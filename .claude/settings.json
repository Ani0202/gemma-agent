{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "TodoWrite"
    ],
    "deny": [
      "Read(~/.kaggle/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.codex/**)",
      "Read(~/.config/gemma/**)",
      "Edit(ops/decisions/**)",
      "Edit(DIRECTOR.md)",
      "Edit(ops/budget/allowance_usd)",
      "Edit(bin/kaggle-submit)",
      "Edit(bin/gpu)",
      "Edit(bin/job)",
      "Bash(kaggle competitions submit)",
      "Bash(kaggle competitions submit *)",
      "Bash(gcloud compute instances create *)",
      "Bash(gcloud billing *)",
      "Bash(gcloud projects delete *)",
      "Bash(cat ~/.kaggle*)",
      "Bash(cat ~/.codex*)",
      "Bash(cat ~/.config/gemma*)",
      "Bash(git push --force *)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Read(~/work/etho/**)",
      "Edit(~/work/etho/**)",
      "Bash(tmux kill-session *)",
      "Bash(tmux kill-server*)",
      "Bash(tailscale *)",
      "Bash(systemctl *)",
      "Bash(crontab -r*)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(reboot*)",
      "Bash(shutdown*)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Edit(bin/router)",
      "Edit(bin/session)",
      "Edit(bin/start)",
      "Edit(bin/decide)",
      "Edit(bin/send)",
      "Edit(bin/hook-stop)",
      "Edit(bin/hook-prompt)",
      "Edit(.claude/settings.json)",
      "Edit(ops/mail/**)",
      "Edit(ops/rc/**)",
      "Bash(tmux send-keys *)",
      "Bash(tmux attach*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/hook-stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/hook-prompt"
          }
        ]
      }
    ]
  }
}
