#!/usr/bin/env bash
# Send a message to another role. Usage: bin/send <builder|director|paper|aniket> "<message>"
# builder/director/paper: delivered into their session by bin/router when they're idle.
# aniket: pushed to his phone via ntfy (no competition data!).
set -euo pipefail
cd "$(dirname "$0")/.."
to=$1; shift; msg="$*"; from=${GEMMA_ROLE:-${SEND_FROM:-router}}
case "$to" in
  builder|director|paper)
    mkdir -p "ops/mail/$to"
    f="ops/mail/$to/$(date -u +%Y%m%dT%H%M%S)-$RANDOM-from-$from.md"
    printf 'From: %s\nTime: %s UTC\n\n%s\n' "$from" "$(date -u +%FT%T)" "$msg" > "$f"
    echo "queued $f" ;;
  aniket) bin/notify default "Gemma ($from)" "$msg"; echo "pushed to phone" ;;
  *) echo "usage: bin/send <builder|director|paper|aniket> <message>"; exit 2 ;;
esac
