#!/usr/bin/env bash
# Independent read-only review by Codex. Usage: bin/codex-review "<what to review: paths, diff range, question>"
# Output: ops/codex/review-<ts>.md
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
mkdir -p ops/codex; ts=$(date -u +%Y%m%dT%H%M%S)
model_args=(); [ -n "${CODEX_MODEL:-}" ] && model_args=(-m "$CODEX_MODEL")
timeout 1800 codex exec --sandbox read-only "${model_args[@]}" \
"Read AGENTS.md (your role: reviewer) and CLAUDE.md. Review: $*
Lead with BLOCKING issues (numbered), then non-blocking, then questions. Cite file:line. Be concrete." \
  </dev/null > "ops/codex/review-$ts.md" 2> "ops/codex/review-$ts.log" || echo "(codex exited non-zero; see log)" >> "ops/codex/review-$ts.md"
echo "ops/codex/review-$ts.md"
