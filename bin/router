#!/usr/bin/env bash
# Router: delivers mail into the interactive Builder/Director sessions when they're idle, primes and
# names (Remote Control) fresh sessions, wakes the Builder on job completion, relays phone replies,
# backs off on usage limits, sends the daily digest, reconciles GPU spend, and pushes to git.
# Runs in tmux window gemma:router (started by bin/start). Only types into its own tmux session.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
source ./config.env
S=$TMUX_SESSION
mkdir -p ops/rc ops/mail/builder/read ops/mail/director/read ops/logs ops/jobs
touch ops/journal.md ops/digest_pending
[ -f ops/status ] || echo "CONTINUE" > ops/status
log(){ echo "$(date -u +%FT%TZ) $*" | tee -a ops/logs/router.log; }
now(){ date -u +%s; }
age(){ [ -f "$1" ] && echo $(( $(now) - $(stat -c %Y "$1") )) || echo 999999; }  # seconds since mtime

inject(){ # role text
  tmux send-keys -t "$S:$1" -l "$2" && sleep 0.5 && tmux send-keys -t "$S:$1" Enter
  rm -f "ops/rc/$1.idle"; date -u +%s > "ops/rc/$1.lastinject"
}
idle(){ [ -f "ops/rc/$1.idle" ]; }
human_recent(){ [ "$(age "ops/rc/$1.human")" -lt "$2" ]; }
limited(){ local u; u=$(cat "ops/rc/$1.backoff_until" 2>/dev/null || echo 0); [ "$(now)" -lt "$u" ]; }
check_limit(){ # if the session just went idle showing a usage-limit message, back off
  local role=$1
  if idle "$role" && [ "$(age "ops/rc/$role.lastinject")" -lt 600 ] && \
     tmux capture-pane -p -t "$S:$role" 2>/dev/null | tail -8 | grep -qiE 'usage limit|limit reached|resets? at|rate.?limit'; then
    if ! limited "$role"; then
      echo $(( $(now) + RL_SLEEP_MIN*60 )) > "ops/rc/$role.backoff_until"; log "$role hit a usage limit; backing off ${RL_SLEEP_MIN}m"
    fi
  fi
}
orient(){ # role -> grounding prefix for every injected message (context may have been cleared)
  if [ "$1" = builder ]; then echo "You are the BUILDER (constitution: CLAUDE.md; state: ops/STATE.md)."
  else echo "You are the DIRECTOR (constitution: DIRECTOR.md; record decisions only via bin/decide)."; fi
}
maybe_clear(){ # role: clear context before new work unless Aniket was active recently
  local role=$1
  if ! human_recent "$role" $((HUMAN_QUIET_MIN*60)); then
    tmux send-keys -t "$S:$role" -l "/clear" && sleep 0.5 && tmux send-keys -t "$S:$role" Enter; sleep 4
  fi
}
prime(){ # fresh session: name it for Remote Control, then orient
  local role=$1 st
  st=$(cat "ops/rc/$role.started" 2>/dev/null || echo 0)
  [ -f "ops/rc/$role.primed" ] && return
  [ $(( $(now) - st )) -lt 20 ] && return          # give claude time to boot
  log "priming $role (remote control + orientation)"
  tmux send-keys -t "$S:$role" -l "/remote-control gemma-$role" && sleep 0.5 && tmux send-keys -t "$S:$role" Enter
  sleep 8
  if [ "$role" = builder ]; then
    inject builder "[[ROUTER]] $(orient builder) Session (re)started. Read CLAUDE.md fully, then ops/STATE.md (if missing, follow docs/KICKOFF.md), check ops/mail/builder/ for unread mail, and continue your plan. End your turn as CLAUDE.md says."
  else
    inject director "[[ROUTER]] $(orient director) Session (re)started. Read DIRECTOR.md fully and ops/STATE.md, then check ops/mail/director/ for unread mail and handle it. If nothing is pending, reply 'ready' and wait."
  fi
  touch "ops/rc/$role.primed"
}
deliver(){ # role: inject unread mail as one message
  local role=$1 files=() f dst list
  for f in ops/mail/$role/*.md; do [ -e "$f" ] && files+=("$f"); done
  [ ${#files[@]} -eq 0 ] && return 1
  idle "$role" || return 0; limited "$role" && return 0; human_recent "$role" "$HUMAN_HOLD_SEC" && return 0
  list=""
  for f in "${files[@]}"; do dst="ops/mail/$role/read/$(basename "$f")"; mv "$f" "$dst"; list="$list $dst"; done
  maybe_clear "$role"
  log "deliver to $role:$list"
  inject "$role" "[[MAIL]] $(orient "$role") New message(s):$list . Read them and act on them per your constitution."
  return 0
}
wake_builder(){ # job events and status-based nudges (only when no mail is pending)
  idle builder || return; limited builder && return; human_recent builder "$HUMAN_HOLD_SEC" && return
  local st kind changed idle_s
  st=$(head -1 ops/status 2>/dev/null); kind=${st%% *}
  changed=$(find ops/jobs -name '*.status' -newer ops/rc/builder.idle 2>/dev/null | xargs -r -n1 basename | sed 's/.status$//' | paste -sd, -)
  idle_s=$(age ops/rc/builder.idle)
  if [ -n "$changed" ]; then SEND_FROM=router bin/send builder "Job status changed: $changed (see bin/job status)." >/dev/null
  elif [ "$kind" = CONTINUE ] && [ "$idle_s" -ge $((MIN_GAP_MIN*60)) ]; then SEND_FROM=router bin/send builder "Continue your plan (status was CONTINUE)." >/dev/null
  elif [ "$kind" = WAITING_JOBS ] && [ "$idle_s" -ge $((WAKE_MAX_MIN*60)) ]; then SEND_FROM=router bin/send builder "Periodic check while waiting on: ${st#* }." >/dev/null
  elif [ "$kind" = NEEDS_DECISION ] && [ "$idle_s" -ge 1800 ] && ! ls ops/decisions 2>/dev/null | grep -q "$(basename "${st#* }" .md)"; then
       [ -z "$(ls ops/mail/director/*.md 2>/dev/null)" ] && SEND_FROM=router bin/send director "Reminder: Builder is waiting on a decision for ${st#* }." >/dev/null && touch ops/rc/builder.idle
  fi
}
send_digest(){
  local today; today=$(date -u +%F)
  [ "$(cat ops/.digest_day 2>/dev/null)" = "$today" ] && return
  [ "$(date -u +%H)" -lt "$DIGEST_HOUR_UTC" ] && return
  bin/notify default "Gemma daily digest $today" "$(tail -8 ops/digest_pending)
GPU \$$(bin/gpu spent 2>/dev/null || echo ?) / allowance \$$(cat ops/budget/allowance_usd). Builder: $(head -1 ops/status | cut -c1-80)"
  : > ops/digest_pending; echo "$today" > ops/.digest_day
}
gitsync(){
  [ "$(age ops/rc/.lastgit)" -lt 1800 ] && return
  touch ops/rc/.lastgit
  git add -A >/dev/null 2>&1; git commit -qm "router sync $(date -u +%FT%TZ)" >/dev/null 2>&1 || true
  git remote | grep -q . && { git push -q >/dev/null 2>&1 || log "git push failed (non-fatal)"; }
}

log "router started (pid $$)"
while :; do
  [ -f ops/STOP ] && { log "STOP present; router exiting"; exit 0; }
  bin/notify-poll >/dev/null 2>&1 || true
  if [ ! -f ops/PAUSE ]; then
    for r in director builder; do
      tmux has-session -t "$S" 2>/dev/null || break
      prime "$r"; check_limit "$r"
      [ -f "ops/rc/$r.primed" ] && deliver "$r"
    done
    [ -f ops/rc/builder.primed ] && [ -z "$(ls ops/mail/builder/*.md 2>/dev/null)" ] && wake_builder
  fi
  [ "$(age ops/rc/.lastgpu)" -ge 300 ] && { touch ops/rc/.lastgpu; bin/gpu reconcile >/dev/null 2>&1 || true; }
  send_digest; gitsync
  sleep 15
done
