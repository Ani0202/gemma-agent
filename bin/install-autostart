#!/usr/bin/env bash
# Restart the gemma tmux session after a VM reboot (cron @reboot). Idempotent; other cron lines untouched.
set -euo pipefail
cd "$(dirname "$0")/.."; ROOT=$PWD
line="@reboot sleep 60; export PATH=$PATH; cd $ROOT && bin/start # gemma-autostart"
( crontab -l 2>/dev/null | grep -v 'gemma-autostart' ; echo "$line" ) | crontab -
echo "installed: $line"
