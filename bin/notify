#!/usr/bin/env bash
# Push a notification to Aniket's phone via ntfy. Usage: bin/notify <min|default|high> "<title>" "<message>"
# Never include competition data (task text, patches) in messages.
set -uo pipefail
f="$HOME/.config/gemma/ntfy.env"; [ -f "$f" ] && source "$f"
[ -n "${NTFY_TOPIC:-}" ] || { echo "notify: NTFY_TOPIC not set" >&2; exit 0; }
prio=${1:-default}; title=${2:-Gemma}; msg=${3:-}
curl -s -m 20 -H "Title: $title" -H "Priority: $prio" -H "Tags: robot" -d "$msg" "https://ntfy.sh/$NTFY_TOPIC" >/dev/null \
  || echo "notify failed" >&2
