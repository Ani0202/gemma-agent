#!/usr/bin/env bash
# Start (or re-attach) the whole system in its own tmux session. Never touches other tmux sessions.
set -euo pipefail
cd "$(dirname "$0")/.."; source ./config.env
S=$TMUX_SESSION
rm -f ops/STOP
if tmux has-session -t "$S" 2>/dev/null; then echo "tmux session '$S' already running (tmux attach -t $S)"; exit 0; fi
tmux new-session -d -s "$S" -n builder "bin/session builder"
tmux new-window  -t "$S" -n director "bin/session director"
tmux new-window  -t "$S" -n router   "bin/router"
tmux new-window  -t "$S" -n paper    "bin/session paper"
echo "started tmux session '$S' with windows builder, director, router, paper"
echo "attach: tmux attach -t $S   (switch windows: Ctrl-b then 0/1/2/3; detach: Ctrl-b then d)"
