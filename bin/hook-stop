#!/usr/bin/env bash
# Claude Code Stop hook: mark this role's session idle (used by bin/router). No-op outside gemma sessions.
cat >/dev/null
[ -n "${GEMMA_ROLE:-}" ] || exit 0
d="${CLAUDE_PROJECT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}/ops/rc"; mkdir -p "$d"
date -u +%s > "$d/$GEMMA_ROLE.idle"
exit 0
