#!/usr/bin/env bash
# One-screen overview.
cd "$(dirname "$0")/.." || exit 1; source ./config.env
st(){ [ -f "ops/rc/$1.idle" ] && echo idle || echo busy; }
echo "tmux:      $(tmux has-session -t "$TMUX_SESSION" 2>/dev/null && echo running || echo NOT running)   paused: $([ -f ops/PAUSE ] && echo yes || echo no)"
echo "builder:   $(st builder)  status: $(head -1 ops/status 2>/dev/null)"
echo "director:  $(st director)  last decision: $(ls -t ops/decisions 2>/dev/null | head -1)"
echo "mail:      builder $(ls ops/mail/builder/*.md 2>/dev/null | wc -l) unread, director $(ls ops/mail/director/*.md 2>/dev/null | wc -l) unread"
echo "gpu:       \$$(bin/gpu spent 2>/dev/null || echo ?) spent / \$$(cat ops/budget/allowance_usd) allowance"
echo "subs:      $( [ -f ops/submissions.jsonl ] && wc -l < ops/submissions.jsonl || echo 0) total"
echo "jobs:"; bin/job status 2>/dev/null | sed 's/^/  /'
echo "router log:"; tail -5 ops/logs/router.log 2>/dev/null | sed 's/^/  /'
