#!/usr/bin/env bash
# Claude Code UserPromptSubmit hook: mark session busy; record when Aniket (not the router) typed.
in=$(cat)
[ -n "${GEMMA_ROLE:-}" ] || exit 0
d="${CLAUDE_PROJECT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}/ops/rc"; mkdir -p "$d"
rm -f "$d/$GEMMA_ROLE.idle"
p=$(printf '%s' "$in" | jq -r '.prompt // ""' 2>/dev/null)
case "$p" in "[["*|"/"*) ;; *) date -u +%s > "$d/$GEMMA_ROLE.human" ;; esac
exit 0
