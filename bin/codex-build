#!/usr/bin/env bash
# Hand a well-scoped implementation task to Codex in its own git worktree. Saves Claude usage.
# Usage: bin/codex-build <name> "<spec with acceptance criteria>"
# Override per call: CODEX_MODEL=<m> CODEX_EFFORT=<low|medium|high|xhigh> bin/codex-build <name> "..."  (default effort: CODEX_EFFORT_BUILD)
# Codex's sandbox can't write the main repo's .git, so this wrapper commits on its behalf.
# Runs detached as a bin/job named codex-<name>; report: ops/codex/build-<name>.md; branch codex/<name>.
set -euo pipefail
[ $# -ge 2 ] || { echo 'usage: bin/codex-build <name> "<spec>"'; exit 1; }
name=$1; shift; spec="$*"
root=$(git rev-parse --show-toplevel); cd "$root"
. bin/lib/codex-env.sh BUILD
wt="$root/../gemma-wt/codex-$name"
mkdir -p ops/codex "$root/../gemma-wt"
git worktree add -B "codex/$name" "$wt" HEAD >/dev/null
cat > "ops/codex/build-$name.sh" <<SH
#!/usr/bin/env bash
cd "$wt" || exit 1
codex exec --sandbox workspace-write ${CODEX_MODEL:+-m $CODEX_MODEL} -c model_reasoning_effort="$effort" \\
"Read AGENTS.md (your role: implementer) and CLAUDE.md. Implement: \$(cat "$root/ops/codex/build-$name.spec")
Do NOT run git commit (the wrapper commits). Tests must run offline. End with: what changed, test output,
open issues, anything the sandbox prevented." </dev/null > "$root/ops/codex/build-$name.md" 2> "$root/ops/codex/build-$name.log"
rc=\$?
git add -A && git commit -q -m "codex-build: $name" || echo "(nothing to commit)" >> "$root/ops/codex/build-$name.md"
exit \$rc
SH
printf '%s\n' "$spec" > "ops/codex/build-$name.spec"
chmod +x "ops/codex/build-$name.sh"
bin/job start "codex-$name" -- "ops/codex/build-$name.sh"
echo "Codex building '$name' on branch codex/$name (worktree $wt). Review, then merge: git merge codex/$name"
