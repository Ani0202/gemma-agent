#!/usr/bin/env bash
# Keeps one interactive Claude Code session alive for a role. Started by bin/start inside tmux.
# Usage: bin/session builder|director|paper
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
source ./config.env
role=$1; export GEMMA_ROLE=$role
unset ANTHROPIC_API_KEY
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR_GEMMA:-$HOME/.claude-gemma}"
mkdir -p ops/rc ops/logs
case $role in
  builder)  args=(--model "$BUILDER_MODEL" --disallowedTools "Bash(bin/decide *),Bash(*GEMMA_ROLE=director*)") ;;
  director) args=(--model "$DIRECTOR_MODEL" --disallowedTools "Edit,Write,NotebookEdit,Bash(bin/kaggle-submit *),Bash(bin/gpu up *),Bash(bin/codex-build *)") ;;
  paper)    args=(--model sonnet --disallowedTools "Bash(bin/decide *),Bash(bin/kaggle-submit *),Bash(bin/gpu *),Bash(*GEMMA_ROLE=director*),Bash(git add -A*)") ;;
  *) echo "role must be builder|director|paper"; exit 2 ;;
esac
while :; do
  [ -f ops/STOP ] && exit 0
  rm -f "ops/rc/$role.idle" "ops/rc/$role.primed" "ops/rc/$role.rc"
  date -u +%s > "ops/rc/$role.started"
  echo "$(date -u +%FT%TZ) $role session starting" >> ops/logs/sessions.log
  claude "${args[@]}"
  echo "$(date -u +%FT%TZ) $role session exited rc=$?; restarting in 30s" >> ops/logs/sessions.log
  sleep 30
done
