#!/usr/bin/env bash
# Ask Codex for an independent second opinion (read-only). Usage: bin/codex-ask "<question with file refs>"
# Override per call: CODEX_MODEL=<m> CODEX_EFFORT=<low|medium|high|xhigh> bin/codex-ask "..."  (default effort: CODEX_EFFORT_ASK)
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. bin/lib/codex-env.sh ASK
mkdir -p ops/codex; ts=$(date -u +%Y%m%dT%H%M%S)
model_args=(); [ -n "${CODEX_MODEL:-}" ] && model_args=(-m "$CODEX_MODEL")
timeout 1200 codex exec --sandbox read-only "${model_args[@]}" -c model_reasoning_effort="$effort" \
"Read AGENTS.md and CLAUDE.md. Give an independent, adversarial second opinion. Argue the strongest case
against the proposed choice before concluding. Question: $*" </dev/null > "ops/codex/ask-$ts.md" 2> "ops/codex/ask-$ts.log" || true
cat "ops/codex/ask-$ts.md"
