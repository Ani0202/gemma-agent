# Bundle validation and packaging

Run from the repository root:

```sh
bin/pack bundles/31b/v000
bin/pack bundles/e4b/v000 --zip
python3 -m pytest -q eval/tests/test_pack.py
```

Validation requires `agent.yaml` and `eval_config.yaml` at the bundle root.
The timing cap must be positive, finite, and satisfy
`evaluation.max_time_minutes * 125 + 30 <= 660`.
All agents must explicitly declare the same allowed quantized Gemma model.

`!include` paths resolve relative to the containing YAML file. `config_path`
references resolve relative to the bundle root. Both reject absolute paths,
null bytes and every `..` component, even when traversal would stay inside the
bundle. Place included files beside their consuming YAML, or beneath it.
Includes support Markdown/text and recursive YAML, with cycle detection and
a maximum depth of ten. Config reference cycles also fail validation.

PyYAML is used when installed. Without it, the conservative fallback supports
block mappings and lists, plain and quoted scalars, JSON flow collections,
literal/folded text blocks, and `!include`. Advanced YAML such as anchors and
non-JSON flow collections requires PyYAML; unsupported syntax fails validation.
The tests exercise both parsers and invoke `python3 -S` to verify the fallback.

`--zip` writes `dist/<parent-directory>-<bundle-directory>.zip` under this
repository, e.g. `dist/31b-v000.zip`. The archive contains sorted files with
fixed timestamps and permissions, with `agent.yaml` at its root. It omits only
the root `MANIFEST.md`. A manifest cannot be an include/config target because
it will not be shipped. File contents are streamed to avoid loading adapter
weights into RAM. The command prints SHA-256 and compressed size and refreshes
one `zip sha256: <digest>` line in the bundle manifest. Validation without
`--zip` writes nothing. Invalid bundles exit nonzero with a `FAIL:` message.
#!/usr/bin/env python3
"""Validate a declarative Gemma bundle; optionally build dist/<track>-<version>.zip.

Without PyYAML, a conservative YAML subset is supported: block mappings/lists,
quoted/plain scalars, JSON flow collections, literal/folded blocks and !include.
Unsupported YAML syntax fails closed with a request to use PyYAML.
"""
import argparse
import hashlib
import json
import math
import os
from pathlib import Path, PureWindowsPath
import re
import shutil
import stat
import sys
import tempfile
import zipfile

try:
    import yaml
except ImportError:
    yaml = None

LIMIT = 3221225472
EXTENSIONS = {'.yaml', '.yml', '.md', '.txt', '.py', '.json', '.safetensors'}
MODELS = {f'gemma-4-{size}-it-qat-w4a16-ct' for size in ('31b', '12b', 'e4b', 'e2b')}
ROOTS = {'agent.yaml', 'agent.yml', 'root_agent.yaml', 'root_agent.yml'}


class Invalid(ValueError):
    pass


def require(condition, message):
    if not condition:
        raise Invalid(message)


def safe_path(value):
    require(isinstance(value, str) and value and '\0' not in value,
            'path must be a nonempty string without null bytes')
    parts = value.replace('\\', '/').split('/')
    require(not value.startswith(('/', '\\')) and not PureWindowsPath(value).drive
            and '..' not in parts, f'unsafe path: {value!r} (absolute or ..)')
    return value


def minimal_yaml(source, include):
    """Small fail-closed parser, deliberately not a general YAML implementation."""
    lines = source.splitlines()

    def scalar(text):
        text = text.strip()
        if text.startswith('!include '):
            return include(scalar(text[9:]))
        if text.startswith(('"', "'")):
            # YAML single quotes escape by doubling; double quotes use JSON escapes.
            try:
                if text.startswith('"'):
                    return json.loads(text)
                require(text.endswith("'"), 'unterminated YAML quote')
                return text[1:-1].replace("''", "'")
            except (ValueError, SyntaxError) as exc:
                raise Invalid(f'invalid quoted YAML scalar: {text}') from exc
        text = re.split(r'\s+#', text, maxsplit=1)[0].rstrip()
        if text.startswith(('[', '{')):
            try:
                return json.loads(text)
            except ValueError as exc:
                raise Invalid('fallback supports JSON flow collections only; use PyYAML') from exc
        require(not text.startswith(('!', '&', '*', '|', '>')),
                'unsupported YAML syntax in fallback; use PyYAML')
        if text.lower() in ('null', '~') or not text:
            return None
        if text.lower() in ('true', 'false'):
            return text.lower() == 'true'
        if re.fullmatch(r'[-+]?\d+', text):
            return int(text)
        if re.fullmatch(r'[-+]?(?:\d+\.\d*|\d*\.\d+)(?:[eE][-+]?\d+)?', text):
            return float(text)
        require(': ' not in text,
                'invalid or unsupported YAML scalar; use PyYAML')
        return text

    def next_line(i):
        while i < len(lines) and (not lines[i].strip() or lines[i].lstrip().startswith('#')):
            i += 1
        return i

    def indent(i):
        require('\t' not in lines[i][:len(lines[i]) - len(lines[i].lstrip())],
                'tabs are not valid YAML indentation')
        return len(lines[i]) - len(lines[i].lstrip(' '))

    def block(i, level):
        seq = lines[i][level:].startswith(('- ', '-'))
        result = [] if seq else {}

        def value(text, pos, base):
            if re.fullmatch(r'[|>][-+]?', text.strip()):
                end = pos
                while end < len(lines) and (not lines[end].strip() or indent(end) > base):
                    end += 1
                content = lines[pos:end]
                margin = min((len(x) - len(x.lstrip()) for x in content if x.strip()), default=base+1)
                chunks = [x[margin:] for x in content]
                out = ('\n' if text.strip().startswith('|') else ' ').join(chunks)
                return out + ('' if text.strip().endswith('-') else '\n'), end
            if text.strip():
                return scalar(text), pos
            child = next_line(pos)
            if child < len(lines) and indent(child) > base:
                return block(child, indent(child))
            return None, pos

        while True:
            i = next_line(i)
            if i >= len(lines) or indent(i) < level:
                return result, i
            require(indent(i) == level, f'invalid YAML indentation at line {i+1}')
            text = lines[i][level:]
            if seq:
                require(text == '-' or text.startswith('- '), f'expected YAML list at line {i+1}')
                text = text[1:].lstrip()
                if re.match(r'[^:]+:(?:\s|$)', text):
                    key, rest = text.split(':', 1)
                    item, i = value(rest, i+1, level+2)
                    entry = {str(scalar(key)): item}
                    nxt = next_line(i)
                    if nxt < len(lines) and indent(nxt) == level+2:
                        extra, i = block(nxt, level+2)
                        require(isinstance(extra, dict) and not entry.keys() & extra.keys(), 'invalid list mapping')
                        entry.update(extra)
                    result.append(entry)
                else:
                    item, i = value(text, i+1, level)
                    result.append(item)
            else:
                match = re.match(r'([^:]+):(?:\s(.*)|$)', text)
                require(match is not None, f'invalid YAML mapping at line {i+1}')
                key = scalar(match[1])
                require(isinstance(key, str) and key not in result, 'invalid or duplicate YAML key')
                result[key], i = value(match[2] or '', i+1, level)

    start = next_line(0)
    if start == len(lines):
        return None
    # A JSON document is also YAML.
    if lines[start].lstrip().startswith(('{', '[')):
        return scalar('\n'.join(lines[start:]))
    require(indent(start) == 0, 'YAML document must begin at indentation zero')
    result, end = block(start, 0)
    require(next_line(end) == len(lines), 'trailing YAML content')
    return result


class Bundle:
    def __init__(self, root):
        self.root = Path(root).absolute()
        self.files = []
        self.cache = {}
        self.loading = []
        self.models = set()

    def target(self, value, base=None):
        safe_path(value)
        path = (base or self.root) / value
        require(path.is_relative_to(self.root), f'path outside bundle: {value}')
        require(path.is_file(), f'missing reference target: {value}')
        require(path in self.files, f'reference is not a bundle file: {value}')
        require(path != self.root / 'MANIFEST.md', 'MANIFEST.md cannot be referenced: excluded from ZIP')
        return path

    def load(self, path):
        require(path not in self.loading, f'YAML reference/include cycle: {path}')
        require(len(self.loading) <= 10, f'include depth exceeds 10: {path}')
        if path in self.cache:
            return self.cache[path]
        self.loading.append(path)
        try:
            source = path.read_text(encoding='utf-8')
            require('\0' not in source, f'null bytes in {path}')
            if path.suffix not in {'.yaml', '.yml'}:
                require(path.suffix in {'.md', '.txt'}, f'unsupported !include target: {path}')
                result = source
            else:
                def include(value):
                    return self.load(self.target(value, path.parent))
                if yaml is None:
                    result = minimal_yaml(source, include)
                else:
                    class Loader(yaml.SafeLoader):
                        pass
                    def mapping(loader, node):
                        result = {}
                        for key_node, value_node in node.value:
                            key = loader.construct_object(key_node)
                            require(isinstance(key, str) and key not in result,
                                    f'invalid or duplicate YAML key in {path}')
                            result[key] = loader.construct_object(value_node)
                        return result
                    Loader.add_constructor('tag:yaml.org,2002:map', mapping)
                    Loader.add_constructor('!include', lambda loader, node: include(loader.construct_scalar(node)))
                    result = yaml.load(source, Loader=Loader)
            self.cache[path] = result
            return result
        except (ValueError, UnicodeError) as exc:
            raise Invalid(f'{path}: {exc}') from exc
        except Exception as exc:
            if yaml is not None and isinstance(exc, yaml.YAMLError):
                raise Invalid(f'{path}: YAML parse failed: {exc}') from exc
            raise
        finally:
            self.loading.pop()

    def prompt(self, value, where):
        if isinstance(value, str):
            bad = set(re.findall(r'\{([A-Za-z_][\w.-]*\??)\}', value)) - {'problem_description'}
            require(not bad, f'{where}: forbidden placeholder(s): {sorted(bad)}')

    def walk(self, value, where, ancestors=(), agent=False):
        if isinstance(value, str):
            require('\0' not in value, f'{where}: null bytes in text')
        if agent:
            require(isinstance(value, (dict, list)), f'{where}: agent must be a mapping')
        if isinstance(value, (dict, list)):
            require(id(value) not in ancestors, f'{where}: recursive YAML alias')
            ancestors = (*ancestors, id(value))
        if isinstance(value, list):
            for index, item in enumerate(value):
                self.walk(item, f'{where}[{index}]', ancestors, agent)
        elif isinstance(value, dict):
            is_agent = agent or bool({'name', 'model', 'agent_class', 'instruction', 'global_instruction', 'tools', 'sub_agents'} & value.keys())
            if is_agent and 'config_path' not in value and 'agent_tool' not in value:
                model = value.get('model')
                require(isinstance(model, str) and model in MODELS, f'{where}: missing or disallowed model: {model!r}')
                self.models.add(model)
            for key, item in value.items():
                label = f'{where}.{key}'
                if key == 'config_path':
                    target = self.target(item)
                    require(target.suffix in {'.yaml', '.yml'}, f'{label}: config_path must reference YAML')
                    # Reference cycles are checked separately using the document graph.
                    self.load(target)
                elif key == 'adapter' and item is not None:
                    require(isinstance(item, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', item)
                            and item != '..', f'{label}: invalid adapter name')
                    for filename in ('adapter_config.json', 'adapter_model.safetensors'):
                        self.target(f'adapters/{item}/{filename}')
                elif key == 'thinking_config':
                    self.thinking(item, label)
                elif key == 'max_output_tokens':
                    require(type(item) is int and 1 <= item <= 32768, f'{label}: must be integer 1..32768')
                if 'instruction' in key or 'prompt' in key:
                    self.prompt(item, label)
                self.walk(item, label, ancestors, key in {'sub_agents', 'agent_tool'})

    def thinking(self, config, where):
        require(isinstance(config, dict), f'{where}: must be a mapping')
        require(not config.keys() - {'thinking_budget', 'thinking_level', 'include_thoughts'}, f'{where}: unknown fields')
        if 'thinking_budget' in config:
            budget = config['thinking_budget']
            require(type(budget) is int and 0 <= budget <= 32768, f'{where}: thinking_budget must be integer 0..32768')
        if 'thinking_level' in config:
            level = config['thinking_level']
            require(isinstance(level, str) and level.upper() in {'MINIMAL', 'LOW', 'MEDIUM', 'HIGH', 'NONE'}, f'{where}: invalid thinking_level')
        if 'include_thoughts' in config:
            require(type(config['include_thoughts']) is bool, f'{where}: include_thoughts must be boolean')

    def validate(self):
        require(self.root.is_dir() and not self.root.is_symlink(), f'not a bundle directory (or symlink): {self.root}')
        total = 0
        for directory, dirs, files in os.walk(self.root, followlinks=False):
            for name in sorted(dirs + files):
                path = Path(directory) / name
                safe_path(path.relative_to(self.root).as_posix())
                mode = path.lstat().st_mode
                require(not stat.S_ISLNK(mode), f'symlink forbidden: {path}')
                require(stat.S_ISDIR(mode) or stat.S_ISREG(mode), f'not a regular file: {path}')
                if stat.S_ISREG(mode):
                    require(path.suffix in EXTENSIONS, f'extension not allowed: {path}')
                    total += path.stat().st_size
                    require(total < LIMIT, f'unpacked size must be < {LIMIT} bytes')
                    self.files.append(path)
        self.files.sort()
        require(self.root / 'agent.yaml' in self.files, 'missing agent.yaml at bundle root')
        require(len(ROOTS & {p.name for p in self.files if p.parent == self.root}) == 1, 'multiple root agent configs')
        require(isinstance(self.load(self.root / 'agent.yaml'), dict), 'agent.yaml must be a mapping')
        for path in self.files:
            if path.suffix in {'.yaml', '.yml'}:
                value = self.load(path)
                self.walk(value, str(path), agent=path == self.root / 'agent.yaml')
            elif path.suffix != '.safetensors':
                source = path.read_text(encoding='utf-8')
                require('\0' not in source, f'null bytes in {path}')
                if 'prompts' in path.relative_to(self.root).parts:
                    self.prompt(source, str(path))
        require(len(self.models) == 1, f'models must be identical across all agents: {sorted(self.models)}')
        # Follow config references, including unreferenced standalone documents.
        def refs(value):
            if isinstance(value, dict):
                for key, item in value.items():
                    if key == 'config_path':
                        yield self.target(item)
                    else:
                        yield from refs(item)
            elif isinstance(value, list):
                for item in value:
                    yield from refs(item)
        done = set()
        def visit(path, active):
            require(path not in active, f'config_path cycle: {path}')
            if path in done:
                return
            for target in refs(self.load(path)):
                child = self.load(target)
                require(isinstance(child, dict), f'agent config must be a mapping: {target}')
                self.walk(child, str(target), agent=True)
                visit(target, active | {path})
            done.add(path)
        for path in list(self.cache):
            visit(path, set())
        require(len(self.models) == 1, 'models must be identical across all agents')
        config = self.load(self.target('eval_config.yaml'))
        evaluation = config.get('evaluation') if isinstance(config, dict) else None
        cap = evaluation.get('max_time_minutes') if isinstance(evaluation, dict) else None
        require(type(cap) in (int, float) and math.isfinite(cap) and cap > 0,
                'evaluation.max_time_minutes: missing or invalid positive cap')
        require(cap * 125 + 30 <= 660, f'evaluation timing FAIL: {cap}*125+30 > 660 minutes')
        return total


def write_zip(bundle, dist):
    track, version = bundle.root.parent.name, bundle.root.name
    require(re.fullmatch(r'[A-Za-z0-9_-]+', track) and re.fullmatch(r'[A-Za-z0-9_-]+', version), 'invalid track/version for archive name')
    dist.mkdir(parents=True, exist_ok=True)
    destination = dist / f'{track}-{version}.zip'
    fd, temporary = tempfile.mkstemp(prefix='.pack-', suffix='.zip', dir=dist)
    os.close(fd)
    try:
        with zipfile.ZipFile(temporary, 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
            for path in bundle.files:
                if path == bundle.root / 'MANIFEST.md':
                    continue
                info = zipfile.ZipInfo(path.relative_to(bundle.root).as_posix(), (1980, 1, 1, 0, 0, 0))
                info.create_system = 3
                info.external_attr = (stat.S_IFREG | 0o644) << 16
                info.compress_type = zipfile.ZIP_DEFLATED
                with path.open('rb') as source, archive.open(info, 'w', force_zip64=True) as target:
                    shutil.copyfileobj(source, target, 1024*1024)
        digest = hashlib.sha256()
        with open(temporary, 'rb') as source:
            for chunk in iter(lambda: source.read(1024*1024), b''):
                digest.update(chunk)
        checksum = digest.hexdigest()
        os.replace(temporary, destination)
        manifest = bundle.root / 'MANIFEST.md'
        content = manifest.read_text(encoding='utf-8') if manifest.exists() else ''
        lines = [line for line in content.splitlines() if not re.match(r'^\s*(?:[-*]\s*)?zip sha256\s*:', line, re.I)]
        manifest.write_text('\n'.join(lines).rstrip() + f'\nzip sha256: {checksum}\n', encoding='utf-8')
        print(f'{destination}\nsha256: {checksum}\nsize: {destination.stat().st_size} bytes')
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('bundle_dir')
    parser.add_argument('--zip', action='store_true')
    args = parser.parse_args()
    try:
        bundle = Bundle(args.bundle_dir)
        total = bundle.validate()
        if args.zip:
            write_zip(bundle, Path(__file__).resolve().parent.parent / 'dist')
        print(f'PASS: {args.bundle_dir} ({total} unpacked bytes)')
        return 0
    except (Invalid, OSError, UnicodeError, RecursionError) as exc:
        print(f'FAIL: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())

