    33	r = subprocess.run([sys.executable, '-c', "import sys; print('x'*6000); print('ERROR: No module named pip', file=sys.stderr); print('Retrying', file=sys.stderr); sys.exit(7)"], capture_output=True, text=True)
    34	assert r.returncode == 7 and len(r.stdout) == 6001
    35	''')
