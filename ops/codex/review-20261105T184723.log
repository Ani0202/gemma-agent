   246	                lines.append(line)
   247	            else:
   248	                lines.append(line)
   249	        if not has_addopts:
   250	            lines.append(f"addopts = {default_addopts}")
   251	        if not has_norecursedirs:
   252	            lines.append(f"norecursedirs = {norecursedirs_val}")
   253	        content = "\n".join(lines) + "\n"
   254	    else:
   255	        content = f"""[pytest]
