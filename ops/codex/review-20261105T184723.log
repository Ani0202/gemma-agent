   257	norecursedirs = {norecursedirs_val}
   258	python_classes = Test* *Test
   259	python_files = test_*.py *_test.py
   260	filterwarnings =
   261	    ignore::DeprecationWarning
   262	    ignore::UserWarning
   263	""" + (("\n" + existing) if existing.strip() else "")
   264	
   265	    try:
   266	        ini_path.write_text(content, encoding="utf-8")
   267	    except Exception as e:
   268	        print(f"Warning: could not write {ini_path}: {e}", file=sys.stderr)
