    38	def build_sanitized_env(
    39	    work_dir: pathlib.Path,
    40	    tmp_dir: pathlib.Path | None = None,
    41	    extra_env: dict[str, str] | None = None,
    42	) -> dict[str, str]:
    43	    """Build a sanitized environment dictionary from _SAFE_ENV_KEYS."""
    44	    eff_tmp = tmp_dir if tmp_dir is not None else work_dir
    45	    sanitized_env: dict[str, str] = {
    46	        k: os.environ[k] for k in _SAFE_ENV_KEYS if k in os.environ
    47	    }
