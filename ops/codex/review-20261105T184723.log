   202	        "--no-build-isolation",
   203	        "--no-deps",
   204	        "-e",
   205	        str(workspace),
   206	    ]
   207	    try:
   208	        res = subprocess.run(cmd, capture_output=True, text=True, check=False)
   209	        if res.returncode != 0:
   210	            fallback = [sys.executable, "-m", "pip", "install", "--no-deps", "-e", str(workspace)]
   211	            subprocess.run(fallback, capture_output=True, text=True, check=False)
   212	    except Exception as e:
   213	        print(f"Notice: install_editable_package skipped: {e}", file=sys.stderr)
