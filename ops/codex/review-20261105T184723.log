   253	# Capture setup.py's otherwise discarded subprocess output without changing setup.py.
   254	# Write after EVERY call so an outer timeout still leaves completed calls visible.
   255	SETUP_OBSERVER = r'''import json, runpy, subprocess, sys, time
   256	from pathlib import Path
   257	original = subprocess.run
   258	calls = []
   259	log = Path(__file__).with_name('setup_subprocesses.json')
   260	log.write_text('[]')
   261	def run(*args, **kwargs):
   262	    start = time.perf_counter()
   263	    argv = args[0] if args else kwargs.get('args')
   264	    result = None
   265	    try:
   266	        result = original(*args, **kwargs)
   267	        return result
   268	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   269	        result = exc
   270	        raise
   271	    finally:
   272	        def decode(value):
   273	            return value.decode(errors='replace') if isinstance(value, bytes) else (value or '')
   274	        out, err = decode(getattr(result, 'stdout', '')), decode(getattr(result, 'stderr', ''))
   275	        calls.append(dict(argv=argv, duration_s=time.perf_counter()-start,
   276	            start_offset_s=start-origin, rc=getattr(result, 'returncode', None),
   277	            stdout=out.encode()[-2048:].decode(errors='ignore'),
   278	            stderr=err.encode()[-2048:].decode(errors='ignore'), stdout_full=out, stderr_full=err,
   279	            retrying_lines=sum('Retrying' in line for line in (out+'\n'+err).splitlines()),
   280	            interpreter_version=sys.version))
   281	        log.write_text(json.dumps(calls))
   282	origin = time.perf_counter()
   283	subprocess.run = run
   284	sys.argv = sys.argv[1:]
   285	runpy.run_path(sys.argv[0], run_name='__main__')
   286	'''
