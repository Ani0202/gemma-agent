   233	def _build_unpacked_wheels_tar(
   234	    selected_wheels: list[Path], cache_name: str, marker_name: str
   235	) -> Path:
   236	    """Unpacks selected_wheels into a cached uncompressed tar archive with a marker file."""
   237	    import shutil
   238	    import subprocess
   239	    import tempfile
   240	    import uuid
   241	    import zipfile
   242	    from concurrent.futures import ThreadPoolExecutor
