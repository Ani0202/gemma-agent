   113	def setup_step(current, name, action, *, fatal=True):
   114	    """Time setup steps and retain bounded output plus retry counts."""
   115	    start = time.perf_counter()
   116	    row = dict(step=name, start_offset_s=round(start-current['started'], 6),
   117	               duration_s=0.0, rc=None, stdout='', stderr='', retrying_lines=0)
   118	    current['setup_calls'].append(row)
   119	    try:
   120	        result = action()
   121	        row['rc'] = getattr(result, 'exit_code', getattr(result, 'returncode', 0))
   122	        for field in ('stdout', 'stderr'):
   123	            value = getattr(result, field, '') or ''
   124	            row['retrying_lines'] += sum('Retrying' in line for line in value.splitlines())
   125	            row[field] = value.encode('utf-8', errors='replace')[-2048:].decode('utf-8', errors='ignore')
   126	        return result
   127	    except Exception as exc:
   128	        row.update(rc=-1, stderr=type(exc).__name__)
   129	        if fatal:
   130	            current['setup_failed'] = True
   131	            raise
   132	    finally:
   133	        row['duration_s'] = round(time.perf_counter()-start, 6)
   134	        if fatal and row['rc'] != 0:
   135	            current['setup_failed'] = True
