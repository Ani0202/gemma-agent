    57	def execute_subprocess_command(
    58	    command: str | list[str],
    59	    cwd: pathlib.Path,
    60	    env: dict[str, str],
    61	    timeout: float | None = 300,
    62	    *,
    63	    shell: bool | None = None,
    64	    max_output_chars: int = 10 * 1024 * 1024,
    65	) -> ExecutionResult:
    66	    """Execute a command in a new process group with timeout and SIGKILL cleanup."""
    67	    if shell is None:
    68	        shell = isinstance(command, str)
    69	    start = time.perf_counter()
    70	    try:
    71	        proc = subprocess.Popen(
    72	            command,
    73	            shell=shell,
    74	            cwd=str(cwd),
    75	            env=env,
    76	            stdout=subprocess.PIPE,
    77	            stderr=subprocess.PIPE,
    78	            text=True,
    79	            encoding="utf-8",
    80	            errors="replace",
    81	            start_new_session=True,
    82	        )
    83	    except (RuntimeError, OSError, ValueError, EvalCoreError) as e:
    84	        duration = time.perf_counter() - start
    85	        return ExecutionResult(
    86	            status="error",
    87	            stdout="",
    88	            stderr=str(e),
    89	            exit_code=-1,
    90	            duration_seconds=round(duration, 3),
    91	        )
    92	
    93	    try:
    94	        stdout, stderr = proc.communicate(timeout=timeout)
    95	        duration = time.perf_counter() - start
    96	        stdout = stdout or ""
    97	        stderr = stderr or ""
    98	        if max_output_chars and len(stdout) > max_output_chars:
    99	            stdout = stdout[:max_output_chars] + "\n...[Output truncated at 10MB limit]\n"
   100	        if max_output_chars and len(stderr) > max_output_chars:
   101	            stderr = stderr[:max_output_chars] + "\n...[Output truncated at 10MB limit]\n"
   102	        status = "ok" if proc.returncode == 0 else "error"
   103	        return ExecutionResult(
   104	            status=status,
   105	            stdout=stdout,
   106	            stderr=stderr,
   107	            exit_code=proc.returncode,
   108	            duration_seconds=round(duration, 3),
   109	        )
   110	    except subprocess.TimeoutExpired:
   111	        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
   112	            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
   113	        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
   114	            os.killpg(proc.pid, signal.SIGKILL)
   115	        try:
   116	            stdout, stderr = proc.communicate(timeout=1.0)
   117	        except (subprocess.TimeoutExpired, Exception):  # noqa: BLE001
   118	            stdout, stderr = "", ""
   119	        duration = time.perf_counter() - start
   120	        return ExecutionResult(
   121	            status="timeout",
   122	            stdout=stdout or "",
   123	            stderr=stderr or "",
   124	            exit_code=124,
   125	            duration_seconds=round(duration, 3),
   126	        )
   127	    except (RuntimeError, OSError, ValueError, EvalCoreError) as e:
   128	        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
   129	            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
   130	        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
   131	            os.killpg(proc.pid, signal.SIGKILL)
   132	        duration = time.perf_counter() - start
   133	        return ExecutionResult(
   134	            status="error",
   135	            stdout="",
   136	            stderr=str(e),
   137	            exit_code=1,
   138	            duration_seconds=round(duration, 3),
   139	        )
   140	    finally:
   141	        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
   142	            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
   143	        with contextlib.suppress(ProcessLookupError, PermissionError, OSError):
   144	            os.killpg(proc.pid, signal.SIGKILL)
