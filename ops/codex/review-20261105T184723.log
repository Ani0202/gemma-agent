   564	            logger.warning(
   565	                'Failed to install test dependencies for %s (exit code %d):\n%s',
   566	                repo,
   567	                res.exit_code,
   568	                details,
   569	            )
   570	    finally:
   571	        if script_in_container == '/tmp/setup.py':
   572	            docker.exec(container_id, 'rm -f /tmp/setup.py')
