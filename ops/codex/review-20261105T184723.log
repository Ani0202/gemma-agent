   147	class SubprocessSandbox(BaseSandbox):
   148	    """Local process sandbox operating within a host directory."""
   149	
   150	    def __init__(
   151	        self,
   152	        work_dir: str | pathlib.Path | None = None,
   153	        environment: dict[str, str] | None = None,
   154	    ) -> None:
   155	        if work_dir is None:
   156	            import tempfile
   157	            self._temp_dir = tempfile.TemporaryDirectory(prefix="adk_sandbox_")
   158	            self._work_dir = pathlib.Path(self._temp_dir.name).resolve()
   159	        else:
   160	            self._temp_dir = None
   161	            self._work_dir = pathlib.Path(work_dir).resolve()
   162	            self._work_dir.mkdir(parents=True, exist_ok=True)
   163	        self._environment: dict[str, str] = dict(environment) if environment else {}
   164	        self._initial_files: dict[str, str | bytes] = {}
   165	
   166	    def initialize(self, files: dict[str, str | bytes] | None = None) -> None:
   167	        """Ensure working directory exists and write initial files."""
   168	        self._work_dir.mkdir(parents=True, exist_ok=True)
   169	        if files is not None:
   170	            self._initial_files = dict(files)
   171	            self._write_files(files)
   172	
   173	    def _write_files(self, files: dict[str, str | bytes]) -> None:
   174	        for rel_path, content in files.items():
   175	            self.write_file(rel_path, content)
   176	
   177	    def run_command(
   178	        self,
   179	        command: str,
   180	        timeout: float | None = 300,
   181	        work_dir: str | None = None,
   182	    ) -> ExecutionResult:
   183	        """Execute a shell command via subprocess."""
   184	        target_dir = self._resolve_sandbox_path(work_dir) if work_dir else self._work_dir
   185	        target_dir.mkdir(parents=True, exist_ok=True)
   186	        sanitized_env = build_sanitized_env(
   187	            work_dir=self._work_dir,
   188	            extra_env=self._environment,
   189	        )
   190	        return execute_subprocess_command(
   191	            command=command,
   192	            cwd=target_dir,
   193	            env=sanitized_env,
   194	            timeout=timeout,
   195	            shell=True,
   196	        )
   197	
   198	    def _resolve_sandbox_path(self, path: str | pathlib.Path) -> pathlib.Path:
   199	        p = pathlib.Path(path)
   200	        if not p.is_absolute():
   201	            p = self._work_dir / p
   202	        resolved = p.resolve()
   203	        if not resolved.is_relative_to(self._work_dir.resolve()):
   204	            raise SandboxPathTraversalError(f"Path escapes sandbox: {path!r}", path=str(path))
   205	        return resolved
   206	
   207	    def write_file(self, path: str, content: str | bytes) -> None:
   208	        """Write file to local workspace."""
   209	        full_path = self._resolve_sandbox_path(path)
   210	        full_path.parent.mkdir(parents=True, exist_ok=True)
   211	        if isinstance(content, str):
   212	            full_path.write_text(content, encoding="utf-8")
   213	        else:
   214	            full_path.write_bytes(content)
   215	
   216	    def read_file(self, path: str) -> str:
   217	        """Read text file from local workspace."""
   218	        full_path = self._resolve_sandbox_path(path)
   219	        if not full_path.is_file():
   220	            raise SandboxFileNotFoundError(f"File not found: {path}", path=str(path))
   221	        return full_path.read_text(encoding="utf-8")
   222	
   223	    def copy_to(self, host_path: str | pathlib.Path, container_path: str | pathlib.Path) -> None:
   224	        """Copy a file or directory from the host into the sandbox."""
   225	        host_p = pathlib.Path(host_path).resolve()
   226	        if not host_p.exists():
   227	            raise SandboxFileNotFoundError(f"Host path not found: {host_path}", path=str(host_path))
   228	
   229	        target_p = self._resolve_sandbox_path(container_path)
   230	        if host_p.is_file():
   231	            if str(container_path).endswith(("/", "\\")) or target_p.is_dir():
   232	                target_p.mkdir(parents=True, exist_ok=True)
   233	                target_file = target_p / host_p.name
   234	            else:
   235	                target_p.parent.mkdir(parents=True, exist_ok=True)
