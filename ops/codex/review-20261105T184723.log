   122	def clean_requirement_line(line: str) -> str:
   123	    """Removes comments, markers, extras, and version constraints from a requirement line."""
   124	    line = line.strip()
   125	    if not line or line.startswith("#") or line.startswith("-"):
   126	        return ""
   127	    line = re.sub(r";.*$", "", line)
   128	    line = re.sub(r"\[.*?\]", "", line)
   129	    line = re.split(r"[=<>!~]", line)[0]
   130	    return line.strip()
