   133	def collect_from_pyproject(pyproject_path: Path) -> list[str]:
   134	    """Collects dependencies and test/optional-dependencies from pyproject.toml."""
   135	    if not pyproject_path.exists() or tomllib is None:
   136	        return []
   137	    try:
   138	        with open(pyproject_path, "rb") as f:
   139	            data = tomllib.load(f)
   140	    except Exception as e:
   141	        print(f"Warning: could not parse {pyproject_path}: {e}", file=sys.stderr)
   142	        return []
   143	
   144	    collected: list[str] = []
   145	    project = data.get("project", {})
   146	    for dep in project.get("dependencies", []):
   147	        cleaned = clean_requirement_line(dep)
   148	        if cleaned:
   149	            collected.append(cleaned)
   150	    for group, deps in project.get("optional-dependencies", {}).items():
   151	        for dep in deps:
   152	            cleaned = clean_requirement_line(dep)
   153	            if cleaned:
   154	                collected.append(cleaned)
   155	    return collected
   156	
   157	
   158	def collect_from_requirements_files(workspace: Path) -> list[str]:
   159	    """Collects dependency names from requirements*.txt and test-requirements*.txt."""
   160	    collected: list[str] = []
   161	    req_files = list(workspace.glob("**/requirements*.txt")) + list(workspace.glob("**/test-requirements*.txt"))
   162	    for rf in req_files:
   163	        if "docker/" in str(rf) or ".git" in str(rf):
   164	            continue
   165	        try:
   166	            for line in rf.read_text(encoding="utf-8", errors="replace").splitlines():
   167	                cleaned = clean_requirement_line(line)
   168	                if cleaned:
   169	                    collected.append(cleaned)
   170	        except Exception:
   171	            pass
   172	    return collected
