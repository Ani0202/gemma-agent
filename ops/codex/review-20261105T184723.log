   151	def copy_runtime_package(name, destination):
   152	    """Copy only the pure Python image package and metadata; no host path injection."""
   153	    from importlib.metadata import distribution, PackageNotFoundError
   154	    try:
   155	        dist = distribution(name)
   156	    except PackageNotFoundError:
   157	        return 'missing'
   158	    if name == 'pytest-timeout' and dist.version != '2.1.0':
   159	        return 'missing'
   160	    # Distribution names need not match import names (trove-classifiers, PyYAML).
   161	    files = list(dist.files or [])
   162	    if not files or any(str(p).endswith(('.so', '.pyd', '.dll', '.dylib')) for p in files):
   163	        return 'missing'
   164	    files = [p for p in files if '..' not in p.parts and not p.is_absolute()
   165	             and not p.parts[0].endswith('.data')]
   166	    if not any(str(p).endswith('.py') and not p.parts[0].endswith('.dist-info') for p in files):
   167	        return 'missing'
   168	    for entry in files:
   169	        target = destination / entry
   170	        target.parent.mkdir(parents=True, exist_ok=True)
   171	        shutil.copyfile(dist.locate_file(entry), target)
   172	    return 'runtime-site-packages:' + str(dist.locate_file(''))
