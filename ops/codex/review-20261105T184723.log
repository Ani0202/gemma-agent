   442	def classify_patch(patch, repo, protected=None, test_targets=()):
   443	    """Parse file headers outside hunks, including quoted paths and renames."""
   444	    files, new = set(), set()
   445	    current, added, in_hunk = set(), False, False
   446	    def path_value(raw):
   447	        raw = raw.split('\t', 1)[0]
   448	        value = json.loads(raw) if raw.startswith('"') else raw
   449	        return value[2:] if value.startswith(('a/', 'b/')) else value
   450	    for line in patch.splitlines() + ['diff --git ']:
   451	        if line.startswith('diff --git '):
   452	            files.update(current)
   453	            if added:
   454	                new.update(current)
   455	            current, added, in_hunk = set(), False, False
   456	            match = re.match(r'^diff --git ("a/.*?"|a/.*?) ("b/.*?"|b/.*)$', line)
   457	            if match:
   458	                current.update(path_value(p) for p in match.groups())
   459	        elif line.startswith('@@'):
   460	            in_hunk = True
   461	        elif not in_hunk:
   462	            if line.startswith(('--- ', '+++ ')):
   463	                p = path_value(line[4:])
   464	                if p != '/dev/null':
   465	                    current.add(p)
   466	                elif line.startswith('--- '):
   467	                    added = True
   468	            elif line.startswith('new file mode '):
   469	                added = True
   470	            elif line.startswith(('rename from ', 'rename to ')):
   471	                current.add(path_value(line.split(' ', 2)[2]))
   472	    if protected is None:
   473	        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
   474	    tests = sorted(p for p in files if protected(p) or p in test_targets)
   475	    package = repo.split('/')[-1].replace('-', '_').lower()
   476	    source_roots = (package + '/', 'src/' + package + '/')
   477	    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
   478	                                         and p not in tests))
   479	    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
   480	                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())
