   175	def wheel_metadata(path):
   176	    from email.parser import BytesParser
   177	    import zipfile
   178	    with zipfile.ZipFile(path) as archive:
   179	        name = next(n for n in archive.namelist() if n.endswith('.dist-info/METADATA'))
   180	        return BytesParser().parsebytes(archive.read(name))
