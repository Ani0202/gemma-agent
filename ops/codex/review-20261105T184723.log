   183	def close_tool_dependencies(roots, wheels, tags, environment, destination, install_wheel):
   184	    """Walk runtime requirements only, using sandbox markers and no pip resolver.
   185	
   186	    Existing sandbox metadata describes base wheels and copied tools. Each requirement
   187	    edge is checked, while each installed distribution/version is expanded only once.
   188	    Missing edges remain diagnostic and never prevent installing the tools themselves.
   189	    """
   190	    from importlib.metadata import distributions, distribution, PackageNotFoundError
   191	    from packaging.requirements import Requirement
   192	    from packaging.utils import canonicalize_name, parse_wheel_filename
   193	    installed = {canonicalize_name(d.metadata['Name']): d.metadata
   194	                 for d in distributions(path=[str(destination)])}
   195	    queue = list(roots)
   196	    installed.update({canonicalize_name(m['Name']): m for m in queue})
   197	    sources = {name: 'runtime-site-packages:' + str(destination) for name in installed}
   198	    for path in compatible_wheels(wheels, tags).values():
   199	        name, version, _, _ = parse_wheel_filename(path.name)
   200	        if name in installed and installed[name]['Version'] == str(version):
   201	            sources[name] = str(path)
   202	    visited, entries, missing = set(), [], []
   203	    while queue:
   204	        metadata = queue.pop(0)
   205	        key = (canonicalize_name(metadata['Name']), metadata['Version'])
   206	        if key in visited:
   207	            continue
   208	        visited.add(key)
   209	        for raw in metadata.get_all('Requires-Dist', []):
   210	            req = Requirement(raw)
   211	            if req.marker and not req.marker.evaluate(dict(environment, extra='')):
   212	                continue
   213	            name = canonicalize_name(req.name)
   214	            current = installed.get(name)
   215	            row = dict(name=name, required_spec=str(req.specifier), requirement=raw,
   216	                       source='missing', version_installed=None)
   217	            if current is not None and current['Version'] in req.specifier:
   218	                row.update(source=sources.get(name, 'sandbox metadata'),
   219	                           version_installed=current['Version'])
   220	            else:
   221	                candidate = compatible_wheels(wheels, tags, req).get(name)
   222	                current = None
   223	                if candidate:
   224	                    result = install_wheel(candidate)
   225	                    row['rc'] = result.exit_code
   226	                    for field in ('stdout', 'stderr'):
   227	                        row[field] = (getattr(result, field, '') or '').encode()[-2048:].decode(errors='ignore')
   228	                    if result.exit_code == 0:
   229	                        current = wheel_metadata(candidate)
   230	                        row['source'] = str(candidate)
   231	                else:
   232	                    try:
   233	                        runtime = distribution(name)
   234	                    except PackageNotFoundError:
   235	                        runtime = None
   236	                    if runtime is not None and runtime.version in req.specifier:
   237	                        source = copy_runtime_package(name, destination)
   238	                        if source != 'missing':
   239	                            current = runtime.metadata
   240	                            row['source'] = source
   241	                if current is not None:
   242	                    installed[name] = current
   243	                    sources[name] = row['source']
   244	                    row['version_installed'] = current['Version']
   245	            entries.append(row)
   246	            if current is not None:
   247	                queue.append(current)
   248	            elif name not in missing:
   249	                missing.append(name)
   250	    return entries, missing
