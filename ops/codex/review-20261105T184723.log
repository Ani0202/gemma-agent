    95	def compatible_wheels(wheels, tags, requirement=None):
    96	    """Highest version per distribution, with sandbox PEP 425 tags (never host tags)."""
    97	    from packaging.utils import canonicalize_name, parse_wheel_filename
    98	    rank = {tag: i for i, tag in enumerate(tags)}
    99	    selected = {}
   100	    for path in sorted(Path(wheels).glob('*.whl')):
   101	        name, version, build, wheel_tags = parse_wheel_filename(path.name)
   102	        if requirement is not None and (name != canonicalize_name(requirement.name) or version not in requirement.specifier):
   103	            continue
   104	        matches = [rank[str(tag)] for tag in wheel_tags if str(tag) in rank]
   105	        if not matches:
   106	            continue
   107	        score = (version, -min(matches), build)
   108	        if name not in selected or score > selected[name][0]:
   109	            selected[name] = (score, path)
   110	    return {name: item[1] for name, item in selected.items()}
