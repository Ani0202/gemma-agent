   239	            target_p.mkdir(parents=True, exist_ok=True)
   240	            shutil.copytree(host_p, target_p, dirs_exist_ok=True)
   241	
   242	    def copy_from(self, container_path: str | pathlib.Path, host_path: str | pathlib.Path) -> None:
   243	        """Copy a file or directory from the sandbox to the host."""
   244	        src_p = self._resolve_sandbox_path(container_path)
   245	        if not src_p.exists():
   246	            raise SandboxFileNotFoundError(f"Sandbox path not found: {container_path}", path=str(container_path))
