   482	def trace_counts(trace):
   483	    entries = trace.entries if trace else []
   484	    counts = Counter(e.tool_name for e in entries if e.event_type == 'tool_call')
   485	    tokens = {}
   486	    for key in ('prompt_tokens', 'completion_tokens'):
   487	        values = [e.usage[key] for e in entries if e.usage and isinstance(e.usage.get(key), (int, float))]
   488	        tokens[key] = sum(values) if values else None
   489	    return dict(counts), tokens, tool_seconds(entries)
   490	
   491	def tool_seconds(entries):
   492	    """Per tool name: wall seconds from each tool_call to its tool_response (FIFO per name)."""
   493	    pending, out = {}, {}
   494	    for e in entries:
   495	        if e.event_type == 'tool_call':
   496	            pending.setdefault(e.tool_name, []).append(e.timestamp)
   497	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   498	            stat = out.setdefault(e.tool_name, dict(n=0, total=0.0, max=0.0))
   499	            dt = max(0.0, e.timestamp - pending[e.tool_name].pop(0))
   500	            stat['n'] += 1
   501	            stat['total'] = round(stat['total'] + dt, 3)
   502	            stat['max'] = round(max(stat['max'], dt), 3)
   503	    return out
   504	
   505	def observe_patch_strip(original, state):
   506	    """Retain the agent's diff before the harness removes protected edits."""
   507	    def strip(patch, *pos, **kw):
   508	        current = state.get(None)
   509	        filtered = original(patch, *pos, **kw)
   510	        if current is not None and current.get('agent_active'):
   511	            if patch != current.get('filtered_patch'):
   512	                current['raw_patch'] = patch
   513	            current['filtered_patch'] = filtered
   514	        return filtered
   515	    return strip
   516	
   517	def test_run_stats(trace, agent_seconds):
   518	    pending, n, total = {}, 0, 0.0
   519	    for e in trace.entries if trace else []:
   520	        if e.event_type == 'tool_call':
   521	            command = (e.tool_args or {}).get('command', '')
   522	            is_test = e.tool_name == 'run_command' and any(s in command for s in ('pytest', 'unittest', 'tox', 'nox', 'run_tests'))
   523	            n += int(is_test)
   524	            pending.setdefault(e.tool_name, []).append((e.timestamp, is_test))
   525	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   526	            start, is_test = pending[e.tool_name].pop(0)
   527	            if is_test:
   528	                total += max(0.0, e.timestamp - start)
   529	    return dict(n=n, total_seconds=total, share_of_agent_seconds=total / agent_seconds if agent_seconds else None)
   530	
   531	def should_stop(elapsed, cap_minutes, verification_timeout, observed_max, budget):
   532	    return elapsed + 1.5 * max(cap_minutes * 60 + verification_timeout, observed_max) > budget
   533	
   534	def distribution(values):
   535	    values = sorted(values)
   536	    def percentile(q):
   537	        x = (len(values) - 1) * q
   538	        lo = int(x)
   539	        return values[lo] + (values[min(lo + 1, len(values)-1)] - values[lo]) * (x-lo)
   540	    return dict(mean=sum(values)/len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))

