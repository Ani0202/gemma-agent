            return 4
    else:
        print(__doc__)
        return 2
    Path(argv[-1]).write_text(json.dumps(out, indent=2) + '\n')
    print(json.dumps(out.get('totals', dict(n_rows=out['n_rows'], overall=out.get('overall')))))
    return 0


