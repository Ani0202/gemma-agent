    verdict_missing = any(type(r.get('resolved')) is not bool or r.get('verification_skipped') is True for r in rows)
    missing = not rows or hs is None or identity_missing or verdict_missing
    ciii = dict(status='FAIL' if not inv['complete'] or identity_conflict or hs else
