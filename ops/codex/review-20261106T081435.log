    49	    messages = (timing_row['result_error'], timing_row['agent_error_text'])
    50	    if not all(_blank(m) for m in messages):
    51	        return False
    52	    if any(isinstance(m, str) and m.strip().startswith(VERIFY_AGENT_PREFIXES) for m in messages):
    53	        return False
    54	    return True
