    34	def is_h_verify_empty_patch(cls_row, timing_row):
    35	    """True iff the row is the pre-registered H-VERIFY(empty-patch) sub-case (pure; no I/O)."""
    36	    if cls_row.get('h') != 'H-VERIFY' or cls_row.get('reasons') != EMPTY_PATCH_REASONS:
