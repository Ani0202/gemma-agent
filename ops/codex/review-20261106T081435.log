    38	    pb = timing_row.get('verified_patch_bytes')
    39	    if type(pb) is not int or pb != 0:
    40	        return False
    41	    code = timing_row.get('exit_code')
    42	    if type(code) is not int or code in (0, -1):
    43	        return False
    44	    if timing_row.get('resolved') is not False:
    45	        return False
    46	    # Keys must be PRESENT (null/empty values qualify; absent keys do not) - codex review 081225 B2.
