   177	def resolve_all(target, containing):
   178	    """Every plausible normalized resolution (root- and document-relative) of a path value."""
   179	    if not isinstance(target, str) or not target:
   180	        return set()
   181	    return {posixpath.normpath(posixpath.join(base, target)).rstrip('/')
   182	            for base in ('', posixpath.dirname(containing))}
