   167	def has_merge_key(nodes):
   168	    """True if any mapping in the tree uses a YAML merge key (`<<`); such docs get no allowance."""
   169	    for _, node in nodes:
   170	        if isinstance(node, yaml.MappingNode):
   171	            for k, _v in node.value:
   172	                if k.tag == MERGE_TAG or (isinstance(k, yaml.ScalarNode) and k.value == '<<'):
   173	                    return True
   174	    return False
