   155	def resolve(target, containing, names):
   156	    """Resolve an include/config_path value; None if missing or ambiguous."""
   157	    if not isinstance(target, str) or not target:
   158	        return None
   159	    cands = set()
   160	    for base in ('', posixpath.dirname(containing)):
   161	        p = posixpath.normpath(posixpath.join(base, target))
   162	        if p in names:
   163	            cands.add(p)
   164	    return cands.pop() if len(cands) == 1 else None
