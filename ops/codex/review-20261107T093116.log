    80	def read_zip(path):
    81	    """Return ({name: bytes}, [problems]). Problems make the zip unusable for clause (b)."""
    82	    files, problems, seen_fold = {}, [], {}
    83	    with zipfile.ZipFile(path) as z:
    84	        infos = z.infolist()
    85	        for i in infos:
    86	            n = i.filename
    87	            if n in files:
    88	                problems.append(f'duplicate entry {n!r}')
    89	                continue
    90	            fold = unicodedata.normalize('NFC', n).casefold()
    91	            if fold in seen_fold:
    92	                problems.append(f'entry {n!r} collides with {seen_fold[fold]!r} (case/unicode fold)')
    93	            seen_fold[fold] = n
    94	            if n.endswith('/') or i.is_dir():
    95	                problems.append(f'directory entry {n!r}')
    96	                continue
    97	            parts = n.split('/')
    98	            if ('\\' in n or n.startswith('/') or any(p in ('', '.', '..') for p in parts)
    99	                    or posixpath.normpath(n) != n or '\x00' in n):
   100	                problems.append(f'non-normalized path {n!r}')
   101	                continue
   102	            mode = (i.external_attr >> 16) & 0xFFFF
   103	            if mode and stat.S_IFMT(mode) not in (0, stat.S_IFREG):
   104	                problems.append(f'entry {n!r} is not a regular file (mode {oct(mode)})')
   105	                continue
   106	            if i.flag_bits & 0x1:
   107	                problems.append(f'entry {n!r} is encrypted')
   108	                continue
   109	            files[n] = z.read(i)
   110	    names = set(files)
   111	    for n in names:
   112	        parts = n.split('/')
   113	        for k in range(1, len(parts)):
   114	            if '/'.join(parts[:k]) in names:
   115	                problems.append(f'file/directory conflict: {"/".join(parts[:k])!r} vs {n!r}')
   116	    return files, problems
