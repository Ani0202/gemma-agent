   245	def parse_value(knob, text):
   246	    pat, lo, allow_float, strict = DOMAINS[knob]
   247	    if not re.fullmatch(pat, text):
   248	        return None
   249	    v = float(text) if allow_float else int(text)
   250	    if (strict and v <= lo) or v < lo:
   251	        return None
   252	    return v
