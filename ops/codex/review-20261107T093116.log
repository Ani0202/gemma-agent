   255	def compare_allowed(name, cdata, rdata, perms, knobs, violations):
   256	    def bad(reason, line=None):
   257	        violations.append({'file': name, 'path': [] if line is None else [f'line {line}'], 'reason': reason})
   258	
   259	    cl, rl = cdata.splitlines(keepends=True), rdata.splitlines(keepends=True)
   260	    if len(cl) != len(rl):
   261	        return bad(f'line count {len(cl)} != reference {len(rl)}')
   262	    changed = []
   263	    for i, (c, r) in enumerate(zip(cl, rl)):
   264	        if c == r:
   265	            continue
   266	        mc, mr = LINE_RE.match(c), LINE_RE.match(r)
   267	        if not (mc and mr) or mc.group(1, 2, 3, 5) != mr.group(1, 2, 3, 5):
   268	            return bad('non-knob line differs', i + 1)
   269	        knob = mc.group(2).decode()
   270	        if knob not in DOMAINS:
   271	            return bad(f'key {knob!r} is not a knob', i + 1)
   272	        changed.append((i, knob, mc.group(4).decode(), mr.group(4).decode()))
   273	    if not changed:
   274	        return None
   275	    trees = {}
   276	    for side, data in (('candidate', cdata), ('reference', rdata)):
   277	        try:
   278	            root = compose(data, f'{side} {name}')
   279	            trees[side] = list(walk_paths(root)) if root is not None else []
   280	        except ValueError as e:
   281	            return bad(str(e))
   282	    for i, knob, ctext, rtext in changed:
   283	        for side, text in (('candidate', ctext), ('reference', rtext)):
   284	            hits = [(p, n) for p, n in trees[side]
   285	                    if isinstance(n, yaml.ScalarNode) and n.start_mark.line == i and n.value == text]
   286	            if len(hits) != 1 or hits[0][1].style is not None or hits[0][1].tag not in (INT_TAG, FLOAT_TAG):
   287	                return bad(f'{side} value {text!r} is not a single plain numeric scalar', i + 1)
   288	            path = hits[0][0]
   289	            same = [p for p, n in trees[side] if n is hits[0][1]]
   290	            if any(perms.get(p) != knob for p in same):
   291	                return bad(f'{side} {knob} at {["/".join(map(str, p)) for p in same]} is not an allowed path', i + 1)
   292	        cv, rv = parse_value(knob, ctext), parse_value(knob, rtext)
   293	        entry = {'file': name, 'path': list(path), 'knob': knob, 'candidate': ctext, 'reference': rtext}
   294	        if cv is None or rv is None:
   295	            entry['status'] = 'NOT_COMPARABLE'
   296	            knobs.append(entry)
   297	            bad(f'knob {knob} outside valid domain: {ctext!r} vs {rtext!r}', i + 1)
   298	        elif cv <= rv:
   299	            entry['status'] = 'EQUAL' if cv == rv else 'DECREASE'
   300	            knobs.append(entry)
   301	        else:
   302	            entry['status'] = 'INCREASE'
   303	            knobs.append(entry)
   304	            bad(f'knob {knob} increased: {ctext} > {rtext}', i + 1)
   305	    return None
   306	
