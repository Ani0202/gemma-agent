   308	def check(cand_zip, ref_zip):
   309	    cand, cprob = read_zip(cand_zip)
   310	    ref, rprob = read_zip(ref_zip)
   311	    violations, knobs, files = [], [], {}
   312	    for side, probs in (('candidate', cprob), ('reference', rprob)):
   313	        for p in probs:
   314	            violations.append({'file': f'<{side} zip>', 'path': [], 'reason': p})
   315	    for name in sorted(set(cand) - set(ref)):
   316	        violations.append({'file': name, 'path': [], 'reason': 'file only in candidate'})
   317	        files[name] = 'ONLY_CANDIDATE'
   318	    for name in sorted(set(ref) - set(cand)):
   319	        violations.append({'file': name, 'path': [], 'reason': 'file only in reference'})
   320	        files[name] = 'ONLY_REFERENCE'
   321	    allowed, notes = allowed_files(ref, set(cand))
   322	    for name in sorted(set(cand) & set(ref)):
   323	        if cand[name] == ref[name]:
   324	            files[name] = 'BYTE_IDENTICAL'
   325	            continue
   326	        if name not in allowed:
   327	            files[name] = 'DIFFERS'
   328	            violations.append({'file': name, 'path': [], 'reason': 'not byte-identical (no knob allowance)'})
   329	            continue
   330	        before = len(violations)
   331	        compare_allowed(name, cand[name], ref[name], allowed[name], knobs, violations)
   332	        files[name] = 'DIFFERS' if len(violations) > before else 'KNOB_ONLY'
   333	    return {'files': files, 'knobs': knobs, 'violations': violations,
   334	            'allowed_files': {k: sorted('/'.join(map(str, p)) for p in v) for k, v in sorted(allowed.items())},
   335	            'notes': notes, 'verdict': 'INELIGIBLE' if violations else 'ELIGIBLE'}
   336	
   337	
   338	def check_reference_lb(lb_path, ref_sha):
   339	    with open(lb_path) as f:
   340	        lb = json.load(f)
   341	    problems = []
   342	    if lb.get('status') != 'COMPLETE':
   343	        problems.append(f"reference lb status {lb.get('status')!r} != 'COMPLETE'")
   344	    if lb.get('public_score') is None:
   345	        problems.append('reference lb public_score missing')
   346	    if lb.get('sha256') != ref_sha:
   347	        problems.append(f"reference lb sha256 {lb.get('sha256')!r} != reference zip {ref_sha}")
   348	    return {'path': lb_path, 'status': lb.get('status'), 'public_score': lb.get('public_score'),
   349	            'submission_ref': lb.get('submission_ref'), 'problems': problems}
   350	
   351	
   352	def main(argv=None):
   353	    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
   354	    ap.add_argument('candidate')
   355	    ap.add_argument('reference')
   356	    ap.add_argument('--reference-lb')
   357	    ap.add_argument('--out')
   358	    a = ap.parse_args(argv)
   359	    try:
   360	        res = check(a.candidate, a.reference)
   361	    except (OSError, zipfile.BadZipFile, ValueError) as e:
   362	        print(f'ERROR: {e}', file=sys.stderr)
   363	        return 2
   364	    out = {'_schema': SCHEMA, 'rule': 'ops/decisions/087-20261107T090954-880-from-builder.md item 1 (b)',
   365	           'candidate': {'zip': a.candidate, 'sha256': sha256_file(a.candidate)},
   366	           'reference': {'zip': a.reference, 'sha256': sha256_file(a.reference)}, **res}
   367	    if a.reference_lb:
   368	        out['reference_lb'] = check_reference_lb(a.reference_lb, out['reference']['sha256'])
   369	        if out['reference_lb']['problems']:
   370	            out['verdict'] = 'INELIGIBLE'
   371	    text = json.dumps(out, indent=1, default=repr)
   372	    if a.out:
   373	        with open(a.out, 'w') as f:
   374	            f.write(text + '\n')
   375	    print(f"{out['verdict']}: {a.candidate} vs {a.reference} "
   376	          f"({len(out['violations'])} violations"
   377	          f"{', ref-lb problems ' + str(len(out['reference_lb']['problems'])) if a.reference_lb else ''})")
   378	    for v in out['violations'][:20]:
   379	        print(f"  - {v['file']} {'/'.join(map(str, v['path']))}: {v['reason']}")
   380	    return 0 if out['verdict'] == 'ELIGIBLE' else 1
   381	
   382	
   383	if __name__ == '__main__':
   384	    sys.exit(main())

