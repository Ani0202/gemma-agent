   189	def allowed_files(ref, other_names=()):
   190	    """{file: {path tuple: knob}} for files whose knob lines may change (derived from REFERENCE).
   191	    Files inside any skill directory (dir of a SKILL.md in either zip, or a path named under a
   192	    `skills` key of an agent doc) never get an allowance: skills must be byte-identical."""
   193	    names, out, notes, skill_refs = set(ref), {}, [], set()
   194	    if EVAL_CONFIG in names:
   195	        out[EVAL_CONFIG] = dict(EVAL_PATHS)
   196	    todo, done = [ROOT_AGENT] if ROOT_AGENT in names else [], set()
   197	    while todo:
   198	        doc = todo.pop()
   199	        if doc in done:
   200	            continue
   201	        done.add(doc)
   202	        try:
   203	            root = compose(ref[doc], doc)
   204	            nodes = list(walk_paths(root)) if root is not None else []
   205	        except ValueError as e:
   206	            notes.append(f'agent doc {doc} not analyzable, no allowance: {e}')
   207	            continue
   208	        for path, node in nodes:
   209	            if 'skills' in path and isinstance(node, yaml.ScalarNode):
   210	                skill_refs.update(resolve_all(node.value, doc))
   211	        if has_merge_key(nodes):
   212	            notes.append(f'agent doc {doc} uses a YAML merge key, no allowance and no sub-agent discovery')
   213	            continue
   214	        perms = out.setdefault(doc, {})
   215	        for path, node in nodes:
   216	            if (len(path) == 4 and path[0] == 'tools' and isinstance(path[1], int)
   217	                    and path[2] == 'agent_tool' and path[3] == 'config_path'
   218	                    and isinstance(node, yaml.ScalarNode)):
   219	                t = resolve(node.value, doc, names)
   220	                if t is None:
   221	                    notes.append(f'{doc}: config_path {node.value!r} missing/ambiguous')
   222	                else:
   223	                    todo.append(t)
   224	        for path, node in nodes:
   225	            if path == ('generate_content_config',):
   226	                if isinstance(node, yaml.MappingNode):
   227	                    for rel, knob in GCC_REL.items():
   228	                        perms[('generate_content_config',) + rel] = knob
   229	                elif isinstance(node, yaml.ScalarNode) and node.tag == '!include':
   230	                    t = resolve(node.value, doc, names)
   231	                    if t is None:
   232	                        notes.append(f'{doc}: gcc include {node.value!r} missing/ambiguous, no allowance')
   233	                    else:
   234	                        out.setdefault(t, {}).update(GCC_REL)
   235	    skill_roots = skill_refs | {posixpath.dirname(n) for n in names | set(other_names)
   236	                                if posixpath.basename(n).lower() == 'skill.md'}
   237	    for f in sorted(out):
   238	        hit = sorted(r for r in skill_roots if under(f, r))
   239	        if hit:
   240	            notes.append(f'{f}: inside skill dir {hit[0]!r}, no allowance (must be byte-identical)')
   241	            del out[f]
   242	    return out, notes
