   131	def walk_paths(root):
   132	    """Yield (path tuple, node) for every node; alias cycles cut by node identity on the path.
   133	    Raises ValueError on duplicate mapping keys."""
   134	    stack = [((), root, frozenset())]
   135	    while stack:
   136	        path, node, onpath = stack.pop()
   137	        yield path, node
   138	        if id(node) in onpath:
   139	            continue
   140	        onpath = onpath | {id(node)}
   141	        if isinstance(node, yaml.MappingNode):
   142	            keys = []
   143	            for k, v in node.value:
   144	                key = (k.tag, k.value) if isinstance(k, yaml.ScalarNode) else ('<complex>', id(k))
   145	                if key in keys:
   146	                    raise ValueError(f'duplicate mapping key {k.value!r} at {"/".join(map(str, path))}')
   147	                keys.append(key)
   148	                label = k.value if isinstance(k, yaml.ScalarNode) else '<complex>'
   149	                stack.append((path + (label,), v, onpath))
   150	        elif isinstance(node, yaml.SequenceNode):
   151	            for idx, v in enumerate(node.value):
   152	                stack.append((path + (idx,), v, onpath))
