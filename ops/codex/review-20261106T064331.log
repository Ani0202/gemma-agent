   989	def distribution(values):
   990	    values = sorted(values)
   991	    def percentile(q):
   992	        x = (len(values) - 1) * q
   993	        lo = int(x)
   994	        return values[lo] + (values[min(lo + 1, len(values)-1)] - values[lo]) * (x-lo)
   995	    return dict(mean=sum(values)/len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))
