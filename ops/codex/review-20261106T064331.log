  1140	    from swegemma.config import ALLOWED_ADAPTER_EXTENSIONS
  1141	    MODEL_VLLM_EXTRA_ARGS = {'gemma-4-12b-it-qat-w4a16-ct': (
  1142	        '--hf-overrides', '{"architectures": ["Gemma4ForCausalLM"], "model_type": "gemma4"}')}
  1143	    _SAFE_PATH_COMPONENT = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')
  1144	    declared_models = discover_declared_models(BUNDLE)
  1145	    assert len(declared_models) == 1, f'Expected exactly 1 declared model, got: {sorted(declared_models)}'
  1146	    declared_model = next(iter(declared_models))
  1147	    assert declared_model in {'gemma-4-' + x + '-it-qat-w4a16-ct' for x in ('31b', '12b', 'e4b', 'e2b')}, 'Unsupported declared model'
  1148	    MODEL_PATH = Path(f'/kaggle/input/models/google/gemma-4/other/{declared_model}/2')
  1149	    assert MODEL_PATH.exists(), f'Model weights not found at {MODEL_PATH}. Ensure the model input is attached.'
  1150	    adapters = discover_adapters(str(BUNDLE), adapter_extensions=ALLOWED_ADAPTER_EXTENSIONS)
  1151	    adapter_map = getattr(adapters, 'adapters', None) or {}
  1152	    for adapter_name in adapter_map:
  1153	        assert _SAFE_PATH_COMPONENT.fullmatch(adapter_name), 'Unsafe adapter name'
  1154	    detected_ranks = [r for info in adapter_map.values() if (r := getattr(info, 'rank', None)) is not None and r > 0]
  1155	    gpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1
  1156	    tp_size = 4 if gpu_count >= 4 else (2 if gpu_count >= 2 else 1)
  1157	    vllm_cfg = VllmConfig(
  1158	        model=str(MODEL_PATH), port=8000, host='127.0.0.1',
  1159	        tool_call_parser='gemma4', reasoning_parser='gemma4', max_model_len=32768,
  1160	        dtype='bfloat16' if (torch.cuda.is_available() and torch.cuda.is_bf16_supported()) else 'auto',
  1161	        gpu_memory_utilization=0.90, enable_auto_tool_choice=True,
  1162	        enable_lora=bool(adapter_map), max_loras=max(1, len(adapter_map)),
  1163	        max_lora_rank=max(detected_ranks) if detected_ranks else 128,
  1164	        scheduler_reserve_full_isl=False, tensor_parallel_size=tp_size, startup_timeout=60 * 20,
  1165	        extra_args=MODEL_VLLM_EXTRA_ARGS.get(declared_model, ()),
