   424	# Capture setup.py's otherwise discarded subprocess output without changing setup.py.
   425	# Write after EVERY call so an outer timeout still leaves completed calls visible.
   426	SETUP_OBSERVER = r'''import json, runpy, subprocess, sys, time
   427	from pathlib import Path
   428	original = subprocess.run
   429	calls = []
   430	log = Path(__file__).with_name('setup_subprocesses.json')
   431	log.write_text('[]')
   432	full_log = log.with_name('setup_subprocesses_full.jsonl')
   433	full_log.write_text('')
   434	def run(*args, **kwargs):
   435	    start = time.perf_counter()
   436	    argv = args[0] if args else kwargs.get('args')
   437	    result = None
   438	    try:
   439	        result = original(*args, **kwargs)
   440	        return result
   441	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   442	        result = exc
   443	        raise
   444	    finally:
   445	        def decode(value):
   446	            return value.decode(errors='replace') if isinstance(value, bytes) else (value or '')
   447	        out, err = decode(getattr(result, 'stdout', '')), decode(getattr(result, 'stderr', ''))
   448	        with full_log.open('a') as stream:
   449	            stream.write(json.dumps(dict(argv=argv, stdout=out, stderr=err)) + '\n')
   450	        calls.append(dict(argv=argv, duration_s=time.perf_counter()-start,
   451	            start_offset_s=start-origin, rc=getattr(result, 'returncode', None),
   452	            stdout=out.encode()[-2048:].decode(errors='ignore'),
   453	            stderr=err.encode()[-2048:].decode(errors='ignore'),
   454	            retrying_lines=sum('Retrying' in line for line in (out+'\n'+err).splitlines()),
   455	            interpreter_version=sys.version))
   456	        log.write_text(json.dumps(calls))
   457	origin = time.perf_counter()
   458	subprocess.run = run
   459	sys.argv = sys.argv[1:]
   460	runpy.run_path(sys.argv[0], run_name='__main__')
   461	'''
