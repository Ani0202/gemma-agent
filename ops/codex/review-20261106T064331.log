   806	async def skip_verification(docker, config, task, snapshot_path, *, agent_patch='',
   807	                            agent_error=None, trace=None, start_time=0.0, **kwargs):
   808	    """Return the harness result type without starting Container B or running tests."""
   809	    from swegemma.models import TaskResult
   810	    result = TaskResult(instance_id=task.instance_id, repo=task.repo, resolved=False,
   811	        agent_patch=agent_patch, test_output='', test_exit_code=0,
   812	        duration_seconds=time.perf_counter() - start_time, error=agent_error, trace=trace)
   813	    # swegemma 0.2.11 annotates this field int, with assignment validation disabled.
   814	    result.test_exit_code = None
   815	    return result
