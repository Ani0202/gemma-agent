   703	def observe_patch_strip(original, state):
   704	    """Retain the agent's diff before the harness removes protected edits."""
   705	    def strip(patch, *pos, **kw):
   706	        current = state.get(None)
   707	        filtered = original(patch, *pos, **kw)
   708	        if current is not None and current.get('agent_active'):
   709	            if patch != current.get('filtered_patch'):
   710	                current['raw_patch'] = patch
   711	            current['filtered_patch'] = filtered
   712	        return filtered
   713	    return strip
