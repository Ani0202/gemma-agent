   345	def wheel_metadata(path):
   346	    from email.parser import BytesParser
   347	    import zipfile
   348	    with zipfile.ZipFile(path) as archive:
   349	        name = next(n for n in archive.namelist() if n.endswith('.dist-info/METADATA'))
   350	        return BytesParser().parsebytes(archive.read(name))
