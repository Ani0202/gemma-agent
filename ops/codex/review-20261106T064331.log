   464	def patch_subprocess_deps(data_dir, state=None):
   465	    """Install scorer tools in each venv, using that interpreter's ABI, entirely offline."""
   466	    import swegemma.harness.container_setup as cs
   467	    from packaging.utils import parse_wheel_filename
   468	    orig = getattr(cs.install_test_dependencies, '_timing_original', cs.install_test_dependencies)
   469	    wheels = data_dir / 'wheels'
   470	    if not wheels.is_dir():
   471	        wheels = WHEELHOUSE
   472	    setup = data_dir / 'sandbox' / 'setup.py'
   473	    if not setup.exists():
   474	        setup = next(iter(data_dir.rglob('setup.py')), setup)
   475	
   476	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   477	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   478	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   479	        current = state.get() if state is not None else dict(
   480	            started=time.perf_counter(), setup_calls=[], setup_failed=False)
   481	        fixed = os.environ.get('SETUP_FIX', '1') == '1'
   482	        current['setup_fix'] = int(fixed)
   483	        venv = docker.sandboxes[container_id]['venv']
   484	        sp = next(iter(sorted(venv.glob('lib/python3*/site-packages'))))
   485	        if not fixed:
   486	            # Preserve the original injector's wheel selection and base tar exactly.
   487	            def original_base():
   488	                base, large, _modules, _requirements = cs._inspect_wheels_dir(wheels)
   489	                if large:
   490	                    raise RuntimeError('large wheels present; workspace-import scan not emulated')
   491	                current['wheel_tags_chosen'] = [p.name for p in base]
   492	                inject_base(cs, base, sp, current)
   493	            setup_step(current, 'base_tar_extraction', original_base)
   494	            record_distributions(docker, container_id, repo, current['setup_calls'][-1])
   495	        else:
   496	            # A subprocess venv otherwise exposes every kernel package via _host_env.pth.
   497	            # Only the scorer's image tools and public base wheels belong here.
   498	            def isolate_venv():
   499	                for pth in sp.glob('_host_env.pth'):
   500	                    pth.unlink()
   501	                cfg = venv / 'pyvenv.cfg'
   502	                if cfg.exists():
   503	                    cfg.write_text(cfg.read_text().replace(
   504	                        'include-system-site-packages = true', 'include-system-site-packages = false'))
   505	            setup_step(current, 'venv_fidelity', isolate_venv)
   506	            pip_wheel = fallback_wheel(wheels, 'pip')
   507	            def bootstrap_pip():
   508	                if pip_wheel:
   509	                    current['setup_calls'][-1]['source'] = str(pip_wheel)
   510	                    import zipfile
   511	                    with zipfile.ZipFile(pip_wheel) as zf:
   512	                        zf.extractall(sp)
   513	                else:
   514	                    current['setup_calls'][-1]['source'] = copy_runtime_package('pip', sp)
   515	                    if current['setup_calls'][-1]['source'] == 'missing':
   516	                        raise RuntimeError('No offline pip source available')
   517	                return docker.exec(container_id, 'python3 -m pip --version', timeout=30)
   518	            result = setup_step(current, 'pip_bootstrap', bootstrap_pip)
   519	            if result.exit_code != 0:
   520	                raise RuntimeError('Sandbox pip bootstrap failed')
   521	            probe = ("import sys,json;from pip._vendor.packaging.tags import sys_tags;"
   522	                     "from pip._vendor.packaging.markers import default_environment;"
   523	                     "print(json.dumps({'version':sys.version,'tags':[str(t) for t in sys_tags()],"
   524	                     "'environment':default_environment()}))")
   525	            result = setup_step(current, 'interpreter_probe', lambda: docker.exec(
   526	                container_id, 'python3 -c ' + shlex.quote(probe), timeout=30))
   527	            if result.exit_code != 0:
   528	                raise RuntimeError('Sandbox interpreter probe failed')
   529	            identity = json.loads(result.stdout)
   530	            current['interpreter_version'] = identity['version']
   531	            selected = compatible_wheels(wheels, identity['tags'])
   532	            # The image pins pytest-timeout, even if a newer wheel is present.
   533	            selected.pop('pytest-timeout', None)
   534	            for path in pytest_timeout_wheels(wheels):
   535	                if {str(t) for t in parse_wheel_filename(path.name)[3]} & set(identity['tags']):
   536	                    selected['pytest-timeout'] = path
   537	                    break
   538	            current['wheel_tags_chosen'] = [p.name for p in selected.values()]
   539	            def validate_tools():
   540	                missing = [n for n in SCORER_TOOLS if n not in selected and n not in ('pip', 'pytest-timeout')]
   541	                if missing:
   542	                    raise RuntimeError('Required compatible tools missing: ' + ', '.join(missing))
   543	            setup_step(current, 'tool_sources', validate_tools)
   544	            def timeout_source():
   545	                source = selected.get('pytest-timeout')
   546	                current['setup_calls'][-1]['source'] = str(source) if source else copy_runtime_package('pytest-timeout', sp)
   547	                if current['setup_calls'][-1]['source'] == 'missing':
   548	                    raise RuntimeError('No offline pytest-timeout 2.1.0 source available')
   549	            setup_step(current, 'pytest_timeout_source', timeout_source)
   550	            def install_tools():
   551	                for path in selected.values():
   552	                    docker.copy_to(container_id, path, '/wheels/' + path.name)
   553	                tools = ['/wheels/' + selected[n].name for n in SCORER_TOOLS
   554	                         if n in selected and n != 'pip']
   555	                return docker.exec(container_id,
   556	                    'python3 -m pip install --ignore-installed --no-index --find-links=/wheels --no-deps ' +
   557	                    ' '.join(shlex.quote(n) for n in tools), timeout=60)
   558	            result = setup_step(current, 'tool_install', install_tools)
   559	            if result.exit_code != 0:
   560	                raise RuntimeError('Offline scorer tool installation failed')
   561	            def tool_deps():
   562	                from importlib.metadata import distributions
   563	                roots = [wheel_metadata(selected[n]) for n in SCORER_TOOLS if n in selected]
   564	                roots.extend(d.metadata for d in distributions(path=[str(sp)])
   565	                             if d.metadata['Name'].lower() in ('pip', 'pytest-timeout')
   566	                             and d.metadata['Name'].lower() not in selected)
   567	                def install_dependency(path):
   568	                    docker.copy_to(container_id, path, '/wheels/' + path.name)
   569	                    result = docker.exec(container_id,
   570	                        'python3 -m pip install --ignore-installed --no-index --find-links=/wheels --no-deps ' +
   571	                        shlex.quote('/wheels/' + path.name), timeout=60)
   572	                    setup_artifact(current, dict(step='tool_deps', wheel=path.name,
   573	                        stdout=result.stdout, stderr=result.stderr))
   574	                    current['setup_calls'][-1]['retrying_lines'] += sum(
   575	                        'Retrying' in line for line in (result.stdout + '\n' + result.stderr).splitlines())
   576	                    return result
   577	                entries, missing = close_tool_dependencies(
   578	                    roots, wheels, identity['tags'], identity['environment'], sp, install_dependency)
   579	                current['setup_calls'][-1]['dependencies'] = entries
   580	                current['missing_tool_deps'] = missing
   581	                if missing:
   582	                    current.update(status='failed', reason='missing_tool_deps')
   583	                    raise RuntimeError('missing_tool_deps: ' + ', '.join(missing))
   584	            setup_step(current, 'tool_deps', tool_deps)
   585	            setup_step(current, 'pip_check', lambda: docker.exec(
   586	                container_id, 'python3 -m pip check', timeout=30), fatal=False)
   587	            # Docker's hook ignores failure, but observe the real pip rc and both streams.
   588	            setup_step(current, 'workspace_editable', lambda: docker.exec(container_id,
   589	                'python3 -m pip install --no-index --find-links=/wheels --no-build-isolation --no-deps -e /workspace',
   590	                timeout=280), fatal=False)
   591	            current['workspace_editable_rc'] = current['setup_calls'][-1]['rc']
   592	            current['editable_failed'] = current['workspace_editable_rc'] != 0
   593	            current['setup_failed'] |= current['editable_failed']
   594	            record_distributions(docker, container_id, repo, current['setup_calls'][-1])
   595	            def extract_base():
   596	                base = [p for name, p in selected.items() if name not in BASE_SKIP]
   597	                if any(p.stat().st_size >= cs._LARGE_WHEEL_THRESHOLD_BYTES for p in base):
   598	                    raise RuntimeError('large wheels present; workspace-import scan not emulated')
   599	                inject_base(cs, base, sp, current)
   600	            setup_step(current, 'base_tar_extraction', extract_base)
   601	            record_distributions(docker, container_id, repo, current['setup_calls'][-1])
   602	        def run_setup():
   603	            docker.copy_to(container_id, setup, '/tmp/setup.py')
   604	            # All observer files are scratch files, never workspace patch inputs.
   605	            observer = docker.sandboxes[container_id]['tmp'] / 'setup_observer.py'
   606	            observer.write_text(SETUP_OBSERVER)
   607	            return docker.exec(container_id, setup_command(repo, fast_path), timeout=280)
   608	        try:
   609	            setup_step(current, 'setup.py', run_setup)
   610	        finally:
   611	            log = docker.sandboxes[container_id]['tmp'] / 'setup_subprocesses.json'
   612	            calls = json.loads(log.read_text()) if log.exists() else []
   613	            full_log = log.with_name('setup_subprocesses_full.jsonl')
   614	            if full_log.exists():
   615	                for line in full_log.read_text().splitlines():
   616	                    setup_artifact(current, dict(step='setup.py', **json.loads(line)))
   617	            current['setup_subprocesses'] = calls
   618	            setup_row = next(c for c in reversed(current['setup_calls']) if c['step'] == 'setup.py')
   619	            setup_row['subprocesses'] = calls
   620	            setup_row['retrying_lines'] += sum(c['retrying_lines'] for c in calls)
   621	            current['retrying_lines'] = sum(c['retrying_lines'] for c in current['setup_calls'])
   622	            editable = [c for c in calls if isinstance(c['argv'], list) and '-e' in c['argv']]
   623	            current['editable_rc'] = editable[0]['rc'] if editable else None
   624	            current['editable_final_rc'] = editable[-1]['rc'] if editable else None
   625	            current['editable_failed'] = any(c['rc'] != 0 for c in editable) or current.get('workspace_editable_rc', 0) != 0
   626	            current['setup_failed'] |= current['editable_failed']
   627	            record_distributions(docker, container_id, repo, setup_row)
   628	            if calls:
   629	                current['interpreter_version'] = calls[0]['interpreter_version']
   630	            else:
   631	                current.setdefault('interpreter_version', None)
   632	        current['status'] = 'failed' if current['setup_failed'] else 'passed'
   633	        return current
   634	    install._timing_original = orig
   635	    for name, module in list(sys.modules.items()):
   636	        if name.startswith('swegemma.') and hasattr(module, 'install_test_dependencies'):
   637	            module.install_test_dependencies = install
   638	    return install
