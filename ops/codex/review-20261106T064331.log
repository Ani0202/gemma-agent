   312	def runtime_copyable(name):
   313	    """(dist, files) if copy_runtime_package can copy this runtime package, else None. Copies nothing."""
   314	    from importlib.metadata import distribution, PackageNotFoundError
   315	    try:
   316	        dist = distribution(name)
   317	    except PackageNotFoundError:
   318	        return None
   319	    if name == 'pytest-timeout' and dist.version != '2.1.0':
   320	        return None
   321	    # Distribution names need not match import names (trove-classifiers, PyYAML).
   322	    files = list(dist.files or [])
   323	    if not files or any(str(p).endswith(('.so', '.pyd', '.dll', '.dylib')) for p in files):
   324	        return None
   325	    files = [p for p in files if '..' not in p.parts and not p.is_absolute()
   326	             and not p.parts[0].endswith('.data')]
   327	    if not any(str(p).endswith('.py') and not p.parts[0].endswith('.dist-info') for p in files):
   328	        return None
   329	    return dist, files
