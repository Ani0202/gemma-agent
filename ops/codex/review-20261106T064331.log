   353	def close_tool_dependencies(roots, wheels, tags, environment, destination, install_wheel):
   354	    """Walk runtime requirements only, using sandbox markers and no pip resolver.
   355	
   356	    Existing sandbox metadata describes base wheels and copied tools. Each requirement
