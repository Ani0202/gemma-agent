def _unquote_git_path(raw: str) -> str:
    """Unquotes a git diff file path and strips leading a/ or b/ prefixes."""
    s = raw.strip()
    if not s:
        return ''
    if s.startswith('"'):
        end = 1
        while end < len(s):
            if s[end] == '"' and s[end - 1] != '\\':
                break
            end += 1
        s = s[1:end].encode('utf-8').decode('unicode_escape')
    else:
        s = s.split('\t', 1)[0].strip()
    if s.startswith(('a/', 'b/')):
        s = s[2:]
    return s.strip()


