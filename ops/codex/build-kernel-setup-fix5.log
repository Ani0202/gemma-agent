            context.stop_agent_session()
        if file_display_mgr is not None:
            file_display_mgr.stop()
        if log_file is not None:
            log_file.flush()
            log_file.close()
        await sandbox_stop(docker, sandbox_id)

    return agent_patch, agent_error, trace
