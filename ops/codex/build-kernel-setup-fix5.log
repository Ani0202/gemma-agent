                        trace_json_path=json_path,
                    )
            finally:
                test_patch_host_path.unlink(missing_ok=True)

        # Refresh workspace paths, stubs, and pytest config after patches add new files/imports
        await asyncio.to_thread(
            install_test_dependencies,
