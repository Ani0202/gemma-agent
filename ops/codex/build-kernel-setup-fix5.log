                diff_res = await sandbox_exec(
                    docker,
                    sandbox_id,
                    'cd /workspace && (git diff --binary _swegemma_baseline 2>/dev/null || git diff --binary HEAD)',
                )
                unsubmitted_diff = diff_res.stdout or ''
                if not is_synthetic_mock_repo and unsubmitted_diff.strip():
