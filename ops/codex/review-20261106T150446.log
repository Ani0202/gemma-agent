   428	def _schema(mode, paths):
   429	    # Legacy modes retain the frozen pre-extension implementation fingerprint to
   430	    # honor their byte-identical output contract. New modes hash this full script.
   431	    return dict(name='plan008_metrics/v1', mode=mode, definitions=dict(DEFINITIONS, **ARM3_DEFINITIONS) if mode in ('arm3', 'arm3smoke') else DEFINITIONS,
   432	                script_sha256=(base.sha(__file__) if mode in ('arm3', 'arm3smoke') else
   433	                               'b9c2cb5efed8a5d2e0e3b0bcbb0f530f4cc8ab59dcb3daa0d414c42dabe4557a'),
   434	                input_shas={str(p): base.sha(p) for p in dict.fromkeys(map(Path, paths))})
