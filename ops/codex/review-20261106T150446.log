   945	def arm3_cli(argv):
   946	    import argparse
   947	    parser = argparse.ArgumentParser(description='Plan 009 CPU/offline metrics')
   948	    parser.add_argument('mode', choices=['arm3', 'arm3smoke'])
   949	    if argv[1] == 'arm3smoke':
   950	        parser.add_argument('run_dir')
   951	        parser.add_argument('classifier')
   952	        parser.add_argument('out_json')
   953	        args = parser.parse_args(argv[1:])
   954	        out = arm3smoke_metrics(args.run_dir, args.classifier)
   955	    else:
   956	        parser.add_argument('base', choices=['arm1', 'arm2'])
   957	        parser.add_argument('out_json')
   958	        parser.add_argument('--arm3', nargs='+', required=True)
   959	        parser.add_argument('--base-dirs', nargs='+', default=[])
   960	        parser.add_argument('--classifiers', action='append', default=[])
   961	        parser.add_argument('--smoke-json')
   962	        args = parser.parse_args(argv[1:])
   963	        classifiers = {}
   964	        for value in args.classifiers:
   965	            if '=' not in value:
   966	                parser.error('--classifiers requires DIR=D4_JSON,A2_JSON')
   967	            directory, pair = value.split('=', 1)
