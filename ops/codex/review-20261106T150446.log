   217	    for mod in (m, legacy):
   218	        monkeypatch.setattr(mod, 'expected_ids', lambda kind: registered)
   219	        monkeypatch.setattr(mod, '_tasks_path', lambda: tmp_path / 'absent-tasks')
   220	    for function in ('smoke_metrics', 'arm2_metrics'):
   221	        assert json.dumps(getattr(m, function)(directory), indent=2) == json.dumps(getattr(legacy, function)(directory), indent=2)
