   750	def aggregate_arm(dirs, classifiers):
   751	    """Inventory first, before loading classifier/trace evidence. Never drop a row."""
   752	    selected, occurrences, paths, headers = {}, defaultdict(list), [], []
   753	    for directory in dirs:
   754	        timing = Path(directory) / 'timing.jsonl'
   755	        if not timing.is_file():
   756	            raise IncompleteRun(dict(dir=str(directory), missing_timing=True))
   757	        try:
   758	            rows = base.load_rows(timing)
   759	        except AssertionError:
   760	            raw = [json.loads(l) for l in timing.read_text().splitlines() if l.strip()]
   761	            inv = inventory([r['instance_id'] for r in raw if 'instance_id' in r], base.ids_file(base.ARM_IDS))
   762	            raise IncompleteRun(dict(dir=str(directory), inventory=inv))
   763	        paths.append(timing)
   764	        headers.extend(_headers(timing))
   765	        for row in rows:
   766	            iid = row['instance_id']
   767	            occurrences[iid].append(str(directory))
   768	            selected.setdefault(iid, (row, str(directory)))
   769	    inv = inventory(list(selected), base.ids_file(base.ARM_IDS))
   770	    inv['duplicates'] = [dict(instance_id=i, dirs=ds) for i, ds in occurrences.items() if len(ds) > 1]
   771	    if not inv['complete']:
   772	        raise IncompleteRun(inv)
   773	    classified = {}
   774	    for directory in dirs:
   775	        timing = Path(directory) / 'timing.jsonl'
   776	        d4, a2 = classifiers[str(Path(directory))]
   777	        rows = base.load_rows(timing)
   778	        classified[str(directory)] = _classifier(timing, d4, base.D4_SHA, rows)
   779	        _classifier(timing, a2, base.A2_SHA, rows)
   780	        paths.extend((d4, a2))
   781	    records = []
   782	    for iid in base.ids_file(base.ARM_IDS):
   783	        row, directory = selected[iid]
   784	        trace = Path(directory) / 'runs' / iid / 'trace.json'
   785	        entries = json.loads(trace.read_text()).get('entries') or []
   786	        paths.append(trace)
   787	        records.append((row, classified[directory][iid], trace, entries))
   788	    return records, inv, paths, headers
