   657	    'safety': 'arm3 test_files_edited and stray_files zero rows; total wall p90 <=1.10*base; empty and submitted_without_test <=base+3; missing evidence fails',
   658	    'thinking': 'thinking_bound.task: root author swe_baseline_agent, type thinking, nonempty content; blocks/chars per task and tasks>0',
   659	    'arm3smoke': 'first two registered ids exactly; i each >=1 thinking block and sum>=5; ii timing; iii verification verdict, zero H, agreeing identity headers; missing -> UNVERIFIABLE',
