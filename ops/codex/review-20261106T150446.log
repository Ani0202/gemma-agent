    26	    bdir = os.path.join(ROOT, "bundles", "31b", v)
    27	    zpath = os.path.join(ROOT, "dist", f"31b-{v}.zip")
    28	    man = open(os.path.join(bdir, "MANIFEST.md")).read()
    29	    m = re.search(r"zip sha256:\s*([0-9a-f]{64})", man)
    30	    manifest_sha = m.group(1) if m else None
    31	    with open(zpath, "rb") as f:
    32	        zsha = sha(f.read())
    33	    zfiles = {}
    34	    dup = []
    35	    with zipfile.ZipFile(zpath) as z:
    36	        for info in z.infolist():
    37	            if info.is_dir():
    38	                continue
    39	            if info.filename in zfiles:
    40	                dup.append(info.filename)  # duplicate member names could hide unmatched bytes
    41	            zfiles[info.filename] = sha(z.read(info))
    42	    dup = sorted(set(dup))
    43	    dfiles = {}
    44	    for dp, dn, fn in os.walk(bdir):
    45	        for n in fn:
    46	            full = os.path.join(dp, n)
    47	            rel = os.path.relpath(full, bdir).replace(os.sep, "/")
    48	            with open(full, "rb") as f:
    49	                dfiles[rel] = sha(f.read())
    50	    excluded = []
    51	    if "MANIFEST.md" in dfiles:
    52	        del dfiles["MANIFEST.md"]
    53	        excluded.append("MANIFEST.md")
    54	    only_z = sorted(set(zfiles) - set(dfiles))
    55	    only_d = sorted(set(dfiles) - set(zfiles))
    56	    mism = sorted(p for p in set(zfiles) & set(dfiles) if zfiles[p] != dfiles[p])
    57	    zip_ok = manifest_sha is not None and manifest_sha == zsha
    58	    content_ok = not (only_z or only_d or mism or dup)
    59	    return {"zip_path": os.path.relpath(zpath, ROOT), "zip_sha256": zsha, "manifest_zip_sha256": manifest_sha,
    60	            "zip_ok": zip_ok, "content_ok": content_ok, "only_in_zip": only_z, "only_in_dir": only_d,
