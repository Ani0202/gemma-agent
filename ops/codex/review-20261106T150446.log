   473	def load_task_test_files(tasks_path):
   474	    # Match agent_timing.evaluate / run_agent_eval.run: the Task property derives
   475	    # these paths from test_patch. Never use gold patch or test text as agent input.
   476	    from swegemma.models import load_tasks
   477	    tasks = load_tasks(Path(tasks_path))
   478	    inventory = {t.instance_id: list(t.test_files) for t in tasks}
   479	    if len(inventory) != len(tasks):
   480	        raise ValueError('duplicate task IDs')
   481	    return inventory
