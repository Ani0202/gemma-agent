   971	            classifiers[str(Path(directory))] = files
   972	        required = args.arm3 + (args.base_dirs if args.base == 'arm2' else [])
   973	        if any(str(Path(d)) not in classifiers for d in required):
   974	            parser.error('--classifiers required for every arm3 and arm2-base dir')
   975	        if args.base == 'arm2' and not args.base_dirs:
   976	            parser.error('--base-dirs required for arm2')
