   160	                 and _patch_size(p['response']) is not None]
   161	        gates.append(dict(c, root_index=i, children=children, inner_successes=inner,
   162	                          canonical_reply=_reply(c['response']) if canonical else '',
   163	                          canonical_index=reply_index if canonical else None))
