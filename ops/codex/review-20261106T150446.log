   738	    missing = bool(inv['missing']) or not rows or hs is None or identity_missing or verdict_missing
   739	    ciii = dict(status='FAIL' if inv['extra'] or inv['duplicates'] or identity_conflict or hs else
   740	                'UNVERIFIABLE' if missing else 'PASS', h_rows=hs, identity_headers=identity,
   741	                identity_checked_externally=True)
   742	    criteria = dict(i=ci, ii=cii, iii=ciii)
   743	    overall = 'PASS' if all(c['status'] == 'PASS' for c in criteria.values()) else 'FAIL'
