   682	def arm3_timing(rows):
   683	    bad = []
   684	    for row in rows:
   685	        fields = [k for k, limit in (('agent_clock_seconds', 220), ('finalization_seconds', 30))
   686	                  if not _finite_number(row.get(k)) or row[k] > limit]
   687	        if fields:
   688	            bad.append(dict(instance_id=row['instance_id'], fields=fields))
   689	    return dict(violations=bad, timing_pass=not bad)
