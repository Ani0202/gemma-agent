    92	            continue
    93	        key = (e.get('tool'), json.dumps(e.get('args', e.get('arguments')), sort_keys=True))
    94	        cur = cur + 1 if key == prev else 1
    95	        prev = key
    96	        if cur > best[0]:
    97	            best = (cur, key)
    98	    return [best[1]] if best[1] else []
