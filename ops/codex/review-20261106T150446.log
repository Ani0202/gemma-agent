    78	def _pairs(entries):
    79	    # Legacy trace has no call IDs. FIFO by (author, tool) also isolates nested tools.
    80	    pending, calls = defaultdict(deque), []
    81	    for i, e in enumerate(entries):
    82	        key = (e.get('author'), e.get('tool'))
    83	        if e.get('type') == 'tool_call':
    84	            c = dict(e, entry_index=i, response=None, response_index=None)
    85	            calls.append(c)
    86	            pending[key].append(c)
    87	        elif e.get('type') in ('tool_response', 'tool_result') and pending[key]:
    88	            c = pending[key].popleft()
    89	            c.update(response=e.get('result', ''), response_index=i)
    90	    return calls
