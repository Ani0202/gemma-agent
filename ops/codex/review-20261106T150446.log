   224	def test_missing_safety_and_environment(tmp_path, registered):
   225	    d1, c1 = make_run(tmp_path, 'on', registered)
   226	    d2, c2 = make_run(tmp_path, 'off', registered)
   227	    records, _, _, headers = m.aggregate_arm([d1], c1)
   228	    for row, _, _, _ in records:
   229	        row.pop('test_files_edited')
   230	        row.pop('verified_patch_bytes')
   231	        row.pop('patch_submitted')
   232	    summary = m.summarize_arm(records)
   233	    assert summary['safety']['test_files_edited'] == 'not available'
   234	    assert not summary['safety']['empty_patch_complete']
   235	    assert summary['safety']['submitted_without_test']['count'] == 3
   236	    env = m.environment_metrics(headers, records)
   237	    assert env['vllm_version'] == '1'
   238	    assert env['docker_image_digest'] is None
   239	    # Drift and kernel-path differences are reported, not silently ruled upon.
   240	    timing = Path(d2) / 'timing.jsonl'
   241	    data = [json.loads(l) for l in timing.read_text().splitlines()]
   242	    data[0]['kernel_code']['agent_path_sha256'] = 'd'*64
   243	    data[0]['gpu_count'] = 2
   244	    timing.write_text('\n'.join(map(json.dumps, data)))
   245	    for path in c2[d2]:
   246	        c = json.loads(Path(path).read_text())
   247	        c['input_sha256'] = m.base.sha(timing)
   248	        Path(path).write_text(json.dumps(c))
   249	    out = m.arm3_metrics('arm2', [d1], [d2], c1 | c2)
   250	    assert out['env_drift']['pairing_void_candidate'] is True
   251	    assert set(out['env_drift']['differences']) == {'kernel_code', 'gpu_count'}
   252	    assert out['decision'] == 'KEEP-OFF'

