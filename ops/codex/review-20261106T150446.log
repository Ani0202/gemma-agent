   725	                                 for k in ('agent_clock_seconds', 'finalization_seconds'))
   726	    cii = dict(status='UNVERIFIABLE' if missing_time else 'PASS' if ti['timing_pass'] else 'FAIL', **ti)
   727	    headers = _headers(timing) if timing.is_file() else []
   728	    identity = {k: [h.get(k) for h in headers] for k in ('agent_yaml_sha256', 'bundle_sha256')}
   729	    identity_missing = not headers or any(not v for vals in identity.values() for v in vals)
   730	    identity_conflict = any(len(set(vals)) > 1 for vals in identity.values())
