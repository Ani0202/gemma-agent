   701	def _classifier(timing, path, sha, rows):
   702	    c = json.loads(Path(path).read_text())
   703	    assert c['classifier_sha256'] == sha
   704	    assert c['input_sha256'] == base.sha(timing)
   705	    by_id = base.unique_map(c['rows'], path)
   706	    assert set(by_id) == {r['instance_id'] for r in rows}
   707	    for r in rows:
   708	        base.assert_paired(by_id[r['instance_id']], r)
   709	    return by_id
