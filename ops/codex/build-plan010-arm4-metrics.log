def assert_no_text(value):
    if isinstance(value, dict):
        for key, item in value.items():
            if key != 'definitions':
                assert_no_text(item)
    elif isinstance(value, list):
        for item in value:
            assert_no_text(item)
    elif isinstance(value, str):
        assert len(value) <= 200


