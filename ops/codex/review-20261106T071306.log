   156	def check_tool_sources(wheels):
   157	    """Before vLLM starts: every Dockerfile.public line-9 tool needs an offline wheel (or pip fallback)."""
   158	    from packaging.utils import canonicalize_name, parse_wheel_filename
   159	    names = set()
   160	    for w in Path(wheels).glob('*.whl'):
   161	        try:
   162	            names.add(canonicalize_name(parse_wheel_filename(w.name)[0]))
   163	        except Exception:
   164	            continue
   165	    missing = [n for n in SCORER_TOOLS if n not in ('pip', 'pytest-timeout') and canonicalize_name(n) not in names]
   166	    if not pytest_timeout_wheels(wheels):
   167	        missing.append('pytest-timeout==2.1.0')
   168	    if fallback_wheel(wheels, 'pip') is None and runtime_copyable('pip') is None:  # same sources as bootstrap_pip
   169	        missing.append('pip')
   170	    missing.extend(missing_tool_closure(wheels))
   171	    if missing:
   172	        raise RuntimeError('Offline scorer tool sources missing: ' + ', '.join(missing))
   173	    return sorted(names)
