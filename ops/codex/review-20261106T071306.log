   853	def harness_error(result, agent_error):
   854	    """Fail closed: any error that is not a known normal agent end state is a harness failure."""
   855	    messages = [m for m in ((result.error if result is not None else None), agent_error) if m]
   856	    return 'Harness task failure' if any(agent_outcome(m) is None for m in messages) else None
