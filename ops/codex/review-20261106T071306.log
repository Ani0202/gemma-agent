    91	                 'openai', 'urllib3', 'opentelemetry', 'opentelemetry.context'):
    92	        lg = logging.getLogger(name); lg.setLevel(logging.WARNING)
    93	        if 'litellm' in name.lower():
    94	            lg.propagate = False
