  1192	def gpu_preflight():
  1193	    """Raise WrongAccelerator unless nvidia-smi lists >= 4 L4 GPUs; skip if nvidia-smi is unavailable."""
  1194	    try:
  1195	        gpus = subprocess.run(['nvidia-smi', '-L'], capture_output=True, text=True, timeout=60).stdout.splitlines()
  1196	    except (OSError, subprocess.SubprocessError):
  1197	        return
  1198	    if len(gpus) < 4 or not all('L4' in g for g in gpus):
  1199	        raise WrongAccelerator('expected 4x L4 (nvidia-smi -L preflight)')
