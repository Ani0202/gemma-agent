   997	def extract_bundle(encoded, destination):
   998	    payload = base64.b64decode(encoded, validate=True)
   999	    destination.mkdir(parents=True, exist_ok=True)
  1000	    with tarfile.open(fileobj=io.BytesIO(payload), mode='r:gz') as tf:
  1001	        tf.extractall(destination, filter='data')
  1002	    return hashlib.sha256(payload).hexdigest(), hashlib.sha256((destination / 'agent.yaml').read_bytes()).hexdigest()
