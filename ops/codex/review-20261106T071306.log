   859	def platform_probe(host='pypi.org', port=443, timeout=10.0):
   860	    """P2 (plan 006 addendum): docker presence, DNS, and one TCP connect. Sends no payload."""
   861	    out = dict(docker_which=shutil.which('docker'), docker_sock=os.path.exists('/var/run/docker.sock'),
   862	               host=host, port=port, dns=None, dns_seconds=None, tcp=None, tcp_seconds=None, tcp_errno=None)
   863	    box = {}
   864	    def resolve():
   865	        try:
   866	            box['addrs'] = sorted({ai[4][0] for ai in socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)})
   867	        except Exception as exc:
   868	            box['error'] = type(exc).__name__
   869	    start = time.perf_counter()
   870	    worker = threading.Thread(target=resolve, daemon=True)
   871	    worker.start(); worker.join(timeout)
   872	    out['dns_seconds'] = round(time.perf_counter() - start, 3)
   873	    if worker.is_alive():
   874	        out['dns'], out['tcp'] = 'timeout', 'skipped'
   875	        return out
   876	    if 'error' in box or not box.get('addrs'):
   877	        out['dns'], out['tcp'] = 'failed:' + box.get('error', 'empty'), 'skipped'
   878	        return out
   879	    out['dns'] = 'resolved'
   880	    out['dns_addr_count'] = len(box['addrs'])
   881	    start = time.perf_counter()
   882	    try:
   883	        sock = socket.create_connection((box['addrs'][0], port), timeout=timeout)
   884	        sock.close()
   885	        out['tcp'] = 'connected'
   886	    except socket.timeout:
   887	        out['tcp'] = 'timeout'  # blackhole: SYN dropped
   888	    except ConnectionRefusedError:
   889	        out['tcp'] = 'refused'
   890	    except OSError as exc:
   891	        out['tcp'], out['tcp_errno'] = 'unreachable', exc.errno
