   271	def setup_step(current, name, action, *, fatal=True):
   272	    """Time setup steps and retain bounded output plus retry counts."""
   273	    start = time.perf_counter()
   274	    row = dict(step=name, start_offset_s=round(start-current['started'], 6),
   275	               duration_s=0.0, rc=None, stdout='', stderr='', retrying_lines=0)
   276	    current['setup_calls'].append(row)
   277	    try:
   278	        result = action()
   279	        row['rc'] = getattr(result, 'exit_code', getattr(result, 'returncode', 0))
   280	        setup_artifact(current, dict(step=name, stdout=getattr(result, 'stdout', '') or '',
   281	                                     stderr=getattr(result, 'stderr', '') or ''))
   282	        for field in ('stdout', 'stderr'):
   283	            value = getattr(result, field, '') or ''
   284	            row['retrying_lines'] += sum('Retrying' in line for line in value.splitlines())
   285	            row[field] = value.encode('utf-8', errors='replace')[-2048:].decode('utf-8', errors='ignore')
   286	        return result
   287	    except Exception as exc:
   288	        row.update(rc=-1, stderr=type(exc).__name__)
   289	        if fatal:
   290	            current['setup_failed'] = True
   291	            raise
   292	    finally:
   293	        row['duration_s'] = round(time.perf_counter()-start, 6)
   294	        current['retrying_lines'] = sum(c['retrying_lines'] for c in current['setup_calls'])
   295	        if fatal and row['rc'] != 0:
   296	            current['setup_failed'] = True
