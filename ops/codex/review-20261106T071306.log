   219	def test_cli(tmp_path):
   220	    source, output = tmp_path / 'timing.jsonl', tmp_path / 'classes.json'
   221	    source.write_text('\n'.join(json.dumps(r) for r in [
   222	        {'_schema': 'example'}, {'_vllm': {}}, row(resolved=True),
   223	        row(instance_id='bad', error='Harness task failure', result_error='Evaluation error: boom'),
   224	        row(instance_id='diag', setup_calls=[chain()], setup_failed=True),
   225	        {'_stopped': 'example'}, {'_done': {'n': 3}},
   226	    ]) + '\n')
   227	    proc = subprocess.run([sys.executable, classifier.__file__, str(source), '--out', str(output)],
   228	                          check=True, capture_output=True, text=True)
   229	    result = json.loads(proc.stdout)
   230	    assert result == json.loads(output.read_text())
   231	    assert result['_schema'] == 'plan007_row_classes/v1'
   232	    assert result['n_rows'] == 3 and result['h_rows'] == ['bad']
   233	    assert result['counts'] == dict(h={'H-ROW': 1}, agent={'PASS': 1, 'EXIT0_UNRESOLVED': 1}, known_diag=1)
   234	    assert result['input_sha256'] == hashlib.sha256(source.read_bytes()).hexdigest()
   235	    assert result['classifier_sha256'] == hashlib.sha256(Path(classifier.__file__).read_bytes()).hexdigest()
   236	    assert 'boom' not in proc.stdout and 'Evaluation error' not in proc.stdout
   237	    assert classifier.RECORD not in proc.stdout
   238	    assert proc.stderr == ''
