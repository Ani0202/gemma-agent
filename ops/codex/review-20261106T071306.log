   640	def classify_patch(patch, repo, protected=None, test_targets=()):
   641	    """Parse file headers outside hunks, including quoted paths and renames."""
   642	    files, new = set(), set()
   643	    current, added, in_hunk = set(), False, False
   644	    def path_value(raw):
   645	        raw = raw.split('\t', 1)[0]
   646	        value = json.loads(raw) if raw.startswith('"') else raw
   647	        return value[2:] if value.startswith(('a/', 'b/')) else value
   648	    for line in patch.splitlines() + ['diff --git ']:
   649	        if line.startswith('diff --git '):
   650	            files.update(current)
   651	            if added:
   652	                new.update(current)
   653	            current, added, in_hunk = set(), False, False
   654	            match = re.match(r'^diff --git ("a/.*?"|a/.*?) ("b/.*?"|b/.*)$', line)
   655	            if match:
   656	                current.update(path_value(p) for p in match.groups())
   657	        elif line.startswith('@@'):
   658	            in_hunk = True
   659	        elif not in_hunk:
   660	            if line.startswith(('--- ', '+++ ')):
   661	                p = path_value(line[4:])
   662	                if p != '/dev/null':
   663	                    current.add(p)
   664	                elif line.startswith('--- '):
   665	                    added = True
   666	            elif line.startswith('new file mode '):
   667	                added = True
   668	            elif line.startswith(('rename from ', 'rename to ')):
   669	                current.add(path_value(line.split(' ', 2)[2]))
   670	    if protected is None:
   671	        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
   672	    tests = sorted(p for p in files if protected(p) or p in test_targets)
   673	    package = repo.split('/')[-1].replace('-', '_').lower()
   674	    source_roots = (package + '/', 'src/' + package + '/')
   675	    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
   676	                                         and p not in tests))
   677	    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
   678	                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())
