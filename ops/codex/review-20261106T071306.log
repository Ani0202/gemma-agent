   715	def test_run_stats(trace, agent_seconds):
   716	    pending, n, total = {}, 0, 0.0
   717	    for e in trace.entries if trace else []:
   718	        if e.event_type == 'tool_call':
   719	            command = (e.tool_args or {}).get('command', '')
   720	            is_test = e.tool_name == 'run_command' and any(s in command for s in ('pytest', 'unittest', 'tox', 'nox', 'run_tests'))
   721	            n += int(is_test)
   722	            pending.setdefault(e.tool_name, []).append((e.timestamp, is_test))
   723	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   724	            start, is_test = pending[e.tool_name].pop(0)
   725	            if is_test:
   726	                total += max(0.0, e.timestamp - start)
   727	    return dict(n=n, total_seconds=total, share_of_agent_seconds=total / agent_seconds if agent_seconds else None)
