    71	        gpu_wheel = w.name.lower().startswith(('vllm-', 'torch-', 'triton-', 'nvidia_'))
    72	        if 'cutlass' in w.name.lower() or (os.environ.get('SETUP_ONLY') == '1' and gpu_wheel):
    73	            continue
    74	        name = w.name.replace('cu128', '+cu128') if 'cu128' in w.name and '+' not in w.name else w.name
    75	        target = staged / name
    76	        if not target.exists():
    77	            try:
    78	                target.symlink_to(w)
    79	            except OSError:
    80	                shutil.copyfile(w, target)
    81	    wheels = sorted(map(str, staged.glob('*.whl')))
    82	    if not wheels:
    83	        raise RuntimeError('No wheelhouse wheels')
    84	    subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '--no-deps',
    85	                    '--no-index', '--force-reinstall', *wheels], check=True)
    86	    importlib.invalidate_caches()
