    result = classifier.classify(row(error='unexpected', setup_failed=True, exit_code=-1))
    assert result['h'] == 'H-ROW' and result['known_diag'] is False
    assert classifier.classify(row(setup_failed=True, exit_code=-1))['h'] == 'H-SETUP'


