   141	def running_jobs():
   142	    """Legacy three-field, current four-field, and longer (extra trailing fields) status records."""
   143	    records = []
   144	    for path in sorted(Path(REPO, "ops/jobs").glob("*.status")):
   145	        fields = (read(path) or "").split()
   146	        # >=3: legacy 3-field, current 4-field, and the proposed owner patch's extra identity fields.
   147	        if len(fields) < 3 or fields[0] != "running":
   148	            continue
   149	        try:
   150	            pid = int(fields[1])
   151	            pgid = int(fields[3]) if len(fields) >= 4 else None
   152	        except ValueError:
   153	            continue
   154	        record = {"name": path.stem, "pid": pid, "pgid": pgid}
   155	        if len(fields) >= 6:
   156	            record.update(boot_id=fields[4], starttime=fields[5],
   157	                          job_id=f"{path.stem}/{fields[4]}/{fields[5]}".encode())
   158	        records.append(record)
   159	    return records
   160	
   161	
   162	def job_name(root, procs, records):
   163	    """Use status metadata only; never inspect a process command line."""
   164	    pgid = procs.get(root, {}).get("pgid")
   165	    for record in records:
   166	        if (record["pid"] == root or record["pgid"] == root or
   167	                (pgid is not None and pgid in (record["pid"], record["pgid"]))):
   168	            return record["name"]
   169	    return None
   170	
   171	
   172	def runs_memguard(pid):
   173	    argv = (read(f"/proc/{pid}/cmdline", "rb") or b"").split(b"\0")
   174	    return any(os.path.basename(arg) == b"memguard" for arg in argv[:2])
