   176	
   177	def protected_watchdogs(procs, records):
   178	    # Deployment stops the old guard before starting the new one, with no heavy
   179	    # jobs running. We do not rely on the old implementation excluding this guard.
   180	    guards = {p for p in procs if runs_memguard(p)}
   181	    for p in procs:
   182	        job_id = marker_value(p, "GEMMA_JOB_ID")
   183	        name = job_name(p, procs, records)
   184	        if ((job_id is not None and job_id.startswith(b"memguard")) or
   185	                (name is not None and name.startswith("memguard")) or
   186	                any(r["name"].startswith("memguard") and r["pid"] in ancestors(p, procs)
   187	                    for r in records)):
   188	            guards.add(p)
   189	    return guards | {procs[p]["ppid"] for p in guards}
