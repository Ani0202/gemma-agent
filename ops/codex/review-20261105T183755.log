   199	
   200	def find_jobs(procs, args, self_pids, records=None, known_jobs=None):
   201	    """Classify every recipient independently; ancestry only associates eligible members."""
   202	    records = running_jobs() if records is None else records
   203	    known = {(p, start): j for j in (known_jobs or {}).values()
   204	             for p, start in j["known_members"].items()}
   205	    protected = protected_watchdogs(procs, records)
   206	    jobs = {}
   207	    # Carry history independently of eligible-member traversal order. In particular,
   208	    # an exec to node must not erase a live legacy identity, even if no member is
   209	    # eligible this poll. Only members/pids/RSS describe current eligible recipients.
   210	    for key, previous in (known_jobs or {}).items():
   211	        if any(p in procs and procs[p]["starttime"] == start
   212	               for p, start in previous["known_members"].items()):
   213	            jobs[key] = {**previous, "pids": [], "members": {}, "rss": 0,
   214	                         "records": records, "known_members": dict(previous["known_members"])}
   215	    for p, d in procs.items():
   216	        if not eligible(p, procs, args, protected):
   217	            continue
   218	        value = marker_value(p, args.marker)
   219	        job_id = marker_value(p, "GEMMA_JOB_ID")
   220	        record = None
   221	        previous = known.get((p, d["starttime"])) if job_id is None else None
   222	        if job_id is not None:
   223	            # Bytes equality, never a prefix/substring/regex match. Identity takes
   224	            # precedence over PGID, ancestry, and the eligibility marker's value.
   225	            record = next((r for r in records if r.get("job_id") == job_id), None)
   226	            key = ("job_id", job_id)
   227	        elif previous:
   228	            key = previous["key"]
   229	        elif value is not None:
   230	            lineage = [p] + ancestors(p, procs)
   231	            record = next((r for r in records if
   232	                           (r["pgid"] is not None and d["pgid"] == r["pgid"]) or
   233	                           (r["pgid"] is None and r["pid"] in lineage)), None)
   234	            key = (("job", value, record["pid"], record["pgid"]) if record else
   235	                   ("orphan", value))
   236	        else:
   237	            key = ("unmarked", p, d["starttime"])
   238	        root = record["pid"] if record else p
   239	        if previous:
   240	            root = previous["root"]
   241	        j = jobs.setdefault(key, {"key": key, "root": root, "name": record["name"] if record else job_name(root, procs, records),
   242	                                  "pids": [], "members": {}, "rss": 0, "records": records,
   243	                                  "known_members": dict(previous["known_members"]) if previous else {}})
   244	        if previous:
   245	            j["name"] = previous["name"]
   246	            for member, start in previous["known_members"].items():
   247	                j["known_members"].setdefault(member, start)
   248	        if job_id is None:
   249	            j["known_members"][p] = d["starttime"]
   250	        j["pids"].append(p)
   251	        j["members"][p] = d
   252	        j["rss"] += d["rss"]
   253	    # Exclude the watchdog's whole job, including siblings, rather than only its pid.
   254	    for key, j in list(jobs.items()):
   255	        if (set(j["pids"]) & (self_pids | protected) or j["root"] in self_pids | protected or
   256	                (j["name"] is not None and j["name"].startswith("memguard"))):
   257	            del jobs[key]
   258	    targets = {p: d for j in jobs.values() for p, d in j["members"].items()}
   259	    return targets, jobs
   260	
   261	
   262	def action_eligible(d, args):
   263	    """Refresh identity AND allowlist after opening the process handle (exec keeps starttime)."""
   264	    current = proc_info(d["pid"])
   265	    if not current or current["starttime"] != d["starttime"]:
   266	        return False
   267	    # Include children so a guard's bin/job parent is protected at action time too.
   268	    procs = snapshot()
   269	    procs[d["pid"]] = current
   270	    parent = current["ppid"]
   271	    while current["comm"] in SHELL_COMMS and parent and parent not in procs:
   272	        info = proc_info(parent)
   273	        if not info:
   274	            break
   275	        procs[parent] = info
   276	        parent = info["ppid"]
   277	    return eligible(d["pid"], procs, args, protected_watchdogs(procs, running_jobs()))
   278	
   279	
   280	def send_kill(d, log, args):
   281	    """Pin a pidfd before the final identity check; never signal a recycled pid."""
   282	    fd = None
   283	    try:
   284	        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
   285	            try:
   286	                fd = os.pidfd_open(d["pid"])
   287	            except OSError as exc:
   288	                if exc.errno not in (errno.ENOSYS, errno.EINVAL, errno.EPERM):
   289	                    raise
   290	        if not action_eligible(d, args):
   291	            return False
   292	        if fd is not None:
   293	            signal.pidfd_send_signal(fd, signal.SIGKILL)
   294	        else:
   295	            os.kill(d["pid"], signal.SIGKILL)
   296	        return True
   297	    except ProcessLookupError:
   298	        return False
   299	    except OSError as exc:
   300	        log(f"  cannot kill {d['pid']}: {exc}")
   301	        return False
   302	    finally:
   303	        if fd is not None:
   304	            os.close(fd)
   305	
   306	
   307	def raise_oom_adj(targets, dry, args):
   308	    n = 0
   309	    if dry:
   310	        return n
   311	    for p, d in targets.items():
   312	        # Opening first pins the proc file to this process, even if its numeric pid is reused.
   313	        try:
   314	            with open(f"/proc/{p}/oom_score_adj", "w") as f:
   315	                if action_eligible(d, args):
   316	                    f.write("1000")
   317	                    n += 1
   318	        except OSError:
   319	            pass
   320	    return n
   321	
   322	
   323	def inventory(job, args, self_pids):
   324	    # Use the same job ID / known legacy identities for every scan, including survivors.
   325	    _, jobs = find_jobs(snapshot(), args, self_pids, job["records"], {job["key"]: job})
   326	    current = jobs.get(job["key"], {})
   327	    job["known_members"].update(current.get("known_members", {}))
   328	    return current.get("members", {})
   329	
   330	
   331	def kill_tree(job, args, self_pids, log):
   332	    """Two empty scans, bounded by five seconds, then an independent survivor inventory."""
   333	    killed = set()
   334	    started = time.monotonic()
   335	    deadline = started + 5
   336	    root_identity = job["members"].get(job["root"])
   337	    empty_scans = 0
   338	    while time.monotonic() < deadline:
   339	        members = inventory(job, args, self_pids)
   340	        # The wrapper gets a grace period to record the child's failure. A new process
   341	        # with the same numeric pid does not inherit this special treatment.
   342	        grace = (root_identity and time.monotonic() < started + 3 and
   343	                 any(p != job["root"] for p in job["members"]))
   344	        for p, d in members.items():
   345	            if grace and p == job["root"] and d["starttime"] == root_identity["starttime"]:
   346	                continue
   347	            if send_kill(d, log, args):
   348	                killed.add(p)
   349	        empty_scans = empty_scans + 1 if not members else 0
   350	        if empty_scans >= 2 and not grace:
   351	            break
   352	        time.sleep(0.2)
   353	    survivors = sorted(inventory(job, args, self_pids))
   354	    return sorted(killed), survivors
   355	
   356	
   357	def send_mail(msg, log):
   358	    try:
   359	        result = subprocess.run([os.path.join(REPO, "bin/send"), "builder", msg],
   360	                                env={**os.environ, "SEND_FROM": "memguard", "GEMMA_ROLE": "memguard"},
   361	                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
   362	        if result.returncode:
   363	            log(f"  mail failed: exit {result.returncode}")
   364	    except (OSError, subprocess.TimeoutExpired) as exc:
   365	        log(f"  mail failed: {exc}")
