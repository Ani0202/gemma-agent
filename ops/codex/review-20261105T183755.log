   191	
   192	def eligible(pid, procs, args, protected=()):
   193	    d = procs[pid]
   194	    return (pid not in protected and d["uid"] == UID and d["state"] not in {"Z", "X"} and
   195	            not is_session(pid, procs) and
   196	            (marker_value(pid, args.marker) is not None or
   197	             (d["rss"] > args.unmarked_rss and under(cwd_of(pid), args.roots))))
