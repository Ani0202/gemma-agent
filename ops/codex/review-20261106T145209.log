    97	## Decision rule (plan 007 rules, base = BASE; written before any data)
    98	- ON-ADOPT: ON-only > OFF-only with p < 0.2, AND arm-3 timeouts <= base timeouts + 2, AND TIMING passes, AND every SAFETY metric is
    99	  met -> thinking ON becomes the 31B default draft (the arm-3 bundle).
   100	- ON-BETTER-VETOED: ON ahead with p < 0.2 but timeouts, TIMING or SAFETY fail -> keep OFF; report with the timing data as a candidate
   101	  cap/budget follow-up (no automatic further arm).
   102	- KEEP-OFF: OFF-only >= ON-only.
   103	- NO-DIFFERENCE: ON ahead with p >= 0.2 -> keep OFF (cheaper, faster).
   104	- INVALID: smoke (i) fails, or H rows >= 5 of 33 (literal, see VALIDITY), or the pairing is voided (kernel agent/verification path
   105	  differs, IDENTITY mismatch, base invalid/unruled) -> no rule applies. ON-ADOPT and ON-BETTER-VETOED require a VALID arm 3.
   106	- Label (review non-blocking 2): smoke (i) shows thinking is ACTIVE, not that the 4096-token budget is enforced exactly; no metric
   107	  here establishes numeric budget enforcement.
   108	- Power caveat (in advance): k=1, n=33. +-3 resolved is noise; p < 0.2 needs e.g. 4 of 4, 6 of 7 or 7 of 9 discordants one way (5 of 6 gives p = 0.22); p < 0.05
   109	  needs 6 of 6. A KEEP-OFF or NO-DIFFERENCE verdict does not show thinking is useless, only that this n cannot see a gain.
   110	  Any k > 1 follow-up needs a new pre-registration (fixed n and seeds, per-task mean, sign test on per-task differences).
   111	- The arm-3 result does not override the FINALS RULE or CAP-BOUND: thinking ON changes per-turn latency, not the cap. It ships only
   112	  at a cap that has SCORED on the real scorer (the dec 055 31b-v002 submit is thinking 4096 at cap 3.5 and is that evidence if it scores).
     1	#!/usr/bin/env python3
     2	"""Plan 009 rev 2 IDENTITY checks ZIP + CONTENT (eval/plans/009.md, IDENTITY block).
     3	
     4	ZIP:     sha256(dist/31b-<v>.zip) == the 'zip sha256:' line of bundles/31b/<v>/MANIFEST.md.
     5	CONTENT: zip member paths + per-file sha256 == files under bundles/31b/<v>/, excluding ONLY the
     6	         root MANIFEST.md of the source dir (bin/pack strips it from the zip by design).
     7	Also records sha256 of agent.yaml inside the zip (header agent_yaml_sha256 must equal it).
     8	TRANSPORT is a separate check made at push time (journaled); it is not computed here.
     9	
    10	Usage: eval/plan009_identity.py v012 [v013 ...] [--out results/plan009_bundle_identity.json] [--event smoke|main|chunkN]
    11	Exit 0 iff every requested bundle passes ZIP and CONTENT. Appends one record per call to the output file.
    12	"""
    13	import argparse, datetime, hashlib, json, os, re, subprocess, sys, zipfile
    14	
    15	ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    16	SCHEMA = ("plan009_bundle_identity v1: records[] each {utc, git_sha, event, bundles{<v>: {zip_path, zip_sha256, "
    17	          "manifest_zip_sha256, zip_ok, content_ok, only_in_zip[], only_in_dir[], byte_mismatch[], excluded[], "
    18	          "agent_yaml_sha256, pass}}}")
    19	
    20	
    21	def sha(b):
    22	    return hashlib.sha256(b).hexdigest()
    23	
    24	
    25	def check(v):
    26	    bdir = os.path.join(ROOT, "bundles", "31b", v)
    27	    zpath = os.path.join(ROOT, "dist", f"31b-{v}.zip")
    28	    man = open(os.path.join(bdir, "MANIFEST.md")).read()
    29	    m = re.search(r"zip sha256:\s*([0-9a-f]{64})", man)
    30	    manifest_sha = m.group(1) if m else None
    31	    with open(zpath, "rb") as f:
    32	        zsha = sha(f.read())
    33	    zfiles = {}
    34	    with zipfile.ZipFile(zpath) as z:
    35	        for info in z.infolist():
    36	            if info.is_dir():
    37	                continue
    38	            zfiles[info.filename] = sha(z.read(info))
    39	    dfiles = {}
    40	    for dp, dn, fn in os.walk(bdir):
    41	        for n in fn:
    42	            full = os.path.join(dp, n)
    43	            rel = os.path.relpath(full, bdir).replace(os.sep, "/")
    44	            with open(full, "rb") as f:
    45	                dfiles[rel] = sha(f.read())
    46	    excluded = []
    47	    if "MANIFEST.md" in dfiles:
    48	        del dfiles["MANIFEST.md"]
    49	        excluded.append("MANIFEST.md")
    50	    only_z = sorted(set(zfiles) - set(dfiles))
    51	    only_d = sorted(set(dfiles) - set(zfiles))
    52	    mism = sorted(p for p in set(zfiles) & set(dfiles) if zfiles[p] != dfiles[p])
    53	    zip_ok = manifest_sha is not None and manifest_sha == zsha
    54	    content_ok = not (only_z or only_d or mism)
    55	    return {"zip_path": os.path.relpath(zpath, ROOT), "zip_sha256": zsha, "manifest_zip_sha256": manifest_sha,
    56	            "zip_ok": zip_ok, "content_ok": content_ok, "only_in_zip": only_z, "only_in_dir": only_d,
    57	            "byte_mismatch": mism, "excluded": excluded, "agent_yaml_sha256": zfiles.get("agent.yaml"),
    58	            "pass": zip_ok and content_ok and "agent.yaml" in zfiles}
    59	
    60	
    61	def main():
    62	    ap = argparse.ArgumentParser()
    63	    ap.add_argument("versions", nargs="+")
    64	    ap.add_argument("--out", default=os.path.join(ROOT, "results", "plan009_bundle_identity.json"))
    65	    ap.add_argument("--event", default="check")
    66	    a = ap.parse_args()
    67	    git = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    68	    rec = {"utc": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "git_sha": git,
    69	           "event": a.event, "bundles": {v: check(v) for v in a.versions}}
    70	    data = {"_schema": SCHEMA, "records": []}
    71	    if os.path.exists(a.out):
    72	        data = json.load(open(a.out))
    73	    data["records"].append(rec)
    74	    with open(a.out, "w") as f:
    75	        json.dump(data, f, indent=1)
    76	        f.write("\n")
    77	    ok = all(b["pass"] for b in rec["bundles"].values())
    78	    for v, b in rec["bundles"].items():
    79	        print(f"{v}: zip_ok={b['zip_ok']} content_ok={b['content_ok']} agent_yaml={b['agent_yaml_sha256']} pass={b['pass']}")
    80	    print("PASS" if ok else "FAIL")
    81	    sys.exit(0 if ok else 1)
    82	
    83	
    84	if __name__ == "__main__":
    85	    main()

