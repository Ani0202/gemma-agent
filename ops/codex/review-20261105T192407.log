    61	            events.append(('exec', command, kwargs))
    62	            # Even a failed editable attempt must be followed by injection.
    63	            return SimpleNamespace(exit_code=1)
    64	
    65	        def copy_to(self, sid, source, destination):
    66	            events.append(('copy', destination))
    67	
    68	    install = env.patch_subprocess_deps(tmp_path)
    69	    return SimpleNamespace(install=install, manager=SubprocessManager(), cs=cs,
    70	                           wheels=wheels, site=site, events=events)
