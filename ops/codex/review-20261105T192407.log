   285	def patch_subprocess_deps(data_dir):
   286	    """Emulate the docker-only dependency setup for the subprocess sandbox (swegemma skips it).
   287	
   288	    Contract (swegemma 0.2.11 container_setup): Docker workspace setup first attempts
   289	    the workspace editable install; _ensure_container_site_packages then unpacks every deduplicated
   290	    (highest-version, py313-compatible) wheel from wheels_dir that is
   291	    < 16 MB and not in skip_base_pkgs (pytest, pluggy, ... come from the image) straight into
   292	    site-packages, no resolver; large wheels are added only if imported by the workspace; then
   293	    sandbox/setup.py runs with --fast-path. We replicate exactly that inside the sandbox venv.
   294	    The sandbox venv uses system_site_packages=True, so the HOST python must mirror the image
   295	    (Dockerfile.public: pytest, pytest-timeout==2.1.0, typer, build backends; nothing else).
   296	    """
   297	    import tarfile
   298	    from importlib.metadata import version
   299	    import swegemma.harness.container_setup as cs
   300	    import swegemma.harness.verification as vf
   301	    import swegemma.harness.sample_verification  # load all known by-name bindings
   302	    import swegemma.evaluate
   303	    import swegemma.cli
   304	    import swegemma.harness.agent_runner
   305	    orig = getattr(cs.install_test_dependencies, '_scorer_original', cs.install_test_dependencies)
   306	    previous = cs.install_test_dependencies
   307	    wheels_src = Path(data_dir) / 'wheels'
   308	    if not wheels_src.is_dir():
   309	        wheels_src = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')
   310	    setup_py = setup_script_path(data_dir)
   311	
   312	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   313	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   314	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   315	        venv_dir = docker.sandboxes[container_id]['venv']
   316	        sp_dir = next(iter(sorted(venv_dir.glob('lib/python3*/site-packages'))))
   317	        # The stock editable hook returns early for subprocess managers. Mirror
   318	        # its Docker command, ignored failure, and default manager timeout here.
   319	        docker.exec(container_id,
   320	                    'pip install --no-index --find-links=/wheels --no-build-isolation --no-deps -e /workspace 2>/dev/null || true')
   321	        # The harness index caches by directory path alone. Refresh it so a changed
   322	        # wheelhouse is still selected/deduplicated by the actual harness code.
   323	        cs._WHEEL_INDEX_CACHE.pop(str(wheels_src.resolve()), None)
   324	        base_wheels, large_wheels, _m2p, _req = cs._inspect_wheels_dir(wheels_src)
   325	        selected = list(base_wheels)
   326	        if large_wheels:  # public wheels have none; fail loudly rather than silently diverge
   327	            raise RuntimeError('large wheels present; workspace-import scan not emulated')
   328	        cache_key = base_cache_key(selected, version('swegemma'))
   329	        marker = sp_dir / '.swegemma_base_injected'
   330	        if not marker.is_file() or marker.read_text() != cache_key:
   331	            tar_path = cs._build_unpacked_wheels_tar(selected, cache_key, marker.name)
   332	            with tarfile.open(tar_path) as tf:
   333	                tf.extractall(sp_dir, filter='data')
   334	            # The harness archive contains an 'ok' marker; bind the container's
   335	            # marker to this wheel identity only after extraction succeeds.
   336	            marker.write_text(cache_key)
   337	        docker.copy_to(container_id, setup_py, '/tmp/setup.py')
   338	        flag = '--fast-path' if fast_path else ''
   339	        docker.exec(container_id, f'python3 /tmp/setup.py {flag} {repo}'.strip(), timeout=280)
   340	        probe_log = os.environ.get('GOLD_PROBE_LOG')  # diagnostic: which copy of the repo package is imported
   341	        if probe_log:
   342	            pkg = {'Textualize/rich': 'rich', 'encode/httpx': 'httpx', 'fastapi/fastapi': 'fastapi',
   343	                   'psf/requests': 'requests'}.get(repo, repo.split('/')[-1])
   344	            out = docker.exec(container_id, f'cd /workspace && PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1 python3 -s -c '
   345	                              f'"import {pkg};print({pkg}.__file__)"', timeout=60)
   346	            with open(probe_log, 'a') as fh:
   347	                fh.write(json.dumps({'container': str(container_id), 'repo': repo, 'probe': str(out)[:500]}) + '\n')
   348	    install._scorer_original = orig
   349	    for name, module in list(sys.modules.items()):
   350	        if ((name == 'swegemma' or name.startswith('swegemma.'))
   351	                and getattr(module, 'install_test_dependencies', None) in (orig, previous)):
   352	            module.install_test_dependencies = install
   353	    return install
