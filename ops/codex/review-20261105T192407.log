   144	def _inspect_wheels_dir(
   145	    wheels_dir: Path,
   146	) -> tuple[list[Path], dict[str, Path], dict[str, set[str]], dict[str, set[str]]]:
   147	    """Indexes wheels in wheels_dir into base (<16MB) and large (>=16MB) sets with module and dependency graphs."""
   148	    import re
   149	    import zipfile
   150	
   151	    key = str(wheels_dir.resolve())
   152	    if key in _WHEEL_INDEX_CACHE:
   153	        return _WHEEL_INDEX_CACHE[key]
   154	
   155	    skip_base_pkgs = {
   156	        'pytest',
   157	        'pytest_timeout',
   158	        'pytest_asyncio',
   159	        'pytest_httpbin',
   160	        'pytest_xdist',
   161	        'pluggy',
   162	        'pip',
   163	        'setuptools',
   164	        'wheel',
   165	    }
   166	
   167	    all_wheels = [
   168	        str(wheels_dir / f) for f in os.listdir(wheels_dir) if f.endswith('.whl')
   169	    ]
   170	    deduped = _deduplicate_wheels(all_wheels)
   171	
   172	    base_wheels: list[Path] = []
   173	    large_wheels: dict[str, Path] = {}
   174	    module_to_pkg: dict[str, set[str]] = {}
   175	    pkg_requires: dict[str, set[str]] = {}
   176	
   177	    for w_path in deduped:
   178	        pkg_norm = re.sub(r'[-_.]+', '_', w_path.name.split('-', 1)[0]).lower()
   179	        if pkg_norm in skip_base_pkgs:
   180	            continue
   181	        if w_path.stat().st_size < _LARGE_WHEEL_THRESHOLD_BYTES:
   182	            base_wheels.append(w_path)
   183	        else:
   184	            large_wheels[pkg_norm] = w_path
   185	
   186	        module_to_pkg.setdefault(pkg_norm, set()).add(pkg_norm)
   187	        try:
   188	            with zipfile.ZipFile(w_path, 'r') as zf:
   189	                names = zf.namelist()
   190	                for n in names:
   191	                    top = n.split('/', 1)[0]
   192	                    if top.endswith('.dist-info') or top.endswith('.data'):
   193	                        if n.endswith('/top_level.txt'):
   194	                            tl_txt = zf.read(n).decode('utf-8', errors='ignore')
   195	                            for line in tl_txt.splitlines():
   196	                                mod = line.strip().split('/')[0].lower()
   197	                                if mod:
   198	                                    module_to_pkg.setdefault(mod, set()).add(pkg_norm)
   199	                        elif n.endswith('/METADATA'):
   200	                            meta_txt = zf.read(n).decode('utf-8', errors='ignore')
   201	                            for line in meta_txt.splitlines():
   202	                                if line.startswith('Requires-Dist:'):
   203	                                    raw_dep = line.split(':', 1)[1].strip()
   204	                                    if ';' in raw_dep and 'extra ==' in raw_dep:
   205	                                        continue
   206	                                    m_dep = re.match(r'^([a-zA-Z0-9_\-\.]+)', raw_dep)
   207	                                    if m_dep:
   208	                                        dep_norm = re.sub(
   209	                                            r'[-_.]+', '_', m_dep.group(1)
   210	                                        ).lower()
   211	                                        pkg_requires.setdefault(pkg_norm, set()).add(
   212	                                            dep_norm
   213	                                        )
   214	                    else:
   215	                        mod_name = (
   216	                            top[:-3].lower()
   217	                            if top.endswith('.py')
   218	                            else top.split('.')[0].lower()
   219	                        )
   220	                        if mod_name and not mod_name.startswith('_'):
   221	                            module_to_pkg.setdefault(mod_name, set()).add(pkg_norm)
   222	        except Exception:
   223	            pass
   224	
   225	    res = (base_wheels, large_wheels, module_to_pkg, pkg_requires)
   226	    _WHEEL_INDEX_CACHE[key] = res
   227	    return res
