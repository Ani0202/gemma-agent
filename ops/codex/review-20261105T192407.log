   278	def base_cache_key(wheels, harness_version):
   279	    """Identify the selected base wheels, independent of enumeration order/path."""
   280	    import hashlib
   281	    identity = (str(harness_version), sorted((p.name, p.stat().st_size) for p in wheels))
   282	    return 'sp_base_local_' + hashlib.sha256(json.dumps(identity).encode()).hexdigest()[:24]
