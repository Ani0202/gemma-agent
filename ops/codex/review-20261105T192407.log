    33	    site = tmp_path / 'venv/lib/python3.13/site-packages'
    34	    site.mkdir(parents=True)
    35	    cs._WHEEL_INDEX_CACHE = {str(wheels.resolve()): 'stale index'}
    36	
    37	    def inspect(path):
    38	        assert path == wheels
    39	        assert str(wheels.resolve()) not in cs._WHEEL_INDEX_CACHE
    40	        events.append(('inspect',))
    41	        return sorted(path.glob('*.whl')), {}, {}, {}
    42	
    43	    def build(selected, cache_key, marker_name):
    44	        events.append(('build', cache_key, tuple(p.name for p in selected)))
    45	        archive = tmp_path / (cache_key + '.tar')
    46	        if not archive.exists():
    47	            with tarfile.open(archive, 'w') as tf:
    48	                for name, content in [(p.name + '.payload', p.read_bytes()) for p in selected] + [(marker_name, b'ok\n')]:
    49	                    info = tarfile.TarInfo(name)
    50	                    info.size = len(content)
    51	                    tf.addfile(info, io.BytesIO(content))
    52	        return archive
