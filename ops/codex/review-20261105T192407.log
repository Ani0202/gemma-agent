   262	def setup_script_path(data_dir):
   263	    """The dependency setup script the subprocess installer copies and executes."""
   264	    setup_py = Path(data_dir) / 'sandbox' / 'setup.py'
   265	    if not setup_py.exists():
   266	        setup_py = next(iter(sorted(Path(data_dir).rglob('setup.py'))), setup_py)  # competition sandbox/setup.py
   267	    return setup_py
