    95	def execute_limited(command, cwd, env, timeout=300, *, shell=None,
    96	                    max_output_chars=10 * 1024 * 1024):
    97	    """Installed executor contract, with host process-tree limits and cleanup."""
    98	    from adk_eval_core.errors import EvalCoreError
    99	    from adk_eval_core.sandbox.base import ExecutionResult
   100	
   101	    start = time.perf_counter()
   102	    try:
   103	        # Fresh interpreters give threaded GOLD_CONCURRENCY workers separate
   104	        # subreaper/adoption domains, without forking a multithreaded process.
   105	        worker = subprocess.run(
   106	            [sys.executable, '-c', proctree.supervisor_source() + '\nsupervisor_main()\n'],
   107	            input=json.dumps(dict(command=command, cwd=str(cwd), env=dict(env),
   108	                                 timeout=timeout, shell=shell,
   109	                                 max_output_chars=max_output_chars)),
   110	            capture_output=True, text=True)
   111	        if worker.returncode:
   112	            raise RuntimeError('Sandbox supervisor failed: ' + worker.stderr)
   113	        result = json.loads(worker.stdout)
   114	        observed = result.pop('metrics')
   115	        metrics = command_metrics.get()
   116	        if metrics is not None:
   117	            metrics['peak_rss_bytes'] = max(metrics.get('peak_rss_bytes', 0),
   118	                                            observed.get('peak_rss_bytes', 0))
   119	            for key in ('mem_kills', 'orphan_kills'):
   120	                metrics[key] = metrics.get(key, 0) + observed.get(key, 0)
   121	        result['duration_seconds'] = round(time.perf_counter() - start, 3)
   122	        return ExecutionResult(**result)
   123	    except (RuntimeError, OSError, ValueError, EvalCoreError) as exc:
   124	        return ExecutionResult(status='error', stdout='', stderr=str(exc), exit_code=-1,
   125	                               duration_seconds=round(time.perf_counter() - start, 3))
   126	
