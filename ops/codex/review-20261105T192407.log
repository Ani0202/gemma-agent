   200	def setup_scorer_env(data_dir, *, out_dir=None, repo_root=None, allow_unsandboxed=False):
   201	    """Common subprocess scorer setup for evaluation and gold calibration."""
   202	    from swegemma.sandbox import SubprocessManager
   203	    from swegemma.harness.container_setup import resolve_wheels_dir
   204	    from types import SimpleNamespace
   205	    data_dir = Path(data_dir).resolve()
   206	    repo_root = Path(repo_root or Path(__file__).resolve().parents[1]).resolve()
   207	    out_dir = Path(out_dir or data_dir.parent / 'gold-output').resolve()
   208	    isolate_host_packages()
   209	    patched = patch_subprocess_deps(data_dir)
   210	    isolate_gold_tempfiles()
   211	    hidden = [Path.home(), repo_root, data_dir, out_dir, Path('/home/ubuntu/work/gemma-wt')]
   212	    wheels = resolve_wheels_dir(SimpleNamespace(wheels_dir=data_dir / 'wheels',
   213	                                              tasks_path=data_dir / 'tasks.jsonl',
   214	                                              snapshots_dir=data_dir / 'snapshots'))
   215	    ro = [wheels.resolve()] if wheels else []
   216	    try:
   217	        if not shutil.which('bwrap'):
   218	            raise RuntimeError('bubblewrap is not installed')
   219	        # First check the empty inventory mask before mounting its wheelhouse
   220	        # child. Then repeat with the complete runtime mounts: wheels may be
   221	        # visible under data_dir, but the inventory must remain inaccessible.
   222	        template = apply_isolation(hidden, [])
   223	        probe_isolation(SubprocessManager(), data_dir / 'tasks.jsonl', data_dir)
   224	        apply_isolation(hidden, ro)
   225	        probe_isolation(SubprocessManager(), data_dir / 'tasks.jsonl', data_dir, empty_data=False)
   226	        mode = 'bwrap'
   227	    except Exception:
   228	        # Never leave an unusable boundary or silently downgrade its protection.
   229	        apply_isolation([], ro)
   230	        if not allow_unsandboxed:
   231	            raise
   232	        mode, template = 'none', None
   233	        import logging
   234	        logging.warning('bubblewrap unavailable/probe failed; explicitly allowed unsandboxed run',
   235	                        exc_info=True)
   236	    return dict(sandbox=mode, bwrap_argv_template=template, patched=patched,
   237	                wheels_dir=wheels)
