    88	    key = env.base_cache_key([a, b], 'v1')
    89	    assert key == env.base_cache_key([b, a], 'v1')
    90	    assert key == env.base_cache_key([a, b], 'v1')
    91	    assert key != env.base_cache_key([a, b], 'v2')
    92	    a.write_bytes(b'aa')
