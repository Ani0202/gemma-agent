    14	def local_setup(tmp_path, monkeypatch):
    15	    events = []
    16	    original = lambda *args, **kwargs: events.append(('docker', args, kwargs))
    17	    names = ['swegemma', 'swegemma.harness', 'swegemma.harness.container_setup',
    18	             'swegemma.harness.verification', 'swegemma.harness.sample_verification',
    19	             'swegemma.evaluate', 'swegemma.cli', 'swegemma.harness.agent_runner']
    20	    for name in names:
    21	        module = ModuleType(name)
    22	        monkeypatch.setitem(sys.modules, name, module)
    23	        if '.' in name:
    24	            parent, attr = name.rsplit('.', 1)
    25	            setattr(sys.modules[parent], attr, module)
    26	    cs = sys.modules['swegemma.harness.container_setup']
    27	    cs.install_test_dependencies = original
    28	    monkeypatch.setattr(importlib.metadata, 'version', lambda name: 'fake-0.2.11')
