   115	    # Coerce dict → ToolRegistry
   116	    if isinstance(tool_registry, dict):
   117	        reg = ToolRegistry()
   118	        for name, fn in tool_registry.items():
   119	            reg.register(name, fn)
   120	        tool_registry = reg
   121	
   122	    limits = limits or SubmissionLimits()
