   200	    """
   201	
   202	    model_config = ConfigDict(extra="forbid", frozen=True)
   203	
   204	    temperature: float | None = Field(default=None, ge=0.0)
   205	    top_p: float | None = Field(default=None, ge=0.0, le=1.0)
   206	    top_k: int | None = Field(default=None, ge=1)
   207	    max_output_tokens: int | None = Field(default=None, ge=1)
