   142	        # 5. Initialize agent factory (supports direct injection and test patches)
   143	        if agent_factory is None:
   144	            agent_factory = AgentClassFactory(
   145	                agent_cls=Agent,
   146	                sequential_agent_cls=SequentialAgent,
   147	                parallel_agent_cls=ParallelAgent,
   148	                loop_agent_cls=LoopAgent,
   149	                agent_tool_cls=AgentTool,
