    57	def _allocate_code_budgets(lengths: list[int], max_chars: int) -> list[int]:
    58	    """Divide max_chars across results with unused characters rolling over to larger nodes."""
    59	    if not lengths:
    60	        return []
    61	    if max_chars <= 0:
    62	        return [0] * len(lengths)
    63	    if sum(lengths) <= max_chars:
    64	        return list(lengths)
    65	
    66	    remaining = max_chars
    67	    unallocated = list(range(len(lengths)))
    68	    budgets = [0] * len(lengths)
    69	
    70	    while unallocated:
    71	        share = remaining // len(unallocated)
    72	        fitting = [i for i in unallocated if lengths[i] <= share]
    73	        if fitting:
    74	            for i in fitting:
    75	                budgets[i] = lengths[i]
    76	                remaining -= lengths[i]
    77	            fitting_set = set(fitting)
    78	            unallocated = [i for i in unallocated if i not in fitting_set]
    79	        else:
    80	            remainder = remaining % len(unallocated)
    81	            for rank_idx, i in enumerate(unallocated):
    82	                budgets[i] = share + (1 if rank_idx < remainder else 0)
    83	            break
    84	
    85	    return budgets
