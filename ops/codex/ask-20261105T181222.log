    20	@dataclass
    21	class EvaluationResult:
    22	    """Aggregated result container for a complete benchmark evaluation run."""
    23	
    24	    task_results: list[TaskResult] = field(default_factory=list)
    25	
    26	    @property
    27	    def total(self) -> int:
    28	        return len(self.task_results)
    29	
    30	    @property
    31	    def resolved(self) -> int:
    32	        return sum(1 for r in self.task_results if r.resolved)
    33	
    34	    @property
    35	    def resolution_rate(self) -> float:
    36	        return (self.resolved / self.total) if self.total > 0 else 0.0
    37	
    38	    def summary(self) -> dict[str, Any]:
    39	        """Compute overall evaluation summary statistics."""
    40	        return {
    41	            "total": self.total,
    42	            "resolved": self.resolved,
    43	            "rate": self.resolution_rate,
    44	        }
    45	
    46	    def group_by(
    47	        self,
    48	        key: str | Callable[[TaskResult], str] = "default",
    49	        default: str = "default",
    50	    ) -> dict[str, dict[str, Any]]:
    51	        """Group task results and compute summary statistics per group.
    52	
    53	        Args:
    54	            key: Either a metadata key string (or attribute name on TaskResult)
    55	                or an extractor callable taking a TaskResult and returning a group name.
    56	            default: Fallback group name if the key is missing or empty.
    57	
    58	        Returns:
    59	            Dictionary mapping group names to statistics:
    60	            {"total": int, "resolved": int, "rate": float}
    61	        """
    62	        stats: dict[str, dict[str, Any]] = {}
    63	        for tr in self.task_results:
    64	            if callable(key):
    65	                val = key(tr)
    66	                group = str(val) if (val is not None and val != "") else default
    67	            elif isinstance(key, str):
    68	                if key in tr.metadata:
    69	                    val = tr.metadata[key]
    70	                    group = str(val) if (val is not None and val != "") else default
    71	                elif hasattr(tr, key) and not callable(getattr(tr, key)):
    72	                    val = getattr(tr, key)
    73	                    group = str(val) if (val is not None and val != "") else default
    74	                else:
    75	                    group = default
    76	            else:
    77	                group = default
    78	
    79	            if group not in stats:
    80	                stats[group] = {"total": 0, "resolved": 0, "rate": 0.0}
    81	            stats[group]["total"] += 1
    82	            if tr.resolved:
    83	                stats[group]["resolved"] += 1
    84	
    85	        for group, s in stats.items():
    86	            s["rate"] = (s["resolved"] / s["total"]) if s["total"] > 0 else 0.0
    87	        return stats
