   119	@budget_gated(count_tool_call=False)
   120	def get_status(ctx: Any) -> str:
   121	    """Check active budget details (time, tool calls) and active patch details.
   122	
   123	    Args:
   124	        ctx: Context instance.
   125	    """
   126	    status_data: dict[str, Any] = {
   127	        'status': 'ok',
   128	        'tool_calls_used': ctx.tool_calls_used,
   129	        'patch_submitted': ctx.submitted_patch is not None,
   130	        'patch_size': len(ctx.submitted_patch) if ctx.submitted_patch else 0,
   131	    }
   132	    if ctx.budget.tool_calls is not None:
   133	        status_data['tool_calls_remaining'] = max(
   134	            0, ctx.budget.tool_calls - ctx.tool_calls_used
   135	        )
   136	        status_data['max_tool_calls'] = ctx.budget.tool_calls
   137	    if ctx.budget.time_minutes is not None:
   138	        status_data['time_seconds_remaining'] = ctx.remaining_time_seconds
   139	        status_data['max_time_minutes'] = ctx.budget.time_minutes
   140	        status_data['agent_elapsed_seconds'] = ctx.agent_elapsed_seconds
   141	    if ctx.budget.turns is not None:
   142	        status_data['max_turns'] = ctx.budget.turns
   143	    if ctx.harness.command_timeout_seconds is not None:
   144	        status_data['command_timeout_seconds'] = ctx.harness.command_timeout_seconds
   145	    return json.dumps(status_data, ensure_ascii=False)
   146	
