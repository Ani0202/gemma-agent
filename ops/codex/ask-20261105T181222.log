   214	async def sandbox_start(docker: Any) -> str:
   215	    """Start sandbox asynchronously, supporting async managers, sync managers, and mocks."""
   216	    if inspect.iscoroutinefunction(getattr(docker, 'start_async', None)):
   217	        return await docker.start_async()
   218	    start_fn = getattr(docker, 'start', None)
   219	    if start_fn is None:
   220	        raise AttributeError(f'{docker} has neither start_async nor start')
   221	    if inspect.iscoroutinefunction(start_fn):
   222	        return await start_fn()
   223	    from unittest.mock import Mock
   224	
   225	    if isinstance(docker, Mock) or isinstance(start_fn, Mock):
   226	        val = start_fn()
   227	        return await val if inspect.isawaitable(val) else val
   228	    return await asyncio.to_thread(start_fn)
   229	
   230	
   231	async def sandbox_stop(docker: Any, sandbox_id: str) -> None:
   232	    """Stop sandbox asynchronously, supporting async managers, sync managers, and mocks."""
   233	    if inspect.iscoroutinefunction(getattr(docker, 'stop_async', None)):
   234	        await docker.stop_async(sandbox_id)
   235	        return
   236	    stop_fn = getattr(docker, 'stop', None)
   237	    if stop_fn is None:
   238	        return
   239	    if inspect.iscoroutinefunction(stop_fn):
   240	        await stop_fn(sandbox_id)
   241	        return
   242	    from unittest.mock import Mock
   243	
   244	    if isinstance(docker, Mock) or isinstance(stop_fn, Mock):
   245	        val = stop_fn(sandbox_id)
   246	        if inspect.isawaitable(val):
   247	            await val
   248	        return
   249	    await asyncio.to_thread(stop_fn, sandbox_id)
