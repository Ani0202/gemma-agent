    49	@experimental
    50	class EventsCompactionConfig(BaseModel):
    51	  """The config of event compaction for an application."""
    52	
    53	  model_config = ConfigDict(
    54	      arbitrary_types_allowed=True,
    55	      extra="forbid",
    56	  )
    57	
    58	  summarizer: Optional[BaseEventsSummarizer] = None
    59	  """The event summarizer to use for compaction."""
    60	
    61	  compaction_interval: Optional[int] = Field(default=None, gt=0)
    62	  """The number of *new* user-initiated invocations that, once
    63	  fully represented in the session's events, will trigger a compaction."""
    64	
    65	  overlap_size: Optional[int] = Field(default=None, ge=0)
    66	  """The number of preceding invocations to include from the
    67	  end of the last compacted range. This creates an overlap between consecutive
    68	  compacted summaries, maintaining context."""
    69	
    70	  token_threshold: Optional[int] = Field(
    71	      default=None,
    72	      gt=0,
    73	  )
    74	  """Post-invocation token threshold trigger.
    75	
    76	  If set, ADK will attempt a post-invocation compaction when the most recently
    77	  observed prompt token count meets or exceeds this threshold.
    78	  """
    79	
    80	  event_retention_size: Optional[int] = Field(default=None, ge=0)
    81	  """Post-invocation raw event retention size.
    82	
    83	  If token-based post-invocation compaction is triggered, this keeps the last N
    84	  raw events un-compacted.
    85	  """
    86	
    87	  @model_validator(mode="after")
    88	  def _validate_trigger_params(self) -> EventsCompactionConfig:
    89	    token_threshold_set = self.token_threshold is not None
    90	    retention_size_set = self.event_retention_size is not None
    91	    if token_threshold_set != retention_size_set:
    92	      raise ValueError(
    93	          "token_threshold and event_retention_size must be set together."
    94	      )
    95	    compaction_interval_set = self.compaction_interval is not None
    96	    overlap_size_set = self.overlap_size is not None
    97	    if compaction_interval_set != overlap_size_set:
    98	      raise ValueError(
    99	          "compaction_interval and overlap_size must be set together."
   100	      )
   101	    if not (token_threshold_set or compaction_interval_set):
   102	      raise ValueError(
   103	          "At least one compaction trigger must be configured: the"
   104	          " token-threshold pair or the sliding-window pair."
   105	      )
   106	    return self
     1	"""ADK plugin providing automatic exponential backoff retries for transient LLM errors."""
     2	
     3	from __future__ import annotations
     4	
     5	import asyncio
     6	import inspect
     7	import logging
     8	import random
     9	import re
    10	from typing import TYPE_CHECKING
    11	
    12	from google.adk.plugins.base_plugin import BasePlugin
    13	
    14	from adk_eval_core.errors import EvalCoreError
    15	
    16	if TYPE_CHECKING:
    17	    from google.adk.agents.callback_context import CallbackContext
    18	    from google.adk.models.llm_request import LlmRequest
    19	    from google.adk.models.llm_response import LlmResponse
    20	
    21	logger = logging.getLogger(__name__)
    22	
    23	_STATUS_CODE_PATTERN = re.compile(r"\b(429|500|502|503|504)\b")
    24	
    25	
    26	class ModelRetryPlugin(BasePlugin):
    27	    """ADK plugin providing exponential backoff retries for model calls.
    28	
    29	    Handles rate limits (429), server errors (500, 502, 503, 504), ResourceExhausted,
    30	    and network connection timeouts.
    31	    """
    32	
    33	    def __init__(
    34	        self,
    35	        max_retries: int = 5,
    36	        initial_delay: float | None = None,
    37	        backoff_factor: float = 2.0,
    38	        max_delay: float = 60.0,
    39	        name: str = "model_retry",
    40	        *,
    41	        initial_backoff: float | None = None,
    42	    ) -> None:
    43	        super().__init__(name=name)
    44	        self.max_retries = max_retries
    45	        self.initial_delay = (
    46	            initial_delay
    47	            if initial_delay is not None
    48	            else (initial_backoff if initial_backoff is not None else 3.0)
    49	        )
    50	        self.initial_backoff = self.initial_delay
    51	        self.backoff_factor = backoff_factor
    52	        self.max_delay = max_delay
    53	
    54	    def _is_retryable_error(self, error: Exception) -> bool:
    55	        if isinstance(
    56	            error,
    57	            (
    58	                EvalCoreError,
    59	                FileNotFoundError,
    60	                PermissionError,
    61	                IsADirectoryError,
    62	                TypeError,
    63	            ),
    64	        ):
    65	            return False
    66	
    67	        err_str = str(error)
    68	        err_type = type(error).__name__
    69	
    70	        # 1. ADK ResourceExhaustedError or rate limit / quota errors
    71	        if "ResourceExhausted" in err_type or "ResourceExhausted" in err_str:
    72	            return True
    73	
    74	        # 2. Status code attribute check
    75	        status_code = getattr(error, "status_code", None)
    76	        if status_code in (429, 500, 502, 503, 504):
    77	            return True
    78	
    79	        # 3. Common LiteLLM / OpenAI / provider retryable exception types
    80	        retryable_types = (
    81	            "InternalServerError",
    82	            "APIError",
    83	            "ServiceUnavailableError",
    84	            "BadGatewayError",
    85	            "GatewayTimeoutError",
    86	            "RateLimitError",
    87	            "APIConnectionError",
    88	            "OverloadedError",
    89	            "OpenAIError",
    90	        )
    91	        if any(t in err_type for t in retryable_types):
    92	            return True
    93	
    94	        # 4. HTTP status code word boundary regex and error substrings
    95	        if _STATUS_CODE_PATTERN.search(err_str):
    96	            return True
    97	
    98	        if any(
    99	            phrase in err_str.lower()
   100	            for phrase in (
   101	                "no 'choices'",
   102	                "internalservererror",
   103	                "rate limit",
   104	                "rate_limit",
   105	                "ratelimit",
   106	                "overloaded",
   107	                "service unavailable",
   108	                "bad gateway",
   109	                "gateway timeout",
   110	                "resourceexhausted",
   111	                "quota exceeded",
   112	            )
   113	        ):
   114	            return True
   115	
   116	        # 5. Network/connection errors
   117	        return isinstance(error, (TimeoutError, ConnectionError, OSError))
   118	
   119	    async def on_model_error_callback(
   120	        self,
   121	        *,
   122	        callback_context: CallbackContext,
   123	        llm_request: LlmRequest,
   124	        error: Exception,
   125	    ) -> LlmResponse | None:
   126	        """Intercept model errors and retry with exponential backoff on transient errors."""
   127	        if not self._is_retryable_error(error):
   128	            logger.warning(
   129	                "Non-retryable model error: %s: %s", type(error).__name__, error
   130	            )
   131	            return None
   132	
   133	        # Extract agent model reference
   134	        inv_context = getattr(callback_context, "_invocation_context", None)
   135	        agent = getattr(callback_context, "agent", None) or (
   136	            getattr(inv_context, "agent", None) if inv_context else None
   137	        )
   138	        model = (
   139	            getattr(agent, "canonical_model", None) or getattr(agent, "model", None)
   140	            if agent
   141	            else None
   142	        )
   143	
   144	        if model is None:
   145	            logger.error("No model found on agent; cannot perform retry.")
   146	            return None
   147	
   148	        delay = self.initial_delay
   149	        for attempt in range(1, self.max_retries + 1):
   150	            # Jitter: +-20% randomization
   151	            jittered_delay = delay * (0.8 + 0.4 * random.random())
   152	            logger.warning(
   153	                "⚠️ Model error (%s: %s). Retrying attempt %d/%d in %.1fs...",
   154	                type(error).__name__,
   155	                error,
   156	                attempt,
   157	                self.max_retries,
   158	                jittered_delay,
   159	            )
   160	            await asyncio.sleep(jittered_delay)
   161	
   162	            try:
   163	                gen_or_coro = model.generate_content_async(llm_request)
   164	                if hasattr(gen_or_coro, "__aiter__"):
   165	                    responses: list[LlmResponse] = []
   166	                    async for res in gen_or_coro:
   167	                        responses.append(res)
   168	                    if responses:
   169	                        logger.info(
   170	                            "✅ Model call succeeded on retry attempt %d/%d.",
   171	                            attempt,
   172	                            self.max_retries,
   173	                        )
   174	                        return responses[-1]
   175	                elif inspect.isawaitable(gen_or_coro):
   176	                    response = await gen_or_coro
   177	                    if response is not None:
   178	                        logger.info(
   179	                            "✅ Model call succeeded on retry attempt %d/%d.",
   180	                            attempt,
   181	                            self.max_retries,
   182	                        )
   183	                        return response
   184	                else:
   185	                    response = gen_or_coro
   186	                    if response is not None:
   187	                        logger.info(
   188	                            "✅ Model call succeeded on retry attempt %d/%d.",
   189	                            attempt,
   190	                            self.max_retries,
   191	                        )
   192	                        return response
   193	            except Exception as retry_err:  # noqa: BLE001
   194	                error = retry_err
   195	                if not self._is_retryable_error(retry_err):
   196	                    logger.error(
   197	                        "Non-retryable error during retry: %s: %s",
   198	                        type(retry_err).__name__,
   199	                        retry_err,
   200	                    )

