   302	    workspace_dir: str = '/workspace',
   303	) -> str:
   304	    """Build shell command to capture a breadth-first, pruned workspace layout tree."""
   305	    prune_clauses = ' '.join(f'-not -path "./{d}/*"' for d in _PRUNED_TOP_DIRS)
   306	    return (
   307	        f'cd {workspace_dir} && find . -mindepth 1 -maxdepth 3 '
   308	        '-not -path "./.*" -not -name ".*" '
