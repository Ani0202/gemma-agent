   216	@budget_gated
   217	def edit_file(
   218	    ctx: Any,
   219	    filepath: str,
   220	    old_string: str,
   221	    new_string: str,
   222	    allow_multiple: bool = False,
   223	) -> str:
   224	    """Replace a contiguous block of text in an existing file.
   225	
   226	    More token-efficient than write_file for targeted changes. Provide 2-4 lines of unique
   227	    surrounding context in old_string to ensure an unambiguous match.
   228	
   229	    Args:
   230	        ctx: Context instance.
   231	        filepath: Relative path to the target file.
   232	        old_string: Text block to replace.
   233	        new_string: Replacement text block.
   234	        allow_multiple: Replace all occurrences of old_string if True.
   235	    """
   236	    try:
   237	        from swegemma.edit import apply_replacement
   238	
   239	        dest_path = _resolve_workspace_path(filepath, allow_root=False)
   240	        filename = dest_path.name
   241	
   242	        with tempfile.TemporaryDirectory() as tmpdir:
   243	            local_file = Path(tmpdir) / filename
   244	            ctx.docker.copy_from(ctx.container_id, str(dest_path), local_file)
   245	
   246	            if not local_file.exists():
   247	                raise FileNotFoundError(f"File '{filepath}' not found in workspace.")
   248	
   249	            with open(local_file, encoding='utf-8', errors='replace', newline='') as f:
   250	                content = f.read()
   251	
   252	            if len(content) == 0:
   253	                raise ValueError(
   254	                    f"File '{filepath}' is empty. Use write_file to populate an empty or newly created file."
   255	                )
   256	
   257	            coerced_allow_multiple = (
   258	                allow_multiple.strip().lower() in ('true', '1', 'yes')
   259	                if isinstance(allow_multiple, str)
   260	                else bool(allow_multiple)
   261	            )
   262	
   263	            res = apply_replacement(
   264	                content,
   265	                old_string,
   266	                new_string,
   267	                filepath=filepath,
   268	                allow_multiple=coerced_allow_multiple,
   269	            )
   270	
   271	            with open(local_file, 'w', encoding='utf-8', newline='') as f:
   272	                f.write(res.new_content)
   273	
   274	            ctx.docker.copy_to(ctx.container_id, local_file, f'{dest_path.parent}/')
   275	
   276	        max_chars = ctx.harness.max_stdout_chars
   277	        diff_str = res.diff
   278	        is_truncated = False
   279	        if max_chars is not None and len(diff_str) > max_chars:
   280	            diff_str = diff_str[:max_chars]
   281	            is_truncated = True
   282	
   283	        return ok_response(
   284	            filepath=filepath,
   285	            occurrences=res.occurrences,
   286	            strategy=res.strategy,
   287	            diff=diff_str,
   288	            is_truncated=is_truncated,
   289	        )
   290	    except Exception as e:
   291	        return error_response(
   292	            error_type='FileEditError',
   293	            error_message=str(e),
   294	        )
