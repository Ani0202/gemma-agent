   338	    def edit_file_tool(
   339	        filepath: str,
   340	        old_string: str,
   341	        new_string: str,
   342	        allow_multiple: bool = False,
   343	    ) -> dict[str, Any]:
   344	        """Replace a contiguous block of text in an existing file.
   345	
