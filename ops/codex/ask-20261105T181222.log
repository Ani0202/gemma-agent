   199	                raise RuntimeError(
   200	                    f'Failed to create directory {dest_path.parent} inside container: {mkdir_res.stderr}'
   201	                )
   202	
   203	            ctx.docker.copy_to(ctx.container_id, tmp_file, f'{dest_path.parent}/')
   204	
   205	        return ok_response(
   206	            filepath=filepath,
   207	            size=len(content),
   208	        )
   209	    except Exception as e:
   210	        return error_response(
   211	            error_type='FileWriteError',
   212	            error_message=str(e),
   213	        )
