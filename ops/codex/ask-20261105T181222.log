   148	def make_run_command(ctx: Any) -> Callable:
   149	    def run_command_tool(command: str) -> dict[str, Any]:
   150	        """Execute a shell command inside the repository sandbox.
   151	
   152	        You can run any shell command (Python scripts, tests, git commands, etc.).
   153	        The command runs in the repository workspace. No network access.
   154	
   155	        Args:
   156	            command: Shell command to execute (e.g., "pytest tests/", "python3 script.py").
   157	        """
   158	        return parse_tool_response(run_command(ctx, command))
   159	
   160	    run_command_tool.__name__ = 'run_command'
   161	    return run_command_tool
   162	
   163	
   164	def make_submit_patch(ctx: Any) -> Callable:
   165	    def submit_patch_tool() -> dict[str, Any]:
