   103	        return None
   104	
   105	    str_keys = (
   106	        ('skill_name',)
   107	        if tool_name == 'load_skill'
   108	        else ('skill_name', 'file_path')
   109	    )
   110	    errors: list[str] = []
   111	    for key in str_keys:
   112	        if key not in tool_args:
   113	            continue
   114	        val = tool_args[key]
   115	        if isinstance(val, list) and len(val) == 1 and isinstance(val[0], str):
   116	            tool_args[key] = val[0]
   117	            val = val[0]
   118	        if val is not None and not isinstance(val, str):
   119	            errors.append(
   120	                f"Argument '{key}' must be a string, got {type(val).__name__}."
   121	            )
   122	
   123	    if errors:
   124	        return {
   125	            'status': 'error',
   126	            'error': '\n'.join(errors),
   127	            'error_code': 'INVALID_ARGUMENTS',
   128	        }
