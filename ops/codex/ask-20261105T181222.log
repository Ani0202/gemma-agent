   167	
   168	        This generates a unified git diff against the baseline commit. The agent
   169	        can submit multiple times; only the final submission is evaluated.
   170	        """
   171	        return parse_tool_response(submit_patch(ctx))
   172	
   173	    submit_patch_tool.__name__ = 'submit_patch'
   174	    return submit_patch_tool
   175	
   176	
   177	def make_get_status(ctx: Any) -> Callable:
