   122	_DEFAULT_MAX_ACTIVE_SKILLS = 5
   123	
   124	
   125	class SkillLifecycleMode(Enum):
   126	  """How long a skill stays active once loaded."""
   127	
   128	  PERSISTENT = "persistent"
   129	  """Stays active for the rest of the session unless explicitly unloaded.
   130	
   131	  The default, and what every skill did before this setting existed. A
   132	  persistent skill neither counts against `max_active_skills` nor is evicted
   133	  by it.
   134	  """
   135	
   136	  BOUNDED = "bounded"
   137	  """As PERSISTENT, but also subject to the `max_active_skills` cap.
   138	
   139	  Loading a bounded skill past the cap releases the bounded skill that was
   140	  least recently loaded. Reloading one counts as a use.
   141	  """
   142	
   143	  EPHEMERAL = "ephemeral"
   144	  """Released once the turn that loaded it ends.
   145	
   146	  Active for every model step of that turn, so the model can finish what it
   147	  loaded the skill for, and gone from the next turn on. Loading it again buys
   148	  another turn. Bounded by time, so the `max_active_skills` cap ignores it.
   149	
   150	  Not supported under `run_live`, which runs the whole bidi stream as one
   151	  invocation: with no turn boundary to expire on, an ephemeral skill there
   152	  behaves as PERSISTENT and stays active until the stream ends.
   153	  """
   154	
   155	
   156	@dataclasses.dataclass(frozen=True)
   157	class SkillLifecycleConfig:
   158	  """How long a toolset's skills stay active once loaded.
   159	
   160	  Attributes:
   161	    enabled: False leaves every skill active for the whole session, whatever the
   162	      rest of this says.
   163	    default_mode: Lifecycle for any skill not in `skill_overrides`. PERSISTENT
   164	      is how skills behaved before this config existed.
   165	    max_active_skills: How many BOUNDED skills may be active at once, per agent.
   166	      PERSISTENT and EPHEMERAL skills never count against it.
   167	    skill_overrides: Per-skill lifecycles. Names need not be registered locally,
   168	      so a registry skill can be listed here too.
   169	    revalidate_skills: Recheck each request that the active skills still say
   170	      what they did when loaded, and re-state the ones that changed. Off by
   171	      default: a registry lookup per active skill per turn, and re-stating one
   172	      invalidates the prompt cache.
   173	  """
   174	
   175	  enabled: bool = True
   176	  default_mode: SkillLifecycleMode = SkillLifecycleMode.PERSISTENT
   177	  max_active_skills: int = _DEFAULT_MAX_ACTIVE_SKILLS
   178	  skill_overrides: dict[str, SkillLifecycleMode] = dataclasses.field(
   179	      default_factory=dict
   180	  )
   181	  revalidate_skills: bool = False
   182	
   183	  def __post_init__(self) -> None:
   184	    if self.max_active_skills < 1:
   185	      raise ValueError(
   186	          "`max_active_skills` must be at least 1, got"
   187	          f" {self.max_active_skills}."
   188	      )
   189	
   190	
   191	def _skill_lifecycle_state_key(agent_name: str) -> str:
   192	  """Returns the session state key holding an agent's lifecycle records.
   193	
   194	  Deliberately not under the `_adk_activated_skill_` prefix: consumers
   195	  elsewhere scan for that prefix and read every match as a list of names.
   196	  """
   197	  return f"_adk_skill_meta_{agent_name}"
   198	
   199	
   200	def _read_lifecycle_records(
   201	    state: Any, agent_name: str
   202	) -> dict[str, dict[str, Any]]:
   203	  """Returns a mutable copy of an agent's per-skill lifecycle records."""
   204	  records = state.get(_skill_lifecycle_state_key(agent_name))
   205	  if not isinstance(records, dict):
   206	    return {}
   207	  return {
   208	      name: dict(record)
   209	      for name, record in records.items()
   210	      if isinstance(record, dict)
   211	  }
   212	
   213	
   214	def _is_expired(record: dict[str, Any], invocation_id: str | None) -> bool:
   215	  """Whether a lifecycle record has outlived the turn that created it.
   216	
   217	  An invocation is a turn: every model step and tool call the user's message
   218	  sets off shares its id. So an ephemeral skill is expired as soon as some
   219	  other invocation asks. Except under `run_live`, where the whole stream is
   220	  one invocation and nothing ever expires.
   221	
   222	  A record with no id was activated without one, which only a hand-built
   223	  context does. Left active, since guessing would release a skill in use.
   224	  """
   225	  if record.get("lifecycle") != SkillLifecycleMode.EPHEMERAL.value:
   226	    return False
   227	  activated_in = record.get("activated_in")
   228	  return bool(activated_in) and activated_in != invocation_id
   229	
   230	
   231	class SkillDiscoveryMode(Enum):
   232	  """How the local skill catalog is disclosed to the model."""
   233	
   234	  LAZY = "lazy"
   235	  """The model discovers skills by calling `list_skills` (default).
   236	
   237	  Costs a model turn before the first `load_skill`, and keeps the system
   238	  instruction free of skill names. Preferable for a large or changing catalog.
   239	  """
   240	
   241	  EAGER = "eager"
   242	  """The catalog is injected into the system instruction as XML.
   243	
   244	  The `list_skills` tool is not offered, and the model can call `load_skill`
   245	  straight away. Preferable for a small, stable catalog, where the discovery
   246	  turn costs more than the names do. Registry skills are unaffected: they are
   247	  still reachable only through `search_skills`.
   248	  """
   249	
