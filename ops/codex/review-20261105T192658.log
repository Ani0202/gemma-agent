   430	def raise_oom_adj(targets, dry, args, known_jobs=None):
   431	    n = 0
   432	    if dry:
   433	        return n
   434	    for p, d in targets.items():
   435	        # Opening first pins the proc file to this process, even if its numeric pid is reused.
   436	        try:
   437	            with open(f"/proc/{p}/oom_score_adj", "w") as f:
   438	                if action_eligible(d, args, known_jobs):
   439	                    f.write("1000")
   440	                    n += 1
   441	        except OSError:
   442	            pass
   443	    return n
