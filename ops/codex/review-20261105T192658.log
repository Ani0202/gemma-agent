   365	
   366	def action_eligible(d, args, known_jobs=None):
   367	    """Refresh the recipient AFTER discovery/protection scans (exec keeps starttime)."""
   368	    initial = proc_info(d["pid"])
   369	    if not initial or initial["starttime"] != d["starttime"]:
   370	        return False
   371	    procs = snapshot()
   372	    # Preserve session ancestry checks when a shell's parent was missed by the scan.
   373	    parent = initial["ppid"]
   374	    while initial["comm"] in SHELL_COMMS and parent and parent not in procs:
   375	        info = proc_info(parent)
   376	        if not info:
   377	            break
   378	        procs[parent] = info
   379	        parent = info["ppid"]
   380	    records = running_jobs()
   381	    verified = verified_records(procs, records)
   382	    protected = protected_watchdogs(procs, records)
   383	    # Read the command and environment after the protection scan, then bind them
   384	    # to the recipient identity again. Missing proc metadata refuses both actions.
   385	    cmdline = read(f"/proc/{d['pid']}/cmdline", "rb")
   386	    environ = read(f"/proc/{d['pid']}/environ", "rb")
   387	    current = proc_info(d["pid"])
   388	    if (not current or current["starttime"] != d["starttime"] or
   389	            cmdline is None or environ is None):
   390	        return False
   391	    job_id = next((entry[len(b"GEMMA_JOB_ID="):] for entry in environ.split(b"\0")
   392	                   if entry.startswith(b"GEMMA_JOB_ID=")), None)
   393	    if verified_wrapper(cmdline) or watchdog_record(d["pid"], cmdline, job_id, records):
   394	        return False
   395	    # Re-parented wrappers whose parent cannot be inspected fail closed.
   396	    if current["comm"] in SHELL_COMMS and current["ppid"] and current["ppid"] not in procs:
   397	        return False
   398	    procs[d["pid"]] = {**current, "job_id": job_id}
   399	    # Re-evaluate fresh recipient metadata against the scanned protections/ancestry.
   400	    return eligible(d["pid"], procs, args, protected, verified, known_jobs)
   401	
   402	
   403	def send_kill(d, log, args, known_jobs=None):
   404	    """Pin a pidfd before the final identity check; never signal a recycled pid."""
   405	    fd = None
   406	    try:
   407	        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
   408	            try:
   409	                fd = os.pidfd_open(d["pid"])
   410	            except OSError as exc:
   411	                if exc.errno not in (errno.ENOSYS, errno.EINVAL, errno.EPERM):
   412	                    raise
   413	        if not action_eligible(d, args, known_jobs):
   414	            return False
   415	        if fd is not None:
   416	            signal.pidfd_send_signal(fd, signal.SIGKILL)
   417	        else:
   418	            os.kill(d["pid"], signal.SIGKILL)
   419	        return True
   420	    except ProcessLookupError:
   421	        return False
   422	    except OSError as exc:
   423	        log(f"  cannot kill {d['pid']}: {exc}")
   424	        return False
   425	    finally:
   426	        if fd is not None:
   427	            os.close(fd)
   428	
   429	
   430	def raise_oom_adj(targets, dry, args, known_jobs=None):
   431	    n = 0
   432	    if dry:
   433	        return n
   434	    for p, d in targets.items():
   435	        # Opening first pins the proc file to this process, even if its numeric pid is reused.
   436	        try:
   437	            with open(f"/proc/{p}/oom_score_adj", "w") as f:
   438	                if action_eligible(d, args, known_jobs):
   439	                    f.write("1000")
   440	                    n += 1
   441	        except OSError:
   442	            pass
   443	    return n
   444	
   445	
   446	def inventory(job, args, self_pids):
   447	    # Use the same job ID / known legacy identities for every scan, including survivors.
   448	    _, jobs = find_jobs(snapshot(), args, self_pids, known_jobs={job["key"]: job})
   449	    current = jobs.get(job["key"], {})
   450	    job["known_members"].update(current.get("known_members", {}))
   451	    return current.get("members", {})
   452	
   453	
   454	def kill_tree(job, args, self_pids, log):
   455	    """Two empty scans, bounded by five seconds, then an independent survivor inventory."""
   456	    killed = set()
   457	    deadline = time.monotonic() + 5
   458	    empty_scans = 0
   459	    while time.monotonic() < deadline:
   460	        members = inventory(job, args, self_pids)
   461	        for p, d in members.items():
   462	            if send_kill(d, log, args, {job["key"]: job}):
   463	                killed.add(p)
   464	        empty_scans = empty_scans + 1 if not members else 0
   465	        if empty_scans >= 2:
   466	            break
   467	        time.sleep(0.2)
   468	    survivors = sorted(inventory(job, args, self_pids))
   469	    return sorted(killed), survivors
   470	
   471	
   472	def send_mail(msg, log):
   473	    try:
   474	        result = subprocess.run([os.path.join(REPO, "bin/send"), "builder", msg],
   475	                                env={**os.environ, "SEND_FROM": "memguard", "GEMMA_ROLE": "memguard"},
   476	                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
   477	        if result.returncode:
   478	            log(f"  mail failed: exit {result.returncode}")
   479	    except (OSError, subprocess.TimeoutExpired) as exc:
   480	        log(f"  mail failed: {exc}")
   481	
   482	
   483	def main():
   484	    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   485	    ap.add_argument("--interval", type=float, default=2.0)
   486	    ap.add_argument("--min-available", type=float, default=2.5, help="GiB")
   487	    ap.add_argument("--max-total", type=float, default=6.0, help="GiB of summed targeted RSS")
   488	    ap.add_argument("--min-kill-rss", type=float, default=0.25,
   489	                    help="GiB; on low MemAvailable alone, skip jobs smaller than this (killing a waiter frees nothing)")
   490	    ap.add_argument("--log", default=os.path.join(REPO, "ops/logs/memguard.log"))
   491	    ap.add_argument("--once", action="store_true")
   492	    ap.add_argument("--dry-run", action="store_true")
   493	    ap.add_argument("--no-mail", action="store_true")
   494	    args = ap.parse_args()
   495	    for k in ("min_available", "max_total", "min_kill_rss"):
   496	        setattr(args, k, int(getattr(args, k) * GIB))
   497	    os.makedirs(os.path.dirname(args.log), exist_ok=True)
   498	
   499	    def log(msg):
   500	        line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}"
   501	        with open(args.log, "a") as f:
   502	            f.write(line + "\n")
   503	        print(line, flush=True)
   504	
   505	    log(f"start pid={os.getpid()} min_available={args.min_available/GIB:.2f}G max_total={args.max_total/GIB:.2f}G "
   506	        f"dry_run={args.dry_run}")
   507	    last_beat = 0
   508	    jobs = {}
   509	    while True:
   510	        procs = snapshot()
   511	        self_pids = {os.getpid()} | set(ancestors(os.getpid(), procs))
   512	        # Our ancestors include the bin/job wrapper and maybe a Claude shell; they're never targets.
   513	        targets, jobs = find_jobs(procs, args, self_pids, known_jobs=jobs)
   514	        if args.dry_run:
   515	            log(f"targets={sorted(targets)} jobs=" + repr([
   516	                {"name": j["name"], "root": j["root"], "pids": sorted(j["pids"])}
   517	                for j in jobs.values()]))
   518	        raise_oom_adj(targets, args.dry_run, args, jobs)
   519	        avail = mem_available() or 0
   520	        total = sum(j["rss"] for j in jobs.values())
   521	        if time.time() - last_beat > 600:
   522	            log(f"beat avail={avail/GIB:.2f}G targeted_rss={total/GIB:.2f}G jobs={len(jobs)} targets={len(targets)}")
   523	            last_beat = time.time()
   524	        reason = None
   525	        if total > args.max_total:
   526	            reason = f"targeted RSS {total/GIB:.2f}G > {args.max_total/GIB:.2f}G"
   527	        elif avail < args.min_available:
   528	            reason = f"MemAvailable {avail/GIB:.2f}G < {args.min_available/GIB:.2f}G"
   529	        if reason and jobs:
   530	            _, j = max(jobs.items(), key=lambda kv: kv[1]["rss"])
   531	            root = j["root"]
   532	            if total <= args.max_total and j["rss"] < args.min_kill_rss:
   533	                reason = None  # pressure is not ours to fix by killing a tiny job
   534	        if reason and jobs:
   535	            name = j["name"]
   536	            comm = procs.get(root, {}).get("comm", "?")
   537	            log(f"KILL job={name or '-'} root={root} comm={comm} rss={j['rss']/GIB:.2f}G reason: {reason}"
   538	                + (" [dry-run]" if args.dry_run else ""))
   539	            if not args.dry_run:
   540	                killed, surv = kill_tree(j, args, self_pids, log)
   541	                log(f"  killed {len(killed)} pids; survivors={surv}")
   542	                msg = (f"memguard killed job {name or '(job pid %d %s)' % (root, comm)}: "
   543	                       f"{j['rss']/GIB:.2f}G, {reason}. Survivors: {surv or 'none'}. See ops/logs/memguard.log.")
   544	                if name:
   545	                    time.sleep(0.5)
   546	                    try:
   547	                        with open(os.path.join(REPO, "ops/jobs", f"{name}.log"), "a") as f:
   548	                            f.write(f"[memguard] {msg}\n")
   549	                    except OSError:
   550	                        pass
   551	                if not args.no_mail:
   552	                    # Mail may take up to ten seconds; keep polling while it completes.
   553	                    threading.Thread(target=send_mail, args=(msg, log)).start()
   554	        if args.once:
   555	            return 0
   556	        time.sleep(args.interval)
   557	
   558	
   559	if __name__ == "__main__":
   560	    sys.exit(main())

