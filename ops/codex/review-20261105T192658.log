   356	        guard_source = f"""
   357	import os, types
   358	from pathlib import Path
   359	module = types.ModuleType("memguard_test")
   360	module.__file__ = {str(MG)!r}
   361	exec(compile(Path(module.__file__).read_text(), module.__file__, "exec"), module.__dict__)
   362	snapshot = module.snapshot
