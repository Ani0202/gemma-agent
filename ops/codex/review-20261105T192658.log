   309	    records = [r for r in records if same_boot(r, boot_id)]
   310	    known_jobs = {k: j for k, j in (known_jobs or {}).items() if same_boot(j, boot_id)}
   311	    verified = verified_records(procs, records)
   312	    known = {(p, start): j for j in (known_jobs or {}).values()
   313	             for p, start in j["known_members"].items()}
   314	    protected = protected_watchdogs(procs, records)
   315	    jobs = {}
   316	    # Carry history independently of eligible-member traversal order. In particular,
   317	    # an exec to node must not erase a live legacy identity, even if no member is
   318	    # eligible this poll. Only members/pids/RSS describe current eligible recipients.
   319	    for key, previous in (known_jobs or {}).items():
   320	        if any(p in procs and procs[p]["starttime"] == start
   321	               for p, start in previous["known_members"].items()):
   322	            jobs[key] = {**previous, "pids": [], "members": {}, "rss": 0,
   323	                         "records": records, "known_members": dict(previous["known_members"])}
   324	    for p, d in procs.items():
   325	        if not eligible(p, procs, args, protected, verified, known_jobs):
   326	            continue
   327	        job_id = marker_value(p, "GEMMA_JOB_ID")
   328	        record = None
   329	        previous = known.get((p, d["starttime"])) if job_id is None else None
   330	        if job_id is not None:
   331	            # Bytes equality, never a prefix/substring/regex match. Identity takes
   332	            # precedence over PGID, ancestry, and the eligibility marker's value.
   333	            record = next((r for r in records if r.get("job_id") == job_id), None)
   334	            key = ("job_id", job_id)
   335	        elif previous:
   336	            key = previous["key"]
   337	        else:
   338	            lineage = [p] + ancestors(p, procs)
   339	            record = next((r for r in verified if r["pid"] in lineage), None)
   340	            if record is None:
   341	                continue  # The job-ID marker may have disappeared since eligibility.
   342	            key = ("job", record["pid"], procs[record["pid"]]["starttime"])
   343	        root = record["pid"] if record else p
   344	        if previous:
   345	            root = previous["root"]
   346	        j = jobs.setdefault(key, {"key": key, "root": root, "name": record["name"] if record else job_name(root, procs, records),
   347	                                  "pids": [], "members": {}, "rss": 0, "records": records,
   348	                                  "boot_id": boot_id, "known_members": dict(previous["known_members"]) if previous else {}})
   349	        if previous:
   350	            j["name"] = previous["name"]
   351	            for member, start in previous["known_members"].items():
   352	                j["known_members"].setdefault(member, start)
   353	        j["known_members"][p] = d["starttime"]
   354	        j["pids"].append(p)
   355	        j["members"][p] = d
   356	        j["rss"] += d["rss"]
   357	    # Exclude the watchdog's whole job, including siblings, rather than only its pid.
   358	    for key, j in list(jobs.items()):
   359	        if (set(j["pids"]) & (self_pids | protected) or j["root"] in self_pids | protected or
   360	                (j["name"] is not None and j["name"].startswith("memguard"))):
   361	            del jobs[key]
   362	    targets = {p: d for j in jobs.values() for p, d in j["members"].items()}
   363	    return targets, jobs
