   446	def inventory(job, args, self_pids):
   447	    # Use the same job ID / known legacy identities for every scan, including survivors.
   448	    _, jobs = find_jobs(snapshot(), args, self_pids, known_jobs={job["key"]: job})
   449	    current = jobs.get(job["key"], {})
   450	    job["known_members"].update(current.get("known_members", {}))
   451	    return current.get("members", {})
