   760	def assert_actions_refused(monkeypatch, mg, args, candidate, known_jobs=None):
   761	    """Exercise both pinned action paths without touching real processes."""
   762	    import io
   763	    class File(io.StringIO):
   764	        def close(self):
   765	            pass
   766	    output, sent = File(), []
   767	    real_open = open
   768	    def open_oom(path, *a, **kw):
   769	        return output if str(path).endswith("oom_score_adj") else real_open(path, *a, **kw)
   770	    monkeypatch.setattr("builtins.open", open_oom)
   771	    monkeypatch.setattr(mg.os, "pidfd_open", lambda p: 42)
   772	    monkeypatch.setattr(mg.os, "close", lambda fd: None)
   773	    monkeypatch.setattr(mg.signal, "pidfd_send_signal", lambda *a: sent.append(a))
   774	    monkeypatch.setattr(mg.os, "kill", lambda *a: sent.append(a))
   775	    assert mg.send_kill(candidate, lambda _: None, args, known_jobs) is False
   776	    assert mg.raise_oom_adj({candidate["pid"]: candidate}, False, args, known_jobs) == 0
   777	    assert sent == []
   778	    assert output.getvalue() == ""
