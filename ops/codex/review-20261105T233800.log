   129	  @staticmethod
   130	  def _from_str(v):
   131	    v = v.rstrip("Z")
   132	    fields = v.rsplit(".", maxsplit=1)
   133	    if len(fields) == 1:
   134	      return datetime.fromisoformat(v)
   135	    (dt, nanos) = fields
   136	    millis = nanos[:3]
   137	    try:
   138	      return datetime.fromisoformat(f"{dt}.{millis}")
   139	    except ValueError:
