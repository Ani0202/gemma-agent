    start = next_line(0)
    if start == len(lines):
        return None
    # A JSON document is also YAML.
    if lines[start].lstrip().startswith(('{', '[')):
        return scalar('\n'.join(lines[start:]))
    require(indent(start) == 0, 'YAML document must begin at indentation zero')
    result, end = block(start, 0)
    require(next_line(end) == len(lines), 'trailing YAML content')
    return result


class Bundle:
    def __init__(self, root):
        self.root = Path(root).absolute()
        self.files = []
        self.cache = {}
        self.loading = []
        self.models = set()
        self.expanded_bytes = {}
        self.agent_count = 0
        self.instruction_chars = 0
        self.skill_count = 0
        self.agent_documents = set()
        self.linted = set()

    def target(self, value, base=None):
        safe_path(value)
        path = (base or self.root) / value
        require(path.is_relative_to(self.root), f'path outside bundle: {value}')
        require(path.is_file(), f'missing reference target: {value}')
        require(path != self.root / 'MANIFEST.md', 'MANIFEST.md cannot be referenced: excluded from ZIP')
        require(path in self.files, f'reference is not a bundle file: {value}')
        return path

    def load(self, path):
        require(path not in self.loading, f'YAML reference/include cycle: {path}')
        require(len(self.loading) <= 10, f'include depth exceeds 10: {path}')
        if path in self.cache:
            return self.cache[path]
        self.loading.append(path)
        try:
            require(path.stat().st_size <= MAX_YAML_BYTES,
                    f'YAML/include size exceeds {MAX_YAML_BYTES} bytes: {path}')
            expanded = path.stat().st_size
            source = path.read_text(encoding='utf-8')
            require('\0' not in source, f'null bytes in {path}')
            if path.suffix not in {'.yaml', '.yml'}:
                require(path.suffix in {'.md', '.txt'}, f'unsupported !include target: {path}')
                result = source
            else:
                def include(value):
                    nonlocal expanded
                    target = self.target(value, path.parent)
                    result = self.load(target)
                    expanded += self.expanded_bytes[target]
                    require(expanded <= MAX_YAML_BYTES,
                            f'cumulative !include size exceeds {MAX_YAML_BYTES} bytes: {path}')
                    return result
                if yaml is None:
                    result = minimal_yaml(source, include)
                else:
                    class Loader(yaml.SafeLoader):
                        pass
                    def mapping(loader, node):
                        result = {}
                        for key_node, value_node in node.value:
                            key = loader.construct_object(key_node)
                            require(isinstance(key, str) and key not in result,
                                    f'invalid or duplicate YAML key in {path}')
                            result[key] = loader.construct_object(value_node)
                        return result
                    Loader.add_constructor('tag:yaml.org,2002:map', mapping)
                    Loader.add_constructor('!include', lambda loader, node: include(loader.construct_scalar(node)))
                    result = yaml.load(source, Loader=Loader)
            self.expanded_bytes[path] = expanded
            self.cache[path] = result
            return result
        except (ValueError, UnicodeError) as exc:
            raise Invalid(f'{path}: {exc}') from exc
        except Exception as exc:
            if yaml is not None and isinstance(exc, yaml.YAMLError):
                raise Invalid(f'{path}: YAML parse failed: {exc}') from exc
            raise
        finally:
            self.loading.pop()

    def prompt(self, value, where):
        if isinstance(value, str):
            bad = set(re.findall(r'\{([A-Za-z_][\w.-]*\??)\}', value)) - {'problem_description'}
            require(not bad, f'{where}: forbidden placeholder(s): {sorted(bad)}')

    def walk(self, value, where, ancestors=(), agent=False):
        if isinstance(value, str):
            require('\0' not in value, f'{where}: null bytes in text')
        if agent:
            require(isinstance(value, (dict, list)), f'{where}: agent must be a mapping')
        if isinstance(value, (dict, list)):
            require(id(value) not in ancestors, f'{where}: recursive YAML alias')
            ancestors = (*ancestors, id(value))
            if id(value) in self.linted:
                return
            self.linted.add(id(value))
        if isinstance(value, list):
            for index, item in enumerate(value):
                self.walk(item, f'{where}[{index}]', ancestors, agent)
        elif isinstance(value, dict):
            for key, item in value.items():
                label = f'{where}.{key}'
                if key == 'config_path':
                    target = self.target(item)
                    require(target.suffix in {'.yaml', '.yml'}, f'{label}: config_path must reference YAML')
                    # Reference cycles are checked separately using the document graph.
                    self.load(target)
                elif key == 'adapter' and item is not None:
                    require(isinstance(item, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', item)
                            and item != '..', f'{label}: invalid adapter name')
                    for filename in ('adapter_config.json', 'adapter_model.safetensors'):
                        self.target(f'adapters/{item}/{filename}')
                elif key == 'generate_content_config' and item is not None:
                    require(isinstance(item, dict), f'{label}: must be a mapping')
                    require(not item.keys() - GENERATION_FIELDS,
                            f'{label}: forbidden or unknown fields: {sorted(item.keys() - GENERATION_FIELDS)}')
                elif key == 'thinking_config':
                    self.thinking(item, label)
                elif key == 'max_output_tokens':
                    require(type(item) is int and 1 <= item <= 32768, f'{label}: must be integer 1..32768')
                if 'instruction' in key or 'prompt' in key:
                    self.prompt(item, label)
                self.walk(item, label, ancestors, key in {'sub_agents', 'agent_tool'})

    def agent(self, value, where, depth=0, active=()):
        """Count compiled occurrences, including repeated references and YAML aliases."""
        require(depth <= MAX_DEPTH, f'{where}: agent depth exceeds {MAX_DEPTH}')
        require(len(active) <= MAX_DEPTH + 1, f'{where}: config_path depth exceeds {MAX_DEPTH}')
        require(isinstance(value, dict), f'{where}: agent must be a mapping')
        if 'agent_tool' in value:
            require(set(value) == {'agent_tool'}, f'{where}: invalid agent_tool wrapper')
            return self.agent(value['agent_tool'], where + '.agent_tool', depth, active)
        if 'config_path' in value:
            require(not set(value) - {'config_path', 'skip_summarization'},
                    f'{where}: invalid config reference')
            target = self.target(value['config_path'])
            require(target not in active, f'config_path cycle: {target}')
            self.agent_documents.add(target)
            return self.agent(self.load(target), str(target), depth, (*active, target))
        self.agent_documents.update(path for path, doc in self.cache.items() if doc is value)
        self.agent_count += 1
        require(self.agent_count <= MAX_AGENTS, f'max_agents exceeds {MAX_AGENTS}')
        name = value.get('name')
        require(isinstance(name, str) and name.strip(), f'{where}: agent name required')
        kind = value.get('agent_class', 'LlmAgent')
        require(isinstance(kind, str) and kind in {'LlmAgent', 'SequentialAgent', 'ParallelAgent', 'LoopAgent'},
                f'{where}: unsupported agent_class')
        # Repository policy requires explicit identical models even on workflows.
        model = value.get('model')
        require(isinstance(model, str) and model in MODELS,
                f'{where}: missing or disallowed model: {model!r}')
        self.models.add(model)
        chars = 0
        for key in ('instruction', 'global_instruction', 'description'):
            if key in value:
                require(isinstance(value[key], str), f'{where}.{key}: must be text')
                if key == 'description':
                    require(len(value[key]) <= MAX_INSTRUCTION_CHARS,
                            f'{where}: description too long')
                else:
                    chars += len(value[key])
        require(chars <= MAX_INSTRUCTION_CHARS, f'{where}: instruction chars exceed {MAX_INSTRUCTION_CHARS}')
        for directory, dirs, files in os.walk(self.root, followlinks=False):
            for name in sorted(dirs + files):
                path = Path(directory) / name
                safe_path(path.relative_to(self.root).as_posix())
                mode = path.lstat().st_mode
                require(not stat.S_ISLNK(mode), f'symlink forbidden: {path}')
                require(stat.S_ISDIR(mode) or stat.S_ISREG(mode), f'not a regular file: {path}')
                if stat.S_ISREG(mode):
                    require(path.suffix in EXTENSIONS, f'extension not allowed: {path}')
                    if path == self.root / 'MANIFEST.md':
                        continue
                    total += path.stat().st_size
                    require(total < LIMIT, f'unpacked size must be < {LIMIT} bytes')
                    self.files.append(path)
                    require(len(self.files) <= MAX_FILE_COUNT, f'max_file_count exceeds {MAX_FILE_COUNT}')
                    if path.suffix in {'.yaml', '.yml'}:
                        yaml_count += 1
                        require(yaml_count <= MAX_YAML_FILES, f'max_yaml_files exceeds {MAX_YAML_FILES}')
                        require(path.stat().st_size <= MAX_YAML_BYTES,
                                f'YAML size exceeds {MAX_YAML_BYTES} bytes: {path}')
        self.files.sort()
        require(self.root / 'agent.yaml' in self.files, 'missing agent.yaml at bundle root')
        require(len(ROOTS & {p.name for p in self.files if p.parent == self.root}) == 1, 'multiple root agent configs')
        require(isinstance(self.load(self.root / 'agent.yaml'), dict), 'agent.yaml must be a mapping')
        for path in self.files:
            if path.suffix in {'.yaml', '.yml'}:
                value = self.load(path)
                self.walk(value, str(path), agent=path == self.root / 'agent.yaml')
            elif path.suffix != '.safetensors':
                source = path.read_text(encoding='utf-8')
                require('\0' not in source, f'null bytes in {path}')
                if 'prompts' in path.relative_to(self.root).parts:
                    self.prompt(source, str(path))
        root = self.root / 'agent.yaml'
        self.agent_documents.add(root)
        self.agent(self.load(root), str(root), active=(root,))
        # Validate standalone agent declarations, but do not count referenced files twice.
        # Visit referring documents before their dependencies.
        def references(value, seen=None):
            if seen is None:
                seen = set()
            if isinstance(value, (dict, list)):
                if id(value) in seen:
                    return
                seen.add(id(value))
            if isinstance(value, dict):
                for key, item in value.items():
                    if key == 'config_path':
                        yield self.target(item)
                    else:
                        yield from references(item, seen)
            elif isinstance(value, list):
                for item in value:
                    yield from references(item, seen)
        candidates = {}
        for path, value in self.cache.items():
            if isinstance(value, dict) and {'name', 'model', 'agent_class', 'instruction',
                                            'global_instruction', 'tools', 'sub_agents'} & value.keys():
                candidates[path] = value
        done = set()
        ordered = []

        def visit(path, active=()):
            require(path not in active, f'config_path cycle: {path}')
            require(len(active) <= MAX_DEPTH, f'config_path depth exceeds {MAX_DEPTH}')
            if path in done:
                return
            for target in references(self.load(path)):
                require(isinstance(self.load(target), dict),
                        f'agent config must be a mapping: {target}')
                visit(target, (*active, path))
            done.add(path)
            ordered.append(path)

        for path in list(self.cache):
            visit(path)
        for path in reversed(ordered):
            if path in candidates and path not in self.agent_documents:
                self.agent_documents.add(path)
                self.agent(candidates[path], str(path), active=(path,))
        require(len(self.models) == 1, f'models must be identical across all agents: {sorted(self.models)}')
        config = self.load(self.target('eval_config.yaml'))
        evaluation = config.get('evaluation') if isinstance(config, dict) else None
        cap = evaluation.get('max_time_minutes') if isinstance(evaluation, dict) else None
        require(type(cap) in (int, float) and math.isfinite(cap) and cap > 0,
                'evaluation.max_time_minutes: missing or invalid positive cap')
        require(cap * 125 + 30 <= 660, f'evaluation timing FAIL: {cap}*125+30 > 660 minutes')
        for field in ('timeout_seconds', 'max_tool_calls', 'max_turns'):
            if field in evaluation:
                require(type(evaluation[field]) is int and evaluation[field] > 0,
                        f'evaluation.{field}: must be a positive integer')

