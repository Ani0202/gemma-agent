   127	def walk_paths(root):
   128	    """Yield (path tuple, node) for every node; alias cycles cut by node identity on the path.
   129	    Raises ValueError on duplicate mapping keys."""
   130	    stack = [((), root, frozenset())]
   131	    while stack:
   132	        path, node, onpath = stack.pop()
   133	        yield path, node
   134	        if id(node) in onpath:
   135	            continue
   136	        onpath = onpath | {id(node)}
   137	        if isinstance(node, yaml.MappingNode):
   138	            keys = []
   139	            for k, v in node.value:
   140	                key = (k.tag, k.value) if isinstance(k, yaml.ScalarNode) else ('<complex>', id(k))
   141	                if key in keys:
   142	                    raise ValueError(f'duplicate mapping key {k.value!r} at {"/".join(map(str, path))}')
   143	                keys.append(key)
   144	                label = k.value if isinstance(k, yaml.ScalarNode) else '<complex>'
   145	                stack.append((path + (label,), v, onpath))
   146	        elif isinstance(node, yaml.SequenceNode):
   147	            for idx, v in enumerate(node.value):
   148	                stack.append((path + (idx,), v, onpath))
