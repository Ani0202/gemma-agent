   119	def compose(data, name):
   120	    """Composed YAML node tree (no construction, so custom tags are kept). Raises ValueError."""
   121	    try:
   122	        return yaml.compose(data.decode('utf-8'), Loader=StrictComposer)
   123	    except Exception as e:  # noqa: BLE001
   124	        raise ValueError(f'{name}: YAML compose failed: {e}') from e
