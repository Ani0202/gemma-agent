    76	def read_zip(path):
    77	    """Return ({name: bytes}, [problems]). Problems make the zip unusable for clause (b)."""
    78	    files, problems, seen_fold = {}, [], {}
    79	    with zipfile.ZipFile(path) as z:
    80	        infos = z.infolist()
    81	        for i in infos:
    82	            n = i.filename
    83	            if n in files:
    84	                problems.append(f'duplicate entry {n!r}')
    85	                continue
    86	            fold = unicodedata.normalize('NFC', n).casefold()
    87	            if fold in seen_fold:
    88	                problems.append(f'entry {n!r} collides with {seen_fold[fold]!r} (case/unicode fold)')
    89	            seen_fold[fold] = n
    90	            if n.endswith('/') or i.is_dir():
    91	                problems.append(f'directory entry {n!r}')
    92	                continue
    93	            parts = n.split('/')
    94	            if ('\\' in n or n.startswith('/') or any(p in ('', '.', '..') for p in parts)
    95	                    or posixpath.normpath(n) != n or '\x00' in n):
    96	                problems.append(f'non-normalized path {n!r}')
    97	                continue
    98	            mode = (i.external_attr >> 16) & 0xFFFF
    99	            if mode and stat.S_IFMT(mode) not in (0, stat.S_IFREG):
   100	                problems.append(f'entry {n!r} is not a regular file (mode {oct(mode)})')
   101	                continue
   102	            if i.flag_bits & 0x1:
   103	                problems.append(f'entry {n!r} is encrypted')
   104	                continue
   105	            files[n] = z.read(i)
   106	    names = set(files)
   107	    for n in names:
   108	        parts = n.split('/')
   109	        for k in range(1, len(parts)):
   110	            if '/'.join(parts[:k]) in names:
   111	                problems.append(f'file/directory conflict: {"/".join(parts[:k])!r} vs {n!r}')
   112	    return files, problems
