   150	
   151	def resolve(target, containing, names):
   152	    """Resolve an include/config_path value; None if missing or ambiguous."""
   153	    if not isinstance(target, str) or not target:
   154	        return None
   155	    cands = set()
   156	    for base in ('', posixpath.dirname(containing)):
   157	        p = posixpath.normpath(posixpath.join(base, target))
   158	        if p in names:
   159	            cands.add(p)
   160	    return cands.pop() if len(cands) == 1 else None
   161	
   162	
   163	def allowed_files(ref):
   164	    """{file: {path tuple: knob}} for files whose knob lines may change (derived from REFERENCE)."""
   165	    names, out, notes = set(ref), {}, []
   166	    if EVAL_CONFIG in names:
   167	        out[EVAL_CONFIG] = dict(EVAL_PATHS)
   168	    todo, done = [ROOT_AGENT] if ROOT_AGENT in names else [], set()
   169	    while todo:
   170	        doc = todo.pop()
   171	        if doc in done:
   172	            continue
   173	        done.add(doc)
   174	        try:
   175	            root = compose(ref[doc], doc)
   176	            nodes = list(walk_paths(root)) if root is not None else []
   177	        except ValueError as e:
   178	            notes.append(f'agent doc {doc} not analyzable, no allowance: {e}')
   179	            continue
   180	        perms = out.setdefault(doc, {})
   181	        for path, node in nodes:
   182	            if (len(path) >= 2 and path[-1] == 'config_path' and 'agent_tool' in path
   183	                    and isinstance(node, yaml.ScalarNode)):
   184	                t = resolve(node.value, doc, names)
   185	                if t is None:
   186	                    notes.append(f'{doc}: config_path {node.value!r} missing/ambiguous')
   187	                else:
   188	                    todo.append(t)
   189	        for path, node in nodes:
   190	            if path == ('generate_content_config',):
   191	                if isinstance(node, yaml.MappingNode):
   192	                    for rel, knob in GCC_REL.items():
   193	                        perms[('generate_content_config',) + rel] = knob
   194	                elif isinstance(node, yaml.ScalarNode) and node.tag == '!include':
   195	                    t = resolve(node.value, doc, names)
   196	                    if t is None:
   197	                        notes.append(f'{doc}: gcc include {node.value!r} missing/ambiguous, no allowance')
   198	                    else:
   199	                        out.setdefault(t, {}).update(GCC_REL)
   200	    return out, notes
   201	
   202	
   203	def parse_value(knob, text):
   204	    pat, lo, allow_float, strict = DOMAINS[knob]
   205	    if not re.fullmatch(pat, text):
   206	        return None
   207	    v = float(text) if allow_float else int(text)
   208	    if (strict and v <= lo) or v < lo:
   209	        return None
   210	    return v
   211	
   212	
   213	def compare_allowed(name, cdata, rdata, perms, knobs, violations):
   214	    def bad(reason, line=None):
   215	        violations.append({'file': name, 'path': [] if line is None else [f'line {line}'], 'reason': reason})
   216	
   217	    cl, rl = cdata.splitlines(keepends=True), rdata.splitlines(keepends=True)
   218	    if len(cl) != len(rl):
   219	        return bad(f'line count {len(cl)} != reference {len(rl)}')
   220	    changed = []
   221	    for i, (c, r) in enumerate(zip(cl, rl)):
   222	        if c == r:
   223	            continue
   224	        mc, mr = LINE_RE.match(c), LINE_RE.match(r)
   225	        if not (mc and mr) or mc.group(1, 2, 3, 5) != mr.group(1, 2, 3, 5):
   226	            return bad('non-knob line differs', i + 1)
   227	        knob = mc.group(2).decode()
   228	        if knob not in DOMAINS:
   229	            return bad(f'key {knob!r} is not a knob', i + 1)
   230	        changed.append((i, knob, mc.group(4).decode(), mr.group(4).decode()))
   231	    if not changed:
   232	        return None
   233	    trees = {}
   234	    for side, data in (('candidate', cdata), ('reference', rdata)):
   235	        try:
   236	            root = compose(data, f'{side} {name}')
   237	            trees[side] = list(walk_paths(root)) if root is not None else []
   238	        except ValueError as e:
   239	            return bad(str(e))
   240	    for i, knob, ctext, rtext in changed:
   241	        for side, text in (('candidate', ctext), ('reference', rtext)):
   242	            hits = [(p, n) for p, n in trees[side]
   243	                    if isinstance(n, yaml.ScalarNode) and n.start_mark.line == i and n.value == text]
   244	            if len(hits) != 1 or hits[0][1].style is not None or hits[0][1].tag not in (INT_TAG, FLOAT_TAG):
   245	                return bad(f'{side} value {text!r} is not a single plain numeric scalar', i + 1)
   246	            path = hits[0][0]
   247	            same = [p for p, n in trees[side] if n is hits[0][1]]
   248	            if any(perms.get(p) != knob for p in same):
   249	                return bad(f'{side} {knob} at {["/".join(map(str, p)) for p in same]} is not an allowed path', i + 1)
   250	        cv, rv = parse_value(knob, ctext), parse_value(knob, rtext)
   251	        entry = {'file': name, 'path': list(path), 'knob': knob, 'candidate': ctext, 'reference': rtext}
   252	        if cv is None or rv is None:
   253	            entry['status'] = 'NOT_COMPARABLE'
   254	            knobs.append(entry)
   255	            bad(f'knob {knob} outside valid domain: {ctext!r} vs {rtext!r}', i + 1)
   256	        elif cv <= rv:
   257	            entry['status'] = 'EQUAL' if cv == rv else 'DECREASE'
   258	            knobs.append(entry)
   259	        else:
   260	            entry['status'] = 'INCREASE'
   261	            knobs.append(entry)
   262	            bad(f'knob {knob} increased: {ctext} > {rtext}', i + 1)
   263	    return None
   264	
   265	
   266	def check(cand_zip, ref_zip):
   267	    cand, cprob = read_zip(cand_zip)
   268	    ref, rprob = read_zip(ref_zip)
   269	    violations, knobs, files = [], [], {}
   270	    for side, probs in (('candidate', cprob), ('reference', rprob)):
   271	        for p in probs:
   272	            violations.append({'file': f'<{side} zip>', 'path': [], 'reason': p})
   273	    for name in sorted(set(cand) - set(ref)):
   274	        violations.append({'file': name, 'path': [], 'reason': 'file only in candidate'})
   275	        files[name] = 'ONLY_CANDIDATE'
   276	    for name in sorted(set(ref) - set(cand)):
   277	        violations.append({'file': name, 'path': [], 'reason': 'file only in reference'})
   278	        files[name] = 'ONLY_REFERENCE'
   279	    allowed, notes = allowed_files(ref)
   280	    for name in sorted(set(cand) & set(ref)):
   281	        if cand[name] == ref[name]:
   282	            files[name] = 'BYTE_IDENTICAL'
   283	            continue
   284	        if name not in allowed:
   285	            files[name] = 'DIFFERS'
   286	            violations.append({'file': name, 'path': [], 'reason': 'not byte-identical (no knob allowance)'})
   287	            continue
   288	        before = len(violations)
   289	        compare_allowed(name, cand[name], ref[name], allowed[name], knobs, violations)
   290	        files[name] = 'DIFFERS' if len(violations) > before else 'KNOB_ONLY'
   291	    return {'files': files, 'knobs': knobs, 'violations': violations,
   292	            'allowed_files': {k: sorted('/'.join(map(str, p)) for p in v) for k, v in sorted(allowed.items())},
   293	            'notes': notes, 'verdict': 'INELIGIBLE' if violations else 'ELIGIBLE'}
   294	
   295	
   296	def check_reference_lb(lb_path, ref_sha):
   297	    with open(lb_path) as f:
   298	        lb = json.load(f)
   299	    problems = []
   300	    if lb.get('status') != 'COMPLETE':
   301	        problems.append(f"reference lb status {lb.get('status')!r} != 'COMPLETE'")
   302	    if lb.get('public_score') is None:
   303	        problems.append('reference lb public_score missing')
   304	    if lb.get('sha256') != ref_sha:
   305	        problems.append(f"reference lb sha256 {lb.get('sha256')!r} != reference zip {ref_sha}")
   306	    return {'path': lb_path, 'status': lb.get('status'), 'public_score': lb.get('public_score'),
   307	            'submission_ref': lb.get('submission_ref'), 'problems': problems}
   308	
   309	
   310	def main(argv=None):
   311	    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
   312	    ap.add_argument('candidate')
   313	    ap.add_argument('reference')
   314	    ap.add_argument('--reference-lb')
   315	    ap.add_argument('--out')
   316	    a = ap.parse_args(argv)
   317	    try:
   318	        res = check(a.candidate, a.reference)
   319	    except (OSError, zipfile.BadZipFile, ValueError) as e:
   320	        print(f'ERROR: {e}', file=sys.stderr)
   321	        return 2
   322	    out = {'_schema': SCHEMA, 'rule': 'ops/decisions/087-20261107T090954-880-from-builder.md item 1 (b)',
   323	           'candidate': {'zip': a.candidate, 'sha256': sha256_file(a.candidate)},
   324	           'reference': {'zip': a.reference, 'sha256': sha256_file(a.reference)}, **res}
   325	    if a.reference_lb:
   326	        out['reference_lb'] = check_reference_lb(a.reference_lb, out['reference']['sha256'])
   327	        if out['reference_lb']['problems']:
   328	            out['verdict'] = 'INELIGIBLE'
   329	    text = json.dumps(out, indent=1, default=repr)
   330	    if a.out:
   331	        with open(a.out, 'w') as f:
   332	            f.write(text + '\n')
   333	    print(f"{out['verdict']}: {a.candidate} vs {a.reference} "
   334	          f"({len(out['violations'])} violations"
   335	          f"{', ref-lb problems ' + str(len(out['reference_lb']['problems'])) if a.reference_lb else ''})")
   336	    for v in out['violations'][:20]:
   337	        print(f"  - {v['file']} {'/'.join(map(str, v['path']))}: {v['reason']}")
   338	    return 0 if out['verdict'] == 'ELIGIBLE' else 1
   339	
   340	
   341	if __name__ == '__main__':
   342	    sys.exit(main())

