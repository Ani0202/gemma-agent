        else:
            target_path = config_path
        return validate_sandboxed_path(
            path=target_path,
            base_dir=self.root_dir,
            allow_relative=True,
            must_exist=True,
            allow_symlinks=False,
            allowed_extensions={".yaml", ".yml"},
            error_prefix=error_prefix,
        )


