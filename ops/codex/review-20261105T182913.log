     1	"""Shared local scorer environment; no installed harness source is modified.
     2	
     3	The executor hook is after swegemma's path translation, and covers exec_async,
     4	run_command, setup, and verification as well as agent commands.
     5	"""
     6	from contextvars import ContextVar
     7	import base64
     8	import json
     9	import os
    10	from pathlib import Path
    11	import re
    12	import shlex
    13	import shutil
    14	import subprocess
    15	import sys
    16	import time
    17	
    18	from eval import proctree
    19	
    20	command_metrics = ContextVar('command_metrics', default=None)
    21	gold_artifact_dir = ContextVar('gold_artifact_dir', default=None)
    22	
    23	BWRAP_TEMPLATE = [
    24	    'bwrap', '--die-with-parent', '--unshare-net', '--unshare-pid',
    25	    '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc',
    26	    '--tmpfs', '<each hidden path>', '--tmpfs', '/tmp',
    27	    '--dir', '<each hidden path under /tmp, if any>',
    28	    '--bind', '<sandbox_root>', '<sandbox_root>',
    29	    '--ro-bind', '<each ro path>', '<same>',
    30	    '--chdir', '<workspace>', '/bin/bash', '-c', '<translated_cmd>',
    31	]
    32	
    33	
    34	def bwrap_argv(command, workspace, hidden_paths, ro_paths):
    35	    workspace = Path(workspace).resolve()
    36	    root = workspace.parent
    37	    argv = BWRAP_TEMPLATE[:11]
    38	    # Mask parents first so nested masks don't get covered by their parents.
    39	    for path in sorted({str(Path(p).absolute()) for p in hidden_paths},
    40	                       key=lambda p: (len(Path(p).parts), p)):
    41	        argv += ['--tmpfs', path]
    42	    argv += ['--tmpfs', '/tmp']
    43	    # A final /tmp mask removes nested hidden mountpoints. Recreate their empty
    44	    # directories so temporary inventories can be probed with ls as well.
    45	    for path in sorted({str(Path(p).absolute()) for p in hidden_paths}):
    46	        if path != '/tmp' and Path(path).is_relative_to('/tmp'):
    47	            argv += ['--dir', path]
    48	    argv += ['--bind', str(root), str(root)]
    49	    # Bind each asset at its resolved path and, when reached through a symlink
    50	    # (uv's cpython-3.13 -> cpython-3.13.18 alias under a masked $HOME), at the
    51	    # unresolved path too, so venv interpreter symlinks don't dangle in the sandbox.
    52	    binds = set()
    53	    for p in ro_paths:
    54	        src = str(Path(p).resolve())
    55	        binds |= {(src, src), (src, str(Path(p).absolute()))}
    56	    for path, dest in sorted(binds, key=lambda b: (len(Path(b[1]).parts), b)):
    57	        # Only explicit runtime assets may be re-exposed, never inventory/artifacts.
    58	        if ({'tasks.jsonl', 'splits', 'runs', 'results'} & (set(Path(path).parts) | set(Path(dest).parts))
    59	                or (Path(path).is_dir() and (Path(path) / 'tasks.jsonl').exists())):
    60	            raise ValueError('Forbidden read-only exposure')
    61	        argv += ['--ro-bind', path, dest]
    62	    argv += ['--chdir', str(workspace), *command]
    63	    return argv
    64	
    65	
    66	def runtime_ro_paths(workspace, ro_paths):
    67	    root = Path(workspace).resolve().parent
    68	    cfg = (root / 'venv/pyvenv.cfg').read_text()
    69	    home = next(line.split('=', 1)[1].strip() for line in cfg.splitlines()
    70	                if line.startswith('home ='))
    71	    prefix = Path(home).resolve().parent
    72	    if prefix != Path(sys.base_prefix).resolve():
    73	        raise ValueError('Sandbox python prefix differs from the scorer interpreter')
    74	    # Keep the unresolved alias too; bwrap_argv binds the resolved target there.
    75	    paths = {prefix, Path(home).absolute().parent, *(Path(p).resolve() for p in ro_paths)}
    76	    def wheel_target(path):
    77	        target = path.resolve()
    78	        # Agent-created symlinks must not turn an arbitrary directory into a
    79	        # new read-only exposure. Only wheel files or trusted wheelhouse subdirs
    80	        # can be reached through symlinks; a file mount cannot expose siblings.
    81	        if not (target.is_file() and target.suffix == '.whl') and not any(
    82	                target.is_relative_to(Path(p).resolve()) for p in ro_paths):
    83	            raise ValueError('Untrusted wheel symlink target')
    84	        paths.add(target)
    85	
    86	    wheels = root / 'wheels'
    87	    if wheels.is_symlink():
    88	        wheel_target(wheels)
    89	    for path in wheels.rglob('*'):
    90	        if path.is_symlink():
    91	            wheel_target(path)
    92	    return paths
    93	
    94	
    95	def execute_limited(command, cwd, env, timeout=300, *, shell=None,
    96	                    max_output_chars=10 * 1024 * 1024):
    97	    """Installed executor contract, with host process-tree limits and cleanup."""
    98	    from adk_eval_core.errors import EvalCoreError
    99	    from adk_eval_core.sandbox.base import ExecutionResult
   100	
   101	    start = time.perf_counter()
   102	    try:
   103	        # Fresh interpreters give threaded GOLD_CONCURRENCY workers separate
   104	        # subreaper/adoption domains, without forking a multithreaded process.
   105	        worker = subprocess.run(
   106	            [sys.executable, '-c', proctree.supervisor_source() + '\nsupervisor_main()\n'],
   107	            input=json.dumps(dict(command=command, cwd=str(cwd), env=dict(env),
   108	                                 timeout=timeout, shell=shell,
   109	                                 max_output_chars=max_output_chars)),
   110	            capture_output=True, text=True)
   111	        if worker.returncode:
   112	            raise RuntimeError('Sandbox supervisor failed: ' + worker.stderr)
   113	        result = json.loads(worker.stdout)
   114	        observed = result.pop('metrics')
   115	        metrics = command_metrics.get()
   116	        if metrics is not None:
   117	            metrics['peak_rss_bytes'] = max(metrics.get('peak_rss_bytes', 0),
   118	                                            observed.get('peak_rss_bytes', 0))
   119	            for key in ('mem_kills', 'orphan_kills'):
   120	                metrics[key] = metrics.get(key, 0) + observed.get(key, 0)
   121	        result['duration_seconds'] = round(time.perf_counter() - start, 3)
   122	        return ExecutionResult(**result)
   123	    except (RuntimeError, OSError, ValueError, EvalCoreError) as exc:
   124	        return ExecutionResult(status='error', stdout='', stderr=str(exc), exit_code=-1,
   125	                               duration_seconds=round(time.perf_counter() - start, 3))
   126	
   127	
   128	def apply_isolation(hidden_paths, ro_paths):
   129	    """Wrap the module executor, retaining the installed manager's translation/env.
   130	
   131	    Empty hidden_paths disables bwrap (explicit opt-out), but retains timeout
   132	    accounting. Repeated setup replaces this hook rather than stacking it.
   133	    """
   134	    import swegemma.sandbox.subprocess as sb
   135	    hidden_paths, ro_paths = tuple(hidden_paths), tuple(ro_paths)
   136	    original = getattr(sb.execute_subprocess_command, '_unwrapped', sb.execute_subprocess_command)
   137	
   138	    def execute(command, cwd, env, **kwargs):
   139	        if ro_paths:
   140	            command = [*command[:2], re.sub(r'(?<![\w.-])/wheels(?![\w.-])',
   141	                                           str(Path(ro_paths[0]).resolve()), command[2])]
   142	        if hidden_paths:
   143	            if not isinstance(command, list) or command[:2] != ['/bin/bash', '-c']:
   144	                raise RuntimeError('Unsupported harness subprocess command')
   145	            # The harness's fallback wheel search doesn't include custom data dirs.
   146	            command = bwrap_argv(command, cwd, hidden_paths, runtime_ro_paths(cwd, ro_paths))
   147	        result = execute_limited(command=command, cwd=cwd, env=env, **kwargs)
   148	        metrics = command_metrics.get()
   149	        if metrics is not None and (result.status == 'timeout' or result.exit_code == 124):
   150	            metrics['cmd_timeouts'] = metrics.get('cmd_timeouts', 0) + 1
   151	        return result
   152	
   153	    execute._unwrapped = original
   154	    sb.execute_subprocess_command = execute
   155	    return BWRAP_TEMPLATE.copy()
   156	
