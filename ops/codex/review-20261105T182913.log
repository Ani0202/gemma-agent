   287	def test_memory_excess_first_seen_in_cleanup(monkeypatch, tmp_path):
   288	    import io
   289	    runner = proctree.snapshot()[os.getpid()]
   290	    parent = replace(runner, pid=runner.pid + 100000, ppid=runner.pid, rss=1024)
   291	    child = replace(parent, pid=parent.pid + 1, rss=301 * 1024**2)
   292	    processes = {runner.pid: runner, parent.pid: parent}
   293	
   294	    class ExitingParent:
   295	        pid = parent.pid
   296	        returncode = None
   297	        peak_rss_bytes = 4096
   298	        stdout, stderr = io.StringIO(), io.StringIO()
   299	
   300	        def poll(self):
   301	            return self.returncode
   302	
   303	        def communicate(self, timeout=None):
   304	            # Parent exits 0 between live scan and cleanup. Only the cleanup
   305	            # scan sees its adopted child above the 300 MiB aggregate limit.
   306	            if self.returncode is None:
   307	                processes.pop(parent.pid)
   308	                self.returncode = 0
   309	            return '', ''
   310	
   311	    def kill(identities):
   312	        if not identities:
   313	            return 0
   314	        assert identities == {child.pid: child}
   315	        processes.pop(child.pid)
   316	        return 1
