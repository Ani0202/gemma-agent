   338	    assert result['status'] == 'error' and result['exit_code'] == 137
   339	    assert 'killed: sandbox memory limit' in result['stderr']
   340	    assert result['metrics']['mem_kills'] == 1
   341	    assert result['metrics']['peak_rss_bytes'] > 300 * 1024**2
   342	    assert result['metrics']['orphan_kills'] == 1
