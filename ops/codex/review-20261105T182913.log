   345	def test_threaded_supervisors_are_independent(tmp_path):
   346	    from concurrent.futures import ThreadPoolExecutor
   347	
   348	    def task(name, timeout):
   349	        metrics = {}
   350	        token = sandbox_env.command_metrics.set(metrics)
   351	        try:
   352	            code = ("import os,time; "
   353	                    f"open('{name}.pid','w').write(str(os.getpid())); "
   354	                    "time.sleep(.8); print('survived')")
   355	            result = sandbox_env.execute_limited(python(code), tmp_path,
   356	                                                  dict(os.environ), timeout=timeout)
   357	            return result, metrics
   358	        finally:
   359	            sandbox_env.command_metrics.reset(token)
   360	
   361	    with ThreadPoolExecutor(max_workers=2) as pool:
   362	        fast = pool.submit(task, 'fast', .3)
   363	        slow = pool.submit(task, 'slow', 3)
   364	        fast_result, fast_metrics = fast.result()
   365	        slow_result, slow_metrics = slow.result()
   366	    assert fast_result.status == 'timeout'
   367	    assert slow_result.status == 'ok' and slow_result.stdout == 'survived\n'
   368	    assert fast_metrics['peak_rss_bytes'] > 0
   369	    assert slow_metrics['peak_rss_bytes'] > 0
   370	    assert_dead(tmp_path / 'fast.pid')
   371	    assert_dead(tmp_path / 'slow.pid')
