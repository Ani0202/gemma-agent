   107	class RusagePopen(subprocess.Popen):
   108	    """Keep Popen's status/pipe handling while collecting the child's rusage.
   109	
   110	    POSIX Popen reaps through both _internal_poll and _try_wait (wait and
   111	    communicate). Both must use wait4 before the kernel discards the rusage.
   112	    """
   113	    peak_rss_bytes = 0
   114	
   115	    def _waitpid(self, pid, flags):
   116	        pid, status, usage = os.wait4(pid, flags)
   117	        if pid:
   118	            self.peak_rss_bytes = max(self.peak_rss_bytes, usage.ru_maxrss * 1024)
   119	        return pid, status
   120	
   121	    def _internal_poll(self, _deadstate=None):
   122	        # Popen's private poll callback signature differs between Python 3.12
   123	        # and 3.13. Keep its locking/status semantics with our wait4 callback.
   124	        if self.returncode is None and self._waitpid_lock.acquire(False):
   125	            try:
   126	                if self.returncode is None:
   127	                    pid, status = self._waitpid(self.pid, os.WNOHANG)
   128	                    if pid == self.pid:
   129	                        self._handle_exitstatus(status)
   130	            except OSError as exc:
   131	                if _deadstate is not None:
   132	                    self.returncode = _deadstate
   133	                elif exc.errno == errno.ECHILD:
   134	                    self.returncode = 0
   135	            finally:
   136	                self._waitpid_lock.release()
   137	        return self.returncode
   138	
   139	    def _try_wait(self, wait_flags):
   140	        try:
   141	            return self._waitpid(self.pid, wait_flags)
   142	        except ChildProcessError:
   143	            return self.pid, 0  # Match Popen's already-reaped child behavior.
