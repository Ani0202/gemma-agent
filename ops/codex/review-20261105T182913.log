   320	    monkeypatch.setattr(proctree, 'snapshot', lambda: processes.copy())
   321	    monkeypatch.setattr(proctree, 'RusagePopen', lambda *a, **kw: ExitingParent())
   322	    monkeypatch.setattr(proctree, 'kill_tree', kill)
