   325	    def wait_children(pid, flags):
   326	        nonlocal waits
   327	        assert pid == -1
   328	        waits += 1
   329	        if waits == 1:
   330	            # Simulate /proc missing a child during a fork/reparent race.
   331	            # wait4 still sees it, so cleanup must scan again before success.
   332	            processes[child.pid] = child
   333	            return 0, 0, None
   334	        raise ChildProcessError()
   335	
   336	    monkeypatch.setattr(proctree.os, 'wait4', wait_children)
