   158	def probe_isolation(manager, inventory_path, data_dir, *, empty_data=True):
   159	    """Fail closed on visibility, image imports, or broken workspace write-through."""
   160	    sid = manager.start()
   161	    try:
   162	        # Encode host paths to bypass swegemma's /tmp path translation in probes
   163	        # whose inventory is itself under /tmp. A failed ls must fail the probe.
   164	        encoded = lambda p: shlex.quote(base64.b64encode(str(p).encode()).decode())
   165	        empty_check = 'contents=$(ls -A "$data") && test -z "$contents" && ' if empty_data else ''
   166	        cmd = (f'inventory=$(printf %s {encoded(inventory_path)} | base64 -d); '
   167	               f'data=$(printf %s {encoded(data_dir)} | base64 -d); '
   168	               'test ! -e "$inventory" && ' + empty_check +
   169	               "python3 -c 'import pytest' && "
   170	               'echo probe > /workspace/x && echo probe > /tmp/y')
   171	        result = manager.exec(sid, cmd, timeout=60)
   172	        workspace = manager.sandboxes[sid]['workspace']
   173	        if result.exit_code != 0 or not (workspace / 'x').is_file():
   174	            raise RuntimeError('bubblewrap startup probe failed: ' + result.stderr[:500])
   175	    finally:
   176	        manager.cleanup_all()
   177	
