   278	def patch_subprocess_deps(data_dir):
   279	    """Emulate the docker-only dependency setup for the subprocess sandbox (swegemma skips it).
   280	
   281	    Contract (swegemma 0.2.11 container_setup): for docker, _ensure_container_site_packages
   282	    unpacks every deduplicated (highest-version, py313-compatible) wheel from wheels_dir that is
   283	    < 20 MB and not in skip_base_pkgs (pytest, pluggy, ... come from the image) straight into
   284	    site-packages, no resolver; large wheels are added only if imported by the workspace; then
   285	    sandbox/setup.py runs with --fast-path. We replicate exactly that inside the sandbox venv.
   286	    The sandbox venv uses system_site_packages=True, so the HOST python must mirror the image
   287	    (Dockerfile.public: pytest, pytest-timeout==2.1.0, typer, build backends; nothing else).
   288	    """
   289	    import tarfile
   290	    import swegemma.harness.container_setup as cs
   291	    import swegemma.harness.verification as vf
   292	    import swegemma.harness.sample_verification  # load all known by-name bindings
   293	    import swegemma.evaluate
   294	    import swegemma.cli
   295	    import swegemma.harness.agent_runner
   296	    orig = getattr(cs.install_test_dependencies, '_scorer_original', cs.install_test_dependencies)
   297	    previous = cs.install_test_dependencies
   298	    wheels_src = Path(data_dir) / 'wheels'
   299	    if not wheels_src.is_dir():
   300	        wheels_src = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')
   301	    setup_py = setup_script_path(data_dir)
   302	
   303	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   304	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   305	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   306	        venv_dir = docker.sandboxes[container_id]['venv']
   307	        sp_dir = next(iter(sorted(venv_dir.glob('lib/python3*/site-packages'))))
   308	        base_wheels, large_wheels, _m2p, _req = cs._inspect_wheels_dir(wheels_src)
   309	        selected = list(base_wheels)
   310	        if large_wheels:  # public wheels have none; fail loudly rather than silently diverge
   311	            raise RuntimeError('large wheels present; workspace-import scan not emulated')
   312	        tar_path = cs._build_unpacked_wheels_tar(selected, 'sp_base_local', '.swegemma_base_injected')
   313	        with tarfile.open(tar_path) as tf:
   314	            tf.extractall(sp_dir, filter='data')
   315	        docker.copy_to(container_id, setup_py, '/tmp/setup.py')
   316	        flag = '--fast-path' if fast_path else ''
   317	        docker.exec(container_id, f'python3 /tmp/setup.py {flag} {repo}'.strip(), timeout=280)
   318	        probe_log = os.environ.get('GOLD_PROBE_LOG')  # diagnostic: which copy of the repo package is imported
