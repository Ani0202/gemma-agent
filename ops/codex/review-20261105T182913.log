   179	def isolate_gold_tempfiles():
   180	    """Route verification's temporary patch serialization to the caller's out dir."""
   181	    import tempfile
   182	    import swegemma.harness.verification as vf
   183	    if getattr(vf.tempfile, '_gold_redirect', False):
   184	        return
   185	
   186	    class Tempfiles:
   187	        _gold_redirect = True
   188	
   189	        def __getattr__(self, name):
   190	            return getattr(tempfile, name)
   191	
   192	        def NamedTemporaryFile(self, *args, **kwargs):
   193	            if gold_artifact_dir.get() is not None:
   194	                kwargs['dir'] = gold_artifact_dir.get()
   195	            return tempfile.NamedTemporaryFile(*args, **kwargs)
   196	
   197	    vf.tempfile = Tempfiles()
