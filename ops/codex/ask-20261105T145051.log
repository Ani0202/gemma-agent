    31	def resolve_sandbox_image(
    32	    image_name: str = 'swebench-sandbox:latest',
    33	    client: Any | None = None,
    34	) -> str:
    35	    """Resolves the sandbox image in the Docker daemon, falling back to pre-seeded SDG tags."""
    36	    try:
    37	        if client is None:
    38	            import docker
    39	
    40	            client = docker.from_env()
    41	        try:
    42	            client.images.get(image_name)
    43	            return image_name
    44	        except Exception:
    45	            pass
    46	
    47	        for candidate in SDG_IMAGE_CANDIDATES:
    48	            try:
    49	                img = client.images.get(candidate)
    50	            except Exception:
    51	                continue
    52	
    53	            logger.info(
    54	                "Found pre-seeded SDG image '%s' for requested '%s'.",
    55	                candidate,
    56	                image_name,
    57	            )
    58	            try:
    59	                repo, tag = (
    60	                    image_name.split(':', 1)
    61	                    if ':' in image_name
    62	                    else (image_name, 'latest')
    63	                )
    64	                img.tag(repo, tag=tag)
    65	            except Exception:
    66	                logger.debug(
    67	                    "Best-effort re-tag of '%s' -> '%s' skipped (blocked by dockerproxy).",
    68	                    candidate,
    69	                    image_name,
    70	                )
    71	            return candidate
    72	    except Exception as e:
    73	        logger.warning(
    74	            "Could not query Docker daemon for sandbox image '%s': %s",
    75	            image_name,
    76	            e,
    77	        )
    78	    return image_name
