   184	    Contract (swegemma 0.2.11 container_setup): for docker, _ensure_container_site_packages
   185	    unpacks every deduplicated (highest-version, py313-compatible) wheel from wheels_dir that is
   186	    < 20 MB and not in skip_base_pkgs (pytest, pluggy, ... come from the image) straight into
   187	    site-packages, no resolver; large wheels are added only if imported by the workspace; then
   188	    sandbox/setup.py runs with --fast-path. We replicate exactly that inside the sandbox venv.
   189	    The sandbox venv uses system_site_packages=True, so the HOST python must mirror the image
   190	    (Dockerfile.public: pytest, pytest-timeout==2.1.0, typer, build backends; nothing else).
   191	    """
   192	    import tarfile
   193	    import swegemma.harness.container_setup as cs
   194	    import swegemma.harness.verification as vf
   195	    orig = cs.install_test_dependencies
   196	    wheels_src = Path(data_dir) / 'wheels'
   197	    if not wheels_src.is_dir():
   198	        wheels_src = WHEELHOUSE
   199	    setup_py = Path(data_dir) / 'sandbox' / 'setup.py'
   200	    if not setup_py.exists():
   201	        setup_py = next(iter(Path(data_dir).rglob('setup.py')), setup_py)  # competition sandbox/setup.py
   202	
   203	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   204	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   205	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   206	        venv_dir = docker.sandboxes[container_id]['venv']
   207	        sp_dir = next(iter(sorted(venv_dir.glob('lib/python3*/site-packages'))))
   208	        base_wheels, large_wheels, _m2p, _req = cs._inspect_wheels_dir(wheels_src)
   209	        selected = list(base_wheels)
   210	        if large_wheels:  # public wheels have none; fail loudly rather than silently diverge
   211	            raise RuntimeError('large wheels present; workspace-import scan not emulated')
   212	        tar_path = cs._build_unpacked_wheels_tar(selected, 'sp_base_local', '.swegemma_base_injected')
   213	        with tarfile.open(tar_path) as tf:
   214	            tf.extractall(sp_dir, filter='data')
   215	        docker.copy_to(container_id, setup_py, '/tmp/setup.py')
   216	        flag = '--fast-path' if fast_path else ''
   217	        docker.exec(container_id, f'python3 /tmp/setup.py {flag} {repo}'.strip(), timeout=280)
   218	        probe_log = os.environ.get('GOLD_PROBE_LOG')  # diagnostic: which copy of the repo package is imported
   219	        if probe_log:
   220	            pkg = {'Textualize/rich': 'rich', 'encode/httpx': 'httpx', 'fastapi/fastapi': 'fastapi',
   221	                   'psf/requests': 'requests'}.get(repo, repo.split('/')[-1])
   222	            out = docker.exec(container_id, f'cd /workspace && PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1 python3 -s -c '
   223	                              f'"import {pkg};print({pkg}.__file__)"', timeout=60)
   224	            with open(probe_log, 'a') as fh:
   225	                fh.write(json.dumps({'container': str(container_id), 'repo': repo, 'probe': str(out)[:500]}) + '\n')
   226	    cs.install_test_dependencies = install
   227	    vf.install_test_dependencies = install
