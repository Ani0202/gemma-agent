    30	def finished_results(text):
    31	    """Parse a journal, ignoring only a torn final JSON line; last full row wins.
    32	
    33	    Both successful verifications and errors are finished attempts. Malformed
    34	    complete records fail loudly rather than silently removing tasks.
    35	    """
    36	    results = {}
    37	    lines = text.splitlines(keepends=True)
    38	    for index, line in enumerate(lines):
    39	        try:
    40	            row = json.loads(line)
    41	        except json.JSONDecodeError:
    42	            if index == len(lines) - 1 and not line.endswith('\n'):
    43	                break
    44	            raise ValueError(f'Invalid results JSON at line {index + 1}') from None
    45	        if (not isinstance(row, dict) or not isinstance(row.get('instance_id'), str)
    46	                or not row['instance_id'] or not isinstance(row.get('repo'), str)
    47	                or type(row.get('resolved')) is not bool
    48	                or 'exit_code' not in row or 'error' not in row
    49	                or (row['exit_code'] is not None and type(row['exit_code']) is not int)
    50	                or (row['error'] is not None and not isinstance(row['error'], str))
    51	                or type(row.get('duration_seconds')) not in (float, int)
    52	                or not math.isfinite(row['duration_seconds']) or row['duration_seconds'] < 0):
    53	            raise ValueError(f'Invalid result schema at line {index + 1}')
    54	        results[row['instance_id']] = row
    55	    return results
