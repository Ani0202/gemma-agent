   498	def setup_git_exclude(docker: BaseSandboxManager, container_id: str) -> None:
   499	    """Configures git exclude rules in the container workspace."""
   500	    docker.exec(
   501	        container_id,
   502	        'mkdir -p /workspace/.git/info && printf "__pycache__/\\n*.pyc\\n.pytest_cache/\\n*.egg-info/\\nbuild/\\ndist/\\n.coverage\\n.adk_exec_*.py\\n" >> /workspace/.git/info/exclude',
   503	    )
