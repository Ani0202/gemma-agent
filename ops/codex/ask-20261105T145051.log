   158	def collect_from_requirements_files(workspace: Path) -> list[str]:
   159	    """Collects dependency names from requirements*.txt and test-requirements*.txt."""
   160	    collected: list[str] = []
   161	    req_files = list(workspace.glob("**/requirements*.txt")) + list(workspace.glob("**/test-requirements*.txt"))
   162	    for rf in req_files:
   163	        if "docker/" in str(rf) or ".git" in str(rf):
   164	            continue
   165	        try:
   166	            for line in rf.read_text(encoding="utf-8", errors="replace").splitlines():
   167	                cleaned = clean_requirement_line(line)
   168	                if cleaned:
   169	                    collected.append(cleaned)
   170	        except Exception:
   171	            pass
   172	    return collected
