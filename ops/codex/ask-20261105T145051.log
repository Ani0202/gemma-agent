    89	def _is_wheel_compatible_py313(filename: str) -> bool:
    90	    """Checks if a wheel filename is compatible with CPython 3.13 on Linux x86_64 under PEP 427."""
    91	    base = os.path.basename(filename)
    92	    if not base.endswith('.whl'):
    93	        return False
    94	    parts = base[:-4].split('-')
    95	    if len(parts) < 5:
    96	        return False
    97	    py_tag = parts[-3]
    98	    abi_tag = parts[-2]
    99	    if (
   100	        abi_tag in ('cp38', 'cp39', 'cp310', 'cp311', 'cp312')
   101	        and py_tag in ('cp38', 'cp39', 'cp310', 'cp311', 'cp312')
   102	    ):
   103	        return False
   104	    return abi_tag == 'none' or 'abi3' in abi_tag or 'cp313' in py_tag
   105	
   106	
   107	def _deduplicate_wheels(wheel_files: list[str]) -> list[Path]:
   108	    """Deduplicates compatible wheels to the highest version per normalized distribution name."""
   109	    import re
   110	
   111	    from packaging.version import parse as parse_version
   112	
   113	    latest: dict[str, tuple[object, Path]] = {}
   114	    for w_str in wheel_files:
   115	        if not _is_wheel_compatible_py313(w_str):
   116	            continue
   117	        p = Path(w_str)
   118	        parts = p.name[:-4].split('-')
   119	        pkg_norm = re.sub(r'[-_.]+', '_', parts[0]).lower()
   120	        try:
   121	            ver: object = parse_version(parts[1])
   122	        except Exception:
   123	            ver = parts[1]
   124	        prev = latest.get(pkg_norm)
   125	        if prev is None:
   126	            latest[pkg_norm] = (ver, p)
   127	        else:
   128	            try:
   129	                if ver > prev[0]:  # type: ignore[operator]
   130	                    latest[pkg_norm] = (ver, p)
   131	            except TypeError:
   132	                if str(ver) > str(prev[0]):
   133	                    latest[pkg_norm] = (ver, p)
   134	    return [item[1] for _, item in sorted(latest.items())]
   135	
   136	
   137	_LARGE_WHEEL_THRESHOLD_BYTES: int = 20 * 1024 * 1024
   138	_WHEEL_INDEX_CACHE: dict[
   139	    str,
   140	    tuple[list[Path], dict[str, Path], dict[str, set[str]], dict[str, set[str]]],
   141	] = {}
   142	
   143	
   144	def _inspect_wheels_dir(
   145	    wheels_dir: Path,
   146	) -> tuple[list[Path], dict[str, Path], dict[str, set[str]], dict[str, set[str]]]:
   147	    """Indexes wheels in wheels_dir into base (<16MB) and large (>=16MB) sets with module and dependency graphs."""
   148	    import re
   149	    import zipfile
   150	
   151	    key = str(wheels_dir.resolve())
   152	    if key in _WHEEL_INDEX_CACHE:
   153	        return _WHEEL_INDEX_CACHE[key]
   154	
   155	    skip_base_pkgs = {
   156	        'pytest',
   157	        'pytest_timeout',
   158	        'pytest_asyncio',
   159	        'pytest_httpbin',
   160	        'pytest_xdist',
   161	        'pluggy',
   162	        'pip',
   163	        'setuptools',
   164	        'wheel',
   165	    }
   166	
   167	    all_wheels = [
   168	        str(wheels_dir / f) for f in os.listdir(wheels_dir) if f.endswith('.whl')
   169	    ]
   170	    deduped = _deduplicate_wheels(all_wheels)
   171	
   172	    base_wheels: list[Path] = []
   173	    large_wheels: dict[str, Path] = {}
   174	    module_to_pkg: dict[str, set[str]] = {}
   175	    pkg_requires: dict[str, set[str]] = {}
   176	
   177	    for w_path in deduped:
   178	        pkg_norm = re.sub(r'[-_.]+', '_', w_path.name.split('-', 1)[0]).lower()
   179	        if pkg_norm in skip_base_pkgs:
   180	            continue
   181	        if w_path.stat().st_size < _LARGE_WHEEL_THRESHOLD_BYTES:
   182	            base_wheels.append(w_path)
   183	        else:
   184	            large_wheels[pkg_norm] = w_path
   185	
   186	        module_to_pkg.setdefault(pkg_norm, set()).add(pkg_norm)
   187	        try:
   188	            with zipfile.ZipFile(w_path, 'r') as zf:
   189	                names = zf.namelist()
   190	                for n in names:
   191	                    top = n.split('/', 1)[0]
   192	                    if top.endswith('.dist-info') or top.endswith('.data'):
   193	                        if n.endswith('/top_level.txt'):
   194	                            tl_txt = zf.read(n).decode('utf-8', errors='ignore')
   195	                            for line in tl_txt.splitlines():
   196	                                mod = line.strip().split('/')[0].lower()
   197	                                if mod:
   198	                                    module_to_pkg.setdefault(mod, set()).add(pkg_norm)
   199	                        elif n.endswith('/METADATA'):
   200	                            meta_txt = zf.read(n).decode('utf-8', errors='ignore')
   201	                            for line in meta_txt.splitlines():
   202	                                if line.startswith('Requires-Dist:'):
   203	                                    raw_dep = line.split(':', 1)[1].strip()
   204	                                    if ';' in raw_dep and 'extra ==' in raw_dep:
   205	                                        continue
   206	                                    m_dep = re.match(r'^([a-zA-Z0-9_\-\.]+)', raw_dep)
   207	                                    if m_dep:
   208	                                        dep_norm = re.sub(
   209	                                            r'[-_.]+', '_', m_dep.group(1)
   210	                                        ).lower()
   211	                                        pkg_requires.setdefault(pkg_norm, set()).add(
   212	                                            dep_norm
   213	                                        )
   214	                    else:
   215	                        mod_name = (
   216	                            top[:-3].lower()
   217	                            if top.endswith('.py')
   218	                            else top.split('.')[0].lower()
   219	                        )
   220	                        if mod_name and not mod_name.startswith('_'):
   221	                            module_to_pkg.setdefault(mod_name, set()).add(pkg_norm)
   222	        except Exception:
   223	            pass
   224	
   225	    res = (base_wheels, large_wheels, module_to_pkg, pkg_requires)
   226	    _WHEEL_INDEX_CACHE[key] = res
   227	    return res
   228	
   229	
   230	_WHEELS_TAR_LOCK = threading.Lock()
   231	
   232	
   233	def _build_unpacked_wheels_tar(
   234	    selected_wheels: list[Path], cache_name: str, marker_name: str
   235	) -> Path:
   236	    """Unpacks selected_wheels into a cached uncompressed tar archive with a marker file."""
   237	    import shutil
   238	    import subprocess
   239	    import tempfile
   240	    import uuid
   241	    import zipfile
   242	    from concurrent.futures import ThreadPoolExecutor
   243	
   244	    cache_dir = Path(tempfile.gettempdir()) / 'swegemma_sp_cache_v8'
   245	    cache_dir.mkdir(parents=True, exist_ok=True)
   246	    tar_path = cache_dir / f'{cache_name}.tar'
   247	    if tar_path.exists() and tar_path.stat().st_size > 0:
   248	        return tar_path
   249	
   250	    with _WHEELS_TAR_LOCK:
   251	        if tar_path.exists() and tar_path.stat().st_size > 0:
   252	            return tar_path
   253	
   254	        uid = uuid.uuid4().hex[:8]
   255	        staging_dir = cache_dir / f'staging_{cache_name}_{os.getpid()}_{uid}'
   256	        if staging_dir.exists():
   257	            shutil.rmtree(staging_dir, ignore_errors=True)
   258	        staging_dir.mkdir(parents=True, exist_ok=True)
   259	
   260	        def _extract_one(w_path: Path) -> None:
   261	            try:
   262	                with zipfile.ZipFile(w_path, 'r') as zf:
   263	                    members = [
   264	                        m
   265	                        for m in zf.infolist()
   266	                        if not m.filename.endswith(('.pyc', '/RECORD'))
   267	                    ]
   268	                    zf.extractall(staging_dir, members=members)
   269	            except Exception as e:
   270	                logger.debug('Skipping wheel %s during staging: %s', w_path.name, e)
   271	
   272	        try:
   273	            with ThreadPoolExecutor(max_workers=8) as pool:
   274	                list(pool.map(_extract_one, selected_wheels))
   275	
   276	            for data_dir in list(staging_dir.glob('*.data')):
   277	                for sub_name in ('purelib', 'platlib'):
   278	                    sub_dir = data_dir / sub_name
   279	                    if sub_dir.is_dir():
   280	                        for item in sub_dir.iterdir():
   281	                            dest = staging_dir / item.name
   282	                            if not dest.exists():
   283	                                shutil.move(str(item), str(dest))
   284	                shutil.rmtree(data_dir, ignore_errors=True)
   285	
   286	            (staging_dir / marker_name).write_text('ok\n', encoding='utf-8')
   287	
   288	            tmp_tar = cache_dir / f'{cache_name}_{os.getpid()}_{uid}.tar.tmp'
   289	            subprocess.run(
   290	                ['tar', '-cf', str(tmp_tar), '-C', str(staging_dir), '.'],
   291	                check=True,
   292	            )
   293	            tmp_tar.replace(tar_path)
   294	        finally:
   295	            shutil.rmtree(staging_dir, ignore_errors=True)
   296	
   297	    return tar_path
   298	
   299	
   300	def _extract_tar_into_site_packages(
   301	    docker: BaseSandboxManager, container_id: str, tar_path: Path
   302	) -> None:
   303	    """Streams or copies a tar archive and extracts it into /usr/local/lib/python3.13/site-packages."""
   304	    sp_dir = '/usr/local/lib/python3.13/site-packages'
   305	    stream_fn = getattr(docker, '_stream_tar_via_exec_socket', None)
   306	    if callable(stream_fn):
   307	        with open(tar_path, 'rb') as f:
   308	            if stream_fn(container_id, f, sp_dir):
   309	                return
   310	    staged = f'/var/tmp/{tar_path.name}'
   311	    docker.copy_to(container_id, tar_path, staged)
   312	    docker.exec(
   313	        container_id,
   314	        f'tar --no-same-owner -xf {shlex.quote(staged)} -C {sp_dir} && rm -f {shlex.quote(staged)}',
   315	    )
   316	
   317	
   318	def _ensure_container_site_packages(
   319	    docker: BaseSandboxManager,
   320	    container_id: str,
   321	    repo: str,
   322	    config: EvalConfig | None = None,
   323	) -> None:
   324	    """Dynamically injects cached unpacked wheels into container site-packages based on workspace imports."""
   325	    if not hasattr(docker, 'extract_archive_to_container'):
   326	        return
   327	
   328	    wheels_dir = resolve_wheels_dir(config)
   329	    if not wheels_dir:
   330	        return
   331	
   332	    base_wheels, large_wheels, module_to_pkg, pkg_requires = _inspect_wheels_dir(
   333	        wheels_dir
   334	    )
   335	    sp_dir = '/usr/local/lib/python3.13/site-packages'
   336	
   337	    # 1. Inject base wheels (<16MB) once per container
   338	    base_marker = f'{sp_dir}/.swegemma_base_injected'
   339	    if docker.exec(container_id, f'test -f {base_marker}').exit_code != 0:
   340	        base_tar = _build_unpacked_wheels_tar(
   341	            base_wheels, 'sp_base', '.swegemma_base_injected'
   342	        )
   343	        _extract_tar_into_site_packages(docker, container_id, base_tar)
   344	
   345	    if not large_wheels:
   346	        return
   347	
   348	    # 2. Discover top-level imported modules in /workspace and resolve transitive large wheels (>=16MB)
   349	    scan_cmd = (
   350	        'python3 -S -c "'
   351	        'import pathlib, re; mods = set(); '
   352	        '[mods.update(m.group(1).lower() for m in re.finditer(r\'^\\s*(?:import|from)\\s+([a-zA-Z0-9_]+)\', p.read_text(errors=\'ignore\'), re.M)) '
   353	        'for p in pathlib.Path(\'/workspace\').rglob(\'*.py\') if \'.git\' not in p.parts]; '
   354	        'print(\' \'.join(sorted(mods)))" 2>/dev/null'
   355	    )
   356	    scan_res = docker.exec(container_id, scan_cmd)
   357	    imported_mods = set((scan_res.stdout or '').split())
   358	    if repo:
   359	        repo_short = repo.rsplit('/', 1)[-1].lower()
   360	        imported_mods.add(repo_short)
   361	
   362	    needed_pkgs: set[str] = set()
   363	    queue: list[str] = []
   364	    for mod in imported_mods:
   365	        for pkg_norm in module_to_pkg.get(mod, ()):
   366	            if pkg_norm not in needed_pkgs:
   367	                needed_pkgs.add(pkg_norm)
   368	                queue.append(pkg_norm)
   369	
   370	    while queue:
   371	        curr = queue.pop()
   372	        for dep in pkg_requires.get(curr, ()):
   373	            if dep not in needed_pkgs:
   374	                needed_pkgs.add(dep)
   375	                queue.append(dep)
   376	            for p_cand in large_wheels:
   377	                if p_cand.startswith(curr + '_') and p_cand not in needed_pkgs:
   378	                    needed_pkgs.add(p_cand)
   379	                    queue.append(p_cand)
   380	
   381	    needed_large = sorted(p for p in needed_pkgs if p in large_wheels)
   382	    for pkg_norm in needed_large:
   383	        marker = f'{sp_dir}/.swegemma_whl_{pkg_norm}'
   384	        if docker.exec(container_id, f'test -f {marker}').exit_code != 0:
   385	            w_tar = _build_unpacked_wheels_tar(
   386	                [large_wheels[pkg_norm]],
   387	                f'sp_whl_{pkg_norm}',
   388	                f'.swegemma_whl_{pkg_norm}',
   389	            )
   390	            _extract_tar_into_site_packages(docker, container_id, w_tar)
   391	
   392	
   393	def setup_container_wheels(
   394	    docker: BaseSandboxManager, container_id: str, config: EvalConfig
   395	) -> None:
   396	    """Copies task wheels into the sandbox container if available on host and not already present."""
   397	    check_res = docker.exec(container_id, 'ls /wheels/*.whl 2>/dev/null | wc -l')
   398	    if check_res.exit_code == 0 and check_res.stdout.strip() not in ('0', ''):
   399	        logger.debug(
   400	            'Container %s already has wheels populated in /wheels, skipping copy.',
   401	            container_id,
   402	        )
   403	        return
   404	
   405	    # For real Docker containers with extract_archive_to_container, install_test_dependencies
   406	    # streams unpacked wheels directly into site-packages, avoiding a 1.7 GB /wheels tar copy per task.
   407	    if hasattr(docker, 'extract_archive_to_container'):
   408	        return
   409	
   410	    wheels_path = resolve_wheels_dir(config)
   411	    if wheels_path:
   412	        docker.exec(container_id, 'mkdir -p /wheels')
   413	        docker.copy_to(container_id, wheels_path, '/wheels')
