    91	def deduplicate_wheels(wheel_files: list[str]) -> dict[str, str]:
    92	    """Selects the highest version wheel per normalized distribution name."""
    93	    grouped: dict[str, list[dict[str, Any]]] = {}
    94	    for filename in wheel_files:
    95	        info = parse_wheel_filename(filename)
    96	        if info is not None:
    97	            grouped.setdefault(info["normalized"], []).append(info)
    98	
    99	    selected: dict[str, str] = {}
   100	    for norm_name, candidates in grouped.items():
   101	        sorted_candidates = sorted(
   102	            candidates,
   103	            key=lambda c: (
   104	                parse_semver_for_sort(c["version"]),
   105	                1 if "py3" in c["pyver"] or "py2.py3" in c["pyver"] else 0,
   106	                c["filename"],
   107	            ),
   108	            reverse=True,
   109	        )
   110	        selected[norm_name] = sorted_candidates[0]["filename"]
   111	    return selected
