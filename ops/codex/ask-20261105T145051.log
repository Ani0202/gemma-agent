   416	def extract_snapshot(
   417	    docker: BaseSandboxManager,
   418	    container_id: str,
   419	    snapshot_path: Path,
   420	    *,
   421	    patch_path: Path | None = None,
   422	    base_snapshot_path: Path | None = None,
   423	) -> None:
   424	    """Copies a snapshot tarball (or base snapshot + patch) into the container and extracts it into /workspace."""
   425	    tar_to_copy = (
   426	        base_snapshot_path if base_snapshot_path is not None else snapshot_path
   427	    )
   428	    extracted = False
   429	    extract_fn = getattr(docker, 'extract_archive_to_container', None)
   430	    if callable(extract_fn):
   431	        extracted = bool(
   432	            extract_fn(
   433	                container_id, tar_to_copy, '/workspace'
   434	            )
   435	        )
   436	        if not extracted:
   437	            logger.warning(
   438	                'Direct archive extraction of %s into /workspace failed on container %s; falling back to copy + tar',
   439	                tar_to_copy.name,
   440	                container_id,
   441	            )
   442	    if not extracted:
   443	        docker.copy_to(container_id, tar_to_copy, '/tmp')
   444	        ext_res = docker.exec(
   445	            container_id,
   446	            f'(tar --no-same-owner -I pigz -xf /tmp/{tar_to_copy.name} -C /workspace 2>/dev/null || tar --no-same-owner -xzf /tmp/{tar_to_copy.name} -C /workspace) && rm -f /tmp/{tar_to_copy.name}',
   447	        )
   448	        if ext_res.exit_code != 0:
   449	            msg = f'Failed to extract snapshot {tar_to_copy.name} on container {container_id}: {ext_res.stderr or ext_res.stdout}'
   450	            logger.error(msg)
   451	            raise ContainerSetupError(msg)
   452	
   453	    # Apply incremental patch if provided
   454	    if patch_path is not None and patch_path.exists():
   455	        docker.copy_to(container_id, patch_path, '/tmp')
   456	        exit_code, stdout, stderr = apply_patch_in_container(
   457	            docker,
   458	            container_id,
   459	            f'/tmp/{patch_path.name}',
   460	            workspace_dir='/workspace',
   461	        )
   462	        docker.exec(container_id, f'rm -f /tmp/{shlex.quote(patch_path.name)}')
   463	        if exit_code != 0:
   464	            msg = f'Failed to apply incremental patch {patch_path.name} on container {container_id}: {stderr or stdout}'
   465	            logger.error(msg)
   466	            raise ContainerSetupError(msg)
   467	
   468	    # Remove any circular symlinks from snapshot (pointing to /workspace or ancestors)
   469	    # that cause setuptools find_packages() and pytest directory walkers to loop infinitely
   470	    docker.exec(
   471	        container_id,
   472	        "python3 -S -c \"import pathlib; ws=pathlib.Path('/workspace').resolve(); "
   473	        "[p.unlink() for p in list(ws.rglob('*')) if p.is_symlink() and (p.resolve() == ws or ws.is_relative_to(p.resolve()))]\" 2>/dev/null || true",
   474	    )
   475	
   476	
   477	def extract_deduplicated_snapshot(
   478	    docker: BaseSandboxManager,
   479	    container_id: str,
   480	    base_snapshot_path: Path,
   481	    patch_path: Path | None = None,
   482	    fallback_path: Path | None = None,
   483	) -> None:
   484	    """Extracts a deduplicated snapshot: uses fallback archive if present, else base snapshot + incremental patch."""
   485	    if fallback_path and fallback_path.exists():
   486	        extract_snapshot(docker, container_id, fallback_path)
   487	        return
   488	
   489	    extract_snapshot(
   490	        docker,
   491	        container_id,
   492	        base_snapshot_path,
   493	        patch_path=patch_path,
   494	        base_snapshot_path=base_snapshot_path,
   495	    )
