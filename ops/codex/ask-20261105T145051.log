    69	def summarize(tasks, results):
    70	    """Aggregate every input task, including failures and unfinished attempts."""
    71	    pending = pending_tasks(tasks, results)
    72	    if os.environ.get('GOLD_LIMIT'):  # smoke runs only: first task of each repo
    73	        seen = set(); pending = [t for t in pending if not (t['repo'] in seen or seen.add(t['repo']))]
    74	    repos = {}
    75	    passing, failing = [], []
    76	    for task in tasks:
    77	        task_id = task['instance_id']
    78	        counts = repos.setdefault(task['repo'], dict(total=0, finished=0, passed=0, failed=0, pending=0))
    79	        counts['total'] += 1
    80	        row = results.get(task_id)
    81	        if row is None:
    82	            counts['pending'] += 1
    83	            continue
    84	        counts['finished'] += 1
    85	        if row['resolved']:
    86	            counts['passed'] += 1
    87	            passing.append(task_id)
    88	        else:
    89	            counts['failed'] += 1
    90	            reason = row['error'] or f"verification unresolved (exit_code={row['exit_code']})"
    91	            failing.append({'instance_id': task_id, 'reason': reason[:200]})
    92	    passing.sort()
    93	    return dict(total=len(tasks), finished=len(results), passed=len(passing),
    94	                failed=len(failing), pending=len(pending), concurrency=CONCURRENCY,
    95	                timing_note='Concurrent calibration durations are not scorer timing measurements.',
    96	                per_repo=dict(sorted(repos.items())), passing_ids=passing,
    97	                failing_ids=sorted(failing, key=lambda row: row['instance_id']),
    98	                pending_ids=sorted(task['instance_id'] for task in pending))
