   101	def resume_journal(path):
   102	    """Repair only an interrupted final append, preserving all complete records."""
   103	    if not path.exists():
   104	        return {}
   105	    text = path.read_text(encoding='utf-8')
   106	    results = finished_results(text)
   107	    if text and not text.endswith('\n'):
   108	        try:
   109	            json.loads(text.splitlines()[-1])
   110	        except json.JSONDecodeError:
   111	            # Remove an incomplete tail before further appends. No completed row is lost.
   112	            with path.open('r+b') as stream:
   113	                stream.truncate(len(text[:text.rfind('\n') + 1].encode('utf-8')))
   114	        else:
   115	            with path.open('a', encoding='utf-8') as stream:
   116	                stream.write('\n')
   117	    return results
