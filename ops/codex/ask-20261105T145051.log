    58	def pending_tasks(tasks, results):
    59	    """Validate the current task inventory and return unfinished tasks in order."""
    60	    inventory = {task['instance_id']: task['repo'] for task in tasks}
    61	    if len(inventory) != len(tasks):
    62	        raise ValueError('Duplicate task ids in tasks.jsonl')
    63	    for task_id, row in results.items():
    64	        if task_id not in inventory or inventory[task_id] != row['repo']:
    65	            raise ValueError('Resume journal does not match task inventory')
    66	    return [task for task in tasks if task['instance_id'] not in results]
