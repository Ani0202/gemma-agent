   165	             '--network=none', '--memory=4g', '--cpus=2',
   166	             '--entrypoint', 'python3', 'swebench-sandbox:latest', '-c', 'pass'],
   167	            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
   168	        if probe.returncode == 0:
   169	            return 'docker'
   170	    except (OSError, subprocess.TimeoutExpired):
   171	        pass
   172	    finally:
   173	        try:
   174	            subprocess.run(['docker', 'rm', '-f', name], stdout=subprocess.DEVNULL,
   175	                           stderr=subprocess.DEVNULL, timeout=10)
   176	        except (OSError, subprocess.TimeoutExpired):
   177	            pass
   178	    return 'subprocess'
