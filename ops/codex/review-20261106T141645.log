   425	def smoke_metrics(run_dir, tasks_path=None):
   426	    timing = Path(run_dir) / 'timing.jsonl'
   427	    paths, rows = [timing, GATE_YAML], []
   428	    tasks_path = Path(tasks_path) if tasks_path is not None else _tasks_path()
   429	    if tasks_path.is_file():
   430	        paths.append(tasks_path)
   431	    try:
   432	        test_files = load_task_test_files(tasks_path)
   433	    except Exception:
   434	        test_files = {}  # criterion ii is UNVERIFIABLE for every missing task
