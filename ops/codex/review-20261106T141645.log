    37	def run(cmd):
    38	    p = subprocess.run(['/bin/bash', '-c', cmd], capture_output=True, text=True)
    39	    assert p.returncode == 0, p.stderr
    40	    out = p.stdout.strip().splitlines()
    41	    assert len(out) == 2 and out[0].startswith('GATE call='), p.stdout
    42	    return out
