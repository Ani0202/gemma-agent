    50	def apply(ws, edits):
    51	    for e in edits:
    52	        if e.startswith('DEL '):
    53	            (ws / e[4:]).unlink()
    54	        elif e == 'COPIES':
    55	            subprocess.run(['git', 'config', 'diff.renames', 'copies'], check=True, cwd=ws)
    56	        elif e.startswith('CP '):
    57	            import shutil
    58	            a, b = e[3:].split(' -> ')
    59	            (ws / b).parent.mkdir(parents=True, exist_ok=True)
    60	            shutil.copyfile(ws / a, ws / b)
    61	        elif e.startswith('MODE '):
    62	            (ws / e[5:]).chmod(0o755)
    63	        elif e.startswith('MV '):
    64	            a, b = e[3:].split(' -> ')
    65	            (ws / b).parent.mkdir(parents=True, exist_ok=True)
    66	            subprocess.run(['git', 'mv', a, b], check=True, cwd=ws)
    67	        else:
    68	            (ws / e).parent.mkdir(parents=True, exist_ok=True)
    69	            with open(ws / e, 'a') as fh:
    70	                fh.write('y\n')
