   100	def test_gate(tmp_path, edits, expected):
   101	    ws = make_repo(tmp_path, reverse='MV tests/a.py -> src/a.py' in edits)
   102	    apply(ws, edits)
   103	    cmd = gate_cmd(ws, tmp_path / 'n')
   104	    got = [verdict(run(cmd)) for _ in expected]
   105	    assert got == expected
