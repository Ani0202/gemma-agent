   359	def _schema(mode, paths):
   360	    return dict(name='plan008_metrics/v1', mode=mode, definitions=DEFINITIONS,
   361	                script_sha256=base.sha(__file__),
   362	                input_shas={str(p): base.sha(p) for p in dict.fromkeys(map(Path, paths))})
   363	
   364	
   365	def base_metrics():
   366	    rows, paths = [], [base.ARM_IDS, base.__file__, 'eval/plan007_report.py']
   367	    for part, timing, d4path, a2path in base.PARTS:
   368	        d4, a2 = [json.loads(Path(p).read_text()) for p in (d4path, a2path)]
   369	        assert d4['classifier_sha256'] == base.D4_SHA and a2['classifier_sha256'] == base.A2_SHA
   370	        assert d4['input_sha256'] == base.sha(timing) == a2['input_sha256']
   371	        ts = base.load_rows(timing)
   372	        cs, als = base.unique_map(d4['rows'], d4path), base.unique_map(a2['rows'], a2path)
   373	        assert set(cs) == set(als) == {r['instance_id'] for r in ts}
   374	        paths.extend((timing, d4path, a2path))
   375	        for t in ts:
   376	            iid = t['instance_id']
   377	            base.assert_paired(cs[iid], t)
   378	            base.assert_paired(als[iid], t)
   379	            trace = Path(timing).parent / 'runs' / iid / 'trace.json'
   380	            entries = json.loads(trace.read_text())['entries']
   381	            paths.append(trace)
   382	            rep = identical_runs_root(entries)
   383	            rows.append(dict(instance_id=iid, part=part, **rep, mechanism2=rep['max_run'] >= 5,
   384	                             mechanism1_empty=t.get('verified_patch_bytes') == 0,
   385	                             submitted_without_test=submitted_without_test(entries, gate_mode=False)))
   386	    assert [r['instance_id'] for r in rows] == base.ids_file(base.ARM_IDS)
   387	    totals = dict(mechanism2=sum(r['mechanism2'] for r in rows),
   388	                  mechanism1_empty=sum(r['mechanism1_empty'] for r in rows),
   389	                  submitted_without_test=sum(r['submitted_without_test'] is True for r in rows),
   390	                  count_no_successful_submit=sum(r['submitted_without_test'] is None for r in rows),
   391	                  max_run=max((r['max_run'] for r in rows), default=0),
   392	                  runs_ge3=sum(r['runs_ge3'] for r in rows), runs_ge5=sum(r['runs_ge5'] for r in rows),
   393	                  repeated_calls=sum(r['repeated_calls'] for r in rows))
   394	    assert totals['mechanism2'] == 17, 'arm-1 mechanism2 baseline changed'
   395	    assert totals['mechanism1_empty'] == 12, 'arm-1 empty baseline changed'
   396	    assert totals['submitted_without_test'] == 23, 'arm-1 safety baseline changed'
   397	    assert totals['count_no_successful_submit'] == 7, 'arm-1 no-submit baseline changed'
   398	    return dict(_schema=_schema('base', paths), n_rows=len(rows), totals=totals, rows=rows)
   399	
