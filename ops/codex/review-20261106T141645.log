    21	ROOT = 'swe_baseline_agent'
    22	GATE_YAML = Path('bundles/31b/v010/sub_agents/submit_gate.yaml')
    23	TEST = re.compile(r'\bpytest\b|-m\s+unittest\b|\btox\b')
    24	BOUNCE = ('NOT SUBMITTED: no non-test source file is changed. Make your source edit with '
    25	          'edit_file (or a /tmp Python script), confirm it with git diff --stat, then call submit_patch again.')
    26	DEFINITIONS = {
    27	    'mechanism1_empty': 'verified_patch_bytes == 0 (plan007 empty definition)',
    28	    'mechanism2': 'rows with max_run >= 5; root-author tool calls only; same tool and sort_keys JSON args; nested calls excluded before runs',
    29	    'repeated_calls': 'sum(length - 1) over root identical runs',
    30	    'submitted_without_test': 'successful root submit with no prior root run_command matching \\bpytest\\b|-m\\s+unittest\\b|\\btox\\b; no success excluded and counted separately',
    31	    'success': 'first root harness patch_size response (builtin), or gate-authored inner harness patch_size response attributed to its enclosing root submit; acknowledgement not required',
    32	    'submit_unverifiable': 'inner/builtin success vs explicit patch_submitted mismatch, or flag unavailable; missing flag derived from harness response only, not acknowledgement; rows counted and listed',
    33	    'smoke': '008.md D73.2 i-v; missing evidence UNVERIFIABLE; overall PASS requires every criterion PASS',
    34	    'gate_descriptives': 'root submit calls; reply-prefix bounces/failures; gate run_command response forced/check_error counts; terminal bounces; internal visibility',
    35	    'gate_llm_limit': 'gate-authored limit evidence, or an unacknowledged enclosing gate with the runner turns-budget error; inferred from saved evidence',
    36	    'gate_detection': 'v010 header label or gate request/reply/child events; otherwise builtin layout and gate counts n/a',
    37	    'untracked_only': 'D72.2: canonical SUBMITTED reply and nonempty scored patch with all sections declaring new file mode; absent scored-patch evidence reported separately',
    38	}
