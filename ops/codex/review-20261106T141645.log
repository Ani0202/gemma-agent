   401	def load_task_test_files(tasks_path):
   402	    # Match agent_timing.evaluate / run_agent_eval.run: the Task property derives
   403	    # these paths from test_patch. Never use gold patch or test text as agent input.
   404	    from swegemma.models import load_tasks
   405	    tasks = load_tasks(Path(tasks_path))
   406	    inventory = {t.instance_id: list(t.test_files) for t in tasks}
   407	    if len(inventory) != len(tasks):
   408	        raise ValueError('duplicate task IDs')
   409	    return inventory
