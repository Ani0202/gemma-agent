    12	def gate_cmd(ws, counter):
    13	    ins = yaml.safe_load(GATE.read_text())['instruction']
    14	    lines = ins.splitlines()
    15	    cmd = lines[lines.index(next(l for l in lines if 'exactly this command' in l)) + 2].strip()
    16	    assert cmd.startswith('cd /workspace && ') and cmd.count('/tmp/.submit_gate_n') == 3
    17	    return cmd.replace('/workspace', str(ws)).replace('/tmp/.submit_gate_n', str(counter))
