   412	def _tasks_path():
   413	    if os.environ.get('PLAN008_TASKS_PATH'):
   414	        return Path(os.environ['PLAN008_TASKS_PATH'])
   415	    kaggle = Path('/kaggle/input/competitions/gemma-4-developer-agent/tasks.jsonl')
   416	    return kaggle if kaggle.is_file() else Path('data/raw/tasks.jsonl')
