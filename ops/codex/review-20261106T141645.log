   419	def _artifacts(run_dir, iid):
   420	    # Kaggle: runs/<iid>; local eval runner: <iid>.
   421	    nested = Path(run_dir) / 'runs' / iid
   422	    return nested if nested.is_dir() else Path(run_dir) / iid
