    24	def make_repo(tmp_path, tag=True, reverse=False):
    25	    ws = tmp_path / 'ws'
    26	    files = [f for f in BASE_FILES if not (reverse and f == 'src/a.py')]
    27	    if reverse:
    28	        files.append('tests/a.py')
    29	    for f in files:
    30	        (ws / f).parent.mkdir(parents=True, exist_ok=True)
    31	        (ws / f).write_text(f + '\nx\n')
    32	    subprocess.run('git init -q && git add -A && git -c user.email=a@b -c user.name=a commit -qm i'
    33	                   + (' && git tag _swegemma_baseline' if tag else ''), shell=True, check=True, cwd=ws)
    34	    return ws
