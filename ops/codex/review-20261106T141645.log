    41	def _parsed(value):
    42	    if isinstance(value, str):
    43	        try:
    44	            return json.loads(value)
    45	        except (ValueError, TypeError):
    46	            pass
    47	    return value
    48	
    49	
    50	def _reply(value):
    51	    """Legacy AgentTool text is JSON {raw: text} (sometimes {result: text})."""
    52	    value = _parsed(value)
    53	    if isinstance(value, str):
    54	        return value
    55	    if isinstance(value, dict):
    56	        for k in ('raw', 'result'):
    57	            if k in value:
    58	                return _reply(value[k])
    59	    return ''
    60	
    61	
    62	def _pairs(entries):
    63	    # Legacy trace has no call IDs. FIFO by (author, tool) also isolates nested tools.
    64	    pending, calls = defaultdict(deque), []
    65	    for i, e in enumerate(entries):
    66	        key = (e.get('author'), e.get('tool'))
    67	        if e.get('type') == 'tool_call':
    68	            c = dict(e, entry_index=i, response=None, response_index=None)
    69	            calls.append(c)
    70	            pending[key].append(c)
    71	        elif e.get('type') in ('tool_response', 'tool_result') and pending[key]:
    72	            c = pending[key].popleft()
    73	            c.update(response=e.get('result', ''), response_index=i)
    74	    return calls
    75	
    76	
    77	def root_tool_calls(entries, root=ROOT):
    78	    """Ordered call dictionaries, enriched with response text and entry/response indices."""
    79	    return [c for c in _pairs(entries) if c.get('author') == root]
    80	
    81	
    82	def identical_runs_root(entries):
    83	    lens, cur, prev = [], 0, object()
    84	    for c in root_tool_calls(entries):
    85	        key = (c.get('tool'), json.dumps(c.get('args', c.get('arguments')), sort_keys=True))
    86	        if key == prev:
    87	            cur += 1
    88	        else:
    89	            if cur:
    90	                lens.append(cur)
    91	            cur = 1
    92	        prev = key
    93	    if cur:
    94	        lens.append(cur)
    95	    return dict(max_run=max(lens, default=0), runs_ge3=sum(n >= 3 for n in lens),
    96	                runs_ge5=sum(n >= 5 for n in lens), repeated_calls=sum(n - 1 for n in lens))
    97	
    98	
    99	def _has_error(value):
   100	    value = _parsed(value)
   101	    if isinstance(value, dict):
   102	        if value.get('error') or str(value.get('status', '')).lower() in ('error', 'failed', 'failure'):
   103	            return True
   104	        return any(_has_error(v) for v in value.values())
   105	    if isinstance(value, list):
   106	        return any(_has_error(v) for v in value)
   107	    return False
   108	
   109	
   110	def _patch_size(value):
   111	    value = _parsed(value)
   112	    if isinstance(value, dict) and not _has_error(value):
   113	        n = value.get('patch_size')
   114	        if type(n) is int and n >= 0:
   115	            return n
   116	    return None
   117	
   118	
   119	def gate_invocations(entries):
   120	    """Legacy traces lack event IDs: enclose children by root call/reply interval.
   121	
   122	    A missing acknowledgement ends at the next root call or trace end. This retains
   123	    inner captures interrupted by a deadline, without assigning them to a later call.
   124	    Only the root tool_response is a canonical gate reply.
   125	    """
   126	    pairs = _pairs(entries)
   127	    roots = [c for c in pairs if c.get('author') == ROOT]
   128	    gates = []
   129	    for i, c in enumerate(roots):
   130	        if c.get('tool') != 'submit_patch':
   131	            continue
   132	        end = roots[i + 1]['entry_index'] if i + 1 < len(roots) else len(entries)
   133	        reply_index = c['response_index']
   134	        canonical = (reply_index is not None and reply_index < end
   135	                     and entries[reply_index].get('type') == 'tool_response')
   136	        if canonical:
   137	            end = reply_index
   138	        children = [dict(p, response=None, response_index=None)
   139	                    if p['response_index'] is not None and p['response_index'] >= end else p
   140	                    for p in pairs if p.get('author') == 'submit_patch'
   141	                    and c['entry_index'] < p['entry_index'] < end]
   142	        inner = [p for p in children if p.get('tool') == 'submit_patch'
   143	                 and p['response_index'] is not None and p['response_index'] < end
   144	                 and _patch_size(p['response']) is not None]
   145	        gates.append(dict(c, root_index=i, children=children, inner_successes=inner,
   146	                          canonical_reply=_reply(c['response']) if canonical else '',
   147	                          canonical_index=reply_index if canonical else None))
   148	    return gates
   149	
   150	
   151	def successful_submit_index(entries, gate_mode=None):
   152	    gates = {g['entry_index']: g for g in gate_invocations(entries)}
   153	    for i, c in enumerate(root_tool_calls(entries)):
   154	        if c.get('tool') != 'submit_patch':
   155	            continue
   156	        gate = gates[c['entry_index']]
   157	        args = c.get('args', c.get('arguments'))
   158	        is_gate = gate_mode if gate_mode is not None else bool(
   159	            gate['children'] or isinstance(args, dict) and 'request' in args
   160	            or gate['canonical_reply'] in ('SUBMITTED', BOUNCE)
   161	            or gate['canonical_reply'].startswith('SUBMIT FAILED'))
   162	        if (gate['inner_successes'] if is_gate else _patch_size(c['response']) is not None):
   163	            return i
   164	    return None
   165	
   166	
   167	def _terminal_flag(row, entries):
   168	    if type(row.get('patch_submitted')) is bool:
   169	        return row['patch_submitted'], 'row'
   170	    flags = [e['patch_submitted'] for e in entries if type(e.get('patch_submitted')) is bool]
   171	    return (flags[-1], 'trace') if flags else (None, 'derived_from_harness_response')
   172	
   173	
   174	def submit_evidence(row, entries, gate_mode=None, trace_loaded=True):
   175	    observed = successful_submit_index(entries, gate_mode) is not None
   176	    flag, source = _terminal_flag(row, entries)
   177	    known = type(flag) is bool
   178	    return dict(submit_unverifiable=not trace_loaded or not known or flag != observed,
   179	                patch_submitted=flag if known else observed,
   180	                patch_submitted_source=source,
   181	                successful_submit=observed)
   182	
   183	
   184	def submitted_without_test(entries, gate_mode=None):
   185	    index = successful_submit_index(entries, gate_mode)
   186	    if index is None:
   187	        return None
   188	    return not any(c.get('tool') == 'run_command' and TEST.search(_command(c))
   189	                   for c in root_tool_calls(entries)[:index])
   190	
   191	
   192	def d735_counts(r):
   193	    """D73.5 (dec 074 item 2): a submit_unverifiable row counts as submitted_without_test
   194	    unless a root test run precedes the earliest candidate boundary. The observed value
   195	    already tests root calls before the enclosing root submit call (the earlier of the
   196	    two candidates), so False is kept; no candidate (None) = worst case = counted. If
   197	    patch_submitted is False it ALSO counts in no_successful_submit. Verifiable rows keep
   198	    the observed D73.3 values. Mutates and returns the row."""
   199	    obs = r['submitted_without_test']
   200	    if r['submit_unverifiable']:
   201	        r['swt_d735'] = obs is not False
   202	        r['no_submit_d735'] = r['patch_submitted'] is not True
   203	    else:
   204	        r['swt_d735'] = obs is True
   205	        r['no_submit_d735'] = obs is None
   206	    return r
   207	
   208	
   209	def _command(c):
   210	    args = c.get('args', c.get('arguments'))
   211	    return args.get('command', '') if isinstance(args, dict) and isinstance(args.get('command', ''), str) else ''
   212	
   213	
   214	def _response_text(value):
   215	    return value if isinstance(value, str) else json.dumps(value)
   216	
   217	
   218	def gate_descriptives(entries, row=None):
   219	    roots = root_tool_calls(entries)
   220	    gates = gate_invocations(entries)
   221	    cmds = [c for g in gates for c in g['children'] if c.get('tool') == 'run_command']
   222	    limit = any('LlmCallsLimitExceeded' in _response_text(e) for e in entries
   223	                if e.get('author') == 'submit_patch')
   224	    if row and gates and gates[-1]['canonical_index'] is None and gates[-1]['root_index'] == len(roots) - 1:
   225	        limit |= row.get('agent_outcome') == 'turns'
   226	        limit |= any(re.search(r'LlmCallsLimitExceeded|exceeded turns budget|maximum allowed LLM turns', str(row.get(k, ''))) is not None
   227	                     for k in ('agent_error', 'agent_error_text', 'result_error', 'error'))
   228	    return dict(gate_calls=len(gates),
   229	                bounces=sum(g['canonical_reply'].startswith('NOT SUBMITTED') for g in gates),
   230	                forced=sum('reason=forced' in _response_text(c['response']) for c in cmds),
   231	                check_error=sum('reason=check_error' in _response_text(c['response']) for c in cmds),
   232	                submit_failed=sum(g['canonical_reply'].startswith('SUBMIT FAILED') for g in gates),
   233	                bounce_no_followup=sum(g['root_index'] == len(roots) - 1 and
   234	                                       g['canonical_reply'].startswith('NOT SUBMITTED') for g in gates),
   235	                gate_llm_limit=int(limit),
   236	                unacknowledged_inner_submits=sum(len(g['inner_successes']) for g in gates
   237	                                                if g['canonical_reply'] != 'SUBMITTED'),
   238	                gate_run_cmds=[_command(c) for c in cmds],
   239	                gate_internal_visible=any(g['children'] for g in gates))
   240	
   241	
   242	def untracked_only(patch_text):
   243	    sections = re.split(r'^diff --git ', patch_text, flags=re.M)[1:]
   244	    return bool(patch_text.strip() and sections) and all(
   245	        re.search(r'^new file mode [0-7]+\s*$', s, re.M) is not None for s in sections)
   246	
   247	
   248	def _gate_command(path):
   249	    # Read the literal YAML instruction block without a YAML dependency.
   250	    lines = Path(path).read_text().splitlines()
   251	    i = next(i for i, line in enumerate(lines) if '1. Call `run_command` ONCE' in line)
   252	    return next(line[2:] for line in lines[i + 1:] if line.strip())
   253	
   254	
   255	def _criterion(status, reason):
   256	    return dict(status=status, reason=reason)
   257	
   258	
   259	def smoke_check(row, entries, gate_yaml_path, scored_patch=None, test_files_loaded=False):
   260	    """D73.2 i..v. scored_patch must already be stripped with task.test_files.
   261	
   262	    Missing evidence is UNVERIFIABLE, which is FAIL for the overall smoke.
   263	    Reasons are fixed descriptions; commands, patches and task text are never emitted.
   264	    """
   265	    out = {}
   266	    gates = gate_invocations(entries)
   267	    desc = gate_descriptives(entries, row)
   268	    expected = _gate_command(gate_yaml_path)
   269	    failures, missing = [], []
   270	    captures = []
   271	    if not gates:
   272	        failures.append('no gate invocation in task')
   273	    for gate in gates:
   274	        children = gate['children']
   275	        if not children:
   276	            missing.append('gate internals absent')
   277	            continue
   278	        if gate['canonical_index'] is None:
   279	            missing.append('canonical gate response absent')
   280	        cmds = [c for c in children if c.get('tool') == 'run_command']
   281	        subs = [c for c in children if c.get('tool') == 'submit_patch']
   282	        captures.extend(gate['inner_successes'])
   283	        if len(cmds) != 1 or _command(cmds[0]) != expected:
   284	            failures.append('gate check command differs or count differs')
   285	        elif cmds[0]['response_index'] is None:
   286	            missing.append('gate check response absent')
   287	        else:
   288	            text = _response_text(cmds[0]['response'])
   289	            need_submit = 'VERDICT=SUBMIT' in text or 'VERDICT=EDIT_FIRST' not in text
   290	            if need_submit and (len(subs) != 1 or subs[0]['entry_index'] <= cmds[0]['response_index']
   291	                                or not gate['inner_successes']):
   292	                failures.append('successful inner submit absent or out of order')
   293	            if not need_submit and subs:
   294	                failures.append('inner submit after EDIT_FIRST')
   295	        if gate['canonical_reply'] == 'SUBMITTED':
   296	            for e in entries[gate['canonical_index'] + 1:]:
   297	                if e.get('author') != ROOT or e.get('type') in ('tool_response', 'tool_result'):
   298	                    continue
   299	                if e.get('type') == 'final' and e.get('content') == gate['canonical_reply']:
   300	                    continue  # legacy recorder's mirrored function-response display
   301	                failures.append('root model event after successful gate response')
   302	                break
   303	    if gates and not captures:
   304	        missing.append('no successful inner submit evidence')
   305	    flag, _ = _terminal_flag(row, entries)
   306	    if flag is False:
   307	        failures.append('run did not end with patch_submitted true')
   308	    elif flag is not True:
   309	        missing.append('terminal patch_submitted flag absent')
   310	    out['i'] = _criterion('FAIL' if failures else 'UNVERIFIABLE' if missing else 'PASS',
   311	                          '; '.join(failures or missing) or 'gate sequence and termination observed')
   312	
   313	    actual = row.get('verified_patch_bytes')
   314	    if not test_files_loaded or scored_patch is None or not captures or type(actual) is not int:
   315	        out['ii'] = _criterion('UNVERIFIABLE', 'task test_files, saved patch or capture evidence missing')
   316	    else:
   317	        size = _patch_size(captures[-1]['response'])
   318	        agrees = len(scored_patch) == size and len(scored_patch.encode('utf-8')) == actual
   319	        out['ii'] = _criterion('PASS' if agrees else 'FAIL',
   320	                               'stripped patch characters and UTF-8 bytes agree' if agrees else 'stripped patch sizes differ')
   321	
   322	    errors = bool(desc['check_error'] or desc['submit_failed'])
   323	    for key in ('agent_error', 'agent_error_text', 'result_error', 'error'):
   324	        err = row.get(key)
   325	        if err and (re.search(r'unknown[ _-]tool|ToolErrorPlugin|compile|validator', str(err), re.I)
   326	                    or not re.search(r'budget|timeout|timed out', str(err), re.I)):
   327	            errors = True
   328	    for e in entries:
   329	        if e.get('author') not in (ROOT, 'submit_patch'):
   330	            continue
   331	        if e.get('type') in ('tool_response', 'tool_result'):
   332	            text = _response_text(e.get('result', ''))
   333	            errors |= _has_error(text) or bool(re.search(r'unknown[ _-]tool|ToolErrorPlugin|compile error|validator error', text, re.I))
   334	    malformed = False
   335	    for gate in gates:
   336	        args = gate.get('args', gate.get('arguments'))
   337	        malformed |= not (isinstance(args, dict) and set(args) == {'request'}
   338	                          and isinstance(args['request'], str) and bool(args['request']))
   339	        malformed |= gate['canonical_reply'] not in ('SUBMITTED', BOUNCE)
   340	        for c in gate['children']:
   341	            args = c.get('args', c.get('arguments'))
   342	            if c.get('tool') == 'run_command':
   343	                malformed |= args != {'command': expected}
   344	            elif c.get('tool') == 'submit_patch':
   345	                malformed |= args != {}
   346	            else:
   347	                malformed = True
   348	    out['iii'] = _criterion('FAIL' if errors or malformed else 'PASS',
   349	                            'error or malformed gate call/reply observed' if errors or malformed else 'no errors or malformed gate calls/replies observed')
   350	    clock = row.get('agent_clock_seconds')
   351	    valid = type(clock) in (int, float) and math.isfinite(clock) and clock >= 0
   352	    out['iv'] = _criterion('UNVERIFIABLE' if not valid else 'PASS' if clock <= 210 else 'FAIL',
   353	                           'agent clock missing or invalid' if not valid else 'agent clock within 210 seconds' if clock <= 210 else 'agent clock exceeds 210 seconds')
   354	    out['v'] = _criterion('PASS' if desc['bounces'] <= 2 else 'FAIL',
   355	                          'at most two EDIT_FIRST replies' if desc['bounces'] <= 2 else 'more than two EDIT_FIRST replies')
   356	    return out
   357	
