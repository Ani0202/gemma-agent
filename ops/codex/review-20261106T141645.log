     6	Smoke loads task.test_files with swegemma.models.load_tasks, as both eval runners do.
     7	Tasks default to data/raw/tasks.jsonl (local) or the Kaggle competition tasks.jsonl;
     8	PLAN008_TASKS_PATH overrides that location for downloaded runs. Missing tasks fail smoke.
     9	"""
    10	import json
    11	import math
    12	import os
    13	from pathlib import Path
    14	import re
    15	import sys
    16	from collections import defaultdict, deque
    17	
    18	sys.path.insert(0, str(Path(__file__).resolve().parent))
    19	import plan007_arm1_summary as base
