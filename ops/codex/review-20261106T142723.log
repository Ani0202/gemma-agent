   461	def load_task_test_files(tasks_path):
   462	    # Match agent_timing.evaluate / run_agent_eval.run: the Task property derives
   463	    # these paths from test_patch. Never use gold patch or test text as agent input.
   464	    from swegemma.models import load_tasks
   465	    tasks = load_tasks(Path(tasks_path))
   466	    inventory = {t.instance_id: list(t.test_files) for t in tasks}
   467	    if len(inventory) != len(tasks):
   468	        raise ValueError('duplicate task IDs')
   469	    return inventory
