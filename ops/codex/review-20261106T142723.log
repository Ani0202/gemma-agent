   530	def arm2_metrics(run_dir):
   531	    timing = Path(run_dir) / 'timing.jsonl'
   532	    paths, rows, inputs = [timing], [], []
   533	    for row in base.load_rows(timing):
   534	        artifacts = _artifacts(run_dir, row['instance_id'])
   535	        trace = artifacts / 'trace.json'
   536	        if trace.is_file():
   537	            paths.append(trace)
   538	        entries = json.loads(trace.read_text()).get('entries', []) if trace.is_file() else []
   539	        inputs.append((row, entries, artifacts))
   540	    # Builtin responses carry patch_size; gate requests carry request, children
   541	    # have author submit_patch. Header/directory labels cover runs with no calls.
   542	    headers = [json.loads(line) for line in timing.read_text().splitlines() if line.strip()
   543	               and 'instance_id' not in json.loads(line)]
   544	    inv = inventory([row['instance_id'] for row, _, _ in inputs], expected_ids('arm2'))
   545	    if not inv['complete']:
   546	        raise IncompleteRun(inv)
   547	    bundle, bundle_source = selected_bundle(headers)
   548	    gate_events = (any(
   549	        e.get('author') == 'submit_patch' or
   550	        (e.get('author') == ROOT and e.get('tool') == 'submit_patch' and
   551	         (isinstance(e.get('args'), dict) and 'request' in e['args'] or
   552	          _reply(e.get('result')) in ('SUBMITTED', BOUNCE)))
   553	        for _, entries, _ in inputs for e in entries))
   554	    has_gate = bundle == 'v010' if bundle else gate_events
   555	    for row, entries, artifacts in inputs:
   556	        rep = identical_runs_root(entries)
   557	        desc = gate_descriptives(entries, row) if has_gate else {}
   558	        desc.pop('gate_run_cmds', None)
   559	        if has_gate:
   560	            # D72's untracked-only descriptive requires a canonical acknowledgement;
   561	            # the D73 SAFETY boundary below needs only an inner harness capture.
   562	            acknowledged = any(g['canonical_reply'] == 'SUBMITTED' for g in gate_invocations(entries))
   563	            desc['untracked_only_submits'] = None if acknowledged else False
   564	            if acknowledged:
   565	                result = artifacts / 'result.json'
   566	                if not result.is_file():
   567	                    result = artifacts / 'output.json'
   568	                scored = None
   569	                if result.is_file():
   570	                    paths.append(result)
   571	                    scored = json.loads(result.read_text()).get('agent_patch')
   572	                patch = artifacts / 'agent.patch'
   573	                if scored is None and patch.is_file():
   574	                    paths.append(patch)
   575	                    try:
   576	                        from swegemma.harness.verification import strip_protected_files_from_patch
   577	                        tasks_path = _tasks_path()
   578	                        if tasks_path.is_file():
   579	                            paths.append(tasks_path)
   580	                        tests = load_task_test_files(tasks_path)[row['instance_id']]
   581	                        scored = strip_protected_files_from_patch(patch.read_bytes().decode('utf-8'), extra_protected_paths=tests)
   582	                    except Exception:
   583	                        scored = None
   584	                if isinstance(scored, str):
   585	                    desc['untracked_only_submits'] = untracked_only(scored)
   586	        else:
   587	            desc = dict.fromkeys((*GATE_COUNTS, 'gate_internal_visible'), 'n/a (no gate)')
   588	        rows.append(dict(instance_id=row['instance_id'], **rep, mechanism2=rep['max_run'] >= 5,
   589	                         mechanism1_empty=row.get('verified_patch_bytes') == 0,
   590	                         submitted_without_test=submitted_without_test(entries, has_gate),
   591	                         **submit_evidence(row, entries, has_gate, (artifacts / 'trace.json').is_file()), **desc))
   592	    for r, (_, entries, _) in zip(rows, inputs):
   593	        d735_counts(r, entries)
   594	    totals = dict(mechanism2=sum(r['mechanism2'] for r in rows),
   595	                  mechanism1_empty=sum(r['mechanism1_empty'] for r in rows),
   596	                  # D73.5 (ship-rule numbers): unverifiable rows count against arm 2.
   597	                  submitted_without_test=sum(r['swt_d735'] for r in rows),
   598	                  count_no_successful_submit=sum(r['no_submit_d735'] for r in rows),
   599	                  submitted_without_test_observed=sum(r['submitted_without_test'] is True for r in rows),
   600	                  count_no_successful_submit_observed=sum(r['submitted_without_test'] is None for r in rows),
   601	                  max_run=max((r['max_run'] for r in rows), default=0),
   602	                  runs_ge3=sum(r['runs_ge3'] for r in rows), runs_ge5=sum(r['runs_ge5'] for r in rows),
   603	                  repeated_calls=sum(r['repeated_calls'] for r in rows),
   604	                  submit_unverifiable=sum(r['submit_unverifiable'] for r in rows))
   605	    for key in GATE_COUNTS:
   606	        totals[key] = (sum(r[key] for r in rows if r[key] is not None) if has_gate else 'n/a (no gate)')
   607	    totals['untracked_only_unverifiable'] = sum(r.get('untracked_only_submits') is None for r in rows) if has_gate else 'n/a (no gate)'
   608	    return dict(_schema=_schema('arm2', paths), n_rows=len(rows), inventory=inv,
   609	                selected_bundle=bundle, selected_bundle_source=bundle_source,
   610	                gate_layout=has_gate, gate_events_observed=gate_events,
   611	                bundle_identity_conflict=bundle is not None and gate_events != has_gate,
   612	                totals=totals,
   613	                submit_unverifiable_rows=[r['instance_id'] for r in rows if r['submit_unverifiable']],
   614	                d735_rule='submit_unverifiable rows: submitted_without_test unless root test before earliest candidate boundary (none = counted); patch_submitted not True -> also no_successful_submit',
   615	                rows=rows)
   616	
   617	
   618	def main(argv=None):
   619	    argv = sys.argv if argv is None else argv
   620	    if len(argv) == 3 and argv[1] == 'base':
   621	        out = base_metrics()
   622	    elif len(argv) == 4 and argv[1] in ('smoke', 'arm2'):
   623	        try:
   624	            out = (smoke_metrics if argv[1] == 'smoke' else arm2_metrics)(argv[2])
   625	        except IncompleteRun as e:
   626	            print('INCOMPLETE arm2 inventory; no results written:', json.dumps(e.args[0]))
   627	            return 3
   628	    else:
   629	        print(__doc__)
   630	        return 2
   631	    Path(argv[-1]).write_text(json.dumps(out, indent=2) + '\n')
   632	    print(json.dumps(out.get('totals', dict(n_rows=out['n_rows'], overall=out.get('overall')))))
   633	    return 0
   634	
   635	
   636	if __name__ == '__main__':
   637	    sys.exit(main())

