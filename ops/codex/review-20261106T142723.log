   251	    out = dict(expected=len(expected), observed=len(ids),
   252	               missing=[i for i in expected if i not in seen],
   253	               extra=sorted(seen - set(expected)),
   254	               duplicates=sorted({i for i in ids if ids.count(i) > 1}),
   255	               order_matches=list(ids) == list(expected))
   256	    out['complete'] = not (out['missing'] or out['extra'] or out['duplicates'])
   257	    return out
