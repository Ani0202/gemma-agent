    71	def _pairs(entries):
    72	    # Legacy trace has no call IDs. FIFO by (author, tool) also isolates nested tools.
    73	    pending, calls = defaultdict(deque), []
    74	    for i, e in enumerate(entries):
    75	        key = (e.get('author'), e.get('tool'))
    76	        if e.get('type') == 'tool_call':
    77	            c = dict(e, entry_index=i, response=None, response_index=None)
    78	            calls.append(c)
    79	            pending[key].append(c)
    80	        elif e.get('type') in ('tool_response', 'tool_result') and pending[key]:
    81	            c = pending[key].popleft()
    82	            c.update(response=e.get('result', ''), response_index=i)
    83	    return calls
    84	
