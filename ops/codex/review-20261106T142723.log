   208	             if p.get('author') == 'submit_patch' and p.get('tool') == 'submit_patch'
   209	             and p['response_index'] is not None and _patch_size(p['response']) is not None]
   210	    cands += [g['entry_index'] for g in gate_invocations(entries) if g['inner_successes']]
   211	    cands += [c['entry_index'] for c in root_tool_calls(entries)
   212	              if c.get('tool') == 'submit_patch' and _patch_size(c['response']) is not None]
