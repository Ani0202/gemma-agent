    94	        key = (c.get('tool'), json.dumps(c.get('args', c.get('arguments')), sort_keys=True))
    95	        if key == prev:
    96	            cur += 1
    97	        else:
    98	            if cur:
    99	                lens.append(cur)
   100	            cur = 1
   101	        prev = key
   102	    if cur:
   103	        lens.append(cur)
