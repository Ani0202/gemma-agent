   128	def gate_invocations(entries):
   129	    """Legacy traces lack event IDs: enclose children by root call/reply interval.
   130	
   131	    A missing acknowledgement ends at the next root call or trace end. This retains
   132	    inner captures interrupted by a deadline, without assigning them to a later call.
   133	    Only the root tool_response is a canonical gate reply.
   134	    """
   135	    pairs = _pairs(entries)
   136	    roots = [c for c in pairs if c.get('author') == ROOT]
   137	    gates = []
   138	    for i, c in enumerate(roots):
   139	        if c.get('tool') != 'submit_patch':
   140	            continue
   141	        end = roots[i + 1]['entry_index'] if i + 1 < len(roots) else len(entries)
   142	        reply_index = c['response_index']
   143	        canonical = (reply_index is not None and reply_index < end
   144	                     and entries[reply_index].get('type') == 'tool_response')
   145	        if canonical:
   146	            end = reply_index
   147	        children = [dict(p, response=None, response_index=None)
   148	                    if p['response_index'] is not None and p['response_index'] >= end else p
   149	                    for p in pairs if p.get('author') == 'submit_patch'
   150	                    and c['entry_index'] < p['entry_index'] < end]
   151	        inner = [p for p in children if p.get('tool') == 'submit_patch'
   152	                 and p['response_index'] is not None and p['response_index'] < end
   153	                 and _patch_size(p['response']) is not None]
   154	        gates.append(dict(c, root_index=i, children=children, inner_successes=inner,
   155	                          canonical_reply=_reply(c['response']) if canonical else '',
   156	                          canonical_index=reply_index if canonical else None))
   157	    return gates
