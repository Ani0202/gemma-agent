   201	def earliest_candidate_index(entries):
   202	    """D73.5 boundary, independent of successful-root attribution: the earliest of
   203	    (a) any gate-authored inner submit_patch harness response carrying patch_size,
   204	    (b) the root submit call enclosing such a response (gate_invocations interval),
   205	    (c) any root submit_patch call whose own response carries patch_size (builtin).
   206	    Extra candidates only move the boundary earlier (stricter). None = no candidate."""
