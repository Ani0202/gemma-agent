   425	def base_metrics():
   426	    rows, paths = [], [base.ARM_IDS, base.__file__, 'eval/plan007_report.py']
   427	    for part, timing, d4path, a2path in base.PARTS:
   428	        d4, a2 = [json.loads(Path(p).read_text()) for p in (d4path, a2path)]
   429	        assert d4['classifier_sha256'] == base.D4_SHA and a2['classifier_sha256'] == base.A2_SHA
   430	        assert d4['input_sha256'] == base.sha(timing) == a2['input_sha256']
   431	        ts = base.load_rows(timing)
   432	        cs, als = base.unique_map(d4['rows'], d4path), base.unique_map(a2['rows'], a2path)
   433	        assert set(cs) == set(als) == {r['instance_id'] for r in ts}
   434	        paths.extend((timing, d4path, a2path))
   435	        for t in ts:
   436	            iid = t['instance_id']
   437	            base.assert_paired(cs[iid], t)
   438	            base.assert_paired(als[iid], t)
   439	            trace = Path(timing).parent / 'runs' / iid / 'trace.json'
   440	            entries = json.loads(trace.read_text())['entries']
   441	            paths.append(trace)
   442	            rep = identical_runs_root(entries)
   443	            rows.append(dict(instance_id=iid, part=part, **rep, mechanism2=rep['max_run'] >= 5,
   444	                             mechanism1_empty=t.get('verified_patch_bytes') == 0,
   445	                             submitted_without_test=submitted_without_test(entries, gate_mode=False)))
   446	    assert [r['instance_id'] for r in rows] == base.ids_file(base.ARM_IDS)
   447	    totals = dict(mechanism2=sum(r['mechanism2'] for r in rows),
   448	                  mechanism1_empty=sum(r['mechanism1_empty'] for r in rows),
   449	                  submitted_without_test=sum(r['submitted_without_test'] is True for r in rows),
   450	                  count_no_successful_submit=sum(r['submitted_without_test'] is None for r in rows),
   451	                  max_run=max((r['max_run'] for r in rows), default=0),
