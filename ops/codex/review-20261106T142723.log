    59	def _reply(value):
    60	    """Legacy AgentTool text is JSON {raw: text} (sometimes {result: text})."""
    61	    value = _parsed(value)
    62	    if isinstance(value, str):
    63	        return value
    64	    if isinstance(value, dict):
    65	        for k in ('raw', 'result'):
    66	            if k in value:
