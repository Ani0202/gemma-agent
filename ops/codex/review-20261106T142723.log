   485	def smoke_metrics(run_dir, tasks_path=None):
   486	    timing = Path(run_dir) / 'timing.jsonl'
   487	    paths, rows = [timing, GATE_YAML], []
   488	    tasks_path = Path(tasks_path) if tasks_path is not None else _tasks_path()
   489	    if tasks_path.is_file():
   490	        paths.append(tasks_path)
   491	    try:
   492	        test_files = load_task_test_files(tasks_path)
   493	    except Exception:
   494	        test_files = {}  # criterion ii is UNVERIFIABLE for every missing task
   495	    for row in base.load_rows(timing):
   496	        artifacts = _artifacts(run_dir, row['instance_id'])
   497	        trace, patch = artifacts / 'trace.json', artifacts / 'agent.patch'
   498	        if trace.is_file():
   499	            paths.append(trace)
   500	        entries = json.loads(trace.read_text()).get('entries', []) if trace.is_file() else []
   501	        scored = None
   502	        loaded = row['instance_id'] in test_files
   503	        if patch.is_file():
   504	            paths.append(patch)
   505	            if loaded:
   506	                from swegemma.harness.verification import strip_protected_files_from_patch
   507	                try:
   508	                    scored = strip_protected_files_from_patch(patch.read_bytes().decode('utf-8'),
   509	                                extra_protected_paths=test_files[row['instance_id']])
   510	                except (OSError, UnicodeError, ValueError):
   511	                    scored = None
   512	        desc = gate_descriptives(entries, row)
   513	        desc.pop('gate_run_cmds')
   514	        rows.append(dict(instance_id=row['instance_id'],
   515	                         criteria=smoke_check(row, entries, GATE_YAML, scored, loaded), **desc))
   516	    inv = inventory([r['instance_id'] for r in rows], expected_ids('smoke'))
   517	    passed = inv['complete'] and bool(rows) and all(c['status'] == 'PASS' for r in rows for c in r['criteria'].values())
   518	    return dict(_schema=_schema('smoke', paths), n_rows=len(rows), inventory=inv,
   519	                overall='PASS' if passed else 'FAIL', rows=rows)
