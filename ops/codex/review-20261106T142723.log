import pytest
class MemoryOnly:
    def pytest_collection_modifyitems(self, config, items):
        keep, skip = [], []
        for item in items:
            (skip if 'tmp_path' in item.fixturenames or 'tmpdir' in item.fixturenames else keep).append(item)
        items[:] = keep
        config.hook.pytest_deselected(items=skip)
raise SystemExit(pytest.main(['eval/tests/test_plan008_metrics.py', '-q', '-p', 'no:cacheprovider', '--capture=sys'], plugins=[MemoryOnly()]))
