   160	def successful_submit_index(entries, gate_mode=None):
   161	    gates = {g['entry_index']: g for g in gate_invocations(entries)}
   162	    for i, c in enumerate(root_tool_calls(entries)):
   163	        if c.get('tool') != 'submit_patch':
   164	            continue
   165	        gate = gates[c['entry_index']]
   166	        args = c.get('args', c.get('arguments'))
   167	        is_gate = gate_mode if gate_mode is not None else bool(
   168	            gate['children'] or isinstance(args, dict) and 'request' in args
   169	            or gate['canonical_reply'] in ('SUBMITTED', BOUNCE)
   170	            or gate['canonical_reply'].startswith('SUBMIT FAILED'))
   171	        if (gate['inner_successes'] if is_gate else _patch_size(c['response']) is not None):
   172	            return i
   173	    return None
