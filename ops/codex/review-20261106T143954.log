    40	           "fields": {"max_thinking_lb": "max over root turns of completion_tokens - chars(visible text + tool name + json args) - 32*max(calls,1); DESCRIPTIVE residual (not a proven bound: unrecorded whitespace and tool-call serialization tokens; plan 005 correction 3)",
    41	                      "max_thinking_chars": "longest root thinking block (chars)", "thinking_blocks": "root thinking entries with non-empty content",
    42	                      "max_completion": "max root per-turn completion_tokens", "root_usage_turns": "root usage-bearing turns", "has_summary": "trace summary present"},
    43	           "tasks": rows}
