   585	                result = artifacts / 'result.json'
   586	                if not result.is_file():
   587	                    result = artifacts / 'output.json'
   588	                scored = None
   589	                if result.is_file():
   590	                    paths.append(result)
   591	                    scored = json.loads(result.read_text()).get('agent_patch')
   592	                patch = artifacts / 'agent.patch'
   593	                if scored is None and patch.is_file():
   594	                    paths.append(patch)
   595	                    try:
   596	                        from swegemma.harness.verification import strip_protected_files_from_patch
   597	                        tasks_path = _tasks_path()
   598	                        if tasks_path.is_file():
   599	                            paths.append(tasks_path)
   600	                        tests = load_task_test_files(tasks_path)[row['instance_id']]
   601	                        scored = strip_protected_files_from_patch(patch.read_bytes().decode('utf-8'), extra_protected_paths=tests)
   602	                    except Exception:
   603	                        scored = None
   604	                if isinstance(scored, str):
   605	                    desc['untracked_only_submits'] = untracked_only(scored)
   606	        else:
   607	            desc = dict.fromkeys((*GATE_COUNTS, 'gate_internal_visible'), 'n/a (no gate)')
   608	        rows.append(dict(instance_id=row['instance_id'], **rep, mechanism2=rep['max_run'] >= 5,
   609	                         mechanism1_empty=row.get('verified_patch_bytes') == 0,
   610	                         submitted_without_test=submitted_without_test(entries, has_gate),
   611	                         **submit_evidence(row, entries, has_gate, (artifacts / 'trace.json').is_file()), **desc))
   612	    for r, (_, entries, _) in zip(rows, inputs):
   613	        d735_counts(r, entries)
   614	    totals = dict(mechanism2=sum(r['mechanism2'] for r in rows),
   615	                  mechanism1_empty=sum(r['mechanism1_empty'] for r in rows),
   616	                  # D73.5 (ship-rule numbers): unverifiable rows count against arm 2.
   617	                  submitted_without_test=sum(r['swt_d735'] for r in rows),
   618	                  count_no_successful_submit=sum(r['no_submit_d735'] for r in rows),
   619	                  submitted_without_test_observed=sum(r['submitted_without_test'] is True for r in rows),
   620	                  count_no_successful_submit_observed=sum(r['submitted_without_test'] is None for r in rows),
   621	                  max_run=max((r['max_run'] for r in rows), default=0),
   622	                  runs_ge3=sum(r['runs_ge3'] for r in rows), runs_ge5=sum(r['runs_ge5'] for r in rows),
   623	                  repeated_calls=sum(r['repeated_calls'] for r in rows),
