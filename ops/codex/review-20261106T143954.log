     1	"""Per-task lower bound on ROOT thinking tokens per turn (plan 005 Addenda C/D correction 2).
     2	DESCRIPTIVE only (plan 005 correction 3): not a proven bound.
     3	A turn = a root usage-bearing entry plus the root entries sharing its timestamp. Every token decodes to >= 1 char, so
     4	non-thinking tokens <= chars(visible text) + chars(json tool args) + OVERHEAD per tool call; hence
     5	residual = completion_tokens - those chars - OVERHEAD*n_calls (a lower bound only if every token is recorded). Also reports max thinking-text chars.
     6	Usage: thinking_bound.py <run_dir> [<out.json>]"""
     7	import json, sys, glob, os
     8	ROOT = "swe_baseline_agent"; OVERHEAD = 32
     9	def turns(entries):
    10	    out = []
    11	    for i, e in enumerate(entries):
    12	        if e.get("author") == ROOT and e.get("usage"):
    13	            grp = [x for x in entries if x.get("author") == ROOT and x.get("timestamp") == e.get("timestamp")]
    14	            out.append((e, grp))
    15	    return out
    16	def task(path):
    17	    d = json.load(open(path)); E = d.get("entries") or []
    18	    res = {"has_summary": isinstance(d.get("summary"), dict), "root_usage_turns": 0, "max_completion": 0,
    19	           "max_thinking_chars": 0, "max_thinking_lb": 0, "thinking_blocks": 0}
    20	    for e in E:
    21	        if e.get("author") == ROOT and e.get("type") == "thinking" and (e.get("content") or ""):
    22	            res["thinking_blocks"] += 1; res["max_thinking_chars"] = max(res["max_thinking_chars"], len(e["content"]))
    23	    for e, grp in turns(E):
    24	        res["root_usage_turns"] += 1
    25	        comp = e["usage"].get("completion_tokens") or 0
    26	        other = 0; ncalls = 0
    27	        for x in grp:
    28	            if x.get("type") == "tool_call":
    29	                ncalls += 1; other += len(json.dumps(x.get("args"), ensure_ascii=False)) + len(x.get("tool") or "")
    30	            elif x.get("type") not in ("thinking", "tool_call", "tool_response") and isinstance(x.get("content"), str):
    31	                other += len(x["content"])
    32	        lb = comp - other - OVERHEAD * max(ncalls, 1)
    33	        res["max_completion"] = max(res["max_completion"], comp); res["max_thinking_lb"] = max(res["max_thinking_lb"], lb)
    34	    return res
    35	if __name__ == "__main__":
    36	    run = sys.argv[1]; rows = {}
