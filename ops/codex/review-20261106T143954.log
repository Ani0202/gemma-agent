   581	            # the D73 SAFETY boundary below needs only an inner harness capture.
   582	            acknowledged = any(g['canonical_reply'] == 'SUBMITTED' for g in gate_invocations(entries))
   583	            desc['untracked_only_submits'] = None if acknowledged else False
