     1	#!/usr/bin/env bash
     2	# Stage a self-contained private GPU timing or CPU setup kernel. --dry-run never invokes Kaggle.
     3	set -euo pipefail
     4	dry_run=false
     5	skip_verification=1
     6	stock_probe=1
     7	while [[ ${1:-} == --dry-run || ${1:-} == --with-verification || ${1:-} == --no-stock-probe ]]; do
     8	  case $1 in
     9	    --dry-run) dry_run=true ;;
    10	    --with-verification) skip_verification=0 ;;
    11	    --no-stock-probe) stock_probe=0 ;;
    12	  esac
    13	  shift
    14	done
    15	setup_only=0
    16	setup_fix=1
    17	if [[ ${1:-} == --setup-only ]]; then
    18	  setup_only=1
    19	  setup_fix=${2:?SETUP_FIX required}
    20	  [[ $setup_fix == 0 || $setup_fix == 1 ]] || { echo 'SETUP_FIX must be 0 or 1' >&2; exit 2; }
    21	  shift 2
    22	  [[ $# -ge 2 && $# -le 3 ]] || { echo 'Usage: timing_push.sh [--dry-run] [--with-verification] [--no-stock-probe] --setup-only SETUP_FIX USER/SLUG IDS_FILE [BUDGET_SECONDS]' >&2; exit 2; }
    23	  set -- "$1" - "$2" "${3:-1800}"
    24	fi
    25	if [[ $# -lt 3 || $# -gt 4 || ! $1 =~ ^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$ ]]; then
    26	  echo "Usage: $0 [--dry-run] [--with-verification] [--no-stock-probe] KAGGLE_USER/SLUG BUNDLE_DIR IDS_FILE [BUDGET_SECONDS]" >&2
    27	  exit 2
    28	fi
    29	script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    30	stage_dir=$(mktemp -d /tmp/timing-kernel-push.XXXXXX)
    31	# Dry runs retain the generated artifact for inspection.
    32	if ! $dry_run; then trap 'rm -rf -- "$stage_dir"' EXIT; fi
    33	budget=${4:-10800}
    34	python3 - "$script_dir" "$stage_dir" "$1" "$2" "$3" "$budget" "$setup_only" "$setup_fix" "$skip_verification" "$stock_probe" <<'PY'
    35	import ast
    36	import base64
    37	import gzip
    38	import hashlib
    39	import io
    40	import json
    41	from pathlib import Path
    42	import re
    43	import subprocess
    44	import sys
    45	import tarfile
    46	
    47	source, stage = map(Path, sys.argv[1:3])
    48	kernel_id, bundle_arg, ids_arg, budget_arg, setup_only_arg, setup_fix_arg, skip_verification_arg, stock_probe_arg = sys.argv[3:]
    49	setup_only = setup_only_arg == "1"
    50	bundle, ids_file = Path(bundle_arg).resolve(), Path(ids_arg)
    51	budget = int(budget_arg)
    52	if budget <= 0:
    53	    raise ValueError('Budget must be positive')
    54	ids = [s.strip() for s in ids_file.read_text().splitlines() if s.strip() and not s.lstrip().startswith('#')]
    55	if not ids or len(ids) != len(set(ids)) or any(not re.fullmatch(r'[A-Za-z0-9_.-]+', s) for s in ids):
    56	    raise ValueError('Nonempty unique safe task IDs required')
    57	# PyYAML is not required on the push host. agent.yaml uses a scalar model declaration.
    58	buf = io.BytesIO()
    59	model = None
    60	if not setup_only:
    61	    models = set()
    62	    for path in [bundle / 'agent.yaml', *sorted((bundle / 'sub_agents').rglob('*.yaml')), *sorted((bundle / 'sub_agents').rglob('*.yml'))]:
    63	        for line in path.read_text().splitlines():
    64	            match = re.fullmatch(r'\s*model:\s*[\'"]?(gemma-4-(?:31b|12b|e4b|e2b)-it-qat-w4a16-ct)[\'"]?\s*(?:#.*)?', line)
    65	            if match:
    66	                models.add(match[1])
    67	    if len(models) != 1:
    68	        raise ValueError('Expected one allowed scalar model declaration')
    69	    model = models.pop()
    70	    buf = io.BytesIO()
    71	    with gzip.GzipFile(fileobj=buf, mode='wb', mtime=0) as gz:
    72	        with tarfile.open(fileobj=gz, mode='w') as tf:
    73	            for path in sorted(bundle.rglob('*')):
    74	                if path.is_symlink() or not (path.is_file() or path.is_dir()):
    75	                    raise ValueError('Bundle contains symlink or special file')
