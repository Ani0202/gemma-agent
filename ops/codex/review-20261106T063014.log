   239	def record_distributions(docker, container_id, repo, row):
   240	    # Query the same interpreter and metadata selection pip uses, never host metadata.
   241	    package = repo.rsplit('/', 1)[-1].lower()
   242	    probe = """import json
   243	from importlib.metadata import distribution, PackageNotFoundError
   244	names = NAMES
   245	result = {}
   246	for name in names:
   247	    try:
   248	        d = distribution(name)
   249	        result[name] = dict(location=str(d.locate_file('')), version=d.version,
   250	                            metadata_location=str(d._path), record_exists=d.read_text('RECORD') is not None)
   251	    except PackageNotFoundError:
   252	        result[name] = dict(location=None, version=None, metadata_location=None, record_exists=False)
   253	print(json.dumps(result))
   254	""".replace('NAMES', repr([package]))
   255	    # Diagnostic only: a probe problem must never change the harness path.
   256	    try:
   257	        result = docker.exec(container_id, 'python3 -c ' + shlex.quote(probe), timeout=30)
   258	        row['dist_probe_rc'] = result.exit_code
   259	        if result.exit_code != 0:
   260	            row['dist_probe_error'] = 'rc'
   261	            return
   262	        row['distributions'] = json.loads(result.stdout)
   263	    except Exception as exc:
   264	        row['dist_probe_error'] = type(exc).__name__
