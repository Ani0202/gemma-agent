   851	def platform_probe(host='pypi.org', port=443, timeout=10.0):
   852	    """P2 (plan 006 addendum): docker presence, DNS, and one TCP connect. Sends no payload."""
   853	    out = dict(docker_which=shutil.which('docker'), docker_sock=os.path.exists('/var/run/docker.sock'),
   854	               host=host, port=port, dns=None, dns_seconds=None, tcp=None, tcp_seconds=None, tcp_errno=None)
   855	    box = {}
   856	    def resolve():
   857	        try:
   858	            box['addrs'] = sorted({ai[4][0] for ai in socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)})
   859	        except Exception as exc:
   860	            box['error'] = type(exc).__name__
   861	    start = time.perf_counter()
   862	    worker = threading.Thread(target=resolve, daemon=True)
   863	    worker.start(); worker.join(timeout)
   864	    out['dns_seconds'] = round(time.perf_counter() - start, 3)
   865	    if worker.is_alive():
   866	        out['dns'], out['tcp'] = 'timeout', 'skipped'
   867	        return out
   868	    if 'error' in box or not box.get('addrs'):
   869	        out['dns'], out['tcp'] = 'failed:' + box.get('error', 'empty'), 'skipped'
   870	        return out
   871	    out['dns'] = 'resolved'
   872	    out['dns_addr_count'] = len(box['addrs'])
   873	    start = time.perf_counter()
   874	    try:
   875	        sock = socket.create_connection((box['addrs'][0], port), timeout=timeout)
   876	        sock.close()
   877	        out['tcp'] = 'connected'
   878	    except socket.timeout:
   879	        out['tcp'] = 'timeout'  # blackhole: SYN dropped
   880	    except ConnectionRefusedError:
   881	        out['tcp'] = 'refused'
   882	    except OSError as exc:
   883	        out['tcp'], out['tcp_errno'] = 'unreachable', exc.errno
   884	    out['tcp_seconds'] = round(time.perf_counter() - start, 3)
   885	    return out
