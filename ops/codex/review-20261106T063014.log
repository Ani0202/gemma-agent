   111	def missing_tool_closure(wheels, tags=None, runtime=True):
   112	    """Mirror the sandbox tool_deps walk: compatible_wheels (wheelhouse, then embedded), then runtime copy.
   113	
   114	    tags default to the kernel interpreter's, which is the sandbox venv's interpreter on Kaggle.
   115	    """
   116	    from packaging.markers import default_environment
   117	    from packaging.requirements import Requirement
   118	    from packaging.tags import sys_tags
   119	    from packaging.utils import canonicalize_name, parse_wheel_filename
   120	    tags = [str(t) for t in sys_tags()] if tags is None else tags
   121	    extra = extra_wheels()
   122	    selected = compatible_wheels(wheels, tags)
   123	    roots = [wheel_metadata(selected[canonicalize_name(n)]) for n in SCORER_TOOLS
   124	             if n not in ('pip', 'pytest-timeout') and canonicalize_name(n) in selected]
   125	    timeout = [p for p in pytest_timeout_wheels(wheels)
   126	               if any(str(t) in tags for t in parse_wheel_filename(p.name)[3])]
   127	    roots.extend(wheel_metadata(p) for p in timeout[:1])
   128	    env, seen, missing, queue = dict(default_environment(), extra=''), set(), [], list(roots)
   129	    while queue:
   130	        metadata = queue.pop()
   131	        key = (canonicalize_name(metadata['Name']), metadata['Version'])
   132	        if key in seen:
   133	            continue
   134	        seen.add(key)
   135	        for raw in metadata.get_all('Requires-Dist', []):
   136	            req = Requirement(raw)
   137	            if req.marker and not req.marker.evaluate(env):
   138	                continue
   139	            name = canonicalize_name(req.name)
   140	            candidate = compatible_wheels(wheels, tags, req).get(name) or compatible_wheels(extra, tags, req).get(name)
   141	            if candidate:
   142	                queue.append(wheel_metadata(candidate))
   143	                continue
   144	            found = runtime_copyable(name) if runtime else None
   145	            if found is not None and found[0].version in req.specifier:
   146	                queue.append(found[0].metadata)
   147	            elif name not in missing:
   148	                missing.append(name)
   149	    return missing
