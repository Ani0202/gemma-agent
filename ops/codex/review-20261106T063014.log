   328	def copy_runtime_package(name, destination):
   329	    """Copy only the pure Python image package and metadata; no host path injection."""
   330	    found = runtime_copyable(name)
   331	    if found is None:
   332	        return 'missing'
   333	    dist, files = found
   334	    for entry in files:
   335	        target = destination / entry
   336	        target.parent.mkdir(parents=True, exist_ok=True)
   337	        shutil.copyfile(dist.locate_file(entry), target)
   338	    return 'runtime-site-packages:' + str(dist.locate_file(''))
