   810	def phase1_fields(current, run_seconds, total, context, patch):
   811	    def difference(end, start):
   812	        return current[end] - current[start] if current.get(end) is not None and current.get(start) is not None else None
   813	    phase1 = difference('sandbox_stop_end', 'sandbox_start_begin')
   814	    source = 'sandbox_wrappers' if phase1 is not None else 'run_agent_sandbox'
   815	    phase1 = run_seconds if phase1 is None else phase1
   816	    submitted = bool(context.patch_submitted) if context is not None else None
   817	    return dict(agent_timeout_seconds=current.get('agent_timeout_seconds'),
   818	        agent_clock_seconds=difference('timeout_exit', 'timeout_enter'),
   819	        agent_timeout_fired=current.get('agent_timeout_fired'),
   820	        finalization_seconds=difference('sandbox_stop_end', 'timeout_exit'),
   821	        finalization_exec=current.get('finalization_exec', []),
   822	        teardown_seconds=current.get('sandbox_stop_duration'),
   823	        phase1_wall_seconds=phase1, phase1_source=source,
   824	        pre_agent_seconds=difference('timeout_enter', 'sandbox_start_begin'),
   825	        post_phase1_seconds=total - phase1, patch_submitted=submitted,
   826	        fallback_patch_used=(not submitted and bool(patch.strip())) if submitted is not None else None,
   827	        verification_skipped=SKIP_VERIFICATION)
