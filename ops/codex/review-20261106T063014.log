   100	def resume_journal(path):
   101	    """Repair only an interrupted final append, preserving all complete records."""
   102	    if not path.exists():
   103	        return {}
   104	    text = path.read_text(encoding='utf-8')
   105	    results = finished_results(text)
   106	    if text and not text.endswith('\n'):
   107	        try:
   108	            json.loads(text.splitlines()[-1])
   109	        except json.JSONDecodeError:
   110	            # Remove an incomplete tail before further appends. No completed row is lost.
   111	            with path.open('r+b') as stream:
   112	                stream.truncate(len(text[:text.rfind('\n') + 1].encode('utf-8')))
   113	        else:
   114	            with path.open('a', encoding='utf-8') as stream:
   115	                stream.write('\n')
   116	    return results
