    29	def finished_results(text):
    30	    """Parse a journal, ignoring only a torn final JSON line; last full row wins.
    31	
    32	    Both successful verifications and errors are finished attempts. Malformed
    33	    complete records fail loudly rather than silently removing tasks.
    34	    """
    35	    results = {}
    36	    lines = text.splitlines(keepends=True)
    37	    for index, line in enumerate(lines):
    38	        try:
    39	            row = json.loads(line)
    40	        except json.JSONDecodeError:
    41	            if index == len(lines) - 1 and not line.endswith('\n'):
    42	                break
    43	            raise ValueError(f'Invalid results JSON at line {index + 1}') from None
    44	        if (not isinstance(row, dict) or not isinstance(row.get('instance_id'), str)
    45	                or not row['instance_id'] or not isinstance(row.get('repo'), str)
    46	                or type(row.get('resolved')) is not bool
    47	                or 'exit_code' not in row or 'error' not in row
    48	                or (row['exit_code'] is not None and type(row['exit_code']) is not int)
    49	                or (row['error'] is not None and not isinstance(row['error'], str))
    50	                or type(row.get('duration_seconds')) not in (float, int)
    51	                or not math.isfinite(row['duration_seconds']) or row['duration_seconds'] < 0):
    52	            raise ValueError(f'Invalid result schema at line {index + 1}')
    53	        results[row['instance_id']] = row
    54	    return results
    55	
    56	
    57	def pending_tasks(tasks, results):
    58	    """Validate the current task inventory and return unfinished tasks in order."""
    59	    inventory = {task['instance_id']: task['repo'] for task in tasks}
    60	    if len(inventory) != len(tasks):
    61	        raise ValueError('Duplicate task ids in tasks.jsonl')
    62	    for task_id, row in results.items():
    63	        if task_id not in inventory or inventory[task_id] != row['repo']:
    64	            raise ValueError('Resume journal does not match task inventory')
    65	    return [task for task in tasks if task['instance_id'] not in results]
    66	
    67	
    68	def summarize(tasks, results):
    69	    """Aggregate every input task, including failures and unfinished attempts."""
    70	    pending = pending_tasks(tasks, results)
    71	    if os.environ.get('GOLD_LIMIT'):  # smoke runs only: first task of each repo
    72	        seen = set(); pending = [t for t in pending if not (t['repo'] in seen or seen.add(t['repo']))]
    73	    repos = {}
    74	    passing, failing = [], []
    75	    for task in tasks:
    76	        task_id = task['instance_id']
    77	        counts = repos.setdefault(task['repo'], dict(total=0, finished=0, passed=0, failed=0, pending=0))
    78	        counts['total'] += 1
    79	        row = results.get(task_id)
    80	        if row is None:
    81	            counts['pending'] += 1
    82	            continue
    83	        counts['finished'] += 1
    84	        if row['resolved']:
    85	            counts['passed'] += 1
    86	            passing.append(task_id)
    87	        else:
    88	            counts['failed'] += 1
    89	            reason = row['error'] or f"verification unresolved (exit_code={row['exit_code']})"
    90	            failing.append({'instance_id': task_id, 'reason': reason[:200]})
    91	    passing.sort()
    92	    return dict(total=len(tasks), finished=len(results), passed=len(passing),
    93	                failed=len(failing), pending=len(pending), concurrency=CONCURRENCY,
    94	                timing_note='Concurrent calibration durations are not scorer timing measurements.',
    95	                per_repo=dict(sorted(repos.items())), passing_ids=passing,
    96	                failing_ids=sorted(failing, key=lambda row: row['instance_id']),
    97	                pending_ids=sorted(task['instance_id'] for task in pending))
    98	
