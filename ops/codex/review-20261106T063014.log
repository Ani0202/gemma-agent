   729	class AsyncioTimingProxy:
   730	    """Observe only agent_runner's timeout context, without changing asyncio itself."""
   731	    def __init__(self, original, state):
   732	        self._original, self._state = original, state
   733	
   734	    def __getattr__(self, name):
   735	        return getattr(self._original, name)
   736	
   737	    def timeout(self, *args, **kwargs):
   738	        cm = self._original.timeout(*args, **kwargs)
   739	        state = self._state
   740	        delay = args[0] if args else kwargs.get('delay')
   741	
   742	        class ObservedTimeout:
   743	            async def __aenter__(self):
   744	                self.current = state.get(None)
   745	                if self.current is not None:
   746	                    self.current.update(agent_timeout_seconds=delay, timeout_enter=time.perf_counter())
   747	                return await cm.__aenter__()
   748	
   749	            async def __aexit__(self, *exc_info):
   750	                exit_exc = exc_info[1]
   751	                try:
   752	                    return await cm.__aexit__(*exc_info)
   753	                except BaseException as exc:
   754	                    exit_exc = exc
   755	                    raise
   756	                finally:
   757	                    if self.current is not None:
   758	                        self.current.update(timeout_exit=time.perf_counter(),
   759	                            agent_timeout_fired=bool(getattr(cm, 'expired', lambda: False)())
   760	                                or isinstance(exit_exc, TimeoutError))
   761	
   762	        return ObservedTimeout()
   763	
   764	
   765	def observe_sandbox(original, state, name):
   766	    """Forward identical arguments/results/exceptions and time sandbox boundaries."""
   767	    async def observed(*args, **kwargs):
   768	        current = state.get(None)
   769	        start = time.perf_counter()
   770	        row = None
   771	        if current is not None:
   772	            if name == 'sandbox_start':
   773	                current['sandbox_start_begin'] = start
   774	            elif name == 'sandbox_exec' and current.get('timeout_exit') is not None:
   775	                cmd = args[2] if len(args) > 2 else kwargs.get('command', kwargs.get('cmd', ''))
   776	                row = dict(cmd=str(cmd)[:40], duration_s=None, rc=None)
   777	                current.setdefault('finalization_exec', []).append(row)
   778	        try:
   779	            result = await original(*args, **kwargs)
   780	            if row is not None:
   781	                row['rc'] = getattr(result, 'exit_code', None)
   782	            return result
   783	        except BaseException as exc:
   784	            if row is not None:
   785	                row['exception'] = type(exc).__name__
   786	            raise
   787	        finally:
   788	            end = time.perf_counter()
   789	            if current is not None:
   790	                if name in ('sandbox_start', 'sandbox_stop'):
   791	                    current[name + '_end'] = end
   792	                    current[name + '_duration'] = end - start
   793	                if row is not None:
   794	                    row['duration_s'] = end - start
   795	    return observed
