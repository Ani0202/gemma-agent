   271	) -> tuple[bool, str | None]:
   272	    """Validate JUnit XML report to prevent os._exit(0), conftest, or skip-all exploits."""
   273	    import xml.etree.ElementTree as ET
   274	
   275	    if not xml_content or not xml_content.strip():
   276	        return False, 'Missing or empty JUnit XML report (possible premature exit)'
   277	    try:
   278	        root = ET.fromstring(xml_content)
   279	    except ET.ParseError as e:
   280	        return False, f'Malformed JUnit XML report: {e}'
   281	
   282	    suites = [root] if root.tag == 'testsuite' else list(root.findall('.//testsuite'))
   283	    if not suites:
   284	        return False, 'No <testsuite> elements found in JUnit XML'
   285	
   286	    total_tests = sum(int(s.attrib.get('tests', 0)) for s in suites)
   287	    total_failures = sum(int(s.attrib.get('failures', 0)) for s in suites)
   288	    total_errors = sum(int(s.attrib.get('errors', 0)) for s in suites)
   289	    total_skipped = sum(int(s.attrib.get('skipped', 0)) for s in suites)
   290	    passed_tests = total_tests - total_failures - total_errors - total_skipped
   291	
   292	    if total_tests <= 0 or passed_tests <= 0:
   293	        return (
   294	            False,
   295	            f'No passing tests recorded in JUnit XML (total={total_tests}, passed={passed_tests}, skipped={total_skipped})',
   296	        )
   297	    if total_failures > 0 or total_errors > 0:
   298	        return (
   299	            False,
   300	            f'Test failures/errors recorded in JUnit XML (failures={total_failures}, errors={total_errors})',
   301	        )
