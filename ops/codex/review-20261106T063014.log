   252	def _node_matches_requirement(node_name: str, req: str, req_short: str, req_base: str) -> bool:
   253	    """Check if a JUnit testcase identifier matches a required test specification."""
   254	    if node_name in (req, req_short, req_base):
   255	        return True
   256	    short_node = node_name.rsplit('::', 1)[-1].rsplit('.', 1)[-1]
   257	    if short_node in (req, req_short, req_base):
   258	        return True
   259	    if short_node.startswith(f'{req_base}_') or short_node.startswith(f'{req_base}['):
   260	        return True
   261	    if len(req_base) >= 68 and short_node.startswith(req_base):
   262	        return True
   263	    return short_node.startswith(req_base) and short_node[len(req_base) :].isdigit()
