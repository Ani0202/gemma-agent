   963	def llm_calls(trace, limit=200):
   964	    """P3 (plan 006 addendum): one row per trace entry carrying usage (ADK attaches usage once per
   965	    model event), with the gap since the previous entry of any type (approx. model latency)."""
   966	    rows, prev = [], None
   967	    entries = trace.entries if trace else []
   968	    first = entries[0].timestamp if entries else None
   969	    for e in entries:
   970	        if e.usage:
   971	            rows.append(dict(t=round(e.timestamp - first, 3), gap_s=round(e.timestamp - prev, 3) if prev is not None else None,
   972	                             event_type=e.event_type,
   973	                             completion_tokens=e.usage.get('completion_tokens'), prompt_tokens=e.usage.get('prompt_tokens')))
   974	        prev = e.timestamp
   975	    return rows[:limit]
