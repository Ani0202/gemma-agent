   267	def setup_step(current, name, action, *, fatal=True):
   268	    """Time setup steps and retain bounded output plus retry counts."""
   269	    start = time.perf_counter()
   270	    row = dict(step=name, start_offset_s=round(start-current['started'], 6),
   271	               duration_s=0.0, rc=None, stdout='', stderr='', retrying_lines=0)
   272	    current['setup_calls'].append(row)
   273	    try:
   274	        result = action()
   275	        row['rc'] = getattr(result, 'exit_code', getattr(result, 'returncode', 0))
   276	        setup_artifact(current, dict(step=name, stdout=getattr(result, 'stdout', '') or '',
   277	                                     stderr=getattr(result, 'stderr', '') or ''))
   278	        for field in ('stdout', 'stderr'):
   279	            value = getattr(result, field, '') or ''
   280	            row['retrying_lines'] += sum('Retrying' in line for line in value.splitlines())
   281	            row[field] = value.encode('utf-8', errors='replace')[-2048:].decode('utf-8', errors='ignore')
   282	        return result
   283	    except Exception as exc:
   284	        row.update(rc=-1, stderr=type(exc).__name__)
   285	        if fatal:
   286	            current['setup_failed'] = True
   287	            raise
   288	    finally:
   289	        row['duration_s'] = round(time.perf_counter()-start, 6)
   290	        current['retrying_lines'] = sum(c['retrying_lines'] for c in current['setup_calls'])
   291	        if fatal and row['rc'] != 0:
   292	            current['setup_failed'] = True
