   545	            setup_step(current, 'pytest_timeout_source', timeout_source)
   546	            def install_tools():
   547	                for path in selected.values():
   548	                    docker.copy_to(container_id, path, '/wheels/' + path.name)
   549	                tools = ['/wheels/' + selected[n].name for n in SCORER_TOOLS
   550	                         if n in selected and n != 'pip']
   551	                return docker.exec(container_id,
   552	                    'python3 -m pip install --ignore-installed --no-index --find-links=/wheels --no-deps ' +
   553	                    ' '.join(shlex.quote(n) for n in tools), timeout=60)
   554	            result = setup_step(current, 'tool_install', install_tools)
   555	            if result.exit_code != 0:
   556	                raise RuntimeError('Offline scorer tool installation failed')
   557	            def tool_deps():
   558	                from importlib.metadata import distributions
   559	                roots = [wheel_metadata(selected[n]) for n in SCORER_TOOLS if n in selected]
   560	                roots.extend(d.metadata for d in distributions(path=[str(sp)])
   561	                             if d.metadata['Name'].lower() in ('pip', 'pytest-timeout')
   562	                             and d.metadata['Name'].lower() not in selected)
   563	                def install_dependency(path):
   564	                    docker.copy_to(container_id, path, '/wheels/' + path.name)
   565	                    result = docker.exec(container_id,
   566	                        'python3 -m pip install --ignore-installed --no-index --find-links=/wheels --no-deps ' +
   567	                        shlex.quote('/wheels/' + path.name), timeout=60)
   568	                    setup_artifact(current, dict(step='tool_deps', wheel=path.name,
   569	                        stdout=result.stdout, stderr=result.stderr))
   570	                    current['setup_calls'][-1]['retrying_lines'] += sum(
   571	                        'Retrying' in line for line in (result.stdout + '\n' + result.stderr).splitlines())
   572	                    return result
   573	                entries, missing = close_tool_dependencies(
   574	                    roots, wheels, identity['tags'], identity['environment'], sp, install_dependency)
   575	                current['setup_calls'][-1]['dependencies'] = entries
   576	                current['missing_tool_deps'] = missing
   577	                if missing:
   578	                    current.update(status='failed', reason='missing_tool_deps')
   579	                    raise RuntimeError('missing_tool_deps: ' + ', '.join(missing))
   580	            setup_step(current, 'tool_deps', tool_deps)
   581	            setup_step(current, 'pip_check', lambda: docker.exec(
   582	                container_id, 'python3 -m pip check', timeout=30), fatal=False)
   583	            # Docker's hook ignores failure, but observe the real pip rc and both streams.
   584	            setup_step(current, 'workspace_editable', lambda: docker.exec(container_id,
   585	                'python3 -m pip install --no-index --find-links=/wheels --no-build-isolation --no-deps -e /workspace',
   586	                timeout=280), fatal=False)
   587	            current['workspace_editable_rc'] = current['setup_calls'][-1]['rc']
   588	            current['editable_failed'] = current['workspace_editable_rc'] != 0
   589	            current['setup_failed'] |= current['editable_failed']
   590	            record_distributions(docker, container_id, repo, current['setup_calls'][-1])
   591	            def extract_base():
   592	                base = [p for name, p in selected.items() if name not in BASE_SKIP]
   593	                if any(p.stat().st_size >= cs._LARGE_WHEEL_THRESHOLD_BYTES for p in base):
   594	                    raise RuntimeError('large wheels present; workspace-import scan not emulated')
   595	                inject_base(cs, base, sp, current)
   596	            setup_step(current, 'base_tar_extraction', extract_base)
   597	            record_distributions(docker, container_id, repo, current['setup_calls'][-1])
   598	        def run_setup():
   599	            docker.copy_to(container_id, setup, '/tmp/setup.py')
   600	            # All observer files are scratch files, never workspace patch inputs.
   601	            observer = docker.sandboxes[container_id]['tmp'] / 'setup_observer.py'
   602	            observer.write_text(SETUP_OBSERVER)
   603	            return docker.exec(container_id, setup_command(repo, fast_path), timeout=280)
   604	        try:
   605	            setup_step(current, 'setup.py', run_setup)
   606	        finally:
   607	            log = docker.sandboxes[container_id]['tmp'] / 'setup_subprocesses.json'
   608	            calls = json.loads(log.read_text()) if log.exists() else []
   609	            full_log = log.with_name('setup_subprocesses_full.jsonl')
   610	            if full_log.exists():
   611	                for line in full_log.read_text().splitlines():
   612	                    setup_artifact(current, dict(step='setup.py', **json.loads(line)))
   613	            current['setup_subprocesses'] = calls
   614	            setup_row = next(c for c in reversed(current['setup_calls']) if c['step'] == 'setup.py')
   615	            setup_row['subprocesses'] = calls
   616	            setup_row['retrying_lines'] += sum(c['retrying_lines'] for c in calls)
   617	            current['retrying_lines'] = sum(c['retrying_lines'] for c in current['setup_calls'])
   618	            editable = [c for c in calls if isinstance(c['argv'], list) and '-e' in c['argv']]
   619	            current['editable_rc'] = editable[0]['rc'] if editable else None
   620	            current['editable_final_rc'] = editable[-1]['rc'] if editable else None
   621	            current['editable_failed'] = any(c['rc'] != 0 for c in editable) or current.get('workspace_editable_rc', 0) != 0
   622	            current['setup_failed'] |= current['editable_failed']
   623	            record_distributions(docker, container_id, repo, setup_row)
   624	            if calls:
   625	                current['interpreter_version'] = calls[0]['interpreter_version']
   626	            else:
   627	                current.setdefault('interpreter_version', None)
   628	        current['status'] = 'failed' if current['setup_failed'] else 'passed'
   629	        return current
   630	    install._timing_original = orig
   631	    for name, module in list(sys.modules.items()):
   632	        if name.startswith('swegemma.') and hasattr(module, 'install_test_dependencies'):
   633	            module.install_test_dependencies = install
   634	    return install
