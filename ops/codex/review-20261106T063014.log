   240	def isolate_host_packages():
   241	    """Keep pyimg system packages; remove swegemma's extra harness-venv .pth leak."""
   242	    from swegemma.sandbox import SubprocessManager
   243	    original = SubprocessManager.start
   244	    if getattr(original, '_image_only', False):
   245	        return
   246	
   247	    def start(self):
   248	        base = getattr(self, 'base_dir', None)
   249	        if gold_artifact_dir.get() is not None:
   250	            self.base_dir = Path(gold_artifact_dir.get())
   251	        try:
   252	            sid = original(self)
   253	        finally:
   254	            self.base_dir = base
   255	        for pth in self.sandboxes[sid]['venv'].glob('lib/python*/site-packages/_host_env.pth'):
   256	            pth.unlink()
   257	        return sid
   258	    start._image_only = True
   259	    SubprocessManager.start = start
