   711	def test_run_stats(trace, agent_seconds):
   712	    pending, n, total = {}, 0, 0.0
   713	    for e in trace.entries if trace else []:
   714	        if e.event_type == 'tool_call':
   715	            command = (e.tool_args or {}).get('command', '')
   716	            is_test = e.tool_name == 'run_command' and any(s in command for s in ('pytest', 'unittest', 'tox', 'nox', 'run_tests'))
   717	            n += int(is_test)
   718	            pending.setdefault(e.tool_name, []).append((e.timestamp, is_test))
   719	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   720	            start, is_test = pending[e.tool_name].pop(0)
   721	            if is_test:
   722	                total += max(0.0, e.timestamp - start)
   723	    return dict(n=n, total_seconds=total, share_of_agent_seconds=total / agent_seconds if agent_seconds else None)
   724	
   725	def should_stop(elapsed, cap_minutes, verification_timeout, observed_max, budget):
   726	    return elapsed + 1.5 * max(cap_minutes * 60 + verification_timeout, observed_max) > budget
