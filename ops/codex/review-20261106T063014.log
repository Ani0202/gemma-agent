   295	def fallback_wheel(wheels, package):
   296	    """Prefer the wheelhouse, then the running interpreter's ensurepip bundle."""
   297	    from packaging.utils import parse_wheel_filename
   298	    found = list(Path(wheels).glob(package + '-*-py3-none-any.whl'))
   299	    if not found and package == 'pip':
   300	        try:
   301	            import ensurepip
   302	            found = list((Path(ensurepip.__file__).parent / '_bundled').glob('pip-*.whl'))
   303	        except ImportError:
   304	            pass
   305	    return max(found, key=lambda p: parse_wheel_filename(p.name)[1]) if found else None
