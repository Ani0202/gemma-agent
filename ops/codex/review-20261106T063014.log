   101	generated = ''.join(lines)
   102	compile(generated, 'agent_timing.py', 'exec')
   103	(stage / 'agent_timing.py').write_text(generated)
   104	# No network per task constraint. Assumption: Kaggle model_sources accepts versioned model handles.
   105	metadata = dict(id=kernel_id, title=kernel_id.split('/')[1], code_file='agent_timing.py', language='python',
   106	                kernel_type='script', is_private=True, enable_gpu=not setup_only, enable_internet=False,
   107	                dataset_sources=['metric/gemma-4-developer-agent-wheelhouse'],
   108	                competition_sources=['gemma-4-developer-agent'], model_sources=[] if setup_only else [f'google/gemma-4/Other/{model}/2'], kernel_sources=[],
   109	                # Pin the starter notebook's image (Python 3.12; wheelhouse binaries are cp312).
   110	                # Source: kaggle kernels pull ryanholbrook/getting-started-gemma-4-developer-agent -m (2026-11-05).
   111	                docker_image='gcr.io/kaggle-private-byod/python@sha256:37c64f7dd9c54116ecd1bcc88817c5469b88387388fade02bfa8bf3fc647d461')
   112	(stage / 'kernel-metadata.json').write_text(json.dumps(metadata, indent=2) + '\n')
   113	print(json.dumps(metadata, indent=2))
   114	print(f'Generated script: {len(generated.encode())} bytes; stage: {stage}')
