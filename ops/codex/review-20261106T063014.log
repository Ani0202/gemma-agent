   887	def stock_setup_probe(config, iid, repo):
   888	    """P1 (plan 006 addendum): time swegemma's STOCK subprocess setup sequence on this task's snapshot.
   889	    Mirrors eval/tools/stock_subprocess_setup_timing.py (agent_runner.py ~l.553-584); the stock
   890	    install_test_dependencies is used even though patch_subprocess_deps rebinds it. Never raises."""
   891	    steps, error, mgr, sid = {}, None, None, None
   892	    t0 = time.perf_counter()
   893	    deadline = t0 + P1_DEADLINE_SECONDS
   894	    # BaseException prevents stock helpers' broad Exception handlers from swallowing the deadline.
   895	    class Deadline(BaseException):
   896	        pass
   897	    def expired(*args):
   898	        raise Deadline()
   899	    def remaining():
   900	        left = deadline - time.perf_counter()
   901	        if left <= 0:
   902	            raise Deadline()
   903	        return left
   904	    old_handler, old_timer = None, None
   905	    try:
   906	        old_handler = signal.signal(signal.SIGALRM, expired)
   907	        old_timer = signal.setitimer(signal.ITIMER_REAL, remaining())
   908	        import swegemma.harness.container_setup as cs
   909	        from swegemma.sandbox.subprocess import SubprocessManager
   910	        install_deps = getattr(cs.install_test_dependencies, '_timing_original', cs.install_test_dependencies)
   911	        mgr = SubprocessManager(timeout_seconds=120)
   912	        original_exec = mgr.exec
   913	        def bounded_exec(*args, **kwargs):
   914	            kwargs['timeout'] = min(120, remaining())
   915	            return original_exec(*args, **kwargs)
   916	        mgr.exec = bounded_exec
   917	        remaining()
   918	        s = time.perf_counter(); sid = mgr.start(); steps['start_venv'] = round(time.perf_counter() - s, 3)
   919	        for name, fn, args, kwargs in (
   920	                ('setup_container_wheels', cs.setup_container_wheels, (mgr, sid, config), {}),
   921	                ('extract_snapshot', cs.extract_snapshot, (mgr, sid, Path(config.snapshots_dir) / f'{iid}.tgz'), {}),
   922	                ('setup_git_exclude', cs.setup_git_exclude, (mgr, sid), {}),
   923	                ('install_editable_package', cs.install_editable_package, (mgr, sid), {}),
   924	                ('install_test_dependencies', install_deps, (mgr, sid, repo), dict(config=config)),
   925	                ('setup_workspace_test_config', cs.setup_workspace_test_config, (mgr, sid), dict(repo=repo)),
   926	                ('setup_baseline_commit', cs.setup_baseline_commit, (mgr, sid, 'baseline'), {})):
   927	            remaining()
   928	            s = time.perf_counter()
   929	            try:
   930	                fn(*args, **kwargs)
   931	                remaining()
   932	            finally:
   933	                steps[name] = round(time.perf_counter() - s, 3)
   934	    except Deadline:
   935	        error = 'deadline'
   936	    except Exception as exc:
   937	        error = type(exc).__name__
   938	    finally:
   939	        try:
   940	            if old_timer is not None:
   941	                # Cleanup always gets a bounded chance, even after the overall deadline.
   942	                signal.setitimer(signal.ITIMER_REAL, max(.001, min(30, deadline - time.perf_counter()))
   943	                                 if time.perf_counter() < deadline else 30)
   944	            if mgr is not None:
   945	                mgr.cleanup_all()
   946	        except Deadline:
   947	            error = 'deadline'
   948	        except Exception as exc:
   949	            error = error or 'cleanup ' + type(exc).__name__
   950	        finally:
   951	            if time.perf_counter() >= deadline:
   952	                error = 'deadline'
   953	            if old_timer is not None:
   954	                signal.setitimer(signal.ITIMER_REAL, 0)
   955	            if old_handler is not None:
   956	                signal.signal(signal.SIGALRM, old_handler)
   957	            if old_timer is not None:
   958	                if old_timer[0]:
   959	                    signal.setitimer(signal.ITIMER_REAL,
   960	                                     max(.001, old_timer[0] - (time.perf_counter() - t0)), old_timer[1])
   961	    return dict(total_s=round(time.perf_counter() - t0, 3), steps_s=steps, error=error)
