   765	def observe_sandbox(original, state, name):
   766	    """Forward identical arguments/results/exceptions and time sandbox boundaries."""
   767	    async def observed(*args, **kwargs):
   768	        current = state.get(None)
   769	        start = time.perf_counter()
   770	        row = None
   771	        if current is not None:
   772	            if name == 'sandbox_start':
   773	                current['sandbox_start_begin'] = start
   774	            elif name == 'sandbox_exec' and current.get('timeout_exit') is not None:
   775	                cmd = args[2] if len(args) > 2 else kwargs.get('command', kwargs.get('cmd', ''))
   776	                row = dict(cmd=str(cmd)[:40], duration_s=None, rc=None)
   777	                current.setdefault('finalization_exec', []).append(row)
   778	        try:
   779	            result = await original(*args, **kwargs)
   780	            if row is not None:
   781	                row['rc'] = getattr(result, 'exit_code', None)
   782	            return result
   783	        except BaseException as exc:
   784	            if row is not None:
   785	                row['exception'] = type(exc).__name__
   786	            raise
   787	        finally:
   788	            end = time.perf_counter()
   789	            if current is not None:
   790	                if name in ('sandbox_start', 'sandbox_stop'):
   791	                    current[name + '_end'] = end
   792	                    current[name + '_duration'] = end - start
   793	                if row is not None:
   794	                    row['duration_s'] = end - start
   795	    return observed
