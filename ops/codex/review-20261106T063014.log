   126	def install_harness():
   127	    """Use preinstalled packages or the same offline wheelhouse as the starter."""
   128	    try:
   129	        import swegemma  # noqa: F401
   130	        return
   131	    except ImportError:
   132	        pass
   133	    staged = Path('/tmp/wheelhouse')
   134	    staged.mkdir(parents=True, exist_ok=True)
   135	    for w in WHEELHOUSE.glob('*.whl'):
   136	        # CPU image is Python 3.13; wheelhouse binaries are cp312, so take pure wheels only.
   137	        if 'cutlass' in w.name.lower() or not w.name.endswith('-none-any.whl'):
   138	            continue
   139	        # Kaggle dataset upload strips '+' from local version tags (e.g. cu128).
   140	        name = w.name.replace('cu128', '+cu128') if 'cu128' in w.name and '+' not in w.name else w.name
   141	        target = staged / name
   142	        if not target.exists():
   143	            try:
   144	                os.symlink(w, target)
   145	            except OSError:
   146	                shutil.copyfile(w, target)
   147	    wheels = sorted(str(p) for p in staged.glob('*.whl'))
   148	    if not wheels:
   149	        raise RuntimeError('Harness unavailable; attach metric/gemma-4-developer-agent-wheelhouse')
   150	    proc = subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '--no-index', '--no-deps',
   151	                           '--force-reinstall', '--disable-pip-version-check', *wheels],
   152	                          stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
   153	    if proc.returncode:
   154	        # pip diagnostics only (no task data); keep the tail for debugging.
   155	        raise RuntimeError('wheel install failed: ' + proc.stderr[-1500:].replace(str(WHEELHOUSE), '<wh>'))
