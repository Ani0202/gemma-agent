   368	    visited, entries, missing = set(), [], []
   369	    while queue:
   370	        metadata = queue.pop(0)
   371	        key = (canonicalize_name(metadata['Name']), metadata['Version'])
   372	        if key in visited:
   373	            continue
   374	        visited.add(key)
   375	        for raw in metadata.get_all('Requires-Dist', []):
   376	            req = Requirement(raw)
   377	            if req.marker and not req.marker.evaluate(dict(environment, extra='')):
   378	                continue
   379	            name = canonicalize_name(req.name)
   380	            current = installed.get(name)
   381	            row = dict(name=name, required_spec=str(req.specifier), requirement=raw,
   382	                       source='missing', version_installed=None)
   383	            if current is not None and current['Version'] in req.specifier:
   384	                row.update(source=sources.get(name, 'sandbox metadata'),
   385	                           version_installed=current['Version'])
   386	            else:
   387	                # Wheelhouse first, then the embedded official PyPI wheels (pip-installed like the image), then runtime copy.
   388	                candidate = compatible_wheels(wheels, tags, req).get(name) or compatible_wheels(extra_wheels(), tags, req).get(name)
   389	                current = None
   390	                if candidate:
   391	                    result = install_wheel(candidate)
   392	                    row['rc'] = result.exit_code
   393	                    for field in ('stdout', 'stderr'):
   394	                        row[field] = (getattr(result, field, '') or '').encode()[-2048:].decode(errors='ignore')
   395	                    if result.exit_code == 0:
   396	                        current = wheel_metadata(candidate)
   397	                        row['source'] = str(candidate)
   398	                else:
   399	                    try:
   400	                        runtime = distribution(name)
   401	                    except PackageNotFoundError:
   402	                        runtime = None
   403	                    if runtime is not None and runtime.version in req.specifier:
   404	                        source = copy_runtime_package(name, destination)
   405	                        if source != 'missing':
   406	                            current = runtime.metadata
   407	                            row['source'] = source
   408	                if current is not None:
   409	                    installed[name] = current
   410	                    sources[name] = row['source']
   411	                    row['version_installed'] = current['Version']
   412	            entries.append(row)
   413	            if current is not None:
   414	                queue.append(current)
   415	            elif name not in missing:
   416	                missing.append(name)
   417	    return entries, missing
