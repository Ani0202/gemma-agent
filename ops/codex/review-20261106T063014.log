   308	def runtime_copyable(name):
   309	    """(dist, files) if copy_runtime_package can copy this runtime package, else None. Copies nothing."""
   310	    from importlib.metadata import distribution, PackageNotFoundError
   311	    try:
   312	        dist = distribution(name)
   313	    except PackageNotFoundError:
   314	        return None
   315	    if name == 'pytest-timeout' and dist.version != '2.1.0':
   316	        return None
   317	    # Distribution names need not match import names (trove-classifiers, PyYAML).
   318	    files = list(dist.files or [])
   319	    if not files or any(str(p).endswith(('.so', '.pyd', '.dll', '.dylib')) for p in files):
   320	        return None
   321	    files = [p for p in files if '..' not in p.parts and not p.is_absolute()
   322	             and not p.parts[0].endswith('.data')]
   323	    if not any(str(p).endswith('.py') and not p.parts[0].endswith('.dist-info') for p in files):
   324	        return None
   325	    return dist, files
