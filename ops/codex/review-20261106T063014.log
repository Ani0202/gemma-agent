   636	def classify_patch(patch, repo, protected=None, test_targets=()):
   637	    """Parse file headers outside hunks, including quoted paths and renames."""
   638	    files, new = set(), set()
   639	    current, added, in_hunk = set(), False, False
   640	    def path_value(raw):
   641	        raw = raw.split('\t', 1)[0]
   642	        value = json.loads(raw) if raw.startswith('"') else raw
   643	        return value[2:] if value.startswith(('a/', 'b/')) else value
   644	    for line in patch.splitlines() + ['diff --git ']:
   645	        if line.startswith('diff --git '):
   646	            files.update(current)
   647	            if added:
   648	                new.update(current)
   649	            current, added, in_hunk = set(), False, False
   650	            match = re.match(r'^diff --git ("a/.*?"|a/.*?) ("b/.*?"|b/.*)$', line)
   651	            if match:
   652	                current.update(path_value(p) for p in match.groups())
   653	        elif line.startswith('@@'):
   654	            in_hunk = True
   655	        elif not in_hunk:
   656	            if line.startswith(('--- ', '+++ ')):
   657	                p = path_value(line[4:])
   658	                if p != '/dev/null':
   659	                    current.add(p)
   660	                elif line.startswith('--- '):
   661	                    added = True
   662	            elif line.startswith('new file mode '):
   663	                added = True
   664	            elif line.startswith(('rename from ', 'rename to ')):
   665	                current.add(path_value(line.split(' ', 2)[2]))
   666	    if protected is None:
   667	        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
   668	    tests = sorted(p for p in files if protected(p) or p in test_targets)
   669	    package = repo.split('/')[-1].replace('-', '_').lower()
   670	    source_roots = (package + '/', 'src/' + package + '/')
   671	    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
   672	                                         and p not in tests))
   673	    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
   674	                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())
   675	
   676	def trace_counts(trace):
   677	    entries = trace.entries if trace else []
   678	    counts = Counter(e.tool_name for e in entries if e.event_type == 'tool_call')
   679	    tokens = {}
   680	    for key in ('prompt_tokens', 'completion_tokens'):
   681	        values = [e.usage[key] for e in entries if e.usage and isinstance(e.usage.get(key), (int, float))]
   682	        tokens[key] = sum(values) if values else None
   683	    return dict(counts), tokens, tool_seconds(entries)
   684	
   685	def tool_seconds(entries):
   686	    """Per tool name: wall seconds from each tool_call to its tool_response (FIFO per name)."""
   687	    pending, out = {}, {}
   688	    for e in entries:
   689	        if e.event_type == 'tool_call':
   690	            pending.setdefault(e.tool_name, []).append(e.timestamp)
   691	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   692	            stat = out.setdefault(e.tool_name, dict(n=0, total=0.0, max=0.0))
   693	            dt = max(0.0, e.timestamp - pending[e.tool_name].pop(0))
   694	            stat['n'] += 1
   695	            stat['total'] = round(stat['total'] + dt, 3)
   696	            stat['max'] = round(max(stat['max'], dt), 3)
   697	    return out
