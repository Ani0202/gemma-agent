   989	def extract_bundle(encoded, destination):
   990	    payload = base64.b64decode(encoded, validate=True)
   991	    destination.mkdir(parents=True, exist_ok=True)
   992	    with tarfile.open(fileobj=io.BytesIO(payload), mode='r:gz') as tf:
   993	        tf.extractall(destination, filter='data')
   994	    return hashlib.sha256(payload).hexdigest(), hashlib.sha256((destination / 'agent.yaml').read_bytes()).hexdigest()
   995	
   996	def append(stream, row):
   997	    stream.write(json.dumps(row, allow_nan=False) + '\n')
   998	    stream.flush(); os.fsync(stream.fileno())
