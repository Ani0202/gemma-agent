   798	async def skip_verification(docker, config, task, snapshot_path, *, agent_patch='',
   799	                            agent_error=None, trace=None, start_time=0.0, **kwargs):
   800	    """Return the harness result type without starting Container B or running tests."""
   801	    from swegemma.models import TaskResult
   802	    result = TaskResult(instance_id=task.instance_id, repo=task.repo, resolved=False,
   803	        agent_patch=agent_patch, test_output='', test_exit_code=0,
