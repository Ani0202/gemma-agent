   699	def observe_patch_strip(original, state):
   700	    """Retain the agent's diff before the harness removes protected edits."""
   701	    def strip(patch, *pos, **kw):
   702	        current = state.get(None)
   703	        filtered = original(patch, *pos, **kw)
   704	        if current is not None and current.get('agent_active'):
   705	            if patch != current.get('filtered_patch'):
   706	                current['raw_patch'] = patch
   707	            current['filtered_patch'] = filtered
   708	        return filtered
   709	    return strip
