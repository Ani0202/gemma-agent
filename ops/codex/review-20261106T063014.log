   832	                  ('turns', re.compile(r'Agent exceeded (turns budget|maximum allowed LLM turns)\b')),
   833	                  ('tool_calls', re.compile(r'Agent exceeded tool call budget\b')),
   834	                  ('no_submit', re.compile(r'Agent completed execution without calling submit_patch\b')))
   835	IMAGE_EMULATION_STEPS = ('venv_fidelity', 'pip_bootstrap', 'interpreter_probe', 'tool_sources',
