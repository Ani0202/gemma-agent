   845	def harness_error(result, agent_error):
   846	    """Fail closed: any error that is not a known normal agent end state is a harness failure."""
   847	    messages = [m for m in ((result.error if result is not None else None), agent_error) if m]
   848	    return 'Harness task failure' if any(agent_outcome(m) is None for m in messages) else None
