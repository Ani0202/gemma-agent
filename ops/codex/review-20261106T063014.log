   119	def load_inventory(data_dir):
   120	    with (data_dir / 'tasks.jsonl').open(encoding='utf-8') as stream:
   121	        tasks = [json.loads(line) for line in stream if line.strip()]
   122	    pending_tasks(tasks, {})
   123	    return tasks
