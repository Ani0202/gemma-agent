   420	# Capture setup.py's otherwise discarded subprocess output without changing setup.py.
   421	# Write after EVERY call so an outer timeout still leaves completed calls visible.
   422	SETUP_OBSERVER = r'''import json, runpy, subprocess, sys, time
   423	from pathlib import Path
   424	original = subprocess.run
   425	calls = []
   426	log = Path(__file__).with_name('setup_subprocesses.json')
   427	log.write_text('[]')
   428	full_log = log.with_name('setup_subprocesses_full.jsonl')
   429	full_log.write_text('')
   430	def run(*args, **kwargs):
   431	    start = time.perf_counter()
   432	    argv = args[0] if args else kwargs.get('args')
   433	    result = None
   434	    try:
   435	        result = original(*args, **kwargs)
   436	        return result
   437	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   438	        result = exc
   439	        raise
   440	    finally:
   441	        def decode(value):
   442	            return value.decode(errors='replace') if isinstance(value, bytes) else (value or '')
   443	        out, err = decode(getattr(result, 'stdout', '')), decode(getattr(result, 'stderr', ''))
   444	        with full_log.open('a') as stream:
   445	            stream.write(json.dumps(dict(argv=argv, stdout=out, stderr=err)) + '\n')
   446	        calls.append(dict(argv=argv, duration_s=time.perf_counter()-start,
   447	            start_offset_s=start-origin, rc=getattr(result, 'returncode', None),
   448	            stdout=out.encode()[-2048:].decode(errors='ignore'),
   449	            stderr=err.encode()[-2048:].decode(errors='ignore'),
   450	            retrying_lines=sum('Retrying' in line for line in (out+'\n'+err).splitlines()),
   451	            interpreter_version=sys.version))
   452	        log.write_text(json.dumps(calls))
   453	origin = time.perf_counter()
   454	subprocess.run = run
   455	sys.argv = sys.argv[1:]
   456	runpy.run_path(sys.argv[0], run_name='__main__')
   457	'''
