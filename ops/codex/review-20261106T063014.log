   460	def patch_subprocess_deps(data_dir, state=None):
   461	    """Install scorer tools in each venv, using that interpreter's ABI, entirely offline."""
   462	    import swegemma.harness.container_setup as cs
   463	    from packaging.utils import parse_wheel_filename
   464	    orig = getattr(cs.install_test_dependencies, '_timing_original', cs.install_test_dependencies)
   465	    wheels = data_dir / 'wheels'
   466	    if not wheels.is_dir():
   467	        wheels = WHEELHOUSE
   468	    setup = data_dir / 'sandbox' / 'setup.py'
   469	    if not setup.exists():
   470	        setup = next(iter(data_dir.rglob('setup.py')), setup)
   471	
   472	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   473	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   474	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   475	        current = state.get() if state is not None else dict(
   476	            started=time.perf_counter(), setup_calls=[], setup_failed=False)
   477	        fixed = os.environ.get('SETUP_FIX', '1') == '1'
   478	        current['setup_fix'] = int(fixed)
   479	        venv = docker.sandboxes[container_id]['venv']
   480	        sp = next(iter(sorted(venv.glob('lib/python3*/site-packages'))))
   481	        if not fixed:
   482	            # Preserve the original injector's wheel selection and base tar exactly.
   483	            def original_base():
   484	                base, large, _modules, _requirements = cs._inspect_wheels_dir(wheels)
   485	                if large:
   486	                    raise RuntimeError('large wheels present; workspace-import scan not emulated')
   487	                current['wheel_tags_chosen'] = [p.name for p in base]
   488	                inject_base(cs, base, sp, current)
   489	            setup_step(current, 'base_tar_extraction', original_base)
   490	            record_distributions(docker, container_id, repo, current['setup_calls'][-1])
   491	        else:
   492	            # A subprocess venv otherwise exposes every kernel package via _host_env.pth.
   493	            # Only the scorer's image tools and public base wheels belong here.
   494	            def isolate_venv():
   495	                for pth in sp.glob('_host_env.pth'):
   496	                    pth.unlink()
   497	                cfg = venv / 'pyvenv.cfg'
   498	                if cfg.exists():
   499	                    cfg.write_text(cfg.read_text().replace(
   500	                        'include-system-site-packages = true', 'include-system-site-packages = false'))
   501	            setup_step(current, 'venv_fidelity', isolate_venv)
   502	            pip_wheel = fallback_wheel(wheels, 'pip')
   503	            def bootstrap_pip():
   504	                if pip_wheel:
   505	                    current['setup_calls'][-1]['source'] = str(pip_wheel)
   506	                    import zipfile
   507	                    with zipfile.ZipFile(pip_wheel) as zf:
   508	                        zf.extractall(sp)
   509	                else:
   510	                    current['setup_calls'][-1]['source'] = copy_runtime_package('pip', sp)
   511	                    if current['setup_calls'][-1]['source'] == 'missing':
   512	                        raise RuntimeError('No offline pip source available')
   513	                return docker.exec(container_id, 'python3 -m pip --version', timeout=30)
   514	            result = setup_step(current, 'pip_bootstrap', bootstrap_pip)
   515	            if result.exit_code != 0:
   516	                raise RuntimeError('Sandbox pip bootstrap failed')
   517	            probe = ("import sys,json;from pip._vendor.packaging.tags import sys_tags;"
   518	                     "from pip._vendor.packaging.markers import default_environment;"
   519	                     "print(json.dumps({'version':sys.version,'tags':[str(t) for t in sys_tags()],"
   520	                     "'environment':default_environment()}))")
   521	            result = setup_step(current, 'interpreter_probe', lambda: docker.exec(
   522	                container_id, 'python3 -c ' + shlex.quote(probe), timeout=30))
   523	            if result.exit_code != 0:
   524	                raise RuntimeError('Sandbox interpreter probe failed')
   525	            identity = json.loads(result.stdout)
   526	            current['interpreter_version'] = identity['version']
   527	            selected = compatible_wheels(wheels, identity['tags'])
   528	            # The image pins pytest-timeout, even if a newer wheel is present.
   529	            selected.pop('pytest-timeout', None)
   530	            for path in pytest_timeout_wheels(wheels):
   531	                if {str(t) for t in parse_wheel_filename(path.name)[3]} & set(identity['tags']):
   532	                    selected['pytest-timeout'] = path
   533	                    break
   534	            current['wheel_tags_chosen'] = [p.name for p in selected.values()]
   535	            def validate_tools():
   536	                missing = [n for n in SCORER_TOOLS if n not in selected and n not in ('pip', 'pytest-timeout')]
   537	                if missing:
   538	                    raise RuntimeError('Required compatible tools missing: ' + ', '.join(missing))
   539	            setup_step(current, 'tool_sources', validate_tools)
   540	            def timeout_source():
