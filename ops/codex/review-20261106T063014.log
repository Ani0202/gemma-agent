   116	      'Metadata assumption (offline): model_sources uses google/gemma-4/Other/<model>/2 (starter casing); docker_image pinned to starter')
   117	PY
   118	if $dry_run; then
   119	  echo "Dry run: no push. Staged: $stage_dir"
   120	elif [[ $setup_only == 1 ]]; then
   121	  kaggle kernels push -p "$stage_dir" -t "$((budget + 1800))"
   122	else
   123	  # 'NvidiaL4' is the starter notebook's machine_shape; unknown names (e.g. NvidiaL4X4) silently fall back to T4 x2.
   124	  kaggle kernels push -p "$stage_dir" --accelerator NvidiaL4 -t "$((budget + 1800))"
   125	  shape_dir=$(mktemp -d /tmp/timing-kernel-shape.XXXXXX)
   126	  kaggle kernels pull "$1" -p "$shape_dir" -m >/dev/null
   127	  shape=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["machine_shape"])' "$shape_dir/kernel-metadata.json")
   128	  rm -rf -- "$shape_dir"
   129	  echo "Server machine_shape: $shape"
   130	  if [[ $shape != NvidiaL4 ]]; then echo "WARNING: accelerator is $shape, not NvidiaL4; kernel will abort at the GPU check" >&2; fi
   131	fi

