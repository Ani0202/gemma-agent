   303	    required_nodes = list(fail_to_pass) + list(pass_to_pass)
   304	    if not required_nodes and test_patch:
   305	        required_nodes = _extract_test_functions_from_patch(test_patch)
   306	    if required_nodes:
   307	        passed_names: set[str] = set()
   308	        failed_or_skipped_names: set[str] = set()
   309	        for tc in root.findall('.//testcase'):
   310	            name = tc.attrib.get('name', '')
   311	            classname = tc.attrib.get('classname', '')
   312	            candidates = {name}
   313	            if '[' in name:
   314	                candidates.add(name.split('[', 1)[0])
   315	            if classname:
   316	                candidates.add(f'{classname}::{name}')
   317	                candidates.add(f'{classname}.{name}')
   318	                mod_path = classname.replace('.', '/') + '.py'
   319	                candidates.add(f'{mod_path}::{name}')
   320	            if (
   321	                tc.find('failure') is None
   322	                and tc.find('error') is None
   323	                and tc.find('skipped') is None
   324	            ):
   325	                passed_names.update(candidates)
   326	            else:
   327	                failed_or_skipped_names.update(candidates)
   328	        for req in required_nodes:
   329	            req_short = req.split('::')[-1]
   330	            req_base = req_short.split('[', 1)[0]
   331	            has_pass = any(
   332	                _node_matches_requirement(p, req, req_short, req_base)
   333	                for p in passed_names
   334	            )
   335	            has_non_pass = any(
   336	                _node_matches_requirement(np, req, req_short, req_base)
   337	                for np in failed_or_skipped_names
   338	            )
   339	            if not has_pass or has_non_pass:
   340	                return False, f'Required test node did not pass: {req}'
   341	
   342	    return True, None
