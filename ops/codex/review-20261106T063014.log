   981	def distribution(values):
   982	    values = sorted(values)
   983	    def percentile(q):
   984	        x = (len(values) - 1) * q
   985	        lo = int(x)
   986	        return values[lo] + (values[min(lo + 1, len(values)-1)] - values[lo]) * (x-lo)
   987	    return dict(mean=sum(values)/len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))
