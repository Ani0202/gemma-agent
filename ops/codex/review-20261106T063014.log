    73	def sha_file(path):
    74	    digest = hashlib.sha256()
    75	    with path.open('rb') as stream:
    76	        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
    77	            digest.update(chunk)
    78	    return digest.hexdigest()
