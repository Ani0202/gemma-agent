   270	def setup_script_identity(data_dir):
   271	    """Resolved path + content hash of the setup script (part of resume identity)."""
   272	    import hashlib
   273	    path = setup_script_path(data_dir)
   274	    return dict(path=str(path.resolve()),
   275	                sha256=hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None)
