   183	def compatible_wheels(wheels, tags, requirement=None):
   184	    """Highest version per distribution, with sandbox PEP 425 tags (never host tags)."""
   185	    from packaging.utils import canonicalize_name, parse_wheel_filename
   186	    rank = {tag: i for i, tag in enumerate(tags)}
   187	    selected = {}
   188	    for path in sorted(Path(wheels).glob('*.whl')):
   189	        name, version, build, wheel_tags = parse_wheel_filename(path.name)
   190	        if requirement is not None and (name != canonicalize_name(requirement.name) or version not in requirement.specifier):
   191	            continue
   192	        matches = [rank[str(tag)] for tag in wheel_tags if str(tag) in rank]
   193	        if not matches:
   194	            continue
   195	        score = (version, -min(matches), build)
   196	        if name not in selected or score > selected[name][0]:
   197	            selected[name] = (score, path)
   198	    return {name: item[1] for name, item in selected.items()}
