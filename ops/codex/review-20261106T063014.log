   158	def choose_sandbox():
   159	    """Probe actual offline container startup, not merely existence of docker CLI."""
   160	    name = f'gold-calibration-probe-{os.getpid()}'
   161	    try:
   162	        probe = subprocess.run(
   163	            ['docker', 'run', '--pull=never', '--rm', '--name', name,
   164	             '--network=none', '--memory=4g', '--cpus=2',
   165	             '--entrypoint', 'python3', 'swebench-sandbox:latest', '-c', 'pass'],
   166	            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
   167	        if probe.returncode == 0:
   168	            return 'docker'
   169	    except (OSError, subprocess.TimeoutExpired):
   170	        pass
   171	    finally:
   172	        try:
   173	            subprocess.run(['docker', 'rm', '-f', name], stdout=subprocess.DEVNULL,
   174	                           stderr=subprocess.DEVNULL, timeout=10)
   175	        except (OSError, subprocess.TimeoutExpired):
   176	            pass
   177	    return 'subprocess'
