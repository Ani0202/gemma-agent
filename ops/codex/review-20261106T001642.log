   190	        path = (base or self.root) / value
   191	        require(path.is_relative_to(self.root), f'path outside bundle: {value}')
   192	        require(path.is_file(), f'missing reference target: {value}')
   193	        require(path != self.root / 'MANIFEST.md', 'MANIFEST.md cannot be referenced: excluded from ZIP')
   194	        require(path in self.files, f'reference is not a bundle file: {value}')
   195	        return path
