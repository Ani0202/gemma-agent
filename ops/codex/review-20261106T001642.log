   102	    def next_line(i):
   103	        while i < len(lines) and (not lines[i].strip() or lines[i].lstrip().startswith('#')):
   104	            i += 1
   105	        return i
   106	
   107	    def indent(i):
   108	        require('\t' not in lines[i][:len(lines[i]) - len(lines[i].lstrip())],
   109	                'tabs are not valid YAML indentation')
   110	        return len(lines[i]) - len(lines[i].lstrip(' '))
   111	
   112	    def block(i, level):
   113	        seq = lines[i][level:].startswith(('- ', '-'))
   114	        result = [] if seq else {}
   115	
   116	        def value(text, pos, base):
   117	            if re.fullmatch(r'[|>][-+]?', text.strip()):
   118	                end = pos
   119	                while end < len(lines) and (not lines[end].strip() or indent(end) > base):
   120	                    end += 1
   121	                content = lines[pos:end]
   122	                margin = min((len(x) - len(x.lstrip()) for x in content if x.strip()), default=base+1)
   123	                chunks = [x[margin:] for x in content]
   124	                out = ('\n' if text.strip().startswith('|') else ' ').join(chunks)
   125	                return out + ('' if text.strip().endswith('-') else '\n'), end
   126	            if text.strip():
   127	                return scalar(text), pos
   128	            child = next_line(pos)
   129	            if child < len(lines) and indent(child) > base:
   130	                return block(child, indent(child))
   131	            return None, pos
   132	
   133	        while True:
   134	            i = next_line(i)
   135	            if i >= len(lines) or indent(i) < level:
   136	                return result, i
   137	            require(indent(i) == level, f'invalid YAML indentation at line {i+1}')
   138	            text = lines[i][level:]
   139	            if seq:
   140	                require(text == '-' or text.startswith('- '), f'expected YAML list at line {i+1}')
   141	                text = text[1:].lstrip()
   142	                if re.match(r'[^:]+:(?:\s|$)', text):
   143	                    key, rest = text.split(':', 1)
   144	                    item, i = value(rest, i+1, level+2)
   145	                    entry = {str(scalar(key)): item}
   146	                    nxt = next_line(i)
   147	                    if nxt < len(lines) and indent(nxt) == level+2:
   148	                        extra, i = block(nxt, level+2)
   149	                        require(isinstance(extra, dict) and not entry.keys() & extra.keys(), 'invalid list mapping')
   150	                        entry.update(extra)
   151	                    result.append(entry)
   152	                else:
   153	                    item, i = value(text, i+1, level)
   154	                    result.append(item)
   155	            else:
   156	                match = re.match(r'([^:]+):(?:\s(.*)|$)', text)
   157	                require(match is not None, f'invalid YAML mapping at line {i+1}')
   158	                key = scalar(match[1])
   159	                require(isinstance(key, str) and key not in result, 'invalid or duplicate YAML key')
   160	                result[key], i = value(match[2] or '', i+1, level)
   161	
   162	    start = next_line(0)
   163	    if start == len(lines):
   164	        return None
   165	    # A JSON document is also YAML.
   166	    if lines[start].lstrip().startswith(('{', '[')):
   167	        return scalar('\n'.join(lines[start:]))
   168	    require(indent(start) == 0, 'YAML document must begin at indentation zero')
   169	    result, end = block(start, 0)
   170	    require(next_line(end) == len(lines), 'trailing YAML content')
   171	    return result
