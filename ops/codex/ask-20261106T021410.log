    11	def ok_response(**kwargs: Any) -> str:
    12	    """Format a successful tool JSON response."""
    13	    data = {'status': 'ok'}
    14	    data.update(kwargs)
    15	    return json.dumps(data, ensure_ascii=False)
    16	
    17	
    18	def error_response(
    19	    error_type: str,
    20	    error_message: str,
    21	    details: dict[str, Any] | None = None,
    22	) -> str:
    23	    """Format an error tool JSON response."""
    24	    data: dict[str, Any] = {
    25	        'status': 'error',
    26	        'error_type': error_type,
    27	        'error_message': error_message,
    28	    }
    29	    if details is not None:
    30	        data['details'] = details
    31	    return json.dumps(data, ensure_ascii=False)
    32	
    33	
    34	def parse_tool_response(raw_response: str | dict[str, Any]) -> dict[str, Any]:
    35	    """Convert a JSON-serialized tool response into a dict for the ADK tool boundary."""
    36	    if isinstance(raw_response, dict):
    37	        return raw_response
    38	    try:
    39	        parsed = json.loads(raw_response)
    40	        if isinstance(parsed, dict):
    41	            return parsed
    42	        return {'status': 'ok', 'result': parsed}
    43	    except Exception:
    44	        return {'status': 'ok', 'result': raw_response}
    45	
    46	
    47	def _attach_low_budget_warning(ctx: Any, raw_response: str) -> str:
    48	    """Attach a low-budget warning to a JSON tool response when <= 10 tool calls remain."""
    49	    budget = getattr(ctx, 'budget', None)
    50	    max_calls = getattr(budget, 'tool_calls', None) if budget is not None else None
    51	    used_calls = getattr(ctx, 'tool_calls_used', None)
    52	    if max_calls is None or used_calls is None or max_calls < 20:
    53	        return raw_response
    54	
    55	    remaining = max(0, max_calls - used_calls)
    56	    if remaining > 10:
    57	        return raw_response
    58	
    59	    try:
    60	        payload = json.loads(raw_response)
    61	        if isinstance(payload, dict) and 'budget_warning' not in payload:
    62	            payload['budget_warning'] = (
    63	                f'Only {remaining} tool call(s) remaining ({used_calls}/{max_calls} used). '
    64	                'Finalize your edits and call submit_patch soon.'
    65	            )
    66	            return json.dumps(payload, ensure_ascii=False)
    67	    except Exception:
    68	        pass
    69	    return raw_response
    70	
    71	
    72	def budget_gated(
    73	    func: Callable | None = None,
    74	    *,
    75	    count_tool_call: bool = True,
    76	) -> Callable:
    77	    """Decorator ensuring that tool invocations check and adhere to the context budget."""
    78	
    79	    def decorator(target: Callable) -> Callable:
    80	        @functools.wraps(target)
    81	        def wrapper(ctx: Any, *args: Any, **kwargs: Any) -> str:
    82	            tool_lock = getattr(ctx, 'tool_lock', None)
    83	            if tool_lock is not None:
    84	                with tool_lock:
    85	                    try:
    86	                        budget_error = ctx.check_budget(
    87	                            count_tool_call=count_tool_call
    88	                        )
    89	                    except TypeError:
    90	                        budget_error = ctx.check_budget()
    91	                    if budget_error:
    92	                        return budget_error
    93	                    res = target(ctx, *args, **kwargs)
    94	            else:
    95	                try:
    96	                    budget_error = ctx.check_budget(
    97	                        count_tool_call=count_tool_call
    98	                    )
    99	                except TypeError:
   100	                    budget_error = ctx.check_budget()
   101	                if budget_error:
   102	                    return budget_error
   103	                res = target(ctx, *args, **kwargs)
   104	
   105	            if count_tool_call and isinstance(res, str):
   106	                return _attach_low_budget_warning(ctx, res)
   107	            return res
   108	
   109	        return wrapper
   110	
   111	    if func is not None:
   112	        return decorator(func)
   113	    return decorator
