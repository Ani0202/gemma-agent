   208	def _compile_agent(
   209	    config: Any,
   210	    ctx: CompilationContext,
   211	) -> BaseAgent:
   212	    """Dispatch to the correct builder for each agent configuration type.
   213	
   214	    Args:
   215	        config: The validated sandboxed agent configuration object to compile.
   216	        ctx: The compilation context tracking mutable state and limits.
   217	
   218	    Returns:
   219	        An instantiated ADK BaseAgent matching the configuration.
   220	
   221	    Raises:
   222	        LimitExceededError: If the total number of compiled agents exceeds ``ctx.limits.max_agents``.
   223	        SubmissionValidationError: If the agent configuration type is unsupported.
   224	    """
   225	    ctx.agent_count += 1
   226	    if ctx.agent_count > ctx.limits.max_agents:
   227	        raise LimitExceededError(
   228	            f"Too many agents: {ctx.agent_count} (max {ctx.limits.max_agents})"
   229	        )
   230	
   231	    if isinstance(config, SandboxedLlmAgentConfig):
   232	        return compile_llm_agent(config, ctx, _compile_agent)
   233	    elif isinstance(config, SandboxedSequentialAgentConfig):
   234	        return compile_sequential_agent(config, ctx, _compile_agent)
   235	    elif isinstance(config, SandboxedParallelAgentConfig):
   236	        return compile_parallel_agent(config, ctx, _compile_agent)
   237	    elif isinstance(config, SandboxedLoopAgentConfig):
   238	        return compile_loop_agent(config, ctx, _compile_agent)
   239	    else:
   240	        raise SubmissionValidationError(
