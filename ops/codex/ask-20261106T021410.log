   145	def _reject_bool_nan_inf(v: Any, field_name: str) -> Any:
   146	    if v is None:
   147	        return None
   148	    if isinstance(v, bool):
   149	        raise ValueError(f"{field_name} cannot be a boolean")
   150	    if isinstance(v, (int, float)) and (math.isnan(v) or math.isinf(v)):
   151	        raise ValueError(f"{field_name} must be a finite number, got {v!r}")
   152	    return v
