    72	                except (AttributeError, TypeError):
    73	                    @functools.wraps(tool)
    74	                    def _wrapped_ro(*args: Any, **kwargs: Any) -> Any:
    75	                        return tool(*args, **kwargs)
    76	
    77	                    _wrapped_ro.__name__ = item
