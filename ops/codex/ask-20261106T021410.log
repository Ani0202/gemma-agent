   211	    def handle_adk_event(self, event: Any, agent_name: str | None = None) -> None:
   212	        """Synchronously extract tool/thought activity preview and count model calls."""
   213	        if event is None:
   214	            return
   215	
   216	        with self._lock:
   217	            event_id = getattr(event, 'id', None) or id(event)
   218	            is_partial = getattr(event, 'partial', False)
   219	            event_key = (event_id, is_partial)
   220	            if event_key in self._handled_event_ids:
   221	                return
   222	            self._handled_event_ids.add(event_key)
   223	
   224	        try:
   225	            content = getattr(event, 'content', None)
   226	            parts = getattr(content, 'parts', []) if content else []
   227	
   228	            # 1. Activity preview extraction
   229	            activity_found = False
   230	            for part in parts:
   231	                if hasattr(part, 'function_call') and part.function_call:
   232	                    fc = part.function_call
   233	                    name = getattr(fc, 'name', '') or 'tool'
   234	                    args = dict(fc.args) if getattr(fc, 'args', None) else {}
   235	                    preview_arg = ''
   236	                    for key in (
   237	                        'command',
   238	                        'path',
   239	                        'file_path',
   240	                        'query',
   241	                        'pattern',
   242	                        'filename',
   243	                        'prompt',
   244	                    ):
   245	                        val = args.get(key)
   246	                        if val:
   247	                            preview_arg = str(val)
   248	                            break
   249	                    if not preview_arg and args:
   250	                        preview_arg = str(next(iter(args.values())))
   251	                    if preview_arg and preview_arg.strip():
   252	                        lines = preview_arg.strip().splitlines()
   253	                        first_line = lines[0] if lines else ''
   254	                        if len(first_line) > 30:
   255	                            first_line = first_line[:27] + '...'
   256	                        activity = (
   257	                            f'{name}({first_line})' if first_line else f'{name}()'
   258	                        )
   259	                    else:
