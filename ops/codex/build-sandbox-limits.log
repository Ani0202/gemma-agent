               f'data=$(printf %s {encoded(data_dir)} | base64 -d); '
               'test ! -e "$inventory" && ' + empty_check +
               "python3 -c 'import pytest' && "
               'echo probe > /workspace/x && echo probe > /tmp/y')
        result = manager.exec(sid, cmd, timeout=60)
