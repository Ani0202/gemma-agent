def execute_limited(command, cwd, env, timeout=300, *, shell=None,
                    max_output_chars=10 * 1024 * 1024):
    """Installed executor contract, with host process-tree limits and cleanup."""
    from adk_eval_core.errors import EvalCoreError
    from adk_eval_core.sandbox.base import ExecutionResult

    start = time.perf_counter()
    metrics = command_metrics.get()
    tracked = {}
    peak = 0
    marker = ('GEMMA_SANDBOX_TREE=' + uuid.uuid4().hex).encode()
    child_env = dict(env)
    child_env['GEMMA_SANDBOX_TREE'] = marker.decode().split('=', 1)[1]
    if shell is None:
        shell = isinstance(command, str)
    try:
        limit = int(os.environ.get('GEMMA_SANDBOX_MEM_BYTES', 4 * 1024**3))
        as_limit = int(os.environ.get('GEMMA_SANDBOX_AS_BYTES', 8 * 1024**3))
        # A bin/job fallback may already impose a lower hard AS cap. Raising
        # that cap is unprivileged and must never be attempted by prlimit.
        hard_as = resource.getrlimit(resource.RLIMIT_AS)[1]
        if hard_as != resource.RLIM_INFINITY:
            as_limit = min(as_limit, hard_as)
        prlimit = shutil.which('prlimit')
        if prlimit:
            # Preserve Popen's string/list shell semantics inside the backstop.
            if shell:
                command = ['/bin/sh', '-c', command] if isinstance(command, str) else ['/bin/sh', '-c', *command]
            elif isinstance(command, str):
                command = [command]
            command = [prlimit, f'--as={as_limit}', '--', *command]
            shell = False
        proc = subprocess.Popen(command, shell=shell, cwd=str(cwd), env=child_env,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, encoding='utf-8', errors='replace',
                                start_new_session=True)
    except (RuntimeError, OSError, ValueError, EvalCoreError) as exc:
        return ExecutionResult(status='error', stdout='', stderr=str(exc), exit_code=-1,
                               duration_seconds=round(time.perf_counter() - start, 3))

    def scan():
        nonlocal peak
        processes = proctree.snapshot()
        roots = set(proctree.survivors(tracked, processes)) | {proc.pid}
        selected = proctree.descendants(roots, processes)
        for p in processes.values():
            if p.pgid == proc.pid or p.sid == proc.pid:
                selected.add(p.pid)
            elif p.pid not in selected:
                # A child can setsid + reparent between polls. The inherited unique
                # marker catches it without relying on namespace-local pids (bwrap).
                try:
                    if marker in Path(f'/proc/{p.pid}/environ').read_bytes().split(b'\0'):
                        selected.add(p.pid)
                except OSError:
                    pass
        selected = proctree.descendants(selected, processes)
        for pid in selected:
            if pid in processes:
                tracked.setdefault(pid, processes[pid])
        peak = max(peak, proctree.tree_rss(tracked, processes))
        return proctree.survivors(tracked, processes)

    def cleanup():
        live = scan()
        count = len(live)
        deadline = time.monotonic() + 2
        while live:
            proctree.kill_tree(live)
            proc.poll()  # Reap our direct child; zombies aren't running survivors.
            if time.monotonic() >= deadline:
                raise RuntimeError('Sandbox processes survived SIGKILL')
            time.sleep(0.025)
            live = scan()
        return count

    status, code = None, None
    stdout, stderr = '', ''
    try:
        while True:
            scan()
            if peak > limit:
                status, code = 'error', 137
                if metrics is not None:
                    metrics['mem_kills'] = metrics.get('mem_kills', 0) + 1
                cleanup()
                break
            if timeout is not None and time.perf_counter() - start >= timeout:
                status, code = 'timeout', 124
                cleanup()
                break
            if proc.poll() is not None:
                count = cleanup()
                if metrics is not None:
                    metrics['orphan_kills'] = metrics.get('orphan_kills', 0) + count
                break
            wait = 0.25 if timeout is None else max(0.001, min(0.25, timeout - (time.perf_counter() - start)))
            try:
                stdout, stderr = proc.communicate(timeout=wait)
            except subprocess.TimeoutExpired:
                continue
            # Scan and clean up even if detached daemons closed their pipe fds.
            count = cleanup()
            if metrics is not None:
                metrics['orphan_kills'] = metrics.get('orphan_kills', 0) + count
            break
        try:
            stdout, stderr = proc.communicate(timeout=1)
        except Exception:
            stdout, stderr = '', ''
        if status is None:
            status, code = ('ok' if proc.returncode == 0 else 'error'), proc.returncode
        if status != 'timeout':
            if max_output_chars and len(stdout) > max_output_chars:
                stdout = stdout[:max_output_chars] + '\n...[Output truncated at 10MB limit]\n'
            if max_output_chars and len(stderr) > max_output_chars:
                stderr = stderr[:max_output_chars] + '\n...[Output truncated at 10MB limit]\n'
        if code == 137:
            stderr += '\nkilled: sandbox memory limit\n'
    except (RuntimeError, OSError, ValueError, EvalCoreError) as exc:
        status, code, stdout, stderr = 'error', 1, '', str(exc)
    finally:
        cleanup()  # Fail closed if a process cannot be killed.
        proc.stdout.close()
        proc.stderr.close()
        if metrics is not None:
            metrics['peak_rss_bytes'] = max(metrics.get('peak_rss_bytes', 0), peak)
            for key in ('mem_kills', 'orphan_kills'):
                metrics.setdefault(key, 0)
    return ExecutionResult(status=status, stdout=stdout or '', stderr=stderr or '',
                           exit_code=code, duration_seconds=round(time.perf_counter() - start, 3))


def apply_isolation(hidden_paths, ro_paths):
    """Wrap the module executor, retaining the installed manager's translation/env.

    Empty hidden_paths disables bwrap (explicit opt-out), but retains timeout
    accounting. Repeated setup replaces this hook rather than stacking it.
    """
    import swegemma.sandbox.subprocess as sb
    hidden_paths, ro_paths = tuple(hidden_paths), tuple(ro_paths)
    original = getattr(sb.execute_subprocess_command, '_unwrapped', sb.execute_subprocess_command)

    def execute(command, cwd, env, **kwargs):
        if ro_paths:
            command = [*command[:2], re.sub(r'(?<![\w.-])/wheels(?![\w.-])',
                                           str(Path(ro_paths[0]).resolve()), command[2])]
        if hidden_paths:
            if not isinstance(command, list) or command[:2] != ['/bin/bash', '-c']:
                raise RuntimeError('Unsupported harness subprocess command')
            # The harness's fallback wheel search doesn't include custom data dirs.
            command = bwrap_argv(command, cwd, hidden_paths, runtime_ro_paths(cwd, ro_paths))
        result = execute_limited(command=command, cwd=cwd, env=env, **kwargs)
        metrics = command_metrics.get()
        if metrics is not None and (result.status == 'timeout' or result.exit_code == 124):
            metrics['cmd_timeouts'] = metrics.get('cmd_timeouts', 0) + 1
        return result

    execute._unwrapped = original
