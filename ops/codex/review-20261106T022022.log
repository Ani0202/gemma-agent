  1170	def gpu_preflight():
  1171	    """Raise WrongAccelerator unless nvidia-smi lists >= 4 L4 GPUs; skip if nvidia-smi is unavailable."""
  1172	    try:
  1173	        gpus = subprocess.run(['nvidia-smi', '-L'], capture_output=True, text=True, timeout=60).stdout.splitlines()
  1174	    except (OSError, subprocess.SubprocessError):
  1175	        return
  1176	    if len(gpus) < 4 or not all('L4' in g for g in gpus):
  1177	        raise WrongAccelerator('expected 4x L4 (nvidia-smi -L preflight)')
