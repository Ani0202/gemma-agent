   496	        checksum = digest.hexdigest()
   497	        os.replace(temporary, destination)
   498	        manifest = bundle.root / 'MANIFEST.md'
   499	        content = manifest.read_text(encoding='utf-8') if manifest.exists() else ''
   500	        lines = [line for line in content.splitlines() if not re.match(r'^\s*(?:[-*]\s*)?zip sha256\s*:', line, re.I)]
   501	        manifest.write_text('\n'.join(lines).rstrip() + f'\nzip sha256: {checksum}\n', encoding='utf-8')
   502	        print(f'{destination}\nsha256: {checksum}\nsize: {destination.stat().st_size} bytes')
   503	    finally:
   504	        if os.path.exists(temporary):
   505	            os.unlink(temporary)
