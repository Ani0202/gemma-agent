  1128	def start_server(holder):
  1129	    import torch
  1130	    from adk_submission import VllmConfig, VllmServer, discover_adapters
  1131	    from adk_submission.discovery import discover_declared_models
  1132	    from swegemma.config import ALLOWED_ADAPTER_EXTENSIONS
  1133	    MODEL_VLLM_EXTRA_ARGS = {'gemma-4-12b-it-qat-w4a16-ct': (
  1134	        '--hf-overrides', '{"architectures": ["Gemma4ForCausalLM"], "model_type": "gemma4"}')}
  1135	    _SAFE_PATH_COMPONENT = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')
  1136	    declared_models = discover_declared_models(BUNDLE)
  1137	    assert len(declared_models) == 1, f'Expected exactly 1 declared model, got: {sorted(declared_models)}'
  1138	    declared_model = next(iter(declared_models))
  1139	    assert declared_model in {'gemma-4-' + x + '-it-qat-w4a16-ct' for x in ('31b', '12b', 'e4b', 'e2b')}, 'Unsupported declared model'
  1140	    MODEL_PATH = Path(f'/kaggle/input/models/google/gemma-4/other/{declared_model}/2')
  1141	    assert MODEL_PATH.exists(), f'Model weights not found at {MODEL_PATH}. Ensure the model input is attached.'
  1142	    adapters = discover_adapters(str(BUNDLE), adapter_extensions=ALLOWED_ADAPTER_EXTENSIONS)
  1143	    adapter_map = getattr(adapters, 'adapters', None) or {}
  1144	    for adapter_name in adapter_map:
  1145	        assert _SAFE_PATH_COMPONENT.fullmatch(adapter_name), 'Unsafe adapter name'
  1146	    detected_ranks = [r for info in adapter_map.values() if (r := getattr(info, 'rank', None)) is not None and r > 0]
  1147	    gpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1
  1148	    tp_size = 4 if gpu_count >= 4 else (2 if gpu_count >= 2 else 1)
  1149	    vllm_cfg = VllmConfig(
  1150	        model=str(MODEL_PATH), port=8000, host='127.0.0.1',
  1151	        tool_call_parser='gemma4', reasoning_parser='gemma4', max_model_len=32768,
  1152	        dtype='bfloat16' if (torch.cuda.is_available() and torch.cuda.is_bf16_supported()) else 'auto',
  1153	        gpu_memory_utilization=0.90, enable_auto_tool_choice=True,
  1154	        enable_lora=bool(adapter_map), max_loras=max(1, len(adapter_map)),
  1155	        max_lora_rank=max(detected_ranks) if detected_ranks else 128,
  1156	        scheduler_reserve_full_isl=False, tensor_parallel_size=tp_size, startup_timeout=60 * 20,
  1157	        extra_args=MODEL_VLLM_EXTRA_ARGS.get(declared_model, ()),
  1158	    )
  1159	    server_instance = VllmServer(vllm_cfg, adapter_manifest=adapters)
  1160	    holder.append(server_instance)
  1161	    start = time.perf_counter()
  1162	    server_instance.start()
  1163	    startup = time.perf_counter() - start
  1164	    return server_instance, adapters, declared_model, startup
