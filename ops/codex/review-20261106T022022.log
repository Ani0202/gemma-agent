   478	    destination = dist / f'{track}-{version}.zip'
   479	    fd, temporary = tempfile.mkstemp(prefix='.pack-', suffix='.zip', dir=dist)
   480	    os.close(fd)
   481	    try:
   482	        with zipfile.ZipFile(temporary, 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
   483	            for path in bundle.files:
   484	                if path == bundle.root / 'MANIFEST.md':
   485	                    continue
   486	                info = zipfile.ZipInfo(path.relative_to(bundle.root).as_posix(), (1980, 1, 1, 0, 0, 0))
   487	                info.create_system = 3
   488	                info.external_attr = (stat.S_IFREG | 0o644) << 16
   489	                info.compress_type = zipfile.ZIP_DEFLATED
   490	                with path.open('rb') as source, archive.open(info, 'w', force_zip64=True) as target:
