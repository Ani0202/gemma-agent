   991	def start_server(holder):
   992	    import torch
   993	    from adk_submission import VllmConfig, VllmServer, discover_adapters
   994	    from adk_submission.discovery import discover_declared_models
   995	    from swegemma.config import ALLOWED_ADAPTER_EXTENSIONS
   996	    MODEL_VLLM_EXTRA_ARGS = {'gemma-4-12b-it-qat-w4a16-ct': (
   997	        '--hf-overrides', '{"architectures": ["Gemma4ForCausalLM"], "model_type": "gemma4"}')}
   998	    _SAFE_PATH_COMPONENT = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')
   999	    declared_models = discover_declared_models(BUNDLE)
  1000	    assert len(declared_models) == 1, f'Expected exactly 1 declared model, got: {sorted(declared_models)}'
  1001	    declared_model = next(iter(declared_models))
  1002	    assert declared_model in {'gemma-4-' + x + '-it-qat-w4a16-ct' for x in ('31b', '12b', 'e4b', 'e2b')}, 'Unsupported declared model'
  1003	    MODEL_PATH = Path(f'/kaggle/input/models/google/gemma-4/other/{declared_model}/2')
  1004	    assert MODEL_PATH.exists(), f'Model weights not found at {MODEL_PATH}. Ensure the model input is attached.'
  1005	    adapters = discover_adapters(str(BUNDLE), adapter_extensions=ALLOWED_ADAPTER_EXTENSIONS)
  1006	    adapter_map = getattr(adapters, 'adapters', None) or {}
  1007	    for adapter_name in adapter_map:
  1008	        assert _SAFE_PATH_COMPONENT.fullmatch(adapter_name), 'Unsafe adapter name'
  1009	    detected_ranks = [r for info in adapter_map.values() if (r := getattr(info, 'rank', None)) is not None and r > 0]
  1010	    gpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1
  1011	    tp_size = 4 if gpu_count >= 4 else (2 if gpu_count >= 2 else 1)
  1012	    vllm_cfg = VllmConfig(
  1013	        model=str(MODEL_PATH), port=8000, host='127.0.0.1',
  1014	        tool_call_parser='gemma4', reasoning_parser='gemma4', max_model_len=32768,
  1015	        dtype='bfloat16' if (torch.cuda.is_available() and torch.cuda.is_bf16_supported()) else 'auto',
  1016	        gpu_memory_utilization=0.90, enable_auto_tool_choice=True,
  1017	        enable_lora=bool(adapter_map), max_loras=max(1, len(adapter_map)),
  1018	        max_lora_rank=max(detected_ranks) if detected_ranks else 128,
  1019	        scheduler_reserve_full_isl=False, tensor_parallel_size=tp_size, startup_timeout=60 * 20,
  1020	        extra_args=MODEL_VLLM_EXTRA_ARGS.get(declared_model, ()),
  1021	    )
  1022	    server_instance = VllmServer(vllm_cfg, adapter_manifest=adapters)
  1023	    holder.append(server_instance)
  1024	    start = time.perf_counter()
  1025	    server_instance.start()
  1026	    startup = time.perf_counter() - start
  1027	    return server_instance, adapters, declared_model, startup
