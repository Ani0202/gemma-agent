   290	def fallback_wheel(wheels, package):
   291	    """Prefer the wheelhouse, then the running interpreter's ensurepip bundle."""
   292	    from packaging.utils import parse_wheel_filename
   293	    found = list(Path(wheels).glob(package + '-*-py3-none-any.whl'))
   294	    if not found and package == 'pip':
   295	        try:
   296	            import ensurepip
   297	            found = list((Path(ensurepip.__file__).parent / '_bundled').glob('pip-*.whl'))
   298	        except ImportError:
   299	            pass
   300	    return max(found, key=lambda p: parse_wheel_filename(p.name)[1]) if found else None
   301	
   302	
   303	def runtime_copyable(name):
   304	    """(dist, files) if copy_runtime_package can copy this runtime package, else None. Copies nothing."""
   305	    from importlib.metadata import distribution, PackageNotFoundError
   306	    try:
   307	        dist = distribution(name)
   308	    except PackageNotFoundError:
   309	        return None
   310	    if name == 'pytest-timeout' and dist.version != '2.1.0':
   311	        return None
   312	    # Distribution names need not match import names (trove-classifiers, PyYAML).
   313	    files = list(dist.files or [])
   314	    if not files or any(str(p).endswith(('.so', '.pyd', '.dll', '.dylib')) for p in files):
   315	        return None
   316	    files = [p for p in files if '..' not in p.parts and not p.is_absolute()
   317	             and not p.parts[0].endswith('.data')]
   318	    if not any(str(p).endswith('.py') and not p.parts[0].endswith('.dist-info') for p in files):
   319	        return None
   320	    return dist, files
   321	
   322	
   323	def copy_runtime_package(name, destination):
   324	    """Copy only the pure Python image package and metadata; no host path injection."""
   325	    found = runtime_copyable(name)
   326	    if found is None:
   327	        return 'missing'
   328	    dist, files = found
   329	    for entry in files:
   330	        target = destination / entry
   331	        target.parent.mkdir(parents=True, exist_ok=True)
   332	        shutil.copyfile(dist.locate_file(entry), target)
   333	    return 'runtime-site-packages:' + str(dist.locate_file(''))
