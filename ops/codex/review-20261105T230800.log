   177	def main():
   178	    parser = argparse.ArgumentParser(description=__doc__)
   179	    parser.add_argument('timing_jsonl', type=Path)
   180	    parser.add_argument('--output', type=Path, required=True)
   181	    parser.add_argument('--gate-max-phase1', type=float, default=296)
   182	    parser.add_argument('--gate-mean-phase1', type=float, default=270)
   183	    parser.add_argument('--gate-vllm-seconds', type=float, default=600)
   184	    parser.add_argument('--gate-min-nonempty', type=int, default=1)
   185	    args = parser.parse_args()
