   846	def image_emulation_seconds(setup_calls):
   847	    """Seconds spent emulating Dockerfile.public image layers the scorer image already has."""
   848	    return sum(c.get('duration_s') or 0 for c in setup_calls if c.get('step') in IMAGE_EMULATION_STEPS)
