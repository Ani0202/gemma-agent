   631	def classify_patch(patch, repo, protected=None, test_targets=()):
   632	    """Parse file headers outside hunks, including quoted paths and renames."""
   633	    files, new = set(), set()
   634	    current, added, in_hunk = set(), False, False
   635	    def path_value(raw):
   636	        raw = raw.split('\t', 1)[0]
   637	        value = json.loads(raw) if raw.startswith('"') else raw
   638	        return value[2:] if value.startswith(('a/', 'b/')) else value
   639	    for line in patch.splitlines() + ['diff --git ']:
   640	        if line.startswith('diff --git '):
   641	            files.update(current)
   642	            if added:
   643	                new.update(current)
   644	            current, added, in_hunk = set(), False, False
   645	            match = re.match(r'^diff --git ("a/.*?"|a/.*?) ("b/.*?"|b/.*)$', line)
   646	            if match:
   647	                current.update(path_value(p) for p in match.groups())
   648	        elif line.startswith('@@'):
   649	            in_hunk = True
   650	        elif not in_hunk:
   651	            if line.startswith(('--- ', '+++ ')):
   652	                p = path_value(line[4:])
   653	                if p != '/dev/null':
   654	                    current.add(p)
   655	                elif line.startswith('--- '):
   656	                    added = True
   657	            elif line.startswith('new file mode '):
   658	                added = True
   659	            elif line.startswith(('rename from ', 'rename to ')):
   660	                current.add(path_value(line.split(' ', 2)[2]))
   661	    if protected is None:
   662	        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
   663	    tests = sorted(p for p in files if protected(p) or p in test_targets)
   664	    package = repo.split('/')[-1].replace('-', '_').lower()
   665	    source_roots = (package + '/', 'src/' + package + '/')
   666	    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
   667	                                         and p not in tests))
   668	    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
   669	                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())
