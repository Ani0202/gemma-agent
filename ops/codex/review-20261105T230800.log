   671	def trace_counts(trace):
   672	    entries = trace.entries if trace else []
   673	    counts = Counter(e.tool_name for e in entries if e.event_type == 'tool_call')
   674	    tokens = {}
   675	    for key in ('prompt_tokens', 'completion_tokens'):
   676	        values = [e.usage[key] for e in entries if e.usage and isinstance(e.usage.get(key), (int, float))]
   677	        tokens[key] = sum(values) if values else None
   678	    return dict(counts), tokens, tool_seconds(entries)
   679	
   680	def tool_seconds(entries):
   681	    """Per tool name: wall seconds from each tool_call to its tool_response (FIFO per name)."""
   682	    pending, out = {}, {}
   683	    for e in entries:
   684	        if e.event_type == 'tool_call':
   685	            pending.setdefault(e.tool_name, []).append(e.timestamp)
   686	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   687	            stat = out.setdefault(e.tool_name, dict(n=0, total=0.0, max=0.0))
   688	            dt = max(0.0, e.timestamp - pending[e.tool_name].pop(0))
   689	            stat['n'] += 1
   690	            stat['total'] = round(stat['total'] + dt, 3)
   691	            stat['max'] = round(max(stat['max'], dt), 3)
   692	    return out
