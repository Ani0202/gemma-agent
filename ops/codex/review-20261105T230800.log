   858	def extract_bundle(encoded, destination):
   859	    payload = base64.b64decode(encoded, validate=True)
   860	    destination.mkdir(parents=True, exist_ok=True)
   861	    with tarfile.open(fileobj=io.BytesIO(payload), mode='r:gz') as tf:
   862	        tf.extractall(destination, filter='data')
   863	    return hashlib.sha256(payload).hexdigest(), hashlib.sha256((destination / 'agent.yaml').read_bytes()).hexdigest()
