     1	"""Summarize a downloaded kaggle_timing_v1 journal without reading raw task artifacts."""
     2	import argparse
     3	import json
     4	import math
     5	from collections import Counter
     6	from pathlib import Path
     7	
     8	
     9	def distribution(values):
    10	    values = sorted(values)
    11	    def percentile(q):
    12	        pos = (len(values) - 1) * q
    13	        low = int(pos)
    14	        return values[low] + (values[min(low + 1, len(values) - 1)] - values[low]) * (pos - low)
    15	    return dict(mean=sum(values) / len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))
    16	
    17	
    18	def retrying_lines(call):
    19	    children = call.get('subprocesses', [])
    20	    return max(call.get('retrying_lines', 0), sum(c.get('retrying_lines', 0) for c in children))
    21	
    22	
    23	def fallback_invocations(call):
    24	    return setup_evidence(call) - retrying_lines(call)
    25	
    26	
    27	def setup_evidence(call):
    28	    """Count index fallback invocations and retry lines, without counting nested output twice."""
    29	    children = call.get('subprocesses', [])
    30	    retries = max(call.get('retrying_lines', 0), sum(c.get('retrying_lines', 0) for c in children))
    31	    fallbacks = 0
    32	    for child in children or [call]:
    33	        argv = child.get('argv') or []
    34	        if isinstance(argv, str):
    35	            import shlex
    36	            argv = shlex.split(argv)
    37	        fallbacks += int('install' in argv and '-e' in argv and '--no-index' not in argv)
    38	    return retries + fallbacks
    39	
    40	
    41	def summarize(path, *, gate_max_phase1=296, gate_mean_phase1=270,
    42	              gate_vllm_seconds=600, gate_min_nonempty=1):
    43	    records = [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
    44	    if not records or records[0].get('_schema') != 'kaggle_timing_v1':
    45	        raise ValueError('Expected kaggle_timing_v1 header')
    46	    header, rows, startup, done, stopped = records[0], [], records[0].get('vllm_startup_seconds'), None, []
    47	    artifact_errors = []
    48	    for row in records[1:]:
    49	        if 'instance_id' in row:
    50	            rows.append(row)
    51	        elif '_vllm' in row:
    52	            startup = row['_vllm']['startup_seconds']
    53	        elif '_done' in row:
    54	            done = row['_done']
    55	        elif '_stopped' in row:
    56	            stopped.append(row['_stopped'])
    57	        elif '_artifact_error' in row:
    58	            artifact_errors.append(row['_artifact_error'])
    59	        else:
    60	            raise ValueError('Unknown journal record')
    61	    ids = [r['instance_id'] for r in rows]
    62	    if len(ids) != len(set(ids)) or set(ids) - set(header['task_ids']):
    63	        raise ValueError('Duplicate or unexpected task records')
    64	    if done is not None and done['n'] != len(rows):
    65	        raise ValueError('Done count does not match task records')
    66	    def numbers(values):
    67	        if any(type(v) not in (int, float) or not math.isfinite(v) or v < 0 for v in values):
    68	            raise ValueError('Invalid measurement')
    69	        return values
    70	    totals = distribution(numbers([r['wall_seconds']['total'] for r in rows]))
    71	    shares = distribution(numbers([r.get('test_run', {}).get('share_of_agent_seconds') for r in rows if r.get('test_run', {}).get('share_of_agent_seconds') is not None]))
    72	    runs = distribution(numbers([r.get('test_run', {}).get('n', 0) for r in rows]))
    73	    caps = header.get('caps') or {}
    74	    cap = caps.get('max_time_minutes')
    75	    numbers([v for v in (startup, cap) if v is not None])
    76	    timing_minutes = totals['p90'] * 125 / 60 + startup / 60 if totals['p90'] is not None and startup is not None else None
    77	    cap_minutes = cap * 125 + 30 if cap is not None else None
    78	    tasks = []
    79	    for row in rows:
    80	        source_files = set(row.get('patch_files', [])) - set(row.get('test_files_edited', [])) - set(row.get('stray_files', []))
    81	        tasks.append(dict(instance_id=row['instance_id'], repo=row.get('repo'),
    82	            setup_calls=[{key: call.get(key) for key in ('step', 'duration_s', 'rc', 'retrying_lines')}
    83	                         for call in row.get('setup_calls', [])],
    84	            **{key: row.get(key) for key in ('sandbox_setup_seconds', 'agent_clock_seconds',
    85	                'agent_timeout_fired', 'finalization_seconds', 'teardown_seconds',
    86	                'phase1_wall_seconds', 'phase1_source', 'error', 'agent_outcome', 'fallback_patch_used',
    87	                'image_emulation_seconds', 'setup_failed', 'editable_failed')},
    88	            phase1_minus_image_seconds=(row['phase1_wall_seconds'] - row['image_emulation_seconds']
    89	                if row.get('phase1_wall_seconds') is not None and row.get('image_emulation_seconds') is not None else None),
    90	            total=row['wall_seconds']['total'],
    91	            nonempty_source_diff=not row.get('empty_patch', True) and bool(source_files)))
    92	    def measured(key):
    93	        return numbers([r[key] for r in tasks if r[key] is not None])
    94	    phase1, setup = distribution(measured('phase1_wall_seconds')), distribution(measured('sandbox_setup_seconds'))
    95	    finalization = distribution(measured('finalization_seconds'))
    96	    # Dec 028 (a): harness errors only. Non-fatal setup results (setup_failed/editable_failed) and
    97	    # normal agent end states (timeout, no submit) are diagnostics, not gate failures. A Phase-1 value
    98	    # from the run_agent_sandbox fallback means the sandbox wrappers never fired: not complete.
    99	    def wrapped(r):
   100	        return r['phase1_wall_seconds'] is not None and r.get('phase1_source') != 'run_agent_sandbox'
   101	    complete = sum(r['error'] is None and wrapped(r) for r in tasks)
   102	    n_expected = len(header['task_ids'])
   103	    missing = [iid for iid in header['task_ids'] if iid not in ids]
   104	    nonempty = sum(t['nonempty_source_diff'] for t in tasks)
   105	    def check(passed, value, threshold):
   106	        return dict(status='PASS' if passed else 'FAIL', value=value, threshold=threshold)
   107	    all_phase1 = bool(tasks) and all(wrapped(r) for r in tasks)
   108	    gate = dict(n_expected=n_expected,
   109	        a_all_tasks_complete_no_harness_error=check(n_expected > 0 and complete == n_expected and not missing
   110	                                                    and not stopped and done is not None, complete, n_expected),
   111	        b_max_phase1=check(all_phase1 and phase1['max'] <= gate_max_phase1, phase1['max'], gate_max_phase1),
   112	        c_mean_phase1=check(all_phase1 and phase1['mean'] <= gate_mean_phase1, phase1['mean'], gate_mean_phase1),
   113	        d_vllm_seconds=check(startup is not None and startup <= gate_vllm_seconds, startup, gate_vllm_seconds),
   114	        e_nonempty_source_diff=check(nonempty >= gate_min_nonempty, nonempty, gate_min_nonempty))
   115	    gate['status'] = 'PASS' if all(v['status'] == 'PASS' for v in gate.values() if isinstance(v, dict)) else 'FAIL'
   116	    return dict(_schema='kaggle_timing_summary_v1',
   117	                fields=dict(n='Number of task rows (gate expected n)',
   118	                    n_complete_no_error='Rows with a sandbox-wrapper phase1 measurement and no harness error (setup_failed is diagnostic only)',
   119	                    provenance='Kernel header: git_sha, bundle_sha256, agent_yaml_sha256, gpu_names, gpu_count, caps, created_utc, concurrency, mcp_import_ok',
   120	                    agent_outcome_counts='Rows per agent_outcome (timeout/turns/tool_calls/no_submit/null)',
   121	                    setup_failed_count='Rows with a non-fatal setup rc!=0 (diagnostic, not gated)',
   122	                    editable_failed_count='Rows whose editable install returned rc!=0 (diagnostic, not gated)',
   123	                    image_emulation_seconds='Distribution of in-Phase-1 seconds emulating image layers the scorer image already has',
   124	                    phase1_minus_image_seconds='Distribution of phase1_wall_seconds minus image_emulation_seconds (not gated; reported for the Director)',
   125	                    fallback_invocations='Index-enabled editable fallback invocations across setup calls',
   126	                    retrying_lines_total='pip Retrying lines across setup calls, nested output counted once',
   127	                    tasks='Per-task instance_id, repo, setup_calls [{step,duration_s,rc,retrying_lines}], sandbox_setup_seconds, agent_clock_seconds, agent_timeout_fired, finalization_seconds, teardown_seconds, phase1_wall_seconds, total, error, nonempty_source_diff, fallback_patch_used; unavailable measurements are null',
   128	                    nonempty_source_diff='Nonblank classified patch with a path outside protected/test and stray files',
   129	                    phase1_seconds='Phase-1 wall seconds: mean/p50/p90/max of available measurements',
   130	                    setup_seconds='Setup S seconds: mean/p50/p90/max of available measurements',
   131	                    finalization_max_seconds='Maximum finalization seconds, or null',
   132	                    fallback_count='Index-enabled editable fallback invocations plus Retrying lines across setup calls, nested output counted once',
   133	                    tasks_with_retrying_lines='Task count with setup retrying_lines > 0',
   134	                    timeout_fired_count='Tasks whose observed agent timeout fired',
   135	                    fallback_patch_count='Tasks using a non-empty fallback patch',
   136	                    vllm_startup_seconds='Measured vLLM startup seconds',
   137	                    gate='a-e checks: PASS/FAIL, observed value, CLI threshold; overall status requires all checks',
   138	                    total_seconds='Total task wall seconds distribution',
   139	                    test_run_share='Agent test time share distribution', test_runs_per_task='Test request count distribution',
   140	                    empty_patch_count='Blank patches', test_files_edited_count='Tasks editing protected/test files',
   141	                    stray_files_count='Tasks adding stray files', test_files_edited_files='Total protected/test paths',
   142	                    stray_files_files='Total stray paths', decision='Legacy total-wall/cap projection check',
   143	                    projected_minutes='p90 total seconds times 125 plus vLLM, in minutes',
   144	                    cap_worst_case_minutes='Configured cap times 125 plus 30 minutes', cap_minutes='Configured agent cap',
   145	                    artifact_errors='Raw artifact write failures (diagnostic; rows unaffected)',
   146	                    missing_task_ids='Header task IDs absent from task rows', done_present='Journal contains _done', stopped='Journal stop reasons'),
   147	                tasks=tasks, gate=gate, n_complete_no_error=complete,
   148	                provenance={k: header.get(k) for k in ('git_sha', 'bundle_sha256', 'agent_yaml_sha256', 'gpu_names',
   149	                    'gpu_count', 'caps', 'created_utc', 'concurrency', 'mcp_import_ok')},
   150	                agent_outcome_counts=dict(Counter(str(t['agent_outcome']) for t in tasks)),
   151	                setup_failed_count=sum(bool(t['setup_failed']) for t in tasks),
   152	                editable_failed_count=sum(bool(t['editable_failed']) for t in tasks),
   153	                image_emulation_seconds=distribution(measured('image_emulation_seconds')),
   154	                phase1_minus_image_seconds=distribution(measured('phase1_minus_image_seconds')),
   155	                fallback_invocations=sum(fallback_invocations(c) for r in rows for c in r.get('setup_calls', [])),
   156	                retrying_lines_total=sum(retrying_lines(c) for r in rows for c in r.get('setup_calls', [])),
   157	                phase1_seconds=phase1, setup_seconds=setup, finalization_max_seconds=finalization['max'],
   158	                fallback_count=sum(setup_evidence(c) for r in rows for c in r.get('setup_calls', [])),
   159	                tasks_with_retrying_lines=sum(any(c.get('retrying_lines', 0) > 0 or
   160	                    any(s.get('retrying_lines', 0) > 0 for s in c.get('subprocesses', []))
   161	                    for c in r.get('setup_calls', [])) for r in rows),
   162	                fallback_patch_count=sum(bool(r.get('fallback_patch_used')) for r in rows),
   163	                timeout_fired_count=sum(bool(r.get('agent_timeout_fired')) for r in rows),
   164	                n=len(rows), vllm_startup_seconds=startup,
   165	                total_seconds=totals, test_run_share=shares, test_runs_per_task=runs,
   166	                empty_patch_count=sum(bool(r.get('empty_patch', True)) for r in rows),
   167	                test_files_edited_count=sum(bool(r.get('test_files_edited', [])) for r in rows),
   168	                stray_files_count=sum(bool(r.get('stray_files', [])) for r in rows),
   169	                test_files_edited_files=sum(len(r.get('test_files_edited', [])) for r in rows),
   170	                stray_files_files=sum(len(r.get('stray_files', [])) for r in rows),
   171	                decision='PASS' if timing_minutes is not None and cap_minutes is not None and timing_minutes <= 660 and cap_minutes <= 660 else 'FAIL',
   172	                projected_minutes=timing_minutes, cap_worst_case_minutes=cap_minutes,
   173	                cap_minutes=cap, missing_task_ids=missing,
   174	                done_present=done is not None, stopped=stopped, artifact_errors=artifact_errors)
