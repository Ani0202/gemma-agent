   262	def setup_step(current, name, action, *, fatal=True):
   263	    """Time setup steps and retain bounded output plus retry counts."""
   264	    start = time.perf_counter()
   265	    row = dict(step=name, start_offset_s=round(start-current['started'], 6),
   266	               duration_s=0.0, rc=None, stdout='', stderr='', retrying_lines=0)
   267	    current['setup_calls'].append(row)
   268	    try:
   269	        result = action()
   270	        row['rc'] = getattr(result, 'exit_code', getattr(result, 'returncode', 0))
   271	        setup_artifact(current, dict(step=name, stdout=getattr(result, 'stdout', '') or '',
   272	                                     stderr=getattr(result, 'stderr', '') or ''))
   273	        for field in ('stdout', 'stderr'):
   274	            value = getattr(result, field, '') or ''
   275	            row['retrying_lines'] += sum('Retrying' in line for line in value.splitlines())
   276	            row[field] = value.encode('utf-8', errors='replace')[-2048:].decode('utf-8', errors='ignore')
   277	        return result
   278	    except Exception as exc:
   279	        row.update(rc=-1, stderr=type(exc).__name__)
   280	        if fatal:
   281	            current['setup_failed'] = True
   282	            raise
   283	    finally:
   284	        row['duration_s'] = round(time.perf_counter()-start, 6)
   285	        current['retrying_lines'] = sum(c['retrying_lines'] for c in current['setup_calls'])
   286	        if fatal and row['rc'] != 0:
   287	            current['setup_failed'] = True
