   850	def distribution(values):
   851	    values = sorted(values)
   852	    def percentile(q):
   853	        x = (len(values) - 1) * q
   854	        lo = int(x)
   855	        return values[lo] + (values[min(lo + 1, len(values)-1)] - values[lo]) * (x-lo)
   856	    return dict(mean=sum(values)/len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))
