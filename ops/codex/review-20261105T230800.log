   106	def missing_tool_closure(wheels, tags=None, runtime=True):
   107	    """Mirror the sandbox tool_deps walk: compatible_wheels (wheelhouse, then embedded), then runtime copy.
   108	
   109	    tags default to the kernel interpreter's, which is the sandbox venv's interpreter on Kaggle.
   110	    """
   111	    from packaging.markers import default_environment
   112	    from packaging.requirements import Requirement
   113	    from packaging.tags import sys_tags
   114	    from packaging.utils import canonicalize_name, parse_wheel_filename
   115	    tags = [str(t) for t in sys_tags()] if tags is None else tags
   116	    extra = extra_wheels()
   117	    selected = compatible_wheels(wheels, tags)
   118	    roots = [wheel_metadata(selected[canonicalize_name(n)]) for n in SCORER_TOOLS
   119	             if n not in ('pip', 'pytest-timeout') and canonicalize_name(n) in selected]
   120	    timeout = [p for p in pytest_timeout_wheels(wheels)
   121	               if any(str(t) in tags for t in parse_wheel_filename(p.name)[3])]
   122	    roots.extend(wheel_metadata(p) for p in timeout[:1])
   123	    env, seen, missing, queue = dict(default_environment(), extra=''), set(), [], list(roots)
   124	    while queue:
   125	        metadata = queue.pop()
   126	        key = (canonicalize_name(metadata['Name']), metadata['Version'])
   127	        if key in seen:
   128	            continue
   129	        seen.add(key)
   130	        for raw in metadata.get_all('Requires-Dist', []):
   131	            req = Requirement(raw)
   132	            if req.marker and not req.marker.evaluate(env):
   133	                continue
   134	            name = canonicalize_name(req.name)
   135	            candidate = compatible_wheels(wheels, tags, req).get(name) or compatible_wheels(extra, tags, req).get(name)
   136	            if candidate:
   137	                queue.append(wheel_metadata(candidate))
   138	                continue
   139	            found = runtime_copyable(name) if runtime else None
   140	            if found is not None and found[0].version in req.specifier:
   141	                queue.append(found[0].metadata)
   142	            elif name not in missing:
   143	                missing.append(name)
   144	    return missing
