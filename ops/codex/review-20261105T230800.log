  1033	def gpu_preflight():
  1034	    """Raise WrongAccelerator unless nvidia-smi lists >= 4 L4 GPUs; skip if nvidia-smi is unavailable."""
  1035	    try:
  1036	        gpus = subprocess.run(['nvidia-smi', '-L'], capture_output=True, text=True, timeout=60).stdout.splitlines()
  1037	    except (OSError, subprocess.SubprocessError):
  1038	        return
  1039	    if len(gpus) < 4 or not all('L4' in g for g in gpus):
  1040	        raise WrongAccelerator('expected 4x L4 (nvidia-smi -L preflight)')
