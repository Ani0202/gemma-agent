   694	def observe_patch_strip(original, state):
   695	    """Retain the agent's diff before the harness removes protected edits."""
   696	    def strip(patch, *pos, **kw):
   697	        current = state.get(None)
   698	        filtered = original(patch, *pos, **kw)
   699	        if current is not None and current.get('agent_active'):
   700	            if patch != current.get('filtered_patch'):
   701	                current['raw_patch'] = patch
   702	            current['filtered_patch'] = filtered
   703	        return filtered
   704	    return strip
