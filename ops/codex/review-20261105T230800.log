   706	def test_run_stats(trace, agent_seconds):
   707	    pending, n, total = {}, 0, 0.0
   708	    for e in trace.entries if trace else []:
   709	        if e.event_type == 'tool_call':
   710	            command = (e.tool_args or {}).get('command', '')
   711	            is_test = e.tool_name == 'run_command' and any(s in command for s in ('pytest', 'unittest', 'tox', 'nox', 'run_tests'))
   712	            n += int(is_test)
   713	            pending.setdefault(e.tool_name, []).append((e.timestamp, is_test))
   714	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   715	            start, is_test = pending[e.tool_name].pop(0)
   716	            if is_test:
   717	                total += max(0.0, e.timestamp - start)
   718	    return dict(n=n, total_seconds=total, share_of_agent_seconds=total / agent_seconds if agent_seconds else None)
