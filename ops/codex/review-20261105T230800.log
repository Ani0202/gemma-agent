   178	def compatible_wheels(wheels, tags, requirement=None):
   179	    """Highest version per distribution, with sandbox PEP 425 tags (never host tags)."""
   180	    from packaging.utils import canonicalize_name, parse_wheel_filename
   181	    rank = {tag: i for i, tag in enumerate(tags)}
   182	    selected = {}
   183	    for path in sorted(Path(wheels).glob('*.whl')):
   184	        name, version, build, wheel_tags = parse_wheel_filename(path.name)
   185	        if requirement is not None and (name != canonicalize_name(requirement.name) or version not in requirement.specifier):
   186	            continue
   187	        matches = [rank[str(tag)] for tag in wheel_tags if str(tag) in rank]
   188	        if not matches:
   189	            continue
   190	        score = (version, -min(matches), build)
   191	        if name not in selected or score > selected[name][0]:
   192	            selected[name] = (score, path)
   193	    return {name: item[1] for name, item in selected.items()}
