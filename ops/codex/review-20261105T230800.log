   217	def inject_base(cs, wheels, destination, current):
   218	    from importlib.metadata import version
   219	    harness_version = version('swegemma')
   220	    row = current['setup_calls'][-1]
   221	    row.update(selected_wheels=sorted(p.name for p in wheels), harness_version=harness_version,
   222	               cache_key=base_cache_key(wheels, harness_version))
   223	    archive = cs._build_unpacked_wheels_tar(wheels, row['cache_key'], '.swegemma_base_injected')
   224	    with tarfile.open(archive) as tf:
   225	        members = tf.getmembers()
   226	        row['tar_member_count'] = len(members)
   227	        payload = [m for m in members if m.isfile() and
   228	                   Path(m.name).name not in ('', '.swegemma_base_injected')]
   229	        if wheels and not payload:
   230	            raise RuntimeError('Selected wheels but base tar contains only marker/empty entries')
   231	        tf.extractall(destination, filter='data')
