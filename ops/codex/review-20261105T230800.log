   149	    from packaging.utils import canonicalize_name, parse_wheel_filename
   150	    names = set()
   151	    for w in Path(wheels).glob('*.whl'):
   152	        try:
   153	            names.add(canonicalize_name(parse_wheel_filename(w.name)[0]))
   154	        except Exception:
   155	            continue
   156	    missing = [n for n in SCORER_TOOLS if n not in ('pip', 'pytest-timeout') and canonicalize_name(n) not in names]
   157	    if not pytest_timeout_wheels(wheels):
   158	        missing.append('pytest-timeout==2.1.0')
   159	    if fallback_wheel(wheels, 'pip') is None and runtime_copyable('pip') is None:  # same sources as bootstrap_pip
   160	        missing.append('pip')
