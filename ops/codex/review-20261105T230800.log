   344	def close_tool_dependencies(roots, wheels, tags, environment, destination, install_wheel):
   345	    """Walk runtime requirements only, using sandbox markers and no pip resolver.
   346	
   347	    Existing sandbox metadata describes base wheels and copied tools. Each requirement
   348	    edge is checked, while each installed distribution/version is expanded only once.
   349	    Missing edges are returned to the caller, which must fail setup.
   350	    """
   351	    from importlib.metadata import distributions, distribution, PackageNotFoundError
   352	    from packaging.requirements import Requirement
   353	    from packaging.utils import canonicalize_name, parse_wheel_filename
   354	    installed = {canonicalize_name(d.metadata['Name']): d.metadata
   355	                 for d in distributions(path=[str(destination)])}
   356	    queue = list(roots)
   357	    installed.update({canonicalize_name(m['Name']): m for m in queue})
   358	    sources = {name: 'runtime-site-packages:' + str(destination) for name in installed}
   359	    for path in compatible_wheels(wheels, tags).values():
   360	        name, version, _, _ = parse_wheel_filename(path.name)
   361	        if name in installed and installed[name]['Version'] == str(version):
   362	            sources[name] = str(path)
   363	    visited, entries, missing = set(), [], []
   364	    while queue:
   365	        metadata = queue.pop(0)
   366	        key = (canonicalize_name(metadata['Name']), metadata['Version'])
   367	        if key in visited:
   368	            continue
   369	        visited.add(key)
   370	        for raw in metadata.get_all('Requires-Dist', []):
   371	            req = Requirement(raw)
   372	            if req.marker and not req.marker.evaluate(dict(environment, extra='')):
   373	                continue
   374	            name = canonicalize_name(req.name)
   375	            current = installed.get(name)
   376	            row = dict(name=name, required_spec=str(req.specifier), requirement=raw,
   377	                       source='missing', version_installed=None)
   378	            if current is not None and current['Version'] in req.specifier:
   379	                row.update(source=sources.get(name, 'sandbox metadata'),
   380	                           version_installed=current['Version'])
   381	            else:
   382	                # Wheelhouse first, then the embedded official PyPI wheels (pip-installed like the image), then runtime copy.
   383	                candidate = compatible_wheels(wheels, tags, req).get(name) or compatible_wheels(extra_wheels(), tags, req).get(name)
   384	                current = None
   385	                if candidate:
   386	                    result = install_wheel(candidate)
   387	                    row['rc'] = result.exit_code
   388	                    for field in ('stdout', 'stderr'):
   389	                        row[field] = (getattr(result, field, '') or '').encode()[-2048:].decode(errors='ignore')
   390	                    if result.exit_code == 0:
   391	                        current = wheel_metadata(candidate)
   392	                        row['source'] = str(candidate)
   393	                else:
   394	                    try:
   395	                        runtime = distribution(name)
   396	                    except PackageNotFoundError:
   397	                        runtime = None
   398	                    if runtime is not None and runtime.version in req.specifier:
   399	                        source = copy_runtime_package(name, destination)
   400	                        if source != 'missing':
   401	                            current = runtime.metadata
   402	                            row['source'] = source
   403	                if current is not None:
   404	                    installed[name] = current
   405	                    sources[name] = row['source']
   406	                    row['version_installed'] = current['Version']
   407	            entries.append(row)
   408	            if current is not None:
   409	                queue.append(current)
   410	            elif name not in missing:
   411	                missing.append(name)
   412	    return entries, missing
