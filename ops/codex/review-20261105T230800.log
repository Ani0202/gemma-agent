   415	# Capture setup.py's otherwise discarded subprocess output without changing setup.py.
   416	# Write after EVERY call so an outer timeout still leaves completed calls visible.
   417	SETUP_OBSERVER = r'''import json, runpy, subprocess, sys, time
   418	from pathlib import Path
   419	original = subprocess.run
   420	calls = []
   421	log = Path(__file__).with_name('setup_subprocesses.json')
   422	log.write_text('[]')
   423	full_log = log.with_name('setup_subprocesses_full.jsonl')
   424	full_log.write_text('')
   425	def run(*args, **kwargs):
   426	    start = time.perf_counter()
   427	    argv = args[0] if args else kwargs.get('args')
   428	    result = None
   429	    try:
   430	        result = original(*args, **kwargs)
   431	        return result
   432	    except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as exc:
   433	        result = exc
   434	        raise
   435	    finally:
   436	        def decode(value):
   437	            return value.decode(errors='replace') if isinstance(value, bytes) else (value or '')
   438	        out, err = decode(getattr(result, 'stdout', '')), decode(getattr(result, 'stderr', ''))
   439	        with full_log.open('a') as stream:
   440	            stream.write(json.dumps(dict(argv=argv, stdout=out, stderr=err)) + '\n')
   441	        calls.append(dict(argv=argv, duration_s=time.perf_counter()-start,
   442	            start_offset_s=start-origin, rc=getattr(result, 'returncode', None),
   443	            stdout=out.encode()[-2048:].decode(errors='ignore'),
   444	            stderr=err.encode()[-2048:].decode(errors='ignore'),
   445	            retrying_lines=sum('Retrying' in line for line in (out+'\n'+err).splitlines()),
   446	            interpreter_version=sys.version))
   447	        log.write_text(json.dumps(calls))
   448	origin = time.perf_counter()
   449	subprocess.run = run
   450	sys.argv = sys.argv[1:]
   451	runpy.run_path(sys.argv[0], run_name='__main__')
   452	'''
   453	
   454	
   455	def patch_subprocess_deps(data_dir, state=None):
   456	    """Install scorer tools in each venv, using that interpreter's ABI, entirely offline."""
   457	    import swegemma.harness.container_setup as cs
