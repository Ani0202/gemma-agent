   826	AGENT_OUTCOMES = (('timeout', re.compile(r'Agent exceeded session timeout\b')),
   827	                  ('turns', re.compile(r'Agent exceeded (turns budget|maximum allowed LLM turns)\b')),
   828	                  ('tool_calls', re.compile(r'Agent exceeded tool call budget\b')),
   829	                  ('no_submit', re.compile(r'Agent completed execution without calling submit_patch\b')))
   830	IMAGE_EMULATION_STEPS = ('venv_fidelity', 'pip_bootstrap', 'interpreter_probe', 'tool_sources',
   831	                         'pytest_timeout_source', 'tool_install', 'tool_deps', 'pip_check')
