   100	def pytest_timeout_wheels(wheels):
   101	    """Wheelhouse pytest-timeout 2.1.0 first, then the embedded official wheel."""
   102	    return [*sorted(Path(wheels).glob('pytest_timeout-2.1.0-*.whl')),
