   805	def phase1_fields(current, run_seconds, total, context, patch):
   806	    def difference(end, start):
   807	        return current[end] - current[start] if current.get(end) is not None and current.get(start) is not None else None
   808	    phase1 = difference('sandbox_stop_end', 'sandbox_start_begin')
   809	    source = 'sandbox_wrappers' if phase1 is not None else 'run_agent_sandbox'
   810	    phase1 = run_seconds if phase1 is None else phase1
   811	    submitted = bool(context.patch_submitted) if context is not None else None
   812	    return dict(agent_timeout_seconds=current.get('agent_timeout_seconds'),
   813	        agent_clock_seconds=difference('timeout_exit', 'timeout_enter'),
   814	        agent_timeout_fired=current.get('agent_timeout_fired'),
   815	        finalization_seconds=difference('sandbox_stop_end', 'timeout_exit'),
   816	        finalization_exec=current.get('finalization_exec', []),
   817	        teardown_seconds=current.get('sandbox_stop_duration'),
   818	        phase1_wall_seconds=phase1, phase1_source=source,
   819	        pre_agent_seconds=difference('timeout_enter', 'sandbox_start_begin'),
   820	        post_phase1_seconds=total - phase1, patch_submitted=submitted,
   821	        fallback_patch_used=(not submitted and bool(patch.strip())) if submitted is not None else None,
