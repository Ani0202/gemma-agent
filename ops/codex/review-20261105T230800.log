   513	                     "from pip._vendor.packaging.markers import default_environment;"
   514	                     "print(json.dumps({'version':sys.version,'tags':[str(t) for t in sys_tags()],"
   515	                     "'environment':default_environment()}))")
   516	            result = setup_step(current, 'interpreter_probe', lambda: docker.exec(
   517	                container_id, 'python3 -c ' + shlex.quote(probe), timeout=30))
