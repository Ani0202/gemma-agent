   724	class AsyncioTimingProxy:
   725	    """Observe only agent_runner's timeout context, without changing asyncio itself."""
   726	    def __init__(self, original, state):
   727	        self._original, self._state = original, state
   728	
   729	    def __getattr__(self, name):
   730	        return getattr(self._original, name)
   731	
   732	    def timeout(self, *args, **kwargs):
   733	        cm = self._original.timeout(*args, **kwargs)
   734	        state = self._state
   735	        delay = args[0] if args else kwargs.get('delay')
   736	
   737	        class ObservedTimeout:
   738	            async def __aenter__(self):
   739	                self.current = state.get(None)
   740	                if self.current is not None:
   741	                    self.current.update(agent_timeout_seconds=delay, timeout_enter=time.perf_counter())
   742	                return await cm.__aenter__()
   743	
   744	            async def __aexit__(self, *exc_info):
   745	                exit_exc = exc_info[1]
   746	                try:
   747	                    return await cm.__aexit__(*exc_info)
   748	                except BaseException as exc:
   749	                    exit_exc = exc
   750	                    raise
   751	                finally:
   752	                    if self.current is not None:
   753	                        self.current.update(timeout_exit=time.perf_counter(),
   754	                            agent_timeout_fired=bool(getattr(cm, 'expired', lambda: False)())
   755	                                or isinstance(exit_exc, TimeoutError))
   756	
   757	        return ObservedTimeout()
   758	
   759	
   760	def observe_sandbox(original, state, name):
   761	    """Forward identical arguments/results/exceptions and time sandbox boundaries."""
   762	    async def observed(*args, **kwargs):
   763	        current = state.get(None)
   764	        start = time.perf_counter()
   765	        row = None
   766	        if current is not None:
   767	            if name == 'sandbox_start':
   768	                current['sandbox_start_begin'] = start
   769	            elif name == 'sandbox_exec' and current.get('timeout_exit') is not None:
   770	                cmd = args[2] if len(args) > 2 else kwargs.get('command', kwargs.get('cmd', ''))
   771	                row = dict(cmd=str(cmd)[:40], duration_s=None, rc=None)
   772	                current.setdefault('finalization_exec', []).append(row)
   773	        try:
   774	            result = await original(*args, **kwargs)
   775	            if row is not None:
   776	                row['rc'] = getattr(result, 'exit_code', None)
   777	            return result
   778	        except BaseException as exc:
   779	            if row is not None:
   780	                row['exception'] = type(exc).__name__
   781	            raise
   782	        finally:
   783	            end = time.perf_counter()
   784	            if current is not None:
   785	                if name in ('sandbox_start', 'sandbox_stop'):
   786	                    current[name + '_end'] = end
   787	                    current[name + '_duration'] = end - start
   788	                if row is not None:
   789	                    row['duration_s'] = end - start
   790	    return observed
