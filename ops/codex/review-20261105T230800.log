   234	def record_distributions(docker, container_id, repo, row):
   235	    # Query the same interpreter and metadata selection pip uses, never host metadata.
   236	    package = repo.rsplit('/', 1)[-1].lower()
   237	    probe = """import json
   238	from importlib.metadata import distribution, PackageNotFoundError
   239	names = NAMES
   240	result = {}
   241	for name in names:
   242	    try:
   243	        d = distribution(name)
   244	        result[name] = dict(location=str(d.locate_file('')), version=d.version,
   245	                            metadata_location=str(d._path), record_exists=d.read_text('RECORD') is not None)
   246	    except PackageNotFoundError:
   247	        result[name] = dict(location=None, version=None, metadata_location=None, record_exists=False)
   248	print(json.dumps(result))
   249	""".replace('NAMES', repr([package]))
   250	    # Diagnostic only: a probe problem must never change the harness path.
   251	    try:
   252	        result = docker.exec(container_id, 'python3 -c ' + shlex.quote(probe), timeout=30)
   253	        row['dist_probe_rc'] = result.exit_code
   254	        if result.exit_code != 0:
   255	            row['dist_probe_error'] = 'rc'
   256	            return
   257	        row['distributions'] = json.loads(result.stdout)
   258	    except Exception as exc:
   259	        row['dist_probe_error'] = type(exc).__name__
