   336	def wheel_metadata(path):
   337	    from email.parser import BytesParser
   338	    import zipfile
   339	    with zipfile.ZipFile(path) as archive:
   340	        name = next(n for n in archive.namelist() if n.endswith('.dist-info/METADATA'))
   341	        return BytesParser().parsebytes(archive.read(name))
