#!/usr/bin/env python3
"""Validate a declarative Gemma bundle; optionally build dist/<track>-<version>.zip.

Without PyYAML, a conservative YAML subset is supported: block mappings/lists,
quoted/plain scalars, JSON flow collections, literal/folded blocks and !include.
Unsupported YAML syntax fails closed with a request to use PyYAML.
"""
import argparse
import hashlib
import json
import math
import os
from pathlib import Path, PureWindowsPath
import re
import shutil
import stat
import sys
import tempfile
import zipfile

try:
    import yaml
except ImportError:
    yaml = None

LIMIT = 3221225472
EXTENSIONS = {'.yaml', '.yml', '.md', '.txt', '.py', '.json', '.safetensors'}
MODELS = {f'gemma-4-{size}-it-qat-w4a16-ct' for size in ('31b', '12b', 'e4b', 'e2b')}
# Snapshot of HARNESS_README sections 2.4 and 6 (SwegemmaContext.create_tools).
TOOLS = {'run_command', 'submit_patch', 'get_status', 'read_file', 'edit_file',
         'write_file', 'get_code_neighbors', 'search_similar_code', 'get_code_subgraph'}
GENERATION_FIELDS = {'temperature', 'top_p', 'top_k', 'max_output_tokens',
                     'presence_penalty', 'frequency_penalty', 'stop_sequences',
                     'response_mime_type', 'seed', 'thinking_config'}
MAX_FILE_COUNT = 10000
MAX_YAML_FILES = 1000
MAX_YAML_BYTES = 50 * 1024 * 1024
MAX_SKILL_BYTES = 50 * 1024 * 1024
MAX_INSTRUCTION_CHARS = 1000000
MAX_TOTAL_INSTRUCTION_CHARS = 10000000
MAX_AGENTS = 500
MAX_DEPTH = 50
MAX_SKILLS = 1000
ROOTS = {'agent.yaml', 'agent.yml', 'root_agent.yaml', 'root_agent.yml'}


class Invalid(ValueError):
    pass


def require(condition, message):
    if not condition:
        raise Invalid(message)


def safe_path(value):
    require(isinstance(value, str) and value and '\0' not in value,
            'path must be a nonempty string without null bytes')
    parts = value.replace('\\', '/').split('/')
    require(not value.startswith(('/', '\\')) and not PureWindowsPath(value).drive
            and '..' not in parts, f'unsafe path: {value!r} (absolute or ..)')
    return value


def minimal_yaml(source, include):
    """Small fail-closed parser, deliberately not a general YAML implementation."""
    lines = source.splitlines()

    def scalar(text):
        text = text.strip()
        if text.startswith('!include '):
            return include(scalar(text[9:]))
        if text.startswith(('"', "'")):
            # YAML single quotes escape by doubling; double quotes use JSON escapes.
            try:
                if text.startswith('"'):
                    return json.loads(text)
                require(text.endswith("'"), 'unterminated YAML quote')
                return text[1:-1].replace("''", "'")
            except (ValueError, SyntaxError) as exc:
                raise Invalid(f'invalid quoted YAML scalar: {text}') from exc
        text = re.split(r'\s+#', text, maxsplit=1)[0].rstrip()
        if text.startswith(('[', '{')):
            try:
                return json.loads(text)

