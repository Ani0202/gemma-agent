   208	def _extract_test_functions_from_patch(test_patch: str) -> list[str]:
   209	    """Extract added or modified test_* function names from a unified diff test_patch."""
   210	    if not test_patch:
   211	        return []
   212	    added = re.findall(
   213	        r'^\+\s*(?:async\s+)?def\s+(test_[A-Za-z0-9_]+)\s*\(',
   214	        test_patch,
   215	        re.MULTILINE,
   216	    )
   217	    if added:
   218	        return list(dict.fromkeys(added))
   219	    removed = set(
   220	        re.findall(
   221	            r'^-\s*(?:async\s+)?def\s+(test_[A-Za-z0-9_]+)\s*\(',
   222	            test_patch,
   223	            re.MULTILINE,
   224	        )
   225	    )
   226	    hunk_headers = re.findall(
   227	        r'^@@[^@]+@@\s*(?:async\s+)?def\s+(test_[A-Za-z0-9_]+)\b',
   228	        test_patch,
   229	        re.MULTILINE,
   230	    )
   231	    context_defs = re.findall(
   232	        r'^ \s*(?:async\s+)?def\s+(test_[A-Za-z0-9_]+)\s*\(',
   233	        test_patch,
   234	        re.MULTILINE,
   235	    )
   236	    context_set = set(context_defs)
   237	    combined = list(dict.fromkeys(hunk_headers + context_defs))
   238	    return [
   239	        fn
   240	        for fn in combined
   241	        if fn not in removed
   242	        and not (
   243	            fn not in context_set
   244	            and (
   245	                any(r.startswith(fn) for r in removed)
   246	                or any(c != fn and c.startswith(fn) for c in context_set)
   247	            )
   248	        )
   249	    ]
