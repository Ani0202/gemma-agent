   474	def write_zip(bundle, dist):
   475	    track, version = bundle.root.parent.name, bundle.root.name
   476	    require(re.fullmatch(r'[A-Za-z0-9_-]+', track) and re.fullmatch(r'[A-Za-z0-9_-]+', version), 'invalid track/version for archive name')
   477	    dist.mkdir(parents=True, exist_ok=True)
