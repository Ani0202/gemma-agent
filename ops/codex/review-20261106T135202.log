    32	GENERATION_FIELDS = {'temperature', 'top_p', 'top_k', 'max_output_tokens',
    33	                     'presence_penalty', 'frequency_penalty', 'stop_sequences',
    34	                     'response_mime_type', 'seed', 'thinking_config'}
    35	MAX_FILE_COUNT = 10000
    36	MAX_YAML_FILES = 1000
    37	MAX_YAML_BYTES = 50 * 1024 * 1024
    38	MAX_SKILL_BYTES = 50 * 1024 * 1024
    39	MAX_INSTRUCTION_CHARS = 1000000
    40	MAX_TOTAL_INSTRUCTION_CHARS = 10000000
    41	MAX_AGENTS = 500
    42	MAX_DEPTH = 50
    43	MAX_SKILLS = 1000
    44	ROOTS = {'agent.yaml', 'agent.yml', 'root_agent.yaml', 'root_agent.yml'}
