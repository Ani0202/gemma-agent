    row = dict(instance_id='a', setup_fix=0, setup_s_total=30, editable_rc=1, retrying_lines=0,
               setup_failed=False, setup_subprocesses=[dict(argv=['python', '-m', 'pip', '-e'],
               rc=1, stderr_full='ERROR: No module named pip')])
    def write(rows):
