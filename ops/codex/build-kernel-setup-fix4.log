to results/plan003_kernel_setup_acceptance.json, including per-step durations and
full observed pip errors. bwrap --unshare-net is mandatory; no PIP_* overrides,
venv monkeypatching, model, agent, verification, downloads, or holdout access.
"""
import argparse
from contextvars import ContextVar
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--data-dir', type=Path, default=Path('/home/ubuntu/work/gemma/data/raw'))
    parser.add_argument('--wheels-dir', type=Path)
    parser.add_argument('--output', type=Path, default=Path('results/plan003_kernel_setup_acceptance.json'))
    parser.add_argument('--setup-fix', choices=('0', '1'))
    parser.add_argument('--inside-bwrap', action='store_true', help=argparse.SUPPRESS)
    args = parser.parse_args()
    args.output.parent.mkdir(parents=True, exist_ok=True)
    identity = dict(_schema='plan003_kernel_setup_acceptance_v1',
                    script='eval/repro/plan003_kernel_setup.py',
                    local_data_dir=str(args.data_dir.resolve()),
                    task_ids=['rich_3006', 'fastapi_14986'],
                    setup_fix_modes=[int(args.setup_fix)] if args.setup_fix else [0, 1])
    if not args.inside_bwrap:
        command = ['bwrap', '--dev-bind', '/', '/', '--unshare-net', sys.executable,
                   str(Path(__file__).resolve()), *sys.argv[1:], '--inside-bwrap']
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode and 'bwrap:' in result.stderr:
            args.output.write_text(json.dumps(dict(**identity, status='blocked', rc=result.returncode,
                stderr=result.stderr[-2048:], rows=[]), indent=2) + '\n')
        print(result.stdout, end='')
        print(result.stderr, end='', file=sys.stderr)
        return result.returncode
    os.environ['LITELLM_LOCAL_MODEL_COST_MAP'] = 'True'
    spec = importlib.util.spec_from_file_location('timing', Path(__file__).parents[1] / 'kaggle/agent_timing.py')
    timing = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(timing)
    state = ContextVar('acceptance')
    rows = []
    with tempfile.TemporaryDirectory(prefix='kernel-setup-') as temp:
        root = Path(temp)
        wheels = (args.wheels_dir or args.data_dir / 'wheels').resolve()
        (root / 'wheels').symlink_to(wheels)
        (root / 'sandbox').symlink_to((args.data_dir / 'sandbox').resolve())
        (root / 'snapshots').symlink_to((args.data_dir / 'snapshots').resolve())
        for mode in [args.setup_fix] if args.setup_fix else ['0', '1']:
            os.environ['SETUP_FIX'] = mode
            for iid, repo in [('rich_3006', 'Textualize/rich'), ('fastapi_14986', 'fastapi/fastapi')]:
                row = timing.setup_task(root, wheels, iid, repo, state)
                rows.append(row)
                print(json.dumps(dict(instance_id=iid, setup_fix=int(mode),
                    steps={c['step']: c['duration_s'] for c in row['setup_calls']},
                    editable_rc=row['editable_rc'], retrying_lines=row['retrying_lines'])), flush=True)
    # The unfixed mode is diagnostic; only fixed rows must pass the setup gate.
    fixed = [r for r in rows if r['setup_fix'] == 1]
    passed = all(not r['setup_failed'] and r['editable_rc'] == 0 and
                 r['retrying_lines'] == 0 and r['setup_s_total'] <= 30 for r in fixed)
    args.output.write_text(json.dumps(dict(**identity, status='passed' if passed else 'failed', rows=rows), indent=2) + '\n')
    return int(not passed)


if __name__ == '__main__':
    raise SystemExit(main())
"""Summarize a CPU setup journal without dropping failures or missing task IDs."""
import argparse
import json
from pathlib import Path


def diagnose(row):
    calls = [c for c in row.get('setup_subprocesses', [])
             if isinstance(c.get('argv'), list) and '-e' in c['argv']]
    if not calls:
        return dict(cause='unobserved', evidence=[])
    first = calls[0]
    if first['rc'] == 0:
        return dict(cause='offline_install_succeeded', evidence=[])
    output = first.get('stdout_full', first.get('stdout', '')) + '\n' + first.get('stderr_full', first.get('stderr', ''))
    lower = output.lower()
    if 'no module named pip' in lower:
        cause = 'pip_absent_in_venv'
    elif any(s in lower for s in ('backendunavailable', 'cannot import', 'no module named', 'backend is not available')):
        cause = 'build_backend_absent_in_venv'
    elif any(s in lower for s in ('not a supported wheel', 'no matching distribution', 'could not find a version')):
        cause = 'wheel_or_abi_failure_stop_and_report'
    else:
        cause = 'unresolved_offline_install_failure'
    evidence = [line for line in output.splitlines() if any(s in line.lower() for s in
                ('error', 'no module named', 'cannot import', 'backendunavailable', 'not a supported wheel'))]
    return dict(cause=cause, evidence=evidence[-12:])


def summarize(path):
    records = [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
    header = records[0]
    if header.get('_schema') != 'kaggle_setup_cpu_check_v1':
        raise ValueError('Unexpected journal schema')
    rows = [r for r in records if 'instance_id' in r]
    ids = [r['instance_id'] for r in rows]
    expected = header['task_ids']
    complete = bool(expected) and len(set(ids)) == len(ids) and sorted(ids) == sorted(expected)
    done = [r['_done']['n'] for r in records if '_done' in r]
    complete = complete and done == [len(expected)] and not any('_stopped' in r for r in records)
    for row in rows:
        if row['setup_fix'] == 0:
            row['offline_install_diagnosis'] = diagnose(row)
    gates = dict(complete=complete,
                 per_task_setup_le_30s=all(isinstance(r.get('setup_s_total'), (float, int)) and
                                          0 <= r['setup_s_total'] <= 30 for r in rows),
                 editable_rc_zero=all(r.get('editable_rc') == 0 for r in rows),
                 zero_retrying_lines=all(r.get('retrying_lines') == 0 for r in rows),
                 no_setup_failures=all(not r.get('setup_failed', True) for r in rows))
    return dict(_schema='kaggle_setup_cpu_check_v1', task_ids=expected, n=len(rows),
                rows=rows, gates=gates, decision='PASS' if all(gates.values()) else 'FAIL')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('journal', type=Path)
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    text = json.dumps(summarize(args.journal), indent=2) + '\n'
    if args.output:
        args.output.write_text(text)
    else:
        print(text, end='')


if __name__ == '__main__':
    main()

