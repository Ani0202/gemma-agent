import sys,json,math,hashlib
from pathlib import Path
sys.path.insert(0,'eval')
import plan008_arm2_summary as w
rows=w.base.load_rows(w.ARM2_RUN)
clocks=[r['agent_clock_seconds'] for r in rows]
wall=sorted(r['wall_seconds']['total'] for r in rows)
i=(len(wall)-1)*.9; p90=wall[math.floor(i)]+(wall[math.ceil(i)]-wall[math.floor(i)])*(i-math.floor(i))
print('raw agent clock max',max(clocks),'raw over cap',[(r['instance_id'],r['agent_clock_seconds']) for r in rows if r['agent_clock_seconds']>210])
print('raw total_wall p90',p90)
print('stray rows',[(r['instance_id'],r.get('stray_files')) for r in rows if r.get('stray_files')])
print('missing safety fields',[(r['instance_id'],k) for r in rows for k in ('test_files_edited','stray_files','agent_clock_seconds') if k not in r or r[k] is None])
print('rounding repro',w.base.pct([210.04],1.0), w.base.pct([210.04],1.0)<=210)
print('null repro',w.base.pct([None],1.0),(w.base.pct([None],1.0) or 0)<=210)
for path in [*w.ARM1_RUNS,w.ARM2_RUN]:
 rec=[json.loads(x) for x in Path(path).read_text().splitlines() if x.strip()]
 print('run metadata',path,[{k:r[k] for k in ('_schema','_done','concurrency','git_sha','agent_yaml_sha256') if k in r} for r in rec if 'instance_id' not in r])
print('sign-test cases',[(a,b,w.sign_test_two_sided(a,b)) for a,b in [(0,0),(4,0),(0,4),(6,0),(3,3),(7,1)]])
