   562	def arm2_metrics(run_dir):
   563	    timing = Path(run_dir) / 'timing.jsonl'
   564	    paths, rows, inputs = [timing], [], []
   565	    for row in base.load_rows(timing):
   566	        artifacts = _artifacts(run_dir, row['instance_id'])
   567	        trace = artifacts / 'trace.json'
   568	        if trace.is_file():
   569	            paths.append(trace)
   570	        entries = json.loads(trace.read_text()).get('entries', []) if trace.is_file() else []
   571	        inputs.append((row, entries, artifacts))
   572	    # Builtin responses carry patch_size; gate requests carry request, children
   573	    # have author submit_patch. Header/directory labels cover runs with no calls.
   574	    headers = [json.loads(line) for line in timing.read_text().splitlines() if line.strip()
   575	               and 'instance_id' not in json.loads(line)]
   576	    inv = inventory([row['instance_id'] for row, _, _ in inputs], expected_ids('arm2'))
   577	    if not inv['complete']:
   578	        raise IncompleteRun(inv)
   579	    bundle, bundle_source = selected_bundle(headers)
   580	    gate_events = (any(
   581	        e.get('author') == 'submit_patch' or
   582	        (e.get('author') == ROOT and e.get('tool') == 'submit_patch' and
   583	         (isinstance(e.get('args'), dict) and 'request' in e['args'] or
   584	          _reply(e.get('result')) in ('SUBMITTED', BOUNCE)))
   585	        for _, entries, _ in inputs for e in entries))
   586	    has_gate = bundle == 'v010' if bundle else gate_events
   587	    if not has_gate:
   588	        bad = [row['instance_id'] for row, entries, _ in inputs if nonroot_submit_responses(entries)]
   589	        if bad:
   590	            raise GateResponseInBuiltinRun(dict(rows=bad, selected_bundle=bundle))
   591	    for row, entries, artifacts in inputs:
   592	        rep = identical_runs_root(entries)
   593	        desc = gate_descriptives(entries, row) if has_gate else {}
   594	        desc.pop('gate_run_cmds', None)
   595	        if has_gate:
   596	            # D72's untracked-only descriptive requires a canonical acknowledgement;
   597	            # the D73 SAFETY boundary below needs only an inner harness capture.
   598	            acknowledged = any(g['canonical_reply'] == 'SUBMITTED' for g in gate_invocations(entries))
   599	            desc['untracked_only_submits'] = None if acknowledged else False
   600	            if acknowledged:
   601	                result = artifacts / 'result.json'
   602	                if not result.is_file():
   603	                    result = artifacts / 'output.json'
   604	                scored = None
   605	                if result.is_file():
   606	                    paths.append(result)
   607	                    scored = json.loads(result.read_text()).get('agent_patch')
   608	                patch = artifacts / 'agent.patch'
   609	                if scored is None and patch.is_file():
   610	                    paths.append(patch)
   611	                    try:
   612	                        from swegemma.harness.verification import strip_protected_files_from_patch
   613	                        tasks_path = _tasks_path()
   614	                        if tasks_path.is_file():
   615	                            paths.append(tasks_path)
   616	                        tests = load_task_test_files(tasks_path)[row['instance_id']]
   617	                        scored = strip_protected_files_from_patch(patch.read_bytes().decode('utf-8'), extra_protected_paths=tests)
   618	                    except Exception:
   619	                        scored = None
   620	                if isinstance(scored, str):
   621	                    desc['untracked_only_submits'] = untracked_only(scored)
   622	        else:
   623	            desc = dict.fromkeys((*GATE_COUNTS, 'gate_internal_visible'), 'n/a (no gate)')
   624	        rows.append(dict(instance_id=row['instance_id'], **rep, mechanism2=rep['max_run'] >= 5,
   625	                         mechanism1_empty=row.get('verified_patch_bytes') == 0,
   626	                         submitted_without_test=submitted_without_test(entries, has_gate),
   627	                         **submit_evidence(row, entries, has_gate, (artifacts / 'trace.json').is_file()), **desc))
   628	    for r, (_, entries, _) in zip(rows, inputs):
   629	        d735_counts(r, entries)
   630	    totals = dict(mechanism2=sum(r['mechanism2'] for r in rows),
   631	                  mechanism1_empty=sum(r['mechanism1_empty'] for r in rows),
   632	                  # D73.5 (ship-rule numbers): unverifiable rows count against arm 2.
   633	                  submitted_without_test=sum(r['swt_d735'] for r in rows),
   634	                  count_no_successful_submit=sum(r['no_submit_d735'] for r in rows),
   635	                  submitted_without_test_observed=sum(r['submitted_without_test'] is True for r in rows),
   636	                  count_no_successful_submit_observed=sum(r['submitted_without_test'] is None for r in rows),
   637	                  max_run=max((r['max_run'] for r in rows), default=0),
   638	                  runs_ge3=sum(r['runs_ge3'] for r in rows), runs_ge5=sum(r['runs_ge5'] for r in rows),
   639	                  repeated_calls=sum(r['repeated_calls'] for r in rows),
   640	                  submit_unverifiable=sum(r['submit_unverifiable'] for r in rows))
   641	    for key in GATE_COUNTS:
   642	        totals[key] = (sum(r[key] for r in rows if r[key] is not None) if has_gate else 'n/a (no gate)')
   643	    totals['untracked_only_unverifiable'] = sum(r.get('untracked_only_submits') is None for r in rows) if has_gate else 'n/a (no gate)'
   644	    return dict(_schema=_schema('arm2', paths), n_rows=len(rows), inventory=inv,
   645	                selected_bundle=bundle, selected_bundle_source=bundle_source,
   646	                gate_layout=has_gate, gate_events_observed=gate_events,
   647	                bundle_identity_conflict=bundle is not None and gate_events != has_gate,
