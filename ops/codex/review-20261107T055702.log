   101	def identical_runs(trace_path):
   102	    """Dec 060 metric: runs of consecutive tool_call entries with the same tool + byte-identical args
   103	    (plan005_armE_compare.max_identical_run key). Returns max run, number of runs >= 3 / >= 5, and
   104	    total repeated calls = sum over runs of (length - 1)."""
   105	    d = json.loads(Path(trace_path).read_text())
   106	    lens, cur, prev = [], 0, object()
   107	    for e in d.get('entries') or []:
   108	        if e.get('type') != 'tool_call':
   109	            continue
   110	        key = (e.get('tool'), json.dumps(e.get('args', e.get('arguments')), sort_keys=True))
   111	        if key == prev:
   112	            cur += 1
   113	        else:
   114	            if cur:
   115	                lens.append(cur)
   116	            cur = 1
   117	        prev = key
   118	    if cur:
   119	        lens.append(cur)
   120	    tools = [k[0] for k in keys_of_max(d)]
   121	    return dict(max_run=max(lens, default=0), max_run_tool=tools[0] if tools else None, runs_ge3=sum(x >= 3 for x in lens),
   122	                runs_ge5=sum(x >= 5 for x in lens), repeated_calls=sum(x - 1 for x in lens))
