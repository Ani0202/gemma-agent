   123	if __name__ == "__main__":
   124	    main(*sys.argv[1:5])
     1	#!/usr/bin/env python3
     2	"""Validate a declarative Gemma bundle; optionally build dist/<track>-<version>.zip.
     3	
     4	Without PyYAML, a conservative YAML subset is supported: block mappings/lists,
     5	quoted/plain scalars, JSON flow collections, literal/folded blocks and !include.
     6	Unsupported YAML syntax fails closed with a request to use PyYAML.
     7	"""
