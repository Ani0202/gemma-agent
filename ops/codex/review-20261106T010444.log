    26	LIMIT = 3221225472
    27	EXTENSIONS = {'.yaml', '.yml', '.md', '.txt', '.py', '.json', '.safetensors'}
    28	MODELS = {f'gemma-4-{size}-it-qat-w4a16-ct' for size in ('31b', '12b', 'e4b', 'e2b')}
    29	# Snapshot of HARNESS_README sections 2.4 and 6 (SwegemmaContext.create_tools).
    30	TOOLS = {'run_command', 'submit_patch', 'get_status', 'read_file', 'edit_file',
    31	         'write_file', 'get_code_neighbors', 'search_similar_code', 'get_code_subgraph'}
    32	GENERATION_FIELDS = {'temperature', 'top_p', 'top_k', 'max_output_tokens',
    33	                     'presence_penalty', 'frequency_penalty', 'stop_sequences',
    34	                     'response_mime_type', 'seed', 'thinking_config'}
    35	MAX_FILE_COUNT = 10000
    36	MAX_YAML_FILES = 1000
    37	MAX_YAML_BYTES = 50 * 1024 * 1024
    38	MAX_SKILL_BYTES = 50 * 1024 * 1024
    39	MAX_INSTRUCTION_CHARS = 1000000
