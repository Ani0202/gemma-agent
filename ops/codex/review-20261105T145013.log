   178	def patch_subprocess_deps(data_dir):
   179	    """Emulate the docker-only dependency setup for the subprocess sandbox (swegemma skips it).
   180	
   181	    Contract (swegemma 0.2.11 container_setup): for docker, _ensure_container_site_packages
   182	    unpacks every deduplicated (highest-version, py313-compatible) wheel from wheels_dir that is
   183	    < 20 MB and not in skip_base_pkgs (pytest, pluggy, ... come from the image) straight into
   184	    site-packages, no resolver; large wheels are added only if imported by the workspace; then
   185	    sandbox/setup.py runs with --fast-path. We replicate exactly that inside the sandbox venv.
   186	    The sandbox venv uses system_site_packages=True, so the HOST python must mirror the image
   187	    (Dockerfile.public: pytest, pytest-timeout==2.1.0, typer, build backends; nothing else).
   188	    """
   189	    import tarfile
   190	    import swegemma.harness.container_setup as cs
   191	    import swegemma.harness.verification as vf
   192	    import swegemma.harness.sample_verification  # load all known by-name bindings
   193	    import swegemma.evaluate
   194	    import swegemma.cli
   195	    import swegemma.harness.agent_runner
   196	    orig = cs.install_test_dependencies
   197	    wheels_src = Path(data_dir) / 'wheels'
   198	    if not wheels_src.is_dir():
   199	        wheels_src = WHEELHOUSE
   200	    setup_py = Path(data_dir) / 'sandbox' / 'setup.py'
   201	    if not setup_py.exists():
   202	        setup_py = next(iter(Path(data_dir).rglob('setup.py')), setup_py)  # competition sandbox/setup.py
   203	
   204	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   205	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   206	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   207	        venv_dir = docker.sandboxes[container_id]['venv']
   208	        sp_dir = next(iter(sorted(venv_dir.glob('lib/python3*/site-packages'))))
   209	        base_wheels, large_wheels, _m2p, _req = cs._inspect_wheels_dir(wheels_src)
   210	        selected = list(base_wheels)
   211	        if large_wheels:  # public wheels have none; fail loudly rather than silently diverge
   212	            raise RuntimeError('large wheels present; workspace-import scan not emulated')
   213	        tar_path = cs._build_unpacked_wheels_tar(selected, 'sp_base_local', '.swegemma_base_injected')
   214	        with tarfile.open(tar_path) as tf:
   215	            tf.extractall(sp_dir, filter='data')
   216	        docker.copy_to(container_id, setup_py, '/tmp/setup.py')
   217	        flag = '--fast-path' if fast_path else ''
   218	        docker.exec(container_id, f'python3 /tmp/setup.py {flag} {repo}'.strip(), timeout=280)
   219	    for name, module in list(sys.modules.items()):
   220	        if (name == 'swegemma' or name.startswith('swegemma.')) and getattr(module, 'install_test_dependencies', None) is orig:
   221	            module.install_test_dependencies = install
   222	    return install
