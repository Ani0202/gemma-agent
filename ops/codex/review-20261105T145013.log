   191	def trace_counts(trace):
   192	    entries = trace.entries if trace else []
   193	    counts = Counter(e.tool_name for e in entries if e.event_type == 'tool_call')
   194	    tokens = {}
   195	    for key in ('prompt_tokens', 'completion_tokens'):
   196	        values = [e.usage[key] for e in entries if e.usage and key in e.usage]
   197	        tokens[key] = sum(values) if values else None
   198	    return dict(counts), tokens, tool_seconds(entries)
   199	
   200	
   201	def tool_seconds(entries):
   202	    """Per tool name: wall seconds from each tool_call to its tool_response (FIFO per name)."""
   203	    pending, out = {}, {}
   204	    for e in entries:
   205	        if e.event_type == 'tool_call':
   206	            pending.setdefault(e.tool_name, []).append(e.timestamp)
   207	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   208	            stat = out.setdefault(e.tool_name, dict(n=0, total=0.0, max=0.0))
   209	            dt = max(0.0, e.timestamp - pending[e.tool_name].pop(0))
   210	            stat['n'] += 1
   211	            stat['total'] = round(stat['total'] + dt, 3)
   212	            stat['max'] = round(max(stat['max'], dt), 3)
   213	    return out
   214	
