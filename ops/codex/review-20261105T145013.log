                )
                unsubmitted_diff = diff_res.stdout or ''
                if not is_synthetic_mock_repo and unsubmitted_diff.strip():
                    from swegemma.harness.verification import (
                        strip_protected_files_from_patch,
                    )

                    unsubmitted_diff = strip_protected_files_from_patch(
                        unsubmitted_diff, extra_protected_paths=extra_protected
                    )
                if unsubmitted_diff.strip():
                    logger.info(
                        'Task %s: Captured unsubmitted working tree modifications as fallback patch (%d bytes)',
                        task.instance_id,
                        len(unsubmitted_diff),
