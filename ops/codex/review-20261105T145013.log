     1	"""Stdlib scripted OpenAI server. Script: JSON list of assistant messages or completions."""
     2	import argparse
     3	from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
     4	import json
     5	from pathlib import Path
     6	import threading
     7	import time
     8	
     9	
    10	def make_server(script, host='127.0.0.1', port=0):
    11	    responses = json.loads(Path(script).read_text())
    12	    if not isinstance(responses, list) or not responses:
    13	        raise ValueError('Script must be a nonempty JSON array')
    14	    lock = threading.Lock()
    15	    position = 0
    16	
    17	    class Handler(BaseHTTPRequestHandler):
    18	        def log_message(self, *args):
    19	            pass
    20	
    21	        def send_json(self, status, payload):
    22	            body = json.dumps(payload).encode()
    23	            self.send_response(status)
    24	            self.send_header('Content-Type', 'application/json')
    25	            self.send_header('Content-Length', str(len(body)))
    26	            self.end_headers()
    27	            self.wfile.write(body)
    28	
    29	        def do_GET(self):
    30	            if self.path.rstrip('/') == '/v1/models':
    31	                self.send_json(200, dict(object='list', data=[dict(id='gemma-4-e4b-it-qat-w4a16-ct',
    32	                                                                 object='model', owned_by='stub')]))
    33	            else:
    34	                self.send_json(404, dict(error='Unknown route'))
    35	
    36	        def do_POST(self):
    37	            nonlocal position
    38	            if self.path.rstrip('/') != '/v1/chat/completions':
    39	                self.send_json(404, dict(error='Unknown route'))
    40	                return
    41	            request = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
    42	            if request.get('stream'):
    43	                self.send_json(400, dict(error='Stub supports non-streaming requests only'))
    44	                return
    45	            with lock:
    46	                if position >= len(responses):
    47	                    self.send_json(409, dict(error='Script exhausted'))
    48	                    return
    49	                entry = responses[position]
    50	                position += 1
    51	                index = position
    52	            if 'choices' in entry:
    53	                payload = entry
    54	            else:
    55	                message = dict(role='assistant', **{k: v for k, v in entry.items() if k != 'role'})
    56	                payload = dict(choices=[dict(index=0, message=message, finish_reason=(
    57	                    'tool_calls' if message.get('tool_calls') else 'stop'))])
    58	            payload = dict(id=f'chatcmpl-stub-{index}', object='chat.completion',
    59	                           created=int(time.time()), model=request.get('model', 'stub'), **payload)
    60	            self.send_json(200, payload)
    61	
    62	    return ThreadingHTTPServer((host, port), Handler)
    63	
    64	
    65	def main():
    66	    parser = argparse.ArgumentParser(description=__doc__)
    67	    parser.add_argument('--script', required=True, type=Path)
    68	    parser.add_argument('--port', type=int, default=8000)
    69	    args = parser.parse_args()
    70	    with make_server(args.script, port=args.port) as server:
    71	        print(f'http://127.0.0.1:{server.server_port}/v1', flush=True)
    72	        server.serve_forever()
    73	
    74	
    75	if __name__ == '__main__':
    76	    main()

