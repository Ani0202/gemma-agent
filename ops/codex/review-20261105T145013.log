   216	def observe_patch_strip(original, state):
   217	    """Retain the agent's diff before the harness removes protected edits."""
   218	    def strip(patch, *pos, **kw):
   219	        current = state.get(None)
   220	        filtered = original(patch, *pos, **kw)
   221	        if current is not None and current.get('agent_active'):
   222	            if patch != current.get('filtered_patch'):
   223	                current['raw_patch'] = patch
   224	            current['filtered_patch'] = filtered
   225	        return filtered
   226	    return strip
