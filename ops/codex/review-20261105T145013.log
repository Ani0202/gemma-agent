   101	def diff(path, old='a', new='b', added=False):
   102	    return (f'diff --git a/{path} b/{path}\n' + ('new file mode 100644\n' if added else '') +
   103	            f'--- {"/dev/null" if added else "a/" + path}\n+++ b/{path}\n' +
   104	            f'@@ -{0 if added else 1},{0 if added else 1} +1 @@\n' +
   105	            ('' if added else '-' + old + '\n') + '+' + new + '\n')
