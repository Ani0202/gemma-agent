   169	        elif not in_hunk:
   170	            if line.startswith(('--- ', '+++ ')):
   171	                p = path_value(line[4:])
   172	                if p != '/dev/null':
   173	                    current.add(p)
   174	                elif line.startswith('--- '):
   175	                    added = True
   176	            elif line.startswith('new file mode '):
   177	                added = True
   178	            elif line.startswith(('rename from ', 'rename to ')):
   179	                current.add(path_value(line.split(' ', 2)[2]))
   180	    if protected is None:
   181	        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
   182	    tests = sorted(p for p in files if protected(p) or p in test_targets)
   183	    package = repo.split('/')[-1].replace('-', '_').lower()
   184	    source_roots = (package + '/', 'src/' + package + '/')
   185	    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
   186	                                         and p not in tests))
   187	    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
   188	                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())
