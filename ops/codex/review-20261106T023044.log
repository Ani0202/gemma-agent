     5	Usage: thinking_bound.py <run_dir> [<out.json>]"""
     6	import json, sys, glob, os
     7	ROOT = "swe_baseline_agent"; OVERHEAD = 32
     8	def turns(entries):
     9	    out = []
    10	    for i, e in enumerate(entries):
    11	        if e.get("author") == ROOT and e.get("usage"):
    12	            grp = [x for x in entries if x.get("author") == ROOT and x.get("timestamp") == e.get("timestamp")]
    13	            out.append((e, grp))
    14	    return out
