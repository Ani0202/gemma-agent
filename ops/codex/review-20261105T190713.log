   968	def disable_test_runners_in_sandbox(
   969	    docker: BaseSandboxManager,
   970	    container_id: str,
   971	) -> None:
   972	    """Masks pytest and suppresses unconstrained test discovery in the agent sandbox container.
   973	
   974	    This prevents agents from running unconstrained test discovery loops or full-repo
   975	    test suites that derail them into fixing pre-existing repository or environment test failures.
   976	    Preserves unittest, unittest.mock, and TestCase so standard library dependencies
   977	    load cleanly.
   978	    Container B (evaluation) does not run this, preserving test frameworks for scoring.
   979	    """
   980	    from swegemma.sandbox.subprocess import SubprocessManager
   981	    if isinstance(docker, SubprocessManager):
   982	        logger.debug('Skipping disable_test_runners_in_sandbox for SubprocessManager to protect host environment.')
   983	        return
   984	
   985	    script = r'''
   986	import os, sys
   987	
   988	pytest_msg = "pytest is disabled in this environment to prevent slow full-repo test runs and pre-existing environment failures. Please verify your implementation directly using python3 -c or targeted test assertions.\n"
   989	
   990	shim = f"""#!/bin/sh
   991	echo "{pytest_msg.strip()}" >&2
   992	exit 1
   993	"""
   994	for bin_name in ["/usr/local/bin/pytest", "/usr/local/bin/py.test"]:
   995	    try:
   996	        with open(bin_name, "w") as f:
   997	            f.write(shim)
   998	        os.chmod(bin_name, 0o755)
   999	    except Exception as e:
  1000	        sys.stderr.write(f"Warning: could not write {bin_name}: {e}\n")
  1001	
  1002	try:
  1003	    import pytest
  1004	    p = os.path.dirname(pytest.__file__)
  1005	    main_py = os.path.join(p, "__main__.py")
  1006	    with open(main_py, "w") as f:
  1007	        f.write(f'import sys\nsys.stderr.write("{pytest_msg}")\nsys.exit(1)\n')
  1008	except Exception:
  1009	    pass
