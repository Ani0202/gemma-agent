   204	def isolate_host_packages():
   205	    """Keep pyimg system packages; remove swegemma's extra harness-venv .pth leak."""
   206	    from swegemma.sandbox import SubprocessManager
   207	    original = SubprocessManager.start
   208	    if getattr(original, '_image_only', False):
   209	        return
   210	
   211	    def start(self):
   212	        base = getattr(self, 'base_dir', None)
   213	        if gold_artifact_dir.get() is not None:
   214	            self.base_dir = Path(gold_artifact_dir.get())
   215	        try:
   216	            sid = original(self)
   217	        finally:
   218	            self.base_dir = base
   219	        for pth in self.sandboxes[sid]['venv'].glob('lib/python*/site-packages/_host_env.pth'):
   220	            pth.unlink()
   221	        return sid
   222	    start._image_only = True
   223	    SubprocessManager.start = start
