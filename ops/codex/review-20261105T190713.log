   113	def setup_artifact(current, payload):
   114	    """Full diagnostics live outside the journal, with only a task ID in the filename."""
   115	    iid = current.get('instance_id')
   116	    if iid is None or not (payload.get('stdout') or payload.get('stderr')):
   117	        return
   118	    if not re.fullmatch(r'[A-Za-z0-9_.-]+', iid):
   119	        raise ValueError('Unsafe task ID')
   120	    path = WORK / 'setup_artifacts' / str(current.get('setup_fix', SETUP_FIX)) / (iid + '.jsonl')
   121	    path.parent.mkdir(parents=True, exist_ok=True)
   122	    if 'setup_output_artifact' not in current:
   123	        path.write_text('')
   124	    with path.open('a') as stream:
   125	        stream.write(json.dumps(payload) + '\n')
   126	    current['setup_output_artifact'] = str(path)
