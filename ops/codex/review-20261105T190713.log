    31	def bwrap_argv(command, workspace, hidden_paths, ro_paths):
    32	    workspace = Path(workspace).resolve()
    33	    root = workspace.parent
    34	    argv = BWRAP_TEMPLATE[:11]
    35	    # Mask parents first so nested masks don't get covered by their parents.
    36	    for path in sorted({str(Path(p).absolute()) for p in hidden_paths},
    37	                       key=lambda p: (len(Path(p).parts), p)):
    38	        argv += ['--tmpfs', path]
    39	    argv += ['--tmpfs', '/tmp']
    40	    # A final /tmp mask removes nested hidden mountpoints. Recreate their empty
    41	    # directories so temporary inventories can be probed with ls as well.
    42	    for path in sorted({str(Path(p).absolute()) for p in hidden_paths}):
    43	        if path != '/tmp' and Path(path).is_relative_to('/tmp'):
    44	            argv += ['--dir', path]
    45	    argv += ['--bind', str(root), str(root)]
    46	    # Bind each asset at its resolved path and, when reached through a symlink
    47	    # (uv's cpython-3.13 -> cpython-3.13.18 alias under a masked $HOME), at the
    48	    # unresolved path too, so venv interpreter symlinks don't dangle in the sandbox.
    49	    binds = set()
    50	    for p in ro_paths:
    51	        src = str(Path(p).resolve())
    52	        binds |= {(src, src), (src, str(Path(p).absolute()))}
    53	    for path, dest in sorted(binds, key=lambda b: (len(Path(b[1]).parts), b)):
    54	        # Only explicit runtime assets may be re-exposed, never inventory/artifacts.
    55	        if ({'tasks.jsonl', 'splits', 'runs', 'results'} & (set(Path(path).parts) | set(Path(dest).parts))
    56	                or (Path(path).is_dir() and (Path(path) / 'tasks.jsonl').exists())):
    57	            raise ValueError('Forbidden read-only exposure')
    58	        argv += ['--ro-bind', path, dest]
    59	    argv += ['--chdir', str(workspace), *command]
    60	    return argv
    61	
    62	
    63	def runtime_ro_paths(workspace, ro_paths):
    64	    root = Path(workspace).resolve().parent
    65	    cfg = (root / 'venv/pyvenv.cfg').read_text()
    66	    home = next(line.split('=', 1)[1].strip() for line in cfg.splitlines()
    67	                if line.startswith('home ='))
    68	    prefix = Path(home).resolve().parent
    69	    if prefix != Path(sys.base_prefix).resolve():
    70	        raise ValueError('Sandbox python prefix differs from the scorer interpreter')
    71	    # Keep the unresolved alias too; bwrap_argv binds the resolved target there.
    72	    paths = {prefix, Path(home).absolute().parent, *(Path(p).resolve() for p in ro_paths)}
    73	    def wheel_target(path):
    74	        target = path.resolve()
    75	        # Agent-created symlinks must not turn an arbitrary directory into a
    76	        # new read-only exposure. Only wheel files or trusted wheelhouse subdirs
    77	        # can be reached through symlinks; a file mount cannot expose siblings.
    78	        if not (target.is_file() and target.suffix == '.whl') and not any(
    79	                target.is_relative_to(Path(p).resolve()) for p in ro_paths):
    80	            raise ValueError('Untrusted wheel symlink target')
    81	        paths.add(target)
    82	
    83	    wheels = root / 'wheels'
    84	    if wheels.is_symlink():
    85	        wheel_target(wheels)
    86	    for path in wheels.rglob('*'):
    87	        if path.is_symlink():
    88	            wheel_target(path)
    89	    return paths
