   215	def copy_runtime_package(name, destination):
   216	    """Copy only the pure Python image package and metadata; no host path injection."""
   217	    from importlib.metadata import distribution, PackageNotFoundError
   218	    try:
   219	        dist = distribution(name)
   220	    except PackageNotFoundError:
   221	        return 'missing'
   222	    if name == 'pytest-timeout' and dist.version != '2.1.0':
   223	        return 'missing'
   224	    # Distribution names need not match import names (trove-classifiers, PyYAML).
   225	    files = list(dist.files or [])
   226	    if not files or any(str(p).endswith(('.so', '.pyd', '.dll', '.dylib')) for p in files):
   227	        return 'missing'
   228	    files = [p for p in files if '..' not in p.parts and not p.is_absolute()
   229	             and not p.parts[0].endswith('.data')]
   230	    if not any(str(p).endswith('.py') and not p.parts[0].endswith('.dist-info') for p in files):
   231	        return 'missing'
   232	    for entry in files:
   233	        target = destination / entry
   234	        target.parent.mkdir(parents=True, exist_ok=True)
   235	        shutil.copyfile(dist.locate_file(entry), target)
   236	    return 'runtime-site-packages:' + str(dist.locate_file(''))
