   151	def record_distributions(docker, container_id, repo, row):
   152	    # Query the same interpreter and metadata selection pip uses, never host metadata.
   153	    package = repo.rsplit('/', 1)[-1].lower()
   154	    probe = """import json
   155	from importlib.metadata import distribution, PackageNotFoundError
   156	names = NAMES
   157	result = {}
   158	for name in names:
   159	    try:
   160	        d = distribution(name)
   161	        result[name] = dict(location=str(d.locate_file('')), version=d.version,
   162	                            metadata_location=str(d._path), record_exists=d.read_text('RECORD') is not None)
   163	    except PackageNotFoundError:
   164	        result[name] = dict(location=None, version=None, metadata_location=None, record_exists=False)
   165	print(json.dumps(result))
   166	""".replace('NAMES', repr([package]))
   167	    result = docker.exec(container_id, 'python3 -c ' + shlex.quote(probe), timeout=30)
   168	    row['dist_probe_rc'] = result.exit_code
   169	    if result.exit_code != 0:
   170	        raise RuntimeError('Sandbox distribution probe failed')
   171	    row['distributions'] = json.loads(result.stdout)
