     1	"""Summarize a CPU setup journal without dropping failures or missing task IDs."""
     2	import argparse
     3	import json
     4	from pathlib import Path
     5	
     6	
     7	def diagnose(row):
     8	    calls = [c for c in row.get('setup_subprocesses', [])
     9	             if isinstance(c.get('argv'), list) and '-e' in c['argv']]
    10	    if not calls:
    11	        return dict(cause='unobserved', evidence=[])
    12	    first = calls[0]
    13	    if first['rc'] == 0:
    14	        return dict(cause='offline_install_succeeded', evidence=[])
    15	    output = first.get('stdout_full', first.get('stdout', '')) + '\n' + first.get('stderr_full', first.get('stderr', ''))
    16	    lower = output.lower()
    17	    if 'no module named pip' in lower:
    18	        cause = 'pip_absent_in_venv'
    19	    elif any(s in lower for s in ('backendunavailable', 'cannot import', 'no module named', 'backend is not available')):
    20	        cause = 'build_backend_absent_in_venv'
    21	    elif any(s in lower for s in ('not a supported wheel', 'no matching distribution', 'could not find a version')):
    22	        cause = 'wheel_or_abi_failure_stop_and_report'
    23	    else:
    24	        cause = 'unresolved_offline_install_failure'
    25	    evidence = [line for line in output.splitlines() if any(s in line.lower() for s in
    26	                ('error', 'no module named', 'cannot import', 'backendunavailable', 'not a supported wheel'))]
    27	    return dict(cause=cause, evidence=evidence[-12:])
    28	
    29	
    30	def summarize(path):
    31	    records = [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
    32	    header = records[0]
    33	    if header.get('_schema') != 'kaggle_setup_cpu_check_v1':
    34	        raise ValueError('Unexpected journal schema')
    35	    rows = [r for r in records if 'instance_id' in r]
    36	    ids = [r['instance_id'] for r in rows]
    37	    expected = header['task_ids']
    38	    complete = bool(expected) and len(set(ids)) == len(ids) and sorted(ids) == sorted(expected)
    39	    done = [r['_done']['n'] for r in records if '_done' in r]
    40	    complete = complete and done == [len(expected)] and not any('_stopped' in r for r in records)
    41	    for row in rows:
    42	        if row['setup_fix'] == 0:
    43	            row['offline_install_diagnosis'] = diagnose(row)
    44	    gates = dict(complete=complete,
    45	                 per_task_setup_le_30s=all(isinstance(r.get('setup_s_total'), (float, int)) and
    46	                                          0 <= r['setup_s_total'] <= 30 for r in rows),
    47	                 editable_rc_zero=all(r.get('editable_rc') == 0 for r in rows),
    48	                 zero_retrying_lines=all(r.get('retrying_lines') == 0 for r in rows),
    49	                 no_missing_tool_deps=all(not r.get('missing_tool_deps') for r in rows),
    50	                 no_editable_failures=all(not r.get('editable_failed', False) for r in rows),
    51	                 no_setup_failures=all(not r.get('setup_failed', True) for r in rows))
    52	    return dict(_schema='kaggle_setup_cpu_check_v1', task_ids=expected, n=len(rows),
    53	                rows=rows, gates=gates, decision='PASS' if all(gates.values()) else 'FAIL')
    54	
    55	
    56	def main():
    57	    parser = argparse.ArgumentParser(description=__doc__)
    58	    parser.add_argument('journal', type=Path)
    59	    parser.add_argument('--output', type=Path)
    60	    args = parser.parse_args()
    61	    text = json.dumps(summarize(args.journal), indent=2) + '\n'
    62	    if args.output:
    63	        args.output.write_text(text)
    64	    else:
    65	        print(text, end='')
    66	
    67	
    68	if __name__ == '__main__':
    69	    main()
