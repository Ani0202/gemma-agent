   242	def patch_subprocess_deps(data_dir):
   243	    """Emulate the docker-only dependency setup for the subprocess sandbox (swegemma skips it).
   244	
   245	    Contract (swegemma 0.2.11 container_setup): for docker, _ensure_container_site_packages
   246	    unpacks every deduplicated (highest-version, py313-compatible) wheel from wheels_dir that is
   247	    < 20 MB and not in skip_base_pkgs (pytest, pluggy, ... come from the image) straight into
   248	    site-packages, no resolver; large wheels are added only if imported by the workspace; then
   249	    sandbox/setup.py runs with --fast-path. We replicate exactly that inside the sandbox venv.
   250	    The sandbox venv uses system_site_packages=True, so the HOST python must mirror the image
   251	    (Dockerfile.public: pytest, pytest-timeout==2.1.0, typer, build backends; nothing else).
   252	    """
   253	    import tarfile
   254	    import swegemma.harness.container_setup as cs
   255	    import swegemma.harness.verification as vf
   256	    import swegemma.harness.sample_verification  # load all known by-name bindings
   257	    import swegemma.evaluate
   258	    import swegemma.cli
   259	    import swegemma.harness.agent_runner
   260	    orig = getattr(cs.install_test_dependencies, '_scorer_original', cs.install_test_dependencies)
   261	    previous = cs.install_test_dependencies
   262	    wheels_src = Path(data_dir) / 'wheels'
   263	    if not wheels_src.is_dir():
   264	        wheels_src = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')
   265	    setup_py = setup_script_path(data_dir)
   266	
   267	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   268	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   269	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   270	        venv_dir = docker.sandboxes[container_id]['venv']
   271	        sp_dir = next(iter(sorted(venv_dir.glob('lib/python3*/site-packages'))))
   272	        base_wheels, large_wheels, _m2p, _req = cs._inspect_wheels_dir(wheels_src)
   273	        selected = list(base_wheels)
   274	        if large_wheels:  # public wheels have none; fail loudly rather than silently diverge
   275	            raise RuntimeError('large wheels present; workspace-import scan not emulated')
   276	        tar_path = cs._build_unpacked_wheels_tar(selected, 'sp_base_local', '.swegemma_base_injected')
   277	        with tarfile.open(tar_path) as tf:
   278	            tf.extractall(sp_dir, filter='data')
   279	        docker.copy_to(container_id, setup_py, '/tmp/setup.py')
   280	        flag = '--fast-path' if fast_path else ''
   281	        docker.exec(container_id, f'python3 /tmp/setup.py {flag} {repo}'.strip(), timeout=280)
   282	        probe_log = os.environ.get('GOLD_PROBE_LOG')  # diagnostic: which copy of the repo package is imported
   283	        if probe_log:
   284	            pkg = {'Textualize/rich': 'rich', 'encode/httpx': 'httpx', 'fastapi/fastapi': 'fastapi',
   285	                   'psf/requests': 'requests'}.get(repo, repo.split('/')[-1])
   286	            out = docker.exec(container_id, f'cd /workspace && PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1 python3 -s -c '
   287	                              f'"import {pkg};print({pkg}.__file__)"', timeout=60)
   288	            with open(probe_log, 'a') as fh:
   289	                fh.write(json.dumps({'container': str(container_id), 'repo': repo, 'probe': str(out)[:500]}) + '\n')
   290	    install._scorer_original = orig
   291	    for name, module in list(sys.modules.items()):
   292	        if ((name == 'swegemma' or name.startswith('swegemma.'))
   293	                and getattr(module, 'install_test_dependencies', None) in (orig, previous)):
   294	            module.install_test_dependencies = install
   295	    return install
