   174	def setup_step(current, name, action, *, fatal=True):
   175	    """Time setup steps and retain bounded output plus retry counts."""
   176	    start = time.perf_counter()
   177	    row = dict(step=name, start_offset_s=round(start-current['started'], 6),
   178	               duration_s=0.0, rc=None, stdout='', stderr='', retrying_lines=0)
   179	    current['setup_calls'].append(row)
   180	    try:
   181	        result = action()
   182	        row['rc'] = getattr(result, 'exit_code', getattr(result, 'returncode', 0))
   183	        setup_artifact(current, dict(step=name, stdout=getattr(result, 'stdout', '') or '',
   184	                                     stderr=getattr(result, 'stderr', '') or ''))
   185	        for field in ('stdout', 'stderr'):
   186	            value = getattr(result, field, '') or ''
   187	            row['retrying_lines'] += sum('Retrying' in line for line in value.splitlines())
   188	            row[field] = value.encode('utf-8', errors='replace')[-2048:].decode('utf-8', errors='ignore')
   189	        return result
   190	    except Exception as exc:
   191	        row.update(rc=-1, stderr=type(exc).__name__)
   192	        if fatal:
   193	            current['setup_failed'] = True
   194	            raise
   195	    finally:
   196	        row['duration_s'] = round(time.perf_counter()-start, 6)
   197	        current['retrying_lines'] = sum(c['retrying_lines'] for c in current['setup_calls'])
   198	        if fatal and row['rc'] != 0:
   199	            current['setup_failed'] = True
