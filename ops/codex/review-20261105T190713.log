    20	BWRAP_TEMPLATE = [
    21	    'bwrap', '--die-with-parent', '--unshare-net', '--unshare-pid',
    22	    '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc',
    23	    '--tmpfs', '<each hidden path>', '--tmpfs', '/tmp',
    24	    '--dir', '<each hidden path under /tmp, if any>',
    25	    '--bind', '<sandbox_root>', '<sandbox_root>',
    26	    '--ro-bind', '<each ro path>', '<same>',
    27	    '--chdir', '<workspace>', '/bin/bash', '-c', '<translated_cmd>',
    28	]
