   177	                                              tasks_path=data_dir / 'tasks.jsonl',
   178	                                              snapshots_dir=data_dir / 'snapshots'))
   179	    ro = [wheels.resolve()] if wheels else []
   180	    try:
   181	        if not shutil.which('bwrap'):
   182	            raise RuntimeError('bubblewrap is not installed')
   183	        # First check the empty inventory mask before mounting its wheelhouse
   184	        # child. Then repeat with the complete runtime mounts: wheels may be
   185	        # visible under data_dir, but the inventory must remain inaccessible.
   186	        template = apply_isolation(hidden, [])
