    29	def max_identical_run(run, tid):
    30	    """Longest run of consecutive byte-identical tool calls (same tool + same args JSON).
    31	    Returns (count, start_s, end_s, span_s): agent-clock seconds of the run's first and last tool_call entry."""
    32	    d = json.load(open(f"{run}/runs/{tid}/trace.json"))
    33	    t0 = float(next(e["elapsed_s"] for e in d["entries"] if e["type"] == "task_prompt"))
    34	    best = (0, None, None, None); cur = 0; prev = None; start = None
    35	    for e in d["entries"]:
    36	        if e["type"] != "tool_call":
    37	            continue
    38	        key = (e.get("tool"), json.dumps(e.get("args", e.get("arguments")), sort_keys=True))
    39	        ts = round(float(e["elapsed_s"]) - t0, 3)
    40	        if key == prev:
    41	            cur += 1
    42	        else:
    43	            cur, start = 1, ts
    44	        prev = key
    45	        if cur > best[0]:
    46	            best = (cur, start, ts, round(ts - start, 3))
    47	    return best
