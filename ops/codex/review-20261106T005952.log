    58	def _coerce_optional_int(val: Any, param_name: str) -> int | None:
    59	    """Coerce an optional integer tool parameter that may arrive as a string."""
    60	    if val is None:
    61	        return None
    62	    if isinstance(val, bool):
    63	        raise TypeError(f'{param_name} must be an integer, got boolean {val}')
    64	    if isinstance(val, int):
    65	        return val
    66	    if isinstance(val, float):
    67	        return int(val)
    68	    if isinstance(val, str):
    69	        s = val.strip()
    70	        if not s or s.lower() in ('none', 'null', 'nil'):
    71	            return None
    72	        try:
    73	            return int(s)
    74	        except ValueError:
    75	            try:
    76	                f = float(s)
    77	                if f.is_integer():
    78	                    return int(f)
    79	            except ValueError:
    80	                pass
    81	            raise ValueError(
    82	                f'Invalid integer for {param_name}: {val!r}'
    83	            ) from None
    84	    raise ValueError(f'Invalid integer for {param_name}: {val!r}')
    85	
