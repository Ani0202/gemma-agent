   180	@budget_gated
   181	def write_file(ctx: Any, filepath: str, content: str) -> str:
   182	    """Create or overwrite a file in the workspace.
   183	
   184	    Args:
   185	        ctx: Context instance.
   186	        filepath: Relative path to the file to create or overwrite.
   187	        content: Full content of the file.
   188	    """
   189	    try:
   190	        dest_path = _resolve_workspace_path(filepath, allow_root=False)
   191	        quoted_parent = shlex.quote(str(dest_path.parent))
   192	
   193	        with tempfile.TemporaryDirectory() as tmpdir:
   194	            tmp_file = Path(tmpdir) / dest_path.name
   195	            tmp_file.write_text(content, encoding='utf-8')
   196	
   197	            mkdir_res = ctx.docker.exec(ctx.container_id, f'mkdir -p {quoted_parent}')
   198	            if mkdir_res.exit_code != 0:
   199	                raise RuntimeError(
   200	                    f'Failed to create directory {dest_path.parent} inside container: {mkdir_res.stderr}'
   201	                )
   202	
   203	            ctx.docker.copy_to(ctx.container_id, tmp_file, f'{dest_path.parent}/')
   204	
   205	        return ok_response(
   206	            filepath=filepath,
   207	            size=len(content),
   208	        )
   209	    except Exception as e:
   210	        return error_response(
   211	            error_type='FileWriteError',
   212	            error_message=str(e),
   213	        )
