     1	"""Execution and status inspection tools for SWE-gemma."""
     2	
     3	from __future__ import annotations
     4	
     5	import json
     6	import logging
     7	from collections.abc import Callable
     8	from typing import Any
     9	
    10	from swegemma.tools.base import (
    11	    budget_gated,
    12	    error_response,
    13	    ok_response,
    14	    parse_tool_response,
    15	)
    16	
    17	logger = logging.getLogger(__name__)
    18	
    19	
    20	@budget_gated
    21	def run_command(ctx: Any, command: str) -> str:
    22	    """Execute a shell command inside the repository sandbox.
    23	
    24	    You can run any shell command (Python scripts, tests, git commands, etc.).
    25	    The command runs in the repository workspace. No network access.
    26	
    27	    Args:
    28	        ctx: Context instance.
    29	        command: Shell command to execute (e.g., "pytest tests/", "python3 script.py").
    30	    """
    31	    # Determine effective command timeout
    32	    cmd_timeout = ctx.harness.command_timeout_seconds
    33	    if ctx.budget.time_minutes is not None:
    34	        remaining = ctx.remaining_time_seconds
    35	        if remaining is not None:
    36	            # Provide a minimum floor of 5s on remaining time so near-deadline commands don't fail immediately on 1s
    37	            effective_remaining = max(5, int(remaining))
    38	            if cmd_timeout is not None:
    39	                effective_timeout = min(cmd_timeout, effective_remaining)
    40	            else:
    41	                effective_timeout = effective_remaining
    42	        else:
    43	            effective_timeout = cmd_timeout
    44	    else:
    45	        effective_timeout = cmd_timeout
    46	
    47	    result = ctx.docker.exec(ctx.container_id, command, timeout=effective_timeout)
    48	    if result.timed_out:
    49	        return error_response(
    50	            error_type='TimeoutExceeded',
    51	            error_message=f'Command timed out after {effective_timeout} seconds',
    52	        )
    53	
    54	    max_chars = ctx.harness.max_stdout_chars
    55	    stdout_str = result.stdout[:max_chars] if max_chars is not None else result.stdout
    56	    stderr_str = result.stderr[:max_chars] if max_chars is not None else result.stderr
    57	
    58	    if result.exit_code != 0:
    59	        return error_response(
    60	            error_type='CommandError',
    61	            error_message=stderr_str if stderr_str else stdout_str,
    62	            details={
    63	                'stdout': stdout_str,
    64	                'stderr': stderr_str,
    65	                'exit_code': result.exit_code,
    66	            },
    67	        )
    68	
    69	    return ok_response(
    70	        stdout=stdout_str,
    71	        stderr=stderr_str,
    72	        exit_code=0,
    73	    )
    74	
    75	
    76	@budget_gated(count_tool_call=False)
    77	def submit_patch(ctx: Any) -> str:
    78	    """Capture the current working tree modifications as the agent's submission.
    79	
    80	    This generates a unified git diff against the baseline commit. The agent
    81	    can submit multiple times; only the final submission is evaluated.
    82	
    83	    Args:
    84	        ctx: Context instance.
    85	    """
    86	    ctx.docker.exec(ctx.container_id, 'cd /workspace && git add -N .')
    87	    res = ctx.docker.exec(
    88	        ctx.container_id,
    89	        'cd /workspace && (git diff --binary _swegemma_baseline 2>/dev/null || git diff --binary HEAD)',
    90	    )
    91	    if res.exit_code != 0:
    92	        return error_response(
    93	            error_type='GitDiffError',
    94	            error_message=f'git diff failed with exit code {res.exit_code}: {res.stderr}',
    95	        )
    96	
    97	    diff = res.stdout
    98	    repo = (
    99	        getattr(ctx, 'repo', None)
   100	        or getattr(getattr(ctx, 'task', None), 'repo', None)
   101	        or ''
   102	    )
   103	    if not str(repo).startswith('test/mock_repo') and diff.strip():
   104	        from swegemma.harness.verification import strip_protected_files_from_patch
   105	
   106	        task_obj = getattr(ctx, 'task', None)
   107	        extra_protected = list(getattr(task_obj, 'test_files', None) or ())
   108	        diff = strip_protected_files_from_patch(
   109	            diff, extra_protected_paths=extra_protected
   110	        )
   111	    ctx.submitted_patch = diff
   112	    ctx.patch_submitted = True
   113	    return ok_response(
   114	        patch_size=len(diff),
   115	        files_changed=diff.count('diff --git'),
   116	    )
   117	
   118	
   119	@budget_gated(count_tool_call=False)
   120	def get_status(ctx: Any) -> str:
   121	    """Check active budget details (time, tool calls) and active patch details.
   122	
   123	    Args:
   124	        ctx: Context instance.
   125	    """
   126	    status_data: dict[str, Any] = {
   127	        'status': 'ok',
   128	        'tool_calls_used': ctx.tool_calls_used,
   129	        'patch_submitted': ctx.submitted_patch is not None,
   130	        'patch_size': len(ctx.submitted_patch) if ctx.submitted_patch else 0,
   131	    }
   132	    if ctx.budget.tool_calls is not None:
   133	        status_data['tool_calls_remaining'] = max(
   134	            0, ctx.budget.tool_calls - ctx.tool_calls_used
   135	        )
   136	        status_data['max_tool_calls'] = ctx.budget.tool_calls
