    87	@budget_gated
    88	def read_file(
    89	    ctx: Any,
    90	    filepath: str,
    91	    start_line: int | None = None,
    92	    end_line: int | None = None,
    93	) -> str:
    94	    """Read the contents of a file from the repository workspace.
    95	
    96	    Supports reading specific line ranges using start_line and end_line (1-indexed).
    97	    To avoid overwhelming the context window, large files are automatically truncated
    98	    to a maximum number of lines (default: 150 lines) and characters (default: 10,000 characters).
    99	
   100	    Args:
   101	        ctx: Context instance.
   102	        filepath: Relative path within the workspace directory (e.g., "fastapi/main.py", "pyproject.toml").
   103	        start_line: Optional starting line number (1-indexed, inclusive).
   104	        end_line: Optional ending line number (1-indexed, inclusive).
   105	
   106	    Returns:
   107	        JSON string containing file content, line range, and truncation status.
   108	    """
   109	    try:
   110	        coerced_start = _coerce_optional_int(start_line, 'start_line')
   111	        coerced_end = _coerce_optional_int(end_line, 'end_line')
   112	
   113	        dest_path = _resolve_workspace_path(filepath, allow_root=False)
   114	        filename = dest_path.name
   115	
   116	        with tempfile.TemporaryDirectory() as tmpdir:
   117	            local_file = Path(tmpdir) / filename
   118	            ctx.docker.copy_from(ctx.container_id, str(dest_path), local_file)
   119	
   120	            if not local_file.exists():
   121	                raise FileNotFoundError(f"File '{filepath}' not found in workspace.")
   122	
   123	            content = local_file.read_text(encoding='utf-8', errors='replace')
   124	
   125	        lines = content.splitlines()
   126	        total_lines = len(lines)
   127	
   128	        if total_lines == 0:
   129	            return ok_response(
   130	                filepath=filepath,
   131	                content='',
   132	                start_line=1,
   133	                end_line=0,
   134	                total_lines=0,
   135	                is_truncated=False,
   136	            )
   137	
   138	        start = coerced_start if coerced_start is not None else 1
   139	        end = coerced_end if coerced_end is not None else total_lines
   140	
   141	        start = max(start, 1)
   142	        end = min(end, total_lines)
   143	
   144	        if start > end:
   145	            return error_response(
   146	                error_type='ValueError',
   147	                error_message=f'start_line ({start}) cannot be greater than end_line ({end})',
   148	                details={},
   149	            )
   150	
   151	        max_lines = getattr(ctx.harness, 'max_file_lines', 150)
   152	        max_chars = getattr(ctx.harness, 'max_file_chars', 10000)
   153	        is_truncated = False
   154	        if max_lines is not None and (end - start + 1) > max_lines:
   155	            end = start + max_lines - 1
   156	            is_truncated = True
   157	
   158	        selected_lines = lines[start - 1 : end]
   159	        snippet = '\n'.join(selected_lines)
   160	
   161	        if max_chars is not None and len(snippet) > max_chars:
   162	            snippet = snippet[:max_chars]
   163	            is_truncated = True
   164	
   165	        return ok_response(
   166	            filepath=filepath,
   167	            content=snippet,
   168	            start_line=start,
   169	            end_line=end,
   170	            total_lines=total_lines,
   171	            is_truncated=is_truncated,
   172	        )
   173	    except Exception as e:
   174	        return error_response(
   175	            error_type='FileReadError',
   176	            error_message=str(e),
   177	        )
