    22	def _resolve_workspace_path(
    23	    filepath: str,
    24	    workspace_root: Path = Path('/workspace'),
    25	    *,
    26	    allow_root: bool = True,
    27	) -> Path:
    28	    """Normalize and resolve relative paths strictly within the workspace directory."""
    29	    workspace_root_resolved = workspace_root.resolve()
    30	    ws_str = str(workspace_root_resolved)
    31	    norm_filepath = filepath
    32	    if norm_filepath == '/workspace':
    33	        norm_filepath = ''
    34	    elif norm_filepath.startswith('/workspace/'):
    35	        norm_filepath = norm_filepath[len('/workspace/') :]
    36	    elif ws_str != '/workspace':
    37	        if norm_filepath == ws_str:
    38	            norm_filepath = ''
    39	        elif norm_filepath.startswith(ws_str + '/'):
    40	            norm_filepath = norm_filepath[len(ws_str) + 1 :]
    41	    if norm_filepath.startswith('/'):
    42	        raise ValueError(
    43	            f"Path traversal detected: '{filepath}' escapes workspace root."
    44	        )
    45	    clean_rel = Path(norm_filepath)
    46	    resolved = (workspace_root_resolved / clean_rel).resolve()
    47	    if not resolved.is_relative_to(workspace_root_resolved):
    48	        raise ValueError(
    49	            f"Path traversal detected: '{filepath}' escapes workspace root."
    50	        )
    51	    if not allow_root and resolved == workspace_root_resolved:
    52	        raise ValueError(
    53	            f"Invalid file path '{filepath}': refers to workspace root directory, not a file."
    54	        )
    55	    return resolved
