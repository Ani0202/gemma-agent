   709	def test_run_stats(trace, agent_seconds):
   710	    pending, n, total = {}, 0, 0.0
   711	    for e in trace.entries if trace else []:
   712	        if e.event_type == 'tool_call':
   713	            command = (e.tool_args or {}).get('command', '')
   714	            is_test = e.tool_name == 'run_command' and any(s in command for s in ('pytest', 'unittest', 'tox', 'nox', 'run_tests'))
   715	            n += int(is_test)
   716	            pending.setdefault(e.tool_name, []).append((e.timestamp, is_test))
   717	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   718	            start, is_test = pending[e.tool_name].pop(0)
   719	            if is_test:
   720	                total += max(0.0, e.timestamp - start)
   721	    return dict(n=n, total_seconds=total, share_of_agent_seconds=total / agent_seconds if agent_seconds else None)
