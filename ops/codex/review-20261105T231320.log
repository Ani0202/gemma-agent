   674	def trace_counts(trace):
   675	    entries = trace.entries if trace else []
   676	    counts = Counter(e.tool_name for e in entries if e.event_type == 'tool_call')
   677	    tokens = {}
   678	    for key in ('prompt_tokens', 'completion_tokens'):
   679	        values = [e.usage[key] for e in entries if e.usage and isinstance(e.usage.get(key), (int, float))]
   680	        tokens[key] = sum(values) if values else None
   681	    return dict(counts), tokens, tool_seconds(entries)
   682	
   683	def tool_seconds(entries):
   684	    """Per tool name: wall seconds from each tool_call to its tool_response (FIFO per name)."""
   685	    pending, out = {}, {}
   686	    for e in entries:
   687	        if e.event_type == 'tool_call':
   688	            pending.setdefault(e.tool_name, []).append(e.timestamp)
   689	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   690	            stat = out.setdefault(e.tool_name, dict(n=0, total=0.0, max=0.0))
   691	            dt = max(0.0, e.timestamp - pending[e.tool_name].pop(0))
   692	            stat['n'] += 1
   693	            stat['total'] = round(stat['total'] + dt, 3)
   694	            stat['max'] = round(max(stat['max'], dt), 3)
   695	    return out
