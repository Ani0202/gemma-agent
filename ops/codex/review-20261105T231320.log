   727	class AsyncioTimingProxy:
   728	    """Observe only agent_runner's timeout context, without changing asyncio itself."""
   729	    def __init__(self, original, state):
   730	        self._original, self._state = original, state
   731	
   732	    def __getattr__(self, name):
   733	        return getattr(self._original, name)
   734	
   735	    def timeout(self, *args, **kwargs):
   736	        cm = self._original.timeout(*args, **kwargs)
   737	        state = self._state
   738	        delay = args[0] if args else kwargs.get('delay')
   739	
   740	        class ObservedTimeout:
   741	            async def __aenter__(self):
   742	                self.current = state.get(None)
   743	                if self.current is not None:
   744	                    self.current.update(agent_timeout_seconds=delay, timeout_enter=time.perf_counter())
   745	                return await cm.__aenter__()
   746	
   747	            async def __aexit__(self, *exc_info):
   748	                exit_exc = exc_info[1]
   749	                try:
   750	                    return await cm.__aexit__(*exc_info)
   751	                except BaseException as exc:
