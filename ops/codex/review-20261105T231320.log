    59	    def initialize(self, files: dict[str, str | bytes] | None = None) -> None:
    60	        """Start default sandbox and optionally write initial files."""
    61	        with self._lock:
    62	            if (
    63	                self._default_sandbox_id is None
    64	                or self._default_sandbox_id not in self._sandboxes
    65	            ):
    66	                self._default_sandbox_id = self.start()
    67	        if files is not None:
    68	            self._initial_files = dict(files)
    69	            for rel_path, content in files.items():
    70	                self.write_file(rel_path, content)
