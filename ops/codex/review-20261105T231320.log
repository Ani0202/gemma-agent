    45	        self._lock = threading.RLock()
    46	
    47	    @property
    48	    def sandboxes(self) -> dict[str, dict[str, Path]]:
    49	        with self._lock:
    50	            return {k: dict(v) for k, v in self._sandboxes.items()}
    51	
    52	    @property
    53	    def work_dir(self) -> str:
    54	        with self._lock:
    55	            if self._default_sandbox_id and self._default_sandbox_id in self._sandboxes:
    56	                return str(self._sandboxes[self._default_sandbox_id]['workspace'])
    57	        return '/workspace'
