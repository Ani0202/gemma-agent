   697	def observe_patch_strip(original, state):
   698	    """Retain the agent's diff before the harness removes protected edits."""
   699	    def strip(patch, *pos, **kw):
   700	        current = state.get(None)
   701	        filtered = original(patch, *pos, **kw)
   702	        if current is not None and current.get('agent_active'):
   703	            if patch != current.get('filtered_patch'):
   704	                current['raw_patch'] = patch
   705	            current['filtered_patch'] = filtered
   706	        return filtered
   707	    return strip
