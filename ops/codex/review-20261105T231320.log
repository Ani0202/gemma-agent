   232	
   233	def _build_unpacked_wheels_tar(
   234	    selected_wheels: list[Path], cache_name: str, marker_name: str
   235	) -> Path:
   236	    """Unpacks selected_wheels into a cached uncompressed tar archive with a marker file."""
   237	    import shutil
   238	    import subprocess
   239	    import tempfile
   240	    import uuid
   241	    import zipfile
   242	    from concurrent.futures import ThreadPoolExecutor
   243	
   244	    cache_dir = Path(tempfile.gettempdir()) / 'swegemma_sp_cache_v8'
   245	    cache_dir.mkdir(parents=True, exist_ok=True)
   246	    tar_path = cache_dir / f'{cache_name}.tar'
   247	    if tar_path.exists() and tar_path.stat().st_size > 0:
   248	        return tar_path
   249	
   250	    with _WHEELS_TAR_LOCK:
   251	        if tar_path.exists() and tar_path.stat().st_size > 0:
   252	            return tar_path
   253	
   254	        uid = uuid.uuid4().hex[:8]
   255	        staging_dir = cache_dir / f'staging_{cache_name}_{os.getpid()}_{uid}'
   256	        if staging_dir.exists():
   257	            shutil.rmtree(staging_dir, ignore_errors=True)
   258	        staging_dir.mkdir(parents=True, exist_ok=True)
   259	
   260	        def _extract_one(w_path: Path) -> None:
   261	            try:
   262	                with zipfile.ZipFile(w_path, 'r') as zf:
   263	                    members = [
   264	                        m
   265	                        for m in zf.infolist()
   266	                        if not m.filename.endswith(('.pyc', '/RECORD'))
   267	                    ]
   268	                    zf.extractall(staging_dir, members=members)
   269	            except Exception as e:
   270	                logger.debug('Skipping wheel %s during staging: %s', w_path.name, e)
   271	
   272	        try:
   273	            with ThreadPoolExecutor(max_workers=8) as pool:
   274	                list(pool.map(_extract_one, selected_wheels))
   275	
   276	            for data_dir in list(staging_dir.glob('*.data')):
   277	                for sub_name in ('purelib', 'platlib'):
   278	                    sub_dir = data_dir / sub_name
   279	                    if sub_dir.is_dir():
   280	                        for item in sub_dir.iterdir():
   281	                            dest = staging_dir / item.name
   282	                            if not dest.exists():
   283	                                shutil.move(str(item), str(dest))
   284	                shutil.rmtree(data_dir, ignore_errors=True)
   285	
   286	            (staging_dir / marker_name).write_text('ok\n', encoding='utf-8')
   287	
   288	            tmp_tar = cache_dir / f'{cache_name}_{os.getpid()}_{uid}.tar.tmp'
   289	            subprocess.run(
   290	                ['tar', '-cf', str(tmp_tar), '-C', str(staging_dir), '.'],
   291	                check=True,
   292	            )
   293	            tmp_tar.replace(tar_path)
   294	        finally:
   295	            shutil.rmtree(staging_dir, ignore_errors=True)
   296	
   297	    return tar_path
