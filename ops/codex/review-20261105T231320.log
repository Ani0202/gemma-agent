   634	def classify_patch(patch, repo, protected=None, test_targets=()):
   635	    """Parse file headers outside hunks, including quoted paths and renames."""
   636	    files, new = set(), set()
   637	    current, added, in_hunk = set(), False, False
   638	    def path_value(raw):
   639	        raw = raw.split('\t', 1)[0]
   640	        value = json.loads(raw) if raw.startswith('"') else raw
   641	        return value[2:] if value.startswith(('a/', 'b/')) else value
   642	    for line in patch.splitlines() + ['diff --git ']:
   643	        if line.startswith('diff --git '):
   644	            files.update(current)
   645	            if added:
   646	                new.update(current)
   647	            current, added, in_hunk = set(), False, False
   648	            match = re.match(r'^diff --git ("a/.*?"|a/.*?) ("b/.*?"|b/.*)$', line)
   649	            if match:
   650	                current.update(path_value(p) for p in match.groups())
   651	        elif line.startswith('@@'):
   652	            in_hunk = True
   653	        elif not in_hunk:
   654	            if line.startswith(('--- ', '+++ ')):
   655	                p = path_value(line[4:])
   656	                if p != '/dev/null':
   657	                    current.add(p)
   658	                elif line.startswith('--- '):
   659	                    added = True
   660	            elif line.startswith('new file mode '):
   661	                added = True
   662	            elif line.startswith(('rename from ', 'rename to ')):
   663	                current.add(path_value(line.split(' ', 2)[2]))
   664	    if protected is None:
   665	        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
   666	    tests = sorted(p for p in files if protected(p) or p in test_targets)
   667	    package = repo.split('/')[-1].replace('-', '_').lower()
   668	    source_roots = (package + '/', 'src/' + package + '/')
   669	    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
   670	                                         and p not in tests))
   671	    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
   672	                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())
