    72	    def run_command(
    73	        self,
    74	        command: str,
    75	        timeout: float | None = 300,
    76	        work_dir: str | None = None,
    77	    ) -> ExecutionResult:
    78	        """Execute a command in the active sandbox workspace."""
    79	        if self._default_sandbox_id is None:
    80	            self.initialize()
    81	        assert self._default_sandbox_id is not None
    82	        int_timeout = int(timeout) if timeout is not None else self.timeout_seconds
    83	        cmd = f'cd {shlex.quote(work_dir)} && {command}' if work_dir else command
    84	        return self.exec(self._default_sandbox_id, cmd, timeout=int_timeout)
