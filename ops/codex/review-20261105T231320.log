    86	    def write_file(self, path: str, content: str | bytes) -> None:
    87	        """Write a file into the active sandbox workspace."""
    88	        if self._default_sandbox_id is None:
    89	            self.initialize()
    90	        assert self._default_sandbox_id is not None
    91	        paths = self._sandboxes[self._default_sandbox_id]
    92	        root_dir = paths['root'].resolve()
    93	        ws_dir = paths['workspace'].resolve()
    94	        if not posixpath.isabs(path):
    95	            target_dest = ws_dir / path
    96	            allowed_root = ws_dir
    97	        elif path == '/workspace' or path.startswith('/workspace/'):
    98	            rel = path[len('/workspace/') :] if path.startswith('/workspace/') else ''
    99	            target_dest = ws_dir / rel
   100	            allowed_root = ws_dir
