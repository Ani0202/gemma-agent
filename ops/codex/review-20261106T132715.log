    36	def wilson(k, n, z=1.959963984540054):
    37	    if n == 0:
    38	        return None
    39	    p = k / n
    40	    d = 1 + z * z / n
    41	    c = (p + z * z / (2 * n)) / d
    42	    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
    43	    return [round(max(0.0, c - h), 4), round(min(1.0, c + h), 4)]
    44	
    45	
    46	def rate(k, n):
    47	    return dict(k=k, n=n, rate=round(k / n, 4) if n else None, wilson95=wilson(k, n))
