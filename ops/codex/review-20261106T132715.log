    50	def pct(vals, q):
    51	    vals = sorted(v for v in vals if v is not None)
    52	    if not vals:
    53	        return None
    54	    i = (len(vals) - 1) * q
    55	    lo, hi = math.floor(i), math.ceil(i)
    56	    return round(vals[lo] + (vals[hi] - vals[lo]) * (i - lo), 1)
