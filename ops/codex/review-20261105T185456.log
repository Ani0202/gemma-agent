   335	def raise_oom_adj(targets, dry, args, known_jobs=None):
   336	    n = 0
   337	    if dry:
   338	        return n
   339	    for p, d in targets.items():
   340	        # Opening first pins the proc file to this process, even if its numeric pid is reused.
   341	        try:
   342	            with open(f"/proc/{p}/oom_score_adj", "w") as f:
   343	                if action_eligible(d, args, known_jobs):
   344	                    f.write("1000")
   345	                    n += 1
   346	        except OSError:
   347	            pass
   348	    return n
