   240	        if not eligible(p, procs, args, protected, verified, known_jobs):
   241	            continue
   242	        job_id = marker_value(p, "GEMMA_JOB_ID")
   243	        record = None
   244	        previous = known.get((p, d["starttime"])) if job_id is None else None
   245	        if job_id is not None:
   246	            # Bytes equality, never a prefix/substring/regex match. Identity takes
   247	            # precedence over PGID, ancestry, and the eligibility marker's value.
   248	            record = next((r for r in records if r.get("job_id") == job_id), None)
   249	            key = ("job_id", job_id)
   250	        elif previous:
   251	            key = previous["key"]
   252	        else:
   253	            lineage = [p] + ancestors(p, procs)
   254	            record = next((r for r in verified if r["pid"] in lineage), None)
   255	            if record is None:
   256	                continue  # The job-ID marker may have disappeared since eligibility.
   257	            key = ("job", record["pid"], procs[record["pid"]]["starttime"])
   258	        root = record["pid"] if record else p
   259	        if previous:
   260	            root = previous["root"]
   261	        j = jobs.setdefault(key, {"key": key, "root": root, "name": record["name"] if record else job_name(root, procs, records),
   262	                                  "pids": [], "members": {}, "rss": 0, "records": records,
   263	                                  "known_members": dict(previous["known_members"]) if previous else {}})
   264	        if previous:
   265	            j["name"] = previous["name"]
   266	            for member, start in previous["known_members"].items():
   267	                j["known_members"].setdefault(member, start)
   268	        j["known_members"][p] = d["starttime"]
   269	        j["pids"].append(p)
   270	        j["members"][p] = d
   271	        j["rss"] += d["rss"]
   272	    # Exclude the watchdog's whole job, including siblings, rather than only its pid.
   273	    for key, j in list(jobs.items()):
   274	        if (set(j["pids"]) & (self_pids | protected) or j["root"] in self_pids | protected or
   275	                (j["name"] is not None and j["name"].startswith("memguard"))):
   276	            del jobs[key]
   277	    targets = {p: d for j in jobs.values() for p, d in j["members"].items()}
   278	    return targets, jobs
