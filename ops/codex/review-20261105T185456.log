   385	def send_mail(msg, log):
   386	    try:
   387	        result = subprocess.run([os.path.join(REPO, "bin/send"), "builder", msg],
   388	                                env={**os.environ, "SEND_FROM": "memguard", "GEMMA_ROLE": "memguard"},
   389	                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
   390	        if result.returncode:
   391	            log(f"  mail failed: exit {result.returncode}")
   392	    except (OSError, subprocess.TimeoutExpired) as exc:
   393	        log(f"  mail failed: {exc}")
