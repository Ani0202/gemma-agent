   178	def verified_records(procs, records):
   179	    """A status pid/PGID alone is never proof of current job ownership."""
   180	    if not records:
   181	        return []
   182	    # Compare the full bash -c wrapper body with our installed bin/job. Fail closed
   183	    # if its layout changes; substring matches could admit unrelated shell scripts.
   184	    source = read(os.path.join(REPO, "bin/job")) or ""
   185	    prefix = "GEMMA_JOB_CAP=$cap setsid nohup bash -c '\n"
   186	    suffix = "    ' _ \"$name\""
   187	    script = source.split(prefix, 1)[1].split(suffix, 1)[0] if prefix in source and suffix in source else None
   188	    verified = []
   189	    for record in records:
   190	        d = procs.get(record["pid"])
   191	        if not d or d["state"] in {"Z", "X"} or d["uid"] != UID:
   192	            continue
   193	        if "starttime" in record:
   194	            if str(d["starttime"]) != str(record["starttime"]):
   195	                continue
   196	        else:
   197	            argv = (read(f"/proc/{record['pid']}/cmdline", "rb") or b"").split(b"\0")
   198	            if not (script is not None and len(argv) >= 6 and
   199	                    os.path.basename(argv[0]) == b"bash" and argv[1] == b"-c" and
   200	                    argv[2] == ("\n" + script).encode() and argv[3] == b"_" and
   201	                    argv[4] == record["name"].encode()):
   202	                continue
   203	        verified.append(record)
   204	    return verified
