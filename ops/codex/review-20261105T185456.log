   396	def main():
   397	    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   398	    ap.add_argument("--interval", type=float, default=2.0)
   399	    ap.add_argument("--min-available", type=float, default=2.5, help="GiB")
   400	    ap.add_argument("--max-total", type=float, default=6.0, help="GiB of summed targeted RSS")
   401	    ap.add_argument("--min-kill-rss", type=float, default=0.25,
   402	                    help="GiB; on low MemAvailable alone, skip jobs smaller than this (killing a waiter frees nothing)")
   403	    ap.add_argument("--log", default=os.path.join(REPO, "ops/logs/memguard.log"))
   404	    ap.add_argument("--once", action="store_true")
   405	    ap.add_argument("--dry-run", action="store_true")
   406	    ap.add_argument("--no-mail", action="store_true")
   407	    args = ap.parse_args()
   408	    for k in ("min_available", "max_total", "min_kill_rss"):
   409	        setattr(args, k, int(getattr(args, k) * GIB))
   410	    os.makedirs(os.path.dirname(args.log), exist_ok=True)
   411	
   412	    def log(msg):
   413	        line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}"
   414	        with open(args.log, "a") as f:
   415	            f.write(line + "\n")
   416	        print(line, flush=True)
   417	
   418	    log(f"start pid={os.getpid()} min_available={args.min_available/GIB:.2f}G max_total={args.max_total/GIB:.2f}G "
   419	        f"dry_run={args.dry_run}")
   420	    last_beat = 0
   421	    jobs = {}
   422	    while True:
   423	        procs = snapshot()
   424	        self_pids = {os.getpid()} | set(ancestors(os.getpid(), procs))
   425	        # Our ancestors include the bin/job wrapper and maybe a Claude shell; they're never targets.
   426	        targets, jobs = find_jobs(procs, args, self_pids, known_jobs=jobs)
   427	        if args.dry_run:
   428	            log(f"targets={sorted(targets)} jobs=" + repr([
   429	                {"name": j["name"], "root": j["root"], "pids": sorted(j["pids"])}
   430	                for j in jobs.values()]))
   431	        raise_oom_adj(targets, args.dry_run, args, jobs)
   432	        avail = mem_available() or 0
   433	        total = sum(j["rss"] for j in jobs.values())
   434	        if time.time() - last_beat > 600:
   435	            log(f"beat avail={avail/GIB:.2f}G targeted_rss={total/GIB:.2f}G jobs={len(jobs)} targets={len(targets)}")
   436	            last_beat = time.time()
   437	        reason = None
   438	        if total > args.max_total:
   439	            reason = f"targeted RSS {total/GIB:.2f}G > {args.max_total/GIB:.2f}G"
   440	        elif avail < args.min_available:
   441	            reason = f"MemAvailable {avail/GIB:.2f}G < {args.min_available/GIB:.2f}G"
   442	        if reason and jobs:
   443	            _, j = max(jobs.items(), key=lambda kv: kv[1]["rss"])
   444	            root = j["root"]
   445	            if total <= args.max_total and j["rss"] < args.min_kill_rss:
   446	                reason = None  # pressure is not ours to fix by killing a tiny job
   447	        if reason and jobs:
   448	            name = j["name"]
   449	            comm = procs.get(root, {}).get("comm", "?")
   450	            log(f"KILL job={name or '-'} root={root} comm={comm} rss={j['rss']/GIB:.2f}G reason: {reason}"
   451	                + (" [dry-run]" if args.dry_run else ""))
   452	            if not args.dry_run:
   453	                killed, surv = kill_tree(j, args, self_pids, log)
   454	                log(f"  killed {len(killed)} pids; survivors={surv}")
   455	                msg = (f"memguard killed job {name or '(job pid %d %s)' % (root, comm)}: "
   456	                       f"{j['rss']/GIB:.2f}G, {reason}. Survivors: {surv or 'none'}. See ops/logs/memguard.log.")
   457	                if name:
   458	                    time.sleep(0.5)
   459	                    try:
   460	                        with open(os.path.join(REPO, "ops/jobs", f"{name}.log"), "a") as f:
   461	                            f.write(f"[memguard] {msg}\n")
   462	                    except OSError:
   463	                        pass
   464	                if not args.no_mail:
   465	                    # Mail may take up to ten seconds; keep polling while it completes.
   466	                    threading.Thread(target=send_mail, args=(msg, log)).start()
   467	        if args.once:
   468	            return 0
   469	        time.sleep(args.interval)
   470	
