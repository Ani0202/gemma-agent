   281	def action_eligible(d, args, known_jobs=None):
   282	    """Refresh the recipient AFTER discovery/protection scans (exec keeps starttime)."""
   283	    initial = proc_info(d["pid"])
   284	    if not initial or initial["starttime"] != d["starttime"]:
   285	        return False
   286	    procs = snapshot()
   287	    # Preserve session ancestry checks when a shell's parent was missed by the scan.
   288	    parent = initial["ppid"]
   289	    while initial["comm"] in SHELL_COMMS and parent and parent not in procs:
   290	        info = proc_info(parent)
   291	        if not info:
   292	            break
   293	        procs[parent] = info
   294	        parent = info["ppid"]
   295	    records = running_jobs()
   296	    verified = verified_records(procs, records)
   297	    protected = protected_watchdogs(procs, records)
   298	    current = proc_info(d["pid"])
   299	    if not current or current["starttime"] != d["starttime"]:
   300	        return False
   301	    if current["comm"] in SHELL_COMMS and current["ppid"] and current["ppid"] not in procs:
   302	        return False
   303	    procs[d["pid"]] = current
   304	    # Re-evaluate fresh recipient metadata against the scanned protections/ancestry.
   305	    return eligible(d["pid"], procs, args, protected, verified, known_jobs)
