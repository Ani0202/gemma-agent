   351	def inventory(job, args, self_pids):
   352	    # Use the same job ID / known legacy identities for every scan, including survivors.
   353	    _, jobs = find_jobs(snapshot(), args, self_pids, known_jobs={job["key"]: job})
   354	    current = jobs.get(job["key"], {})
   355	    job["known_members"].update(current.get("known_members", {}))
   356	    return current.get("members", {})
   357	
   358	
   359	def kill_tree(job, args, self_pids, log):
   360	    """Two empty scans, bounded by five seconds, then an independent survivor inventory."""
   361	    killed = set()
   362	    started = time.monotonic()
   363	    deadline = started + 5
   364	    root_identity = job["members"].get(job["root"])
   365	    empty_scans = 0
   366	    while time.monotonic() < deadline:
   367	        members = inventory(job, args, self_pids)
   368	        # The wrapper gets a grace period to record the child's failure. A new process
   369	        # with the same numeric pid does not inherit this special treatment.
   370	        grace = (root_identity and time.monotonic() < started + 3 and
   371	                 any(p != job["root"] for p in job["members"]))
   372	        for p, d in members.items():
   373	            if grace and p == job["root"] and d["starttime"] == root_identity["starttime"]:
   374	                continue
   375	            if send_kill(d, log, args, {job["key"]: job}):
   376	                killed.add(p)
   377	        empty_scans = empty_scans + 1 if not members else 0
   378	        if empty_scans >= 2 and not grace:
   379	            break
   380	        time.sleep(0.2)
   381	    survivors = sorted(inventory(job, args, self_pids))
   382	    return sorted(killed), survivors
   383	
   384	
   385	def send_mail(msg, log):
   386	    try:
   387	        result = subprocess.run([os.path.join(REPO, "bin/send"), "builder", msg],
   388	                                env={**os.environ, "SEND_FROM": "memguard", "GEMMA_ROLE": "memguard"},
   389	                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
   390	        if result.returncode:
   391	            log(f"  mail failed: exit {result.returncode}")
   392	    except (OSError, subprocess.TimeoutExpired) as exc:
   393	        log(f"  mail failed: {exc}")

