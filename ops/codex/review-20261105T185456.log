   674	@pytest.mark.parametrize("record_kind", ["three", "four", "identity"])
   675	def test_large_unrelated_process_requires_verified_wrapper(monkeypatch, mg, args, record_kind):
   676	    import io
   677	    record = dict(name="work", pid=20, pgid=None if record_kind == "three" else 20)
   678	    if record_kind == "identity":
   679	        record["starttime"] = "123"
   680	    world = mock_world(monkeypatch, mg, {10: proc(10, rss=4 * 1024**3)}, {}, [record])
   681	    # Its cwd is intentionally irrelevant, even when it is /tmp/other-project.
   682	    monkeypatch.setattr(mg.os, "readlink", lambda p: "/tmp/other-project")
   683	    assert mg.find_jobs(world, args, set()) == ({}, {})
   684	    class File(io.StringIO):
   685	        def close(self):
   686	            pass
   687	    output, sent = File(), []
   688	    real_open = open
   689	    def open_oom(path, *a, **kw):
   690	        return output if str(path).endswith("oom_score_adj") else real_open(path, *a, **kw)
   691	    monkeypatch.setattr("builtins.open", open_oom)
   692	    monkeypatch.delattr(mg.os, "pidfd_open", raising=False)
   693	    monkeypatch.setattr(mg.os, "kill", lambda *a: sent.append(a))
   694	    assert mg.send_kill(world[10], lambda _: None, args) is False
   695	    assert mg.raise_oom_adj(world, False, args) == 0
   696	    assert sent == [] and output.getvalue() == ""
   697	    world[20] = proc(20, comm="bash", pgid=20)
   698	    # Sharing a PGID alone is insufficient.
   699	    world[10] = proc(10, pgid=20, rss=4 * 1024**3)
   700	    assert 10 not in mg.find_jobs(world, args, set())[0]
   701	    world[10] = proc(10, ppid=20, pgid=20, rss=4 * 1024**3)
   702	    targets, jobs = mg.find_jobs(world, args, set())
   703	    assert set(targets) == {10, 20}
   704	    assert mg.action_eligible(world[10], args)
   705	    # Retained provenance survives losing both marker and wrapper ancestry.
   706	    del world[20]
   707	    world[10] = proc(10, pgid=99, rss=4 * 1024**3)
   708	    targets, jobs = mg.find_jobs(world, args, set(), known_jobs=jobs)
   709	    assert set(targets) == {10}
   710	    assert mg.raise_oom_adj(targets, False, args, jobs) == 1
   711	    assert mg.send_kill(targets[10], lambda _: None, args, jobs)
   712	    assert sent == [(10, signal.SIGKILL)] and output.getvalue() == "1000"
   713	    world[10] = proc(10, starttime=999, rss=4 * 1024**3)
   714	    assert mg.find_jobs(world, args, set(), known_jobs=jobs) == ({}, {})
