    21	    # Prefer a systemd user scope (caps the whole process tree); after a cron-started boot with no
    22	    # login there is no user manager, so fall back to a per-process ulimit -v.
    23	    rt=/run/user/$(id -u)
    24	    rm -f "ops/jobs/$name.unit"
    25	    if [ -S "$rt/bus" ] && XDG_RUNTIME_DIR=$rt systemd-run --user --scope --quiet -p MemoryMax=64M true 2>/dev/null; then
    26	      unit="gemma-job-$name-$(date +%s)"
    27	      echo "$unit" > "ops/jobs/$name.unit"
    28	      pre=(env XDG_RUNTIME_DIR="$rt" systemd-run --user --scope --quiet --collect --unit="$unit" -p MemoryMax=5G)
