   636	@pytest.mark.parametrize("phase", ["snapshot", "protection"])
   637	def test_recipient_is_refreshed_after_scans(monkeypatch, mg, args, action, change, phase):
   638	    import io
   639	    world = mock_world(monkeypatch, mg, {10: proc(10)}, {10: b"job/boot/123"})
   640	    candidate = world[10]
   641	    def change_recipient():
   642	        if change == "missing":
   643	            world.clear()
   644	        else:
   645	            world[10] = proc(10, comm="node" if change == "node" else "python",
   646	                             starttime=999 if change == "reused" else 123)
   647	    if phase == "snapshot":
   648	        def snapshot():
   649	            change_recipient()
   650	            return dict(world)
   651	        monkeypatch.setattr(mg, "snapshot", snapshot)
   652	    else:
   653	        def protected(procs, records):
   654	            change_recipient()
   655	            return set()
   656	        monkeypatch.setattr(mg, "protected_watchdogs", protected)
   657	    class File(io.StringIO):
   658	        def close(self):
   659	            pass
   660	    output, sent = File(), []
   661	    monkeypatch.setattr("builtins.open", lambda *a, **kw: output)
   662	    monkeypatch.setattr(mg.os, "pidfd_open", lambda p: 42)
   663	    monkeypatch.setattr(mg.os, "close", lambda fd: None)
   664	    monkeypatch.setattr(mg.signal, "pidfd_send_signal", lambda *a: sent.append(a))
   665	    monkeypatch.setattr(mg.os, "kill", lambda *a: sent.append(a))
   666	    if action == "signal":
   667	        assert mg.send_kill(candidate, lambda _: None, args) is False
   668	    else:
   669	        assert mg.raise_oom_adj({10: candidate}, False, args) == 0
   670	    assert sent == []
   671	    assert output.getvalue() == ""
