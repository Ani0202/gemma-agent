   308	def send_kill(d, log, args, known_jobs=None):
   309	    """Pin a pidfd before the final identity check; never signal a recycled pid."""
   310	    fd = None
   311	    try:
   312	        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
   313	            try:
   314	                fd = os.pidfd_open(d["pid"])
   315	            except OSError as exc:
   316	                if exc.errno not in (errno.ENOSYS, errno.EINVAL, errno.EPERM):
   317	                    raise
   318	        if not action_eligible(d, args, known_jobs):
   319	            return False
   320	        if fd is not None:
   321	            signal.pidfd_send_signal(fd, signal.SIGKILL)
   322	        else:
   323	            os.kill(d["pid"], signal.SIGKILL)
   324	        return True
   325	    except ProcessLookupError:
   326	        return False
   327	    except OSError as exc:
   328	        log(f"  cannot kill {d['pid']}: {exc}")
   329	        return False
   330	    finally:
   331	        if fd is not None:
   332	            os.close(fd)
