   314	def test_memguard_kills_job_tree_and_spares_dummy(tmp_path, mg, args):
   315	    marker = "GEMMA_JOB_ID"
   316	    job_id = "mgtest-workload/" + uuid.uuid4().hex
   317	    root = tmp_path / "jobcwd"
   318	    root.mkdir()
   319	    rcfile = tmp_path / "rc"
   320	    log = tmp_path / "memguard.log"
   321	    env_clean = {k: v for k, v in os.environ.items()
   322	                 if k not in {"GEMMA_JOB_CAP", "GEMMA_JOB_ID"} and not k.startswith("GEMMA_MGTEST_")}
   323	    # Both allocators peak at 1.2 GiB each, with only small interpreter/wrapper overhead.
   324	    dummy = subprocess.Popen([sys.executable, "-c", ALLOC], cwd="/", env=env_clean)
   325	    baseline = Path(f"/proc/{dummy.pid}/oom_score_adj").read_text().strip()
   326	    job = subprocess.Popen(["bash", "-c", '"$PYTHON" -c "$CHILD_SRC"; echo $? > "$RCFILE"'],
   327	                           cwd=root, start_new_session=True,
   328	                           env={**env_clean, marker: job_id, "CHILD_SRC": CHILD,
   329	                                "PYTHON": sys.executable, "RCFILE": str(rcfile)})
   330	    guard = None
   331	    try:
   332	        time.sleep(3)
   333	        assert len(marked_live(mg, marker, job_id)) >= 3
   334	        # Confine the live guard's discovery to this test's unique job identity.
   335	        # Production admission remains fixed to GEMMA_JOB_ID; no private marker bypass.
   336	        guard_source = f"""
   337	import os, types
   338	from pathlib import Path
   339	module = types.ModuleType("memguard_test")
   340	module.__file__ = {str(MG)!r}
   341	exec(compile(Path(module.__file__).read_text(), module.__file__, "exec"), module.__dict__)
   342	snapshot = module.snapshot
   343	module.snapshot = lambda: {{p: d for p, d in snapshot().items()
   344	    if p == os.getpid() or module.marker_value(p, "GEMMA_JOB_ID") == {job_id.encode()!r}}}
   345	module.main()
   346	"""
   347	        guard = subprocess.Popen(
   348	            [sys.executable, "-c", guard_source, "--max-total", "0.8", "--min-available", "0",
   349	             "--interval", "0.5",
   350	             "--log", str(log), "--no-mail"], env=env_clean,
   351	            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
   352	        deadline = time.monotonic() + 30
   353	        while time.monotonic() < deadline and "survivors=" not in (log.read_text() if log.exists() else ""):
   354	            time.sleep(0.2)
   355	        text = log.read_text()
   356	        assert "KILL" in text and "survivors=[]" in text, text
   357	        job.wait(timeout=10)
   358	        assert marked_live(mg, marker, job_id) == set(), "fresh inventory found marked survivors"
   359	        assert rcfile.read_text().strip() == "137"
   360	        assert mg.proc_info(dummy.pid)["state"] not in {"Z", "X"}
   361	        assert mg.marker_value(dummy.pid, "GEMMA_JOB_CAP") is None
   362	        assert Path(f"/proc/{dummy.pid}/oom_score_adj").read_text().strip() == baseline
   363	        assert text.count("KILL") == 1, text
   364	    finally:
   365	        if guard and guard.poll() is None:
   366	            guard.kill()
   367	            guard.wait(timeout=5)
   368	        # Discover descendants and marked orphans BEFORE killing their parents.
   369	        procs = mg.snapshot()
   370	        cleanup = set(mg.descendants(job.pid, procs)) | marked_live(mg, marker, job_id)
   371	        for p in sorted(cleanup - {job.pid}):
