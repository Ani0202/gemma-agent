     2	# Detached long-running jobs that survive the end of a Claude cycle.
     3	#   bin/job start <name> -- <command...>   bin/job status [name]   bin/job tail <name> [lines]   bin/job kill <name>
     4	# Writes ops/jobs/<name>.status: "running <pid> <start> <pgid>" -> "done 0 <end>" / "failed <rc> <end>"
     5	set -uo pipefail
     6	cd "$(dirname "$0")/.." || exit 1
