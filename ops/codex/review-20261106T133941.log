    69	        elif not any(m <= set(r) for m in META_KEYS):
    70	            raise AssertionError(f'unrecognized non-row record in {path}: keys {sorted(r)[:8]}')
    71	    ids = [r['instance_id'] for r in out]
    72	    assert len(ids) == len(set(ids)), f'duplicate instance_id rows in {path}'
    73	    return out
