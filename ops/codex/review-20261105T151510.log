     1	#!/usr/bin/env bash
     2	# Send a message to another role. Usage: bin/send <builder|director|paper|aniket> "<message>"
     3	# builder/director/paper: delivered into their session by bin/router when they're idle.
     4	# aniket: pushed to his phone via ntfy (no competition data!).
     5	set -euo pipefail
     6	cd "$(dirname "$0")/.."
     7	to=$1; shift; msg="$*"; from=${GEMMA_ROLE:-${SEND_FROM:-router}}
     8	case "$to" in
     9	  builder|director|paper)
    10	    mkdir -p "ops/mail/$to"
    11	    f="ops/mail/$to/$(date -u +%Y%m%dT%H%M%S)-$RANDOM-from-$from.md"
    12	    printf 'From: %s\nTime: %s UTC\n\n%s\n' "$from" "$(date -u +%FT%T)" "$msg" > "$f"
    13	    echo "queued $f" ;;
    14	  aniket) bin/notify default "Gemma ($from)" "$msg"; echo "pushed to phone" ;;
    15	  *) echo "usage: bin/send <builder|director|paper|aniket> <message>"; exit 2 ;;
    16	esac

