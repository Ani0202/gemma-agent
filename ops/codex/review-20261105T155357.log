   239	def runner_source_sha():
   240	    """Content hash of the runner implementation as it is on disk (tracked or untracked,
   241	    committed or not). Generated artifacts (results, runs, caches) live outside eval/ or are
   242	    not .py, so writing the journal never changes the identity; tests are excluded."""
   243	    listing = subprocess.check_output(['git', 'ls-files', '-z', '--cached', '--others',
   244	                                       '--exclude-standard', '--', RUNNER_SOURCE_DIR], cwd=ROOT)
   245	    files = sorted({f for f in listing.decode('utf-8', 'surrogateescape').split('\0')
   246	                    if f.endswith('.py') and not f.startswith(f'{RUNNER_SOURCE_DIR}/tests/')})
   247	    digest = hashlib.sha256()
   248	    for rel in files:
   249	        path = ROOT / rel
   250	        if path.is_file():  # a deleted tracked file drops out of the hash
   251	            digest.update(rel.encode('utf-8', 'surrogateescape') + b'\0'
   252	                          + hashlib.sha256(path.read_bytes()).digest())
   253	    return digest.hexdigest()
