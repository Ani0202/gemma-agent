   382	def _source_repo(tmp_path, monkeypatch):
   383	    repo = tmp_path / 'repo'
   384	    (repo / 'eval' / 'tests').mkdir(parents=True)
   385	    (repo / 'results').mkdir()
   386	    (repo / 'eval' / 'impl.py').write_text('X = 1\n')
   387	    (repo / 'eval' / 'tests' / 'test_x.py').write_text('pass\n')
   388	    (repo / '.gitignore').write_text('__pycache__/\n')
   389	    git = lambda *a: subprocess.run(['git', '-c', 'user.email=t@t', '-c', 'user.name=t', *a],
   390	                                    cwd=repo, check=True, capture_output=True)
   391	    git('init', '-q'); git('add', '-A'); git('commit', '-qm', 'init')
   392	    monkeypatch.setattr(runner, 'ROOT', repo)
   393	    return repo
