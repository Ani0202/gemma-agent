   275	def config_snapshot(value):
   276	    if dataclasses.is_dataclass(value):
   277	        return {f.name: config_snapshot(getattr(value, f.name)) for f in dataclasses.fields(value)
   278	                if f.name != 'models'}
   279	    if hasattr(value, 'model_dump'):
   280	        return value.model_dump(mode='json')
   281	    if isinstance(value, dict):
   282	        return {k: config_snapshot(v) for k, v in value.items()}
   283	    if isinstance(value, (list, tuple, set, frozenset)):
   284	        values = [config_snapshot(v) for v in value]
   285	        return sorted(values) if isinstance(value, (set, frozenset)) else values
   286	    if isinstance(value, Path):
   287	        return str(value)
   288	    return value
