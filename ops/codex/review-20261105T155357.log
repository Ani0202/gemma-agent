   326	def build_config(defaults, args, models, raw_dir, caps):
   327	    from swegemma import config as sc
   328	    from swegemma.budget import EvaluationBudget, HarnessLimits
   329	    names = {f.name for f in dataclasses.fields(sc.EvalConfig)}
   330	    for key in defaults.keys() - names:
   331	        logging.warning('Unknown EvalConfig key: %s', key)
   332	    options = {k: v for k, v in defaults.items() if k in names}
   333	    types = dict(budget=EvaluationBudget, harness=HarnessLimits,
   334	                 limits=sc.SubmissionLimits, generation_constraints=sc.GenerationConstraints,
   335	                 context_cache_config=sc.ContextCacheConfig,
   336	                 events_compaction_config=sc.EventsCompactionConfig,
   337	                 adapter_manifest=sc.AdapterManifest)
   338	    for key, cls in types.items():
   339	        if isinstance(options.get(key), dict):
   340	            options[key] = cls(**options[key])
   341	    paths = dict(tasks_path=args.data_dir / 'tasks.jsonl', snapshots_dir=args.data_dir / 'snapshots',
   342	                 wheels_dir=args.data_dir / 'wheels', results_dir=raw_dir, submission_dir=args.bundle)
   343	    # Explicit CLI runtime settings own these fields. Other bundle fields pass through.
   344	    options.update(paths, models=models, sandbox='subprocess', concurrency=args.concurrency,
   345	                   display_mode='quiet', **caps)
   346	    for key, fallback in [('graph_dir', 'graphs'), ('embeddings_dir', 'embeddings')]:
   347	        path = Path(options.get(key, fallback))
   348	        options[key] = str((path if path.is_absolute() else args.data_dir / path).resolve())
   349	    return sc.EvalConfig(**options)
