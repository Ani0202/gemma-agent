   258	    # HEAD moves on every ops commit, and the default journal itself dirties the tree.
   259	    return dict(runner_source_sha256=runner_source_sha(),
   260	                provenance=dict(git_sha=subprocess.check_output(['git', 'rev-parse', 'HEAD'],
   261	                                                                cwd=ROOT, text=True).strip(),
   262	                                git_dirty=bool(subprocess.check_output(['git', 'status', '--porcelain'],
   263	                                                                       cwd=ROOT))))
