   199	    """Retain the agent's diff before the harness removes protected edits."""
   200	    def strip(patch, *pos, **kw):
   201	        current = state.get(None)
   202	        filtered = original(patch, *pos, **kw)
   203	        if current is not None and current.get('agent_active'):
   204	            if patch != current.get('filtered_patch'):
   205	                current['raw_patch'] = patch
   206	            current['filtered_patch'] = filtered
   207	        return filtered
   208	    return strip
