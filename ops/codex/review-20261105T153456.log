     1	"""Per-task monotonic ADK tool timing, usable by the Kaggle timing kernel.
     2	
     3	No harness dependencies are imported until installation. Call IDs, rather than
     4	names or merged trace response timestamps, identify overlapping executions.
     5	"""
     6	from contextvars import ContextVar
     7	from dataclasses import dataclass, field
     8	import time
     9	
    10	current_timing = ContextVar('current_tool_timing', default=None)
    11	
    12	
    13	@dataclass
    14	class ToolTiming:
    15	    pending: dict = field(default_factory=dict)
    16	    seconds: dict = field(default_factory=dict)
    17	    unmatched: int = 0
    18	    completed: set = field(default_factory=set)
    19	
    20	    def before(self, call_id, name):
    21	        if not call_id:
    22	            self.unmatched += 1
    23	            return
    24	        if call_id in self.pending or call_id in self.completed:
    25	            self.unmatched += 1
    26	            return
    27	        self.pending[call_id] = (name, time.monotonic())
    28	
    29	    def after(self, call_id):
    30	        # Error callbacks may be followed by after_tool_callback on recovery.
    31	        if call_id in self.completed:
    32	            return
    33	        item = self.pending.pop(call_id, None)
    34	        if item is None:
    35	            self.unmatched += 1
    36	            return
    37	        name, start = item
    38	        elapsed = time.monotonic() - start
    39	        stat = self.seconds.setdefault(name, dict(n=0, total=0.0, max=0.0))
    40	        stat['n'] += 1
    41	        stat['total'] += elapsed
    42	        stat['max'] = max(stat['max'], elapsed)
    43	        self.completed.add(call_id)
    44	
    45	    def metrics(self):
    46	        return dict(tool_seconds=self.seconds,
    47	                    tool_calls_timed=sum(s['n'] for s in self.seconds.values()),
    48	                    tool_seconds_unmatched=self.unmatched + len(self.pending))
    49	
    50	
    51	def make_timing_plugin():
    52	    from google.adk.plugins.base_plugin import BasePlugin
    53	
    54	    class TimingPlugin(BasePlugin):
    55	        def __init__(self):
    56	            super().__init__(name='eval_tool_timing')
    57	
    58	        async def before_tool_callback(self, *, tool, tool_args, tool_context):
    59	            state = current_timing.get()
    60	            if state is not None:
    61	                state.before(tool_context.function_call_id, tool.name)
    62	
    63	        async def after_tool_callback(self, *, tool, tool_args, tool_context, result):
    64	            state = current_timing.get()
    65	            if state is not None:
    66	                state.after(tool_context.function_call_id)
    67	
    68	        async def on_tool_error_callback(self, *, tool, tool_args, tool_context, error):
    69	            state = current_timing.get()
    70	            if state is not None:
    71	                state.after(tool_context.function_call_id)
    72	
    73	    return TimingPlugin()
    74	
    75	
    76	def install_harness_timing():
    77	    """Installed swegemma builds an App with plugins; prepend ours to that list.
    78	
    79	    Prepending ensures timing runs before any error-recovery callback short
    80	    circuits the plugin chain. It also covers MCP and agent_tool subclasses.
    81	    Returns a restoration function for callers embedding the runner.
    82	    """
    83	    import swegemma.harness.agent_runner as ar
    84	    original = ar.App
    85	
    86	    def app(*args, **kwargs):
    87	        kwargs['plugins'] = [make_timing_plugin(), *kwargs.get('plugins', [])]
    88	        return original(*args, **kwargs)
    89	
    90	    ar.App = app
    91	
    92	    def restore():
    93	        ar.App = original
    94	
    95	    return restore

