    13	@dataclass
    14	class ToolTiming:
    15	    pending: dict = field(default_factory=dict)
    16	    seconds: dict = field(default_factory=dict)
    17	    unmatched: int = 0
    18	    completed: set = field(default_factory=set)
    19	
    20	    def before(self, call_id, name):
    21	        if not call_id:
    22	            self.unmatched += 1
    23	            return
    24	        if call_id in self.pending or call_id in self.completed:
    25	            self.unmatched += 1
    26	            return
    27	        self.pending[call_id] = (name, time.monotonic())
    28	
    29	    def after(self, call_id):
    30	        # Error callbacks may be followed by after_tool_callback on recovery.
    31	        if call_id in self.completed:
    32	            return
    33	        item = self.pending.pop(call_id, None)
    34	        if item is None:
    35	            self.unmatched += 1
    36	            return
    37	        name, start = item
    38	        elapsed = time.monotonic() - start
    39	        stat = self.seconds.setdefault(name, dict(n=0, total=0.0, max=0.0))
    40	        stat['n'] += 1
    41	        stat['total'] += elapsed
    42	        stat['max'] = max(stat['max'], elapsed)
    43	        self.completed.add(call_id)
    44	
    45	    def metrics(self):
    46	        return dict(tool_seconds=self.seconds,
    47	                    tool_calls_timed=sum(s['n'] for s in self.seconds.values()),
    48	                    tool_seconds_unmatched=self.unmatched + len(self.pending))
