   178	                                              snapshots_dir=data_dir / 'snapshots'))
   179	    ro = [wheels.resolve()] if wheels else []
   180	    try:
   181	        if not shutil.which('bwrap'):
   182	            raise RuntimeError('bubblewrap is not installed')
   183	        # First check the empty inventory mask before mounting its wheelhouse
   184	        # child. Then repeat with the complete runtime mounts: wheels may be
   185	        # visible under data_dir, but the inventory must remain inaccessible.
   186	        template = apply_isolation(hidden, [])
   187	        probe_isolation(SubprocessManager(), data_dir / 'tasks.jsonl', data_dir)
   188	        apply_isolation(hidden, ro)
   189	        probe_isolation(SubprocessManager(), data_dir / 'tasks.jsonl', data_dir, empty_data=False)
   190	        mode = 'bwrap'
   191	    except Exception:
   192	        # Never leave an unusable boundary or silently downgrade its protection.
   193	        apply_isolation([], ro)
   194	        if not allow_unsandboxed:
   195	            raise
   196	        mode, template = 'none', None
   197	        import logging
   198	        logging.warning('bubblewrap unavailable/probe failed; explicitly allowed unsandboxed run',
   199	                        exc_info=True)
   200	    return dict(sandbox=mode, bwrap_argv_template=template, patched=patched,
   201	                wheels_dir=wheels)
