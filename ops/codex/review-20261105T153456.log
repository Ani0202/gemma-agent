   267	def build_config(defaults, args, models, raw_dir, caps):
   268	    from swegemma import config as sc
   269	    from swegemma.budget import EvaluationBudget, HarnessLimits
   270	    names = {f.name for f in dataclasses.fields(sc.EvalConfig)}
   271	    for key in defaults.keys() - names:
   272	        logging.warning('Unknown EvalConfig key: %s', key)
   273	    options = {k: v for k, v in defaults.items() if k in names}
   274	    types = dict(budget=EvaluationBudget, harness=HarnessLimits,
   275	                 limits=sc.SubmissionLimits, generation_constraints=sc.GenerationConstraints,
   276	                 context_cache_config=sc.ContextCacheConfig,
   277	                 events_compaction_config=sc.EventsCompactionConfig,
   278	                 adapter_manifest=sc.AdapterManifest)
   279	    for key, cls in types.items():
   280	        if isinstance(options.get(key), dict):
   281	            options[key] = cls(**options[key])
   282	    paths = dict(tasks_path=args.data_dir / 'tasks.jsonl', snapshots_dir=args.data_dir / 'snapshots',
   283	                 wheels_dir=args.data_dir / 'wheels', results_dir=raw_dir, submission_dir=args.bundle)
   284	    # Explicit CLI runtime settings own these fields. Other bundle fields pass through.
   285	    options.update(paths, models=models, sandbox='subprocess', concurrency=args.concurrency,
   286	                   display_mode='quiet', **caps)
   287	    for key, fallback in [('graph_dir', 'graphs'), ('embeddings_dir', 'embeddings')]:
   288	        path = Path(options.get(key, fallback))
   289	        options[key] = str((path if path.is_absolute() else args.data_dir / path).resolve())
   290	    return sc.EvalConfig(**options)
