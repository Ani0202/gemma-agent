   216	def decode_git_path(raw):
   217	    # Git C-quotes UTF-8 bytes using octal escapes, which JSON doesn't accept.
   218	    # literal_eval on bytes understands both octal and ordinary C escapes.
   219	    escaped = ''.join(c if ord(c) < 128 else ''.join(f'\\{b:03o}' for b in c.encode())
   220	                      for c in raw)
   221	    return ast.literal_eval('b' + escaped).decode('utf-8', errors='surrogateescape')
