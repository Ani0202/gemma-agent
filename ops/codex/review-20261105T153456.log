   238	    import swegemma.harness.container_setup as cs
   239	    import swegemma.harness.verification as vf
   240	    import swegemma.harness.sample_verification  # load all known by-name bindings
   241	    import swegemma.evaluate
   242	    import swegemma.cli
   243	    import swegemma.harness.agent_runner
   244	    orig = getattr(cs.install_test_dependencies, '_scorer_original', cs.install_test_dependencies)
   245	    previous = cs.install_test_dependencies
   246	    wheels_src = Path(data_dir) / 'wheels'
   247	    if not wheels_src.is_dir():
   248	        wheels_src = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')
   249	    setup_py = Path(data_dir) / 'sandbox' / 'setup.py'
   250	    if not setup_py.exists():
   251	        setup_py = next(iter(Path(data_dir).rglob('setup.py')), setup_py)  # competition sandbox/setup.py
   252	
   253	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   254	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   255	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   256	        venv_dir = docker.sandboxes[container_id]['venv']
   257	        sp_dir = next(iter(sorted(venv_dir.glob('lib/python3*/site-packages'))))
   258	        base_wheels, large_wheels, _m2p, _req = cs._inspect_wheels_dir(wheels_src)
