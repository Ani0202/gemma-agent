   242	def wheels_listing_sha(path):
   243	    listing = []
   244	    if path:
   245	        for p in sorted(Path(path).rglob('*')):
   246	            listing.append((p.relative_to(path).as_posix(), p.stat().st_size,
   247	                            str(p.resolve()) if p.is_symlink() else None))
   248	    return hashlib.sha256(json.dumps(listing, sort_keys=True).encode()).hexdigest()
