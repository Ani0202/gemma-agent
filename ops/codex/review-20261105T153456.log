   226	def patch_subprocess_deps(data_dir):
   227	    """Emulate the docker-only dependency setup for the subprocess sandbox (swegemma skips it).
   228	
   229	    Contract (swegemma 0.2.11 container_setup): for docker, _ensure_container_site_packages
   230	    unpacks every deduplicated (highest-version, py313-compatible) wheel from wheels_dir that is
   231	    < 20 MB and not in skip_base_pkgs (pytest, pluggy, ... come from the image) straight into
   232	    site-packages, no resolver; large wheels are added only if imported by the workspace; then
   233	    sandbox/setup.py runs with --fast-path. We replicate exactly that inside the sandbox venv.
   234	    The sandbox venv uses system_site_packages=True, so the HOST python must mirror the image
   235	    (Dockerfile.public: pytest, pytest-timeout==2.1.0, typer, build backends; nothing else).
   236	    """
