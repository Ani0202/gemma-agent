    63	def runtime_ro_paths(workspace, ro_paths):
    64	    root = Path(workspace).resolve().parent
    65	    cfg = (root / 'venv/pyvenv.cfg').read_text()
    66	    home = next(line.split('=', 1)[1].strip() for line in cfg.splitlines()
    67	                if line.startswith('home ='))
    68	    prefix = Path(home).resolve().parent
    69	    if prefix != Path(sys.base_prefix).resolve():
    70	        raise ValueError('Sandbox python prefix differs from the scorer interpreter')
    71	    # Keep the unresolved alias too; bwrap_argv binds the resolved target there.
    72	    paths = {prefix, Path(home).absolute().parent, *(Path(p).resolve() for p in ro_paths)}
    73	    def wheel_target(path):
    74	        target = path.resolve()
    75	        # Agent-created symlinks must not turn an arbitrary directory into a
    76	        # new read-only exposure. Only wheel files or trusted wheelhouse subdirs
    77	        # can be reached through symlinks; a file mount cannot expose siblings.
    78	        if not (target.is_file() and target.suffix == '.whl') and not any(
    79	                target.is_relative_to(Path(p).resolve()) for p in ro_paths):
    80	            raise ValueError('Untrusted wheel symlink target')
    81	        paths.add(target)
    82	
    83	    wheels = root / 'wheels'
    84	    if wheels.is_symlink():
    85	        wheel_target(wheels)
    86	    for path in wheels.rglob('*'):
    87	        if path.is_symlink():
    88	            wheel_target(path)
    89	    return paths
