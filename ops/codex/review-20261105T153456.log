   164	def setup_scorer_env(data_dir, *, out_dir=None, repo_root=None, allow_unsandboxed=False):
   165	    """Common subprocess scorer setup for evaluation and gold calibration."""
   166	    from swegemma.sandbox import SubprocessManager
