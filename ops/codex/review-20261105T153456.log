   145	def classify_patch(patch, repo, protected=None, test_targets=()):
   146	    """Parse file headers outside hunks, including quoted paths and renames."""
   147	    files, new = set(), set()
   148	    current, added, in_hunk = set(), False, False
   149	
   150	    def path_value(raw):
   151	        raw = raw.split('\t', 1)[0]
   152	        value = decode_git_path(raw) if raw.startswith('"') else raw
   153	        return value[2:] if value.startswith(('a/', 'b/')) else value
   154	
   155	    for line in patch.splitlines() + ['diff --git ']:
   156	        if line.startswith('diff --git '):
   157	            files.update(current)
   158	            if added:
   159	                new.update(current)
   160	            current, added, in_hunk = set(), False, False
   161	            match = re.match(r'^diff --git ("a/.*?"|a/.*?) ("b/.*?"|b/.*)$', line)
   162	            if match:
   163	                current.update(path_value(p) for p in match.groups())
   164	        elif line.startswith('@@'):
   165	            in_hunk = True
   166	        elif not in_hunk:
   167	            if line.startswith(('--- ', '+++ ')):
   168	                p = path_value(line[4:])
   169	                if p != '/dev/null':
   170	                    current.add(p)
   171	                elif line.startswith('--- '):
   172	                    added = True
   173	            elif line.startswith('new file mode '):
   174	                added = True
   175	            elif line.startswith(('rename from ', 'rename to ')):
   176	                current.add(path_value(line.split(' ', 2)[2]))
   177	    if protected is None:
   178	        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
   179	    tests = sorted(p for p in files if protected(p) or p in test_targets)
   180	    package = repo.split('/')[-1].replace('-', '_').lower()
   181	    source_roots = (package + '/', 'src/' + package + '/')
   182	    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
   183	                                         and p not in tests))
   184	    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
   185	                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())
