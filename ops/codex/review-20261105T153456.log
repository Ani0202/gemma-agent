    93	    """Single writer lock, durable appends, and repair of an interrupted final write."""
    94	    def __init__(self, path, header, force=False):
    95	        path.parent.mkdir(parents=True, exist_ok=True)
    96	        self.stream = path.open('a+b')
    97	        fcntl.flock(self.stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
    98	        self.stream.seek(0)
    99	        lines = self.stream.read().splitlines(keepends=True)
   100	        self.finished = set()
   101	        try:
   102	            if lines and not force:
   103	                old = json.loads(lines[0])
   104	                identity = (old.keys() | header.keys()) - {'created_utc'}
   105	                diff = {k: {'old': old.get(k), 'new': header.get(k)}
   106	                        for k in sorted(identity) if old.get(k) != header.get(k)}
   107	                if diff:
   108	                    raise ValueError('Results header mismatch; use --force-new-out or a new run name: '
   109	                                     + json.dumps(diff, default=str, sort_keys=True))
   110	                valid_bytes = len(lines[0])
   111	                for i, line in enumerate(lines[1:], 1):
   112	                    try:
   113	                        row = json.loads(line)
   114	                    except json.JSONDecodeError:
   115	                        if i == len(lines) - 1 and not line.endswith(b'\n'):
   116	                            self.stream.truncate(valid_bytes)
   117	                            break
   118	                        raise ValueError('Corrupt results record') from None
   119	                    if (not isinstance(row.get('instance_id'), str)
   120	                            or type(row.get('resolved')) is not bool or '_schema' in row):
   121	                        raise ValueError('Invalid task record')
   122	                    self.finished.add(row['instance_id'])
   123	                    valid_bytes += len(line)
   124	                else:
   125	                    if not lines[-1].endswith(b'\n'):
   126	                        self.stream.write(b'\n')
   127	            else:
   128	                self.stream.truncate(0)
   129	                self.append(header)
   130	        except BaseException:
   131	            self.close()
   132	            raise
   133	
   134	    def append(self, row):
   135	        self.stream.write((json.dumps(row, allow_nan=False) + '\n').encode())
   136	        self.stream.flush()
   137	        os.fsync(self.stream.fileno())
   138	        if 'instance_id' in row:
   139	            self.finished.add(row['instance_id'])
   140	
   141	    def close(self):
   142	        self.stream.close()
