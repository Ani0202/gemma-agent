    if bad:
        raise RuntimeError('Unpatched dependency bindings: ' + ', '.join(bad))


def sha_file(path):
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            digest.update(chunk)
    return digest.hexdigest()


def bundle_sha(bundle):
    digest = hashlib.sha256()
    for path in sorted(bundle.rglob('*')):
        if path.is_symlink():
            raise ValueError('Bundle symlinks are unsupported')
        if path.is_file():
            digest.update(path.relative_to(bundle).as_posix().encode() + b'\0')
            digest.update(bytes.fromhex(sha_file(path)))
    return digest.hexdigest()


class Journal:
    """Single writer lock, durable appends, and repair of an interrupted final write."""
    def __init__(self, path, header, force=False):
        path.parent.mkdir(parents=True, exist_ok=True)
        self.stream = path.open('a+b')
        fcntl.flock(self.stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        self.stream.seek(0)
        lines = self.stream.read().splitlines(keepends=True)
        self.finished = set()
        try:
            if lines and not force:
                old = json.loads(lines[0])
                identity = (old.keys() | header.keys()) - {'created_utc'}
                diff = {k: {'old': old.get(k), 'new': header.get(k)}
                        for k in sorted(identity) if old.get(k) != header.get(k)}
                if diff:
                    raise ValueError('Results header mismatch; use --force-new-out or a new run name: '
                                     + json.dumps(diff, default=str, sort_keys=True))
                valid_bytes = len(lines[0])
                for i, line in enumerate(lines[1:], 1):
                    try:
                        row = json.loads(line)
                    except json.JSONDecodeError:
                        if i == len(lines) - 1 and not line.endswith(b'\n'):
                            self.stream.truncate(valid_bytes)
                            break
                        raise ValueError('Corrupt results record') from None
                    if (not isinstance(row.get('instance_id'), str)
                            or type(row.get('resolved')) is not bool or '_schema' in row):
                        raise ValueError('Invalid task record')
                    self.finished.add(row['instance_id'])
                    valid_bytes += len(line)
                else:
                    if not lines[-1].endswith(b'\n'):
                        self.stream.write(b'\n')
            else:
                self.stream.truncate(0)
                self.append(header)
        except BaseException:
            self.close()
            raise

    def append(self, row):
        self.stream.write((json.dumps(row, allow_nan=False) + '\n').encode())
        self.stream.flush()
        os.fsync(self.stream.fileno())
        if 'instance_id' in row:
            self.finished.add(row['instance_id'])

    def close(self):
        self.stream.close()


def classify_patch(patch, repo, protected=None, test_targets=()):
    """Parse file headers outside hunks, including quoted paths and renames."""
    files, new = set(), set()
    current, added, in_hunk = set(), False, False

    def path_value(raw):
        raw = raw.split('\t', 1)[0]
        value = decode_git_path(raw) if raw.startswith('"') else raw
        return value[2:] if value.startswith(('a/', 'b/')) else value

    for line in patch.splitlines() + ['diff --git ']:
        if line.startswith('diff --git '):
            files.update(current)
            if added:
                new.update(current)
            current, added, in_hunk = set(), False, False
            match = re.match(r'^diff --git ("a/.*?"|a/.*?) ("b/.*?"|b/.*)$', line)
            if match:
                current.update(path_value(p) for p in match.groups())
        elif line.startswith('@@'):
            in_hunk = True
        elif not in_hunk:
            if line.startswith(('--- ', '+++ ')):
                p = path_value(line[4:])
                if p != '/dev/null':
                    current.add(p)
                elif line.startswith('--- '):
                    added = True
            elif line.startswith('new file mode '):
                added = True
            elif line.startswith(('rename from ', 'rename to ')):
                current.add(path_value(line.split(' ', 2)[2]))
    if protected is None:
        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
    tests = sorted(p for p in files if protected(p) or p in test_targets)
    package = repo.split('/')[-1].replace('-', '_').lower()
    source_roots = (package + '/', 'src/' + package + '/')
    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
                                         and p not in tests))
    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())


def trace_counts(trace):
    entries = trace.entries if trace else []
    counts = Counter(e.tool_name for e in entries if e.event_type == 'tool_call')
    tokens = {}
    for key in ('prompt_tokens', 'completion_tokens'):
        values = [e.usage[key] for e in entries if e.usage and key in e.usage]
        tokens[key] = sum(values) if values else None
    return dict(counts), tokens, {}


def observe_patch_strip(original, state):
    """Retain the agent's diff before the harness removes protected edits."""
    def strip(patch, *pos, **kw):
        current = state.get(None)
        filtered = original(patch, *pos, **kw)
        if current is not None and current.get('agent_active'):
            if patch != current.get('filtered_patch'):
                current['raw_patch'] = patch
            current['filtered_patch'] = filtered
        return filtered
    return strip


def read_ids(path):
    return {line.strip() for line in path.read_text().splitlines()
            if line.strip() and not line.lstrip().startswith('#')}


@pytest.mark.skipif(os.environ.get('RUN_AGENT_EVAL_E2E') != '1', reason='opt-in real harness smoke test')
@pytest.mark.parametrize('transport', ['http', 'in_memory'])
def test_e2e(tmp_path, monkeypatch, transport):
    iid = sorted(runner.read_ids(ROOT / 'eval/splits/dev.txt'))[0]
    name = 'stub-eval'
    data = tmp_path / 'inventory'
    (data / 'snapshots').mkdir(parents=True)
    (data / 'wheels').mkdir()
    (data / 'sandbox').mkdir()
    (data / 'sandbox/setup.py').write_text('# Synthetic offline setup needs no dependencies.\n')
    source = tmp_path / 'source'
    source.mkdir()
    (source / 'module.py').write_text('VALUE = 0\n')
    subprocess.run(['git', 'init', '-q', str(source)], check=True)
    subprocess.run(['git', '-C', str(source), 'config', 'user.name', 'Offline Test'], check=True)
    subprocess.run(['git', '-C', str(source), 'config', 'user.email', 'offline@example.invalid'], check=True)
    with tarfile.open(data / 'snapshots' / (iid + '.tgz'), 'w:gz') as archive:
        archive.add(source, arcname='.')
    test_patch = diff('test_smoke.py', new='def test_smoke(): assert __import__("module").VALUE == 1', added=True)
    (data / 'tasks.jsonl').write_text(json.dumps(dict(instance_id=iid, repo='org/module',
        base_commit='synthetic', problem_statement='Set VALUE to 1 in module.py.',
        patch=diff('module.py', 'VALUE = 0', 'VALUE = 1'), test_patch=test_patch,
        FAIL_TO_PASS=['test_smoke.py::test_smoke'])) + '\n')
    split = tmp_path / 'dev.txt'
    split.write_text(iid + '\n')
    bundle = tmp_path / 'bundle'
    bundle.mkdir()
    (bundle / 'agent.yaml').write_text('name: smoke_agent\nmodel: gemma-4-e4b-it-qat-w4a16-ct\n'
        'instruction: Fix the issue.\ntools:\n  - run_command\n  - submit_patch\n')
    (bundle / 'eval_config.yaml').write_text('evaluation:\n  verification_timeout_seconds: 30\n')
    out = tmp_path / 'out'
    script = tmp_path / 'script.json'
    # A synthetic source fix exercises tool execution, patch capture and verification.
    script.write_text(json.dumps([
        dict(content=None, tool_calls=[dict(id='call_1', type='function', function=dict(
            name='run_command', arguments=json.dumps({'command': 'printf "VALUE = 1\\n" > module.py'})))]),
        dict(content=None, tool_calls=[dict(id='call_2', type='function', function=dict(
            name='submit_patch', arguments='{}'))]), dict(content='Done.')]))
    argv = ['--bundle', str(bundle), '--data-dir', str(data), '--out', str(out),
            '--split', str(split), '--allow-unsandboxed', '--ids', iid, '--run-name', name,
            '--concurrency', '1', '--skip-selfcheck', '--max-turns', '4', '--session-minutes', '1']
    if transport == 'in_memory':
        from google.adk.models import lite_llm
        import litellm
        import swegemma.sandbox.subprocess as sb
        lite_llm._ensure_litellm_imported()
        # Drive the existing stub HTTP handler with streams when sockets are
        # forbidden; keep the real ADK, subprocess setup and verification path.
        monkeypatch.setattr('eval.stub_openai.ThreadingHTTPServer', lambda address, handler: handler)
        handler_class = make_server(script)
        async def completion(**kwargs):
            handler = handler_class.__new__(handler_class)
            handler.send_response = lambda code: None
            handler.send_header = lambda *args: None
            handler.end_headers = lambda: None
            body = json.dumps({'model': kwargs['model']}).encode()
            handler.path = '/v1/chat/completions'
            handler.headers = {'Content-Length': str(len(body))}
            handler.rfile, handler.wfile = io.BytesIO(body), io.BytesIO()
            handler.do_POST()
            payload = json.loads(handler.wfile.getvalue())
            assert 'error' not in payload, payload
            return litellm.ModelResponse(**payload)
        monkeypatch.setattr(lite_llm, 'acompletion', completion)
        monkeypatch.setattr(sb, 'execute_subprocess_command', sb.execute_subprocess_command)
        # This sandbox blocks asyncio's socket wakeups from worker threads.
        # Keep the real subprocess calls, but execute its to_thread work inline.
        async def inline_thread(func, *args, **kwargs):
            return func(*args, **kwargs)
        monkeypatch.setattr(asyncio, 'to_thread', inline_thread)
        runner.main(argv)
        # Gold uses the identical setup hook and verification environment. Its
        # host patch artifacts and fresh sandbox roots must stay under --out.
        from swegemma.models import load_tasks
        import swegemma.harness.verification as vf
        from eval.kaggle.gold_calibration import verify_gold
        original_tempfile = vf.tempfile.NamedTemporaryFile
        gold_files = []
        def gold_file(*args, **kwargs):
            stream = original_tempfile(*args, **kwargs)
            gold_files.append(Path(stream.name))
            return stream
        monkeypatch.setattr(vf.tempfile, 'NamedTemporaryFile', gold_file)
        task = load_tasks(data / 'tasks.jsonl')[0]
        gold = asyncio.run(verify_gold(task, task.patch, data, 'subprocess', out_dir=out))
        assert gold.resolved and gold_files
        assert all(p.is_relative_to(out) for p in gold_files)
        revision = runner.runner_revision()
        monkeypatch.setattr(runner, 'runner_revision', lambda: dict(revision, git_sha='changed-sha'))
        with pytest.raises(ValueError, match='git_sha'):
            runner.main(argv)
        handler_class = make_server(script)
        monkeypatch.setattr(runner, 'classify_patch', lambda *args: 1 / 0)
        runner.main([*argv, '--force-new-out'])
        replacement = [json.loads(line) for line in (out / f'{name}.jsonl').read_text().splitlines()]
        assert replacement[1]['diag_error'] == 'ZeroDivisionError'
        assert replacement[1]['resolved'] is True
        assert len(list(out.glob(name + '-*.jsonl'))) == 1
    else:
        try:
            server = make_server(script)
        except PermissionError:
            pytest.skip('Sandbox denied localhost socket creation')
        with server:
            thread = threading.Thread(target=server.serve_forever, daemon=True)
            thread.start()
            try:
                with (tmp_path / 'runner.log').open('w') as log:
                    proc = subprocess.run([sys.executable, str(ROOT / 'eval/run_agent_eval.py'), *argv,
                        '--endpoint', f'http://127.0.0.1:{server.server_port}/v1'],
                        cwd=ROOT, stdout=log, stderr=log, timeout=240)
                assert proc.returncode == 0, (tmp_path / 'runner.log').read_text()[-2000:]
            finally:
                server.shutdown()
                thread.join()
    path = out / f'{name}.jsonl'
    rows = [json.loads(line) for line in path.read_text().splitlines()]
    assert len(rows) == 2 and rows[1]['instance_id'] == iid
    assert rows[1]['llm_turns'] >= 2 and rows[1]['patch_bytes'] > 0, (rows[1], (out / name / iid / 'trace.json').read_text())
    assert Path(ROOT / rows[1]['trace_path']).is_file()
    assert rows[1]['resolved'] is True and rows[1]['exit_code'] == 0, (out / name / iid / 'output.json').read_text()
    assert rows[1]['wall_seconds']['verification'] > 0
    assert rows[1]['tool_calls_timed'] >= 2
    assert rows[1]['sandbox'] == rows[0]['sandbox']
    assert rows[0]['effective_config']['verification_timeout_seconds'] == 30



def test_observe_patch_before_repeated_stripping():
Run a local bundle with the image-mirror interpreter base:

```sh
/home/ubuntu/gemma-local/venv/bin/python eval/run_agent_eval.py \
  --bundle bundles/e4b/v000 --data-dir data/raw --split eval/splits/dev.txt \
  --run-name baseline-local --concurrency 1 --endpoint http://localhost:8000/v1
```

The runner uses swegemma 0.2.11 programmatically with the subprocess sandbox. Caps
come from the bundle's `eval_config.yaml`, with CLI overrides taking precedence.
It checks two clean tasks with gold patches before inference. `--selfcheck-ids a,b`
chooses the two checks; `--skip-selfcheck` explicitly bypasses them. Only IDs in the
frozen dev split are accepted. `--ids a,b` limits the agent run, not the default
self-check selection. Concurrent durations are throughput measurements, not scorer
timing measurements.

Commands in both agent and verification sandboxes require bubblewrap. Startup
checks inventory hiding, image pytest imports, and workspace write-through, then
checks the full runtime mounts. The only read-only exposures under hidden paths
are the image Python prefix and wheel assets. Graph tools execute in the host
process; their graph and embedding paths resolve under `--data-dir` when relative.
`--allow-unsandboxed` explicitly permits a failed/missing-bubblewrap probe and
records `sandbox: "none"` in the header and every row. Such runs have no filesystem
gold isolation.

`results/<run-name>.jsonl` contains a metadata header and sanitized task metrics.
Completed attempts, including failures, are skipped on resume. Changing the bundle,
caps, split, model registry, data directory, endpoint or concurrency requires a new
name or `--force-new`, which **replaces the results journal**. Raw traces, logs,
pre-stripping agent diffs, and harness outputs remain in `runs/<run-name>/`.
`patch_bytes` and file classifications describe the agent diff before protected-file
stripping; `output.json` includes the diff actually passed to verification.

`--out /path` places both the journal and raw artifact subdirectory under that
directory. Gold self-check patch files and sandbox roots also stay under the
artifact directory. Without `--out`, the existing `results/` and `runs/` layout is
preserved. `--force-new-out` archives the existing journal and artifact directory
with a timestamp before starting fresh. Resume compares runner SHA/dirty flag,
inventory and split hashes, bundle hash, installed package/Python versions,
wheel listing hash, sandbox mode and effective configuration, and reports the
changed fields on mismatch.

Every recognized `EvalConfig` evaluation key is forwarded, with CLI runtime
paths, model registry, subprocess backend, concurrency and cap overrides taking
precedence. Unknown keys produce warnings. The header records the effective
configuration. `tool_seconds` uses ADK execution callbacks keyed by function-call
ID and monotonic time; `tool_calls_timed` and `tool_seconds_unmatched` report
coverage. Parallel or nested tools can have overlapping execution durations.
`cmd_timeouts` counts command timeouts, including those the agent recovers from;
`timed_out` retains its session/verification meaning. Leak diagnostics record only
matched sensitive tokens, and diagnostic failures preserve the row with
`diag_error`.

Gold calibration's local subprocess path uses the same environment setup. Its
Kaggle push script embeds `eval/sandbox_env.py` in the staged single-file kernel.
On a host without usable bubblewrap, calibration requires `--allow-unsandboxed`
or `GOLD_ALLOW_UNSANDBOXED=1`. `GOLD_NULL_PATCH`, `GOLD_IDS_FILE` and `GOLD_PROBE_LOG`
remain available. The Docker calibration path is unchanged.

The offline stub accepts a JSON array of assistant messages, including OpenAI
`tool_calls`, or full completion responses. Responses are consumed in order;
exhaustion returns HTTP 409. It supports non-streaming chat completions and models:

```sh
python eval/stub_openai.py --script /tmp/responses.json --port 8000
```

No packages need installing for tests. If the harness venv lacks pytest, use the
image interpreter and expose the existing harness packages:

```sh
export PYTHONPATH=/home/ubuntu/gemma-local/venv/lib/python3.13/site-packages
export PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
export LITELLM_LOCAL_MODEL_COST_MAP=True
/home/ubuntu/gemma-local/pyimg/cpython-3.13-linux-x86_64-gnu/bin/python3 -m pytest eval/tests -q
RUN_AGENT_EVAL_E2E=1 /home/ubuntu/gemma-local/pyimg/cpython-3.13-linux-x86_64-gnu/bin/python3 -m pytest eval/tests -q -rs
```

The integration tests use synthetic snapshots and a temporary bundle, without
competition data or a GPU. The HTTP variant needs localhost socket permission;
the in-memory variant drives the same stub handler without sockets and verifies
patch capture, gold calibration, resume rejection and diagnostic row persistence.
The real bubblewrap probe skips only if bubblewrap is missing or denied by the
execution sandbox. `--allow-foreign-python` is a unit-test escape hatch.

exec
/bin/bash -lc "sed -n '1,265p' /home/ubuntu/gemma-local/venv/lib/python3.13/site-packages/swegemma/config.py && sed -n '480,640p' /home/ubuntu/gemma-local/venv/lib/python3.13/site-packages/google/adk/flows/llm_flows/tools/_caller.py && sed -n '650,710p' /home/ubuntu/gemma-local/venv/lib/python3.13/site-packages/swegemma/harness/agent_runner.py" in /home/ubuntu/work/gemma
