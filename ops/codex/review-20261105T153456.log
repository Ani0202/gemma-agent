   265	        docker.copy_to(container_id, setup_py, '/tmp/setup.py')
   266	        flag = '--fast-path' if fast_path else ''
   267	        docker.exec(container_id, f'python3 /tmp/setup.py {flag} {repo}'.strip(), timeout=280)
   268	        probe_log = os.environ.get('GOLD_PROBE_LOG')  # diagnostic: which copy of the repo package is imported
   269	        if probe_log:
   270	            pkg = {'Textualize/rich': 'rich', 'encode/httpx': 'httpx', 'fastapi/fastapi': 'fastapi',
   271	                   'psf/requests': 'requests'}.get(repo, repo.split('/')[-1])
   272	            out = docker.exec(container_id, f'cd /workspace && PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1 python3 -s -c '
   273	                              f'"import {pkg};print({pkg}.__file__)"', timeout=60)
   274	            with open(probe_log, 'a') as fh:
   275	                fh.write(json.dumps({'container': str(container_id), 'repo': repo, 'probe': str(out)[:500]}) + '\n')
   276	    install._scorer_original = orig
   277	    for name, module in list(sys.modules.items()):
   278	        if ((name == 'swegemma' or name.startswith('swegemma.'))
