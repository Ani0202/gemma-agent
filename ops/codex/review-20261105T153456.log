   251	def config_snapshot(value):
   252	    if dataclasses.is_dataclass(value):
   253	        return {f.name: config_snapshot(getattr(value, f.name)) for f in dataclasses.fields(value)
   254	                if f.name != 'models'}
   255	    if hasattr(value, 'model_dump'):
   256	        return value.model_dump(mode='json')
   257	    if isinstance(value, dict):
   258	        return {k: config_snapshot(v) for k, v in value.items()}
   259	    if isinstance(value, (list, tuple, set, frozenset)):
   260	        values = [config_snapshot(v) for v in value]
   261	        return sorted(values) if isinstance(value, (set, frozenset)) else values
   262	    if isinstance(value, Path):
   263	        return str(value)
   264	    return value
