   122	def probe_isolation(manager, inventory_path, data_dir, *, empty_data=True):
   123	    """Fail closed on visibility, image imports, or broken workspace write-through."""
   124	    sid = manager.start()
   125	    try:
   126	        # Encode host paths to bypass swegemma's /tmp path translation in probes
   127	        # whose inventory is itself under /tmp. A failed ls must fail the probe.
   128	        encoded = lambda p: shlex.quote(base64.b64encode(str(p).encode()).decode())
   129	        empty_check = 'contents=$(ls -A "$data") && test -z "$contents" && ' if empty_data else ''
   130	        cmd = (f'inventory=$(printf %s {encoded(inventory_path)} | base64 -d); '
   131	               f'data=$(printf %s {encoded(data_dir)} | base64 -d); '
   132	               'test ! -e "$inventory" && ' + empty_check +
   133	               "python3 -c 'import pytest' && "
   134	               'echo probe > /workspace/x && echo probe > /tmp/y')
   135	        result = manager.exec(sid, cmd, timeout=60)
   136	        workspace = manager.sandboxes[sid]['workspace']
   137	        if result.exit_code != 0 or not (workspace / 'x').is_file():
   138	            raise RuntimeError('bubblewrap startup probe failed: ' + result.stderr[:500])
   139	    finally:
   140	        manager.cleanup_all()
