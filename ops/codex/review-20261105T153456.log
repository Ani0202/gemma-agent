    81	def bundle_sha(bundle):
    82	    digest = hashlib.sha256()
    83	    for path in sorted(bundle.rglob('*')):
    84	        if path.is_symlink():
    85	            raise ValueError('Bundle symlinks are unsupported')
    86	        if path.is_file():
    87	            digest.update(path.relative_to(bundle).as_posix().encode() + b'\0')
    88	            digest.update(bytes.fromhex(sha_file(path)))
    89	    return digest.hexdigest()
