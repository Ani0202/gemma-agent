    52	    from google.adk.plugins.base_plugin import BasePlugin
    53	
    54	    class TimingPlugin(BasePlugin):
    55	        def __init__(self):
    56	            super().__init__(name='eval_tool_timing')
    57	
    58	        async def before_tool_callback(self, *, tool, tool_args, tool_context):
    59	            state = current_timing.get()
    60	            if state is not None:
    61	                state.before(tool_context.function_call_id, tool.name)
    62	
    63	        async def after_tool_callback(self, *, tool, tool_args, tool_context, result):
    64	            state = current_timing.get()
    65	            if state is not None:
    66	                state.after(tool_context.function_call_id)
