   293	def task_diagnostics(trace, patch, repo, protected, test_files, data_dir):
   294	    out = dict(per_tool={}, prompt_tokens=None, completion_tokens=None,
   295	               patch_bytes=len(patch.encode()), patch_files=[], test_files_edited=[],
   296	               stray_files=[], empty_patch=not patch.strip(), leak_suspect=False, leak_hits=[],
   297	               diag_error=None)
   298	    errors = []
   299	    try:
   300	        out['per_tool'], tokens, _ = trace_counts(trace)
   301	        out.update(tokens)
   302	    except Exception as exc:
   303	        errors.append(type(exc).__name__)
   304	    try:
   305	        out.update(classify_patch(patch, repo, protected, test_files))
   306	    except Exception as exc:
   307	        errors.append(type(exc).__name__)
   308	    try:
   309	        tokens = (str(ROOT), str(data_dir), 'tasks.jsonl', 'test_patch', 'FAIL_TO_PASS')
   310	        arguments = [json.dumps(e.tool_args, ensure_ascii=False) for e in trace.entries
   311	                     if e.event_type == 'tool_call'] if trace else []
   312	        out['leak_hits'] = [t for t in dict.fromkeys(tokens) if any(t in a for a in arguments)]
   313	        out['leak_suspect'] = bool(out['leak_hits'])
   314	    except Exception as exc:
   315	        errors.append(type(exc).__name__)
   316	    out['diag_error'] = ','.join(errors) or None
   317	    return out
