   226	def patch_subprocess_deps(data_dir):
   227	    """Emulate the docker-only dependency setup for the subprocess sandbox (swegemma skips it).
   228	
   229	    Contract (swegemma 0.2.11 container_setup): for docker, _ensure_container_site_packages
   230	    unpacks every deduplicated (highest-version, py313-compatible) wheel from wheels_dir that is
   231	    < 20 MB and not in skip_base_pkgs (pytest, pluggy, ... come from the image) straight into
   232	    site-packages, no resolver; large wheels are added only if imported by the workspace; then
   233	    sandbox/setup.py runs with --fast-path. We replicate exactly that inside the sandbox venv.
   234	    The sandbox venv uses system_site_packages=True, so the HOST python must mirror the image
   235	    (Dockerfile.public: pytest, pytest-timeout==2.1.0, typer, build backends; nothing else).
   236	    """
   237	    import tarfile
   238	    import swegemma.harness.container_setup as cs
   239	    import swegemma.harness.verification as vf
   240	    import swegemma.harness.sample_verification  # load all known by-name bindings
   241	    import swegemma.evaluate
   242	    import swegemma.cli
   243	    import swegemma.harness.agent_runner
   244	    orig = getattr(cs.install_test_dependencies, '_scorer_original', cs.install_test_dependencies)
   245	    previous = cs.install_test_dependencies
   246	    wheels_src = Path(data_dir) / 'wheels'
   247	    if not wheels_src.is_dir():
   248	        wheels_src = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')
   249	    setup_py = Path(data_dir) / 'sandbox' / 'setup.py'
   250	    if not setup_py.exists():
   251	        setup_py = next(iter(Path(data_dir).rglob('setup.py')), setup_py)  # competition sandbox/setup.py
   252	
   253	    def install(docker, container_id, repo='', *, fast_path=True, config=None):
   254	        if type(docker).__name__ not in {'SubprocessManager', 'SubprocessSandbox'}:
   255	            return orig(docker, container_id, repo, fast_path=fast_path, config=config)
   256	        venv_dir = docker.sandboxes[container_id]['venv']
   257	        sp_dir = next(iter(sorted(venv_dir.glob('lib/python3*/site-packages'))))
   258	        base_wheels, large_wheels, _m2p, _req = cs._inspect_wheels_dir(wheels_src)
   259	        selected = list(base_wheels)
   260	        if large_wheels:  # public wheels have none; fail loudly rather than silently diverge
   261	            raise RuntimeError('large wheels present; workspace-import scan not emulated')
   262	        tar_path = cs._build_unpacked_wheels_tar(selected, 'sp_base_local', '.swegemma_base_injected')
   263	        with tarfile.open(tar_path) as tf:
   264	            tf.extractall(sp_dir, filter='data')
   265	        docker.copy_to(container_id, setup_py, '/tmp/setup.py')
   266	        flag = '--fast-path' if fast_path else ''
   267	        docker.exec(container_id, f'python3 /tmp/setup.py {flag} {repo}'.strip(), timeout=280)
   268	        probe_log = os.environ.get('GOLD_PROBE_LOG')  # diagnostic: which copy of the repo package is imported
   269	        if probe_log:
   270	            pkg = {'Textualize/rich': 'rich', 'encode/httpx': 'httpx', 'fastapi/fastapi': 'fastapi',
   271	                   'psf/requests': 'requests'}.get(repo, repo.split('/')[-1])
   272	            out = docker.exec(container_id, f'cd /workspace && PYTHONSAFEPATH=1 PYTHONNOUSERSITE=1 python3 -s -c '
   273	                              f'"import {pkg};print({pkg}.__file__)"', timeout=60)
   274	            with open(probe_log, 'a') as fh:
   275	                fh.write(json.dumps({'container': str(container_id), 'repo': repo, 'probe': str(out)[:500]}) + '\n')
   276	    install._scorer_original = orig
   277	    for name, module in list(sys.modules.items()):
   278	        if ((name == 'swegemma' or name.startswith('swegemma.'))
   279	                and getattr(module, 'install_test_dependencies', None) in (orig, previous)):
   280	            module.install_test_dependencies = install
   281	    return install
