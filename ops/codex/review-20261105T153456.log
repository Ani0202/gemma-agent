   302	def test_real_adk_parallel_tool_timings_and_concurrent_task_contexts(harness):
   303	    from google.adk.agents import LlmAgent
   304	    from google.adk.apps import App
   305	    from google.adk.models.base_llm import BaseLlm
   306	    from google.adk.models.llm_response import LlmResponse
   307	    from google.adk.runners import Runner
   308	    from google.adk.sessions import InMemorySessionService
   309	    from google.genai import types
   310	
   311	    class StubModel(BaseLlm):
   312	        calls: int = 0
   313	
   314	        async def generate_content_async(self, llm_request, stream=False):
   315	            self.calls += 1
   316	            await asyncio.sleep(0.1)  # model overhead, included in agent wall time
   317	            if self.calls == 1:
   318	                parts = [types.Part(function_call=types.FunctionCall(id=n, name=n, args={}))
   319	                         for n in ('fast', 'slow')]
   320	            else:
   321	                parts = [types.Part(text='Done')]
   322	            yield LlmResponse(content=types.Content(role='model', parts=parts), finish_reason=types.FinishReason.STOP)
   323	
   324	    async def fast() -> dict:
   325	        await asyncio.sleep(0.05)
   326	        return {'ok': True}
   327	
   328	    async def slow() -> dict:
   329	        await asyncio.sleep(0.5)
   330	        return {'ok': True}
   331	
   332	    async def one(name):
   333	        state = timing.ToolTiming()
   334	        token = timing.current_timing.set(state)
   335	        service = InMemorySessionService()
   336	        session = await service.create_session(app_name=name, user_id='u')
   337	        app = App(name=name, root_agent=LlmAgent(name='agent', model=StubModel(model='stub'),
   338	                                                tools=[fast, slow]),
   339	                  plugins=[timing.make_timing_plugin()])
   340	        runner_ = Runner(app=app, session_service=service)
   341	        start = time.monotonic()
   342	        try:
   343	            async for _ in runner_.run_async(user_id='u', session_id=session.id,
   344	                                             new_message=types.Content(role='user', parts=[types.Part(text='Go')])):
   345	                pass
   346	        finally:
   347	            timing.current_timing.reset(token)
   348	        return state.metrics(), time.monotonic() - start
   349	
   350	    async def both():
   351	        return await asyncio.gather(one('first'), one('second'))
   352	
   353	    for metrics, wall in asyncio.run(both()):
   354	        assert metrics['tool_calls_timed'] == 2 and metrics['tool_seconds_unmatched'] == 0
   355	        assert 0.04 <= metrics['tool_seconds']['fast']['total'] <= 0.2
   356	        assert 0.45 <= metrics['tool_seconds']['slow']['total'] <= 0.7
   357	        assert sum(v['total'] for v in metrics['tool_seconds'].values()) <= wall
