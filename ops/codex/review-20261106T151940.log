   732	def identity_check(dirs, identity_json, bundle, transports, smoke_dirs):
   733	    """Check each push against its event proof and its separate transport hash."""
   734	    data = _read_json(identity_json)
   735	    records = data.get('records', [])
   736	    events = defaultdict(set)
   737	    for record in records if isinstance(records, list) else []:
   738	        if not isinstance(record, dict) or not isinstance(record.get('bundles'), dict):
   739	            continue
   740	        proof = record['bundles'].get(bundle, {})
   741	        if not isinstance(proof, dict):
   742	            continue
   743	        if all(proof.get(k) is True for k in ('pass', 'zip_ok', 'content_ok')):
   744	            agent = proof.get('agent_yaml_sha256')
   745	            if isinstance(agent, str) and re.fullmatch('[0-9a-f]{64}', agent):
   746	                events[record.get('event')].add(agent)
   747	    # All pushes must prove the same registered agent bytes.
   748	    agents = set().union(*events.values()) if events else set()
   749	    results = []
   750	    main_index = 0
   751	    for directory in dirs:
   752	        directory = str(Path(directory))
   753	        timing = Path(directory) / 'timing.jsonl'
   754	        rows = base.load_rows(timing) if timing.is_file() else []
   755	        needed = ['smoke'] if directory in smoke_dirs else []
   756	        if directory not in smoke_dirs or any(r['instance_id'] not in base.ids_file(base.ARM_IDS)[:2] for r in rows):
   757	            needed.append('main' if main_index == 0 else 'chunkN')
   758	            main_index += 1
   759	        headers = _headers(timing) if timing.is_file() else []
   760	        event_ok = all(any(re.fullmatch(r'chunk[0-9]+', str(event)) and values == agents
   761	                           for event, values in events.items()) if e == 'chunkN'
   762	                       else events.get(e) == agents for e in needed)
   763	        transport = transports.get(directory)
   764	        ok = (bool(needed) and event_ok and len(agents) == 1 and bool(headers)
   765	              and isinstance(transport, str) and re.fullmatch('[0-9a-f]{64}', transport) is not None
   766	              and all(h.get('bundle_sha256') == transport and h.get('agent_yaml_sha256') in agents
   767	                      for h in headers))
   768	        results.append(dict(dir=directory, events=needed, checked=bool(ok),
   769	                            transport_sha256=transport, agent_yaml_sha256=sorted(agents)))
   770	    return dict(checked=all(r['checked'] for r in results), runs=results,
   771	                mismatching_dirs=[r['dir'] for r in results if not r['checked']])
