    """Returns (lines, gate_bool). Raises on anything unexpected (caller fails closed)."""
    parse_ok, rows, vllm_up = True, [], False
    with open(path, encoding='utf-8', errors='strict') as fh:
        for line in fh:
            if not line.strip():
                continue
            try:
