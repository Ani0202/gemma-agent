   972	def arm3_metrics(base_name, arm3_dirs, base_dirs, classifiers, smoke_json=None, *, base_verdict_json=None,
   973	                 identity_json=None, bundle=None, transports=None):
   974	    paths = [base.ARM_IDS, base.SCREENED_IDS, base.__file__, 'eval/plan007_report.py', 'eval/thinking_bound.py']
   975	    if base_name == 'arm1':
   976	        base_dirs = [str(Path(t).parent) for _, t, _, _ in base.PARTS]
   977	        classifiers = dict(classifiers, **{str(Path(t).parent): (d, a) for _, t, d, a in base.PARTS})
   978	    arms, envs, inventories = {}, {}, {}
   979	    all_records = {}
   980	    for name, dirs in (('arm3', arm3_dirs), ('base', base_dirs)):
   981	        rec, inv, inputs, headers = aggregate_arm(dirs, classifiers)
   982	        paths.extend(inputs)
   983	        all_records[name] = rec
   984	        inventories[name] = inv
   985	        arms[name] = summarize_arm(rec, arm1=name == 'base' and base_name == 'arm1')
   986	        envs[name] = environment_metrics(headers, rec)
   987	    a, b = arms['arm3'], arms['base']
   988	    on, off = [], []
   989	    for (r, _, _, _), (s, _, _, _) in zip(all_records['arm3'], all_records['base']):
   990	        base.assert_paired(r, s)
   991	        if r.get('resolved') is True and s.get('resolved') is not True:
   992	            on.append(r['instance_id'])
   993	        if s.get('resolved') is True and r.get('resolved') is not True:
   994	            off.append(r['instance_id'])
   995	    p = sign_test(len(on), len(off))
   996	    sa, sb = a['safety'], b['safety']
   997	    checks = {key: isinstance(sa[key], dict) and sa[key]['count'] == 0 for key in ('test_files_edited', 'stray_files')}
   998	    checks.update(total_wall_p90=sa['total_wall_complete'] and sb['total_wall_complete'] and
   999	                  sa['total_wall_p90'] <= 1.10 * sb['total_wall_p90'],
  1000	                  empty_patch=sa['empty_patch_complete'] and sb['empty_patch_complete'] and sa['empty_patch']['count'] <= sb['empty_patch']['count'] + 3,
  1001	                  submitted_without_test=sa['submitted_without_test']['count'] <= sb['submitted_without_test']['count'] + 3)
  1002	    vetoes = [k for k, passed in checks.items() if not passed]
  1003	    if a['timeouts']['count'] > b['timeouts']['count'] + 2:
  1004	        vetoes.append('timeouts')
  1005	    if not a['timing']['timing_pass']:
  1006	        vetoes.append('timing')
  1007	    smoke = _read_json(smoke_json)
  1008	    smoke_invalid = smoke.get('overall') != 'PASS'
  1009	    for path in (smoke_json, base_verdict_json, identity_json):
  1010	        if path and _readable_file(path):
  1011	            paths.append(path)
  1012	    smoke_records = all_records['arm3'][:2]
  1013	    traces = [r[2] for r in smoke_records]
  1014	    smoke_dirs = {str(t.parent.parent.parent) for t in traces}
  1015	    schema = smoke.get('_schema')
  1016	    evidence = schema.get('input_shas', {}) if isinstance(schema, dict) else {}
  1017	    if not isinstance(evidence, dict):
  1018	        evidence = {}
  1019	    required_evidence = [*traces, *(Path(d) / 'timing.jsonl' for d in smoke_dirs)]
  1020	    smoke_bound = all(evidence.get(str(p)) == base.sha(p) for p in required_evidence)
  1021	    # A smoke report must name exactly the timing files that supplied the counted rows.
  1022	    smoke_bound = smoke_bound and {str(Path(p)) for p in evidence if Path(p).name == 'timing.jsonl'} == {
  1023	        str(Path(d) / 'timing.jsonl') for d in smoke_dirs}
  1024	    ci = thinking_criterion(traces)
  1025	    identity = identity_check(arm3_dirs, identity_json, bundle, transports or {}, smoke_dirs)
  1026	    base_verdict = _read_json(base_verdict_json)
  1027	    verdicts = [base_verdict[k] for k in ('decision', 'verdict') if k in base_verdict]
  1028	    # Plan 009 l.17-19: base = arm 2 iff plan 008 returned SHIP-ELIGIBLE; any other verdict means base = arm 1.
  1029	    base_valid = base_name == 'arm1' or bool(verdicts) and all(v == 'SHIP-ELIGIBLE' for v in verdicts)
  1030	    differences = [k for k in envs['arm3'] if envs['arm3'][k] != envs['base'][k]]
  1031	    envs.update(differences=differences, pairing_void_candidate='kernel_code' in differences)
  1032	    inputs = dict(arm3_timeouts=a['timeouts']['count'], base_timeouts=b['timeouts']['count'],
  1033	                  on_only=len(on), off_only=len(off), p=p, arm3_h=a['h_rows']['count'],
  1034	                  smoke_invalid=smoke_invalid, smoke_bound=smoke_bound, smoke_thinking=ci,
  1035	                  base_valid=base_valid, identity=identity, timeouts_pass='timeouts' not in vetoes,
  1036	                  timing_pass=a['timing']['timing_pass'], safety_checks=checks, vetoes=vetoes)
  1037	    result = dict(_schema=_schema('arm3', paths), n_rows=a['n_rows'], base_arm=base_name, inventory=inventories,
  1038	                base_validity=('VALID by dec069; ENV CONTROL: environment agreement with local gold calibration unmeasured'
  1039	                               if base_name == 'arm1' else verdicts if base_valid else 'INVALID (base invalid/unruled)'),
  1040	                primary=dict(on_only=_id_count(on), off_only=_id_count(off), p=p,
  1041	                             arm3_resolved=a['resolved'], base_resolved=b['resolved']), arms=arms,
  1042	                validity_literal='INVALID (H>=5)' if a['h_rows']['count'] >= 5 else 'VALID-pending-director',
  1043	                env_drift=envs, decision=arm3_decision(len(on), len(off), p, a['h_rows']['count'], smoke_invalid, vetoes,
  1044	                    pairing_void_reason='kernel agent/verification path differs' if envs['pairing_void_candidate'] else None,
  1045	                    base_valid=base_valid, identity_valid=identity['checked'], smoke_bound=smoke_bound,
  1046	                    thinking_pass=ci['status'] == 'PASS'),
  1047	                decision_inputs=inputs, label='thinking ACTIVE != budget enforced')
  1048	    if not identity['checked']:
  1049	        # Rejected pushes are visible as first-attempt sensitivity, never counted.
  1050	        excluded = set(identity['mismatching_dirs'])
  1051	        counted = [r['instance_id'] for r, _, trace, _ in all_records['arm3']
  1052	                   if str(trace.parent.parent.parent) not in excluded]
  1053	        result['uncounted_sensitivity'] = dict(primary=result.pop('primary'), arms=result.pop('arms'))
  1054	        result['n_rows'] = len(counted)
  1055	        inventories['arm3'].update(complete=False, counted_instance_ids=counted,
  1056	                                  identity_excluded_dirs=identity['mismatching_dirs'],
  1057	                                  counted_missing=[i for i in base.ids_file(base.ARM_IDS) if i not in counted])
  1058	    return result
