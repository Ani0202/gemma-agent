    for part, timing, d4path, a2path in base.PARTS:
        d4, a2 = [json.loads(Path(p).read_text()) for p in (d4path, a2path)]
        assert d4['classifier_sha256'] == base.D4_SHA and a2['classifier_sha256'] == base.A2_SHA
        assert d4['input_sha256'] == base.sha(timing) == a2['input_sha256']
        ts = base.load_rows(timing)
        cs, als = base.unique_map(d4['rows'], d4path), base.unique_map(a2['rows'], a2path)
        assert set(cs) == set(als) == {r['instance_id'] for r in ts}
        paths.extend((timing, d4path, a2path))


def pct(vals, q):
    vals = sorted(v for v in vals if v is not None)
    if not vals:
        return None
    i = (len(vals) - 1) * q
    lo, hi = math.floor(i), math.ceil(i)
    return round(vals[lo] + (vals[hi] - vals[lo]) * (i - lo), 1)


def load_rows(path):
    out = []
    for line in Path(path).read_text().splitlines():
        if not line.strip():
            continue
        r = json.loads(line)
        if 'instance_id' in r:
            out.append(r)
        elif not any(m <= set(r) for m in META_KEYS):
            raise AssertionError(f'unrecognized non-row record in {path}: keys {sorted(r)[:8]}')
    ids = [r['instance_id'] for r in out]
    assert len(ids) == len(set(ids)), f'duplicate instance_id rows in {path}'
    return out


def unique_map(rows, what):
    ids = [r['instance_id'] for r in rows]
    assert len(ids) == len(set(ids)), f'duplicate classifier rows in {what}'
    return {r['instance_id']: r for r in rows}


