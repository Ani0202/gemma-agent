   920	def environment_metrics(headers, records):
   921	    aliases = dict(docker_image_digest=('docker_image_digest', 'docker_image'),
   922	                   vllm_version=('vllm_version',), google_adk_version=('google_adk_version', 'google-adk'),
   923	                   swegemma_version=('swegemma_version',), model_id=('model_id', 'model'),
   924	                   gpu_names=('gpu_names',), gpu_count=('gpu_count',))
   925	    def values(keys):
   926	        vals = []
   927	        for h in headers:
   928	            val = next((h[k] for k in keys if k in h), None)
   929	            if val not in vals:
   930	                vals.append(val)
   931	        return vals[0] if len(vals) == 1 else vals or None
   932	    out = {key: values(keys) for key, keys in aliases.items()}
   933	    for package in ('vllm', 'google-adk', 'swegemma'):
   934	        key = package.replace('-', '_') + '_version'
   935	        if out[key] is None:
   936	            values_from_versions = []
   937	            for h in headers:
   938	                val = (h.get('versions') or {}).get(package)
   939	                if val not in values_from_versions:
   940	                    values_from_versions.append(val)
   941	            out[key] = values_from_versions[0] if len(values_from_versions) == 1 else values_from_versions or None
   942	    for field, wall in (('setup_wall_p50_p90', None), ('verification_wall_p50_p90', 'verification')):
   943	        out[field] = _quantiles([r.get('sandbox_setup_seconds') if wall is None else
   944	                                 (r.get('wall_seconds') or {}).get(wall) for r, _, _, _ in records])
   945	    kernel_keys = sorted({k for h in headers for k in h if k.startswith('kernel_code') or
   946	                          (('agent' in k or 'verification' in k) and ('sha' in k) and k != 'agent_yaml_sha256')})
   947	    out['kernel_code'] = {k: values((k,)) for k in kernel_keys} or None
   948	    return out
