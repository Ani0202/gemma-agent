   818	def aggregate_arm(dirs, classifiers):
   819	    """Inventory first, before loading classifier/trace evidence. Never drop a row."""
   820	    selected, occurrences, paths, headers = {}, defaultdict(list), [], []
   821	    for directory in dirs:
   822	        timing = Path(directory) / 'timing.jsonl'
   823	        if not timing.is_file():
   824	            raise IncompleteRun(dict(dir=str(directory), missing_timing=True))
   825	        try:
   826	            rows = base.load_rows(timing)
   827	        except AssertionError:
   828	            raw = [json.loads(l) for l in timing.read_text().splitlines() if l.strip()]
   829	            inv = inventory([r['instance_id'] for r in raw if 'instance_id' in r], base.ids_file(base.ARM_IDS))
   830	            raise IncompleteRun(dict(dir=str(directory), inventory=inv))
   831	        paths.append(timing)
   832	        headers.extend(_headers(timing))
   833	        for row in rows:
   834	            iid = row['instance_id']
   835	            occurrences[iid].append(dict(dir=str(directory), resolved=row.get('resolved'),
   836	                                         timeout=bool(row.get('timed_out') or row.get('agent_timeout_fired')),
   837	                                         empty_patch=row.get('verified_patch_bytes') == 0))
   838	            selected.setdefault(iid, (row, str(directory)))
   839	    inv = inventory(list(selected), base.ids_file(base.ARM_IDS))
   840	    inv['duplicates'] = [dict(instance_id=i, dirs=[a['dir'] for a in ds], attempts=ds) for i, ds in occurrences.items() if len(ds) > 1]
   841	    if not inv['complete']:
   842	        raise IncompleteRun(inv)
   843	    classified = {}
   844	    for directory in dirs:
   845	        timing = Path(directory) / 'timing.jsonl'
   846	        d4, a2 = classifiers[str(Path(directory))]
   847	        rows = base.load_rows(timing)
   848	        classified[str(directory)] = _classifier(timing, d4, base.D4_SHA, rows)
   849	        _classifier(timing, a2, base.A2_SHA, rows)
   850	        paths.extend((d4, a2))
   851	    records = []
   852	    for iid in base.ids_file(base.ARM_IDS):
   853	        row, directory = selected[iid]
   854	        trace = Path(directory) / 'runs' / iid / 'trace.json'
   855	        entries = json.loads(trace.read_text()).get('entries') or []
   856	        paths.append(trace)
   857	        records.append((row, classified[directory][iid], trace, entries))
   858	    return records, inv, paths, headers
