  1061	def arm3_cli(argv):
  1062	    import argparse
  1063	    parser = argparse.ArgumentParser(description='Plan 009 CPU/offline metrics')
  1064	    parser.add_argument('mode', choices=['arm3', 'arm3smoke'])
  1065	    parser.add_argument('--identity-json', required=True)
  1066	    parser.add_argument('--bundle', required=True)
  1067	    parser.add_argument('--transport', action='append', required=True)
  1068	    def transports_for(args, dirs):
  1069	        transports = {}
  1070	        for value in args.transport:
  1071	            if '=' not in value:
