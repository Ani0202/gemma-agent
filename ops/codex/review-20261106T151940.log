   818	def aggregate_arm(dirs, classifiers):
   819	    """Inventory first, before loading classifier/trace evidence. Never drop a row."""
   820	    selected, occurrences, paths, headers = {}, defaultdict(list), [], []
   821	    for directory in dirs:
