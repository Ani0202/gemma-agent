    65	def evidence(tmp_path, directory, cs):
    66	    identity = tmp_path / 'identity.json'
    67	    identity.write_text(json.dumps(dict(records=[dict(event=e, bundles={'v012': dict(
    68	        zip_ok=True, content_ok=True, **{'pass': True}, agent_yaml_sha256='a'*64)})
    69	        for e in ('smoke', 'main', 'chunk1') ])))
    70	    opts = dict(identity_json=str(identity), bundle='v012', transports={directory: 'b'*64})
    71	    timing = Path(directory) / 'timing.jsonl'
    72	    traces = [Path(directory) / 'runs' / iid / 'trace.json'
    73	              for iid in m.base.ids_file(m.base.ARM_IDS)[:2]]
    74	    smoke = dict(overall='PASS', _schema=m._schema('arm3smoke', [timing, *(p for p in traces if p.is_file())]))
    75	    path = tmp_path / 'smoke.json'
    76	    path.write_text(json.dumps(smoke))
    77	    verdict = tmp_path / 'base.json'
    78	    verdict.write_text(json.dumps(dict(decision='SHIP-ELIGIBLE')))
    79	    return dict(**opts, smoke_json=str(path), base_verdict_json=str(verdict))
