   869	def summarize_arm(records, arm1=False):
   870	    rows = [r for r, _, _, _ in records]
   871	    ids = lambda predicate: [r['instance_id'] for r in rows if predicate(r)]
   872	    hs = [r['instance_id'] for r, c, _, _ in records if c['h'] is not None]
   873	    non_h = [r for r in rows if r['instance_id'] not in hs]
   874	    rate = lambda rs: base.rate(sum(r.get('resolved') is True for r in rs), len(rs))
   875	    thinking, repeats, llm, tools, swt = [], [], [], [], []
   876	    for row, _, trace, entries in records:
   877	        iid = row['instance_id']
   878	        th = base.thinking_task(str(trace))
   879	        thinking.append(dict(instance_id=iid, thinking_blocks=th['thinking_blocks'], total_thinking_chars=sum(
   880	            len(e.get('content') or '') for e in entries if e.get('author') == ROOT and e.get('type') == 'thinking')))
   881	        repeats.append(dict(instance_id=iid, **identical_runs_root(entries)))
   882	        llm.append(row.get('llm_turns') if row.get('llm_turns') is not None else th['root_usage_turns'])
   883	        tc = row.get('tool_calls')
   884	        tools.append(tc['total'] if isinstance(tc, dict) and tc.get('total') is not None else len(root_tool_calls(entries)))
   885	        observed = submitted_without_test(entries, gate_mode=False)
   886	        count = observed is True
   887	        if not arm1:
   888	            evidence = dict(submitted_without_test=observed, **submit_evidence(row, entries, False))
   889	            count = d735_counts(evidence, entries)['swt_d735']
   890	        if count:
   891	            swt.append(iid)
   892	    safety = {}
   893	    for key in ('test_files_edited', 'stray_files'):
   894	        safety[key] = (_id_count(ids(lambda r: bool(r.get(key)))) if all(key in r and r[key] is not None for r in rows)
   895	                       else 'not available')
   896	    safety.update(total_wall_p90=base.pct([(r.get('wall_seconds') or {}).get('total') for r in rows], .9),
   897	                  total_wall_complete=all(_finite_number((r.get('wall_seconds') or {}).get('total')) for r in rows),
   898	                  empty_patch=_id_count(ids(lambda r: r.get('verified_patch_bytes') == 0)),
   899	                  empty_patch_complete=all(type(r.get('verified_patch_bytes')) is int for r in rows),
   900	                  submitted_without_test=_id_count(swt),
   901	                  submitted_without_test_definition='plan007 observed' if arm1 else 'plan008 D73.5 total')
   902	    screened = set(base.ids_file(base.SCREENED_IDS))
   903	    unseen = [r for r in rows if r['instance_id'] not in screened]
   904	    return dict(n_rows=len(rows), resolved=rate(rows), h_rows=_id_count(hs), sensitivity=rate(non_h),
   905	                known_diag=sum(bool(c['known_diag']) for _, c, _, _ in records) if all('known_diag' in c for _, c, _, _ in records) else None,
   906	                timeouts=_id_count(ids(lambda r: bool(r.get('timed_out')) or bool(r.get('agent_timeout_fired')))),
   907	                safety=safety, timing=arm3_timing(rows), descriptive=dict(
   908	                    thinking=dict(rows=thinking, tasks_with_blocks=sum(t['thinking_blocks'] > 0 for t in thinking),
   909	                                  total_blocks=sum(t['thinking_blocks'] for t in thinking),
   910	                                  total_chars=sum(t['total_thinking_chars'] for t in thinking)),
   911	                    context_overflow='not available',
   912	                    repeat=dict(rows=repeats, mechanism2=_id_count([r['instance_id'] for r in repeats if r['max_run'] >= 5]),
   913	                                max_run=max(r['max_run'] for r in repeats), repeated_calls=sum(r['repeated_calls'] for r in repeats)),
   914	                    llm_calls_p50_p90=_quantiles(llm), tool_calls_p50_p90=_quantiles(tools),
   915	                    per_repo={repo: rate([r for r in rows if (r.get('repo') or r['instance_id'].split('__')[0]) == repo])
   916	                              for repo in sorted({r.get('repo') or r['instance_id'].split('__')[0] for r in rows})},
   917	                    unscreened_25=dict(instance_ids=[r['instance_id'] for r in unseen], resolved=rate(unseen))))
