    41	def make_run(tmp_path, name, ids, *, h=(), resolved=(), blocks=3):
    42	    directory = tmp_path / name
    43	    directory.mkdir()
    44	    rows = [dict(instance_id=i, resolved=i in resolved, verified_patch_bytes=1,
    45	                 agent_clock_seconds=200, finalization_seconds=10, timed_out=False,
    46	                 patch_submitted=False, test_files_edited=[], stray_files=[],
    47	                 wall_seconds=dict(total=300, verification=20), sandbox_setup_seconds=80) for i in ids]
    48	    header = dict(_schema='test', agent_yaml_sha256='a'*64, bundle_sha256='b'*64,
    49	                  model_id='test', versions={'vllm': '1'}, kernel_code={'agent_path_sha256': 'c'*64})
    50	    timing = directory / 'timing.jsonl'
    51	    timing.write_text('\n'.join(map(json.dumps, [header, *rows, {'_vllm': {'startup_seconds': 1}}])) + '\n')
    52	    files = []
    53	    for name, sha in [('d4.json', m.base.D4_SHA), ('a2.json', m.base.A2_SHA)]:
    54	        path = directory / name
    55	        path.write_text(json.dumps(dict(classifier_sha256=sha, input_sha256=m.base.sha(timing),
    56	                         rows=[dict(instance_id=i, h='H' if i in h else None, known_diag=False) for i in ids])))
    57	        files.append(str(path))
    58	    for i in set(ids):
    59	        tr = directory / 'runs' / i / 'trace.json'
    60	        tr.parent.mkdir(parents=True)
    61	        tr.write_text(json.dumps(dict(entries=[dict(author=m.ROOT, type='thinking', content='x'*40)] * blocks)))
    62	    return str(directory), {str(directory): files}
