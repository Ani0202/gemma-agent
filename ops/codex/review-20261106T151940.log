    82	def _pairs(entries):
    83	    # Legacy trace has no call IDs. FIFO by (author, tool) also isolates nested tools.
    84	    pending, calls = defaultdict(deque), []
    85	    for i, e in enumerate(entries):
    86	        key = (e.get('author'), e.get('tool'))
    87	        if e.get('type') == 'tool_call':
    88	            c = dict(e, entry_index=i, response=None, response_index=None)
    89	            calls.append(c)
    90	            pending[key].append(c)
    91	        elif e.get('type') in ('tool_response', 'tool_result') and pending[key]:
    92	            c = pending[key].popleft()
    93	            c.update(response=e.get('result', ''), response_index=i)
    94	    return calls
