   951	def arm3_decision(on, off, p, h_count, smoke_invalid, vetoes, *, pairing_void_reason=None,
   952	                  base_valid=True, identity_valid=True, smoke_bound=True, thinking_pass=True):
   953	    if pairing_void_reason:
   954	        return 'INVALID (pairing voided: ' + pairing_void_reason + ')'
   955	    if not base_valid:
   956	        return 'INVALID (base invalid/unruled)'
   957	    if not identity_valid:
   958	        return 'INVALID (identity mismatch)'
   959	    if not thinking_pass:
   960	        return 'INVALID (smoke i)'
   961	    if not smoke_bound:
   962	        return 'INVALID (smoke evidence not bound)'
   963	    if smoke_invalid or h_count >= 5:
   964	        return 'INVALID'
   965	    if off >= on:
   966	        return 'KEEP-OFF'
   967	    if p >= .2:
   968	        return 'NO-DIFFERENCE'
   969	    return 'ON-BETTER-VETOED' if vetoes else 'ON-ADOPT'
