    87	def assert_no_text(value):
    88	    if isinstance(value, dict):
    89	        for key, item in value.items():
    90	            if key != 'definitions':
    91	                assert_no_text(item)
    92	    elif isinstance(value, list):
    93	        for item in value:
    94	            assert_no_text(item)
    95	    elif isinstance(value, str):
    96	        assert len(value) <= 200
