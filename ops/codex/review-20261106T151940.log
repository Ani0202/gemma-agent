   836	                                         timeout=bool(row.get('timed_out') or row.get('agent_timeout_fired')),
   837	                                         empty_patch=row.get('verified_patch_bytes') == 0))
   838	            selected.setdefault(iid, (row, str(directory)))
   839	    inv = inventory(list(selected), base.ids_file(base.ARM_IDS))
   840	    inv['duplicates'] = [dict(instance_id=i, dirs=[a['dir'] for a in ds], attempts=ds) for i, ds in occurrences.items() if len(ds) > 1]
   841	    if not inv['complete']:
