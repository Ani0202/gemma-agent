   774	def arm3smoke_metrics(run_dir, classifier, identity_json=None, bundle=None, transports=None):
   775	    timing = Path(run_dir) / 'timing.jsonl'
   776	    paths = [base.ARM_IDS, base.__file__, 'eval/plan007_report.py', 'eval/thinking_bound.py']
   777	    expected = base.ids_file(base.ARM_IDS)[:2]
   778	    rows = base.load_rows(timing) if timing.is_file() else []
   779	    if timing.is_file():
   780	        paths.append(timing)
   781	    inv = inventory([r['instance_id'] for r in rows], expected)
   782	    traces = [Path(run_dir) / 'runs' / iid / 'trace.json' for iid in expected]
   783	    paths.extend(p for p in traces if p.is_file())
   784	    ci = thinking_criterion(traces)
   785	    ti = arm3_timing(rows)
   786	    missing_time = not rows or any(not _finite_number(r.get(k)) for r in rows
   787	                                 for k in ('agent_clock_seconds', 'finalization_seconds'))
   788	    cii = dict(status='UNVERIFIABLE' if missing_time else 'PASS' if ti['timing_pass'] else 'FAIL', **ti)
   789	    headers = _headers(timing) if timing.is_file() else []
   790	    identity = {k: [h.get(k) for h in headers] for k in ('agent_yaml_sha256', 'bundle_sha256')}
   791	    checked_identity = identity_check([run_dir], identity_json, bundle, transports or {}, {str(Path(run_dir))})
   792	    if identity_json and _readable_file(identity_json):
   793	        paths.append(identity_json)
   794	    startup = [r.get('_vllm') for r in map(json.loads, filter(str.strip, timing.read_text().splitlines())) if '_vllm' in r] if timing.is_file() else []
   795	    vllm_up = any(isinstance(v, dict) and _finite_number(v.get('startup_seconds'))
   796	                  and v['startup_seconds'] > 0 for v in startup)
   797	    identity_missing = not headers or any(not v for vals in identity.values() for v in vals)
   798	    identity_conflict = any(len(set(vals)) > 1 for vals in identity.values())
   799	    hs = None
   800	    if timing.is_file() and Path(classifier).is_file():
   801	        paths.append(classifier)
   802	        cs = _classifier(timing, classifier, base.D4_SHA, rows)
   803	        hs = ([r['instance_id'] for r in rows if cs[r['instance_id']]['h'] is not None]
   804	              if all('h' in cs[r['instance_id']] for r in rows) else None)
   805	    verdict_missing = any(type(r.get('resolved')) is not bool or r.get('verification_skipped') is True for r in rows)
   806	    missing = bool(inv['missing']) or not rows or hs is None or identity_missing or verdict_missing or not vllm_up
   807	    ciii = dict(status='FAIL' if inv['extra'] or inv['duplicates'] or identity_conflict or not checked_identity['checked'] or hs else
   808	                'UNVERIFIABLE' if missing else 'PASS', h_rows=hs, identity_headers=identity,
   809	                identity=checked_identity, vllm_up=vllm_up)
   810	    criteria = dict(i=ci, ii=cii, iii=ciii)
   811	    overall = 'PASS' if all(c['status'] == 'PASS' for c in criteria.values()) else 'FAIL'
   812	    return dict(_schema=_schema('arm3smoke', paths), n_rows=len(rows), inventory=inv,
   813	                criteria=criteria, overall=overall,
   814	                verdict='INVALID (smoke i)' if ci['status'] != 'PASS' else overall,
   815	                label='thinking ACTIVE != budget enforced')
