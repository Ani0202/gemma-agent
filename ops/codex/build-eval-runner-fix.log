+        usage=None, tool_args={'command': f'cat /inventory/tasks.jsonl # test_patch FAIL_TO_PASS {ROOT} secret contents'})])
+    out = runner.task_diagnostics(trace, '', 'org/pkg', None, [], Path('/inventory'))
