def test_stub_tool_calls_and_models(tmp_path, monkeypatch):
    script = tmp_path / 'script.json'
    call = dict(id='call_1', type='function', function=dict(name='get_status', arguments='{}'))
    script.write_text(json.dumps([dict(content=None, tool_calls=[call]), dict(content='Done')]))
    # Exercise the actual HTTP handlers with in-memory streams; no socket permissions needed.
    monkeypatch.setattr('eval.stub_openai.ThreadingHTTPServer', lambda address, handler: handler)
    handler_class = make_server(script)
    handler = handler_class.__new__(handler_class)
    handler.send_response = lambda status: None
    handler.send_header = lambda *args: None
    handler.end_headers = lambda: None
    handler.wfile = io.BytesIO()
    handler.path = '/v1/models'
    handler.do_GET()
    assert json.loads(handler.wfile.getvalue())['object'] == 'list'
    for expected in ('tool_calls', 'stop'):
        body = b'{"model":"stub"}'
        handler.path = '/v1/chat/completions'
        handler.headers = {'Content-Length': str(len(body))}
        handler.rfile, handler.wfile = io.BytesIO(body), io.BytesIO()
        handler.do_POST()
        payload = json.loads(handler.wfile.getvalue())
        assert payload['choices'][0]['finish_reason'] == expected
        if expected == 'tool_calls':
            assert payload['choices'][0]['message']['tool_calls'] == [call]
        assert 'usage' not in payload  # Never invent token counts.


@pytest.mark.skipif(os.environ.get('RUN_AGENT_EVAL_E2E') != '1', reason='opt-in real harness smoke test')
def test_e2e(tmp_path):
    iid = sorted(runner.read_ids(ROOT / 'eval/splits/dev.txt') &
                 runner.read_ids(ROOT / 'eval/splits/clean.txt'))[0]
    name = 'test-agent-eval-' + uuid.uuid4().hex[:10]
    script = tmp_path / 'script.json'
    # A harmless source addition exercises tool execution, patch fallback and verification.
    script.write_text(json.dumps([
        dict(content=None, tool_calls=[dict(id='call_1', type='function', function=dict(
            name='run_command', arguments=json.dumps({'command': 'printf "# stub smoke\\n" > stub_smoke.py'})))]),
        dict(content=None, tool_calls=[dict(id='call_2', type='function', function=dict(
            name='submit_patch', arguments='{}'))]), dict(content='Done.')]))
    try:
        server = make_server(script)
    except PermissionError:
        pytest.skip('Sandbox denied localhost socket creation')
    with server:
        thread = threading.Thread(target=server.serve_forever, daemon=True)
        thread.start()
        try:
            with (tmp_path / 'runner.log').open('w') as log:
                proc = subprocess.run([sys.executable, str(ROOT / 'eval/run_agent_eval.py'),
                    '--bundle', str(ROOT / 'bundles/e4b/v000'), '--data-dir', str(ROOT / 'data/raw'),
                    '--split', str(ROOT / 'eval/splits/dev.txt'), '--ids', iid, '--run-name', name,
                    '--concurrency', '1', '--skip-selfcheck', '--max-turns', '4',
                    '--session-minutes', '1', '--endpoint', f'http://127.0.0.1:{server.server_port}/v1'],
                    cwd=ROOT, stdout=log, stderr=log, timeout=240)
            assert proc.returncode == 0, (tmp_path / 'runner.log').read_text()[-2000:]
            path = ROOT / 'results' / f'{name}.jsonl'
            rows = [json.loads(line) for line in path.read_text().splitlines()]
            assert len(rows) == 2 and rows[1]['instance_id'] == iid
            assert rows[1]['llm_turns'] >= 2 and rows[1]['patch_bytes'] > 0
            assert Path(ROOT / rows[1]['trace_path']).is_file()
        finally:
            server.shutdown()
            thread.join()
            (ROOT / 'results' / f'{name}.jsonl').unlink(missing_ok=True)


def test_observe_patch_before_repeated_stripping():
    from contextvars import ContextVar
    state = ContextVar('test_state')
    strip = runner.observe_patch_strip(lambda patch, **kw: patch.replace('TEST', ''), state)
    assert strip('GOLDTEST') == 'GOLD'  # Self-check has no agent context.
    current = {'agent_active': True}
    state.set(current)
    assert strip('SOURCETEST') == 'SOURCE'
    assert strip('SOURCE') == 'SOURCE'  # Harness strips a submitted patch a second time.
    assert current['raw_patch'] == 'SOURCETEST'
    current['agent_active'] = False
    strip('VERIFICATIONTEST')
    assert current['raw_patch'] == 'SOURCETEST'


def test_host_package_isolation_removes_only_harness_pth(tmp_path, monkeypatch):
    pth = tmp_path / 'lib/python3.13/site-packages/_host_env.pth'
    pth.parent.mkdir(parents=True)
    pth.write_text('/harness/site-packages\n')
    image_pth = pth.with_name('image.pth')
    image_pth.write_text('keep')

    class SubprocessManager:
        def start(self):
            self.sandboxes = {'id': {'venv': tmp_path}}
            return 'id'

    monkeypatch.setitem(sys.modules, 'swegemma.sandbox',
                        types.SimpleNamespace(SubprocessManager=SubprocessManager))
    runner.isolate_host_packages()
    runner.isolate_host_packages()  # Idempotent across repeated evaluations.
    assert SubprocessManager().start() == 'id'
    assert not pth.exists() and image_pth.read_text() == 'keep'
"""Offline tests: stdlib unittest, no competition data or harness imports."""
import argparse
import importlib.util
import json
from pathlib import Path
import tempfile
import types
import unittest
from unittest.mock import patch

SCRIPT = Path(__file__).resolve().parents[1] / 'kaggle/gold_calibration.py'
spec = importlib.util.spec_from_file_location('gold_calibration', SCRIPT)
gold = importlib.util.module_from_spec(spec)
spec.loader.exec_module(gold)


def result(task_id='a', repo='org/repo', resolved=True, error=None):
    return dict(instance_id=task_id, repo=repo, resolved=resolved,
                exit_code=0 if resolved else 1, duration_seconds=1.5, error=error)


class ResumeTests(unittest.TestCase):
    def test_success_and_failure_are_finished(self):
        rows = [result(), result('b', resolved=False, error='setup failed')]
        results = gold.finished_results(''.join(json.dumps(row) + '\n' for row in rows))
        tasks = [dict(instance_id=x, repo='org/repo') for x in 'abc']
        self.assertEqual([t['instance_id'] for t in gold.pending_tasks(tasks, results)], ['c'])

    def test_last_completed_duplicate_wins(self):
        rows = [result(resolved=False), result()]
        results = gold.finished_results('\n'.join(map(json.dumps, rows)) + '\n')
        self.assertTrue(results['a']['resolved'])
        self.assertEqual(len(results), 1)

    def test_partial_tail_repaired_and_append_survives_second_resume(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'results.jsonl'
            complete = json.dumps(result()) + '\n'
            path.write_text(complete + '{"instance_id": "unfinished')
            self.assertEqual(set(gold.resume_journal(path)), {'a'})
            self.assertEqual(path.read_text(), complete)
            with path.open('a') as stream:
                stream.write(json.dumps(result('b')) + '\n')
            self.assertEqual(set(gold.resume_journal(path)), {'a', 'b'})

    def test_complete_last_record_without_newline(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / 'results.jsonl'
            path.write_text(json.dumps(result()))
            self.assertEqual(set(gold.resume_journal(path)), {'a'})
            self.assertTrue(path.read_text().endswith('\n'))

    def test_missing_file_and_empty_journal(self):
        with tempfile.TemporaryDirectory() as directory:
            self.assertEqual(gold.resume_journal(Path(directory) / 'absent'), {})
        self.assertEqual(gold.finished_results(''), {})

    def test_corruption_is_not_silently_dropped(self):
        for text in ('bad\n', 'bad\n' + json.dumps(result()), '{}\n',
                     json.dumps(dict(result(), duration_seconds=float('nan'))) + '\n'):
            with self.subTest(text=text), self.assertRaises(ValueError):
                gold.finished_results(text)

    def test_inventory_mismatch_and_duplicate_ids(self):
        tasks = [dict(instance_id='a', repo='org/repo')]
        for inventory, results in ((tasks * 2, {}), (tasks, {'b': result('b')}),
                                   (tasks, {'a': result(repo='wrong/repo')})):
            with self.assertRaises(ValueError):
                gold.pending_tasks(inventory, results)


class SummaryTests(unittest.TestCase):
    def test_all_tasks_counted_by_repo(self):
        tasks = [dict(instance_id=x, repo=repo) for x, repo in
                 [('a', 'org/one'), ('b', 'org/one'), ('c', 'org/two'), ('d', 'org/two')]]
        results = {'a': result('a', 'org/one'),
                   'b': result('b', 'org/one', False, 'setup failed'),
                   'c': result('c', 'org/two', False)}
        summary = gold.summarize(tasks, results)
        self.assertEqual([summary[k] for k in ('total', 'finished', 'passed', 'failed', 'pending')],
                         [4, 3, 1, 2, 1])
        self.assertEqual(summary['passing_ids'], ['a'])
        self.assertEqual(summary['pending_ids'], ['d'])
        self.assertEqual(summary['failing_ids'], [
            dict(instance_id='b', reason='setup failed'),
            dict(instance_id='c', reason='verification unresolved (exit_code=1)')])
        self.assertEqual(summary['per_repo']['org/one'],
                         dict(total=2, finished=2, passed=1, failed=1, pending=0))
        self.assertEqual(summary['per_repo']['org/two'],
                         dict(total=2, finished=1, passed=0, failed=1, pending=1))

    def test_empty_summary_and_short_reasons(self):
        self.assertEqual(gold.summarize([], {})['total'], 0)
        summary = gold.summarize([dict(instance_id='a', repo='org/repo')],
                                {'a': result(resolved=False, error='x' * 500)})
        self.assertEqual(len(summary['failing_ids'][0]['reason']), 200)

    def test_main_fully_resumed_needs_no_harness(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            (root / 'tasks.jsonl').write_text(json.dumps(dict(instance_id='a', repo='org/repo')) + '\n')
            (root / 'gold_results.jsonl').write_text(json.dumps(result()) + '\n')
            with patch('sys.argv', [str(SCRIPT), '--data-dir', str(root), '--working-dir', str(root)]), \
                    patch.object(gold, 'install_harness', side_effect=AssertionError('must not import harness')), \
                    patch('builtins.print'):
                gold.main()
            self.assertEqual(json.loads((root / 'gold_summary.json').read_text())['passing_ids'], ['a'])


class WorkerTests(unittest.TestCase):
    def run_worker(self, verifier):
