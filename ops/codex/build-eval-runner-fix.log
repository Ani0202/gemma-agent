+def test_git_c_quoted_utf8_octal_paths_and_diag_failure(monkeypatch):
+    patch = ('diff --git "a/caf\\303\\251.py" "b/caf\\303\\251.py"\n'
+             '--- "a/caf\\303\\251.py"\n+++ "b/caf\\303\\251.py"\n@@ -1 +1 @@\n-a\n+b\n')
