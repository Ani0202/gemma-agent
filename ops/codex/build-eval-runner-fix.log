+def test_timing_call_ids_errors_and_pending(monkeypatch):
+    now = iter([0, 0.1, 0.2, 0.5, 0.6])
+    monkeypatch.setattr(timing.time, 'monotonic', lambda: next(now))
+    state = timing.ToolTiming()
