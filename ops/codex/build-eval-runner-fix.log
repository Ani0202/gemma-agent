+BWRAP_TEMPLATE = [
+    'bwrap', '--die-with-parent', '--unshare-net', '--unshare-pid',
+    '--ro-bind', '/', '/', '--dev', '/dev', '--proc', '/proc',
+    '--tmpfs', '<each hidden path>', '--tmpfs', '/tmp',
+    '--bind', '<sandbox_root>', '<sandbox_root>',
+    '--ro-bind', '<each ro path>', '<same>',
+    '--chdir', '<workspace>', '/bin/bash', '-c', '<translated_cmd>',
+]
