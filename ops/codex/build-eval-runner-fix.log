+                                          cwd=tmp_path / 'workspace', env={}, timeout=3, shell=False)
+        assert state['cmd_timeouts'] == 2
+        assert seen[0]['command'][0] == 'bwrap'
+        assert seen[0]['command'][-1] == 'translated'
+        assert seen[0]['timeout'] == 3 and seen[0]['shell'] is False
+    finally:
