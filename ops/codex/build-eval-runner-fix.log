+def validate_inventory_ids(path):
+    seen = set()
+    with path.open() as stream:
+        for number, line in enumerate(stream, 1):
+            if not line.strip():
+                continue
+            iid = json.loads(line)['instance_id']
+            if iid in seen:
+                raise ValueError(f'Duplicate inventory IDs at line {number}')
+            seen.add(iid)
