   206	def extract_bundle(encoded, destination):
   207	    payload = base64.b64decode(encoded, validate=True)
   208	    destination.mkdir(parents=True, exist_ok=True)
   209	    with tarfile.open(fileobj=io.BytesIO(payload), mode='r:gz') as tf:
   210	        tf.extractall(destination, filter='data')
   211	    return hashlib.sha256(payload).hexdigest(), hashlib.sha256((destination / 'agent.yaml').read_bytes()).hexdigest()
