   322	    for adapter_name in adapter_map:
   323	        assert _SAFE_PATH_COMPONENT.fullmatch(adapter_name), 'Unsafe adapter name'
   324	    detected_ranks = [r for info in adapter_map.values() if (r := getattr(info, 'rank', None)) is not None and r > 0]
   325	    gpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1
   326	    tp_size = 4 if gpu_count >= 4 else (2 if gpu_count >= 2 else 1)
   327	    vllm_cfg = VllmConfig(
   328	        model=str(MODEL_PATH), port=8000, host='127.0.0.1',
   329	        tool_call_parser='gemma4', reasoning_parser='gemma4', max_model_len=32768,
   330	        dtype='bfloat16' if (torch.cuda.is_available() and torch.cuda.is_bf16_supported()) else 'auto',
   331	        gpu_memory_utilization=0.90, enable_auto_tool_choice=True,
   332	        enable_lora=bool(adapter_map), max_loras=max(1, len(adapter_map)),
   333	        max_lora_rank=max(detected_ranks) if detected_ranks else 128,
   334	        scheduler_reserve_full_isl=False, tensor_parallel_size=tp_size, startup_timeout=60 * 20,
   335	        extra_args=MODEL_VLLM_EXTRA_ARGS.get(declared_model, ()),
   336	    )
   337	    server_instance = VllmServer(vllm_cfg, adapter_manifest=adapters)
   338	    holder.append(server_instance)
   339	    start = time.perf_counter()
   340	    server_instance.start()
   341	    startup = time.perf_counter() - start
   342	    return server_instance, adapters, declared_model, startup
