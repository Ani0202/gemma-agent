    43	        Path('/kaggle/input/gemma-4-developer-agent-metric-data/sandbox/setup.py'),
    44	        Path('/kaggle/input/competition-data/sandbox/setup.py'),
    45	        Path('/kaggle/input/competition-data/rerun/sandbox/setup.py'),
    46	        Path('/kaggle/input/competition-data/secret/sandbox/setup.py'),
    47	        Path('data/competition_data/secret/sandbox/setup.py'),
    48	        Path('competition_data/rerun/sandbox/setup.py'),
    49	        Path('/sandbox/setup.py'),
    50	    ])
    51	
    52	    for cand in candidates:
    53	        if cand.exists() and cand.is_file():
    54	            return cand
    55	    return None
