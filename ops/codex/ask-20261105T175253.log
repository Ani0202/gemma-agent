   198	        logging.warning('bubblewrap unavailable/probe failed; explicitly allowed unsandboxed run',
   199	                        exc_info=True)
   200	    return dict(sandbox=mode, bwrap_argv_template=template, patched=patched,
   201	                wheels_dir=wheels)
