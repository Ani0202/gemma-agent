   198	def distribution(values):
   199	    values = sorted(values)
   200	    def percentile(q):
   201	        x = (len(values) - 1) * q
   202	        lo = int(x)
   203	        return values[lo] + (values[min(lo + 1, len(values)-1)] - values[lo]) * (x-lo)
   204	    return dict(mean=sum(values)/len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))
