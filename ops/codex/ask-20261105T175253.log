    61	def resolve_wheels_dir(config: EvalConfig | None = None) -> Path | None:
    62	    """Finds the local wheels directory containing task dependencies."""
    63	    if config and config.wheels_dir and config.wheels_dir.exists():
    64	        return config.wheels_dir
    65	    candidates = [
    66	        config.tasks_path.parent / 'wheels' if (config and config.tasks_path) else None,
    67	        config.tasks_path.parent / 'sandbox' / 'wheels'
    68	        if (config and config.tasks_path)
    69	        else None,
    70	        config.snapshots_dir.parent / 'wheels'
    71	        if (config and config.snapshots_dir)
    72	        else None,
    73	        Path(
    74	            '/kaggle/input/datasets/metric/gemma-4-developer-agent-metric-data/sandbox/wheels'
    75	        ),
    76	        Path('/kaggle/input/gemma-4-developer-agent-metric-data/sandbox/wheels'),
    77	        Path('/kaggle/input/competition-data/wheels'),
    78	        Path('data/competition_data/secret/sandbox/wheels'),
    79	        Path('wheels'),
    80	        Path('/wheels'),
    81	        Path('/tmp/wheels'),
    82	    ]
    83	    for cand in candidates:
    84	        if cand and cand.is_dir() and any(f.endswith('.whl') for f in os.listdir(cand)):
    85	            return cand
    86	    return None
