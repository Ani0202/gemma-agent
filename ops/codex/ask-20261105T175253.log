    42	def save_trace_artifact(
    43	    trace: SessionTrace | None,
    44	    results_dir: Path | None,
    45	    instance_id: str,
    46	) -> str | None:
    47	    """Saves a SessionTrace to results_dir/traces/trace_<instance_id>.json if available."""
    48	    if trace is None or results_dir is None:
    49	        return None
    50	    try:
    51	        trace_dir = results_dir / 'traces'
    52	        trace_dir.mkdir(parents=True, exist_ok=True)
    53	        safe_id = instance_id.replace('/', '__')
    54	        trace_path = trace_dir / f'trace_{safe_id}.json'
    55	        trace.save(trace_path)
    56	        return str(trace_path)
    57	    except Exception as tr_err:
    58	        logger.warning('Failed to save trace for task %s: %s', instance_id, tr_err)
    59	        return None
