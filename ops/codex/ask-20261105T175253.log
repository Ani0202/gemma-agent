   234	def setup_script_identity(data_dir):
   235	    """Resolved path + content hash of the setup script (part of resume identity)."""
   236	    import hashlib
   237	    path = setup_script_path(data_dir)
   238	    return dict(path=str(path.resolve()),
   239	                sha256=hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None)
