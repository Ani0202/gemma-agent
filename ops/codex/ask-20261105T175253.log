    31	def normalize_pkg_name(name: str) -> str:
    32	    """Normalizes package name per PEP 503."""
    33	    return re.sub(r"[-_.]+", "-", name).lower()
    34	
    35	
    36	def is_prebaked_env() -> bool:
    37	    """Checks if the sandbox environment already has pre-baked wheels installed."""
    38	    return os.environ.get("SWE_PREBAKED", "").lower() in ("1", "true", "yes")
    39	
    40	
    41	def find_site_packages_dir() -> Path | None:
    42	    """Finds the primary site-packages directory for the current Python interpreter."""
    43	    import site
    44	    packages = site.getsitepackages()
    45	    for p in packages:
    46	        candidate = Path(p)
    47	        if candidate.exists() and os.access(candidate, os.W_OK):
    48	            return candidate
    49	    user_site = site.getusersitepackages()
    50	    if user_site:
    51	        candidate = Path(user_site)
    52	        if candidate.exists() and os.access(candidate, os.W_OK):
    53	            return candidate
    54	    for p in sys.path:
    55	        candidate = Path(p)
    56	        if candidate.name == "site-packages" and candidate.exists() and os.access(candidate, os.W_OK):
    57	            return candidate
    58	    return None
    59	
    60	
    61	def parse_wheel_filename(filename: str) -> dict[str, Any] | None:
    62	    """Parses a wheel filename according to PEP 427."""
    63	    if not filename.endswith(".whl"):
    64	        return None
    65	    stem = filename[:-4]
    66	    parts = stem.split("-")
    67	    if len(parts) < 5:
    68	        return None
    69	    distribution = parts[0]
    70	    version = parts[1]
    71	    pyver = parts[-3]
    72	    abi = parts[-2]
    73	    plat = parts[-1]
    74	    return {
    75	        "distribution": distribution,
    76	        "normalized": normalize_pkg_name(distribution),
    77	        "version": version,
    78	        "pyver": pyver,
    79	        "abi": abi,
    80	        "plat": plat,
    81	        "filename": filename,
    82	    }
    83	
    84	
    85	def parse_semver_for_sort(version_str: str) -> tuple[int, ...]:
    86	    """Extracts numeric semver components for sorting wheel versions."""
    87	    nums = [int(p) for p in re.findall(r"\d+", version_str)]
    88	    return tuple(nums) if nums else (0,)
    89	
    90	
    91	def deduplicate_wheels(wheel_files: list[str]) -> dict[str, str]:
    92	    """Selects the highest version wheel per normalized distribution name."""
    93	    grouped: dict[str, list[dict[str, Any]]] = {}
    94	    for filename in wheel_files:
    95	        info = parse_wheel_filename(filename)
    96	        if info is not None:
    97	            grouped.setdefault(info["normalized"], []).append(info)
    98	
    99	    selected: dict[str, str] = {}
   100	    for norm_name, candidates in grouped.items():
   101	        sorted_candidates = sorted(
   102	            candidates,
   103	            key=lambda c: (
   104	                parse_semver_for_sort(c["version"]),
   105	                1 if "py3" in c["pyver"] or "py2.py3" in c["pyver"] else 0,
   106	                c["filename"],
   107	            ),
   108	            reverse=True,
   109	        )
   110	        selected[norm_name] = sorted_candidates[0]["filename"]
   111	    return selected
   112	
   113	
   114	def get_available_packages(wheels_dir: Path = WHEELS_DIR) -> dict[str, str]:
   115	    """Returns mapping of normalized package name to wheel filename in wheels_dir."""
   116	    if not wheels_dir.exists():
   117	        return {}
   118	    all_whl = [f for f in os.listdir(wheels_dir) if f.endswith(".whl")]
   119	    return deduplicate_wheels(all_whl)
