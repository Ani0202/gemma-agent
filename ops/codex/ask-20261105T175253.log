   146	def trace_counts(trace):
   147	    entries = trace.entries if trace else []
   148	    counts = Counter(e.tool_name for e in entries if e.event_type == 'tool_call')
   149	    tokens = {}
   150	    for key in ('prompt_tokens', 'completion_tokens'):
   151	        values = [e.usage[key] for e in entries if e.usage and isinstance(e.usage.get(key), (int, float))]
   152	        tokens[key] = sum(values) if values else None
   153	    return dict(counts), tokens, tool_seconds(entries)
   154	
   155	def tool_seconds(entries):
   156	    """Per tool name: wall seconds from each tool_call to its tool_response (FIFO per name)."""
   157	    pending, out = {}, {}
   158	    for e in entries:
   159	        if e.event_type == 'tool_call':
   160	            pending.setdefault(e.tool_name, []).append(e.timestamp)
   161	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   162	            stat = out.setdefault(e.tool_name, dict(n=0, total=0.0, max=0.0))
   163	            dt = max(0.0, e.timestamp - pending[e.tool_name].pop(0))
   164	            stat['n'] += 1
   165	            stat['total'] = round(stat['total'] + dt, 3)
   166	            stat['max'] = round(max(stat['max'], dt), 3)
   167	    return out
