   123	    """Removes comments, markers, extras, and version constraints from a requirement line."""
   124	    line = line.strip()
   125	    if not line or line.startswith("#") or line.startswith("-"):
   126	        return ""
   127	    line = re.sub(r";.*$", "", line)
   128	    line = re.sub(r"\[.*?\]", "", line)
   129	    line = re.split(r"[=<>!~]", line)[0]
   130	    return line.strip()
   131	
   132	
   133	def collect_from_pyproject(pyproject_path: Path) -> list[str]:
   134	    """Collects dependencies and test/optional-dependencies from pyproject.toml."""
   135	    if not pyproject_path.exists() or tomllib is None:
   136	        return []
   137	    try:
   138	        with open(pyproject_path, "rb") as f:
   139	            data = tomllib.load(f)
   140	    except Exception as e:
   141	        print(f"Warning: could not parse {pyproject_path}: {e}", file=sys.stderr)
   142	        return []
   143	
   144	    collected: list[str] = []
   145	    project = data.get("project", {})
   146	    for dep in project.get("dependencies", []):
   147	        cleaned = clean_requirement_line(dep)
   148	        if cleaned:
   149	            collected.append(cleaned)
   150	    for group, deps in project.get("optional-dependencies", {}).items():
   151	        for dep in deps:
   152	            cleaned = clean_requirement_line(dep)
   153	            if cleaned:
   154	                collected.append(cleaned)
   155	    return collected
   156	
   157	
   158	def collect_from_requirements_files(workspace: Path) -> list[str]:
   159	    """Collects dependency names from requirements*.txt and test-requirements*.txt."""
   160	    collected: list[str] = []
   161	    req_files = list(workspace.glob("**/requirements*.txt")) + list(workspace.glob("**/test-requirements*.txt"))
   162	    for rf in req_files:
   163	        if "docker/" in str(rf) or ".git" in str(rf):
   164	            continue
   165	        try:
   166	            for line in rf.read_text(encoding="utf-8", errors="replace").splitlines():
   167	                cleaned = clean_requirement_line(line)
   168	                if cleaned:
   169	                    collected.append(cleaned)
   170	        except Exception:
   171	            pass
   172	    return collected
   173	
   174	
   175	def setup_git_exclude(workspace: Path) -> None:
   176	    """Configures git exclude rules to keep git diff clean."""
   177	    exclude_file = workspace / ".git" / "info" / "exclude"
   178	    exclude_file.parent.mkdir(parents=True, exist_ok=True)
   179	    rules = "__pycache__/\n*.pyc\n.pytest_cache/\n*.egg-info/\nbuild/\ndist/\n.coverage\n"
   180	    try:
   181	        if exclude_file.exists():
   182	            existing = exclude_file.read_text(encoding="utf-8", errors="replace")
   183	            to_add = [r for r in rules.splitlines() if r not in existing]
   184	            if to_add:
   185	                with open(exclude_file, "a", encoding="utf-8") as f:
   186	                    f.write("\n" + "\n".join(to_add) + "\n")
   187	        else:
   188	            exclude_file.write_text(rules, encoding="utf-8")
   189	    except Exception as e:
   190	        print(f"Notice: setup_git_exclude skipped: {e}", file=sys.stderr)
   191	
   192	
   193	def install_editable_package(workspace: Path) -> None:
   194	    """Installs the workspace repository in editable mode without dependencies."""
   195	    cmd = [
   196	        sys.executable,
   197	        "-m",
   198	        "pip",
   199	        "install",
   200	        "--no-index",
   201	        f"--find-links={WHEELS_DIR}",
   202	        "--no-build-isolation",
   203	        "--no-deps",
   204	        "-e",
   205	        str(workspace),
   206	    ]
   207	    try:
   208	        res = subprocess.run(cmd, capture_output=True, text=True, check=False)
   209	        if res.returncode != 0:
   210	            fallback = [sys.executable, "-m", "pip", "install", "--no-deps", "-e", str(workspace)]
   211	            subprocess.run(fallback, capture_output=True, text=True, check=False)
   212	    except Exception as e:
   213	        print(f"Notice: install_editable_package skipped: {e}", file=sys.stderr)
   214	
   215	
   216	def configure_workspace_pytest_ini(workspace: Path) -> None:
   217	    """Configures pytest.ini in the workspace root for robust test discovery."""
   218	    ini_path = workspace / "pytest.ini"
   219	    existing = ""
   220	    if ini_path.exists():
   221	        try:
   222	            existing = ini_path.read_text(encoding="utf-8", errors="replace")
   223	        except Exception:
   224	            existing = ""
   225	
   226	    default_addopts = "--import-mode=importlib -p no:anyio"
   227	    norecursedirs_val = ".* build dist venv"
   228	
   229	    if "[pytest]" in existing:
   230	        lines = []
   231	        has_addopts = False
   232	        has_norecursedirs = False
   233	        for line in existing.splitlines():
   234	            if line.strip().startswith("addopts"):
   235	                has_addopts = True
   236	                curr_opts = line.split("=", 1)[1] if "=" in line else ""
   237	                for opt in default_addopts.split():
   238	                    if opt not in curr_opts:
   239	                        line = line.rstrip() + " " + opt
   240	                lines.append(line)

