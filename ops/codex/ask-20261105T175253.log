   120	            match = re.match(r'^diff --git ("a/.*?"|a/.*?) ("b/.*?"|b/.*)$', line)
   121	            if match:
   122	                current.update(path_value(p) for p in match.groups())
   123	        elif line.startswith('@@'):
   124	            in_hunk = True
   125	        elif not in_hunk:
   126	            if line.startswith(('--- ', '+++ ')):
   127	                p = path_value(line[4:])
   128	                if p != '/dev/null':
   129	                    current.add(p)
   130	                elif line.startswith('--- '):
   131	                    added = True
   132	            elif line.startswith('new file mode '):
   133	                added = True
   134	            elif line.startswith(('rename from ', 'rename to ')):
   135	                current.add(path_value(line.split(' ', 2)[2]))
   136	    if protected is None:
   137	        protected = lambda p: bool(re.search(r'(^|/)(tests?/|test_[^/]*\.py$|conftest\.py$)|_test\.py$', p))
   138	    tests = sorted(p for p in files if protected(p) or p in test_targets)
   139	    package = repo.split('/')[-1].replace('-', '_').lower()
   140	    source_roots = (package + '/', 'src/' + package + '/')
   141	    stray = sorted(p for p in new if not (p.endswith('.py') and p.lower().startswith(source_roots)
   142	                                         and p not in tests))
   143	    return dict(patch_bytes=len(patch.encode()), patch_files=sorted(files),
   144	                test_files_edited=tests, stray_files=stray, empty_patch=not patch.strip())
