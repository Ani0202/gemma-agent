   169	def observe_patch_strip(original, state):
   170	    """Retain the agent's diff before the harness removes protected edits."""
   171	    def strip(patch, *pos, **kw):
   172	        current = state.get(None)
   173	        filtered = original(patch, *pos, **kw)
   174	        if current is not None and current.get('agent_active'):
   175	            if patch != current.get('filtered_patch'):
   176	                current['raw_patch'] = patch
   177	            current['filtered_patch'] = filtered
   178	        return filtered
   179	    return strip
