   863	
   864	def setup_workspace_test_config(
   865	    docker: BaseSandboxManager,
   866	    container_id: str,
   867	    repo: str = '',
   868	    *,
   869	    workspace_dir: str = '/workspace',
   870	    overwrite: bool = False,
   871	) -> None:
   872	    """Configures baseline pytest.ini and conftest.py in the container workspace if not already configured by sandbox/setup.py."""
   873	    script = r'''
   874	import sys
   875	from pathlib import Path
   876	
   877	ws = Path(sys.argv[1]).resolve()
   878	repo = sys.argv[2] if len(sys.argv) > 2 else ""
   879	overwrite = sys.argv[3] == "1" if len(sys.argv) > 3 else False
   880	
   881	# 1. Configure pytest.ini if not already configured by sandbox/setup.py
   882	ini_path = ws / "pytest.ini"
   883	existing_ini = ""
   884	if ini_path.exists():
   885	    try:
   886	        existing_ini = ini_path.read_text(errors="replace")
   887	    except Exception:
   888	        existing_ini = ""
   889	
   890	if overwrite or ("# Hermetic test discovery" not in existing_ini and "[pytest]" not in existing_ini):
   891	    content = """[pytest]
   892	addopts = -p no:anyio
   893	norecursedirs = .* build dist venv
   894	python_classes = Test* *Test
   895	python_files = test_*.py *_test.py
   896	filterwarnings =
   897	    ignore::DeprecationWarning
   898	    ignore::UserWarning
   899	"""
   900	    try:
   901	        ini_path.write_text(content)
   902	    except Exception as e:
   903	        sys.stderr.write(f"Warning: could not write {ini_path}: {e}\n")
   904	
   905	# 2. Configure conftest.py if not already configured by sandbox/setup.py
   906	conftest_path = ws / "conftest.py"
   907	existing = ""
   908	if conftest_path.exists():
   909	    try:
   910	        existing = conftest_path.read_text(errors="replace")
   911	    except Exception:
   912	        existing = ""
   913	
   914	hook_header = "# Hermetic test discovery hook for SWE-gemma\n"
   915	if overwrite or (
   916	    "# Hermetic test discovery hook for SWE-gemma" not in existing
   917	    and "# Standard test discovery hook for SWE-gemma" not in existing
   918	):
   919	    clean_existing = existing.replace(hook_header, "").strip()
   920	    new_conftest = hook_header + ("\n" + clean_existing if clean_existing else "") + "\n"
   921	    try:
   922	        conftest_path.write_text(new_conftest)
   923	    except Exception as e:
   924	        sys.stderr.write(f"Warning: could not write {conftest_path}: {e}\n")
   925	'''
   926	    overwrite_flag = '1' if overwrite else '0'
   927	    cmd = (
   928	        f'python3 -S -c {shlex.quote(script)} {shlex.quote(workspace_dir)}'
   929	        f' {shlex.quote(repo)} {overwrite_flag}'
   930	    )
   931	    res = docker.exec(container_id, cmd)
   932	    if res.exit_code != 0:
   933	        logger.warning(
   934	            'Failed to setup workspace test config for %s (exit code %d): %s',
   935	            repo,
   936	            res.exit_code,
   937	            res.stderr or res.stdout,
   938	        )
   939	
