    92	def apply_isolation(hidden_paths, ro_paths):
    93	    """Wrap the module executor, retaining the installed manager's translation/env.
    94	
    95	    Empty hidden_paths disables bwrap (explicit opt-out), but retains timeout
    96	    accounting. Repeated setup replaces this hook rather than stacking it.
    97	    """
    98	    import swegemma.sandbox.subprocess as sb
    99	    hidden_paths, ro_paths = tuple(hidden_paths), tuple(ro_paths)
   100	    original = getattr(sb.execute_subprocess_command, '_unwrapped', sb.execute_subprocess_command)
   101	
   102	    def execute(command, cwd, env, **kwargs):
   103	        if ro_paths:
   104	            command = [*command[:2], re.sub(r'(?<![\w.-])/wheels(?![\w.-])',
   105	                                           str(Path(ro_paths[0]).resolve()), command[2])]
   106	        if hidden_paths:
   107	            if not isinstance(command, list) or command[:2] != ['/bin/bash', '-c']:
   108	                raise RuntimeError('Unsupported harness subprocess command')
   109	            # The harness's fallback wheel search doesn't include custom data dirs.
   110	            command = bwrap_argv(command, cwd, hidden_paths, runtime_ro_paths(cwd, ro_paths))
   111	        result = original(command=command, cwd=cwd, env=env, **kwargs)
   112	        metrics = command_metrics.get()
   113	        if metrics is not None and (result.status == 'timeout' or result.exit_code == 124):
   114	            metrics['cmd_timeouts'] = metrics.get('cmd_timeouts', 0) + 1
   115	        return result
   116	
   117	    execute._unwrapped = original
   118	    sb.execute_subprocess_command = execute
   119	    return BWRAP_TEMPLATE.copy()
