     1	"""Summarize a downloaded kaggle_timing_v1 journal without reading raw task artifacts."""
     2	import argparse
     3	import json
     4	import math
     5	from pathlib import Path
     6	
     7	
     8	def distribution(values):
     9	    values = sorted(values)
    10	    def percentile(q):
    11	        pos = (len(values) - 1) * q
    12	        low = int(pos)
    13	        return values[low] + (values[min(low + 1, len(values) - 1)] - values[low]) * (pos - low)
    14	    return dict(mean=sum(values) / len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))
    15	
    16	
    17	def summarize(path):
    18	    records = [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
    19	    if not records or records[0].get('_schema') != 'kaggle_timing_v1':
    20	        raise ValueError('Expected kaggle_timing_v1 header')
    21	    header, rows, startup, done, stopped = records[0], [], records[0].get('vllm_startup_seconds'), None, []
    22	    for row in records[1:]:
    23	        if 'instance_id' in row:
    24	            rows.append(row)
    25	        elif '_vllm' in row:
    26	            startup = row['_vllm']['startup_seconds']
    27	        elif '_done' in row:
    28	            done = row['_done']
    29	        elif '_stopped' in row:
    30	            stopped.append(row['_stopped'])
    31	        else:
    32	            raise ValueError('Unknown journal record')
    33	    ids = [r['instance_id'] for r in rows]
    34	    if len(ids) != len(set(ids)) or set(ids) - set(header['task_ids']):
    35	        raise ValueError('Duplicate or unexpected task records')
    36	    if done is not None and done['n'] != len(rows):
    37	        raise ValueError('Done count does not match task records')
    38	    def numbers(values):
    39	        if any(type(v) not in (int, float) or not math.isfinite(v) or v < 0 for v in values):
    40	            raise ValueError('Invalid measurement')
    41	        return values
    42	    totals = distribution(numbers([r['wall_seconds']['total'] for r in rows]))
    43	    shares = distribution(numbers([r['test_run']['share_of_agent_seconds'] for r in rows if r['test_run']['share_of_agent_seconds'] is not None]))
    44	    runs = distribution(numbers([r['test_run']['n'] for r in rows]))
    45	    caps = header.get('caps') or {}
    46	    cap = caps.get('max_time_minutes')
    47	    numbers([v for v in (startup, cap) if v is not None])
    48	    timing_minutes = totals['p90'] * 125 / 60 + startup / 60 if totals['p90'] is not None and startup is not None else None
    49	    cap_minutes = cap * 125 + 30 if cap is not None else None
    50	    return dict(_schema='kaggle_timing_summary_v1', n=len(rows), vllm_startup_seconds=startup,
    51	                total_seconds=totals, test_run_share=shares, test_runs_per_task=runs,
    52	                empty_patch_count=sum(bool(r['empty_patch']) for r in rows),
    53	                test_files_edited_count=sum(bool(r['test_files_edited']) for r in rows),
    54	                stray_files_count=sum(bool(r['stray_files']) for r in rows),
    55	                test_files_edited_files=sum(len(r['test_files_edited']) for r in rows),
    56	                stray_files_files=sum(len(r['stray_files']) for r in rows),
    57	                decision='PASS' if timing_minutes is not None and cap_minutes is not None and timing_minutes <= 660 and cap_minutes <= 660 else 'FAIL',
    58	                projected_minutes=timing_minutes, cap_worst_case_minutes=cap_minutes,
    59	                cap_minutes=cap, missing_task_ids=[iid for iid in header['task_ids'] if iid not in ids],
    60	                done_present=done is not None, stopped=stopped)
    61	
    62	
    63	def main():
    64	    parser = argparse.ArgumentParser(description=__doc__)
    65	    parser.add_argument('timing_jsonl', type=Path)
    66	    parser.add_argument('--output', type=Path, required=True)
    67	    args = parser.parse_args()
    68	    summary = summarize(args.timing_jsonl)
    69	    args.output.write_text(json.dumps(summary, indent=2, allow_nan=False) + '\n')
    70	    print(json.dumps(summary, indent=2, allow_nan=False))
    71	
    72	
    73	if __name__ == '__main__':
    74	    main()

