1 {"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat_minor":4,"nbformat":4,"cells":[{"id":"827a919e","cell_type":"markdown","source":"# Getting Started: Gemma 4 Developer Agent","metadata":{}},{"id":"b477808c","cell_type":"markdown","source":"## 1. Environment Configuration and Package Installation","metadata":{}},{"id":"e368fd3b","cell_type":"code","source":"import glob\nimport importlib\nimport logging\nimport os\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\n# Configure environment variables for offline vLLM serving and LiteLLM routing\nos.environ['TRANSFORMERS_NO_TF'] = '1'\nos.environ['TRANSFORMERS_NO_FLAX'] = '1'\nos.environ['TRANSFORMERS_OFFLINE'] = '1'\nos.environ['VLLM_NO_USAGE_STATS'] = '1'\nos.environ['VLLM_WORKER_MULTIPROC_METHOD'] = 'spawn'\nos.environ['VLLM_ENGINE_READY_TIMEOUT_S'] = '1200'\nos.environ['VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS'] = '1'\nos.environ['NCCL_DEBUG'] = 'WARN'\nos.environ['LITELLM_LOCAL_MODEL_COST_MAP'] = 'True'\nos.environ['LITELLM_TELEMETRY'] = 'False'\nos.environ['LITELLM_LOG'] = 'WARNING'\nos.environ['OPENAI_API_KEY'] = os.environ.get('OPENAI_API_KEY', 'EMPTY')\nos.environ['LOCAL_API_KEY'] = os.environ.get('LOCAL_API_KEY', 'EMPTY')\nos.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True'\nos.environ['OTEL_SDK_DISABLED'] = 'true'\nos.environ['OTEL_PYTHON_DISABLED'] = 'true'\n\n\ndef configure_logging() -> None:\n    \"\"\"Silence verbose third-party loggers.\"\"\"\n    for name in (\n        'LiteLLM',\n        'LiteLLM Router',\n        'LiteLLM Proxy',\n        'litellm',\n        'httpx',\n        'httpcore',\n        'openai',\n        'urllib3',\n        'opentelemetry',\n        'opentelemetry.context',\n    ):\n        lg = logging.getLogger(name)\n        lg.setLevel(logging.WARNING)\n        if 'litellm' in name.lower():\n            lg.propagate = False\n            lg.handlers.clear()\n\n\nconfigure_logging()\n\nWHEELHOUSE_DIR = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')\n\n# Remove broken cutlass .pth hooks if present\nfor pth_pattern in (\n    '/usr/local/lib/python*/dist-packages/*cutlass*.pth',\n    '/usr/local/lib/python*/site-packages/*cutlass*.pth',\n):\n    for pth in glob.glob(pth_pattern):\n        try:\n            os.unlink(pth)\n        except OSError:\n            pass\n\n# Restore PEP 440 '+cu128' wheel filenames stripped by Kaggle dataset uploads\ntmp_whl = Path('/tmp/wheelhouse')\ntmp_whl.mkdir(parents=True, exist_ok=True)\nfor w in WHEELHOUSE_DIR.glob('*.whl'):\n    if 'cutlass' in w.name.lower():\n        continue\n    target_name = (\n        w.name.replace('cu128', '+cu128')\n        if ('cu128' in w.name and '+' not in w.name)\n        else w.name\n    )\n    target = tmp_whl / target_name\n    if not target.exists():\n        try:\n            os.symlink(w, target)\n        except OSError:\n            shutil.copyfile(w, target)\n\nwheels = sorted(str(w) for w in tmp_whl.glob('*.whl'))\nprint(f'Installing {len(wheels)} wheels from {WHEELHOUSE_DIR}...')\nsubprocess.run(\n    [sys.executable, '-m', 'pip', 'install', '-q', '--no-deps', '--force-reinstall', *wheels],\n    check=True,\n)\nimportlib.invalidate_caches()\nconfigure_logging()\nprint('Wheelhouse installation complete.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:05:37.865566Z","iopub.execute_input":"2026-10-12T21:05:37.866106Z","iopub.status.idle":"2026-10-12T21:06:29.01204Z","shell.execute_reply.started":"2026-10-12T21:05:37.866079Z","shell.execute_reply":"2026-10-12T21:06:29.011451Z"}},"outputs":[],"execution_count":null},{"id":"ac6108fa","cell_type":"markdown","source":"## 2. Competition Dataset and Sample Submission","metadata":{}},{"id":"63cb4756","cell_type":"code","source":"import re\nfrom swegemma.models import load_tasks\n\nDATA_DIR = Path('/kaggle/input/competitions/gemma-4-developer-agent')\nWORKING_DIR = Path('/kaggle/working')\nWORKING_DIR.mkdir(parents=True, exist_ok=True)\n\n# Official quantized competition models:\n#   - 'gemma-4-31b-it-qat-w4a16-ct' (default in sample_submission)\n#   - 'gemma-4-12b-it-qat-w4a16-ct'\n#   - 'gemma-4-e4b-it-qat-w4a16-ct'\n#   - 'gemma-4-e2b-it-qat-w4a16-ct'\nMODEL_NAME = 'gemma-4-12b-it-qat-w4a16-ct'\n\n# Copy sample_submission to a writable directory for customization and packaging\nSAMPLE_SUBMISSION_SRC = DATA_DIR / 'sample_submission'\nAGENT_DIR = WORKING_DIR / 'sample_submission'\nif AGENT_DIR.exists():\n    shutil.rmtree(AGENT_DIR)\nshutil.copytree(SAMPLE_SUBMISSION_SRC, AGENT_DIR)\n\n# If switching away from 31B, update all agent YAMLs and remove the 31B-shaped sample LoRA adapters\nif MODEL_NAME != 'gemma-4-31b-it-qat-w4a16-ct':\n    for yaml_path in [AGENT_DIR / 'agent.yaml', *sorted((AGENT_DIR / 'sub_agents').glob('*.yaml'))]:\n        if yaml_path.is_file():\n            text = yaml_path.read_text(encoding='utf-8')\n            text = re.sub(r'^(\\s*model:\\s*).*$', rf'\\g<1>{MODEL_NAME}', text, flags=re.MULTILINE)\n            text = re.sub(r'^\\s*adapter:\\s*.*\\n?', '', text, flags=re.MULTILINE)\n            yaml_path.write_text(text, encoding='utf-8')\n    shutil.rmtree(AGENT_DIR / 'adapters', ignore_errors=True)\n\n# Load tasks from the published dataset\nTASKS_PATH = DATA_DIR / 'tasks.jsonl'\ntasks = load_tasks(TASKS_PATH)\n\nprint(f'Data directory: {DATA_DIR}')\nprint(f'Agent directory: {AGENT_DIR} (model={MODEL_NAME})')\nprint(f'Loaded {len(tasks)} tasks from {TASKS_PATH.name}')\nfor t in tasks[:5]:\n    print(f'  - {t.instance_id} ({t.repo} @ {t.base_commit[:8]})')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:06:29.013073Z","iopub.execute_input":"2026-10-12T21:06:29.013348Z","iopub.status.idle":"2026-10-12T21:07:01.669942Z","shell.execute_reply.started":"2026-10-12T21:06:29.013328Z","shell.execute_reply":"2026-10-12T21:07:01.669362Z"}},"outputs":[],"execution_count":null},{"id":"129a9e54","cell_type":"markdown","source":"## 3. Code Graph Functions","metadata":{}},{"id":"9280c4a8","cell_type":"code","source":"from swegemma import graph as sg\n\nsample_task = tasks[0]\nGRAPH_DIR = str(DATA_DIR / 'graphs')\nEMBEDDINGS_DIR = str(DATA_DIR / 'embeddings')\n\n# Load the pre-computed repository code graph and node embeddings for the sample task\nrepo_graph = sg.get_graph(\n    repo_name=sample_task.repo,\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    base_commit=sample_task.base_commit,\n)\nsample_nodes = list(repo_graph.nodes())\nprint(f'Graph for {sample_task.repo} ({sample_task.instance_id}):')\nprint(f'  Nodes: {repo_graph.number_of_nodes()}, Edges: {repo_graph.number_of_edges()}')\n\n# Select a connected symbol and query structural neighbors (callers, callees, definitions)\nquery_node = next((n for n, deg in repo_graph.degree() if deg >= 5), sample_nodes[0])\nneighbors = sg.get_neighbor(\n    node=query_node,\n    graph=repo_graph,\n    max_neighbors=10,\n)\nprint(f'\\nNeighbors of {query_node!r} (showing up to 5):')\nfor n in neighbors[:5]:\n    print(f'  - {n}')\n\n# Search for semantically similar code nodes using pre-computed vector embeddings\nsimilar = sg.get_similar_nodes(\n    node=query_node,\n    repo_name=sample_task.repo,\n    k=5,\n    graph=repo_graph,\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    base_commit=sample_task.base_commit,\n)\nprint(f'\\nTop similar nodes to {query_node!r}:')\nfor item in similar:\n    print(f\"  - {item['node_name']} (similarity={item['similarity']:.4f})\")\n\n# Extract an induced subgraph connecting the query symbol and its neighbors\nfocal_nodes = [query_node, *neighbors[:4]]\nsubgraph = sg.get_induced_subgraph(repo_graph, focal_nodes)\nprint(\n    f'\\nInduced subgraph over {len(focal_nodes)} focal nodes: '\n    f'{subgraph.number_of_nodes()} nodes, {subgraph.number_of_edges()} edges'\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:07:01.670681Z","iopub.execute_input":"2026-10-12T21:07:01.671113Z","iopub.status.idle":"2026-10-12T21:07:03.162442Z","shell.execute_reply.started":"2026-10-12T21:07:01.671086Z","shell.execute_reply":"2026-10-12T21:07:03.161745Z"}},"outputs":[],"execution_count":null},{"id":"86ef881b","cell_type":"markdown","source":"## 4. Start vLLM Server","metadata":{}},{"id":"f0b1ab0d","cell_type":"code","source":"import litellm\nimport torch\nfrom adk_submission import VllmConfig, VllmServer, discover_adapters\nfrom adk_submission.discovery import discover_declared_models\nfrom swegemma.config import ALLOWED_ADAPTER_EXTENSIONS\n\nlitellm.drop_params = True\n\nALLOWED_MODEL_NAMES = frozenset({\n    'gemma-4-31b-it-qat-w4a16-ct',\n    'gemma-4-12b-it-qat-w4a16-ct',\n    'gemma-4-e4b-it-qat-w4a16-ct',\n    'gemma-4-e2b-it-qat-w4a16-ct',\n})\nMODEL_VLLM_EXTRA_ARGS = {\n    'gemma-4-12b-it-qat-w4a16-ct': (\n        '--hf-overrides',\n        '{\"architectures\": [\"Gemma4ForCausalLM\"], \"model_type\": \"gemma4\"}',\n    ),\n}\n_SAFE_PATH_COMPONENT = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')\nINFERENCE_API_KEY = os.environ.get('LOCAL_API_KEY', 'EMPTY')\n\n# Validate single canonical base model and discover any PEFT LoRA adapters in the submission directory.\n# Note: sample_submission includes dummy LoRA adapters (adapters/main_lora and adapters/tool_lora)\n# shaped for gemma-4-31b-it-qat-w4a16-ct; Cell 2 removes them automatically when MODEL_NAME != 31B.\ndeclared_models = discover_declared_models(AGENT_DIR)\nassert len(declared_models) == 1, f'Expected exactly 1 declared model, got: {sorted(declared_models)}'\ndeclared_model = next(iter(declared_models))\nassert declared_model in ALLOWED_MODEL_NAMES, f'Unsupported model {declared_model!r}. Allowed: {sorted(ALLOWED_MODEL_NAMES)}'\n\nMODEL_PATH = Path(f'/kaggle/input/models/google/gemma-4/other/{declared_model}/2')\nassert MODEL_PATH.exists(), f'Model weights not found at {MODEL_PATH}. Ensure the model input is attached.'\n\nadapters = discover_adapters(str(AGENT_DIR), adapter_extensions=ALLOWED_ADAPTER_EXTENSIONS)\nadapter_map = getattr(adapters, 'adapters', None) or {}\nfor adapter_name in adapter_map:\n    assert _SAFE_PATH_COMPONENT.fullmatch(adapter_name), (\n        f'Unsafe adapter name {adapter_name!r}: must match [A-Za-z0-9][A-Za-z0-9._-]*'\n    )\ndetected_ranks = [\n    r for info in adapter_map.values() if (r := getattr(info, 'rank', None)) is not None and r > 0\n]\n\ngpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1\ntp_size = 4 if gpu_count >= 4 else (2 if gpu_count >= 2 else 1)\n\nif 'server_instance' in globals() and server_instance is not None:\n    server_instance.stop()\n\nvllm_cfg = VllmConfig(\n    model=str(MODEL_PATH),\n    port=8000,\n    host='127.0.0.1',\n    tool_call_parser='gemma4',\n    reasoning_parser='gemma4',\n    max_model_len=32768,\n    dtype='bfloat16' if (torch.cuda.is_available() and torch.cuda.is_bf16_supported()) else 'auto',\n    gpu_memory_utilization=0.90,\n    enable_auto_tool_choice=True,\n    enable_lora=bool(adapter_map),\n    max_loras=max(1, len(adapter_map)),\n    max_lora_rank=max(detected_ranks) if detected_ranks else 128,\n    scheduler_reserve_full_isl=False,\n    tensor_parallel_size=tp_size,\n    startup_timeout=60 * 20,\n    extra_args=MODEL_VLLM_EXTRA_ARGS.get(declared_model, ()),\n)\nserver_instance = VllmServer(vllm_cfg, adapter_manifest=adapters)\nserver_instance.start()\nprint(f'vLLM server started on {server_instance.base_url} (tp={tp_size})')\n\n# Register model and LoRA adapter aliases for Google ADK\nmodels = server_instance.create_model_registry(\n    aliases=[declared_model],\n    model_prefix='openai/',\n    api_key=INFERENCE_API_KEY,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:11:28.843785Z","iopub.execute_input":"2026-10-12T21:11:28.844384Z","iopub.status.idle":"2026-10-12T21:15:30.765782Z","shell.execute_reply.started":"2026-10-12T21:11:28.844352Z","shell.execute_reply":"2026-10-12T21:15:30.765199Z"}},"outputs":[],"execution_count":null},{"id":"a0434776","cell_type":"markdown","source":"## 5. Run Phase 1 Inference and Phase 2 Verification","metadata":{}},{"id":"105c5b68","cell_type":"code","source":"import asyncio\nimport concurrent.futures\nimport pandas as pd\nimport yaml\nfrom google.adk.agents.context_cache_config import ContextCacheConfig\nfrom google.adk.apps._configs import EventsCompactionConfig\nfrom swegemma.config import EvalConfig, build_submission_limits\nfrom swegemma.evaluate import Evaluator\n\n\ndef run_sync(coro_or_fn, *args, **kwargs):\n    \"\"\"Run an async coroutine synchronously inside a notebook event loop.\"\"\"\n    if callable(coro_or_fn) and not asyncio.iscoroutine(coro_or_fn):\n        fn = lambda: coro_or_fn(*args, **kwargs)\n    else:\n        fn = lambda: coro_or_fn\n    try:\n        loop = asyncio.get_running_loop()\n    except RuntimeError:\n        loop = None\n    if loop is not None and loop.is_running():\n        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:\n            return pool.submit(lambda: asyncio.run(fn())).result()\n    return asyncio.run(fn())\n\n\n# Read optional evaluation settings from the submission's eval_config.yaml / eval_config.yml\neval_config_file = next(\n    (c for name in ('eval_config.yaml', 'eval_config.yml') if (c := AGENT_DIR / name).is_file()),\n    None,\n)\nraw_eval_cfg = (\n    yaml.safe_load(eval_config_file.read_text(encoding='utf-8')) or {}\n    if eval_config_file is not None\n    else {}\n)\neval_section = raw_eval_cfg.get('evaluation', raw_eval_cfg)\n\ntimeout_seconds = int(eval_section.get('timeout_seconds', 300))\nverification_timeout_seconds = int(eval_section.get('verification_timeout_seconds', 300))\nmax_tool_calls = int(eval_section.get('max_tool_calls', 100))\nmax_time_minutes = float(eval_section.get('max_time_minutes', 60.0))\nturns_raw = eval_section.get('max_turns', eval_section.get('max_llm_calls'))\nmax_turns = int(turns_raw) if turns_raw is not None else None\n\n# Select a small subset of tasks from the published dataset\nSAMPLE_TASKS = tasks[:2]\nlimits, gen_constraints = build_submission_limits()\n\n# Configure Evaluator to run Phase 1 (agent patch generation) and Phase 2 (verification)\n# using the subprocess sandbox backend and the submission's eval_config parameters\neval_config = EvalConfig(\n    tasks_path=TASKS_PATH,\n    snapshots_dir=DATA_DIR / 'snapshots',\n    results_dir=WORKING_DIR / 'results',\n    submission_dir=AGENT_DIR,\n    models=models,\n    sandbox='subprocess',\n    timeout_seconds=timeout_seconds,\n    verification_timeout_seconds=verification_timeout_seconds,\n    max_time_minutes=max_time_minutes,\n    max_tool_calls=max_tool_calls,\n    max_turns=max_turns,\n    limits=limits,\n    generation_constraints=gen_constraints,\n    adapter_manifest=adapters,\n    context_cache_config=ContextCacheConfig(min_tokens=2048, ttl_seconds=1800, cache_intervals=10),\n    events_compaction_config=EventsCompactionConfig(\n        compaction_interval=15,\n        overlap_size=2,\n        token_threshold=14336,\n        event_retention_size=5,\n    ),\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    wheels_dir=DATA_DIR / 'wheels',\n    verbose=False,\n)\n\nevaluator = Evaluator(eval_config)\npredictions = []\n\nfor idx, task in enumerate(SAMPLE_TASKS, start=1):\n    print(f'[{idx}/{len(SAMPLE_TASKS)}] Evaluating {task.instance_id} ({task.repo})...')\n    result = run_sync(\n        evaluator.evaluate_task,\n        task=task,\n        task_index=idx,\n        total_tasks=len(SAMPLE_TASKS),\n    )\n    patch = (result.agent_patch or '').strip()\n    predictions.append({'id': task.instance_id, 'prediction': patch if patch else 'NO_PATCH'})\n    print(\n        f'  -> resolved={result.resolved}, '\n        f'exit_code={result.test_exit_code}, '\n        f'patch_chars={len(patch)}, '\n        f'tool_calls={result.tool_calls}, '\n        f'duration={result.duration_seconds:.1f}s'\n    )\n\nsubmission_df = pd.DataFrame(predictions, columns=['id', 'prediction'])\ndisplay(submission_df)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:15:30.766899Z","iopub.execute_input":"2026-10-12T21:15:30.767128Z"}},"outputs":[],"execution_count":null},{"id":"728ab31f","cell_type":"markdown","source":"## 6. Package Submission Archive","metadata":{}},{"id":"d811048f","cell_type":"code","source":"import zipfile\nfrom adk_submission import validate_directory\nfrom swegemma.config import ALLOWED_SUBMISSION_EXTENSIONS, MAX_SUBMISSION_SIZE_BYTES\n\n# Validate unpacked submission directory structure, file types, symlinks, and size limits\nfor dirpath, dirnames, filenames in os.walk(AGENT_DIR, followlinks=False):\n    parent = Path(dirpath)\n    for name in (*dirnames, *filenames):\n        assert not (parent / name).is_symlink(), f'Symlinks are not permitted: {(parent / name).relative_to(AGENT_DIR)}'\nvalidate_directory(AGENT_DIR, limits=limits)\n\n# Create submission.zip with agent.yaml at the root of the archive\nzip_base = WORKING_DIR / 'submission'\nzip_path = Path(shutil.make_archive(str(zip_base), 'zip', root_dir=AGENT_DIR))\n\n# Validate archive contents against competition constraints\nwith zipfile.ZipFile(zip_path, 'r') as zf:\n    infos = zf.infolist()\n    total_size = sum(i.file_size for i in infos)\n    assert total_size <= MAX_SUBMISSION_SIZE_BYTES, f'Archive exceeds 3 GiB limit: {total_size}'\n    for info in infos:\n        if not info.is_dir():\n            ext = Path(info.filename).suffix.lower()\n            assert ext in ALLOWED_SUBMISSION_EXTENSIONS, f'Disallowed file extension: {info.filename}'\n\nprint(f'Created {zip_path} ({zip_path.stat().st_size / (1024 * 1024):.2f} MiB)')","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}
1 {"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat_minor":4,"nbformat":4,"cells":[{"id":"827a919e","cell_type":"markdown","source":"# Getting Started: Gemma 4 Developer Agent","metadata":{}},{"id":"b477808c","cell_type":"markdown","source":"## 1. Environment Configuration and Package Installation","metadata":{}},{"id":"e368fd3b","cell_type":"code","source":"import glob\nimport importlib\nimport logging\nimport os\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\n# Configure environment variables for offline vLLM serving and LiteLLM routing\nos.environ['TRANSFORMERS_NO_TF'] = '1'\nos.environ['TRANSFORMERS_NO_FLAX'] = '1'\nos.environ['TRANSFORMERS_OFFLINE'] = '1'\nos.environ['VLLM_NO_USAGE_STATS'] = '1'\nos.environ['VLLM_WORKER_MULTIPROC_METHOD'] = 'spawn'\nos.environ['VLLM_ENGINE_READY_TIMEOUT_S'] = '1200'\nos.environ['VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS'] = '1'\nos.environ['NCCL_DEBUG'] = 'WARN'\nos.environ['LITELLM_LOCAL_MODEL_COST_MAP'] = 'True'\nos.environ['LITELLM_TELEMETRY'] = 'False'\nos.environ['LITELLM_LOG'] = 'WARNING'\nos.environ['OPENAI_API_KEY'] = os.environ.get('OPENAI_API_KEY', 'EMPTY')\nos.environ['LOCAL_API_KEY'] = os.environ.get('LOCAL_API_KEY', 'EMPTY')\nos.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True'\nos.environ['OTEL_SDK_DISABLED'] = 'true'\nos.environ['OTEL_PYTHON_DISABLED'] = 'true'\n\n\ndef configure_logging() -> None:\n    \"\"\"Silence verbose third-party loggers.\"\"\"\n    for name in (\n        'LiteLLM',\n        'LiteLLM Router',\n        'LiteLLM Proxy',\n        'litellm',\n        'httpx',\n        'httpcore',\n        'openai',\n        'urllib3',\n        'opentelemetry',\n        'opentelemetry.context',\n    ):\n        lg = logging.getLogger(name)\n        lg.setLevel(logging.WARNING)\n        if 'litellm' in name.lower():\n            lg.propagate = False\n            lg.handlers.clear()\n\n\nconfigure_logging()\n\nWHEELHOUSE_DIR = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')\n\n# Remove broken cutlass .pth hooks if present\nfor pth_pattern in (\n    '/usr/local/lib/python*/dist-packages/*cutlass*.pth',\n    '/usr/local/lib/python*/site-packages/*cutlass*.pth',\n):\n    for pth in glob.glob(pth_pattern):\n        try:\n            os.unlink(pth)\n        except OSError:\n            pass\n\n# Restore PEP 440 '+cu128' wheel filenames stripped by Kaggle dataset uploads\ntmp_whl = Path('/tmp/wheelhouse')\ntmp_whl.mkdir(parents=True, exist_ok=True)\nfor w in WHEELHOUSE_DIR.glob('*.whl'):\n    if 'cutlass' in w.name.lower():\n        continue\n    target_name = (\n        w.name.replace('cu128', '+cu128')\n        if ('cu128' in w.name and '+' not in w.name)\n        else w.name\n    )\n    target = tmp_whl / target_name\n    if not target.exists():\n        try:\n            os.symlink(w, target)\n        except OSError:\n            shutil.copyfile(w, target)\n\nwheels = sorted(str(w) for w in tmp_whl.glob('*.whl'))\nprint(f'Installing {len(wheels)} wheels from {WHEELHOUSE_DIR}...')\nsubprocess.run(\n    [sys.executable, '-m', 'pip', 'install', '-q', '--no-deps', '--force-reinstall', *wheels],\n    check=True,\n)\nimportlib.invalidate_caches()\nconfigure_logging()\nprint('Wheelhouse installation complete.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:05:37.865566Z","iopub.execute_input":"2026-10-12T21:05:37.866106Z","iopub.status.idle":"2026-10-12T21:06:29.01204Z","shell.execute_reply.started":"2026-10-12T21:05:37.866079Z","shell.execute_reply":"2026-10-12T21:06:29.011451Z"}},"outputs":[],"execution_count":null},{"id":"ac6108fa","cell_type":"markdown","source":"## 2. Competition Dataset and Sample Submission","metadata":{}},{"id":"63cb4756","cell_type":"code","source":"import re\nfrom swegemma.models import load_tasks\n\nDATA_DIR = Path('/kaggle/input/competitions/gemma-4-developer-agent')\nWORKING_DIR = Path('/kaggle/working')\nWORKING_DIR.mkdir(parents=True, exist_ok=True)\n\n# Official quantized competition models:\n#   - 'gemma-4-31b-it-qat-w4a16-ct' (default in sample_submission)\n#   - 'gemma-4-12b-it-qat-w4a16-ct'\n#   - 'gemma-4-e4b-it-qat-w4a16-ct'\n#   - 'gemma-4-e2b-it-qat-w4a16-ct'\nMODEL_NAME = 'gemma-4-12b-it-qat-w4a16-ct'\n\n# Copy sample_submission to a writable directory for customization and packaging\nSAMPLE_SUBMISSION_SRC = DATA_DIR / 'sample_submission'\nAGENT_DIR = WORKING_DIR / 'sample_submission'\nif AGENT_DIR.exists():\n    shutil.rmtree(AGENT_DIR)\nshutil.copytree(SAMPLE_SUBMISSION_SRC, AGENT_DIR)\n\n# If switching away from 31B, update all agent YAMLs and remove the 31B-shaped sample LoRA adapters\nif MODEL_NAME != 'gemma-4-31b-it-qat-w4a16-ct':\n    for yaml_path in [AGENT_DIR / 'agent.yaml', *sorted((AGENT_DIR / 'sub_agents').glob('*.yaml'))]:\n        if yaml_path.is_file():\n            text = yaml_path.read_text(encoding='utf-8')\n            text = re.sub(r'^(\\s*model:\\s*).*$', rf'\\g<1>{MODEL_NAME}', text, flags=re.MULTILINE)\n            text = re.sub(r'^\\s*adapter:\\s*.*\\n?', '', text, flags=re.MULTILINE)\n            yaml_path.write_text(text, encoding='utf-8')\n    shutil.rmtree(AGENT_DIR / 'adapters', ignore_errors=True)\n\n# Load tasks from the published dataset\nTASKS_PATH = DATA_DIR / 'tasks.jsonl'\ntasks = load_tasks(TASKS_PATH)\n\nprint(f'Data directory: {DATA_DIR}')\nprint(f'Agent directory: {AGENT_DIR} (model={MODEL_NAME})')\nprint(f'Loaded {len(tasks)} tasks from {TASKS_PATH.name}')\nfor t in tasks[:5]:\n    print(f'  - {t.instance_id} ({t.repo} @ {t.base_commit[:8]})')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:06:29.013073Z","iopub.execute_input":"2026-10-12T21:06:29.013348Z","iopub.status.idle":"2026-10-12T21:07:01.669942Z","shell.execute_reply.started":"2026-10-12T21:06:29.013328Z","shell.execute_reply":"2026-10-12T21:07:01.669362Z"}},"outputs":[],"execution_count":null},{"id":"129a9e54","cell_type":"markdown","source":"## 3. Code Graph Functions","metadata":{}},{"id":"9280c4a8","cell_type":"code","source":"from swegemma import graph as sg\n\nsample_task = tasks[0]\nGRAPH_DIR = str(DATA_DIR / 'graphs')\nEMBEDDINGS_DIR = str(DATA_DIR / 'embeddings')\n\n# Load the pre-computed repository code graph and node embeddings for the sample task\nrepo_graph = sg.get_graph(\n    repo_name=sample_task.repo,\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    base_commit=sample_task.base_commit,\n)\nsample_nodes = list(repo_graph.nodes())\nprint(f'Graph for {sample_task.repo} ({sample_task.instance_id}):')\nprint(f'  Nodes: {repo_graph.number_of_nodes()}, Edges: {repo_graph.number_of_edges()}')\n\n# Select a connected symbol and query structural neighbors (callers, callees, definitions)\nquery_node = next((n for n, deg in repo_graph.degree() if deg >= 5), sample_nodes[0])\nneighbors = sg.get_neighbor(\n    node=query_node,\n    graph=repo_graph,\n    max_neighbors=10,\n)\nprint(f'\\nNeighbors of {query_node!r} (showing up to 5):')\nfor n in neighbors[:5]:\n    print(f'  - {n}')\n\n# Search for semantically similar code nodes using pre-computed vector embeddings\nsimilar = sg.get_similar_nodes(\n    node=query_node,\n    repo_name=sample_task.repo,\n    k=5,\n    graph=repo_graph,\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    base_commit=sample_task.base_commit,\n)\nprint(f'\\nTop similar nodes to {query_node!r}:')\nfor item in similar:\n    print(f\"  - {item['node_name']} (similarity={item['similarity']:.4f})\")\n\n# Extract an induced subgraph connecting the query symbol and its neighbors\nfocal_nodes = [query_node, *neighbors[:4]]\nsubgraph = sg.get_induced_subgraph(repo_graph, focal_nodes)\nprint(\n    f'\\nInduced subgraph over {len(focal_nodes)} focal nodes: '\n    f'{subgraph.number_of_nodes()} nodes, {subgraph.number_of_edges()} edges'\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:07:01.670681Z","iopub.execute_input":"2026-10-12T21:07:01.671113Z","iopub.status.idle":"2026-10-12T21:07:03.162442Z","shell.execute_reply.started":"2026-10-12T21:07:01.671086Z","shell.execute_reply":"2026-10-12T21:07:03.161745Z"}},"outputs":[],"execution_count":null},{"id":"86ef881b","cell_type":"markdown","source":"## 4. Start vLLM Server","metadata":{}},{"id":"f0b1ab0d","cell_type":"code","source":"import litellm\nimport torch\nfrom adk_submission import VllmConfig, VllmServer, discover_adapters\nfrom adk_submission.discovery import discover_declared_models\nfrom swegemma.config import ALLOWED_ADAPTER_EXTENSIONS\n\nlitellm.drop_params = True\n\nALLOWED_MODEL_NAMES = frozenset({\n    'gemma-4-31b-it-qat-w4a16-ct',\n    'gemma-4-12b-it-qat-w4a16-ct',\n    'gemma-4-e4b-it-qat-w4a16-ct',\n    'gemma-4-e2b-it-qat-w4a16-ct',\n})\nMODEL_VLLM_EXTRA_ARGS = {\n    'gemma-4-12b-it-qat-w4a16-ct': (\n        '--hf-overrides',\n        '{\"architectures\": [\"Gemma4ForCausalLM\"], \"model_type\": \"gemma4\"}',\n    ),\n}\n_SAFE_PATH_COMPONENT = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')\nINFERENCE_API_KEY = os.environ.get('LOCAL_API_KEY', 'EMPTY')\n\n# Validate single canonical base model and discover any PEFT LoRA adapters in the submission directory.\n# Note: sample_submission includes dummy LoRA adapters (adapters/main_lora and adapters/tool_lora)\n# shaped for gemma-4-31b-it-qat-w4a16-ct; Cell 2 removes them automatically when MODEL_NAME != 31B.\ndeclared_models = discover_declared_models(AGENT_DIR)\nassert len(declared_models) == 1, f'Expected exactly 1 declared model, got: {sorted(declared_models)}'\ndeclared_model = next(iter(declared_models))\nassert declared_model in ALLOWED_MODEL_NAMES, f'Unsupported model {declared_model!r}. Allowed: {sorted(ALLOWED_MODEL_NAMES)}'\n\nMODEL_PATH = Path(f'/kaggle/input/models/google/gemma-4/other/{declared_model}/2')\nassert MODEL_PATH.exists(), f'Model weights not found at {MODEL_PATH}. Ensure the model input is attached.'\n\nadapters = discover_adapters(str(AGENT_DIR), adapter_extensions=ALLOWED_ADAPTER_EXTENSIONS)\nadapter_map = getattr(adapters, 'adapters', None) or {}\nfor adapter_name in adapter_map:\n    assert _SAFE_PATH_COMPONENT.fullmatch(adapter_name), (\n        f'Unsafe adapter name {adapter_name!r}: must match [A-Za-z0-9][A-Za-z0-9._-]*'\n    )\ndetected_ranks = [\n    r for info in adapter_map.values() if (r := getattr(info, 'rank', None)) is not None and r > 0\n]\n\ngpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1\ntp_size = 4 if gpu_count >= 4 else (2 if gpu_count >= 2 else 1)\n\nif 'server_instance' in globals() and server_instance is not None:\n    server_instance.stop()\n\nvllm_cfg = VllmConfig(\n    model=str(MODEL_PATH),\n    port=8000,\n    host='127.0.0.1',\n    tool_call_parser='gemma4',\n    reasoning_parser='gemma4',\n    max_model_len=32768,\n    dtype='bfloat16' if (torch.cuda.is_available() and torch.cuda.is_bf16_supported()) else 'auto',\n    gpu_memory_utilization=0.90,\n    enable_auto_tool_choice=True,\n    enable_lora=bool(adapter_map),\n    max_loras=max(1, len(adapter_map)),\n    max_lora_rank=max(detected_ranks) if detected_ranks else 128,\n    scheduler_reserve_full_isl=False,\n    tensor_parallel_size=tp_size,\n    startup_timeout=60 * 20,\n    extra_args=MODEL_VLLM_EXTRA_ARGS.get(declared_model, ()),\n)\nserver_instance = VllmServer(vllm_cfg, adapter_manifest=adapters)\nserver_instance.start()\nprint(f'vLLM server started on {server_instance.base_url} (tp={tp_size})')\n\n# Register model and LoRA adapter aliases for Google ADK\nmodels = server_instance.create_model_registry(\n    aliases=[declared_model],\n    model_prefix='openai/',\n    api_key=INFERENCE_API_KEY,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:11:28.843785Z","iopub.execute_input":"2026-10-12T21:11:28.844384Z","iopub.status.idle":"2026-10-12T21:15:30.765782Z","shell.execute_reply.started":"2026-10-12T21:11:28.844352Z","shell.execute_reply":"2026-10-12T21:15:30.765199Z"}},"outputs":[],"execution_count":null},{"id":"a0434776","cell_type":"markdown","source":"## 5. Run Phase 1 Inference and Phase 2 Verification","metadata":{}},{"id":"105c5b68","cell_type":"code","source":"import asyncio\nimport concurrent.futures\nimport pandas as pd\nimport yaml\nfrom google.adk.agents.context_cache_config import ContextCacheConfig\nfrom google.adk.apps._configs import EventsCompactionConfig\nfrom swegemma.config import EvalConfig, build_submission_limits\nfrom swegemma.evaluate import Evaluator\n\n\ndef run_sync(coro_or_fn, *args, **kwargs):\n    \"\"\"Run an async coroutine synchronously inside a notebook event loop.\"\"\"\n    if callable(coro_or_fn) and not asyncio.iscoroutine(coro_or_fn):\n        fn = lambda: coro_or_fn(*args, **kwargs)\n    else:\n        fn = lambda: coro_or_fn\n    try:\n        loop = asyncio.get_running_loop()\n    except RuntimeError:\n        loop = None\n    if loop is not None and loop.is_running():\n        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:\n            return pool.submit(lambda: asyncio.run(fn())).result()\n    return asyncio.run(fn())\n\n\n# Read optional evaluation settings from the submission's eval_config.yaml / eval_config.yml\neval_config_file = next(\n    (c for name in ('eval_config.yaml', 'eval_config.yml') if (c := AGENT_DIR / name).is_file()),\n    None,\n)\nraw_eval_cfg = (\n    yaml.safe_load(eval_config_file.read_text(encoding='utf-8')) or {}\n    if eval_config_file is not None\n    else {}\n)\neval_section = raw_eval_cfg.get('evaluation', raw_eval_cfg)\n\ntimeout_seconds = int(eval_section.get('timeout_seconds', 300))\nverification_timeout_seconds = int(eval_section.get('verification_timeout_seconds', 300))\nmax_tool_calls = int(eval_section.get('max_tool_calls', 100))\nmax_time_minutes = float(eval_section.get('max_time_minutes', 60.0))\nturns_raw = eval_section.get('max_turns', eval_section.get('max_llm_calls'))\nmax_turns = int(turns_raw) if turns_raw is not None else None\n\n# Select a small subset of tasks from the published dataset\nSAMPLE_TASKS = tasks[:2]\nlimits, gen_constraints = build_submission_limits()\n\n# Configure Evaluator to run Phase 1 (agent patch generation) and Phase 2 (verification)\n# using the subprocess sandbox backend and the submission's eval_config parameters\neval_config = EvalConfig(\n    tasks_path=TASKS_PATH,\n    snapshots_dir=DATA_DIR / 'snapshots',\n    results_dir=WORKING_DIR / 'results',\n    submission_dir=AGENT_DIR,\n    models=models,\n    sandbox='subprocess',\n    timeout_seconds=timeout_seconds,\n    verification_timeout_seconds=verification_timeout_seconds,\n    max_time_minutes=max_time_minutes,\n    max_tool_calls=max_tool_calls,\n    max_turns=max_turns,\n    limits=limits,\n    generation_constraints=gen_constraints,\n    adapter_manifest=adapters,\n    context_cache_config=ContextCacheConfig(min_tokens=2048, ttl_seconds=1800, cache_intervals=10),\n    events_compaction_config=EventsCompactionConfig(\n        compaction_interval=15,\n        overlap_size=2,\n        token_threshold=14336,\n        event_retention_size=5,\n    ),\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    wheels_dir=DATA_DIR / 'wheels',\n    verbose=False,\n)\n\nevaluator = Evaluator(eval_config)\npredictions = []\n\nfor idx, task in enumerate(SAMPLE_TASKS, start=1):\n    print(f'[{idx}/{len(SAMPLE_TASKS)}] Evaluating {task.instance_id} ({task.repo})...')\n    result = run_sync(\n        evaluator.evaluate_task,\n        task=task,\n        task_index=idx,\n        total_tasks=len(SAMPLE_TASKS),\n    )\n    patch = (result.agent_patch or '').strip()\n    predictions.append({'id': task.instance_id, 'prediction': patch if patch else 'NO_PATCH'})\n    print(\n        f'  -> resolved={result.resolved}, '\n        f'exit_code={result.test_exit_code}, '\n        f'patch_chars={len(patch)}, '\n        f'tool_calls={result.tool_calls}, '\n        f'duration={result.duration_seconds:.1f}s'\n    )\n\nsubmission_df = pd.DataFrame(predictions, columns=['id', 'prediction'])\ndisplay(submission_df)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:15:30.766899Z","iopub.execute_input":"2026-10-12T21:15:30.767128Z"}},"outputs":[],"execution_count":null},{"id":"728ab31f","cell_type":"markdown","source":"## 6. Package Submission Archive","metadata":{}},{"id":"d811048f","cell_type":"code","source":"import zipfile\nfrom adk_submission import validate_directory\nfrom swegemma.config import ALLOWED_SUBMISSION_EXTENSIONS, MAX_SUBMISSION_SIZE_BYTES\n\n# Validate unpacked submission directory structure, file types, symlinks, and size limits\nfor dirpath, dirnames, filenames in os.walk(AGENT_DIR, followlinks=False):\n    parent = Path(dirpath)\n    for name in (*dirnames, *filenames):\n        assert not (parent / name).is_symlink(), f'Symlinks are not permitted: {(parent / name).relative_to(AGENT_DIR)}'\nvalidate_directory(AGENT_DIR, limits=limits)\n\n# Create submission.zip with agent.yaml at the root of the archive\nzip_base = WORKING_DIR / 'submission'\nzip_path = Path(shutil.make_archive(str(zip_base), 'zip', root_dir=AGENT_DIR))\n\n# Validate archive contents against competition constraints\nwith zipfile.ZipFile(zip_path, 'r') as zf:\n    infos = zf.infolist()\n    total_size = sum(i.file_size for i in infos)\n    assert total_size <= MAX_SUBMISSION_SIZE_BYTES, f'Archive exceeds 3 GiB limit: {total_size}'\n    for info in infos:\n        if not info.is_dir():\n            ext = Path(info.filename).suffix.lower()\n            assert ext in ALLOWED_SUBMISSION_EXTENSIONS, f'Disallowed file extension: {info.filename}'\n\nprint(f'Created {zip_path} ({zip_path.stat().st_size / (1024 * 1024):.2f} MiB)')","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}
1 {"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat_minor":4,"nbformat":4,"cells":[{"id":"827a919e","cell_type":"markdown","source":"# Getting Started: Gemma 4 Developer Agent","metadata":{}},{"id":"b477808c","cell_type":"markdown","source":"## 1. Environment Configuration and Package Installation","metadata":{}},{"id":"e368fd3b","cell_type":"code","source":"import glob\nimport importlib\nimport logging\nimport os\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\n# Configure environment variables for offline vLLM serving and LiteLLM routing\nos.environ['TRANSFORMERS_NO_TF'] = '1'\nos.environ['TRANSFORMERS_NO_FLAX'] = '1'\nos.environ['TRANSFORMERS_OFFLINE'] = '1'\nos.environ['VLLM_NO_USAGE_STATS'] = '1'\nos.environ['VLLM_WORKER_MULTIPROC_METHOD'] = 'spawn'\nos.environ['VLLM_ENGINE_READY_TIMEOUT_S'] = '1200'\nos.environ['VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS'] = '1'\nos.environ['NCCL_DEBUG'] = 'WARN'\nos.environ['LITELLM_LOCAL_MODEL_COST_MAP'] = 'True'\nos.environ['LITELLM_TELEMETRY'] = 'False'\nos.environ['LITELLM_LOG'] = 'WARNING'\nos.environ['OPENAI_API_KEY'] = os.environ.get('OPENAI_API_KEY', 'EMPTY')\nos.environ['LOCAL_API_KEY'] = os.environ.get('LOCAL_API_KEY', 'EMPTY')\nos.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True'\nos.environ['OTEL_SDK_DISABLED'] = 'true'\nos.environ['OTEL_PYTHON_DISABLED'] = 'true'\n\n\ndef configure_logging() -> None:\n    \"\"\"Silence verbose third-party loggers.\"\"\"\n    for name in (\n        'LiteLLM',\n        'LiteLLM Router',\n        'LiteLLM Proxy',\n        'litellm',\n        'httpx',\n        'httpcore',\n        'openai',\n        'urllib3',\n        'opentelemetry',\n        'opentelemetry.context',\n    ):\n        lg = logging.getLogger(name)\n        lg.setLevel(logging.WARNING)\n        if 'litellm' in name.lower():\n            lg.propagate = False\n            lg.handlers.clear()\n\n\nconfigure_logging()\n\nWHEELHOUSE_DIR = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')\n\n# Remove broken cutlass .pth hooks if present\nfor pth_pattern in (\n    '/usr/local/lib/python*/dist-packages/*cutlass*.pth',\n    '/usr/local/lib/python*/site-packages/*cutlass*.pth',\n):\n    for pth in glob.glob(pth_pattern):\n        try:\n            os.unlink(pth)\n        except OSError:\n            pass\n\n# Restore PEP 440 '+cu128' wheel filenames stripped by Kaggle dataset uploads\ntmp_whl = Path('/tmp/wheelhouse')\ntmp_whl.mkdir(parents=True, exist_ok=True)\nfor w in WHEELHOUSE_DIR.glob('*.whl'):\n    if 'cutlass' in w.name.lower():\n        continue\n    target_name = (\n        w.name.replace('cu128', '+cu128')\n        if ('cu128' in w.name and '+' not in w.name)\n        else w.name\n    )\n    target = tmp_whl / target_name\n    if not target.exists():\n        try:\n            os.symlink(w, target)\n        except OSError:\n            shutil.copyfile(w, target)\n\nwheels = sorted(str(w) for w in tmp_whl.glob('*.whl'))\nprint(f'Installing {len(wheels)} wheels from {WHEELHOUSE_DIR}...')\nsubprocess.run(\n    [sys.executable, '-m', 'pip', 'install', '-q', '--no-deps', '--force-reinstall', *wheels],\n    check=True,\n)\nimportlib.invalidate_caches()\nconfigure_logging()\nprint('Wheelhouse installation complete.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:05:37.865566Z","iopub.execute_input":"2026-10-12T21:05:37.866106Z","iopub.status.idle":"2026-10-12T21:06:29.01204Z","shell.execute_reply.started":"2026-10-12T21:05:37.866079Z","shell.execute_reply":"2026-10-12T21:06:29.011451Z"}},"outputs":[],"execution_count":null},{"id":"ac6108fa","cell_type":"markdown","source":"## 2. Competition Dataset and Sample Submission","metadata":{}},{"id":"63cb4756","cell_type":"code","source":"import re\nfrom swegemma.models import load_tasks\n\nDATA_DIR = Path('/kaggle/input/competitions/gemma-4-developer-agent')\nWORKING_DIR = Path('/kaggle/working')\nWORKING_DIR.mkdir(parents=True, exist_ok=True)\n\n# Official quantized competition models:\n#   - 'gemma-4-31b-it-qat-w4a16-ct' (default in sample_submission)\n#   - 'gemma-4-12b-it-qat-w4a16-ct'\n#   - 'gemma-4-e4b-it-qat-w4a16-ct'\n#   - 'gemma-4-e2b-it-qat-w4a16-ct'\nMODEL_NAME = 'gemma-4-12b-it-qat-w4a16-ct'\n\n# Copy sample_submission to a writable directory for customization and packaging\nSAMPLE_SUBMISSION_SRC = DATA_DIR / 'sample_submission'\nAGENT_DIR = WORKING_DIR / 'sample_submission'\nif AGENT_DIR.exists():\n    shutil.rmtree(AGENT_DIR)\nshutil.copytree(SAMPLE_SUBMISSION_SRC, AGENT_DIR)\n\n# If switching away from 31B, update all agent YAMLs and remove the 31B-shaped sample LoRA adapters\nif MODEL_NAME != 'gemma-4-31b-it-qat-w4a16-ct':\n    for yaml_path in [AGENT_DIR / 'agent.yaml', *sorted((AGENT_DIR / 'sub_agents').glob('*.yaml'))]:\n        if yaml_path.is_file():\n            text = yaml_path.read_text(encoding='utf-8')\n            text = re.sub(r'^(\\s*model:\\s*).*$', rf'\\g<1>{MODEL_NAME}', text, flags=re.MULTILINE)\n            text = re.sub(r'^\\s*adapter:\\s*.*\\n?', '', text, flags=re.MULTILINE)\n            yaml_path.write_text(text, encoding='utf-8')\n    shutil.rmtree(AGENT_DIR / 'adapters', ignore_errors=True)\n\n# Load tasks from the published dataset\nTASKS_PATH = DATA_DIR / 'tasks.jsonl'\ntasks = load_tasks(TASKS_PATH)\n\nprint(f'Data directory: {DATA_DIR}')\nprint(f'Agent directory: {AGENT_DIR} (model={MODEL_NAME})')\nprint(f'Loaded {len(tasks)} tasks from {TASKS_PATH.name}')\nfor t in tasks[:5]:\n    print(f'  - {t.instance_id} ({t.repo} @ {t.base_commit[:8]})')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:06:29.013073Z","iopub.execute_input":"2026-10-12T21:06:29.013348Z","iopub.status.idle":"2026-10-12T21:07:01.669942Z","shell.execute_reply.started":"2026-10-12T21:06:29.013328Z","shell.execute_reply":"2026-10-12T21:07:01.669362Z"}},"outputs":[],"execution_count":null},{"id":"129a9e54","cell_type":"markdown","source":"## 3. Code Graph Functions","metadata":{}},{"id":"9280c4a8","cell_type":"code","source":"from swegemma import graph as sg\n\nsample_task = tasks[0]\nGRAPH_DIR = str(DATA_DIR / 'graphs')\nEMBEDDINGS_DIR = str(DATA_DIR / 'embeddings')\n\n# Load the pre-computed repository code graph and node embeddings for the sample task\nrepo_graph = sg.get_graph(\n    repo_name=sample_task.repo,\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    base_commit=sample_task.base_commit,\n)\nsample_nodes = list(repo_graph.nodes())\nprint(f'Graph for {sample_task.repo} ({sample_task.instance_id}):')\nprint(f'  Nodes: {repo_graph.number_of_nodes()}, Edges: {repo_graph.number_of_edges()}')\n\n# Select a connected symbol and query structural neighbors (callers, callees, definitions)\nquery_node = next((n for n, deg in repo_graph.degree() if deg >= 5), sample_nodes[0])\nneighbors = sg.get_neighbor(\n    node=query_node,\n    graph=repo_graph,\n    max_neighbors=10,\n)\nprint(f'\\nNeighbors of {query_node!r} (showing up to 5):')\nfor n in neighbors[:5]:\n    print(f'  - {n}')\n\n# Search for semantically similar code nodes using pre-computed vector embeddings\nsimilar = sg.get_similar_nodes(\n    node=query_node,\n    repo_name=sample_task.repo,\n    k=5,\n    graph=repo_graph,\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    base_commit=sample_task.base_commit,\n)\nprint(f'\\nTop similar nodes to {query_node!r}:')\nfor item in similar:\n    print(f\"  - {item['node_name']} (similarity={item['similarity']:.4f})\")\n\n# Extract an induced subgraph connecting the query symbol and its neighbors\nfocal_nodes = [query_node, *neighbors[:4]]\nsubgraph = sg.get_induced_subgraph(repo_graph, focal_nodes)\nprint(\n    f'\\nInduced subgraph over {len(focal_nodes)} focal nodes: '\n    f'{subgraph.number_of_nodes()} nodes, {subgraph.number_of_edges()} edges'\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:07:01.670681Z","iopub.execute_input":"2026-10-12T21:07:01.671113Z","iopub.status.idle":"2026-10-12T21:07:03.162442Z","shell.execute_reply.started":"2026-10-12T21:07:01.671086Z","shell.execute_reply":"2026-10-12T21:07:03.161745Z"}},"outputs":[],"execution_count":null},{"id":"86ef881b","cell_type":"markdown","source":"## 4. Start vLLM Server","metadata":{}},{"id":"f0b1ab0d","cell_type":"code","source":"import litellm\nimport torch\nfrom adk_submission import VllmConfig, VllmServer, discover_adapters\nfrom adk_submission.discovery import discover_declared_models\nfrom swegemma.config import ALLOWED_ADAPTER_EXTENSIONS\n\nlitellm.drop_params = True\n\nALLOWED_MODEL_NAMES = frozenset({\n    'gemma-4-31b-it-qat-w4a16-ct',\n    'gemma-4-12b-it-qat-w4a16-ct',\n    'gemma-4-e4b-it-qat-w4a16-ct',\n    'gemma-4-e2b-it-qat-w4a16-ct',\n})\nMODEL_VLLM_EXTRA_ARGS = {\n    'gemma-4-12b-it-qat-w4a16-ct': (\n        '--hf-overrides',\n        '{\"architectures\": [\"Gemma4ForCausalLM\"], \"model_type\": \"gemma4\"}',\n    ),\n}\n_SAFE_PATH_COMPONENT = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')\nINFERENCE_API_KEY = os.environ.get('LOCAL_API_KEY', 'EMPTY')\n\n# Validate single canonical base model and discover any PEFT LoRA adapters in the submission directory.\n# Note: sample_submission includes dummy LoRA adapters (adapters/main_lora and adapters/tool_lora)\n# shaped for gemma-4-31b-it-qat-w4a16-ct; Cell 2 removes them automatically when MODEL_NAME != 31B.\ndeclared_models = discover_declared_models(AGENT_DIR)\nassert len(declared_models) == 1, f'Expected exactly 1 declared model, got: {sorted(declared_models)}'\ndeclared_model = next(iter(declared_models))\nassert declared_model in ALLOWED_MODEL_NAMES, f'Unsupported model {declared_model!r}. Allowed: {sorted(ALLOWED_MODEL_NAMES)}'\n\nMODEL_PATH = Path(f'/kaggle/input/models/google/gemma-4/other/{declared_model}/2')\nassert MODEL_PATH.exists(), f'Model weights not found at {MODEL_PATH}. Ensure the model input is attached.'\n\nadapters = discover_adapters(str(AGENT_DIR), adapter_extensions=ALLOWED_ADAPTER_EXTENSIONS)\nadapter_map = getattr(adapters, 'adapters', None) or {}\nfor adapter_name in adapter_map:\n    assert _SAFE_PATH_COMPONENT.fullmatch(adapter_name), (\n        f'Unsafe adapter name {adapter_name!r}: must match [A-Za-z0-9][A-Za-z0-9._-]*'\n    )\ndetected_ranks = [\n    r for info in adapter_map.values() if (r := getattr(info, 'rank', None)) is not None and r > 0\n]\n\ngpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1\ntp_size = 4 if gpu_count >= 4 else (2 if gpu_count >= 2 else 1)\n\nif 'server_instance' in globals() and server_instance is not None:\n    server_instance.stop()\n\nvllm_cfg = VllmConfig(\n    model=str(MODEL_PATH),\n    port=8000,\n    host='127.0.0.1',\n    tool_call_parser='gemma4',\n    reasoning_parser='gemma4',\n    max_model_len=32768,\n    dtype='bfloat16' if (torch.cuda.is_available() and torch.cuda.is_bf16_supported()) else 'auto',\n    gpu_memory_utilization=0.90,\n    enable_auto_tool_choice=True,\n    enable_lora=bool(adapter_map),\n    max_loras=max(1, len(adapter_map)),\n    max_lora_rank=max(detected_ranks) if detected_ranks else 128,\n    scheduler_reserve_full_isl=False,\n    tensor_parallel_size=tp_size,\n    startup_timeout=60 * 20,\n    extra_args=MODEL_VLLM_EXTRA_ARGS.get(declared_model, ()),\n)\nserver_instance = VllmServer(vllm_cfg, adapter_manifest=adapters)\nserver_instance.start()\nprint(f'vLLM server started on {server_instance.base_url} (tp={tp_size})')\n\n# Register model and LoRA adapter aliases for Google ADK\nmodels = server_instance.create_model_registry(\n    aliases=[declared_model],\n    model_prefix='openai/',\n    api_key=INFERENCE_API_KEY,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:11:28.843785Z","iopub.execute_input":"2026-10-12T21:11:28.844384Z","iopub.status.idle":"2026-10-12T21:15:30.765782Z","shell.execute_reply.started":"2026-10-12T21:11:28.844352Z","shell.execute_reply":"2026-10-12T21:15:30.765199Z"}},"outputs":[],"execution_count":null},{"id":"a0434776","cell_type":"markdown","source":"## 5. Run Phase 1 Inference and Phase 2 Verification","metadata":{}},{"id":"105c5b68","cell_type":"code","source":"import asyncio\nimport concurrent.futures\nimport pandas as pd\nimport yaml\nfrom google.adk.agents.context_cache_config import ContextCacheConfig\nfrom google.adk.apps._configs import EventsCompactionConfig\nfrom swegemma.config import EvalConfig, build_submission_limits\nfrom swegemma.evaluate import Evaluator\n\n\ndef run_sync(coro_or_fn, *args, **kwargs):\n    \"\"\"Run an async coroutine synchronously inside a notebook event loop.\"\"\"\n    if callable(coro_or_fn) and not asyncio.iscoroutine(coro_or_fn):\n        fn = lambda: coro_or_fn(*args, **kwargs)\n    else:\n        fn = lambda: coro_or_fn\n    try:\n        loop = asyncio.get_running_loop()\n    except RuntimeError:\n        loop = None\n    if loop is not None and loop.is_running():\n        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:\n            return pool.submit(lambda: asyncio.run(fn())).result()\n    return asyncio.run(fn())\n\n\n# Read optional evaluation settings from the submission's eval_config.yaml / eval_config.yml\neval_config_file = next(\n    (c for name in ('eval_config.yaml', 'eval_config.yml') if (c := AGENT_DIR / name).is_file()),\n    None,\n)\nraw_eval_cfg = (\n    yaml.safe_load(eval_config_file.read_text(encoding='utf-8')) or {}\n    if eval_config_file is not None\n    else {}\n)\neval_section = raw_eval_cfg.get('evaluation', raw_eval_cfg)\n\ntimeout_seconds = int(eval_section.get('timeout_seconds', 300))\nverification_timeout_seconds = int(eval_section.get('verification_timeout_seconds', 300))\nmax_tool_calls = int(eval_section.get('max_tool_calls', 100))\nmax_time_minutes = float(eval_section.get('max_time_minutes', 60.0))\nturns_raw = eval_section.get('max_turns', eval_section.get('max_llm_calls'))\nmax_turns = int(turns_raw) if turns_raw is not None else None\n\n# Select a small subset of tasks from the published dataset\nSAMPLE_TASKS = tasks[:2]\nlimits, gen_constraints = build_submission_limits()\n\n# Configure Evaluator to run Phase 1 (agent patch generation) and Phase 2 (verification)\n# using the subprocess sandbox backend and the submission's eval_config parameters\neval_config = EvalConfig(\n    tasks_path=TASKS_PATH,\n    snapshots_dir=DATA_DIR / 'snapshots',\n    results_dir=WORKING_DIR / 'results',\n    submission_dir=AGENT_DIR,\n    models=models,\n    sandbox='subprocess',\n    timeout_seconds=timeout_seconds,\n    verification_timeout_seconds=verification_timeout_seconds,\n    max_time_minutes=max_time_minutes,\n    max_tool_calls=max_tool_calls,\n    max_turns=max_turns,\n    limits=limits,\n    generation_constraints=gen_constraints,\n    adapter_manifest=adapters,\n    context_cache_config=ContextCacheConfig(min_tokens=2048, ttl_seconds=1800, cache_intervals=10),\n    events_compaction_config=EventsCompactionConfig(\n        compaction_interval=15,\n        overlap_size=2,\n        token_threshold=14336,\n        event_retention_size=5,\n    ),\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    wheels_dir=DATA_DIR / 'wheels',\n    verbose=False,\n)\n\nevaluator = Evaluator(eval_config)\npredictions = []\n\nfor idx, task in enumerate(SAMPLE_TASKS, start=1):\n    print(f'[{idx}/{len(SAMPLE_TASKS)}] Evaluating {task.instance_id} ({task.repo})...')\n    result = run_sync(\n        evaluator.evaluate_task,\n        task=task,\n        task_index=idx,\n        total_tasks=len(SAMPLE_TASKS),\n    )\n    patch = (result.agent_patch or '').strip()\n    predictions.append({'id': task.instance_id, 'prediction': patch if patch else 'NO_PATCH'})\n    print(\n        f'  -> resolved={result.resolved}, '\n        f'exit_code={result.test_exit_code}, '\n        f'patch_chars={len(patch)}, '\n        f'tool_calls={result.tool_calls}, '\n        f'duration={result.duration_seconds:.1f}s'\n    )\n\nsubmission_df = pd.DataFrame(predictions, columns=['id', 'prediction'])\ndisplay(submission_df)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:15:30.766899Z","iopub.execute_input":"2026-10-12T21:15:30.767128Z"}},"outputs":[],"execution_count":null},{"id":"728ab31f","cell_type":"markdown","source":"## 6. Package Submission Archive","metadata":{}},{"id":"d811048f","cell_type":"code","source":"import zipfile\nfrom adk_submission import validate_directory\nfrom swegemma.config import ALLOWED_SUBMISSION_EXTENSIONS, MAX_SUBMISSION_SIZE_BYTES\n\n# Validate unpacked submission directory structure, file types, symlinks, and size limits\nfor dirpath, dirnames, filenames in os.walk(AGENT_DIR, followlinks=False):\n    parent = Path(dirpath)\n    for name in (*dirnames, *filenames):\n        assert not (parent / name).is_symlink(), f'Symlinks are not permitted: {(parent / name).relative_to(AGENT_DIR)}'\nvalidate_directory(AGENT_DIR, limits=limits)\n\n# Create submission.zip with agent.yaml at the root of the archive\nzip_base = WORKING_DIR / 'submission'\nzip_path = Path(shutil.make_archive(str(zip_base), 'zip', root_dir=AGENT_DIR))\n\n# Validate archive contents against competition constraints\nwith zipfile.ZipFile(zip_path, 'r') as zf:\n    infos = zf.infolist()\n    total_size = sum(i.file_size for i in infos)\n    assert total_size <= MAX_SUBMISSION_SIZE_BYTES, f'Archive exceeds 3 GiB limit: {total_size}'\n    for info in infos:\n        if not info.is_dir():\n            ext = Path(info.filename).suffix.lower()\n            assert ext in ALLOWED_SUBMISSION_EXTENSIONS, f'Disallowed file extension: {info.filename}'\n\nprint(f'Created {zip_path} ({zip_path.stat().st_size / (1024 * 1024):.2f} MiB)')","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}
1 {"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"}},"nbformat_minor":4,"nbformat":4,"cells":[{"id":"827a919e","cell_type":"markdown","source":"# Getting Started: Gemma 4 Developer Agent","metadata":{}},{"id":"b477808c","cell_type":"markdown","source":"## 1. Environment Configuration and Package Installation","metadata":{}},{"id":"e368fd3b","cell_type":"code","source":"import glob\nimport importlib\nimport logging\nimport os\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\n# Configure environment variables for offline vLLM serving and LiteLLM routing\nos.environ['TRANSFORMERS_NO_TF'] = '1'\nos.environ['TRANSFORMERS_NO_FLAX'] = '1'\nos.environ['TRANSFORMERS_OFFLINE'] = '1'\nos.environ['VLLM_NO_USAGE_STATS'] = '1'\nos.environ['VLLM_WORKER_MULTIPROC_METHOD'] = 'spawn'\nos.environ['VLLM_ENGINE_READY_TIMEOUT_S'] = '1200'\nos.environ['VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS'] = '1'\nos.environ['NCCL_DEBUG'] = 'WARN'\nos.environ['LITELLM_LOCAL_MODEL_COST_MAP'] = 'True'\nos.environ['LITELLM_TELEMETRY'] = 'False'\nos.environ['LITELLM_LOG'] = 'WARNING'\nos.environ['OPENAI_API_KEY'] = os.environ.get('OPENAI_API_KEY', 'EMPTY')\nos.environ['LOCAL_API_KEY'] = os.environ.get('LOCAL_API_KEY', 'EMPTY')\nos.environ['PYTORCH_CUDA_ALLOC_CONF'] = 'expandable_segments:True'\nos.environ['OTEL_SDK_DISABLED'] = 'true'\nos.environ['OTEL_PYTHON_DISABLED'] = 'true'\n\n\ndef configure_logging() -> None:\n    \"\"\"Silence verbose third-party loggers.\"\"\"\n    for name in (\n        'LiteLLM',\n        'LiteLLM Router',\n        'LiteLLM Proxy',\n        'litellm',\n        'httpx',\n        'httpcore',\n        'openai',\n        'urllib3',\n        'opentelemetry',\n        'opentelemetry.context',\n    ):\n        lg = logging.getLogger(name)\n        lg.setLevel(logging.WARNING)\n        if 'litellm' in name.lower():\n            lg.propagate = False\n            lg.handlers.clear()\n\n\nconfigure_logging()\n\nWHEELHOUSE_DIR = Path('/kaggle/input/datasets/metric/gemma-4-developer-agent-wheelhouse')\n\n# Remove broken cutlass .pth hooks if present\nfor pth_pattern in (\n    '/usr/local/lib/python*/dist-packages/*cutlass*.pth',\n    '/usr/local/lib/python*/site-packages/*cutlass*.pth',\n):\n    for pth in glob.glob(pth_pattern):\n        try:\n            os.unlink(pth)\n        except OSError:\n            pass\n\n# Restore PEP 440 '+cu128' wheel filenames stripped by Kaggle dataset uploads\ntmp_whl = Path('/tmp/wheelhouse')\ntmp_whl.mkdir(parents=True, exist_ok=True)\nfor w in WHEELHOUSE_DIR.glob('*.whl'):\n    if 'cutlass' in w.name.lower():\n        continue\n    target_name = (\n        w.name.replace('cu128', '+cu128')\n        if ('cu128' in w.name and '+' not in w.name)\n        else w.name\n    )\n    target = tmp_whl / target_name\n    if not target.exists():\n        try:\n            os.symlink(w, target)\n        except OSError:\n            shutil.copyfile(w, target)\n\nwheels = sorted(str(w) for w in tmp_whl.glob('*.whl'))\nprint(f'Installing {len(wheels)} wheels from {WHEELHOUSE_DIR}...')\nsubprocess.run(\n    [sys.executable, '-m', 'pip', 'install', '-q', '--no-deps', '--force-reinstall', *wheels],\n    check=True,\n)\nimportlib.invalidate_caches()\nconfigure_logging()\nprint('Wheelhouse installation complete.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:05:37.865566Z","iopub.execute_input":"2026-10-12T21:05:37.866106Z","iopub.status.idle":"2026-10-12T21:06:29.01204Z","shell.execute_reply.started":"2026-10-12T21:05:37.866079Z","shell.execute_reply":"2026-10-12T21:06:29.011451Z"}},"outputs":[],"execution_count":null},{"id":"ac6108fa","cell_type":"markdown","source":"## 2. Competition Dataset and Sample Submission","metadata":{}},{"id":"63cb4756","cell_type":"code","source":"import re\nfrom swegemma.models import load_tasks\n\nDATA_DIR = Path('/kaggle/input/competitions/gemma-4-developer-agent')\nWORKING_DIR = Path('/kaggle/working')\nWORKING_DIR.mkdir(parents=True, exist_ok=True)\n\n# Official quantized competition models:\n#   - 'gemma-4-31b-it-qat-w4a16-ct' (default in sample_submission)\n#   - 'gemma-4-12b-it-qat-w4a16-ct'\n#   - 'gemma-4-e4b-it-qat-w4a16-ct'\n#   - 'gemma-4-e2b-it-qat-w4a16-ct'\nMODEL_NAME = 'gemma-4-12b-it-qat-w4a16-ct'\n\n# Copy sample_submission to a writable directory for customization and packaging\nSAMPLE_SUBMISSION_SRC = DATA_DIR / 'sample_submission'\nAGENT_DIR = WORKING_DIR / 'sample_submission'\nif AGENT_DIR.exists():\n    shutil.rmtree(AGENT_DIR)\nshutil.copytree(SAMPLE_SUBMISSION_SRC, AGENT_DIR)\n\n# If switching away from 31B, update all agent YAMLs and remove the 31B-shaped sample LoRA adapters\nif MODEL_NAME != 'gemma-4-31b-it-qat-w4a16-ct':\n    for yaml_path in [AGENT_DIR / 'agent.yaml', *sorted((AGENT_DIR / 'sub_agents').glob('*.yaml'))]:\n        if yaml_path.is_file():\n            text = yaml_path.read_text(encoding='utf-8')\n            text = re.sub(r'^(\\s*model:\\s*).*$', rf'\\g<1>{MODEL_NAME}', text, flags=re.MULTILINE)\n            text = re.sub(r'^\\s*adapter:\\s*.*\\n?', '', text, flags=re.MULTILINE)\n            yaml_path.write_text(text, encoding='utf-8')\n    shutil.rmtree(AGENT_DIR / 'adapters', ignore_errors=True)\n\n# Load tasks from the published dataset\nTASKS_PATH = DATA_DIR / 'tasks.jsonl'\ntasks = load_tasks(TASKS_PATH)\n\nprint(f'Data directory: {DATA_DIR}')\nprint(f'Agent directory: {AGENT_DIR} (model={MODEL_NAME})')\nprint(f'Loaded {len(tasks)} tasks from {TASKS_PATH.name}')\nfor t in tasks[:5]:\n    print(f'  - {t.instance_id} ({t.repo} @ {t.base_commit[:8]})')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:06:29.013073Z","iopub.execute_input":"2026-10-12T21:06:29.013348Z","iopub.status.idle":"2026-10-12T21:07:01.669942Z","shell.execute_reply.started":"2026-10-12T21:06:29.013328Z","shell.execute_reply":"2026-10-12T21:07:01.669362Z"}},"outputs":[],"execution_count":null},{"id":"129a9e54","cell_type":"markdown","source":"## 3. Code Graph Functions","metadata":{}},{"id":"9280c4a8","cell_type":"code","source":"from swegemma import graph as sg\n\nsample_task = tasks[0]\nGRAPH_DIR = str(DATA_DIR / 'graphs')\nEMBEDDINGS_DIR = str(DATA_DIR / 'embeddings')\n\n# Load the pre-computed repository code graph and node embeddings for the sample task\nrepo_graph = sg.get_graph(\n    repo_name=sample_task.repo,\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    base_commit=sample_task.base_commit,\n)\nsample_nodes = list(repo_graph.nodes())\nprint(f'Graph for {sample_task.repo} ({sample_task.instance_id}):')\nprint(f'  Nodes: {repo_graph.number_of_nodes()}, Edges: {repo_graph.number_of_edges()}')\n\n# Select a connected symbol and query structural neighbors (callers, callees, definitions)\nquery_node = next((n for n, deg in repo_graph.degree() if deg >= 5), sample_nodes[0])\nneighbors = sg.get_neighbor(\n    node=query_node,\n    graph=repo_graph,\n    max_neighbors=10,\n)\nprint(f'\\nNeighbors of {query_node!r} (showing up to 5):')\nfor n in neighbors[:5]:\n    print(f'  - {n}')\n\n# Search for semantically similar code nodes using pre-computed vector embeddings\nsimilar = sg.get_similar_nodes(\n    node=query_node,\n    repo_name=sample_task.repo,\n    k=5,\n    graph=repo_graph,\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    base_commit=sample_task.base_commit,\n)\nprint(f'\\nTop similar nodes to {query_node!r}:')\nfor item in similar:\n    print(f\"  - {item['node_name']} (similarity={item['similarity']:.4f})\")\n\n# Extract an induced subgraph connecting the query symbol and its neighbors\nfocal_nodes = [query_node, *neighbors[:4]]\nsubgraph = sg.get_induced_subgraph(repo_graph, focal_nodes)\nprint(\n    f'\\nInduced subgraph over {len(focal_nodes)} focal nodes: '\n    f'{subgraph.number_of_nodes()} nodes, {subgraph.number_of_edges()} edges'\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:07:01.670681Z","iopub.execute_input":"2026-10-12T21:07:01.671113Z","iopub.status.idle":"2026-10-12T21:07:03.162442Z","shell.execute_reply.started":"2026-10-12T21:07:01.671086Z","shell.execute_reply":"2026-10-12T21:07:03.161745Z"}},"outputs":[],"execution_count":null},{"id":"86ef881b","cell_type":"markdown","source":"## 4. Start vLLM Server","metadata":{}},{"id":"f0b1ab0d","cell_type":"code","source":"import litellm\nimport torch\nfrom adk_submission import VllmConfig, VllmServer, discover_adapters\nfrom adk_submission.discovery import discover_declared_models\nfrom swegemma.config import ALLOWED_ADAPTER_EXTENSIONS\n\nlitellm.drop_params = True\n\nALLOWED_MODEL_NAMES = frozenset({\n    'gemma-4-31b-it-qat-w4a16-ct',\n    'gemma-4-12b-it-qat-w4a16-ct',\n    'gemma-4-e4b-it-qat-w4a16-ct',\n    'gemma-4-e2b-it-qat-w4a16-ct',\n})\nMODEL_VLLM_EXTRA_ARGS = {\n    'gemma-4-12b-it-qat-w4a16-ct': (\n        '--hf-overrides',\n        '{\"architectures\": [\"Gemma4ForCausalLM\"], \"model_type\": \"gemma4\"}',\n    ),\n}\n_SAFE_PATH_COMPONENT = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')\nINFERENCE_API_KEY = os.environ.get('LOCAL_API_KEY', 'EMPTY')\n\n# Validate single canonical base model and discover any PEFT LoRA adapters in the submission directory.\n# Note: sample_submission includes dummy LoRA adapters (adapters/main_lora and adapters/tool_lora)\n# shaped for gemma-4-31b-it-qat-w4a16-ct; Cell 2 removes them automatically when MODEL_NAME != 31B.\ndeclared_models = discover_declared_models(AGENT_DIR)\nassert len(declared_models) == 1, f'Expected exactly 1 declared model, got: {sorted(declared_models)}'\ndeclared_model = next(iter(declared_models))\nassert declared_model in ALLOWED_MODEL_NAMES, f'Unsupported model {declared_model!r}. Allowed: {sorted(ALLOWED_MODEL_NAMES)}'\n\nMODEL_PATH = Path(f'/kaggle/input/models/google/gemma-4/other/{declared_model}/2')\nassert MODEL_PATH.exists(), f'Model weights not found at {MODEL_PATH}. Ensure the model input is attached.'\n\nadapters = discover_adapters(str(AGENT_DIR), adapter_extensions=ALLOWED_ADAPTER_EXTENSIONS)\nadapter_map = getattr(adapters, 'adapters', None) or {}\nfor adapter_name in adapter_map:\n    assert _SAFE_PATH_COMPONENT.fullmatch(adapter_name), (\n        f'Unsafe adapter name {adapter_name!r}: must match [A-Za-z0-9][A-Za-z0-9._-]*'\n    )\ndetected_ranks = [\n    r for info in adapter_map.values() if (r := getattr(info, 'rank', None)) is not None and r > 0\n]\n\ngpu_count = torch.cuda.device_count() if torch.cuda.is_available() else 1\ntp_size = 4 if gpu_count >= 4 else (2 if gpu_count >= 2 else 1)\n\nif 'server_instance' in globals() and server_instance is not None:\n    server_instance.stop()\n\nvllm_cfg = VllmConfig(\n    model=str(MODEL_PATH),\n    port=8000,\n    host='127.0.0.1',\n    tool_call_parser='gemma4',\n    reasoning_parser='gemma4',\n    max_model_len=32768,\n    dtype='bfloat16' if (torch.cuda.is_available() and torch.cuda.is_bf16_supported()) else 'auto',\n    gpu_memory_utilization=0.90,\n    enable_auto_tool_choice=True,\n    enable_lora=bool(adapter_map),\n    max_loras=max(1, len(adapter_map)),\n    max_lora_rank=max(detected_ranks) if detected_ranks else 128,\n    scheduler_reserve_full_isl=False,\n    tensor_parallel_size=tp_size,\n    startup_timeout=60 * 20,\n    extra_args=MODEL_VLLM_EXTRA_ARGS.get(declared_model, ()),\n)\nserver_instance = VllmServer(vllm_cfg, adapter_manifest=adapters)\nserver_instance.start()\nprint(f'vLLM server started on {server_instance.base_url} (tp={tp_size})')\n\n# Register model and LoRA adapter aliases for Google ADK\nmodels = server_instance.create_model_registry(\n    aliases=[declared_model],\n    model_prefix='openai/',\n    api_key=INFERENCE_API_KEY,\n)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:11:28.843785Z","iopub.execute_input":"2026-10-12T21:11:28.844384Z","iopub.status.idle":"2026-10-12T21:15:30.765782Z","shell.execute_reply.started":"2026-10-12T21:11:28.844352Z","shell.execute_reply":"2026-10-12T21:15:30.765199Z"}},"outputs":[],"execution_count":null},{"id":"a0434776","cell_type":"markdown","source":"## 5. Run Phase 1 Inference and Phase 2 Verification","metadata":{}},{"id":"105c5b68","cell_type":"code","source":"import asyncio\nimport concurrent.futures\nimport pandas as pd\nimport yaml\nfrom google.adk.agents.context_cache_config import ContextCacheConfig\nfrom google.adk.apps._configs import EventsCompactionConfig\nfrom swegemma.config import EvalConfig, build_submission_limits\nfrom swegemma.evaluate import Evaluator\n\n\ndef run_sync(coro_or_fn, *args, **kwargs):\n    \"\"\"Run an async coroutine synchronously inside a notebook event loop.\"\"\"\n    if callable(coro_or_fn) and not asyncio.iscoroutine(coro_or_fn):\n        fn = lambda: coro_or_fn(*args, **kwargs)\n    else:\n        fn = lambda: coro_or_fn\n    try:\n        loop = asyncio.get_running_loop()\n    except RuntimeError:\n        loop = None\n    if loop is not None and loop.is_running():\n        with concurrent.futures.ThreadPoolExecutor(max_workers=1) as pool:\n            return pool.submit(lambda: asyncio.run(fn())).result()\n    return asyncio.run(fn())\n\n\n# Read optional evaluation settings from the submission's eval_config.yaml / eval_config.yml\neval_config_file = next(\n    (c for name in ('eval_config.yaml', 'eval_config.yml') if (c := AGENT_DIR / name).is_file()),\n    None,\n)\nraw_eval_cfg = (\n    yaml.safe_load(eval_config_file.read_text(encoding='utf-8')) or {}\n    if eval_config_file is not None\n    else {}\n)\neval_section = raw_eval_cfg.get('evaluation', raw_eval_cfg)\n\ntimeout_seconds = int(eval_section.get('timeout_seconds', 300))\nverification_timeout_seconds = int(eval_section.get('verification_timeout_seconds', 300))\nmax_tool_calls = int(eval_section.get('max_tool_calls', 100))\nmax_time_minutes = float(eval_section.get('max_time_minutes', 60.0))\nturns_raw = eval_section.get('max_turns', eval_section.get('max_llm_calls'))\nmax_turns = int(turns_raw) if turns_raw is not None else None\n\n# Select a small subset of tasks from the published dataset\nSAMPLE_TASKS = tasks[:2]\nlimits, gen_constraints = build_submission_limits()\n\n# Configure Evaluator to run Phase 1 (agent patch generation) and Phase 2 (verification)\n# using the subprocess sandbox backend and the submission's eval_config parameters\neval_config = EvalConfig(\n    tasks_path=TASKS_PATH,\n    snapshots_dir=DATA_DIR / 'snapshots',\n    results_dir=WORKING_DIR / 'results',\n    submission_dir=AGENT_DIR,\n    models=models,\n    sandbox='subprocess',\n    timeout_seconds=timeout_seconds,\n    verification_timeout_seconds=verification_timeout_seconds,\n    max_time_minutes=max_time_minutes,\n    max_tool_calls=max_tool_calls,\n    max_turns=max_turns,\n    limits=limits,\n    generation_constraints=gen_constraints,\n    adapter_manifest=adapters,\n    context_cache_config=ContextCacheConfig(min_tokens=2048, ttl_seconds=1800, cache_intervals=10),\n    events_compaction_config=EventsCompactionConfig(\n        compaction_interval=15,\n        overlap_size=2,\n        token_threshold=14336,\n        event_retention_size=5,\n    ),\n    graph_dir=GRAPH_DIR,\n    embeddings_dir=EMBEDDINGS_DIR,\n    wheels_dir=DATA_DIR / 'wheels',\n    verbose=False,\n)\n\nevaluator = Evaluator(eval_config)\npredictions = []\n\nfor idx, task in enumerate(SAMPLE_TASKS, start=1):\n    print(f'[{idx}/{len(SAMPLE_TASKS)}] Evaluating {task.instance_id} ({task.repo})...')\n    result = run_sync(\n        evaluator.evaluate_task,\n        task=task,\n        task_index=idx,\n        total_tasks=len(SAMPLE_TASKS),\n    )\n    patch = (result.agent_patch or '').strip()\n    predictions.append({'id': task.instance_id, 'prediction': patch if patch else 'NO_PATCH'})\n    print(\n        f'  -> resolved={result.resolved}, '\n        f'exit_code={result.test_exit_code}, '\n        f'patch_chars={len(patch)}, '\n        f'tool_calls={result.tool_calls}, '\n        f'duration={result.duration_seconds:.1f}s'\n    )\n\nsubmission_df = pd.DataFrame(predictions, columns=['id', 'prediction'])\ndisplay(submission_df)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-12T21:15:30.766899Z","iopub.execute_input":"2026-10-12T21:15:30.767128Z"}},"outputs":[],"execution_count":null},{"id":"728ab31f","cell_type":"markdown","source":"## 6. Package Submission Archive","metadata":{}},{"id":"d811048f","cell_type":"code","source":"import zipfile\nfrom adk_submission import validate_directory\nfrom swegemma.config import ALLOWED_SUBMISSION_EXTENSIONS, MAX_SUBMISSION_SIZE_BYTES\n\n# Validate unpacked submission directory structure, file types, symlinks, and size limits\nfor dirpath, dirnames, filenames in os.walk(AGENT_DIR, followlinks=False):\n    parent = Path(dirpath)\n    for name in (*dirnames, *filenames):\n        assert not (parent / name).is_symlink(), f'Symlinks are not permitted: {(parent / name).relative_to(AGENT_DIR)}'\nvalidate_directory(AGENT_DIR, limits=limits)\n\n# Create submission.zip with agent.yaml at the root of the archive\nzip_base = WORKING_DIR / 'submission'\nzip_path = Path(shutil.make_archive(str(zip_base), 'zip', root_dir=AGENT_DIR))\n\n# Validate archive contents against competition constraints\nwith zipfile.ZipFile(zip_path, 'r') as zf:\n    infos = zf.infolist()\n    total_size = sum(i.file_size for i in infos)\n    assert total_size <= MAX_SUBMISSION_SIZE_BYTES, f'Archive exceeds 3 GiB limit: {total_size}'\n    for info in infos:\n        if not info.is_dir():\n            ext = Path(info.filename).suffix.lower()\n            assert ext in ALLOWED_SUBMISSION_EXTENSIONS, f'Disallowed file extension: {info.filename}'\n\nprint(f'Created {zip_path} ({zip_path.stat().st_size / (1024 * 1024):.2f} MiB)')","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}
3:This document provides a complete technical reference for the **`swegemma`** evaluation harness and its companion libraries (**`adk-submission`** and **`adk-eval-core`**). It explains how competitor submissions are validated and compiled, how the harness orchestrates agent sessions and sandboxes, how the built-in tools behave, and how generated patches are extracted and graded.
29:| **`adk-eval-core`** | **Core Evaluation Infrastructure.** Provides base task/result models (`BenchmarkTask`, `BaseTaskResult`, `EvaluationResult`), sandbox execution backends (`DockerContainer`, `SubprocessSandbox`), resilient 3-tier file editing (`apply_replacement`), token/cost tracking (`TokenBudget`, `PricingTable`), ADK plugins (`EventDisplayPlugin`, `ModelRetryPlugin`), and ATIF v1.7 trajectory tracing (`SessionTrace`). |
30:| **`swegemma`** | **SWE-bench Harness & Scoring Engine.** Implements the two-container SWE evaluation lifecycle (`Evaluator`, `run_agent_sandbox`, `verify_task`), binds the 9 sandboxed workspace and code-intelligence tools (`SwegemmaContext.create_tools()`), constructs the task prompt and continuation nudges, extracts unified git diffs (`scripts/inference.py`), and runs hermetic `pytest` + JUnit XML verification (`scripts/metric.py`). |
59:    Tools <-->|"docker exec / subprocess"| ContA
69:Competitors **do not** submit Python code entrypoints (`agent.py` or `agent_fn`). Standard ADK's `from_config()` permits arbitrary dynamic Python imports; **`adk-submission` replaces it with a sandboxed YAML compiler (`compile_submission`)**. All agents, sub-agents, workflows, tools, and generation parameters are declared in YAML and resolved against closed host registries (`ToolRegistry`, `ModelRegistry`, `SkillRegistry`, `CallbackRegistry`).
128:Submission constraints in `swegemma` (`build_submission_limits()` in `swegemma/config.py`) are intentionally minimal: **aside from security sandboxing (no symlinks, no path traversal, declarative YAML only), the primary hard constraint is a total unpacked submission size of `< 3 GiB` (`3,221,225,472` bytes), including all `adapters/` weights**, plus token ceilings required by the 4x L4 GPU context window (`32,768` tokens).
154:> Execution-altering ADK fields that bypass the sandbox (`tools`, `system_instruction`, `http_options`, `safety_settings`, or `response_schema` inside `generate_content_config`) are excluded from `GenerateContentConfig` by schema design and will raise a validation error if set.
189:- **All agents in a submission must declare at most ONE unique base model** (`len(models) == 1`), and in Kaggle competition scoring (`scripts/inference.py`) that model must be in `ALLOWED_MODEL_NAMES` (`gemma-4-31b-it-qat-w4a16-ct`, `gemma-4-12b-it-qat-w4a16-ct`, `gemma-4-e4b-it-qat-w4a16-ct`, or `gemma-4-e2b-it-qat-w4a16-ct`). Declaring multiple base models or an unpermitted model raises `ParticipantVisibleError`.
202:When the scoring harness starts the local inference server (`setup_vllm_server` in `scripts/inference.py`, running `VllmServer` on `127.0.0.1:8000` with `tool_call_parser='gemma4'`, `reasoning_parser='gemma4'`, `max_model_len=32768`), it binds the declared model alias (and any discovered adapter names) to `LiteLlm(model=f"openai/{served_model}", api_base="http://127.0.0.1:8000/v1")` via `server_instance.create_model_registry(...)` (or fallback `LiteLlm(..., num_retries=3)` when attaching to an already-active endpoint) and installs the LiteLLM reasoning patch (`install_litellm_reasoning_patch()`).
221:Every benchmark task (`Task`) is evaluated in **two completely separate sandbox lifecycles** (`Container A` for agent execution and `Container B` for verification).
