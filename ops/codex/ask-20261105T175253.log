   226	def setup_script_path(data_dir):
   227	    """The dependency setup script the subprocess installer copies and executes."""
   228	    setup_py = Path(data_dir) / 'sandbox' / 'setup.py'
   229	    if not setup_py.exists():
   230	        setup_py = next(iter(sorted(Path(data_dir).rglob('setup.py'))), setup_py)  # competition sandbox/setup.py
   231	    return setup_py
