   519	
   520	def install_test_dependencies(
   521	    docker: BaseSandboxManager,
   522	    container_id: str,
   523	    repo: str = '',
   524	    *,
   525	    fast_path: bool = True,
   526	    config: EvalConfig | None = None,
   527	) -> None:
   528	    """Installs test dependencies discovered from pyproject.toml and requirements files or via fast-path."""
   529	    if type(docker).__name__ in {'SubprocessManager', 'SubprocessSandbox'}:
   530	        return
   531	    _ensure_container_site_packages(docker, container_id, repo, config)
   532	
   533	    setup_script = resolve_sandbox_setup_script(config)
   534	    if setup_script and setup_script.exists():
   535	        docker.copy_to(container_id, setup_script, '/tmp/setup.py')
   536	        script_in_container = '/tmp/setup.py'
   537	    else:
   538	        check_res = docker.exec(container_id, 'test -f /sandbox/setup.py')
   539	        if check_res.exit_code == 0:
   540	            script_in_container = '/sandbox/setup.py'
   541	        else:
   542	            msg = f'setup.py not found on host or container for {container_id}'
   543	            is_subprocess = (
   544	                getattr(config, 'sandbox', 'docker') == 'subprocess'
   545	                or type(docker).__name__ in {'SubprocessManager', 'SubprocessSandbox'}
   546	            )
   547	            if config is not None and not is_subprocess:
   548	                logger.error(msg)
   549	                raise ContainerSetupError(msg)
   550	            logger.warning(msg)
   551	            return
   552	
   553	    fast_flag = '--fast-path' if fast_path else ''
   554	    cmd = f'python3 {script_in_container} {fast_flag} {repo}'.strip()
   555	    try:
   556	        res = docker.exec(container_id, cmd)
   557	        logger.debug('Install test deps stdout: %s', res.stdout)
   558	        if res.exit_code != 0:
   559	            details = f'stdout:\n{res.stdout}\nstderr:\n{res.stderr}'.strip()
   560	            if 'No such file or directory' in (res.stderr or ''):
   561	                msg = f'Failed to execute {script_in_container} on container {container_id}: {res.stderr}'
   562	                logger.error(msg)
   563	                raise ContainerSetupError(msg)
   564	            logger.warning(
   565	                'Failed to install test dependencies for %s (exit code %d):\n%s',
   566	                repo,
   567	                res.exit_code,
   568	                details,
   569	            )
   570	    finally:
   571	        if script_in_container == '/tmp/setup.py':
   572	            docker.exec(container_id, 'rm -f /tmp/setup.py')
   573	
   574	
   575	def setup_baseline_commit(
   576	    docker: BaseSandboxManager, container_id: str, commit_msg: str = 'baseline'
   577	) -> None:
   578	    """Creates a clean git baseline commit for diff calculations."""
   579	    docker.exec(
   580	        container_id,
   581	        f'cd /workspace && git add -A && git commit -m "{commit_msg}" --allow-empty -q && git tag -f _swegemma_baseline',
   582	    )
   583	
   584	
   585	def apply_patch_in_container(
   586	    docker: BaseSandboxManager,
   587	    container_id: str,
   588	    patch_path_in_container: str,
   589	    *,
   590	    workspace_dir: str = '/workspace',
   591	) -> tuple[int, str, str]:
   592	    """Applies a patch inside the container using a robust multi-strategy pipeline.
   593	
   594	    Strategies executed in order:
   595	    1. Raw git apply with -p1 strategies ONLY (-3, whitespace tolerance, recount).
   596	    2. Symlink path normalization with -p1 strategies ONLY (resolves symlink directory leading path
   597	       components via os.path.realpath against workspace_dir and retries git apply).
   598	    3. Prefixless git apply with -p0 strategies on raw and normalized patches (-p0, -3, whitespace tolerance, recount).
   599	    4. Non-interactive fallback with --dry-run validation (patch -p1 then -p0 --batch --forward, including -l for whitespace).
   600	
   601	    Returns:
   602	        tuple[int, str, str]: (exit_code, stdout, stderr)
   603	    """
   604	    script = r'''
   605	import os, sys, subprocess, re
   606	from pathlib import Path
   607	
   608	if len(sys.argv) < 3:
   609	    sys.stderr.write("Usage: apply_patch.py <workspace_dir> <patch_path>\n")
   610	    sys.exit(1)
   611	
   612	workspace = Path(sys.argv[1]).resolve()
   613	p_path = Path(sys.argv[2]).resolve()
   614	if not p_path.exists():
   615	    sys.stderr.write(f"Patch file not found: {p_path}\n")
   616	    sys.exit(1)
   617	if p_path.stat().st_size == 0:
   618	    sys.exit(0)
   619	
   620	def check_safe_rel_path(raw_rel: str) -> None:
   621	    s = raw_rel.strip().strip('"')
   622	    if not s or s == "/dev/null":
   623	        return
   624	    if s.startswith(("a/", "b/")):
   625	        s = s[2:].strip()
   626	    if not s or s == "/dev/null":
   627	        return
   628	    if s.startswith("/") or ".." in Path(s).parts:
   629	        sys.stderr.write(f"Unsafe path traversal in patch: {raw_rel}\n")
   630	        sys.exit(1)
   631	    resolved_target = (workspace / s).resolve()
   632	    if resolved_target != workspace and not resolved_target.is_relative_to(workspace):
   633	        sys.stderr.write(f"Unsafe symlink/path escape in patch: {raw_rel}\n")
   634	        sys.exit(1)
   635	
   636	raw_patch_text = p_path.read_text(errors="replace")
   637	for raw_line in raw_patch_text.splitlines():
   638	    if raw_line.startswith("diff --git "):
   639	        m = re.match(r'^diff --git\s+"?a/(.+?)"?\s+"?b/(.+?)"?$', raw_line)
   640	        if m:
   641	            check_safe_rel_path(m.group(1))
   642	            check_safe_rel_path(m.group(2))
   643	    elif raw_line.startswith(("--- ", "+++ ")):
   644	        hdr = raw_line[4:].split("\t", 1)[0].strip()
   645	        check_safe_rel_path(hdr)
   646	    elif raw_line.startswith(("rename from ", "rename to ")):
   647	        hdr = raw_line.split(" ", 2)[2].strip()
   648	        check_safe_rel_path(hdr)
   649	    elif raw_line.startswith("# empty_dir: "):
   650	        hdr = raw_line.split(": ", 1)[-1].strip()
   651	        check_safe_rel_path(hdr)
   652	
   653	try:
   654	    with open(p_path, 'rb') as pf:
   655	        for line in pf:
   656	            if line.startswith(b'# empty_dir: '):
   657	                d = line.decode('utf-8', errors='ignore').strip().split(': ', 1)[-1]
   658	                if d:
   659	                    check_safe_rel_path(d)
   660	                    (workspace / d).mkdir(parents=True, exist_ok=True)
   661	            elif line.startswith(b'diff --git'):
   662	                break
   663	except Exception:
   664	    pass
   665	
   666	def normalize_patch(p: Path) -> Path:
   667	    text = p.read_text(errors="replace")
   668	    lines, mod = [], False
   669	
   670	    def quote_path(prefix: str, path_str: str) -> str:
   671	        if " " in path_str:
   672	            return f'"{prefix}/{path_str}"'
   673	        return f"{prefix}/{path_str}"
   674	
   675	    for line in text.splitlines(keepends=True):
   676	        nl = "\r\n" if line.endswith("\r\n") else ("\n" if line.endswith("\n") else "")
   677	        content = line[:-len(nl)] if nl else line
   678	
   679	        if content.startswith("diff --git "):
   680	            matched = False
   681	            # Case 1: Quoted diff --git "a/..." "b/..."
   682	            m = re.match(r'^diff --git\s+"a/(.+?)"\s+"b/(.+?)"(.*)$', content)
   683	            if m:
   684	                p_a, p_b, rest = m.groups()
   685	                matched = True
   686	            else:
   687	                # Case 2: Unquoted identical paths (with or without spaces)
   688	                m = re.match(r'^diff --git\s+a/(.+)\s+b/\1(.*)$', content)
   689	                if m:
   690	                    p_a, p_b, rest = m.group(1), m.group(1), m.group(2)
   691	                    matched = True
   692	                else:
   693	                    # Case 3: Standard unquoted diff --git a/... b/...
   694	                    m = re.match(r'^diff --git\s+a/(\S+)\s+b/(\S+)(.*)$', content)
   695	                    if m:
   696	                        p_a, p_b, rest = m.groups()
   697	                        matched = True
   698	            if matched:
   699	                try:
   700	                    r_a = os.path.relpath(os.path.realpath(workspace / p_a), workspace)
   701	                    r_b = os.path.relpath(os.path.realpath(workspace / p_b), workspace)
   702	                    check_safe_rel_path(r_a)
   703	                    check_safe_rel_path(r_b)
   704	                    if r_a != p_a or r_b != p_b:
   705	                        mod = True
   706	                    qa = quote_path("a", r_a)
   707	                    qb = quote_path("b", r_b)
   708	                    lines.append(f"diff --git {qa} {qb}{rest}{nl}")
   709	                    continue
   710	                except Exception:
   711	                    pass
   712	
   713	        elif content.startswith("--- a/") or content.startswith('--- "a/'):
   714	            try:
   715	                if content.startswith('--- "a/'):
   716	                    raw_after = content[7:]
   717	                    p_sub, _, rest = raw_after.partition('"')
   718	                    quoted = True
   719	                else:
   720	                    raw_after = content[6:]
   721	                    p_sub, tab, timestamp = raw_after.partition("\t")
   722	                    rest = f"\t{timestamp}" if tab else ""
   723	                    quoted = False
   724	                r_sub = os.path.relpath(os.path.realpath(workspace / p_sub), workspace)
   725	                check_safe_rel_path(r_sub)
   726	                if r_sub != p_sub:
   727	                    mod = True
   728	                q_sub = quote_path("a", r_sub) if (quoted or " " in r_sub) else f"a/{r_sub}"
   729	                lines.append(f"--- {q_sub}{rest}{nl}")
   730	                continue
   731	            except Exception:
   732	                pass
   733	
   734	        elif content.startswith("+++ b/") or content.startswith('+++ "b/'):
   735	            try:
   736	                if content.startswith('+++ "b/'):
   737	                    raw_after = content[7:]
   738	                    p_sub, _, rest = raw_after.partition('"')
   739	                    quoted = True
   740	                else:
   741	                    raw_after = content[6:]
   742	                    p_sub, tab, timestamp = raw_after.partition("\t")
   743	                    rest = f"\t{timestamp}" if tab else ""
   744	                    quoted = False
   745	                r_sub = os.path.relpath(os.path.realpath(workspace / p_sub), workspace)
   746	                check_safe_rel_path(r_sub)
   747	                if r_sub != p_sub:
   748	                    mod = True
   749	                q_sub = quote_path("b", r_sub) if (quoted or " " in r_sub) else f"b/{r_sub}"
   750	                lines.append(f"+++ {q_sub}{rest}{nl}")
   751	                continue
   752	            except Exception:
   753	                pass
   754	
   755	        lines.append(line)
   756	
   757	    if not mod:
   758	        return p
   759	    norm_p = p.with_suffix(".norm.patch")
   760	    norm_p.write_text("".join(lines))
   761	    return norm_p
   762	
   763	errors = []
   764	def try_cmd(c: list[str]) -> bool:
   765	    try:
   766	        r = subprocess.run(c, cwd=workspace, capture_output=True, text=True)
   767	        if r.returncode == 0:
   768	            sys.exit(0)
   769	        errors.append(f"{' '.join(c)} failed ({r.returncode}):\n{r.stderr}\n{r.stdout}")
   770	    except FileNotFoundError as fnf:
   771	        errors.append(f"{c[0]} not found: {fnf}")
   772	    return False
   773	
   774	# Pass 1: Raw patch with -p1 strategies ONLY
   775	for c in [
   776	    ["git", "apply", str(p_path)],
   777	    ["git", "apply", "-3", str(p_path)],
   778	    ["git", "apply", "--ignore-space-change", "--ignore-whitespace", str(p_path)],
   779	    ["git", "apply", "--recount", str(p_path)],
   780	]:
   781	    try_cmd(c)
   782	
   783	# Pass 2: Normalized patch with -p1 strategies ONLY
   784	norm_p = normalize_patch(p_path)
   785	if norm_p != p_path:
   786	    for c in [
   787	        ["git", "apply", str(norm_p)],
   788	        ["git", "apply", "-3", str(norm_p)],
   789	        ["git", "apply", "--ignore-space-change", "--ignore-whitespace", str(norm_p)],
   790	        ["git", "apply", "--recount", str(norm_p)],
   791	    ]:
   792	        try_cmd(c)
   793	
   794	# Pass 3: -p0 strategies on raw and normalized patches ONLY if both -p1 passes fail (for prefixless patches)
   795	p0_targets = [p_path, norm_p] if norm_p != p_path else [p_path]
   796	for target in p0_targets:
   797	    for c in [
   798	        ["git", "apply", "-p0", str(target)],
   799	        ["git", "apply", "-p0", "-3", str(target)],
   800	        ["git", "apply", "-p0", "--ignore-space-change", "--ignore-whitespace", str(target)],
   801	        ["git", "apply", "-p0", "--recount", str(target)],
   802	    ]:
   803	        try_cmd(c)
   804	
   805	# Pass 4: Non-interactive patch fallback with --dry-run validation (try -p1 first, then -p0)
   806	patch_targets = [norm_p, p_path] if norm_p != p_path else [p_path]
   807	for target in patch_targets:
   808	    for c in [
   809	        ["patch", "-p1", "--batch", "--forward", "-i", str(target)],
   810	        ["patch", "-p1", "-l", "--batch", "--forward", "-i", str(target)],
   811	    ]:
   812	        dry_cmd = c + ["--dry-run"]
   813	        try:
   814	            r_dry = subprocess.run(dry_cmd, cwd=workspace, capture_output=True, text=True)
   815	            if r_dry.returncode == 0:
   816	                r_apply = subprocess.run(c, cwd=workspace, capture_output=True, text=True)
   817	                if r_apply.returncode == 0:
   818	                    sys.exit(0)
   819	                errors.append(f"{' '.join(c)} apply failed ({r_apply.returncode}):\n{r_apply.stderr}\n{r_apply.stdout}")
   820	            else:
   821	                errors.append(f"{' '.join(dry_cmd)} dry-run failed ({r_dry.returncode}):\n{r_dry.stderr}\n{r_dry.stdout}")
   822	        except FileNotFoundError as fnf:
   823	            errors.append(f"{c[0]} not found: {fnf}")
   824	
   825	for target in patch_targets:
   826	    for c in [
   827	        ["patch", "-p0", "--batch", "--forward", "-i", str(target)],
   828	        ["patch", "-p0", "-l", "--batch", "--forward", "-i", str(target)],
   829	    ]:
   830	        dry_cmd = c + ["--dry-run"]
   831	        try:
   832	            r_dry = subprocess.run(dry_cmd, cwd=workspace, capture_output=True, text=True)
   833	            if r_dry.returncode == 0:
   834	                r_apply = subprocess.run(c, cwd=workspace, capture_output=True, text=True)
   835	                if r_apply.returncode == 0:
   836	                    sys.exit(0)
   837	                errors.append(f"{' '.join(c)} apply failed ({r_apply.returncode}):\n{r_apply.stderr}\n{r_apply.stdout}")
   838	            else:
   839	                errors.append(f"{' '.join(dry_cmd)} dry-run failed ({r_dry.returncode}):\n{r_dry.stderr}\n{r_dry.stdout}")
   840	        except FileNotFoundError as fnf:
   841	            errors.append(f"{c[0]} not found: {fnf}")
   842	
   843	sys.stderr.write("\n".join(errors) + "\n")
   844	sys.exit(1)
   845	'''
   846	    cmd = (
   847	        f'python3 -S -c {shlex.quote(script)} {shlex.quote(workspace_dir)} '
   848	        f'{shlex.quote(patch_path_in_container)}'
   849	    )
   850	    try:
   851	        res = docker.exec(container_id, cmd)
   852	        exit_code = res.exit_code if res.exit_code is not None else -1
   853	        return exit_code, res.stdout, res.stderr
   854	    finally:
   855	        if patch_path_in_container.startswith('/tmp/'):
   856	            docker.exec(container_id, f'rm -f {shlex.quote(patch_path_in_container)}*')
   857	
   858	
   859	def setup_synthetic_hardware(docker: BaseSandboxManager, container_id: str) -> None:
   860	    """Delegate synthetic environment preparation to the bundle's sandbox/setup.py script."""
   861	    return
