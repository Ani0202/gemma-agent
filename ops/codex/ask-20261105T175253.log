   311	    MODEL_VLLM_EXTRA_ARGS = {'gemma-4-12b-it-qat-w4a16-ct': (
   312	        '--hf-overrides', '{"architectures": ["Gemma4ForCausalLM"], "model_type": "gemma4"}')}
   313	    _SAFE_PATH_COMPONENT = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]*')
   314	    declared_models = discover_declared_models(BUNDLE)
   315	    assert len(declared_models) == 1, f'Expected exactly 1 declared model, got: {sorted(declared_models)}'
   316	    declared_model = next(iter(declared_models))
   317	    assert declared_model in {'gemma-4-' + x + '-it-qat-w4a16-ct' for x in ('31b', '12b', 'e4b', 'e2b')}, 'Unsupported declared model'
