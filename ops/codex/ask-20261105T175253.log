   941	def setup_container_workspace(
   942	    docker: BaseSandboxManager,
   943	    container_id: str,
   944	    repo: str = '',
   945	    *,
   946	    fast_path: bool = True,
   947	    commit_msg: str = 'eval_baseline',
   948	    workspace_dir: str = '/workspace',
   949	    config: EvalConfig | None = None,
   950	) -> None:
   951	    """Sets up the complete container environment for evaluation or agent discovery.
   952	
   953	    Executes git exclude configuration, editable package installation,
   954	    dependency/setup.py execution, workspace test discovery configuration, and baseline git commit.
   955	    """
   956	    setup_synthetic_hardware(docker, container_id)
   957	    setup_git_exclude(docker, container_id)
   958	    install_editable_package(docker, container_id)
   959	    install_test_dependencies(
