   232	def verified_records(procs, records):
   233	    """A status pid/PGID alone is never proof of current job ownership."""
   234	    if not records:
   235	        return []
   236	    # Compare the full bash -c wrapper body with our installed bin/job. Fail closed
   237	    # if its layout changes; substring matches could admit unrelated shell scripts.
   238	    script = wrapper_script()
   239	    boot_id = current_boot_id()
   240	    verified = []
   241	    for record in records:
   242	        if not same_boot(record, boot_id):
   243	            continue
   244	        d = procs.get(record["pid"])
   245	        if not d or d["state"] in {"Z", "X"} or d["uid"] != UID:
   246	            continue
   247	        if "starttime" in record:
   248	            if str(d["starttime"]) != str(record["starttime"]):
   249	                continue
   250	        else:
   251	            cmdline = read(f"/proc/{record['pid']}/cmdline", "rb") or b""
   252	            if not is_job_wrapper(cmdline, record["name"], script):
   253	                continue
   254	        verified.append(record)
   255	    return verified
