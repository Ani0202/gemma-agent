   215	def protected_watchdogs(procs, records):
   216	    # Deployment stops the old guard before starting the new one, with no heavy
   217	    # jobs running. We do not rely on the old implementation excluding this guard.
   218	    guards = {p for p in procs if runs_memguard(p) or watchdog_record(
   219	        p, read(f"/proc/{p}/cmdline", "rb") or b"",
   220	        marker_value(p, "GEMMA_JOB_ID"), records)}
   221	    for p in procs:
   222	        job_id = marker_value(p, "GEMMA_JOB_ID")
   223	        name = job_name(p, procs, records)
   224	        if (watchdog_id(job_id) or
   225	                (name is not None and name.startswith("memguard")) or
   226	                any(r["name"].startswith("memguard") and r["pid"] in ancestors(p, procs)
   227	                    for r in records)):
   228	            guards.add(p)
   229	    return guards | {procs[p]["ppid"] for p in guards}
