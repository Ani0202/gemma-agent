   430	def kill_tree(job, args, self_pids, log):
   431	    """Two empty scans, bounded by five seconds, then an independent survivor inventory."""
   432	    killed = set()
   433	    started = time.monotonic()
   434	    deadline = started + 5
   435	    root_identity = job["members"].get(job["root"])
   436	    empty_scans = 0
   437	    while time.monotonic() < deadline:
   438	        members = inventory(job, args, self_pids)
   439	        # The wrapper gets a grace period to record the child's failure. A new process
   440	        # with the same numeric pid does not inherit this special treatment.
   441	        grace = (root_identity and time.monotonic() < started + 3 and
   442	                 any(p != job["root"] for p in job["members"]))
   443	        for p, d in members.items():
   444	            if grace and p == job["root"] and d["starttime"] == root_identity["starttime"]:
   445	                continue
   446	            if send_kill(d, log, args, {job["key"]: job}):
   447	                killed.add(p)
   448	        empty_scans = empty_scans + 1 if not members else 0
   449	        if empty_scans >= 2 and not grace:
   450	            break
   451	        time.sleep(0.2)
   452	    survivors = sorted(inventory(job, args, self_pids))
   453	    return sorted(killed), survivors
   454	
