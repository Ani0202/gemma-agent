   377	        # Discover descendants and marked orphans BEFORE killing their parents.
   378	        procs = mg.snapshot()
   379	        cleanup = set(mg.descendants(job.pid, procs)) | marked_live(mg, marker, job_id)
   380	        for p in sorted(cleanup - {job.pid}):
