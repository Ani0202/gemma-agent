+    monkeypatch.setattr(mg.os, "close", lambda fd: None)
+    monkeypatch.setattr(mg.signal, "pidfd_send_signal", lambda *a: sent.append(a))
+    monkeypatch.setattr(mg.os, "kill", lambda *a: sent.append(a))
