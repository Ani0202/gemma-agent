   456	def send_mail(msg, log):
   457	    try:
   458	        result = subprocess.run([os.path.join(REPO, "bin/send"), "builder", msg],
   459	                                env={**os.environ, "SEND_FROM": "memguard", "GEMMA_ROLE": "memguard"},
   460	                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
   461	        if result.returncode:
   462	            log(f"  mail failed: exit {result.returncode}")
   463	    except (OSError, subprocess.TimeoutExpired) as exc:
   464	        log(f"  mail failed: {exc}")
