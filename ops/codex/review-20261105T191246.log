   148	def job_name(root, procs, records):
   149	    """Use status metadata only; never inspect a process command line."""
   150	    pgid = procs.get(root, {}).get("pgid")
   151	    for record in records:
   152	        if (record["pid"] == root or record["pgid"] == root or
   153	                (pgid is not None and pgid in (record["pid"], record["pgid"]))):
   154	            return record["name"]
   155	    return None
