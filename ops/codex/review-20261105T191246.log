   100	def ancestors(pid, procs):
   101	    out, seen = [], set()
   102	    p = procs.get(pid, {}).get("ppid", 0)
   103	    while p and p in procs and p not in seen:
   104	        seen.add(p); out.append(p); p = procs[p]["ppid"]
   105	    return out
