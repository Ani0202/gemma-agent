proc, mock_world = ns['proc'], ns['mock_world']
class File(io.StringIO):
    def close(self): pass

def actions(mg, mp, d, known=None):
    sent, output = [], File()
    real_open = open
    mp.setattr('builtins.open', lambda path, *a, **k: output if str(path).endswith('/oom_score_adj') else real_open(path, *a, **k))
    mp.setattr(mg.os, 'pidfd_open', lambda p: 42)
    mp.setattr(mg.os, 'close', lambda fd: None)
    mp.setattr(mg.signal, 'pidfd_send_signal', lambda *a: sent.append(a))
    mp.setattr(mg.os, 'kill', lambda *a: sent.append(a))
    kill_result = mg.send_kill(d, lambda _: None, SimpleNamespace(), known)
    oom_result = mg.raise_oom_adj({d['pid']: d}, False, SimpleNamespace(), known)
    return dict(kill=kill_result, signals=sent, oom_count=oom_result, oom_written=output.getvalue())

# Model a symlink named guard-alias in the guard's own cwd, pointing to bin/memguard.
