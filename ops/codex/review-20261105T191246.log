   171	def watchdog_argv(cmdline):
   172	    installed = os.fsencode(os.path.realpath(os.path.join(REPO, "bin/memguard")))
   173	    for arg in cmdline.split(b"\0"):
   174	        if not arg:
   175	            continue
   176	        path = os.path.realpath(arg) if b"/" in arg else arg
   177	        if path == installed or (os.path.basename(path) == b"memguard" and
   178	                                 os.path.basename(os.path.dirname(path)) == b"bin"):
   179	            return True
   180	    return False
