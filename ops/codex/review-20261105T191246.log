   422	def inventory(job, args, self_pids):
   423	    # Use the same job ID / known legacy identities for every scan, including survivors.
   424	    _, jobs = find_jobs(snapshot(), args, self_pids, known_jobs={job["key"]: job})
   425	    current = jobs.get(job["key"], {})
   426	    job["known_members"].update(current.get("known_members", {}))
   427	    return current.get("members", {})
