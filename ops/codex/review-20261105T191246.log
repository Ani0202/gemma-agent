   202	def watchdog_record(pid, cmdline, job_id, records):
   203	    """Use this recipient's fresh command and marker, including wrapper metadata."""
   204	    if watchdog_id(job_id) or watchdog_argv(cmdline):
   205	        return True
   206	    for record in records:
   207	        if record["pid"] != pid:
   208	            continue
   209	        command = read(os.path.join(REPO, "ops/jobs", record["name"] + ".cmd")) or ""
   210	        if "bin/memguard" in command and is_job_wrapper(cmdline, record["name"], wrapper_script()):
   211	            return True
   212	    return False
