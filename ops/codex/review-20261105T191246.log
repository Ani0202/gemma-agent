   467	def main():
   468	    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   469	    ap.add_argument("--interval", type=float, default=2.0)
   470	    ap.add_argument("--min-available", type=float, default=2.5, help="GiB")
   471	    ap.add_argument("--max-total", type=float, default=6.0, help="GiB of summed targeted RSS")
   472	    ap.add_argument("--min-kill-rss", type=float, default=0.25,
   473	                    help="GiB; on low MemAvailable alone, skip jobs smaller than this (killing a waiter frees nothing)")
   474	    ap.add_argument("--log", default=os.path.join(REPO, "ops/logs/memguard.log"))
   475	    ap.add_argument("--once", action="store_true")
   476	    ap.add_argument("--dry-run", action="store_true")
   477	    ap.add_argument("--no-mail", action="store_true")
   478	    args = ap.parse_args()
   479	    for k in ("min_available", "max_total", "min_kill_rss"):
   480	        setattr(args, k, int(getattr(args, k) * GIB))
   481	    os.makedirs(os.path.dirname(args.log), exist_ok=True)
   482	
   483	    def log(msg):
   484	        line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}"
   485	        with open(args.log, "a") as f:
   486	            f.write(line + "\n")
   487	        print(line, flush=True)
   488	
   489	    log(f"start pid={os.getpid()} min_available={args.min_available/GIB:.2f}G max_total={args.max_total/GIB:.2f}G "
   490	        f"dry_run={args.dry_run}")
   491	    last_beat = 0
   492	    jobs = {}
   493	    while True:
   494	        procs = snapshot()
   495	        self_pids = {os.getpid()} | set(ancestors(os.getpid(), procs))
   496	        # Our ancestors include the bin/job wrapper and maybe a Claude shell; they're never targets.
   497	        targets, jobs = find_jobs(procs, args, self_pids, known_jobs=jobs)
   498	        if args.dry_run:
   499	            log(f"targets={sorted(targets)} jobs=" + repr([
   500	                {"name": j["name"], "root": j["root"], "pids": sorted(j["pids"])}
   501	                for j in jobs.values()]))
   502	        raise_oom_adj(targets, args.dry_run, args, jobs)
   503	        avail = mem_available() or 0
   504	        total = sum(j["rss"] for j in jobs.values())
   505	        if time.time() - last_beat > 600:
   506	            log(f"beat avail={avail/GIB:.2f}G targeted_rss={total/GIB:.2f}G jobs={len(jobs)} targets={len(targets)}")
   507	            last_beat = time.time()
   508	        reason = None
   509	        if total > args.max_total:
   510	            reason = f"targeted RSS {total/GIB:.2f}G > {args.max_total/GIB:.2f}G"
   511	        elif avail < args.min_available:
   512	            reason = f"MemAvailable {avail/GIB:.2f}G < {args.min_available/GIB:.2f}G"
   513	        if reason and jobs:
   514	            _, j = max(jobs.items(), key=lambda kv: kv[1]["rss"])
   515	            root = j["root"]
   516	            if total <= args.max_total and j["rss"] < args.min_kill_rss:
   517	                reason = None  # pressure is not ours to fix by killing a tiny job
   518	        if reason and jobs:
   519	            name = j["name"]
   520	            comm = procs.get(root, {}).get("comm", "?")
   521	            log(f"KILL job={name or '-'} root={root} comm={comm} rss={j['rss']/GIB:.2f}G reason: {reason}"
   522	                + (" [dry-run]" if args.dry_run else ""))
   523	            if not args.dry_run:
   524	                killed, surv = kill_tree(j, args, self_pids, log)
   525	                log(f"  killed {len(killed)} pids; survivors={surv}")
   526	                msg = (f"memguard killed job {name or '(job pid %d %s)' % (root, comm)}: "
   527	                       f"{j['rss']/GIB:.2f}G, {reason}. Survivors: {surv or 'none'}. See ops/logs/memguard.log.")
   528	                if name:
   529	                    time.sleep(0.5)
   530	                    try:
   531	                        with open(os.path.join(REPO, "ops/jobs", f"{name}.log"), "a") as f:
   532	                            f.write(f"[memguard] {msg}\n")
   533	                    except OSError:
   534	                        pass
   535	                if not args.no_mail:
   536	                    # Mail may take up to ten seconds; keep polling while it completes.
   537	                    threading.Thread(target=send_mail, args=(msg, log)).start()
   538	        if args.once:
   539	            return 0
   540	        time.sleep(args.interval)
