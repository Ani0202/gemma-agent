   127	def running_jobs():
   128	    """Legacy three-field, current four-field, and longer (extra trailing fields) status records."""
   129	    records = []
   130	    for path in sorted(Path(REPO, "ops/jobs").glob("*.status")):
   131	        fields = (read(path) or "").split()
   132	        # >=3: legacy 3-field, current 4-field, and the proposed owner patch's extra identity fields.
   133	        if len(fields) < 3 or fields[0] != "running":
   134	            continue
   135	        try:
   136	            pid = int(fields[1])
   137	            pgid = int(fields[3]) if len(fields) >= 4 else None
   138	        except ValueError:
   139	            continue
   140	        record = {"name": path.stem, "pid": pid, "pgid": pgid}
   141	        if len(fields) >= 6:
   142	            record.update(boot_id=fields[4], starttime=fields[5],
   143	                          job_id=f"{path.stem}/{fields[4]}/{fields[5]}".encode())
   144	        records.append(record)
   145	    return records
