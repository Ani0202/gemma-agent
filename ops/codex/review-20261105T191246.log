   379	def send_kill(d, log, args, known_jobs=None):
   380	    """Pin a pidfd before the final identity check; never signal a recycled pid."""
   381	    fd = None
   382	    try:
   383	        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
   384	            try:
   385	                fd = os.pidfd_open(d["pid"])
   386	            except OSError as exc:
   387	                if exc.errno not in (errno.ENOSYS, errno.EINVAL, errno.EPERM):
   388	                    raise
   389	        if not action_eligible(d, args, known_jobs):
   390	            return False
   391	        if fd is not None:
   392	            signal.pidfd_send_signal(fd, signal.SIGKILL)
   393	        else:
   394	            os.kill(d["pid"], signal.SIGKILL)
   395	        return True
   396	    except ProcessLookupError:
   397	        return False
   398	    except OSError as exc:
   399	        log(f"  cannot kill {d['pid']}: {exc}")
   400	        return False
   401	    finally:
   402	        if fd is not None:
   403	            os.close(fd)
   404	
