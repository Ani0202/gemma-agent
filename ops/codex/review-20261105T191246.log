   194	def is_job_wrapper(cmdline, name, script):
   195	    argv = cmdline.split(b"\0")
   196	    return (script is not None and len(argv) >= 6 and
   197	            os.path.basename(argv[0]) == b"bash" and argv[1] == b"-c" and
   198	            argv[2] == ("\n" + script).encode() and argv[3] == b"_" and
   199	            argv[4] == name.encode())
