   258	def provenance(pid, procs, records, known_jobs=None):
   259	    job_id = (procs[pid]["job_id"] if "job_id" in procs[pid]
   260	              else marker_value(pid, "GEMMA_JOB_ID"))
   261	    if watchdog_id(job_id):
   262	        return False
   263	    if job_id is not None:
   264	        return True
   265	    boot_id = current_boot_id()
   266	    records = [r for r in records if same_boot(r, boot_id)]
   267	    known_jobs = {k: j for k, j in (known_jobs or {}).items() if same_boot(j, boot_id)}
   268	    identity = procs[pid]["starttime"]
   269	    if any(j["known_members"].get(pid) == identity for j in (known_jobs or {}).values()):
   270	        return True
   271	    lineage = [pid] + ancestors(pid, procs)
   272	    return any(r["pid"] in lineage for r in records)
