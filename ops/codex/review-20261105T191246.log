   281	def find_jobs(procs, args, self_pids, records=None, known_jobs=None):
   282	    """Require positive provenance and classify every recipient independently."""
   283	    records = running_jobs() if records is None else records
   284	    boot_id = current_boot_id()
   285	    records = [r for r in records if same_boot(r, boot_id)]
   286	    known_jobs = {k: j for k, j in (known_jobs or {}).items() if same_boot(j, boot_id)}
   287	    verified = verified_records(procs, records)
   288	    known = {(p, start): j for j in (known_jobs or {}).values()
   289	             for p, start in j["known_members"].items()}
   290	    protected = protected_watchdogs(procs, records)
   291	    jobs = {}
   292	    # Carry history independently of eligible-member traversal order. In particular,
   293	    # an exec to node must not erase a live legacy identity, even if no member is
   294	    # eligible this poll. Only members/pids/RSS describe current eligible recipients.
   295	    for key, previous in (known_jobs or {}).items():
   296	        if any(p in procs and procs[p]["starttime"] == start
   297	               for p, start in previous["known_members"].items()):
   298	            jobs[key] = {**previous, "pids": [], "members": {}, "rss": 0,
   299	                         "records": records, "known_members": dict(previous["known_members"])}
   300	    for p, d in procs.items():
   301	        if not eligible(p, procs, args, protected, verified, known_jobs):
   302	            continue
   303	        job_id = marker_value(p, "GEMMA_JOB_ID")
   304	        record = None
   305	        previous = known.get((p, d["starttime"])) if job_id is None else None
   306	        if job_id is not None:
   307	            # Bytes equality, never a prefix/substring/regex match. Identity takes
   308	            # precedence over PGID, ancestry, and the eligibility marker's value.
   309	            record = next((r for r in records if r.get("job_id") == job_id), None)
   310	            key = ("job_id", job_id)
   311	        elif previous:
   312	            key = previous["key"]
   313	        else:
   314	            lineage = [p] + ancestors(p, procs)
   315	            record = next((r for r in verified if r["pid"] in lineage), None)
   316	            if record is None:
   317	                continue  # The job-ID marker may have disappeared since eligibility.
   318	            key = ("job", record["pid"], procs[record["pid"]]["starttime"])
   319	        root = record["pid"] if record else p
   320	        if previous:
   321	            root = previous["root"]
   322	        j = jobs.setdefault(key, {"key": key, "root": root, "name": record["name"] if record else job_name(root, procs, records),
   323	                                  "pids": [], "members": {}, "rss": 0, "records": records,
   324	                                  "boot_id": boot_id, "known_members": dict(previous["known_members"]) if previous else {}})
   325	        if previous:
   326	            j["name"] = previous["name"]
   327	            for member, start in previous["known_members"].items():
   328	                j["known_members"].setdefault(member, start)
   329	        j["known_members"][p] = d["starttime"]
   330	        j["pids"].append(p)
   331	        j["members"][p] = d
   332	        j["rss"] += d["rss"]
   333	    # Exclude the watchdog's whole job, including siblings, rather than only its pid.
   334	    for key, j in list(jobs.items()):
   335	        if (set(j["pids"]) & (self_pids | protected) or j["root"] in self_pids | protected or
   336	                (j["name"] is not None and j["name"].startswith("memguard"))):
   337	            del jobs[key]
   338	    targets = {p: d for j in jobs.values() for p, d in j["members"].items()}
   339	    return targets, jobs
