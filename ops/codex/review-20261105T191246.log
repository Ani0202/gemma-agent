   187	def wrapper_script():
   188	    source = read(os.path.join(REPO, "bin/job")) or ""
   189	    prefix = "GEMMA_JOB_CAP=$cap setsid nohup bash -c '\n"
   190	    suffix = "    ' _ \"$name\""
   191	    return source.split(prefix, 1)[1].split(suffix, 1)[0] if prefix in source and suffix in source else None
