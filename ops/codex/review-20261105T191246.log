   406	def raise_oom_adj(targets, dry, args, known_jobs=None):
   407	    n = 0
   408	    if dry:
   409	        return n
   410	    for p, d in targets.items():
   411	        # Opening first pins the proc file to this process, even if its numeric pid is reused.
   412	        try:
   413	            with open(f"/proc/{p}/oom_score_adj", "w") as f:
   414	                if action_eligible(d, args, known_jobs):
   415	                    f.write("1000")
   416	                    n += 1
   417	        except OSError:
   418	            pass
   419	    return n
