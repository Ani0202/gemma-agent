   275	def eligible(pid, procs, args, protected=(), records=(), known_jobs=None):
   276	    d = procs[pid]
   277	    return (pid not in protected and d["uid"] == UID and d["state"] not in {"Z", "X"} and
   278	            not is_session(pid, procs) and provenance(pid, procs, records, known_jobs))
