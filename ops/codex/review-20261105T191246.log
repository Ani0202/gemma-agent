   108	def descendants(root, procs):
   109	    kids = {}
   110	    for d in procs.values():
   111	        kids.setdefault(d["ppid"], []).append(d["pid"])
   112	    out, stack = [], [root]
   113	    while stack:
   114	        for c in kids.get(stack.pop(), []):
   115	            if c not in out:
   116	                out.append(c); stack.append(c)
   117	    return out
