    for name in ['native-1-cp312-cp312-manylinux_2_17_x86_64.whl',
                 'native-2-cp313-cp313-manylinux_2_17_x86_64.whl',
                 'native-3-cp312-cp312-win_amd64.whl', 'pure-1-py3-none-any.whl']:
