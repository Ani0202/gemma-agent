#!/usr/bin/env bash
# Stage a self-contained private GPU timing or CPU setup kernel. --dry-run never invokes Kaggle.
set -euo pipefail
dry_run=false
skip_verification=1
stock_probe=1
seed_max=0
while [[ ${1:-} == --dry-run || ${1:-} == --with-verification || ${1:-} == --no-stock-probe || ${1:-} == --seed-max ]]; do
  case $1 in
    --dry-run) dry_run=true ;;
    --with-verification) skip_verification=0 ;;
    --no-stock-probe) stock_probe=0 ;;
    --seed-max) seed_max=${2:?--seed-max SECONDS}; [[ $seed_max =~ ^[0-9]+$ ]] || { echo '--seed-max takes whole seconds' >&2; exit 2; }; shift ;;
  esac
  shift
done
setup_only=0
setup_fix=1
if [[ ${1:-} == --setup-only ]]; then
  setup_only=1
  setup_fix=${2:?SETUP_FIX required}
  [[ $setup_fix == 0 || $setup_fix == 1 ]] || { echo 'SETUP_FIX must be 0 or 1' >&2; exit 2; }
  shift 2
  [[ $# -ge 2 && $# -le 3 ]] || { echo 'Usage: timing_push.sh [--dry-run] [--with-verification] [--no-stock-probe] --setup-only SETUP_FIX USER/SLUG IDS_FILE [BUDGET_SECONDS]' >&2; exit 2; }
  set -- "$1" - "$2" "${3:-1800}"
fi
if [[ $# -lt 3 || $# -gt 4 || ! $1 =~ ^[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$ ]]; then
  echo "Usage: $0 [--dry-run] [--with-verification] [--no-stock-probe] [--seed-max SECONDS] KAGGLE_USER/SLUG BUNDLE_DIR IDS_FILE [BUDGET_SECONDS]" >&2
  exit 2
fi
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
stage_dir=$(mktemp -d /tmp/timing-kernel-push.XXXXXX)
# Dry runs retain the generated artifact for inspection.
if ! $dry_run; then trap 'rm -rf -- "$stage_dir"' EXIT; fi
budget=${4:-10800}
python3 - "$script_dir" "$stage_dir" "$1" "$2" "$3" "$budget" "$setup_only" "$setup_fix" "$skip_verification" "$stock_probe" "$seed_max" <<'PY'
import ast
import base64
import gzip
import hashlib
import io
import json
from pathlib import Path
import re
import subprocess
import sys
import tarfile

source, stage = map(Path, sys.argv[1:3])
kernel_id, bundle_arg, ids_arg, budget_arg, setup_only_arg, setup_fix_arg, skip_verification_arg, stock_probe_arg, seed_max_arg = sys.argv[3:]
setup_only = setup_only_arg == "1"
bundle, ids_file = Path(bundle_arg).resolve(), Path(ids_arg)
budget = int(budget_arg)
if budget <= 0:
    raise ValueError('Budget must be positive')
ids = [s.strip() for s in ids_file.read_text().splitlines() if s.strip() and not s.lstrip().startswith('#')]
if not ids or len(ids) != len(set(ids)) or any(not re.fullmatch(r'[A-Za-z0-9_.-]+', s) for s in ids):
    raise ValueError('Nonempty unique safe task IDs required')
# PyYAML is not required on the push host. agent.yaml uses a scalar model declaration.
buf = io.BytesIO()
model = None
if not setup_only:
    models = set()
    for path in [bundle / 'agent.yaml', *sorted((bundle / 'sub_agents').rglob('*.yaml')), *sorted((bundle / 'sub_agents').rglob('*.yml'))]:
        for line in path.read_text().splitlines():
            match = re.fullmatch(r'\s*model:\s*[\'"]?(gemma-4-(?:31b|12b|e4b|e2b)-it-qat-w4a16-ct)[\'"]?\s*(?:#.*)?', line)
            if match:
                models.add(match[1])
    if len(models) != 1:
        raise ValueError('Expected one allowed scalar model declaration')
    model = models.pop()
    buf = io.BytesIO()
    with gzip.GzipFile(fileobj=buf, mode='wb', mtime=0) as gz:
        with tarfile.open(fileobj=gz, mode='w') as tf:
            for path in sorted(bundle.rglob('*')):
                if path.is_symlink() or not (path.is_file() or path.is_dir()):
