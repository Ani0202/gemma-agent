     1	#!/usr/bin/env python3
     2	"""Plan 009 rev 2 IDENTITY checks ZIP + CONTENT (eval/plans/009.md, IDENTITY block).
     3	
     4	ZIP:     sha256(dist/31b-<v>.zip) == the 'zip sha256:' line of bundles/31b/<v>/MANIFEST.md.
     5	CONTENT: zip member paths + per-file sha256 == files under bundles/31b/<v>/, excluding ONLY the
     6	         root MANIFEST.md of the source dir (bin/pack strips it from the zip by design).
     7	Also records sha256 of agent.yaml inside the zip (header agent_yaml_sha256 must equal it).
     8	TRANSPORT is a separate check made at push time (journaled); it is not computed here.
     9	
    10	Usage: eval/plan009_identity.py v012 [v013 ...] [--out results/plan009_bundle_identity.json] [--event smoke|main|chunkN]
    11	Exit 0 iff every requested bundle passes ZIP and CONTENT. Appends one record per call to the output file.
    12	"""
    13	import argparse, datetime, hashlib, json, os, re, subprocess, sys, zipfile
    14	
    15	ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    16	SCHEMA = ("plan009_bundle_identity v2 (records made before v2 lack duplicate_members): records[] each {utc, git_sha, event, bundles{<v>: {zip_path, zip_sha256, "
    17	          "manifest_zip_sha256, zip_ok, content_ok, only_in_zip[], only_in_dir[], byte_mismatch[], duplicate_members[], excluded[], "
    18	          "agent_yaml_sha256, pass}}}")
    19	
    20	
    21	def sha(b):
    22	    return hashlib.sha256(b).hexdigest()
    23	
    24	
    25	def check(v):
    26	    bdir = os.path.join(ROOT, "bundles", "31b", v)
    27	    zpath = os.path.join(ROOT, "dist", f"31b-{v}.zip")
    28	    man = open(os.path.join(bdir, "MANIFEST.md")).read()
    29	    m = re.search(r"zip sha256:\s*([0-9a-f]{64})", man)
    30	    manifest_sha = m.group(1) if m else None
    31	    with open(zpath, "rb") as f:
    32	        zsha = sha(f.read())
    33	    zfiles = {}
    34	    dup = []
    35	    with zipfile.ZipFile(zpath) as z:
    36	        for info in z.infolist():
    37	            if info.is_dir():
    38	                continue
    39	            if info.filename in zfiles:
    40	                dup.append(info.filename)  # duplicate member names could hide unmatched bytes
    41	            zfiles[info.filename] = sha(z.read(info))
    42	    dup = sorted(set(dup))
    43	    dfiles = {}
    44	    for dp, dn, fn in os.walk(bdir):
    45	        for n in fn:
    46	            full = os.path.join(dp, n)
    47	            rel = os.path.relpath(full, bdir).replace(os.sep, "/")
    48	            with open(full, "rb") as f:
    49	                dfiles[rel] = sha(f.read())
    50	    excluded = []
    51	    if "MANIFEST.md" in dfiles:
    52	        del dfiles["MANIFEST.md"]
    53	        excluded.append("MANIFEST.md")
    54	    only_z = sorted(set(zfiles) - set(dfiles))
    55	    only_d = sorted(set(dfiles) - set(zfiles))
    56	    mism = sorted(p for p in set(zfiles) & set(dfiles) if zfiles[p] != dfiles[p])
    57	    zip_ok = manifest_sha is not None and manifest_sha == zsha
    58	    content_ok = not (only_z or only_d or mism or dup)
    59	    return {"zip_path": os.path.relpath(zpath, ROOT), "zip_sha256": zsha, "manifest_zip_sha256": manifest_sha,
    60	            "zip_ok": zip_ok, "content_ok": content_ok, "only_in_zip": only_z, "only_in_dir": only_d,
    61	            "byte_mismatch": mism, "duplicate_members": dup, "excluded": excluded, "agent_yaml_sha256": zfiles.get("agent.yaml"),
    62	            "pass": zip_ok and content_ok and "agent.yaml" in zfiles}
    63	
    64	
    65	def main():
    66	    ap = argparse.ArgumentParser()
    67	    ap.add_argument("versions", nargs="+")
    68	    ap.add_argument("--out", default=os.path.join(ROOT, "results", "plan009_bundle_identity.json"))
    69	    ap.add_argument("--event", default="check")
    70	    a = ap.parse_args()
    71	    git = subprocess.run(["git", "-C", ROOT, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    72	    rec = {"utc": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "git_sha": git,
    73	           "event": a.event, "bundles": {v: check(v) for v in a.versions}}
    74	    data = {"_schema": SCHEMA, "records": []}
    75	    if os.path.exists(a.out):
    76	        old = json.load(open(a.out))
    77	        if not isinstance(old, dict) or not isinstance(old.get("records"), list):
    78	            sys.exit(f"ERROR: {a.out} is not a records file; refusing to overwrite")
    79	        data["records"] = old["records"]  # _schema is always rewritten to the current SCHEMA
    80	    data["records"].append(rec)
    81	    with open(a.out, "w") as f:
    82	        json.dump(data, f, indent=1)
    83	        f.write("\n")
    84	    ok = all(b["pass"] for b in rec["bundles"].values())
    85	    for v, b in rec["bundles"].items():
    86	        print(f"{v}: zip_ok={b['zip_ok']} content_ok={b['content_ok']} agent_yaml={b['agent_yaml_sha256']} pass={b['pass']}")
    87	    print("PASS" if ok else "FAIL")
    88	    sys.exit(0 if ok else 1)
    89	
    90	
    91	if __name__ == "__main__":
    92	    main()

