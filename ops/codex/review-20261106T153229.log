   603	@pytest.mark.parametrize('change', ['different_zip', 'manifest_mismatch', 'manifest_missing',
   604	                                  'manifest_unparseable', 'nonempty_list', 'not_list'])
   605	def test_registered_zip_proof(full_pair, change):
   606	    dirs, off, cs, opts, _ = full_pair
   607	    if change.startswith('manifest_'):
   608	        path = m.BUNDLES_ROOT / 'v012/MANIFEST.md'
   609	        if change == 'manifest_missing':
   610	            path.unlink()
   611	        else:
   612	            path.write_text('zip sha256: ' + ('e'*64 if change == 'manifest_mismatch' else 'invalid'))
   613	    else:
   614	        def mutate(rs):
   615	            proof = rs[1]['bundles']['v012']
   616	            if change == 'different_zip':
   617	                proof.update(zip_sha256='e'*64, manifest_zip_sha256='e'*64)
   618	            else:
   619	                proof['duplicate_members'] = ['agent.yaml'] if change == 'nonempty_list' else ''
   620	        edit_identity(opts, mutate)
   621	    result = m.arm3_metrics('arm2', dirs, off, cs, **opts)
   622	    assert result['decision'] == 'INVALID (identity mismatch)'
   623	    path = m.BUNDLES_ROOT / 'v012/MANIFEST.md'
   624	    if path.is_file():
   625	        assert result['_schema']['input_shas'][str(path)] == m.base.sha(path)
