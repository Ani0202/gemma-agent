   311	def rewrite_timing(directory, classifiers, edit):
   312	    timing = Path(directory) / 'timing.jsonl'
   313	    records = [json.loads(line) for line in timing.read_text().splitlines()]
   314	    edit(records)
   315	    timing.write_text('\n'.join(map(json.dumps, records)) + '\n')
   316	    for file in classifiers[directory]:
   317	        data = json.loads(Path(file).read_text())
   318	        data['input_sha256'] = m.base.sha(timing)
   319	        Path(file).write_text(json.dumps(data))
