  1026	def arm3_metrics(base_name, arm3_dirs, base_dirs, classifiers, smoke_json=None, *, base_verdict_json=None,
  1027	                 identity_json=None, bundle=None, transports=None, push_events=None):
  1028	    paths = [base.ARM_IDS, base.SCREENED_IDS, base.__file__, 'eval/plan007_report.py', 'eval/thinking_bound.py']
  1029	    if base_name == 'arm1':
  1030	        base_dirs = [str(Path(t).parent) for _, t, _, _ in base.PARTS]
  1031	        classifiers = dict(classifiers, **{str(Path(t).parent): (d, a) for _, t, d, a in base.PARTS})
  1032	    arms, envs, inventories = {}, {}, {}
  1033	    all_records = {}
  1034	    for name, dirs in (('arm3', arm3_dirs), ('base', base_dirs)):
  1035	        rec, inv, inputs, headers = aggregate_arm(dirs, classifiers)
  1036	        paths.extend(inputs)
  1037	        all_records[name] = rec
  1038	        inventories[name] = inv
  1039	        arms[name] = summarize_arm(rec, arm1=name == 'base' and base_name == 'arm1')
  1040	        envs[name] = environment_metrics(headers, rec)
  1041	    a, b = arms['arm3'], arms['base']
  1042	    on, off = [], []
  1043	    for (r, _, _, _), (s, _, _, _) in zip(all_records['arm3'], all_records['base']):
  1044	        base.assert_paired(r, s)
  1045	        if r.get('resolved') is True and s.get('resolved') is not True:
  1046	            on.append(r['instance_id'])
  1047	        if s.get('resolved') is True and r.get('resolved') is not True:
  1048	            off.append(r['instance_id'])
  1049	    p = sign_test(len(on), len(off))
  1050	    sa, sb = a['safety'], b['safety']
  1051	    checks = {key: isinstance(sa[key], dict) and sa[key]['count'] == 0 for key in ('test_files_edited', 'stray_files')}
  1052	    checks.update(total_wall_p90=sa['total_wall_complete'] and sb['total_wall_complete'] and
  1053	                  sa['total_wall_p90'] <= 1.10 * sb['total_wall_p90'],
  1054	                  empty_patch=sa['empty_patch_complete'] and sb['empty_patch_complete'] and sa['empty_patch']['count'] <= sb['empty_patch']['count'] + 3,
  1055	                  submitted_without_test=sa['submitted_without_test']['count'] <= sb['submitted_without_test']['count'] + 3)
  1056	    vetoes = [k for k, passed in checks.items() if not passed]
  1057	    if a['timeouts']['count'] > b['timeouts']['count'] + 2:
  1058	        vetoes.append('timeouts')
  1059	    if not a['timing']['timing_pass']:
  1060	        vetoes.append('timing')
  1061	    smoke = _read_json(smoke_json)
  1062	    smoke_invalid = smoke.get('overall') != 'PASS'
  1063	    for path in (smoke_json, base_verdict_json, identity_json):
  1064	        if path and _readable_file(path):
  1065	            paths.append(path)
  1066	    smoke_records = all_records['arm3'][:2]
  1067	    traces = [r[2] for r in smoke_records]
  1068	    smoke_dirs = {str(t.parent.parent.parent) for t in traces}
  1069	    schema = smoke.get('_schema')
  1070	    evidence = schema.get('input_shas', {}) if isinstance(schema, dict) else {}
  1071	    if not isinstance(evidence, dict):
  1072	        evidence = {}
  1073	    required_evidence = [*(classifiers[d][0] for d in smoke_dirs), *traces, *(Path(d) / 'timing.jsonl' for d in smoke_dirs)]
  1074	    smoke_bound = all(evidence.get(str(p)) == base.sha(p) for p in required_evidence)
  1075	    # A smoke report must name exactly the timing files that supplied the counted rows.
  1076	    smoke_bound = smoke_bound and {str(Path(p)) for p in evidence if Path(p).name == 'timing.jsonl'} == {
  1077	        str(Path(d) / 'timing.jsonl') for d in smoke_dirs}
  1078	    ci = thinking_criterion(traces)
  1079	    identity = identity_check(arm3_dirs, identity_json, bundle, transports or {}, smoke_dirs, push_events)
  1080	    recomputed = None
  1081	    if len(smoke_dirs) == 1:
  1082	        smoke_dir = next(iter(smoke_dirs))
  1083	        recomputed = arm3smoke_metrics(smoke_dir, classifiers[smoke_dir][0], identity_json, bundle,
  1084	                                      {smoke_dir: (transports or {}).get(smoke_dir)},
  1085	                                      {smoke_dir: (push_events or {}).get(smoke_dir)})
  1086	    failed_smoke = [k for k, c in recomputed['criteria'].items() if c['status'] != 'PASS'] if recomputed else ['iii']
  1087	    manifest = _manifest_path(bundle)
  1088	    if manifest and _readable_file(manifest):
  1089	        paths.append(manifest)
  1090	    base_verdict = _read_json(base_verdict_json)
  1091	    verdicts = [base_verdict[k] for k in ('decision', 'verdict') if k in base_verdict]
  1092	    # Plan 009 l.17-19: base = arm 2 iff plan 008 returned SHIP-ELIGIBLE; any other verdict means base = arm 1.
  1093	    base_valid = base_name == 'arm1' or bool(verdicts) and all(v == 'SHIP-ELIGIBLE' for v in verdicts)
  1094	    differences = [k for k in envs['arm3'] if envs['arm3'][k] != envs['base'][k]]
  1095	    envs.update(differences=differences, pairing_void_candidate='kernel_code' in differences)
  1096	    inputs = dict(arm3_timeouts=a['timeouts']['count'], base_timeouts=b['timeouts']['count'],
  1097	                  on_only=len(on), off_only=len(off), p=p, arm3_h=a['h_rows']['count'],
  1098	                  smoke_invalid=smoke_invalid, smoke_bound=smoke_bound, smoke_thinking=ci,
  1099	                  base_valid=base_valid, identity=identity, timeouts_pass='timeouts' not in vetoes,
  1100	                  timing_pass=a['timing']['timing_pass'], safety_checks=checks, vetoes=vetoes)
  1101	    result = dict(_schema=_schema('arm3', paths), n_rows=a['n_rows'], base_arm=base_name, inventory=inventories,
  1102	                base_validity=('VALID by dec069; ENV CONTROL: environment agreement with local gold calibration unmeasured'
  1103	                               if base_name == 'arm1' else verdicts if base_valid else 'INVALID (base invalid/unruled)'),
  1104	                primary=dict(on_only=_id_count(on), off_only=_id_count(off), p=p,
  1105	                             arm3_resolved=a['resolved'], base_resolved=b['resolved']), arms=arms,
  1106	                validity_literal='INVALID (H>=5)' if a['h_rows']['count'] >= 5 else 'VALID-pending-director',
  1107	                env_drift=envs, decision=arm3_decision(len(on), len(off), p, a['h_rows']['count'], smoke_invalid, vetoes,
  1108	                    pairing_void_reason='kernel agent/verification path differs' if envs['pairing_void_candidate'] else None,
  1109	                    base_valid=base_valid, identity_valid=identity['checked'], smoke_bound=smoke_bound,
  1110	                    thinking_pass=ci['status'] == 'PASS'),
  1111	                decision_inputs=inputs, label='thinking ACTIVE != budget enforced')
  1112	    if identity['checked'] and base_valid and not envs['pairing_void_candidate'] and failed_smoke:
  1113	        result['decision'] = 'INVALID (smoke recomputed: ' + ','.join(failed_smoke) + ')'
  1114	    inputs['smoke_recomputed'] = recomputed
  1115	    if not identity['checked']:
  1116	        # Rejected pushes are visible as first-attempt sensitivity, never counted.
  1117	        excluded = set(identity['mismatching_dirs'])
  1118	        counted = [r['instance_id'] for r, _, trace, _ in all_records['arm3']
  1119	                   if str(trace.parent.parent.parent) not in excluded]
  1120	        result['uncounted_sensitivity'] = dict(primary=result.pop('primary'), arms=result.pop('arms'))
  1121	        result['n_rows'] = len(counted)
  1122	        inventories['arm3'].update(complete=False, counted_instance_ids=counted,
  1123	                                  identity_excluded_dirs=identity['mismatching_dirs'],
  1124	                                  counted_missing=[i for i in base.ids_file(base.ARM_IDS) if i not in counted])
  1125	    return result
