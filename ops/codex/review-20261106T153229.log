  1209	def main(argv=None):
  1210	    argv = sys.argv if argv is None else argv
  1211	    if len(argv) > 1 and argv[1] in ('arm3', 'arm3smoke'):
  1212	        return arm3_cli(argv)
  1213	    if len(argv) == 3 and argv[1] == 'base':
  1214	        out = base_metrics()
  1215	    elif len(argv) == 4 and argv[1] in ('smoke', 'arm2'):
  1216	        try:
  1217	            out = (smoke_metrics if argv[1] == 'smoke' else arm2_metrics)(argv[2])
  1218	        except IncompleteRun as e:
  1219	            print('INCOMPLETE arm2 inventory; no results written:', json.dumps(e.args[0]))
  1220	            return 3
  1221	        except GateResponseInBuiltinRun as e:
  1222	            print('STOP: gate-authored submit_patch response in builtin arm2 run (dec 077); '
  1223	                  'no results written; report to Director:', json.dumps(e.args[0]))
  1224	            return 4
  1225	    else:
  1226	        print(__doc__)
  1227	        return 2
  1228	    Path(argv[-1]).write_text(json.dumps(out, indent=2) + '\n')
  1229	    print(json.dumps(out.get('totals', dict(n_rows=out['n_rows'], overall=out.get('overall')))))
  1230	    return 0
