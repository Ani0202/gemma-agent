  1128	def arm3_cli(argv):
  1129	    import argparse
  1130	    parser = argparse.ArgumentParser(description='Plan 009 CPU/offline metrics')
  1131	    parser.add_argument('mode', choices=['arm3', 'arm3smoke'])
  1132	    parser.add_argument('--identity-json', required=True)
  1133	    parser.add_argument('--bundle', required=True)
  1134	    parser.add_argument('--transport', action='append', required=True)
  1135	    parser.add_argument('--push-event', action='append', required=True)
  1136	    def transports_for(args, dirs):
  1137	        transports = {}
  1138	        for value in args.transport:
  1139	            if '=' not in value:
  1140	                parser.error('--transport requires DIR=SHA256')
  1141	            directory, sha = value.rsplit('=', 1)
  1142	            if not re.fullmatch('[0-9a-f]{64}', sha):
  1143	                parser.error('--transport requires a SHA256')
  1144	            if str(Path(directory)) in transports:
  1145	                parser.error('duplicate --transport dir')
  1146	            transports[str(Path(directory))] = sha
  1147	        if set(transports) != {str(Path(d)) for d in dirs}:
  1148	            parser.error('--transport required for every arm3 dir')
  1149	        if not re.fullmatch(r'v01[0-9]+', args.bundle):
  1150	            parser.error('--bundle requires v01N')
  1151	        return transports
  1152	    def events_for(args, dirs):
  1153	        events = {}
  1154	        for value in args.push_event:
  1155	            if '=' not in value:
  1156	                parser.error('--push-event requires DIR=EVENT')
  1157	            directory, event = value.rsplit('=', 1)
  1158	            directory = str(Path(directory))
  1159	            if directory in events:
  1160	                parser.error('duplicate --push-event dir')
  1161	            events[directory] = event
  1162	        errors = _push_errors(dirs, events, {d for d, e in events.items() if e == 'smoke'}, args.mode == 'arm3smoke')
  1163	        if errors:
  1164	            parser.error('; '.join(errors))
  1165	        return events
  1166	    if argv[1] == 'arm3smoke':
  1167	        parser.add_argument('run_dir')
  1168	        parser.add_argument('classifier')
  1169	        parser.add_argument('out_json')
  1170	        args = parser.parse_args(argv[1:])
  1171	        out = arm3smoke_metrics(args.run_dir, args.classifier, args.identity_json, args.bundle,
  1172	                                 transports_for(args, [args.run_dir]), events_for(args, [args.run_dir]))
  1173	    else:
  1174	        parser.add_argument('base', choices=['arm1', 'arm2'])
  1175	        parser.add_argument('out_json')
  1176	        parser.add_argument('--arm3', nargs='+', required=True)
  1177	        parser.add_argument('--base-dirs', nargs='+', default=[])
  1178	        parser.add_argument('--classifiers', action='append', default=[])
  1179	        parser.add_argument('--smoke-json', required=True)
  1180	        parser.add_argument('--base-verdict-json')
  1181	        args = parser.parse_args(argv[1:])
  1182	        classifiers = {}
  1183	        for value in args.classifiers:
  1184	            if '=' not in value:
  1185	                parser.error('--classifiers requires DIR=D4_JSON,A2_JSON')
  1186	            directory, pair = value.split('=', 1)
  1187	            files = pair.split(',')
  1188	            if len(files) != 2:
  1189	                parser.error('--classifiers requires DIR=D4_JSON,A2_JSON')
  1190	            classifiers[str(Path(directory))] = files
  1191	        required = args.arm3 + (args.base_dirs if args.base == 'arm2' else [])
  1192	        if any(str(Path(d)) not in classifiers for d in required):
  1193	            parser.error('--classifiers required for every arm3 and arm2-base dir')
  1194	        if args.base == 'arm2' and not args.base_dirs:
  1195	            parser.error('--base-dirs required for arm2')
  1196	        try:
  1197	            out = arm3_metrics(args.base, args.arm3, args.base_dirs, classifiers, args.smoke_json,
  1198	                               base_verdict_json=args.base_verdict_json, identity_json=args.identity_json,
  1199	                               bundle=args.bundle, transports=transports_for(args, args.arm3),
  1200	                               push_events=events_for(args, args.arm3))
  1201	        except IncompleteRun as exc:
  1202	            print('INCOMPLETE arm3 inventory; no results written:', json.dumps(exc.args[0]))
  1203	            return 3
  1204	    Path(args.out_json).write_text(json.dumps(out, indent=2) + '\n')
  1205	    print(json.dumps({k: out[k] for k in ('n_rows', 'decision', 'overall', 'verdict') if k in out}))
