   689	def arm3_timing(rows):
   690	    bad = []
   691	    for row in rows:
   692	        fields = [k for k, limit in (('agent_clock_seconds', 220), ('finalization_seconds', 30))
   693	                  if not _finite_number(row.get(k)) or row[k] > limit]
   694	        if fields:
   695	            bad.append(dict(instance_id=row['instance_id'], fields=fields))
   696	    return dict(violations=bad, timing_pass=not bad)
