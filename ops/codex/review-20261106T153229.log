   861	    ciii = dict(status='FAIL' if inv['extra'] or inv['duplicates'] or identity_conflict or not checked_identity['checked'] or hs else
   862	                'UNVERIFIABLE' if missing else 'PASS', h_rows=hs, identity_headers=identity,
   863	                identity=checked_identity, vllm_up=vllm_up)
   864	    criteria = dict(i=ci, ii=cii, iii=ciii)
   865	    overall = 'PASS' if all(c['status'] == 'PASS' for c in criteria.values()) else 'FAIL'
   866	    return dict(_schema=_schema('arm3smoke', paths), n_rows=len(rows), inventory=inv,
   867	                criteria=criteria, overall=overall,
   868	                verdict='INVALID (smoke i)' if ci['status'] != 'PASS' else overall,
   869	                label='thinking ACTIVE != budget enforced')
