   642	@pytest.mark.parametrize('criterion', ['h', 'timing', 'startup', 'verification'])
   643	def test_recompute_full_smoke(full_pair, criterion):
   644	    dirs, off, cs, opts, _ = full_pair
   645	    if criterion == 'h':
   646	        path = Path(cs[dirs[0]][0])
   647	        data = json.loads(path.read_text()); data['rows'][0]['h'] = 'H'
   648	        path.write_text(json.dumps(data))
   649	    else:
   650	        def mutate(rs):
   651	            if criterion == 'timing':
   652	                rs[1]['agent_clock_seconds'] = 221
   653	            elif criterion == 'startup':
   654	                rs.pop()
   655	            else:
   656	                rs[1]['resolved'] = None
   657	        rewrite_timing(dirs[0], cs, mutate)
   658	    # Bind the modified inputs to isolate current mechanics from saved-json binding.
   659	    smoke = json.loads(Path(opts['smoke_json']).read_text())
   660	    for path in (str(Path(dirs[0]) / 'timing.jsonl'), cs[dirs[0]][0]):
   661	        smoke['_schema']['input_shas'][path] = m.base.sha(path)
   662	    Path(opts['smoke_json']).write_text(json.dumps(smoke))
   663	    result = m.arm3_metrics('arm2', dirs, off, cs, **opts)
   664	    assert result['decision'].startswith('INVALID (smoke recomputed:')
   665	    kwargs = {k: opts[k] for k in ('identity_json', 'bundle')}
   666	    kwargs.update(transports={dirs[0]: opts['transports'][dirs[0]]}, push_events={dirs[0]: 'smoke'})
   667	    assert m.arm3smoke_metrics(dirs[0], cs[dirs[0]][0], **kwargs)['overall'] == 'FAIL'
