  1005	def arm3_decision(on, off, p, h_count, smoke_invalid, vetoes, *, pairing_void_reason=None,
  1006	                  base_valid=True, identity_valid=True, smoke_bound=True, thinking_pass=True):
  1007	    if pairing_void_reason:
  1008	        return 'INVALID (pairing voided: ' + pairing_void_reason + ')'
  1009	    if not base_valid:
  1010	        return 'INVALID (base invalid/unruled)'
  1011	    if not identity_valid:
  1012	        return 'INVALID (identity mismatch)'
  1013	    if not thinking_pass:
  1014	        return 'INVALID (smoke i)'
  1015	    if not smoke_bound:
  1016	        return 'INVALID (smoke evidence not bound)'
  1017	    if smoke_invalid or h_count >= 5:
  1018	        return 'INVALID'
  1019	    if off >= on:
  1020	        return 'KEEP-OFF'
  1021	    if p >= .2:
  1022	        return 'NO-DIFFERENCE'
  1023	    return 'ON-BETTER-VETOED' if vetoes else 'ON-ADOPT'
