   974	def environment_metrics(headers, records):
   975	    aliases = dict(docker_image_digest=('docker_image_digest', 'docker_image'),
   976	                   vllm_version=('vllm_version',), google_adk_version=('google_adk_version', 'google-adk'),
   977	                   swegemma_version=('swegemma_version',), model_id=('model_id', 'model'),
   978	                   gpu_names=('gpu_names',), gpu_count=('gpu_count',))
   979	    def values(keys):
   980	        vals = []
   981	        for h in headers:
   982	            val = next((h[k] for k in keys if k in h), None)
   983	            if val not in vals:
   984	                vals.append(val)
   985	        return vals[0] if len(vals) == 1 else vals or None
   986	    out = {key: values(keys) for key, keys in aliases.items()}
   987	    for package in ('vllm', 'google-adk', 'swegemma'):
   988	        key = package.replace('-', '_') + '_version'
   989	        if out[key] is None:
   990	            values_from_versions = []
   991	            for h in headers:
   992	                val = (h.get('versions') or {}).get(package)
   993	                if val not in values_from_versions:
   994	                    values_from_versions.append(val)
   995	            out[key] = values_from_versions[0] if len(values_from_versions) == 1 else values_from_versions or None
   996	    for field, wall in (('setup_wall_p50_p90', None), ('verification_wall_p50_p90', 'verification')):
   997	        out[field] = _quantiles([r.get('sandbox_setup_seconds') if wall is None else
   998	                                 (r.get('wall_seconds') or {}).get(wall) for r, _, _, _ in records])
   999	    kernel_keys = sorted({k for h in headers for k in h if k.startswith('kernel_code') or
  1000	                          (('agent' in k or 'verification' in k) and ('sha' in k) and k != 'agent_yaml_sha256')})
  1001	    out['kernel_code'] = {k: values((k,)) for k in kernel_keys} or None
  1002	    return out
