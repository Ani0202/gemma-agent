   225	    seen = set()
   226	    with path.open() as stream:
   227	        for number, line in enumerate(stream, 1):
   228	            if not line.strip():
   229	                continue
   230	            iid = json.loads(line)['instance_id']
   231	            if iid in seen:
   232	                raise ValueError(f'Duplicate inventory IDs at line {number}')
   233	            seen.add(iid)
