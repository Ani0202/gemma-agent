   291	def resolve_caps(defaults, args):
   292	    """Precedence: CLI flag > flat bundle key > nested bundle key (left to swegemma) > runner fallback."""
   293	    def nested(section, key):
   294	        value = defaults.get(section)
   295	        return value.get(key) if isinstance(value, dict) else None
   296	
   297	    caps = {}
   298	    for key, value, fallback, nested_value in [
   299	            ('max_tool_calls', args.max_tool_calls, None, None),
   300	            ('max_turns', args.max_turns, None, None),
   301	            ('max_time_minutes', args.session_minutes, 5, nested('budget', 'time_minutes')),
   302	            ('timeout_seconds', args.command_timeout, 60, nested('harness', 'command_timeout_seconds'))]:
   303	        if value is None:
   304	            value = defaults.get(key)
   305	        if value is None and nested_value is None:
   306	            value = fallback
   307	        caps[key] = value
   308	    return caps
