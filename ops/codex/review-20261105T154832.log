   266	def wheels_listing_sha(path):
   267	    listing = []
   268	    if path:
   269	        for p in sorted(Path(path).rglob('*')):
   270	            listing.append((p.relative_to(path).as_posix(), p.stat().st_size,
   271	                            str(p.resolve()) if p.is_symlink() else None))
   272	    return hashlib.sha256(json.dumps(listing, sort_keys=True).encode()).hexdigest()
