   311	def build_config(defaults, args, models, raw_dir, caps):
   312	    from swegemma import config as sc
   313	    from swegemma.budget import EvaluationBudget, HarnessLimits
   314	    names = {f.name for f in dataclasses.fields(sc.EvalConfig)}
   315	    for key in defaults.keys() - names:
   316	        logging.warning('Unknown EvalConfig key: %s', key)
   317	    options = {k: v for k, v in defaults.items() if k in names}
   318	    types = dict(budget=EvaluationBudget, harness=HarnessLimits,
   319	                 limits=sc.SubmissionLimits, generation_constraints=sc.GenerationConstraints,
   320	                 context_cache_config=sc.ContextCacheConfig,
   321	                 events_compaction_config=sc.EventsCompactionConfig,
   322	                 adapter_manifest=sc.AdapterManifest)
   323	    for key, cls in types.items():
   324	        if isinstance(options.get(key), dict):
   325	            options[key] = cls(**options[key])
   326	    paths = dict(tasks_path=args.data_dir / 'tasks.jsonl', snapshots_dir=args.data_dir / 'snapshots',
   327	                 wheels_dir=args.data_dir / 'wheels', results_dir=raw_dir, submission_dir=args.bundle)
   328	    # Explicit CLI runtime settings own these fields. Other bundle fields pass through.
   329	    options.update(paths, models=models, sandbox='subprocess', concurrency=args.concurrency,
   330	                   display_mode='quiet', **caps)
   331	    for key, fallback in [('graph_dir', 'graphs'), ('embeddings_dir', 'embeddings')]:
   332	        path = Path(options.get(key, fallback))
   333	        options[key] = str((path if path.is_absolute() else args.data_dir / path).resolve())
   334	    return sc.EvalConfig(**options)
