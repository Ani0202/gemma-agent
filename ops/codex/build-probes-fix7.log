"""Summarize a downloaded kaggle_timing_v1 journal without reading raw task artifacts."""
import argparse
import json
import math
from collections import Counter
from pathlib import Path


def distribution(values):
    values = sorted(values)
    def percentile(q):
        pos = (len(values) - 1) * q
        low = int(pos)
        return values[low] + (values[min(low + 1, len(values) - 1)] - values[low]) * (pos - low)
    return dict(mean=sum(values) / len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))


def retrying_lines(call):
    children = call.get('subprocesses', [])
    return max(call.get('retrying_lines', 0), sum(c.get('retrying_lines', 0) for c in children))


def fallback_invocations(call):
    return setup_evidence(call) - retrying_lines(call)


def setup_evidence(call):
    """Count index fallback invocations and retry lines, without counting nested output twice."""
    children = call.get('subprocesses', [])
    retries = max(call.get('retrying_lines', 0), sum(c.get('retrying_lines', 0) for c in children))
    fallbacks = 0
    for child in children or [call]:
        argv = child.get('argv') or []
        if isinstance(argv, str):
            import shlex
            argv = shlex.split(argv)
        fallbacks += int('install' in argv and '-e' in argv and '--no-index' not in argv)
    return retries + fallbacks


def summarize(path, *, gate_max_phase1=296, gate_mean_phase1=270,
              gate_vllm_seconds=600, gate_min_nonempty=1, gate_mode='total'):
    """gate_mode 'total' = dec 028 item 4 (a)-(e) on TOTAL Phase-1. gate_mode 'stock-path' = dec 034 item 2 as
    corrected by dec 036 item 1: (b) max(stockpath_phase1) <= cap x 60 + 37 s (cap from the header), where
    stockpath_phase1 = phase1_wall - image_emulation_seconds - setup_py_emulation_seconds; (c) not gated."""
    if gate_mode not in ('total', 'stock-path'):
        raise ValueError('gate_mode must be total or stock-path')
    records = [json.loads(line) for line in Path(path).read_text().splitlines() if line.strip()]
    if not records or records[0].get('_schema') != 'kaggle_timing_v1':
        raise ValueError('Expected kaggle_timing_v1 header')
    header, rows, startup, done, stopped = records[0], [], records[0].get('vllm_startup_seconds'), None, []
    artifact_errors = []
    for row in records[1:]:
        if 'instance_id' in row:
            rows.append(row)
        elif '_vllm' in row:
            startup = row['_vllm']['startup_seconds']
        elif '_done' in row:
            done = row['_done']
        elif '_stopped' in row:
            stopped.append(row['_stopped'])
        elif '_artifact_error' in row:
            artifact_errors.append(row['_artifact_error'])
        else:
            raise ValueError('Unknown journal record')
    ids = [r['instance_id'] for r in rows]
    if len(ids) != len(set(ids)) or set(ids) - set(header['task_ids']):
        raise ValueError('Duplicate or unexpected task records')
    if done is not None and done['n'] != len(rows):
        raise ValueError('Done count does not match task records')
    def numbers(values):
        if any(type(v) not in (int, float) or not math.isfinite(v) or v < 0 for v in values):
            raise ValueError('Invalid measurement')
        return values
    totals = distribution(numbers([r['wall_seconds']['total'] for r in rows]))
    shares = distribution(numbers([r.get('test_run', {}).get('share_of_agent_seconds') for r in rows if r.get('test_run', {}).get('share_of_agent_seconds') is not None]))
    runs = distribution(numbers([r.get('test_run', {}).get('n', 0) for r in rows]))
    caps = header.get('caps') or {}
    cap = caps.get('max_time_minutes')
    numbers([v for v in (startup, cap) if v is not None])
    timing_minutes = totals['p90'] * 125 / 60 + startup / 60 if totals['p90'] is not None and startup is not None else None
    cap_minutes = cap * 125 + 30 if cap is not None else None
    def setup_py_seconds(row):
        # Dec 036 item 1: the Dockerfile.public setup.py emulation step(s) in setup_calls (install_editable_package +
        # install_test_dependencies), which the stock subprocess path replaces with P1 stock_setup. Missing -> None.
        steps = [c.get('duration_s') for c in row.get('setup_calls', []) if c.get('step') == 'setup.py']
        return sum(steps) if steps and all(type(v) in (int, float) for v in steps) else None
    def stock_total(row):
        st = row.get('stock_setup') or {}
        return st.get('total_s') if type(st.get('total_s')) in (int, float) and not st.get('error') else None
    tasks = []
    for row in rows:
        setup_py = setup_py_seconds(row)
        stock_s = stock_total(row)
        parts = [row.get('agent_clock_seconds'), row.get('finalization_seconds'), stock_s]
        source_files = set(row.get('patch_files', [])) - set(row.get('test_files_edited', [])) - set(row.get('stray_files', []))
        tasks.append(dict(instance_id=row['instance_id'], repo=row.get('repo'),
            setup_calls=[{key: call.get(key) for key in ('step', 'duration_s', 'rc', 'retrying_lines')}
                         for call in row.get('setup_calls', [])],
            **{key: row.get(key) for key in ('sandbox_setup_seconds', 'agent_clock_seconds',
                'agent_timeout_fired', 'finalization_seconds', 'teardown_seconds',
                'phase1_wall_seconds', 'phase1_source', 'error', 'agent_outcome', 'fallback_patch_used',
                'image_emulation_seconds', 'setup_failed', 'editable_failed')},
            phase1_minus_image_seconds=(row['phase1_wall_seconds'] - row['image_emulation_seconds']
                if row.get('phase1_wall_seconds') is not None and row.get('image_emulation_seconds') is not None else None),
            setup_py_emulation_seconds=setup_py,
            stockpath_phase1_seconds=(row['phase1_wall_seconds'] - row['image_emulation_seconds'] - setup_py
                if row.get('phase1_wall_seconds') is not None and row.get('image_emulation_seconds') is not None
                and setup_py is not None else None),
            stock_setup_seconds=stock_s,
            h1_composite_seconds=sum(parts) if all(type(v) in (int, float) for v in parts) else None,
            # fix5c review BLOCKING 1: a post-timeout finalization command (fallback git diff) that raised or
            # returned rc != 0 is a harness error even when result.error/agent_error look normal. Fail closed:
            # rc None without a recorded exception (unknown result) counts as failed too.
            finalization_failed=[{key: call.get(key) for key in ('cmd', 'rc', 'exception')}
                                 for call in row.get('finalization_exec') or []
                                 if call.get('exception') or call.get('rc') != 0],
            total=row['wall_seconds']['total'],
            nonempty_source_diff=not row.get('empty_patch', True) and bool(source_files)))
    def measured(key):
        return numbers([r[key] for r in tasks if r[key] is not None])
    phase1, setup = distribution(measured('phase1_wall_seconds')), distribution(measured('sandbox_setup_seconds'))
    finalization = distribution(measured('finalization_seconds'))
    # Dec 028 (a): harness errors only. Non-fatal setup results (setup_failed/editable_failed) and
    # normal agent end states (timeout, no submit) are diagnostics, not gate failures. A Phase-1 value
    # from the run_agent_sandbox fallback means the sandbox wrappers never fired: not complete.
    def wrapped(r):
        return r['phase1_wall_seconds'] is not None and r.get('phase1_source') != 'run_agent_sandbox'
    complete = sum(r['error'] is None and not r['finalization_failed'] and wrapped(r) for r in tasks)
    n_expected = len(header['task_ids'])
    missing = [iid for iid in header['task_ids'] if iid not in ids]
    nonempty = sum(t['nonempty_source_diff'] for t in tasks)
    def check(passed, value, threshold):
        return dict(status='PASS' if passed else 'FAIL', value=value, threshold=threshold)
    all_phase1 = bool(tasks) and all(wrapped(r) for r in tasks)
    gate = dict(n_expected=n_expected,
        a_all_tasks_complete_no_harness_error=check(n_expected > 0 and complete == n_expected and not missing
                                                    and not stopped and done is not None, complete, n_expected),
        d_vllm_seconds=None, e_nonempty_source_diff=None)
    if gate_mode == 'total':
        gate.update(b_max_phase1=check(all_phase1 and phase1['max'] <= gate_max_phase1, phase1['max'], gate_max_phase1),
                    c_mean_phase1=check(all_phase1 and phase1['mean'] <= gate_mean_phase1, phase1['mean'], gate_mean_phase1))
    else:
        stock_path = [t['stockpath_phase1_seconds'] for t in tasks]
        bound = cap * 60 + 37 if cap is not None else None
        ok = all_phase1 and bound is not None and all(v is not None for v in stock_path)
        worst = max(stock_path) if ok and stock_path else None
        gate.update(b_max_stockpath_phase1=check(ok and worst <= bound, worst, bound),
                    c_mean_phase1='NOT_GATED (dec 034 item 2)')
    gate.update(
        d_vllm_seconds=check(startup is not None and startup <= gate_vllm_seconds, startup, gate_vllm_seconds),
        e_nonempty_source_diff=check(nonempty >= gate_min_nonempty, nonempty, gate_min_nonempty))
    gate['mode'] = gate_mode
    gate['status'] = 'PASS' if all(v['status'] == 'PASS' for v in gate.values() if isinstance(v, dict)) else 'FAIL'
    stock = [dict(instance_id=r['instance_id'], **(r.get('stock_setup') or {})) for r in rows if 'stock_setup' in r]
    stock_totals = [x['total_s'] for x in stock if x.get('total_s') is not None and not x.get('error')]
    def llm_stats(r):
        calls = r.get('llm_calls') or []
        comp = [c['completion_tokens'] for c in calls if isinstance(c.get('completion_tokens'), (int, float))]
        gaps = [c['gap_s'] for c in calls if isinstance(c.get('gap_s'), (int, float)) and c['gap_s'] > 0]
        agent = r.get('wall_seconds', {}).get('agent')
        return dict(instance_id=r['instance_id'], n_calls=len(calls), completion_tokens=sum(comp) if comp else None,
                    calls_per_minute=len(calls) / agent * 60 if agent else None, mean_gap_s=sum(gaps) / len(gaps) if gaps else None,
                    gap_tokens_per_second=sum(comp) / sum(gaps) if comp and gaps else None)
    h1 = [t['h1_composite_seconds'] for t in tasks]
    probes = dict(platform_probe=header.get('platform_probe'),
                  h1_composite=dict(not_gated='agent_clock + finalization + P1 stock_setup total_s (dec 036 item 1); G1 rests on it',
                                    tasks={t['instance_id']: t['h1_composite_seconds'] for t in tasks},
                                    max_s=max(h1) if h1 and all(v is not None for v in h1) else None,
                                    n_missing=sum(v is None for v in h1)),
                  stock_setup=dict(tasks=stock, n_ok=len(stock_totals), max_s=max(stock_totals) if stock_totals else None,
                                   all_le_30s=bool(stock) and len(stock_totals) == len(stock) and max(stock_totals) <= 30),
                  llm=[llm_stats(r) for r in rows if 'llm_calls' in r],
                  mean_agent_seconds=distribution(numbers([r['wall_seconds']['agent'] for r in rows if r['wall_seconds'].get('agent') is not None]))['mean'])
    return dict(_schema='kaggle_timing_summary_v1',
                fields=dict(n='Number of task rows (gate expected n)',
                    n_complete_no_error='Rows with a sandbox-wrapper phase1 measurement, no harness error and no failed finalization command (setup_failed is diagnostic only)',
                    provenance='Kernel header: git_sha, bundle_sha256, agent_yaml_sha256, gpu_names, gpu_count, caps, created_utc, concurrency, mcp_import_ok',
                    agent_outcome_counts='Rows per agent_outcome (timeout/turns/tool_calls/no_submit/null)',
                    setup_failed_count='Rows with a non-fatal setup rc!=0 (diagnostic, not gated)',
                    editable_failed_count='Rows whose editable install returned rc!=0 (diagnostic, not gated)',
                    image_emulation_seconds='Distribution of in-Phase-1 seconds emulating image layers the scorer image already has',
                    phase1_minus_image_seconds='Distribution of phase1_wall_seconds minus image_emulation_seconds (not gated; reported for the Director)',
                    setup_py_emulation_seconds='Distribution of per-task seconds in setup_calls step setup.py (Dockerfile.public setup.py emulation: install_editable_package + install_test_dependencies)',
                    stockpath_phase1_seconds='Distribution of phase1_wall - image_emulation - setup_py_emulation (gate b in stock-path mode)',
                    h1_composite_seconds='Distribution of agent_clock + finalization + P1 stock_setup total_s (not gated)',
                    fallback_invocations='Index-enabled editable fallback invocations across setup calls',
                    retrying_lines_total='pip Retrying lines across setup calls, nested output counted once',
                    tasks='Per-task instance_id, repo, setup_calls [{step,duration_s,rc,retrying_lines}], sandbox_setup_seconds, agent_clock_seconds, agent_timeout_fired, finalization_seconds, teardown_seconds, phase1_wall_seconds, setup_py_emulation_seconds, stockpath_phase1_seconds, stock_setup_seconds, h1_composite_seconds, total, error, finalization_failed [{cmd,rc,exception}] (post-timeout commands with rc!=0, exception or unknown rc; any entry fails gate a), nonempty_source_diff, fallback_patch_used; unavailable measurements are null',
                    nonempty_source_diff='Nonblank classified patch with a path outside protected/test and stray files',
                    phase1_seconds='Phase-1 wall seconds: mean/p50/p90/max of available measurements',
                    setup_seconds='Setup S seconds: mean/p50/p90/max of available measurements',
                    finalization_max_seconds='Maximum finalization seconds, or null',
                    fallback_count='Index-enabled editable fallback invocations plus Retrying lines across setup calls, nested output counted once',
                    tasks_with_retrying_lines='Task count with setup retrying_lines > 0',
                    timeout_fired_count='Tasks whose observed agent timeout fired',
                    fallback_patch_count='Tasks using a non-empty fallback patch',
                    vllm_startup_seconds='Measured vLLM startup seconds',
                    gate='a-e checks: PASS/FAIL, observed value, CLI threshold; overall status requires all checks; mode total (dec 028) or stock-path (dec 034 item 2 / dec 036 item 1: b = max stockpath_phase1 <= cap*60+37)',
                    probes='Plan 006 addendum P1-P3: platform_probe (header), h1_composite (not gated; per task + max_s, null if any part missing), stock_setup per task (+max_s, all_le_30s = G1 P1 leg), llm per-task call stats, mean_agent_seconds',
                    decision_note='decision is the legacy total-wall/cap projection, NOT the gate (dec 032 item 5)',
                    total_seconds='Total task wall seconds distribution',
                    test_run_share='Agent test time share distribution', test_runs_per_task='Test request count distribution',
                    empty_patch_count='Blank patches', test_files_edited_count='Tasks editing protected/test files',
                    stray_files_count='Tasks adding stray files', test_files_edited_files='Total protected/test paths',
                    stray_files_files='Total stray paths', decision='Legacy total-wall/cap projection check',
                    projected_minutes='p90 total seconds times 125 plus vLLM, in minutes',
                    cap_worst_case_minutes='Configured cap times 125 plus 30 minutes', cap_minutes='Configured agent cap',
                    artifact_errors='Raw artifact write failures (diagnostic; rows unaffected)',
                    missing_task_ids='Header task IDs absent from task rows', done_present='Journal contains _done', stopped='Journal stop reasons'),
                tasks=tasks, gate=gate, probes=probes, n_complete_no_error=complete,
                decision_note='decision is the legacy total-wall/cap projection, NOT the gate (dec 032 item 5)',
                provenance={k: header.get(k) for k in ('git_sha', 'bundle_sha256', 'agent_yaml_sha256', 'gpu_names',
                    'gpu_count', 'caps', 'created_utc', 'concurrency', 'mcp_import_ok')},
                agent_outcome_counts=dict(Counter(str(t['agent_outcome']) for t in tasks)),
                setup_failed_count=sum(bool(t['setup_failed']) for t in tasks),
                editable_failed_count=sum(bool(t['editable_failed']) for t in tasks),
                image_emulation_seconds=distribution(measured('image_emulation_seconds')),
                phase1_minus_image_seconds=distribution(measured('phase1_minus_image_seconds')),
                setup_py_emulation_seconds=distribution(measured('setup_py_emulation_seconds')),
                stockpath_phase1_seconds=distribution(measured('stockpath_phase1_seconds')),
                h1_composite_seconds=distribution(measured('h1_composite_seconds')),
                fallback_invocations=sum(fallback_invocations(c) for r in rows for c in r.get('setup_calls', [])),
                retrying_lines_total=sum(retrying_lines(c) for r in rows for c in r.get('setup_calls', [])),
                phase1_seconds=phase1, setup_seconds=setup, finalization_max_seconds=finalization['max'],
                fallback_count=sum(setup_evidence(c) for r in rows for c in r.get('setup_calls', [])),
                tasks_with_retrying_lines=sum(any(c.get('retrying_lines', 0) > 0 or
                    any(s.get('retrying_lines', 0) > 0 for s in c.get('subprocesses', []))
                    for c in r.get('setup_calls', [])) for r in rows),
                fallback_patch_count=sum(bool(r.get('fallback_patch_used')) for r in rows),
                timeout_fired_count=sum(bool(r.get('agent_timeout_fired')) for r in rows),
                n=len(rows), vllm_startup_seconds=startup,
                total_seconds=totals, test_run_share=shares, test_runs_per_task=runs,
                empty_patch_count=sum(bool(r.get('empty_patch', True)) for r in rows),
                test_files_edited_count=sum(bool(r.get('test_files_edited', [])) for r in rows),
                stray_files_count=sum(bool(r.get('stray_files', [])) for r in rows),
                test_files_edited_files=sum(len(r.get('test_files_edited', [])) for r in rows),
                stray_files_files=sum(len(r.get('stray_files', [])) for r in rows),
                decision='PASS' if timing_minutes is not None and cap_minutes is not None and timing_minutes <= 660 and cap_minutes <= 660 else 'FAIL',
                projected_minutes=timing_minutes, cap_worst_case_minutes=cap_minutes,
                cap_minutes=cap, missing_task_ids=missing,
                done_present=done is not None, stopped=stopped, artifact_errors=artifact_errors)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('timing_jsonl', type=Path)
    parser.add_argument('--output', type=Path, required=True)
    parser.add_argument('--gate-max-phase1', type=float, default=296)
    parser.add_argument('--gate-mean-phase1', type=float, default=270)
    parser.add_argument('--gate-vllm-seconds', type=float, default=600)
    parser.add_argument('--gate-min-nonempty', type=int, default=1)
    parser.add_argument('--gate-mode', choices=('total', 'stock-path'), default='total')
    args = parser.parse_args()
    summary = summarize(args.timing_jsonl, gate_max_phase1=args.gate_max_phase1,
                        gate_mean_phase1=args.gate_mean_phase1,
                        gate_vllm_seconds=args.gate_vllm_seconds,
                        gate_min_nonempty=args.gate_min_nonempty, gate_mode=args.gate_mode)
    args.output.write_text(json.dumps(summary, indent=2, allow_nan=False) + '\n')
    print(json.dumps(summary, indent=2, allow_nan=False))


if __name__ == '__main__':
    main()
    result = TaskResult(instance_id=task.instance_id, repo=task.repo, resolved=False,
        agent_patch=agent_patch, test_output='', test_exit_code=0,
        duration_seconds=time.perf_counter() - start_time, error=agent_error, trace=trace)
    # swegemma 0.2.11 annotates this field int, with assignment validation disabled.
    result.test_exit_code = None
    return result


def phase1_fields(current, run_seconds, total, context, patch):
    def difference(end, start):
        return current[end] - current[start] if current.get(end) is not None and current.get(start) is not None else None
    phase1 = difference('sandbox_stop_end', 'sandbox_start_begin')
    source = 'sandbox_wrappers' if phase1 is not None else 'run_agent_sandbox'
    phase1 = run_seconds if phase1 is None else phase1
    submitted = bool(context.patch_submitted) if context is not None else None
    return dict(agent_timeout_seconds=current.get('agent_timeout_seconds'),
        agent_clock_seconds=difference('timeout_exit', 'timeout_enter'),
        agent_timeout_fired=current.get('agent_timeout_fired'),
        finalization_seconds=difference('sandbox_stop_end', 'timeout_exit'),
        finalization_exec=current.get('finalization_exec', []),
        teardown_seconds=current.get('sandbox_stop_duration'),
        phase1_wall_seconds=phase1, phase1_source=source,
        pre_agent_seconds=difference('timeout_enter', 'sandbox_start_begin'),
        post_phase1_seconds=total - phase1, patch_submitted=submitted,
        fallback_patch_used=(not submitted and bool(patch.strip())) if submitted is not None else None,
        verification_skipped=SKIP_VERIFICATION)


# Normal agent end states that swegemma reports through agent_error (agent_runner.py 0.2.11).
AGENT_OUTCOMES = (('timeout', re.compile(r'Agent exceeded session timeout\b')),
                  ('turns', re.compile(r'Agent exceeded (turns budget|maximum allowed LLM turns)\b')),
                  ('tool_calls', re.compile(r'Agent exceeded tool call budget\b')),
                  ('no_submit', re.compile(r'Agent completed execution without calling submit_patch\b')))
IMAGE_EMULATION_STEPS = ('venv_fidelity', 'pip_bootstrap', 'interpreter_probe', 'tool_sources',
                         'pytest_timeout_source', 'tool_install', 'tool_deps', 'pip_check')


def agent_outcome(message):
    """Name of a known normal agent end state, else None (including for empty messages)."""
    text = (message or '').strip()
    return next((name for name, pattern in AGENT_OUTCOMES if pattern.match(text)), None)


def harness_error(result, agent_error):
    """Fail closed: any error that is not a known normal agent end state is a harness failure."""
    messages = [m for m in ((result.error if result is not None else None), agent_error) if m]
    return 'Harness task failure' if any(agent_outcome(m) is None for m in messages) else None


def platform_probe(host='pypi.org', port=443, timeout=10.0):
    """P2 (plan 006 addendum): docker presence, DNS, and one TCP connect. Sends no payload."""
    out = dict(docker_which=shutil.which('docker'), docker_sock=os.path.exists('/var/run/docker.sock'),
               host=host, port=port, dns=None, dns_seconds=None, tcp=None, tcp_seconds=None, tcp_errno=None)
    box = {}
    def resolve():
        try:
            box['addrs'] = sorted({ai[4][0] for ai in socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)})
        except Exception as exc:
            box['error'] = type(exc).__name__
    start = time.perf_counter()
    worker = threading.Thread(target=resolve, daemon=True)
    worker.start(); worker.join(timeout)
    out['dns_seconds'] = round(time.perf_counter() - start, 3)
    if worker.is_alive():
        out['dns'], out['tcp'] = 'timeout', 'skipped'
        return out
    if 'error' in box or not box.get('addrs'):
        out['dns'], out['tcp'] = 'failed:' + box.get('error', 'empty'), 'skipped'
        return out
    out['dns'] = 'resolved'
    out['dns_addr_count'] = len(box['addrs'])
    start = time.perf_counter()
    try:
        sock = socket.create_connection((box['addrs'][0], port), timeout=timeout)
        sock.close()
        out['tcp'] = 'connected'
    except socket.timeout:
        out['tcp'] = 'timeout'  # blackhole: SYN dropped
    except ConnectionRefusedError:
        out['tcp'] = 'refused'
    except OSError as exc:
        out['tcp'], out['tcp_errno'] = 'unreachable', exc.errno
    out['tcp_seconds'] = round(time.perf_counter() - start, 3)
    return out

def stock_setup_probe(config, iid, repo):
    """P1 (plan 006 addendum): time swegemma's STOCK subprocess setup sequence on this task's snapshot.
    Mirrors eval/tools/stock_subprocess_setup_timing.py (agent_runner.py ~l.553-584); the stock
    install_test_dependencies is used even though patch_subprocess_deps rebinds it. Never raises."""
    steps, error, mgr, sid = {}, None, None, None
    t0 = time.perf_counter()
    try:
        import swegemma.harness.container_setup as cs
        from swegemma.sandbox.subprocess import SubprocessManager
        install_deps = getattr(cs.install_test_dependencies, '_timing_original', cs.install_test_dependencies)
        mgr = SubprocessManager(timeout_seconds=120)
        s = time.perf_counter(); sid = mgr.start(); steps['start_venv'] = round(time.perf_counter() - s, 3)
        for name, fn, args, kwargs in (
                ('setup_container_wheels', cs.setup_container_wheels, (mgr, sid, config), {}),
                ('extract_snapshot', cs.extract_snapshot, (mgr, sid, Path(config.snapshots_dir) / f'{iid}.tgz'), {}),
                ('setup_git_exclude', cs.setup_git_exclude, (mgr, sid), {}),
                ('install_editable_package', cs.install_editable_package, (mgr, sid), {}),
                ('install_test_dependencies', install_deps, (mgr, sid, repo), dict(config=config)),
                ('setup_workspace_test_config', cs.setup_workspace_test_config, (mgr, sid), dict(repo=repo)),
                ('setup_baseline_commit', cs.setup_baseline_commit, (mgr, sid, 'baseline'), {})):
            s = time.perf_counter()
            try:
                fn(*args, **kwargs)
            finally:
                steps[name] = round(time.perf_counter() - s, 3)
    except Exception as exc:
        error = type(exc).__name__
    finally:
        try:
            if mgr is not None:
                mgr.cleanup_all()
        except Exception as exc:
            error = error or 'cleanup ' + type(exc).__name__
    return dict(total_s=round(time.perf_counter() - t0, 3), steps_s=steps, error=error)

def llm_calls(trace, limit=200):
    """P3 (plan 006 addendum): one row per trace entry carrying usage (ADK attaches usage once per
    model event), with the gap since the previous entry of any type (approx. model latency)."""
    rows, prev = [], None
    entries = trace.entries if trace else []
    first = entries[0].timestamp if entries else None
    for e in entries:
        if e.usage:
            rows.append(dict(t=round(e.timestamp - first, 3), gap_s=round(e.timestamp - prev, 3) if prev is not None else None,
                             event_type=e.event_type,
                             completion_tokens=e.usage.get('completion_tokens'), prompt_tokens=e.usage.get('prompt_tokens')))
        prev = e.timestamp
    return rows[:limit]

def image_emulation_seconds(setup_calls):
    """Seconds spent emulating Dockerfile.public image layers the scorer image already has."""
    return sum(c.get('duration_s') or 0 for c in setup_calls if c.get('step') in IMAGE_EMULATION_STEPS)

def distribution(values):
    values = sorted(values)
    def percentile(q):
        x = (len(values) - 1) * q
        lo = int(x)
        return values[lo] + (values[min(lo + 1, len(values)-1)] - values[lo]) * (x-lo)
    return dict(mean=sum(values)/len(values), p50=percentile(.5), p90=percentile(.9), max=max(values)) if values else dict.fromkeys(('mean', 'p50', 'p90', 'max'))

def extract_bundle(encoded, destination):
    payload = base64.b64decode(encoded, validate=True)
    destination.mkdir(parents=True, exist_ok=True)
    with tarfile.open(fileobj=io.BytesIO(payload), mode='r:gz') as tf:
        tf.extractall(destination, filter='data')
    return hashlib.sha256(payload).hexdigest(), hashlib.sha256((destination / 'agent.yaml').read_bytes()).hexdigest()

def append(stream, row):
    stream.write(json.dumps(row, allow_nan=False) + '\n')
    stream.flush(); os.fsync(stream.fileno())

async def evaluate(config, journal, started, caps, totals):
    from contextvars import ContextVar
    from swegemma.evaluate import Evaluator
    from swegemma.models import load_tasks
    from swegemma.harness.verification import _is_protected_test_or_config_path
    import swegemma.evaluate as ev
    import swegemma.harness.verification as vf
    import swegemma.harness.agent_runner as ar
    state = ContextVar('timing')
    original_asyncio = ar.asyncio
    original_sandbox = {name: getattr(ar, name) for name in ('sandbox_start', 'sandbox_stop', 'sandbox_exec')}
    ar.asyncio = AsyncioTimingProxy(original_asyncio, state)
    for name, original in original_sandbox.items():
        setattr(ar, name, observe_sandbox(original, state, name))
    original_verify, original_strip = ev.verify_task, vf.strip_protected_files_from_patch
    vf.strip_protected_files_from_patch = observe_patch_strip(original_strip, state)
    async def verify(*args, **kwargs):
        start = time.perf_counter()
        try:
            return await (skip_verification if SKIP_VERIFICATION else original_verify)(*args, **kwargs)
        finally:
            state.get()['verification'] = time.perf_counter() - start
    ev.verify_task = verify
    class TimingEvaluator(Evaluator):
        agent_seconds, patch, trace, agent_error = 0.0, '', None, ''
        def _hydrate_task_from_secret(self, task):
            return task
        def _get_secret_bundle_data(self):
            return {}, {}, None
        async def _run_agent_sandbox(self, task, *args, **kwargs):
            safe = dataclasses.replace(task, patch='', test_patch='', FAIL_TO_PASS=(), PASS_TO_PASS=())
            self.context = kwargs['context']
            self.context.task = safe
            start = time.perf_counter()
            state.get()['agent_active'] = True
            try:
                self.patch, self.agent_error, self.trace = await super()._run_agent_sandbox(safe, *args, **kwargs)
                return self.patch, self.agent_error, self.trace
            finally:
                self.agent_seconds = time.perf_counter() - start
                state.get()['agent_active'] = False
    try:
        inventory = {t.instance_id: t for t in load_tasks(config.tasks_path)}
        if len(set(TASK_IDS)) != len(TASK_IDS) or set(TASK_IDS) - inventory.keys():
            raise ValueError('Duplicate or missing task IDs')
        patch_subprocess_deps(DATA, state)
        for iid in TASK_IDS:
            if should_stop(time.monotonic()-started, caps['max_time_minutes'], 0 if SKIP_VERIFICATION else caps['verification_timeout_seconds'], max(totals, default=0), float(os.environ.get('KERNEL_BUDGET_SECONDS', KERNEL_BUDGET_SECONDS))):
                append(journal, {'_stopped': 'insufficient remaining budget for next task'})
                break
            task = dataclasses.replace(inventory[iid], patch='')
            stock = stock_setup_probe(config, iid, task.repo) if STOCK_PROBE else None
            times = dict(instance_id=task.instance_id, verification=0.0, started=time.perf_counter(), setup_calls=[], setup_failed=False)
            state.set(times)
            evaluator, result, error = TimingEvaluator(config), None, None
            original_start = evaluator.docker.start
            evaluator.docker.start = lambda: setup_step(times, 'venv', original_start)
            start = time.perf_counter()
            try:
                result = await evaluator.evaluate_task(task)
                error = harness_error(result, evaluator.agent_error)
            except Exception as exc:
                error = 'Evaluation exception (' + type(exc).__name__ + ')'
            finally:
                try:
                    evaluator.docker.cleanup_all()
                except Exception as exc:
                    error = 'Cleanup exception (' + type(exc).__name__ + ')'
            total = time.perf_counter() - start
            totals.append(total)
            patch = times.get('raw_patch', result.agent_patch if result else evaluator.patch) or ''
            try:
                counts, tokens, seconds = trace_counts(evaluator.trace)
            except Exception as exc:  # never lose the run over trace parsing
                counts, tokens, seconds = {}, dict(prompt_tokens=None, completion_tokens=None), {}
                error = (error or '') + ' trace parse (' + type(exc).__name__ + ')'
            code = result.test_exit_code if result else None
            raw_error = (result.error or '') if result else error or ''
            phase = phase1_fields(times, evaluator.agent_seconds, total,
                                  getattr(evaluator, 'context', None),
                                  result.agent_patch if result else evaluator.patch)
            phase.update(agent_outcome=agent_outcome(evaluator.agent_error or raw_error),
                         image_emulation_seconds=image_emulation_seconds(times['setup_calls']))
            try:
              append(journal, dict(instance_id=iid, repo=task.repo, resolved=bool(result and result.resolved), exit_code=code, error=error,
                **phase,
                wall_seconds=dict(agent=evaluator.agent_seconds, verification=times['verification'], total=total), sandbox_setup_seconds=sum(c['duration_s'] for c in times['setup_calls']),
                setup_calls=times['setup_calls'], setup_failed=times['setup_failed'],
                editable_failed=times.get('editable_failed', False),
                setup_output_artifact=times.get('setup_output_artifact'),
                missing_tool_deps=times.get('missing_tool_deps', []),
                setup_fix=times.get('setup_fix'), setup_subprocesses=times.get('setup_subprocesses', []),
                editable_rc=times.get('editable_rc'), retrying_lines=times.get('retrying_lines', 0),
                llm_turns=evaluator.context.llm_calls_used if hasattr(evaluator, 'context') else None, tool_calls=dict(total=sum(counts.values()) if evaluator.trace else (result.tool_calls if result else None), per_tool=counts),
                tool_seconds=seconds, test_run=test_run_stats(evaluator.trace, evaluator.agent_seconds), **tokens,
                completion_tokens_per_second=tokens['completion_tokens']/evaluator.agent_seconds if tokens['completion_tokens'] is not None and evaluator.agent_seconds else None,
                stock_setup=stock, llm_calls=llm_calls(evaluator.trace),
                **classify_patch(patch, task.repo, _is_protected_test_or_config_path, task.test_files),
                timed_out=bool(re.search(r'timeout|timed out', raw_error + ' ' + (evaluator.agent_error or ''), re.I)) or code == 124))
            except Exception as exc:
                append(journal, dict(instance_id=iid, repo=task.repo, resolved=bool(result and result.resolved),
                                     **phase,
                                     wall_seconds=dict(agent=evaluator.agent_seconds, verification=times['verification'], total=total),
                                     setup_calls=times['setup_calls'], setup_failed=times['setup_failed'],
                editable_failed=times.get('editable_failed', False),
                setup_output_artifact=times.get('setup_output_artifact'),
                missing_tool_deps=times.get('missing_tool_deps', []),
                setup_fix=times.get('setup_fix'), setup_subprocesses=times.get('setup_subprocesses', []),
                stock_setup=stock,
                editable_rc=times.get('editable_rc'), retrying_lines=times.get('retrying_lines', 0), error='Row build exception (' + type(exc).__name__ + ')'))
            # Raw artifacts are diagnostics written after the row; never lose the remaining tasks over them.
            try:
                raw = WORK / 'runs' / iid
                raw.mkdir(parents=True, exist_ok=True)
                (raw / 'agent.patch').write_text(patch)
                (raw / 'trace.json').write_text(json.dumps(evaluator.trace.to_dict(format='legacy') if evaluator.trace else {}, default=str))
                (raw / 'result.json').write_text(json.dumps(result.model_dump(exclude={'trace'}) if result else {'error': error}, default=str))
            except Exception as exc:
                append(journal, {'_artifact_error': dict(instance_id=iid, type=type(exc).__name__)})
    finally:
        ev.verify_task, vf.strip_protected_files_from_patch = original_verify, original_strip
        ar.asyncio = original_asyncio
        for name, original in original_sandbox.items():
            setattr(ar, name, original)

