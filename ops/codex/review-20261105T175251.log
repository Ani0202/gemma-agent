    54	    for line in st.splitlines():
    55	        k, _, v = line.partition(":")
    56	        if k == "Name":
    57	            d["comm"] = v.strip()
    58	        elif k == "PPid":
    59	            d["ppid"] = int(v)
    60	        elif k == "Uid":
    61	            d["uid"] = int(v.split()[0])
    62	        elif k == "VmRSS":
    63	            d["rss"] = int(v.split()[0]) * 1024
    64	    return d
    65	
