   139	            targets.add(p)
   140	    jobs = {}
   141	    for p in targets:
   142	        if p in marked:
   143	            root = p
   144	            for a in ancestors(p, procs):
   145	                if a in marked:
   146	                    root = a
   147	        else:
   148	            root = p
   149	        j = jobs.setdefault(root, {"pids": [], "rss": 0})
   150	        j["pids"].append(p); j["rss"] += procs[p]["rss"]
   151	    # Never touch our own job (memguard runs under bin/job and carries the marker).
   152	    for root in list(jobs):
   153	        if root in self_pids or (set(descendants(root, procs)) | {root}) & self_pids:
