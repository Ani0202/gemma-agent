    98	def ancestors(pid, procs):
    99	    out, seen = [], set()
   100	    p = procs.get(pid, {}).get("ppid", 0)
   101	    while p and p in procs and p not in seen:
   102	        seen.add(p); out.append(p); p = procs[p]["ppid"]
   103	    return out
   104	
   105	
   106	def descendants(root, procs):
   107	    kids = {}
   108	    for d in procs.values():
   109	        kids.setdefault(d["ppid"], []).append(d["pid"])
   110	    out, stack = [], [root]
   111	    while stack:
   112	        for c in kids.get(stack.pop(), []):
   113	            if c not in out:
   114	                out.append(c); stack.append(c)
   115	    return out
   116	
   117	
   118	def is_session(pid, procs):
   119	    d = procs[pid]
