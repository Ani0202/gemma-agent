    18	import argparse, collections, json, os, sys
    19	
    20	EDIT_TOOLS = ('edit_file', 'write_file')
    21	
    22	
    23	def read_ids(path):
    24	    with open(path) as f:
    25	        return [ln.strip() for ln in f if ln.strip() and not ln.lstrip().startswith('#')]
    26	
    27	
    28	def parse(s):
    29	    try:
    30	        j = json.loads(s) if isinstance(s, str) else s
    31	    except (TypeError, ValueError):
    32	        return None
    33	    return j if isinstance(j, dict) else None
