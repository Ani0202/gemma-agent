    35	
    36	def diag_row(run, iid, c, max_calls):
    37	    t = json.load(open(f'{run}/runs/{iid}/trace.json'))
    38	    r = json.load(open(f'{run}/runs/{iid}/result.json'))
    39	    calls = []  # [tool, args, parsed_response_or_None]
    40	    for e in t['entries']:
    41	        if e['type'] == 'tool_call':
    42	            calls.append([e['tool'], e.get('args') or {}, None])
    43	        elif e['type'] == 'tool_response' and calls:
    44	            calls[-1][2] = parse(e.get('result'))
    45	    eds = [k for k in calls if k[0] in EDIT_TOOLS]
    46	    ed_ok = sum(1 for k in eds if k[2] is not None and k[2].get('status') == 'ok')
    47	    malformed = sum(1 for k in eds if k[0] == 'edit_file' and ('old_string' not in k[1] or 'new_string' not in k[1]))
    48	    status_zero = any(k[0] == 'get_status' and k[2] is not None and k[2].get('tool_calls_remaining') == 0 for k in calls)
    49	    call_exhausted = len(calls) >= max_calls or status_zero
    50	    patch = r.get('agent_patch')
    51	    empty = patch is None or len(patch.encode('utf-8')) == 0
    52	    edit_failed = bool(eds) and ed_ok == 0
    53	    timeout = c['agent_end'] == 'timeout'
    54	    cls = ('resolved' if r['resolved'] else
    55	           'empty_timeout' if empty and timeout else
    56	           'empty_never_edited' if empty and not eds else
    57	           'empty_edit_failed' if empty and edit_failed else
    58	           'empty_edited_ok' if empty else
    59	           'patch_timeout' if timeout else 'patch_wrong')
    60	    first_edit = next((k + 1 for k, x in enumerate(calls) if x[0] in EDIT_TOOLS), None)
    61	    return dict(id=iid, cls=cls, end=c['agent_end'], calls=len(calls), edits=len(eds), edit_ok=ed_ok,
    62	                edit_err=len(eds) - ed_ok, malformed=malformed, call_exhausted=call_exhausted,
    63	                rule_target=empty and (edit_failed or call_exhausted),
    64	                first_edit_call=first_edit, dur_s=round(r['duration_seconds']))
    65	
    66	
    67	def main(argv=None):
    68	    ap = argparse.ArgumentParser()
    69	    ap.add_argument('--pair', nargs=3, action='append', required=True, metavar=('RUN_DIR', 'CLASSIFIER_JSON', 'IDS_FILE'))
    70	    ap.add_argument('--max-tool-calls', type=int, required=True)
    71	    a = ap.parse_args(argv)
    72	    errs, rows, seen = [], [], set()
    73	    for run, clf, idf in a.pair:
    74	        crows = json.load(open(clf))['rows']
    75	        cids = [x['instance_id'] for x in crows]
    76	        exp = read_ids(idf)
    77	        if len(cids) != len(set(cids)):
    78	            errs.append(f'{clf}: duplicate classifier ids')
    79	        if len(exp) != len(set(exp)):
    80	            errs.append(f'{idf}: duplicate expected ids')
    81	        if set(cids) != set(exp):
    82	            errs.append(f'{clf}: ids != {idf} (missing {len(set(exp) - set(cids))}, extra {len(set(cids) - set(exp))})')
    83	        if seen & set(cids):
    84	            errs.append(f'{clf}: ids overlap an earlier --pair')
    85	        seen |= set(cids)
    86	        for iid in cids:
    87	            for fn in ('trace.json', 'result.json'):
    88	                if not os.path.isfile(f'{run}/runs/{iid}/{fn}'):
    89	                    errs.append(f'{run}: missing artifact for one id ({fn})')
    90	        if errs:
    91	            continue
    92	        C = {x['instance_id']: x for x in crows}
    93	        rows += [dict(diag_row(run, iid, C[iid], a.max_tool_calls), run=run) for iid in sorted(C)]
    94	    if errs:
    95	        print('INVENTORY FAIL:\n' + '\n'.join(errs), file=sys.stderr)
    96	        return 2
    97	    tally = collections.Counter(x['cls'] for x in rows)
    98	    extra = dict(n=len(rows), malformed_edit_calls=sum(x['malformed'] for x in rows),
    99	                 edit_errors=sum(x['edit_err'] for x in rows),
   100	                 empty=sum(1 for x in rows if x['cls'].startswith('empty_')),
   101	                 empty_call_exhausted=sum(1 for x in rows if x['cls'].startswith('empty_') and x['call_exhausted']),
   102	                 rule_target=sum(1 for x in rows if x['rule_target']))
   103	    extra['rule_verdict'] = 'PROPOSE_PLAN011' if extra['rule_target'] >= 3 else 'STAY_SHELVED'
   104	    out = dict(script='eval/plan011_empty_diag.py v2', pairs=a.pair, max_tool_calls=a.max_tool_calls,
   105	               counts=dict(tally), summary=extra, rows=rows)
   106	    print(json.dumps(out, indent=1))
   107	    return 0
   108	
   109	
   110	if __name__ == '__main__':
   111	    sys.exit(main())

