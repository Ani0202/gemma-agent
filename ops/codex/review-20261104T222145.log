   218	    def prompt(self, value, where):
   219	        if isinstance(value, str):
   220	            bad = set(re.findall(r'\{([A-Za-z_][\w.-]*\??)\}', value)) - {'problem_description'}
   221	            require(not bad, f'{where}: forbidden placeholder(s): {sorted(bad)}')
   222	
   223	    def walk(self, value, where, ancestors=(), agent=False):
   224	        if isinstance(value, str):
   225	            require('\0' not in value, f'{where}: null bytes in text')
   226	        if agent:
   227	            require(isinstance(value, (dict, list)), f'{where}: agent must be a mapping')
   228	        if isinstance(value, (dict, list)):
   229	            require(id(value) not in ancestors, f'{where}: recursive YAML alias')
   230	            ancestors = (*ancestors, id(value))
   231	        if isinstance(value, list):
   232	            for index, item in enumerate(value):
   233	                self.walk(item, f'{where}[{index}]', ancestors, agent)
   234	        elif isinstance(value, dict):
   235	            is_agent = agent or bool({'name', 'model', 'agent_class', 'instruction', 'global_instruction', 'tools', 'sub_agents'} & value.keys())
   236	            if is_agent and 'config_path' not in value and 'agent_tool' not in value:
   237	                model = value.get('model')
   238	                require(isinstance(model, str) and model in MODELS, f'{where}: missing or disallowed model: {model!r}')
   239	                self.models.add(model)
   240	            for key, item in value.items():
   241	                label = f'{where}.{key}'
   242	                if key == 'config_path':
   243	                    target = self.target(item)
   244	                    require(target.suffix in {'.yaml', '.yml'}, f'{label}: config_path must reference YAML')
   245	                    # Reference cycles are checked separately using the document graph.
   246	                    self.load(target)
   247	                elif key == 'adapter' and item is not None:
   248	                    require(isinstance(item, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', item)
   249	                            and item != '..', f'{label}: invalid adapter name')
   250	                    for filename in ('adapter_config.json', 'adapter_model.safetensors'):
   251	                        self.target(f'adapters/{item}/{filename}')
   252	                elif key == 'thinking_config':
   253	                    self.thinking(item, label)
   254	                elif key == 'max_output_tokens':
   255	                    require(type(item) is int and 1 <= item <= 32768, f'{label}: must be integer 1..32768')
   256	                if 'instruction' in key or 'prompt' in key:
   257	                    self.prompt(item, label)
   258	                self.walk(item, label, ancestors, key in {'sub_agents', 'agent_tool'})
   259	
   260	    def thinking(self, config, where):
   261	        require(isinstance(config, dict), f'{where}: must be a mapping')
   262	        require(not config.keys() - {'thinking_budget', 'thinking_level', 'include_thoughts'}, f'{where}: unknown fields')
   263	        if 'thinking_budget' in config:
   264	            budget = config['thinking_budget']
   265	            require(type(budget) is int and 0 <= budget <= 32768, f'{where}: thinking_budget must be integer 0..32768')
   266	        if 'thinking_level' in config:
   267	            level = config['thinking_level']
   268	            require(isinstance(level, str) and level.upper() in {'MINIMAL', 'LOW', 'MEDIUM', 'HIGH', 'NONE'}, f'{where}: invalid thinking_level')
   269	        if 'include_thoughts' in config:
   270	            require(type(config['include_thoughts']) is bool, f'{where}: include_thoughts must be boolean')
   271	
   272	    def validate(self):
   273	        require(self.root.is_dir() and not self.root.is_symlink(), f'not a bundle directory (or symlink): {self.root}')
   274	        total = 0
   275	        for directory, dirs, files in os.walk(self.root, followlinks=False):
   276	            for name in sorted(dirs + files):
   277	                path = Path(directory) / name
   278	                safe_path(path.relative_to(self.root).as_posix())
   279	                mode = path.lstat().st_mode
   280	                require(not stat.S_ISLNK(mode), f'symlink forbidden: {path}')
   281	                require(stat.S_ISDIR(mode) or stat.S_ISREG(mode), f'not a regular file: {path}')
   282	                if stat.S_ISREG(mode):
   283	                    require(path.suffix in EXTENSIONS, f'extension not allowed: {path}')
   284	                    total += path.stat().st_size
   285	                    require(total < LIMIT, f'unpacked size must be < {LIMIT} bytes')
   286	                    self.files.append(path)
   287	        self.files.sort()
   288	        require(self.root / 'agent.yaml' in self.files, 'missing agent.yaml at bundle root')
   289	        require(len(ROOTS & {p.name for p in self.files if p.parent == self.root}) == 1, 'multiple root agent configs')
   290	        require(isinstance(self.load(self.root / 'agent.yaml'), dict), 'agent.yaml must be a mapping')
   291	        for path in self.files:
   292	            if path.suffix in {'.yaml', '.yml'}:
   293	                value = self.load(path)
   294	                self.walk(value, str(path), agent=path == self.root / 'agent.yaml')
   295	            elif path.suffix != '.safetensors':
   296	                source = path.read_text(encoding='utf-8')
   297	                require('\0' not in source, f'null bytes in {path}')
   298	                if 'prompts' in path.relative_to(self.root).parts:
   299	                    self.prompt(source, str(path))
   300	        require(len(self.models) == 1, f'models must be identical across all agents: {sorted(self.models)}')
   301	        # Follow config references, including unreferenced standalone documents.
   302	        def refs(value):
   303	            if isinstance(value, dict):
   304	                for key, item in value.items():
   305	                    if key == 'config_path':
   306	                        yield self.target(item)
   307	                    else:
   308	                        yield from refs(item)
   309	            elif isinstance(value, list):
   310	                for item in value:
   311	                    yield from refs(item)
   312	        done = set()
   313	        def visit(path, active):
   314	            require(path not in active, f'config_path cycle: {path}')
   315	            if path in done:
   316	                return
   317	            for target in refs(self.load(path)):
   318	                child = self.load(target)
   319	                require(isinstance(child, dict), f'agent config must be a mapping: {target}')
   320	                self.walk(child, str(target), agent=True)
   321	                visit(target, active | {path})
   322	            done.add(path)
   323	        for path in list(self.cache):
   324	            visit(path, set())
   325	        require(len(self.models) == 1, 'models must be identical across all agents')
   326	        config = self.load(self.target('eval_config.yaml'))
   327	        evaluation = config.get('evaluation') if isinstance(config, dict) else None
   328	        cap = evaluation.get('max_time_minutes') if isinstance(evaluation, dict) else None
   329	        require(type(cap) in (int, float) and math.isfinite(cap) and cap > 0,
   330	                'evaluation.max_time_minutes: missing or invalid positive cap')
   331	        require(cap * 125 + 30 <= 660, f'evaluation timing FAIL: {cap}*125+30 > 660 minutes')
   332	        return total
   333	
   334	
   335	def write_zip(bundle, dist):
   336	    track, version = bundle.root.parent.name, bundle.root.name
   337	    require(re.fullmatch(r'[A-Za-z0-9_-]+', track) and re.fullmatch(r'[A-Za-z0-9_-]+', version), 'invalid track/version for archive name')
   338	    dist.mkdir(parents=True, exist_ok=True)
   339	    destination = dist / f'{track}-{version}.zip'
   340	    fd, temporary = tempfile.mkstemp(prefix='.pack-', suffix='.zip', dir=dist)
   341	    os.close(fd)
   342	    try:
   343	        with zipfile.ZipFile(temporary, 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=9) as archive:
   344	            for path in bundle.files:
   345	                if path == bundle.root / 'MANIFEST.md':
   346	                    continue
   347	                info = zipfile.ZipInfo(path.relative_to(bundle.root).as_posix(), (1980, 1, 1, 0, 0, 0))
   348	                info.create_system = 3
   349	                info.external_attr = (stat.S_IFREG | 0o644) << 16
   350	                info.compress_type = zipfile.ZIP_DEFLATED
   351	                with path.open('rb') as source, archive.open(info, 'w', force_zip64=True) as target:
   352	                    shutil.copyfileobj(source, target, 1024*1024)
   353	        digest = hashlib.sha256()
   354	        with open(temporary, 'rb') as source:
   355	            for chunk in iter(lambda: source.read(1024*1024), b''):
   356	                digest.update(chunk)
   357	        checksum = digest.hexdigest()
   358	        os.replace(temporary, destination)
   359	        manifest = bundle.root / 'MANIFEST.md'
   360	        content = manifest.read_text(encoding='utf-8') if manifest.exists() else ''
   361	        lines = [line for line in content.splitlines() if not re.match(r'^\s*(?:[-*]\s*)?zip sha256\s*:', line, re.I)]
   362	        manifest.write_text('\n'.join(lines).rstrip() + f'\nzip sha256: {checksum}\n', encoding='utf-8')
   363	        print(f'{destination}\nsha256: {checksum}\nsize: {destination.stat().st_size} bytes')
   364	    finally:
   365	        if os.path.exists(temporary):
   366	            os.unlink(temporary)
   367	
   368	
   369	def main():
   370	    parser = argparse.ArgumentParser(description=__doc__)
   371	    parser.add_argument('bundle_dir')
   372	    parser.add_argument('--zip', action='store_true')
   373	    args = parser.parse_args()
   374	    try:
   375	        bundle = Bundle(args.bundle_dir)
   376	        total = bundle.validate()
   377	        if args.zip:
   378	            write_zip(bundle, Path(__file__).resolve().parent.parent / 'dist')
   379	        print(f'PASS: {args.bundle_dir} ({total} unpacked bytes)')
   380	        return 0
   381	    except (Invalid, OSError, UnicodeError, RecursionError) as exc:
   382	        print(f'FAIL: {exc}', file=sys.stderr)
   383	        return 1
   384	
   385	
   386	if __name__ == '__main__':
   387	    sys.exit(main())

