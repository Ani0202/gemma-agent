   186	                require(path.suffix in {'.md', '.txt'}, f'unsupported !include target: {path}')
   187	                result = source
   188	            else:
   189	                def include(value):
   190	                    return self.load(self.target(value, path.parent))
   191	                if yaml is None:
   192	                    result = minimal_yaml(source, include)
   193	                else:
   194	                    class Loader(yaml.SafeLoader):
   195	                        pass
   196	                    def mapping(loader, node):
   197	                        result = {}
   198	                        for key_node, value_node in node.value:
   199	                            key = loader.construct_object(key_node)
   200	                            require(isinstance(key, str) and key not in result,
   201	                                    f'invalid or duplicate YAML key in {path}')
   202	                            result[key] = loader.construct_object(value_node)
   203	                        return result
   204	                    Loader.add_constructor('tag:yaml.org,2002:map', mapping)
   205	                    Loader.add_constructor('!include', lambda loader, node: include(loader.construct_scalar(node)))
   206	                    result = yaml.load(source, Loader=Loader)
   207	            self.cache[path] = result
   208	            return result
   209	        except (ValueError, UnicodeError) as exc:
   210	            raise Invalid(f'{path}: {exc}') from exc
   211	        except Exception as exc:
   212	            if yaml is not None and isinstance(exc, yaml.YAMLError):
   213	                raise Invalid(f'{path}: YAML parse failed: {exc}') from exc
   214	            raise
   215	        finally:
   216	            self.loading.pop()
