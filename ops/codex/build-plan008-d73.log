def smoke_metrics(run_dir, tasks_path=None):
    timing = Path(run_dir) / 'timing.jsonl'
    paths, rows = [timing, GATE_YAML], []
    tasks_path = Path(tasks_path) if tasks_path is not None else _tasks_path()
    try:
