def load_rows(path):
    out = []
    for line in Path(path).read_text().splitlines():
        if not line.strip():
            continue
        r = json.loads(line)
        if 'instance_id' in r:
            out.append(r)
        elif not any(m <= set(r) for m in META_KEYS):
            raise AssertionError(f'unrecognized non-row record in {path}: keys {sorted(r)[:8]}')
    ids = [r['instance_id'] for r in out]
