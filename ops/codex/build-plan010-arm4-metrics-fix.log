def arm4_schema(paths):
    return dict(name='plan008_metrics/v1', mode='arm4', definitions=ARM4_DEFINITIONS,
                script_sha256=base.sha(__file__),
                input_shas={str(p): base.sha(p) for p in dict.fromkeys(map(Path, paths))})


def context_overflow(records):
    """Do not mistake task text, thoughts or tool output mentioning context for an error."""
    pattern = re.compile(r'context[_ -]?(?:length|window|overflow)|maximum context|maximum model length|too many tokens', re.I)
    found, unknown = [], []
    for row, _, trace, entries in records:
        document = _read_json(trace)
        summary = document.get('summary')
        sources = [document, summary] + [e for e in entries if e.get('type') in ('error', 'exception', 'agent_end')]
        explicit, errors = [], []
        for source in sources + entries:
            if not isinstance(source, dict):
                continue
            if type(source.get('context_overflow')) is bool:
                explicit.append(source['context_overflow'])
            errors.extend(source[k] for k in ('error', 'error_message', 'exception', 'agent_error') if source.get(k))
        for event in sources[2:]:
            errors.extend(event.get(k) for k in ('content', 'message') if event.get(k))
        if any(explicit) or any(pattern.search(_response_text(error)) for error in errors):
            found.append(row['instance_id'])
        elif not explicit and not any(e.get('type') == 'agent_end' or
                                      e.get('type') == 'final' and e.get('author') == ROOT for e in entries):
            unknown.append(row['instance_id'])
    return dict(**_id_count(found), unknown=_id_count(unknown))


def arm4_discordants(left, right, predicate):
    a, b = [], []
    right_by_id = {r['instance_id']: r for r, _, _, _ in right}
    for row, _, _, _ in left:
        other = right_by_id[row['instance_id']]
        base.assert_paired(row, other)
        x, y = predicate(row), predicate(other)
        if x and not y:
            a.append(row['instance_id'])
        if y and not x:
            b.append(row['instance_id'])
    return dict(arm4_only=_id_count(a), comparator_only=_id_count(b), p=sign_test(len(a), len(b)))


def arm4_metrics(arm4_dirs, base_dirs, arm1_dirs, classifiers, smoke_json, base_json, *,
                 identity_json, bundle, transports, push_events):
    paths = [base.ARM_IDS, base.SCREENED_IDS, base.__file__, 'eval/plan007_report.py', 'eval/thinking_bound.py']
    arms, inventories, records, envs, arm_paths = {}, {}, {}, {}, {}
    for name, dirs in (('arm4', arm4_dirs), ('arm3', base_dirs), ('arm1', arm1_dirs)):
        rec, inv, inputs, headers = aggregate_arm(dirs, classifiers)
        if len(rec) != 33:
            raise IncompleteRun(dict(arm=name, inventory=inv, required=33))
        paths.extend(inputs)
        records[name], inventories[name], arm_paths[name] = rec, inv, inputs
        # D73.5 applies symmetrically to the primary comparison, including its base.
        arms[name] = summarize_arm(rec)
        arms[name]['descriptive']['context_overflow'] = context_overflow(rec)
        envs[name] = environment_metrics(headers, rec)
    a, b, c = (arms[n] for n in ('arm4', 'arm3', 'arm1'))
    primary = arm4_discordants(records['arm4'], records['arm3'], lambda r: r.get('resolved') is True)
    primary.update(D=primary['comparator_only']['count'] - primary['arm4_only']['count'],
                   arm4_resolved=a['resolved'], arm3_resolved=b['resolved'])
    comparisons = {}
    for name in ('arm3', 'arm1'):
        comparisons[name] = {
            'timeouts': arm4_discordants(records['arm4'], records[name],
                                       lambda r: bool(r.get('timed_out') or r.get('agent_timeout_fired'))),
            'empty_patch': arm4_discordants(records['arm4'], records[name], lambda r: r.get('verified_patch_bytes') == 0)}
    for path in (smoke_json, base_json, identity_json, _manifest_path(bundle)):
        if path and _readable_file(path):
            paths.append(path)
    smoke = _read_json(smoke_json)
    traces = [r[2] for r in records['arm4'][:2]]
    smoke_dirs = {str(t.parent.parent.parent) for t in traces}
    evidence = smoke.get('_schema', {}).get('input_shas', {})
    required = [*traces, *(Path(d) / 'timing.jsonl' for d in smoke_dirs),
                *(classifiers[d][0] for d in smoke_dirs)]
    smoke_bound = isinstance(evidence, dict) and all(evidence.get(str(p)) == base.sha(p) for p in required)
    smoke_bound = smoke_bound and {str(Path(p)) for p in evidence if Path(p).name == 'timing.jsonl'} == {
        str(Path(d) / 'timing.jsonl') for d in smoke_dirs}
    identity = identity_check(arm4_dirs, identity_json, bundle, transports, smoke_dirs, push_events)
    recomputed = None
    if len(smoke_dirs) == 1:
        directory = next(iter(smoke_dirs))
        recomputed = arm3smoke_metrics(directory, classifiers[directory][0], identity_json, bundle,
                                      {directory: transports.get(directory)}, {directory: push_events.get(directory)})
    recorded = _read_json(base_json)
    schema = recorded.get('_schema') or {}
    bound = schema.get('input_shas') or {}
    base_bound = isinstance(bound, dict) and all(bound.get(str(p)) == base.sha(p)
                                                for name in ('arm3', 'arm1') for p in arm_paths[name])
    recorded_inputs = recorded.get('decision_inputs') or {}
    recorded_inventories = recorded.get('inventory') or {}
    base_valid = (schema.get('name') == 'plan008_metrics/v1' and schema.get('mode') == 'arm3'
                  and recorded.get('decision') in ('ON-ADOPT', 'ON-BETTER-VETOED', 'KEEP-OFF', 'NO-DIFFERENCE')
                  and recorded.get('base_arm') == 'arm1' and recorded.get('n_rows') == 33
                  and base_bound and b['h_rows']['count'] < 5
                  and all((recorded_inventories.get(n) or {}).get('complete') is True for n in ('arm3', 'base'))
                  and recorded_inputs.get('base_valid') is True and recorded_inputs.get('smoke_invalid') is False
                  and recorded_inputs.get('smoke_bound') is True
                  and (recorded_inputs.get('identity') or {}).get('checked') is True)
    checks = safety_checks(a['safety'], b['safety'])
    checks.pop('empty_patch')
    checks['submitted_without_test'] = a['safety']['submitted_without_test']['count'] <= 10
    limits = dict(timeouts=a['timeouts']['count'] <= 16, empty_patch=a['safety']['empty_patch']['count'] <= 18)
    missing = {}
    for name, rec in records.items():
        missing[name] = [r['instance_id'] for r, cl, trace, entries in rec if
                         type(r.get('resolved')) is not bool or r.get('verification_skipped') is True
                         or type(r.get('verified_patch_bytes')) is not int or r['verified_patch_bytes'] < 0
                         or type(r.get('timed_out')) is not bool
                         or any(k in r and type(r[k]) is not bool for k in ('timed_out', 'agent_timeout_fired'))
                         or 'h' not in cl or not isinstance(_read_json(trace).get('entries'), list)]
    invalid = []
    if not base_valid:
        invalid.append('base evidence invalid/unbound')
    if not identity['checked']:
        invalid.append('identity mismatch')
    if not smoke_bound or smoke.get('overall') != 'PASS' or not recomputed or recomputed['overall'] != 'PASS':
        invalid.append('smoke failed/unbound')
    if any(arms[n]['h_rows']['count'] >= 5 for n in ('arm4', 'arm3')):
        invalid.append('literal H>=5')
    if any(missing.values()):
        invalid.append('missing row evidence')
    differences = [k for k in envs['arm4'] if envs['arm4'][k] != envs['arm3'][k]]
    if 'kernel_code' in differences:
        invalid.append('pairing voided: kernel agent/verification path differs')
    decision = ('INVALID' if invalid else '2048-WORSE' if primary['D'] >= 3 else
                '2048-NO-GAIN' if not all(limits.values()) else
                'VETOED' if not a['timing']['timing_pass'] or not all(checks.values()) else '2048-ADOPT')
    # Plan 009 against arm1 remains descriptive, including its original observed arm1 counts.
    original_arm1 = summarize_arm(records['arm1'], arm1=True)
    original_checks = safety_checks(a['safety'], original_arm1['safety'])
    original_vetoes = [k for k, passed in original_checks.items() if not passed]
    if a['timeouts']['count'] > c['timeouts']['count'] + 2:
        original_vetoes.append('timeouts')
    if not a['timing']['timing_pass']:
        original_vetoes.append('timing')
    secondary = arm4_discordants(records['arm4'], records['arm1'], lambda r: r.get('resolved') is True)
    secondary.update(descriptive_only=True, vetoes=original_vetoes, safety_checks=original_checks,
                     decision=arm3_decision(secondary['arm4_only']['count'], secondary['comparator_only']['count'],
                                           secondary['p'], a['h_rows']['count'], bool(invalid), original_vetoes))
    return dict(_schema=arm4_schema(paths), mode='arm4', n_rows=33, base_arm='arm3',
                inventory=inventories, arms=arms, primary=primary, comparisons=comparisons,
                secondary_plan009_vs_arm1=secondary, decision=decision, verdict=decision,
                decision_inputs=dict(limits=limits, safety_checks=checks, timing_pass=a['timing']['timing_pass'],
                                     invalid_reasons=invalid, missing_evidence=missing, base_valid=base_valid,
                                     base_bound=base_bound, identity=identity, smoke_bound=smoke_bound,
                                     smoke_recomputed=recomputed),
                env_drift=dict(arms=envs, differences=differences))


def arm4_cli(argv):
    import argparse
    parser = argparse.ArgumentParser(description='Plan 010 CPU/offline metrics')
    for flag in ('arm4-dirs', 'base-dirs', 'arm1-dirs'):
        parser.add_argument('--' + flag, nargs='+', required=True)
    for flag in ('identity-json', 'bundle', 'smoke-json', 'base-json', 'out'):
        parser.add_argument('--' + flag, required=True)
    for flag in ('transport', 'push-event'):
        parser.add_argument('--' + flag, action='append', required=True)
    parser.add_argument('--classifiers', action='append', default=[], help='DIR=D4_JSON,A2_JSON (as arm3); otherwise discover hash-matched evidence')
    args = parser.parse_args(argv[2:])
    def dirs(values):
        return [str(Path(d)) for value in values for d in value.split(',') if d]
    arm4_dirs, base_dirs, arm1_dirs = map(dirs, (args.arm4_dirs, args.base_dirs, args.arm1_dirs))
    def mapping(values, flag):
        out = {}
        for value in values:
            if '=' not in value:
                parser.error(flag + ' requires DIR=VALUE')
            directory, entry = value.rsplit('=', 1)
            directory = str(Path(directory))
            if directory in out:
                parser.error('duplicate ' + flag + ' dir')
            out[directory] = entry
        return out
    transports = mapping(args.transport, '--transport')
    events = mapping(args.push_event, '--push-event')
    if set(transports) != set(arm4_dirs) or any(not re.fullmatch('[0-9a-f]{64}', s) for s in transports.values()):
        parser.error('--transport requires DIR=SHA256 for each arm4 dir')
    errors = _push_errors(arm4_dirs, events, {d for d, e in events.items() if e == 'smoke'})
    if errors:
        parser.error('; '.join(errors))
    if not re.fullmatch(r'v01[0-9]+', args.bundle):
        parser.error('--bundle requires v01N')
    paths = [args.base_json, args.smoke_json, args.identity_json]
    try:
        # Check every inventory before any evidence discovery or decision.
        for directory_list in (arm4_dirs, base_dirs, arm1_dirs):
            ids = []
            for directory in directory_list:
                timing = Path(directory) / 'timing.jsonl'
                paths.append(timing)
                if not timing.is_file():
                    raise IncompleteRun(dict(dir=directory, missing_timing=True))
                try:
                    rows = base.load_rows(timing)
                except AssertionError:
                    raw = [json.loads(line) for line in timing.read_text().splitlines() if line.strip()]
                    raise IncompleteRun(dict(dir=directory, inventory=inventory(
                        [r['instance_id'] for r in raw if 'instance_id' in r], base.ids_file(base.ARM_IDS))))
                ids.extend(r['instance_id'] for r in rows)
            inv = inventory(list(dict.fromkeys(ids)), base.ids_file(base.ARM_IDS))
            if not inv['complete'] or len(set(ids)) != 33:
                raise IncompleteRun(inv)
        classifiers = {d: pair.split(',') for d, pair in mapping(args.classifiers, '--classifiers').items()}
        if any(len(pair) != 2 for pair in classifiers.values()):
            parser.error('--classifiers requires DIR=D4_JSON,A2_JSON')
        recorded_paths = (_read_json(args.base_json).get('_schema') or {}).get('input_shas') or {}
        candidates = list(dict.fromkeys([*(Path(p) for p in recorded_paths), *Path('results').glob('*.json'),
                                       *(p for d in arm4_dirs + base_dirs + arm1_dirs for p in Path(d).glob('*.json'))]))
        index = {}
        for path in candidates:
            if path.suffix != '.json':
                continue
            doc = _read_json(path)
            if doc.get('classifier_sha256') in (base.D4_SHA, base.A2_SHA):
                index.setdefault((doc.get('input_sha256'), doc['classifier_sha256']), str(path))
        for directory in arm4_dirs + base_dirs + arm1_dirs:
            if directory not in classifiers:
                sha = base.sha(Path(directory) / 'timing.jsonl')
                local = {}
                for path in Path(directory).glob('*.json'):
                    doc = _read_json(path)
                    if doc.get('input_sha256') == sha:
                        local[doc.get('classifier_sha256')] = str(path)
                classifiers[directory] = [local.get(classifier) or index[(sha, classifier)]
                                          for classifier in (base.D4_SHA, base.A2_SHA)]
        out = arm4_metrics(arm4_dirs, base_dirs, arm1_dirs, classifiers, args.smoke_json, args.base_json,
                           identity_json=args.identity_json, bundle=args.bundle, transports=transports, push_events=events)
        code = 0
    except IncompleteRun as exc:
        out = dict(_schema=arm4_schema([p for p in paths if _readable_file(p)]), mode='arm4',
                   decision=None, verdict=None, status='NO_DECISION', inventory_error=exc.args[0])
        code = 3
    except (OSError, ValueError, AssertionError, KeyError, TypeError) as exc:
        # Missing/malformed/unpaired evidence never produces a usable decision.
        out = dict(_schema=arm4_schema([p for p in paths if _readable_file(p)]), mode='arm4',
                   decision='INVALID', verdict='INVALID', status='EVIDENCE_FAILURE', error_type=type(exc).__name__)
        code = 4
    Path(args.out).write_text(json.dumps(out, indent=2) + '\n')
    print(json.dumps({k: out[k] for k in ('n_rows', 'decision', 'verdict', 'status') if k in out}))
    return code


def arm3_cli(argv):
    import argparse
    parser = argparse.ArgumentParser(description='Plan 009 CPU/offline metrics')
    parser.add_argument('mode', choices=['arm3', 'arm3smoke'])
    parser.add_argument('--identity-json', required=True)
    parser.add_argument('--bundle', required=True)
    parser.add_argument('--transport', action='append', required=True)
    parser.add_argument('--push-event', action='append', required=True)
    def transports_for(args, dirs):
        transports = {}
        for value in args.transport:
            if '=' not in value:
                parser.error('--transport requires DIR=SHA256')
"""Offline plan-010 acceptance tests, with synthetic runs only.

Run with the image interpreter and environment documented in README_AGENT_EVAL.md:
python3 -m pytest eval/tests -q
"""
import json
from pathlib import Path
import sys

import pytest

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / 'eval'))
import plan008_metrics as m


def write_json(path, value):
    Path(path).write_text(json.dumps(value))


class Experiment:
    def __init__(self, tmp_path, monkeypatch):
        self.root = tmp_path
        self.ids = [f'repo__{i:02}' for i in range(33)]
        ids = tmp_path / 'ids.txt'
        ids.write_text('\n'.join(self.ids) + '\n')
        screened = tmp_path / 'screened.txt'
        screened.write_text('')
        monkeypatch.setattr(m.base, 'ARM_IDS', str(ids))
        monkeypatch.setattr(m.base, 'SCREENED_IDS', str(screened))
        bundles = tmp_path / 'bundles'
        for bundle in ('v012', 'v014'):
            directory = bundles / bundle
            directory.mkdir(parents=True)
            (directory / 'MANIFEST.md').write_text('zip sha256: ' + 'd' * 64 + '\n')
        monkeypatch.setattr(m, 'BUNDLES_ROOT', bundles)
        self.classifiers = {}
        self.dirs = {}
        self.options = {}
        for name, bundle, resolved, timeouts, empties in (
                ('arm1', 'v012', 4, 4, 12), ('arm3', 'v012', 10, 21, 18), ('arm4', 'v014', 8, 16, 18)):
            self.dirs[name] = []
            for event, subset in (('smoke', self.ids[:2]), ('main', self.ids[2:])):
                directory = str(tmp_path / (name + '-' + event))
                self.dirs[name].append(directory)
                self.make_run(directory, subset, resolved, timeouts, empties)
            identity = tmp_path / (name + '-identity.json')
            write_json(identity, dict(records=[dict(event=event, bundles={bundle: dict(
                **{'pass': True}, zip_ok=True, content_ok=True, zip_sha256='d' * 64,
                manifest_zip_sha256='d' * 64, agent_yaml_sha256='a' * 64,
                zip_path='dist/31b-' + bundle + '.zip', only_in_zip=[], only_in_dir=[],
                byte_mismatch=[], duplicate_members=[])}) for event in ('smoke', 'main', 'chunk1')]))
            smoke, main = self.dirs[name]
            options = dict(identity_json=str(identity), bundle=bundle,
                           transports={smoke: 'b' * 64, main: 'b' * 64},
                           push_events={smoke: 'smoke', main: 'main'})
            smoke_json = tmp_path / (name + '-smoke.json')
            write_json(smoke_json, m.arm3smoke_metrics(smoke, self.classifiers[smoke][0], **{
                k: {smoke: v[smoke]} if isinstance(v, dict) else v for k, v in options.items()}))
            self.options[name] = dict(options, smoke_json=str(smoke_json))
        monkeypatch.setattr(m.base, 'PARTS', [
            (event, str(Path(d) / 'timing.jsonl'), *self.classifiers[d])
            for event, d in zip(('smoke', 'main'), self.dirs['arm1'])])
        self.base_json = str(tmp_path / 'base.json')
        self.bind_base()

    def make_run(self, directory, ids, resolved=8, timeouts=16, empties=18):
        directory = Path(directory)
        directory.mkdir()
        rows = [dict(instance_id=i, repo='repo', resolved=self.ids.index(i) < resolved,
                     timed_out=self.ids.index(i) < timeouts, agent_timeout_fired=False,
                     verified_patch_bytes=0 if self.ids.index(i) < empties else 1,
                     agent_clock_seconds=200, finalization_seconds=10, patch_submitted=False,
                     test_files_edited=[], stray_files=[], wall_seconds=dict(total=300, verification=20),
                     sandbox_setup_seconds=80) for i in ids]
        header = dict(_schema='synthetic', agent_yaml_sha256='a' * 64, bundle_sha256='b' * 64,
                      kernel_code={'agent_path_sha256': 'c' * 64, 'verification_path_sha256': 'e' * 64})
        timing = directory / 'timing.jsonl'
        timing.write_text('\n'.join(map(json.dumps, [header, *rows, {'_vllm': {'startup_seconds': 1}}])) + '\n')
        paths = []
        for filename, sha in (('d4.json', m.base.D4_SHA), ('a2.json', m.base.A2_SHA)):
            path = directory / filename
            write_json(path, dict(classifier_sha256=sha, input_sha256=m.base.sha(timing),
                                 rows=[dict(instance_id=i, h=None, known_diag=False) for i in ids]))
            paths.append(str(path))
        self.classifiers[str(directory)] = paths
        for iid in ids:
            trace = directory / 'runs' / iid / 'trace.json'
            trace.parent.mkdir(parents=True)
            write_json(trace, dict(summary={'context_overflow': False}, entries=[
                dict(author=m.ROOT, type='thinking', content='synthetic thought')] * 3))

    def bind_base(self):
        result = m.arm3_metrics('arm1', self.dirs['arm3'], [], self.classifiers, **self.options['arm3'])
        assert result['decision'] == 'ON-BETTER-VETOED'
        write_json(self.base_json, result)

    def mutate(self, arm, fn):
        for directory in self.dirs[arm]:
            timing = Path(directory) / 'timing.jsonl'
            documents = [json.loads(line) for line in timing.read_text().splitlines()]
            for doc in documents:
                if 'instance_id' in doc:
                    fn(doc, self.ids.index(doc['instance_id']))
            timing.write_text('\n'.join(map(json.dumps, documents)) + '\n')
            for classifier in self.classifiers[directory]:
                doc = json.loads(Path(classifier).read_text())
                doc['input_sha256'] = m.base.sha(timing)
                doc['rows'] = [row for row in doc['rows'] if any(d.get('instance_id') == row['instance_id'] for d in documents)]
                write_json(classifier, doc)

    def trace(self, arm, index, entries, **extra):
        directory = self.dirs[arm][index >= 2]
        path = Path(directory) / 'runs' / self.ids[index] / 'trace.json'
        write_json(path, dict(entries=entries, **extra))

    def result(self):
        return m.arm4_metrics(self.dirs['arm4'], self.dirs['arm3'], self.dirs['arm1'],
                              self.classifiers, base_json=self.base_json, **self.options['arm4'])

    def argv(self, explicit_classifiers=True):
        options = self.options['arm4']
        out = ['metrics', 'arm4', '--arm4-dirs', ','.join(self.dirs['arm4']), '--base-dirs',
               *self.dirs['arm3'], '--arm1-dirs', ','.join(self.dirs['arm1']), '--base-json', self.base_json,
               '--smoke-json', options['smoke_json'], '--identity-json', options['identity_json'],
               '--bundle', 'v014', '--out', str(self.root / 'out.json')]
        for directory in self.dirs['arm4']:
            out.extend(['--transport', directory + '=' + options['transports'][directory],
                        '--push-event', directory + '=' + options['push_events'][directory]])
        if explicit_classifiers:
            for directory, pair in self.classifiers.items():
                out.extend(['--classifiers', directory + '=' + ','.join(pair)])
        return out


@pytest.fixture
def experiment(tmp_path, monkeypatch):
    return Experiment(tmp_path, monkeypatch)


def test_vetoed_valid_base_and_primary_statistics(experiment):
    result = experiment.result()
    assert result['decision'] == '2048-ADOPT'
    assert result['decision_inputs']['base_valid']
    assert result['primary'] == dict(arm4_only=m._id_count([]), comparator_only=m._id_count(experiment.ids[8:10]),
                                    D=2, p=.5, arm4_resolved=m.base.rate(8, 33), arm3_resolved=m.base.rate(10, 33))
    assert all(arm['n_rows'] == 33 for arm in result['arms'].values())
    assert result['_schema']['script_sha256'] == m.base.sha(m.__file__)
    assert result['_schema']['name'] == 'plan008_metrics/v1'
    assert result['_schema']['mode'] == 'arm4'
    assert result['_schema']['definitions']['limits'].startswith('ABSOLUTE')
    assert result['_schema']['input_shas'][experiment.base_json] == m.base.sha(experiment.base_json)
    for pair in experiment.classifiers.values():
        for classifier in pair:
            assert result['_schema']['input_shas'][classifier] == m.base.sha(classifier)


@pytest.mark.parametrize('resolved,expected', [(8, '2048-ADOPT'), (7, '2048-WORSE'), (12, '2048-ADOPT')])
def test_D_boundaries(experiment, resolved, expected):
    experiment.mutate('arm4', lambda row, i: row.update(resolved=i < resolved))
    # Smoke evidence is tied to its exact timing bytes; keep smoke rows unchanged here.
    result = experiment.result()
    assert result['decision'] == expected
    assert result['primary']['D'] == 10 - resolved


@pytest.mark.parametrize('metric,count,expected', [
    ('timeouts', 16, '2048-ADOPT'), ('timeouts', 17, '2048-NO-GAIN'),
    ('empties', 18, '2048-ADOPT'), ('empties', 19, '2048-NO-GAIN')])
def test_absolute_limits(experiment, metric, count, expected):
    experiment.mutate('arm4', lambda row, i: row.update(
        **({'timed_out': i < count} if metric == 'timeouts' else {'verified_patch_bytes': 0 if i < count else 1})))
    assert experiment.result()['decision'] == expected


def test_limit_before_safety(experiment):
    experiment.mutate('arm4', lambda row, i: row.update(timed_out=i < 17, test_files_edited=['tests/test_x.py'] if i == 3 else []))
    result = experiment.result()
    assert not result['decision_inputs']['safety_checks']['test_files_edited']
    assert result['decision'] == '2048-NO-GAIN'


@pytest.mark.parametrize('branch', ['adopt', 'worse', 'no_gain', 'veto'])
def test_invalid_H_precedes_every_branch(experiment, branch):
    experiment.mutate('arm4', lambda row, i: row.update(
        resolved=i < (7 if branch == 'worse' else 8), timed_out=i < (17 if branch == 'no_gain' else 16),
        agent_clock_seconds=220.0001 if branch == 'veto' and i == 4 else 200))
    path = experiment.classifiers[experiment.dirs['arm4'][1]][0]
    classifier = json.loads(Path(path).read_text())
    for row in classifier['rows'][:5]:
        row['h'] = 'H'
    write_json(path, classifier)
    result = experiment.result()
    assert result['arms']['arm4']['h_rows']['count'] == 5
    assert result['arms']['arm4']['resolved']['n'] == 33
    assert result['decision'] == 'INVALID'


@pytest.mark.parametrize('field,value,expected', [
    ('agent_clock_seconds', 220, '2048-ADOPT'), ('agent_clock_seconds', 220.0001, 'VETOED'),
    ('finalization_seconds', 30, '2048-ADOPT'), ('finalization_seconds', 30.0001, 'VETOED'),
    ('agent_clock_seconds', None, 'VETOED'), ('finalization_seconds', float('nan'), 'VETOED')])
def test_timing_unrounded(experiment, field, value, expected):
    experiment.mutate('arm4', lambda row, i: row.update({field: value}) if i == 2 else None)
    assert experiment.result()['decision'] == expected


@pytest.mark.parametrize('epsilon,expected', [(0, '2048-ADOPT'), (.0001, 'VETOED')])
def test_wall_p90_boundary(experiment, epsilon, expected):
    experiment.mutate('arm4', lambda row, i: row['wall_seconds'].update(total=1.10 * 300 + epsilon) if i >= 2 else None)
    result = experiment.result()
    assert result['arms']['arm4']['safety']['total_wall_p90'] == 330
    assert result['decision'] == expected


@pytest.mark.parametrize('arm', ['arm4', 'arm3'])
@pytest.mark.parametrize('field', ['stray_files', 'test_files_edited', 'wall_seconds', 'verified_patch_bytes', 'resolved', 'timed_out'])
def test_missing_row_evidence_fails(experiment, arm, field):
    experiment.mutate(arm, lambda row, i: row.pop(field) if i == 2 else None)
    assert experiment.result()['decision'] != '2048-ADOPT'


@pytest.mark.parametrize('evidence', ['trace', 'classifier', 'identity', 'smoke', 'base'])
def test_missing_files_fail_cli(experiment, evidence):
    path = (Path(experiment.dirs['arm4'][1]) / 'runs' / experiment.ids[3] / 'trace.json' if evidence == 'trace' else
            Path(experiment.classifiers[experiment.dirs['arm4'][1]][0]) if evidence == 'classifier' else
            Path(experiment.base_json) if evidence == 'base' else
            Path(experiment.options['arm4'][evidence + '_json']))
    path.unlink()
    m.main(experiment.argv())
    result = json.loads((experiment.root / 'out.json').read_text())
    assert result['decision'] == 'INVALID'


@pytest.mark.parametrize('arm', ['arm4', 'arm3', 'arm1'])
def test_incomplete_inventory_no_decision_and_nonzero_exit(experiment, arm):
    timing = Path(experiment.dirs[arm][1]) / 'timing.jsonl'
    documents = [json.loads(line) for line in timing.read_text().splitlines()]
    timing.write_text('\n'.join(json.dumps(d) for d in documents if d.get('instance_id') != experiment.ids[-1]) + '\n')
    assert m.main(experiment.argv()) == 3
    result = json.loads((experiment.root / 'out.json').read_text())
    assert result['status'] == 'NO_DECISION'
    assert result['decision'] is result['verdict'] is None
    assert 'primary' not in result


@pytest.mark.parametrize('count,base_count,expected', [
    (10, 7, '2048-ADOPT'), (11, 7, 'VETOED'), (11, 20, 'VETOED')])
def test_d735_both_arms_and_absolute_swt(experiment, count, base_count, expected):
    # Explicit flag disagrees with trace: no candidate => D73.5 worst case.
    for arm, n in (('arm4', count), ('arm3', base_count)):
        experiment.mutate(arm, lambda row, i: row.update(patch_submitted=2 <= i < n + 2))
    experiment.bind_base()
    result = experiment.result()
    assert result['arms']['arm4']['safety']['submitted_without_test']['count'] == count
    assert result['arms']['arm3']['safety']['submitted_without_test']['count'] == base_count
    assert result['decision'] == expected


@pytest.mark.parametrize('test_first,expected', [(True, 0), (False, 1)])
def test_d735_test_must_precede_earliest_candidate(experiment, test_first, expected):
    for arm in ('arm4', 'arm3'):
        # Successful response conflicts with the explicit false flag, so D73.5 applies.
        submit = [
            dict(author=m.ROOT, type='tool_call', tool='submit_patch', args={}),
            dict(author=m.ROOT, type='tool_response', tool='submit_patch', result={'patch_size': 1})]
        test = [dict(author=m.ROOT, type='tool_call', tool='run_command', args={'command': 'python -m pytest'})]
        experiment.trace(arm, 2, test + submit if test_first else submit + test)
    experiment.bind_base()
    result = experiment.result()
    assert all(result['arms'][arm]['safety']['submitted_without_test']['count'] == expected for arm in ('arm4', 'arm3'))


def test_timeout_OR_counts_and_paired_empty_counts(experiment):
    experiment.mutate('arm4', lambda row, i: row.update(timed_out=False, agent_timeout_fired=i < 16) if i >= 2 else None)
    result = experiment.result()
    assert [result['arms'][a]['timeouts']['count'] for a in ('arm4', 'arm3', 'arm1')] == [16, 21, 4]
    assert [result['arms'][a]['safety']['empty_patch']['count'] for a in ('arm4', 'arm3', 'arm1')] == [18, 18, 12]
    assert result['comparisons']['arm3']['timeouts']['comparator_only']['count'] == 5
    assert result['comparisons']['arm1']['timeouts']['arm4_only']['count'] == 12

