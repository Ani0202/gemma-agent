    62	def _is_protected_test_or_config_path(rel_path: str) -> bool:
    63	    """Returns True if rel_path is a test file, conftest, or runner config that agent_patch must not tamper with."""
    64	    p = Path(rel_path)
    65	    name = p.name
    66	    if name in {
    67	        'conftest.py',
    68	        'pytest.ini',
    69	        'pyproject.toml',
    70	        'tox.ini',
    71	        'setup.cfg',
    72	        '.pytest.ini',
    73	        'sitecustomize.py',
    74	        'usercustomize.py',
    75	        '_swegemma_stubs.py',
    76	    }:
    77	        return True
    78	    if name.endswith('.pth'):
    79	        return True
    80	    if name.startswith('test_') and name.endswith('.py'):
    81	        return True
    82	    if name.endswith('_test.py'):
    83	        return True
    84	    parts = {part.lower() for part in p.parts[:-1]}
    85	    return bool({'tests', 'test', 'testing'} & parts and name.endswith('.py'))
