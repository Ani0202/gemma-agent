    56	def safe_path(value):
    57	    require(isinstance(value, str) and value and '\0' not in value,
    58	            'path must be a nonempty string without null bytes')
    59	    parts = value.replace('\\', '/').split('/')
    60	    require(not value.startswith(('/', '\\')) and not PureWindowsPath(value).drive
    61	            and '..' not in parts, f'unsafe path: {value!r} (absolute or ..)')
    62	    return value
