   174	class Bundle:
   175	    def __init__(self, root):
   176	        self.root = Path(root).absolute()
   177	        self.files = []
   178	        self.cache = {}
   179	        self.loading = []
   180	        self.models = set()
   181	        self.expanded_bytes = {}
   182	        self.agent_count = 0
   183	        self.instruction_chars = 0
   184	        self.skill_count = 0
   185	        self.agent_documents = set()
   186	        self.linted = set()
   187	
   188	    def target(self, value, base=None):
   189	        safe_path(value)
   190	        path = (base or self.root) / value
   191	        require(path.is_relative_to(self.root), f'path outside bundle: {value}')
   192	        require(path.is_file(), f'missing reference target: {value}')
   193	        require(path != self.root / 'MANIFEST.md', 'MANIFEST.md cannot be referenced: excluded from ZIP')
   194	        require(path in self.files, f'reference is not a bundle file: {value}')
   195	        return path
   196	
   197	    def load(self, path):
   198	        require(path not in self.loading, f'YAML reference/include cycle: {path}')
   199	        require(len(self.loading) <= 10, f'include depth exceeds 10: {path}')
   200	        if path in self.cache:
   201	            return self.cache[path]
   202	        self.loading.append(path)
   203	        try:
   204	            require(path.stat().st_size <= MAX_YAML_BYTES,
   205	                    f'YAML/include size exceeds {MAX_YAML_BYTES} bytes: {path}')
   206	            expanded = path.stat().st_size
   207	            source = path.read_text(encoding='utf-8')
   208	            require('\0' not in source, f'null bytes in {path}')
   209	            if path.suffix not in {'.yaml', '.yml'}:
   210	                require(path.suffix in {'.md', '.txt'}, f'unsupported !include target: {path}')
   211	                result = source
   212	            else:
   213	                def include(value):
   214	                    nonlocal expanded
   215	                    target = self.target(value, path.parent)
   216	                    result = self.load(target)
   217	                    expanded += self.expanded_bytes[target]
   218	                    require(expanded <= MAX_YAML_BYTES,
   219	                            f'cumulative !include size exceeds {MAX_YAML_BYTES} bytes: {path}')
   220	                    return result
   221	                if yaml is None:
   222	                    result = minimal_yaml(source, include)
   223	                else:
   224	                    class Loader(yaml.SafeLoader):
   225	                        pass
   226	                    def mapping(loader, node):
   227	                        result = {}
   228	                        for key_node, value_node in node.value:
   229	                            key = loader.construct_object(key_node)
   230	                            require(isinstance(key, str) and key not in result,
   231	                                    f'invalid or duplicate YAML key in {path}')
   232	                            result[key] = loader.construct_object(value_node)
   233	                        return result
   234	                    Loader.add_constructor('tag:yaml.org,2002:map', mapping)
   235	                    Loader.add_constructor('!include', lambda loader, node: include(loader.construct_scalar(node)))
   236	                    result = yaml.load(source, Loader=Loader)
   237	            self.expanded_bytes[path] = expanded
   238	            self.cache[path] = result
   239	            return result
   240	        except (ValueError, UnicodeError) as exc:
   241	            raise Invalid(f'{path}: {exc}') from exc
   242	        except Exception as exc:
   243	            if yaml is not None and isinstance(exc, yaml.YAMLError):
   244	                raise Invalid(f'{path}: YAML parse failed: {exc}') from exc
   245	            raise
   246	        finally:
   247	            self.loading.pop()
   248	
   249	    def prompt(self, value, where):
   250	        if isinstance(value, str):
   251	            bad = set(re.findall(r'\{([A-Za-z_][\w.-]*\??)\}', value)) - {'problem_description'}
   252	            require(not bad, f'{where}: forbidden placeholder(s): {sorted(bad)}')
   253	
   254	    def walk(self, value, where, ancestors=(), agent=False):
   255	        if isinstance(value, str):
   256	            require('\0' not in value, f'{where}: null bytes in text')
   257	        if agent:
   258	            require(isinstance(value, (dict, list)), f'{where}: agent must be a mapping')
   259	        if isinstance(value, (dict, list)):
   260	            require(id(value) not in ancestors, f'{where}: recursive YAML alias')
   261	            ancestors = (*ancestors, id(value))
   262	            if id(value) in self.linted:
   263	                return
   264	            self.linted.add(id(value))
   265	        if isinstance(value, list):
   266	            for index, item in enumerate(value):
   267	                self.walk(item, f'{where}[{index}]', ancestors, agent)
   268	        elif isinstance(value, dict):
   269	            for key, item in value.items():
   270	                label = f'{where}.{key}'
   271	                if key == 'config_path':
   272	                    target = self.target(item)
   273	                    require(target.suffix in {'.yaml', '.yml'}, f'{label}: config_path must reference YAML')
   274	                    # Reference cycles are checked separately using the document graph.
   275	                    self.load(target)
   276	                elif key == 'adapter' and item is not None:
   277	                    require(isinstance(item, str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', item)
   278	                            and item != '..', f'{label}: invalid adapter name')
   279	                    for filename in ('adapter_config.json', 'adapter_model.safetensors'):
   280	                        self.target(f'adapters/{item}/{filename}')
   281	                elif key == 'generate_content_config' and item is not None:
   282	                    require(isinstance(item, dict), f'{label}: must be a mapping')
   283	                    require(not item.keys() - GENERATION_FIELDS,
   284	                            f'{label}: forbidden or unknown fields: {sorted(item.keys() - GENERATION_FIELDS)}')
   285	                elif key == 'thinking_config':
   286	                    self.thinking(item, label)
   287	                elif key == 'max_output_tokens':
   288	                    require(type(item) is int and 1 <= item <= 32768, f'{label}: must be integer 1..32768')
   289	                if 'instruction' in key or 'prompt' in key:
   290	                    self.prompt(item, label)
   291	                self.walk(item, label, ancestors, key in {'sub_agents', 'agent_tool'})
   292	
   293	    def agent(self, value, where, depth=0, active=()):
   294	        """Count compiled occurrences, including repeated references and YAML aliases."""
   295	        require(depth <= MAX_DEPTH, f'{where}: agent depth exceeds {MAX_DEPTH}')
   296	        require(len(active) <= MAX_DEPTH + 1, f'{where}: config_path depth exceeds {MAX_DEPTH}')
   297	        require(isinstance(value, dict), f'{where}: agent must be a mapping')
   298	        if 'agent_tool' in value:
   299	            require(set(value) == {'agent_tool'}, f'{where}: invalid agent_tool wrapper')
   300	            return self.agent(value['agent_tool'], where + '.agent_tool', depth, active)
   301	        if 'config_path' in value:
   302	            require(not set(value) - {'config_path', 'skip_summarization'},
   303	                    f'{where}: invalid config reference')
   304	            target = self.target(value['config_path'])
   305	            require(target not in active, f'config_path cycle: {target}')
   306	            self.agent_documents.add(target)
   307	            return self.agent(self.load(target), str(target), depth, (*active, target))
   308	        self.agent_documents.update(path for path, doc in self.cache.items() if doc is value)
   309	        self.agent_count += 1
   310	        require(self.agent_count <= MAX_AGENTS, f'max_agents exceeds {MAX_AGENTS}')
   311	        name = value.get('name')
   312	        require(isinstance(name, str) and name.strip(), f'{where}: agent name required')
   313	        kind = value.get('agent_class', 'LlmAgent')
   314	        require(isinstance(kind, str) and kind in {'LlmAgent', 'SequentialAgent', 'ParallelAgent', 'LoopAgent'},
   315	                f'{where}: unsupported agent_class')
   316	        # Repository policy requires explicit identical models even on workflows.
   317	        model = value.get('model')
   318	        require(isinstance(model, str) and model in MODELS,
   319	                f'{where}: missing or disallowed model: {model!r}')
   320	        self.models.add(model)
   321	        chars = 0
   322	        for key in ('instruction', 'global_instruction', 'description'):
   323	            if key in value:
   324	                require(isinstance(value[key], str), f'{where}.{key}: must be text')
   325	                if key == 'description':
   326	                    require(len(value[key]) <= MAX_INSTRUCTION_CHARS,
   327	                            f'{where}: description too long')
   328	                else:
   329	                    chars += len(value[key])
   330	        require(chars <= MAX_INSTRUCTION_CHARS, f'{where}: instruction chars exceed {MAX_INSTRUCTION_CHARS}')
   331	        self.instruction_chars += chars
   332	        require(self.instruction_chars <= MAX_TOTAL_INSTRUCTION_CHARS,
   333	                f'total instruction chars exceed {MAX_TOTAL_INSTRUCTION_CHARS}')
   334	        if kind == 'LoopAgent':
   335	            count = value.get('max_iterations', 500)
   336	            require(type(count) is int and 1 <= count <= 500,
   337	                    f'{where}: max_iterations must be integer 1..500')
   338	        skills = value.get('skills', [])
   339	        if skills is None:
   340	            skills = []
   341	        require(isinstance(skills, list), f'{where}: skills must be a list')
   342	        self.skill_count += len(skills)
   343	        require(self.skill_count <= MAX_SKILLS, f'max_skills exceeds {MAX_SKILLS}')
   344	        for skill in skills:
   345	            safe_path(skill)
   346	            directory = self.root / skill
   347	            require(directory.is_dir(), f'{where}: missing skill directory: {skill}')
   348	            require(directory / 'SKILL.md' in self.files, f'{where}: skill requires SKILL.md: {skill}')
   349	            size = sum(p.stat().st_size for p in self.files if p.is_relative_to(directory))
   350	            require(size <= MAX_SKILL_BYTES, f'{where}: skill size exceeds {MAX_SKILL_BYTES}')
   351	        tools = value.get('tools', [])
   352	        require(isinstance(tools, list), f'{where}: tools must be a list')
   353	        for index, tool in enumerate(tools):
   354	            label = f'{where}.tools[{index}]'
   355	            if isinstance(tool, str):
   356	                require(tool in TOOLS, f'{label}: unknown harness tool: {tool}')
   357	            else:
   358	                self.agent(tool, label, depth + 1, active)
   359	        children = value.get('sub_agents', [])
   360	        require(isinstance(children, list), f'{where}: sub_agents must be a list')
   361	        for index, child in enumerate(children):
   362	            self.agent(child, f'{where}.sub_agents[{index}]', depth + 1, active)
   363	
   364	    def thinking(self, config, where):
   365	        require(isinstance(config, dict), f'{where}: must be a mapping')
   366	        require(not config.keys() - {'thinking_budget', 'thinking_level', 'include_thoughts'}, f'{where}: unknown fields')
   367	        if 'thinking_budget' in config:
   368	            budget = config['thinking_budget']
   369	            require(type(budget) is int and 0 <= budget <= 32768, f'{where}: thinking_budget must be integer 0..32768')
   370	        if 'thinking_level' in config:
   371	            level = config['thinking_level']
   372	            require(isinstance(level, str) and level.upper() in {'MINIMAL', 'LOW', 'MEDIUM', 'HIGH', 'NONE'}, f'{where}: invalid thinking_level')
   373	        if 'include_thoughts' in config:
   374	            require(type(config['include_thoughts']) is bool, f'{where}: include_thoughts must be boolean')
   375	
   376	    def validate(self):
   377	        require(self.root.is_dir() and not self.root.is_symlink(), f'not a bundle directory (or symlink): {self.root}')
   378	        total = 0
   379	        yaml_count = 0
   380	        for directory, dirs, files in os.walk(self.root, followlinks=False):
   381	            for name in sorted(dirs + files):
   382	                path = Path(directory) / name
   383	                safe_path(path.relative_to(self.root).as_posix())
   384	                mode = path.lstat().st_mode
