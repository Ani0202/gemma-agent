   824	    submitted = bool(context.patch_submitted) if context is not None else None
   825	    return dict(agent_timeout_seconds=current.get('agent_timeout_seconds'),
   826	        agent_clock_seconds=difference('timeout_exit', 'timeout_enter'),
   827	        agent_timeout_fired=current.get('agent_timeout_fired'),
