   618	            setup_row = next(c for c in reversed(current['setup_calls']) if c['step'] == 'setup.py')
   619	            setup_row['subprocesses'] = calls
   620	            setup_row['retrying_lines'] += sum(c['retrying_lines'] for c in calls)
   621	            current['retrying_lines'] = sum(c['retrying_lines'] for c in current['setup_calls'])
   622	            editable = [c for c in calls if isinstance(c['argv'], list) and '-e' in c['argv']]
