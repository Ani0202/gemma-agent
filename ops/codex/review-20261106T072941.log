   829	        finalization_exec=current.get('finalization_exec', []),
   830	        teardown_seconds=current.get('sandbox_stop_duration'),
   831	        phase1_wall_seconds=phase1, phase1_source=source,
   832	        pre_agent_seconds=difference('timeout_enter', 'sandbox_start_begin'),
   833	        post_phase1_seconds=total - phase1, patch_submitted=submitted,
