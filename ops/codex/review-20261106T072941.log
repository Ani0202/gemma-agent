   773	def observe_sandbox(original, state, name):
   774	    """Forward identical arguments/results/exceptions and time sandbox boundaries."""
   775	    async def observed(*args, **kwargs):
   776	        current = state.get(None)
   777	        start = time.perf_counter()
   778	        row = None
   779	        if current is not None:
   780	            if name == 'sandbox_start':
   781	                current['sandbox_start_begin'] = start
   782	            elif name == 'sandbox_exec' and current.get('timeout_exit') is not None:
   783	                cmd = args[2] if len(args) > 2 else kwargs.get('command', kwargs.get('cmd', ''))
   784	                row = dict(cmd=str(cmd)[:40], duration_s=None, rc=None)
   785	                current.setdefault('finalization_exec', []).append(row)
   786	        try:
   787	            result = await original(*args, **kwargs)
   788	            if row is not None:
   789	                row['rc'] = getattr(result, 'exit_code', None)
   790	            return result
   791	        except BaseException as exc:
   792	            if row is not None:
   793	                row['exception'] = type(exc).__name__
   794	            raise
   795	        finally:
   796	            end = time.perf_counter()
   797	            if current is not None:
   798	                if name in ('sandbox_start', 'sandbox_stop'):
   799	                    current[name + '_end'] = end
   800	                    current[name + '_duration'] = end - start
   801	                if row is not None:
   802	                    row['duration_s'] = end - start
   803	    return observed
