   243	def record_distributions(docker, container_id, repo, row):
   244	    # Query the same interpreter and metadata selection pip uses, never host metadata.
   245	    package = repo.rsplit('/', 1)[-1].lower()
   246	    probe = """import json
   247	from importlib.metadata import distribution, PackageNotFoundError
   248	names = NAMES
   249	result = {}
   250	for name in names:
   251	    try:
   252	        d = distribution(name)
   253	        result[name] = dict(location=str(d.locate_file('')), version=d.version,
   254	                            metadata_location=str(d._path), record_exists=d.read_text('RECORD') is not None)
   255	    except PackageNotFoundError:
   256	        result[name] = dict(location=None, version=None, metadata_location=None, record_exists=False)
   257	print(json.dumps(result))
   258	""".replace('NAMES', repr([package]))
   259	    # Diagnostic only: a probe problem must never change the harness path.
   260	    try:
   261	        result = docker.exec(container_id, 'python3 -c ' + shlex.quote(probe), timeout=30)
   262	        row['dist_probe_rc'] = result.exit_code
   263	        if result.exit_code != 0:
   264	            row['dist_probe_error'] = 'rc'
   265	            return
   266	        row['distributions'] = json.loads(result.stdout)
   267	    except Exception as exc:
   268	        row['dist_probe_error'] = type(exc).__name__
