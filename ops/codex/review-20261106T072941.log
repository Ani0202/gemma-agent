   187	def compatible_wheels(wheels, tags, requirement=None):
   188	    """Highest version per distribution, with sandbox PEP 425 tags (never host tags)."""
   189	    from packaging.utils import canonicalize_name, parse_wheel_filename
   190	    rank = {tag: i for i, tag in enumerate(tags)}
   191	    selected = {}
   192	    for path in sorted(Path(wheels).glob('*.whl')):
   193	        name, version, build, wheel_tags = parse_wheel_filename(path.name)
   194	        if requirement is not None and (name != canonicalize_name(requirement.name) or version not in requirement.specifier):
   195	            continue
   196	        matches = [rank[str(tag)] for tag in wheel_tags if str(tag) in rank]
   197	        if not matches:
   198	            continue
   199	        score = (version, -min(matches), build)
   200	        if name not in selected or score > selected[name][0]:
   201	            selected[name] = (score, path)
   202	    return {name: item[1] for name, item in selected.items()}
