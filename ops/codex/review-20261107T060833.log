    52	def pct(vals, q):
    53	    vals = sorted(v for v in vals if v is not None)
    54	    if not vals:
    55	        return None
    56	    i = (len(vals) - 1) * q
    57	    lo, hi = math.floor(i), math.ceil(i)
    58	    return round(vals[lo] + (vals[hi] - vals[lo]) * (i - lo), 1)
