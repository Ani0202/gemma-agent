    38	def wilson(k, n, z=1.959963984540054):
    39	    if n == 0:
    40	        return None
    41	    p = k / n
    42	    d = 1 + z * z / n
    43	    c = (p + z * z / (2 * n)) / d
    44	    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
    45	    return [round(max(0.0, c - h), 4), round(min(1.0, c + h), 4)]
    46	
    47	
    48	def rate(k, n):
    49	    return dict(k=k, n=n, rate=round(k / n, 4) if n else None, wilson95=wilson(k, n))
