   506	def install_editable_package(docker: BaseSandboxManager, container_id: str) -> None:
   507	    """Installs the workspace package in editable mode using pre-cached wheels.
   508	
   509	    Uses --no-deps to prevent pip from resolving and potentially installing incompatible
   510	    wheel versions over the container's pre-configured environment.
   511	    """
