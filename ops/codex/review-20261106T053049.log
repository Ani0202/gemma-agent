    81	def _measure_expanded_size(
    82	    data: Any,
    83	    max_chars: int,
    84	    max_nodes: int = 50_000,
    85	) -> int:
    86	    """Measure expanded character size of parsed YAML data, aborting immediately if limits are exceeded."""
    87	    total_chars = 0
    88	    visited_nodes = 0
    89	    stack: list[Any] = [data]
    90	    while stack:
    91	        curr = stack.pop()
    92	        visited_nodes += 1
    93	        if visited_nodes > max_nodes:
    94	            raise LimitExceededError(
    95	                f"Expanded YAML node count ({visited_nodes:,}) exceeds limit ({max_nodes:,}); "
    96	                "possible YAML anchor bomb"
    97	            )
    98	        if isinstance(curr, dict):
    99	            total_chars += 2
   100	            for k, v in curr.items():
   101	                total_chars += len(str(k)) + 4
   102	                if total_chars > max_chars:
   103	                    raise LimitExceededError(
   104	                        f"Expanded YAML size ({total_chars:,} chars) exceeds limit ({max_chars:,})"
   105	                    )
   106	                stack.append(v)
   107	        elif isinstance(curr, list):
   108	            total_chars += 2 + max(0, len(curr) * 2)
   109	            if total_chars > max_chars:
   110	                raise LimitExceededError(
   111	                    f"Expanded YAML size ({total_chars:,} chars) exceeds limit ({max_chars:,})"
   112	                )
   113	            stack.extend(curr)
   114	        else:
   115	            total_chars += len(str(curr))
   116	            if total_chars > max_chars:
   117	                raise LimitExceededError(
   118	                    f"Expanded YAML size ({total_chars:,} chars) exceeds limit ({max_chars:,})"
   119	                )
   120	    return total_chars
   121	
