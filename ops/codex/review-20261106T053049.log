   388	    thinking_budget: int | float | None = None
   389	
   390	    if thinking_cfg is not None:
   391	        if isinstance(thinking_cfg, dict):
   392	            include_thoughts = thinking_cfg.get("include_thoughts")
   393	            raw_level = thinking_cfg.get("thinking_level")
   394	            thinking_budget = thinking_cfg.get("thinking_budget")
   395	        else:
   396	            include_thoughts = getattr(thinking_cfg, "include_thoughts", None)
   397	            raw_level = getattr(thinking_cfg, "thinking_level", None)
   398	            thinking_budget = getattr(thinking_cfg, "thinking_budget", None)
   399	
   400	        if raw_level is not None:
   401	            level_str = str(getattr(raw_level, "value", raw_level)).lower()
   402	
   403	        has_budget = thinking_budget is not None and not isinstance(
   404	            thinking_budget, bool
   405	        )
   406	
   407	        if level_str == "none" or (has_budget and int(thinking_budget) <= 0):
   408	            enable_thinking = False
   409	        elif (
   410	            level_str in {"minimal", "low", "medium", "high"}
   411	            or (has_budget and int(thinking_budget) > 0)
   412	        ):
   413	            enable_thinking = True
   414	        elif include_thoughts is False:
   415	            enable_thinking = False
   416	        elif include_thoughts is True:
   417	            enable_thinking = True
