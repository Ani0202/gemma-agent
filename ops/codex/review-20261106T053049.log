   359	def apply_thinking_config_to_model(model: Any, gen_config: Any) -> Any:
   360	    """Attach thinking_config and seed from GenerateContentConfig to LiteLlm._additional_args.
   361	
   362	    Because ADK's LiteLlm._get_completion_inputs() does not forward Google GenAI
   363	    thinking_config or seed to OpenAI-compatible endpoints (like vLLM), this bridges
   364	    thinking_level, thinking_budget, include_thoughts, and seed into
   365	    extra_body.chat_template_kwargs.enable_thinking, extra_body.thinking_token_budget,
   366	    reasoning_effort, and seed on a cloned model instance.
   367	    """
