    14	def first_ok_edit(run, tid):
    15	    d = json.load(open(f"{run}/runs/{tid}/trace.json"))
    16	    t0 = next(e["elapsed_s"] for e in d["entries"] if e["type"] == "task_prompt")
    17	    pending = []
    18	    for e in d["entries"]:
    19	        if e["type"] == "tool_call":
    20	            pending.append(e.get("tool"))
    21	        elif e["type"] == "tool_response":
    22	            tool = e.get("tool") or (pending.pop(0) if pending else None)
    23	            if e.get("tool") in pending:
    24	                pending.remove(e.get("tool"))
    25	            if tool in ("edit_file", "write_file") and classify(tool, _load(e.get("result", "")))[1]:
    26	                return round(float(e["elapsed_s"]) - float(t0), 3), tool
    27	    return None, None
