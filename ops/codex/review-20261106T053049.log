   369	
   370	    if model is None or gen_config is None:
   371	        return model
   372	
   373	    if not hasattr(model, "_additional_args") or not isinstance(model._additional_args, dict):
   374	        return model
   375	
   376	    if isinstance(gen_config, dict):
   377	        seed = gen_config.get("seed")
   378	        thinking_cfg = gen_config.get("thinking_config")
   379	    else:
   380	        seed = getattr(gen_config, "seed", None)
   381	        thinking_cfg = getattr(gen_config, "thinking_config", None)
   382	
   383	    has_valid_seed = seed is not None and not isinstance(seed, bool)
