   422	    import copy
   423	
   424	    cloned = copy.copy(model)
   425	    additional_args = copy.deepcopy(model._additional_args)
   426	    if isinstance(include_thoughts, bool):
   427	        cloned.__dict__["_adk_include_thoughts"] = include_thoughts
   428	    else:
   429	        cloned.__dict__.pop("_adk_include_thoughts", None)
   430	
   431	    if has_valid_seed:
   432	        additional_args["seed"] = int(seed)  # type: ignore[arg-type]
   433	
   434	    if enable_thinking is not None:
   435	        extra_body = dict(additional_args.get("extra_body") or {})
   436	        chat_template_kwargs = dict(extra_body.get("chat_template_kwargs") or {})
   437	        chat_template_kwargs["enable_thinking"] = enable_thinking
   438	        extra_body["chat_template_kwargs"] = chat_template_kwargs
   439	
   440	        if (
   441	            enable_thinking
   442	            and thinking_budget is not None
   443	            and not isinstance(thinking_budget, bool)
   444	            and int(thinking_budget) > 0
