    def verified_records(procs, records):
        """A status pid/PGID alone is never proof of current job ownership."""
        if not records:
            return []
        # Compare the full bash -c wrapper body with our installed bin/job. Fail closed
        # if its layout changes; substring matches could admit unrelated shell scripts.
        source = read(os.path.join(REPO, "bin/job")) or ""
