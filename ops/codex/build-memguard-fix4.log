#!/usr/bin/env python3
"""bin/memguard: unprivileged userspace memory watchdog for this shared VM (dec 021).

Protects Etho (and the Claude sessions) from our own runaway work. No sudo, no systemd.
Every --interval seconds (default 2):
  1. Find TARGETS, only processes of our own uid that are either
     (i)  carrying the bin/job env marker (GEMMA_JOB_CAP=... in /proc/<pid>/environ), i.e. bin/job
          descendants, including orphans re-parented away from their wrapper; or
     (ii) cwd under /home/ubuntu/work/gemma or /tmp, RSS > 3G, and comm not a session process
          (claude/node/codex/tmux, or a bash/sh whose parent is one of those).
     Session processes and all memguard jobs/wrappers are excluded from both sets.
  2. Raise oom_score_adj to 1000 on every target (unprivileged), so the kernel picks us first.
  3. Group by exact GEMMA_JOB_ID when present; retain legacy member identities.
     Marked orphans outside running groups remain targets in an orphan job.
  4. On memory pressure, kill eligible members of the largest job, allowing its wrapper
     3 seconds to record failure. Re-inventory for up to 5 seconds, including new forks.
Reads only /proc/<pid>/{status,stat,environ,cwd,cmdline} of our own uid; writes oom_score_adj.
Python stdlib only. No process-group signals: every recipient must pass the allowlist.
Usage: bin/memguard [--once] [--dry-run] [--interval S] [--min-available G] [--max-total G]
                    [--unmarked-rss G] [--marker NAME] [--roots DIR,DIR] [--log PATH] [--no-mail]
"""
import argparse, errno, os, signal, subprocess, sys, threading, time
from pathlib import Path

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GIB = 1024 ** 3
SESSION_COMMS = {"claude", "node", "codex", "tmux", "tmux: server", "tmux: client"}
SHELL_COMMS = {"bash", "sh", "dash", "zsh"}
UID = os.getuid()


def read(path, mode="r"):
    try:
        with open(path, mode) as f:
            return f.read()
    except OSError:
        return None


def mem_available():
    txt = read("/proc/meminfo") or ""
    for line in txt.splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) * 1024
    return None


def proc_stat(pid):
    raw = read(f"/proc/{pid}/stat")
    if not raw:
        return None
    try:
        fields = raw.rsplit(") ", 1)[1].split()
        return {"state": fields[0], "ppid": int(fields[1]),
                "pgid": int(fields[2]), "starttime": int(fields[19])}
    except (IndexError, ValueError):
        return None


def proc_info(pid):
    """Read only our uid's processes, binding status to a stable stat identity."""
    try:
        if os.stat(f"/proc/{pid}").st_uid != UID:
            return None
    except OSError:
        return None
    before = proc_stat(pid)
    st = read(f"/proc/{pid}/status")
    after = proc_stat(pid)
    if not before or not after or before["starttime"] != after["starttime"] or st is None:
        return None
    d = {"pid": pid, "rss": 0, "uid": None, "comm": "", **after}
    for line in st.splitlines():
        k, _, v = line.partition(":")
        if k == "Name":
            d["comm"] = v.strip()
        elif k == "Uid":
            d["uid"] = int(v.split()[0])
        elif k == "VmRSS":
            d["rss"] = int(v.split()[0]) * 1024
    return d if d["uid"] == UID else None


def snapshot():
    procs = {}
    for name in os.listdir("/proc"):
        if name.isdigit():
            d = proc_info(int(name))
            if d:
                procs[d["pid"]] = d
    return procs


def marker_value(pid, marker):
    env = read(f"/proc/{pid}/environ", "rb") or b""
    key = marker.encode() + b"="
    for entry in env.split(b"\0"):
        if entry.startswith(key):
            return entry[len(key):]  # Empty marker values still count as marked.
    return None


def cwd_of(pid):
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return ""


def under(path, roots):
    return any(path == r or path.startswith(r.rstrip("/") + "/") for r in roots)


def ancestors(pid, procs):
    out, seen = [], set()
    p = procs.get(pid, {}).get("ppid", 0)
    while p and p in procs and p not in seen:
        seen.add(p); out.append(p); p = procs[p]["ppid"]
    return out


def descendants(root, procs):
    kids = {}
    for d in procs.values():
        kids.setdefault(d["ppid"], []).append(d["pid"])
    out, stack = [], [root]
    while stack:
        for c in kids.get(stack.pop(), []):
            if c not in out:
                out.append(c); stack.append(c)
    return out


def is_session(pid, procs):
    d = procs[pid]
    return (d["comm"] in SESSION_COMMS or
            (d["comm"] in SHELL_COMMS and
             any(procs[a]["comm"] in SESSION_COMMS for a in ancestors(pid, procs))))


def running_jobs():
    """Legacy three-field, current four-field, and longer (extra trailing fields) status records."""
    records = []
    for path in sorted(Path(REPO, "ops/jobs").glob("*.status")):
        fields = (read(path) or "").split()
        # >=3: legacy 3-field, current 4-field, and the proposed owner patch's extra identity fields.
        if len(fields) < 3 or fields[0] != "running":
            continue
        try:
            pid = int(fields[1])
            pgid = int(fields[3]) if len(fields) >= 4 else None
        except ValueError:
            continue
        record = {"name": path.stem, "pid": pid, "pgid": pgid}
        if len(fields) >= 6:
            record.update(boot_id=fields[4], starttime=fields[5],
                          job_id=f"{path.stem}/{fields[4]}/{fields[5]}".encode())
        records.append(record)
    return records


def job_name(root, procs, records):
    """Use status metadata only; never inspect a process command line."""
    pgid = procs.get(root, {}).get("pgid")
    for record in records:
        if (record["pid"] == root or record["pgid"] == root or
                (pgid is not None and pgid in (record["pid"], record["pgid"]))):
            return record["name"]
    return None


def runs_memguard(pid):
    argv = (read(f"/proc/{pid}/cmdline", "rb") or b"").split(b"\0")
    return any(os.path.basename(arg) == b"memguard" for arg in argv[:2])


def protected_watchdogs(procs, records):
    # Deployment stops the old guard before starting the new one, with no heavy
    # jobs running. We do not rely on the old implementation excluding this guard.
    guards = {p for p in procs if runs_memguard(p)}
    for p in procs:
        job_id = marker_value(p, "GEMMA_JOB_ID")
        name = job_name(p, procs, records)
        if ((job_id is not None and job_id.startswith(b"memguard")) or
                (name is not None and name.startswith("memguard")) or
                any(r["name"].startswith("memguard") and r["pid"] in ancestors(p, procs)
                    for r in records)):
            guards.add(p)
    return guards | {procs[p]["ppid"] for p in guards}


def eligible(pid, procs, args, protected=()):
    d = procs[pid]
    return (pid not in protected and d["uid"] == UID and d["state"] not in {"Z", "X"} and
            not is_session(pid, procs) and
            (marker_value(pid, args.marker) is not None or
             (d["rss"] > args.unmarked_rss and under(cwd_of(pid), args.roots))))


def find_jobs(procs, args, self_pids, records=None, known_jobs=None):
    """Classify every recipient independently; ancestry only associates eligible members."""
    records = running_jobs() if records is None else records
    known = {(p, start): j for j in (known_jobs or {}).values()
             for p, start in j["known_members"].items()}
    protected = protected_watchdogs(procs, records)
    jobs = {}
    # Carry history independently of eligible-member traversal order. In particular,
    # an exec to node must not erase a live legacy identity, even if no member is
    # eligible this poll. Only members/pids/RSS describe current eligible recipients.
    for key, previous in (known_jobs or {}).items():
        if any(p in procs and procs[p]["starttime"] == start
               for p, start in previous["known_members"].items()):
            jobs[key] = {**previous, "pids": [], "members": {}, "rss": 0,
                         "records": records, "known_members": dict(previous["known_members"])}
    for p, d in procs.items():
        if not eligible(p, procs, args, protected):
            continue
        value = marker_value(p, args.marker)
        job_id = marker_value(p, "GEMMA_JOB_ID")
        record = None
        previous = known.get((p, d["starttime"])) if job_id is None else None
        if job_id is not None:
            # Bytes equality, never a prefix/substring/regex match. Identity takes
            # precedence over PGID, ancestry, and the eligibility marker's value.
            record = next((r for r in records if r.get("job_id") == job_id), None)
            key = ("job_id", job_id)
        elif previous:
            key = previous["key"]
        elif value is not None:
            lineage = [p] + ancestors(p, procs)
            record = next((r for r in records if
                           (r["pgid"] is not None and d["pgid"] == r["pgid"]) or
                           (r["pgid"] is None and r["pid"] in lineage)), None)
            key = (("job", value, record["pid"], record["pgid"]) if record else
                   ("orphan", value))
        else:
            key = ("unmarked", p, d["starttime"])
        root = record["pid"] if record else p
        if previous:
            root = previous["root"]
        j = jobs.setdefault(key, {"key": key, "root": root, "name": record["name"] if record else job_name(root, procs, records),
                                  "pids": [], "members": {}, "rss": 0, "records": records,
                                  "known_members": dict(previous["known_members"]) if previous else {}})
        if previous:
            j["name"] = previous["name"]
            for member, start in previous["known_members"].items():
                j["known_members"].setdefault(member, start)
        if job_id is None:
            j["known_members"][p] = d["starttime"]
        j["pids"].append(p)
        j["members"][p] = d
        j["rss"] += d["rss"]
    # Exclude the watchdog's whole job, including siblings, rather than only its pid.
    for key, j in list(jobs.items()):
        if (set(j["pids"]) & (self_pids | protected) or j["root"] in self_pids | protected or
                (j["name"] is not None and j["name"].startswith("memguard"))):
            del jobs[key]
    targets = {p: d for j in jobs.values() for p, d in j["members"].items()}
    return targets, jobs


def action_eligible(d, args):
    """Refresh identity AND allowlist after opening the process handle (exec keeps starttime)."""
    current = proc_info(d["pid"])
    if not current or current["starttime"] != d["starttime"]:
        return False
    # Include children so a guard's bin/job parent is protected at action time too.
    procs = snapshot()
    procs[d["pid"]] = current
    parent = current["ppid"]
    while current["comm"] in SHELL_COMMS and parent and parent not in procs:
        info = proc_info(parent)
        if not info:
            break
        procs[parent] = info
        parent = info["ppid"]
    return eligible(d["pid"], procs, args, protected_watchdogs(procs, running_jobs()))


def send_kill(d, log, args):
    """Pin a pidfd before the final identity check; never signal a recycled pid."""
    fd = None
    try:
        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
            try:
                fd = os.pidfd_open(d["pid"])
            except OSError as exc:
                if exc.errno not in (errno.ENOSYS, errno.EINVAL, errno.EPERM):
                    raise
        if not action_eligible(d, args):
            return False
        if fd is not None:
            signal.pidfd_send_signal(fd, signal.SIGKILL)
        else:
            os.kill(d["pid"], signal.SIGKILL)
        return True
    except ProcessLookupError:
        return False
    except OSError as exc:
        log(f"  cannot kill {d['pid']}: {exc}")
        return False
    finally:
        if fd is not None:
            os.close(fd)


def raise_oom_adj(targets, dry, args):
    n = 0
    if dry:
        return n
    for p, d in targets.items():
        # Opening first pins the proc file to this process, even if its numeric pid is reused.
        try:
            with open(f"/proc/{p}/oom_score_adj", "w") as f:
                if action_eligible(d, args):
                    f.write("1000")
                    n += 1
        except OSError:
            pass
    return n


def inventory(job, args, self_pids):
    # Use the same job ID / known legacy identities for every scan, including survivors.
    _, jobs = find_jobs(snapshot(), args, self_pids, job["records"], {job["key"]: job})
    current = jobs.get(job["key"], {})
    job["known_members"].update(current.get("known_members", {}))
    return current.get("members", {})


def kill_tree(job, args, self_pids, log):
    """Two empty scans, bounded by five seconds, then an independent survivor inventory."""
    killed = set()
    started = time.monotonic()
    deadline = started + 5
    root_identity = job["members"].get(job["root"])
    empty_scans = 0
    while time.monotonic() < deadline:
        members = inventory(job, args, self_pids)
        # The wrapper gets a grace period to record the child's failure. A new process
        # with the same numeric pid does not inherit this special treatment.
        grace = (root_identity and time.monotonic() < started + 3 and
                 any(p != job["root"] for p in job["members"]))
        for p, d in members.items():
            if grace and p == job["root"] and d["starttime"] == root_identity["starttime"]:
                continue
            if send_kill(d, log, args):
                killed.add(p)
        empty_scans = empty_scans + 1 if not members else 0
        if empty_scans >= 2 and not grace:
            break
        time.sleep(0.2)
    survivors = sorted(inventory(job, args, self_pids))
    return sorted(killed), survivors


def send_mail(msg, log):
    try:
        result = subprocess.run([os.path.join(REPO, "bin/send"), "builder", msg],
                                env={**os.environ, "SEND_FROM": "memguard", "GEMMA_ROLE": "memguard"},
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
        if result.returncode:
            log(f"  mail failed: exit {result.returncode}")
    except (OSError, subprocess.TimeoutExpired) as exc:
        log(f"  mail failed: {exc}")


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--interval", type=float, default=2.0)
    ap.add_argument("--min-available", type=float, default=2.5, help="GiB")
    ap.add_argument("--max-total", type=float, default=6.0, help="GiB of summed targeted RSS")
    ap.add_argument("--unmarked-rss", type=float, default=3.0, help="GiB, for unmarked targets (ii)")
    ap.add_argument("--min-kill-rss", type=float, default=0.25,
                    help="GiB; on low MemAvailable alone, skip jobs smaller than this (killing a waiter frees nothing)")
    ap.add_argument("--marker", default="GEMMA_JOB_CAP")
    ap.add_argument("--roots", default="/home/ubuntu/work/gemma,/tmp")
    ap.add_argument("--log", default=os.path.join(REPO, "ops/logs/memguard.log"))
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-mail", action="store_true")
    args = ap.parse_args()
    args.roots = [r for r in args.roots.split(",") if r]
    for k in ("min_available", "max_total", "unmarked_rss", "min_kill_rss"):
        setattr(args, k, int(getattr(args, k) * GIB))
    os.makedirs(os.path.dirname(args.log), exist_ok=True)

    def log(msg):
        line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}"
        with open(args.log, "a") as f:
            f.write(line + "\n")
        print(line, flush=True)

    log(f"start pid={os.getpid()} min_available={args.min_available/GIB:.2f}G max_total={args.max_total/GIB:.2f}G "
        f"marker={args.marker} roots={args.roots} dry_run={args.dry_run}")
    last_beat = 0
    jobs = {}
    while True:
        procs = snapshot()
        self_pids = {os.getpid()} | set(ancestors(os.getpid(), procs))
        # Our ancestors include the bin/job wrapper and maybe a Claude shell; they're never targets.
        targets, jobs = find_jobs(procs, args, self_pids, known_jobs=jobs)
        if args.dry_run:
            log(f"targets={sorted(targets)} jobs=" + repr([
                {"name": j["name"], "root": j["root"], "pids": sorted(j["pids"])}
                for j in jobs.values()]))
        raise_oom_adj(targets, args.dry_run, args)
        avail = mem_available() or 0
        total = sum(j["rss"] for j in jobs.values())
        if time.time() - last_beat > 600:
            log(f"beat avail={avail/GIB:.2f}G targeted_rss={total/GIB:.2f}G jobs={len(jobs)} targets={len(targets)}")
            last_beat = time.time()
        reason = None
        if total > args.max_total:
            reason = f"targeted RSS {total/GIB:.2f}G > {args.max_total/GIB:.2f}G"
        elif avail < args.min_available:
            reason = f"MemAvailable {avail/GIB:.2f}G < {args.min_available/GIB:.2f}G"
        if reason and jobs:
            _, j = max(jobs.items(), key=lambda kv: kv[1]["rss"])
            root = j["root"]
            if total <= args.max_total and j["rss"] < args.min_kill_rss:
                reason = None  # pressure is not ours to fix by killing a tiny job
        if reason and jobs:
            name = j["name"]
            comm = procs.get(root, {}).get("comm", "?")
            log(f"KILL job={name or '-'} root={root} comm={comm} rss={j['rss']/GIB:.2f}G reason: {reason}"
                + (" [dry-run]" if args.dry_run else ""))
            if not args.dry_run:
                killed, surv = kill_tree(j, args, self_pids, log)
                log(f"  killed {len(killed)} pids; survivors={surv}")
                msg = (f"memguard killed job {name or '(unmarked pid %d %s)' % (root, comm)}: "
                       f"{j['rss']/GIB:.2f}G, {reason}. Survivors: {surv or 'none'}. See ops/logs/memguard.log.")
                if name:
                    time.sleep(0.5)
                    try:
                        with open(os.path.join(REPO, "ops/jobs", f"{name}.log"), "a") as f:
                            f.write(f"[memguard] {msg}\n")
                    except OSError:
                        pass
                if not args.no_mail:
                    # Mail may take up to ten seconds; keep polling while it completes.
                    threading.Thread(target=send_mail, args=(msg, log)).start()
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    sys.exit(main())

