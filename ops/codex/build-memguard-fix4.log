+    assert sent == [(10, signal.SIGKILL)] and output.getvalue() == "1000"
+    world[10] = proc(10, starttime=999, rss=4 * 1024**3)
+    assert mg.find_jobs(world, args, set(), known_jobs=jobs) == ({}, {})
