   399	    content: types.Content,
   400	    *,
   401	    strip_client_function_call_ids: bool,
   402	) -> types.Content:
   403	  """Returns a session-isolated copy of ``content`` for an LLM request.
   404	
   405	  ``Content`` and every ``Part`` are shallow-copied so downstream request
   406	  processors (nl_planning, code_execution) can mutate them without corrupting
   407	  session events; payloads are shared by reference to avoid the deep recursion
   408	  that the previous ``deepcopy`` paid on every request.
   409	
   410	  Because the copy is shallow, nested fields (e.g. ``function_call.args``,
   411	  ``inline_data.data``) are shared with the session events. Downstream
   412	  processors must therefore only replace ``Part`` objects or set top-level
   413	  ``Part`` fields; mutating a nested field in place would corrupt session
   414	  history.
   415	
   416	  Args:
   417	    content: The (session-owned) content to copy. Not mutated.
   418	    strip_client_function_call_ids: Whether to remove ``adk-`` prefixed function
   419	      call/response ids (mirrors ``remove_client_function_call_id``).
   420	
   421	  Returns:
   422	    An isolated ``Content`` safe to attach to an ``LlmRequest``.
   423	  """
   424	  new_content = content.model_copy()
   425	  parts = content.parts
   426	  if not parts:
   427	    return new_content
   428	
   429	  new_parts = []
   430	  for part in parts:
   431	    new_part = part.model_copy()
   432	    if strip_client_function_call_ids:
   433	      fc = new_part.function_call
   434	      if fc and fc.id and fc.id.startswith(AF_FUNCTION_CALL_ID_PREFIX):
   435	        new_part.function_call = fc.model_copy(update={'id': None})
   436	      fr = new_part.function_response
   437	      if fr and fr.id and fr.id.startswith(AF_FUNCTION_CALL_ID_PREFIX):
   438	        new_part.function_response = fr.model_copy(update={'id': None})
   439	    new_parts.append(new_part)
   440	  new_content.parts = new_parts
   441	  return new_content
