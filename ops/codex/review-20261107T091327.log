   183	        files[name] = 'ONLY_REFERENCE'
   184	    common = sorted(set(cand) & set(ref))
   185	    parsed_c = {n: load_yaml(cand[n], n) for n in common if is_yaml(n)}
   186	    parsed_r = {n: load_yaml(ref[n], n) for n in common if is_yaml(n)}
   187	    gcc_c, gcc_r = gcc_include_targets(parsed_c), gcc_include_targets(parsed_r)
   188	    if gcc_c != gcc_r:
   189	        violations.append({'file': '*', 'path': [], 'reason':
   190	                           f'generate_content_config include targets differ: {sorted(gcc_c)} vs {sorted(gcc_r)}'})
   191	    for name in common:
   192	        if cand[name] == ref[name]:
   193	            files[name] = 'BYTE_IDENTICAL'
   194	            if is_yaml(name):  # still record knob values (all EQUAL) for the audit trail
   195	                compare_tree(name, parsed_c[name], parsed_r[name], (), gcc_r, knobs, [])
   196	            continue
   197	        if not is_yaml(name):
   198	            files[name] = 'DIFFERS'
   199	            violations.append({'file': name, 'path': [], 'reason': 'non-YAML file not byte-identical'})
   200	            continue
   201	        before = len(violations)
   202	        compare_tree(name, parsed_c[name], parsed_r[name], (), gcc_r, knobs, violations)
   203	        files[name] = 'DIFFERS' if len(violations) > before else 'KNOB_OR_COMMENT_ONLY'
   204	    return {'files': files, 'knobs': knobs, 'violations': violations,
   205	            'verdict': 'INELIGIBLE' if violations else 'ELIGIBLE'}
   206	
   207	
   208	def check_reference_lb(lb_path, ref_sha):
   209	    with open(lb_path) as f:
   210	        lb = json.load(f)
   211	    problems = []
   212	    if lb.get('status') != 'COMPLETE':
   213	        problems.append(f"reference lb status {lb.get('status')!r} != 'COMPLETE'")
   214	    if lb.get('public_score') is None:
   215	        problems.append('reference lb public_score missing')
   216	    if lb.get('sha256') != ref_sha:
   217	        problems.append(f"reference lb sha256 {lb.get('sha256')!r} != reference zip {ref_sha}")
   218	    return {'path': lb_path, 'status': lb.get('status'), 'public_score': lb.get('public_score'),
   219	            'submission_ref': lb.get('submission_ref'), 'problems': problems}
   220	
   221	
   222	def main(argv=None):
   223	    ap = argparse.ArgumentParser(description=__doc__.split('\n')[0])
   224	    ap.add_argument('candidate')
   225	    ap.add_argument('reference')
   226	    ap.add_argument('--reference-lb')
   227	    ap.add_argument('--out')
   228	    a = ap.parse_args(argv)
   229	    try:
   230	        res = check(a.candidate, a.reference)
   231	    except (OSError, zipfile.BadZipFile, ValueError) as e:
   232	        print(f'ERROR: {e}', file=sys.stderr)
   233	        return 2
   234	    out = {'_schema': SCHEMA, 'rule': 'ops/decisions/087-20261107T090954-880-from-builder.md item 1 (b)',
   235	           'candidate': {'zip': a.candidate, 'sha256': sha256_file(a.candidate)},
   236	           'reference': {'zip': a.reference, 'sha256': sha256_file(a.reference)}, **res}
   237	    if a.reference_lb:
   238	        out['reference_lb'] = check_reference_lb(a.reference_lb, out['reference']['sha256'])
   239	        if out['reference_lb']['problems']:
   240	            out['verdict'] = 'INELIGIBLE'
   241	    text = json.dumps(out, indent=1, default=repr)
   242	    if a.out:
   243	        with open(a.out, 'w') as f:
   244	            f.write(text + '\n')
   245	    print(f"{out['verdict']}: {a.candidate} vs {a.reference} "
   246	          f"({len(out['violations'])} violations"
   247	          f"{', ref-lb problems ' + str(len(out['reference_lb']['problems'])) if a.reference_lb else ''})")
   248	    for v in out['violations'][:20]:
   249	        print(f"  - {v['file']} {'/'.join(map(str, v['path']))}: {v['reason']}")
   250	    return 0 if out['verdict'] == 'ELIGIBLE' else 1
   251	
   252	
   253	if __name__ == '__main__':
   254	    sys.exit(main())
