   254	    out = dict(expected=len(expected), observed=len(ids),
   255	               missing=[i for i in expected if i not in seen],
   256	               extra=sorted(seen - set(expected)),
   257	               duplicates=sorted({i for i in ids if ids.count(i) > 1}),
   258	               order_matches=list(ids) == list(expected))
