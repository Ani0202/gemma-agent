    44	def gate(reply='SUBMITTED', reason='changes', size=23):
    45	    es = [call('submit_patch', {'request': 'submit'})]
    46	    es += invoke('run_command', {'command': m._gate_command(YAML)},
    47	                 {'status': 'ok', 'stdout': 'GATE call=1 kept_files=1\n' +
    48	                  ('VERDICT=EDIT_FIRST' if reply.startswith('NOT SUBMITTED') else f'VERDICT=SUBMIT reason={reason}')}, 'submit_patch')
    49	    if not reply.startswith('NOT SUBMITTED'):
    50	        result = {'error': 'synthetic'} if reply.startswith('SUBMIT FAILED') else {'status': 'ok', 'patch_size': size}
    51	        es += invoke('submit_patch', result=result, author='submit_patch')
    52	    es += [response('submit_patch', {'raw': reply})]
    53	    return es
