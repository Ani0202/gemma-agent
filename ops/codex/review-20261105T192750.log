@@ -0,0 +1,46 @@
+Run the offline setup acceptance outside the Codex sandbox:
+
+```sh
+PYTHONPATH=/home/ubuntu/gemma-local/imgrt-stub \
+  /home/ubuntu/gemma-local/venv/bin/python eval/repro/plan003_kernel_setup.py \
+  --output results/plan003_kernel_setup_acceptance_r4local.json
+```
+
+The runner requires `bwrap --unshare-net`. It runs both modes sequentially on
+`rich_3006` and `fastapi_14986`, without loading task text, an agent, or verification.
+A bwrap failure produces `status: blocked` and no task rows. `--setup-fix 0` runs
+only the control and produces `status: diagnostic`, never an acceptance pass.
+
+The fixed mode installs only pip and Dockerfile.public line 9's Python tools and
+their runtime dependency closure before attempting the workspace editable install.
+`workspace_editable` uses the Docker hook's pip flags through `python3 -m pip` so
+that the sandbox interpreter is used even when bootstrap pip has no console script.
+It captures the actual return code and stderr that Docker's `|| true` and redirect
+hide, and continues to injection and competition setup even if that attempt fails.
+The subsequent steps are `base_tar_extraction` and `setup.py`. The latter invokes
+the unmodified competition setup script through an output observer. No pip retry,
+timeout, or index environment overrides are added.
+
+Each of those three steps includes `distributions`, queried using
+`importlib.metadata.distribution` in the sandbox interpreter after the step. For
+the task package it reports location, metadata directory, version, and
+`record_exists`. The control reports this state after injection and competition
+setup; its early harness hook remains the original SubprocessManager no-op.
+`editable_rc` is the first editable call inside competition setup,
+`editable_final_rc` is its last call, and `workspace_editable_rc` is the earlier
+Docker-equivalent attempt. `editable_failed` and `setup_failed` are true if any
+observed editable attempt failed, even if a subsequent fallback succeeded. The
+CPU summary consumes the failure flags and rejects any `missing_tool_deps`.
+
+Both modes use a base-tar key derived from sorted selected wheel filenames and
+sizes plus the installed harness version. Every build or reuse logs the key,
+selected wheels, and tar member count. A marker-only or empty tar with selected
+wheels fails loudly. Old `sp_base_local` caches cannot be reused by this path.
+
+Journal stdout/stderr are capped at 2048 UTF-8 bytes per stream. Full output lives
+in per-mode per-task JSONL artifacts linked by `setup_output_artifact`; only the
+task ID appears in the filename. The acceptance JSON and console output include
+editable rc, total retry count, setup seconds, and per-step distribution state.
+These observations distinguish a RECORD-less injected distribution from metadata
+left by the image tool install or earlier workspace editable attempt; they do not
+assert that Kaggle exhibits the same failure or timing.
diff --git a/eval/repro/plan003_kernel_setup.py b/eval/repro/plan003_kernel_setup.py
new file mode 100644
index 0000000..cbd6e3c
--- /dev/null
+++ b/eval/repro/plan003_kernel_setup.py
@@ -0,0 +1,81 @@
+"""Offline setup acceptance using one rich and one fastapi frozen dev snapshot.
+
+Builder command OUTSIDE the Codex sandbox (runs BOTH SETUP_FIX=0 and =1):
+  /home/ubuntu/gemma-local/venv/bin/python eval/repro/plan003_kernel_setup.py
+
+Optional --setup-fix 0|1 selects a single mode. Defaults use the main checkout's
+public data/wheelhouse; override with --data-dir and --wheels-dir. Output defaults
+to results/plan003_kernel_setup_acceptance.json, including per-step durations and
+bounded pip errors; full output is stored in per-task artifacts. bwrap --unshare-net is mandatory; no PIP_* overrides,
+venv monkeypatching, model, agent, verification, downloads, or holdout access.
+"""
+import argparse
+from contextvars import ContextVar
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--data-dir', type=Path, default=Path('/home/ubuntu/work/gemma/data/raw'))
+    parser.add_argument('--wheels-dir', type=Path)
+    parser.add_argument('--output', type=Path, default=Path('results/plan003_kernel_setup_acceptance.json'))
+    parser.add_argument('--setup-fix', choices=('0', '1'))
+    parser.add_argument('--inside-bwrap', action='store_true', help=argparse.SUPPRESS)
+    args = parser.parse_args()
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    identity = dict(_schema='plan003_kernel_setup_acceptance_v1',
+                    script='eval/repro/plan003_kernel_setup.py',
+                    local_data_dir=str(args.data_dir.resolve()),
+                    task_ids=['rich_3006', 'fastapi_14986'],
+                    setup_fix_modes=[int(args.setup_fix)] if args.setup_fix else [0, 1])
+    if not args.inside_bwrap:
+        command = ['bwrap', '--dev-bind', '/', '/', '--unshare-net', sys.executable,
+                   str(Path(__file__).resolve()), *sys.argv[1:], '--inside-bwrap']
+        result = subprocess.run(command, capture_output=True, text=True)
+        if result.returncode and 'bwrap:' in result.stderr:
+            args.output.write_text(json.dumps(dict(**identity, status='blocked', rc=result.returncode,
+                stderr=result.stderr[-2048:], rows=[]), indent=2) + '\n')
+        print(result.stdout, end='')
+        print(result.stderr, end='', file=sys.stderr)
+        return result.returncode
+    os.environ['LITELLM_LOCAL_MODEL_COST_MAP'] = 'True'
+    spec = importlib.util.spec_from_file_location('timing', Path(__file__).parents[1] / 'kaggle/agent_timing.py')
+    timing = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(timing)
+    timing.WORK = args.output.parent / (args.output.stem + '_artifacts')
+    state = ContextVar('acceptance')
+    rows = []
+    with tempfile.TemporaryDirectory(prefix='kernel-setup-') as temp:
+        root = Path(temp)
+        wheels = (args.wheels_dir or args.data_dir / 'wheels').resolve()
+        (root / 'wheels').symlink_to(wheels)
+        (root / 'sandbox').symlink_to((args.data_dir / 'sandbox').resolve())
+        (root / 'snapshots').symlink_to((args.data_dir / 'snapshots').resolve())
+        for mode in [args.setup_fix] if args.setup_fix else ['0', '1']:
+            os.environ['SETUP_FIX'] = mode
+            for iid, repo in [('rich_3006', 'Textualize/rich'), ('fastapi_14986', 'fastapi/fastapi')]:
+                row = timing.setup_task(root, wheels, iid, repo, state)
+                rows.append(row)
+                print(json.dumps(dict(instance_id=iid, setup_fix=int(mode),
+                    steps={c['step']: c['duration_s'] for c in row['setup_calls']},
+                    editable_rc=row['editable_rc'], workspace_editable_rc=row.get('workspace_editable_rc'),
+                    retrying_lines=row['retrying_lines'], setup_s_total=row['setup_s_total'],
+                    distributions={c['step']: c['distributions'] for c in row['setup_calls']
+                                   if 'distributions' in c})), flush=True)
+    # The unfixed mode is diagnostic; only fixed rows must pass the setup gate.
+    fixed = [r for r in rows if r['setup_fix'] == 1]
+    passed = bool(fixed) and all(not r['setup_failed'] and not r.get('editable_failed') and
+                 not r.get('missing_tool_deps') and r['editable_rc'] == 0 and
+                 r['retrying_lines'] == 0 and r['setup_s_total'] <= 30 for r in fixed)
+    args.output.write_text(json.dumps(dict(**identity, status=('passed' if passed else 'failed') if fixed else 'diagnostic', rows=rows), indent=2) + '\n')
+    return int(bool(fixed) and not passed)
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())

