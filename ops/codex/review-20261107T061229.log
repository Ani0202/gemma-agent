   974	def stray_safety(rows, tasks_path=None):
   975	    """S81: governing stray (gating) + literal stray (descriptive, paths only). Missing evidence -> 'not available'."""
   976	    if not all('stray_files' in r and isinstance(r['stray_files'], list) for r in rows):
   977	        return 'not available', 'not available', []
   978	    governing_ids, literal_ids, per_row, missing = [], [], [], []
   979	    for r in rows:
   980	        literal = sorted(r['stray_files'])
   981	        if not literal:
   982	            continue
   983	        dirs = gold_created_dirs(r['instance_id'], tasks_path)
   984	        if dirs is None:
   985	            missing.append(r['instance_id'])
   986	        governing, exempted = amended_stray(literal, dirs)
   987	        literal_ids.append(r['instance_id'])
   988	        if governing or dirs is None:
   989	            governing_ids.append(r['instance_id'])
   990	        per_row.append(dict(instance_id=r['instance_id'], literal=literal, governing=governing, exempted=exempted,
   991	                            gold_unavailable=dirs is None))
   992	    if missing:
   993	        return 'not available', _id_count(literal_ids), per_row
   994	    return _id_count(governing_ids), _id_count(literal_ids), per_row
