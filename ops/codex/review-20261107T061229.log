   962	def amended_stray(literal, gold_dirs):
   963	    """S81.1 exact parent-directory match only (no prefix/ancestor/extension/name matching)."""
   964	    governing, exempted = [], []
   965	    for f in literal:
   966	        d = os.path.dirname(f)
   967	        if gold_dirs is not None and d in gold_dirs:
   968	            exempted.append(dict(path=f, gold_dir=d))
   969	        else:
   970	            governing.append(f)
   971	    return governing, exempted
