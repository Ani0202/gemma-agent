  1007	def summarize_arm(records, arm1=False):
  1008	    rows = [r for r, _, _, _ in records]
  1009	    ids = lambda predicate: [r['instance_id'] for r in rows if predicate(r)]
  1010	    hs = [r['instance_id'] for r, c, _, _ in records if c['h'] is not None]
  1011	    non_h = [r for r in rows if r['instance_id'] not in hs]
  1012	    rate = lambda rs: base.rate(sum(r.get('resolved') is True for r in rs), len(rs))
  1013	    thinking, repeats, llm, tools, swt = [], [], [], [], []
  1014	    for row, _, trace, entries in records:
  1015	        iid = row['instance_id']
  1016	        th = base.thinking_task(str(trace))
  1017	        thinking.append(dict(instance_id=iid, thinking_blocks=th['thinking_blocks'], total_thinking_chars=sum(
  1018	            len(e.get('content') or '') for e in entries if e.get('author') == ROOT and e.get('type') == 'thinking')))
  1019	        repeats.append(dict(instance_id=iid, **identical_runs_root(entries)))
  1020	        llm.append(row.get('llm_turns') if row.get('llm_turns') is not None else th['root_usage_turns'])
  1021	        tc = row.get('tool_calls')
  1022	        tools.append(tc['total'] if isinstance(tc, dict) and tc.get('total') is not None else len(root_tool_calls(entries)))
  1023	        observed = submitted_without_test(entries, gate_mode=False)
  1024	        count = observed is True
  1025	        if not arm1:
  1026	            evidence = dict(submitted_without_test=observed, **submit_evidence(row, entries, False))
  1027	            count = d735_counts(evidence, entries)['swt_d735']
  1028	        if count:
  1029	            swt.append(iid)
  1030	    safety = {}
  1031	    key = 'test_files_edited'
  1032	    safety[key] = (_id_count(ids(lambda r: bool(r.get(key)))) if all(key in r and r[key] is not None for r in rows)
  1033	                   else 'not available')
  1034	    # Plan 009 S81: stray_files = GOVERNING (gating); literal = old rule, DESCRIPTIVE.
  1035	    safety['stray_files'], safety['stray_files_literal'], safety['stray_rows'] = stray_safety(rows)
  1036	    walls = [(r.get('wall_seconds') or {}).get('total') for r in rows]
  1037	    safety.update(total_wall_p90=base.pct(walls, .9), total_wall_p90_unrounded=pct_raw(walls, .9),
  1038	                  total_wall_complete=all(_finite_number((r.get('wall_seconds') or {}).get('total')) for r in rows),
  1039	                  empty_patch=_id_count(ids(lambda r: r.get('verified_patch_bytes') == 0)),
  1040	                  empty_patch_complete=all(type(r.get('verified_patch_bytes')) is int for r in rows),
  1041	                  submitted_without_test=_id_count(swt),
  1042	                  submitted_without_test_definition='plan007 observed' if arm1 else 'plan008 D73.5 total')
  1043	    screened = set(base.ids_file(base.SCREENED_IDS))
  1044	    unseen = [r for r in rows if r['instance_id'] not in screened]
  1045	    return dict(n_rows=len(rows), resolved=rate(rows), h_rows=_id_count(hs), sensitivity=rate(non_h),
  1046	                known_diag=sum(bool(c['known_diag']) for _, c, _, _ in records) if all('known_diag' in c for _, c, _, _ in records) else None,
  1047	                timeouts=_id_count(ids(lambda r: bool(r.get('timed_out')) or bool(r.get('agent_timeout_fired')))),
  1048	                safety=safety, timing=arm3_timing(rows), descriptive=dict(
  1049	                    thinking=dict(rows=thinking, tasks_with_blocks=sum(t['thinking_blocks'] > 0 for t in thinking),
  1050	                                  total_blocks=sum(t['thinking_blocks'] for t in thinking),
  1051	                                  total_chars=sum(t['total_thinking_chars'] for t in thinking)),
  1052	                    context_overflow='not available',
