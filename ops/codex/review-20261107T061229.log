   923	def gold_created_files(patch):
   924	    """Plan 009 S81.1: files a gold patch creates = +++ header file whose section has a hunk starting '@@ -0,0 '.
   925	    The competition patch format has no diff --git / new file mode lines. Paths only; feeds the dev stray metric only."""
   926	    out, current = set(), None
   927	    for line in patch.splitlines():
   928	        if line.startswith('+++ '):
   929	            value = line[4:].split('\t', 1)[0]
   930	            current = value[2:] if value.startswith('b/') else value
   931	        elif line.startswith('--- '):
   932	            current = None
   933	        elif line.startswith('@@ -0,0 ') and current and current != '/dev/null':
   934	            out.add(current)
   935	    return out
