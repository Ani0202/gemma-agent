   238	def d735_counts(r, entries):
   239	    """D73.5 (dec 074 item 2): a submit_unverifiable row counts as submitted_without_test
   240	    unless a root test run precedes the earliest candidate boundary (computed from the
   241	    trace, not from the observed success; the observed success is itself a candidate, so
   242	    the boundary is never later than it). No candidate = worst case = counted. If
   243	    patch_submitted is not True it ALSO counts in no_successful_submit. Verifiable rows keep the observed D73.3 values.
   244	    Mutates and returns the row."""
   245	    obs = r['submitted_without_test']
   246	    if r['submit_unverifiable']:
   247	        boundary = earliest_candidate_index(entries)
   248	        r['d735_boundary_entry'] = boundary
   249	        r['swt_d735'] = not tested_before(entries, boundary)
   250	        r['no_submit_d735'] = r['patch_submitted'] is not True
   251	    else:
   252	        r['swt_d735'] = obs is True
   253	        r['no_submit_d735'] = obs is None
   254	    return r
