   997	def pct_raw(vals, q):
   998	    """S81.5: unrounded percentile (same interpolation as plan007_arm1_summary.pct, which rounds for display)."""
   999	    vals = sorted(v for v in vals if v is not None)
  1000	    if not vals:
  1001	        return None
  1002	    i = (len(vals) - 1) * q
  1003	    lo, hi = math.floor(i), math.ceil(i)
  1004	    return vals[lo] + (vals[hi] - vals[lo]) * (i - lo)
