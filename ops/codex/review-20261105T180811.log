from pathlib import Path
import subprocess
p=Path('ops/patches/bin-job-fallback.diff').read_text().splitlines()
added='\\n'.join(x[1:] for x in p if x.startswith('+') and not x.startswith('+++'))
a=added.index('    marked()'); b=added.index('    id=',a)
marked=added[a:b]
# Preserve the marker finder, substitute virtual proc entries and a deterministic grep response.
# kill is a logging function; no signal is issued.
fake=marked.replace('for e in /proc/[0-9]*/environ;', 'for e in /proc/100/environ /proc/101/environ;')
script='''set -uo pipefail
id=run/boot/1
# Process 100 matches, then exits and is reused during the rest of the scan.
grep() { if [[ \""'$*" == */100/environ* ]]; then return 0; fi; echo '"'pid 100 reused before scan returns' >&2; return 1; }
kill() { printf 'would signal numeric pid: %s\\\\n' \""'$*"; }
'"'''+fake+'''
for p in "'$(marked); do kill -TERM "$p" 2>/dev/null; done
'"'''
r=subprocess.run(['bash','-c',script],text=True,capture_output=True)
print('marked -> kill reuse probe:',r.returncode,repr(r.stdout),repr(r.stderr))
# Read's behavior for absent trailing fields with the exact shell options.
script='''set -uo pipefail
for record in 'running 10 date' 'running 10 date 10' 'running 10 date 10 boot 123'; do
 read -r st pid _ pgid boot stime <<< \""'$record"
 printf '"'pid=%s pgid=<%s> boot=<%s> start=<%s>\\\\n' \""'$pid" "$pgid" "$boot" "$stime"
done
'"'''
r=subprocess.run(['bash','-c',script],text=True,capture_output=True)
print('3/4/6-field nounset probe:',r.returncode,repr(r.stdout),repr(r.stderr))
