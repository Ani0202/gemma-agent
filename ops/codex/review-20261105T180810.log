   134	def is_session(pid, procs):
   135	    d = procs[pid]
   136	    return (d["comm"] in SESSION_COMMS or
   137	            (d["comm"] in SHELL_COMMS and
   138	             any(procs[a]["comm"] in SESSION_COMMS for a in ancestors(pid, procs))))
