   258	def kill_tree(job, args, self_pids, log):
   259	    """Two empty scans, bounded by five seconds, then an independent survivor inventory."""
   260	    killed = set()
   261	    started = time.monotonic()
   262	    deadline = started + 5
   263	    root_identity = job["members"].get(job["root"])
   264	    empty_scans = 0
   265	    while time.monotonic() < deadline:
   266	        members = inventory(job, args, self_pids)
   267	        # The wrapper gets a grace period to record the child's failure. A new process
   268	        # with the same numeric pid does not inherit this special treatment.
   269	        grace = (root_identity and time.monotonic() < started + 3 and
   270	                 any(p != job["root"] for p in job["members"]))
   271	        for p, d in members.items():
   272	            if grace and p == job["root"] and d["starttime"] == root_identity["starttime"]:
   273	                continue
   274	            if send_kill(d, log):
   275	                killed.add(p)
   276	        empty_scans = empty_scans + 1 if not members else 0
   277	        if empty_scans >= 2 and not grace:
   278	            break
   279	        time.sleep(0.2)
   280	    survivors = sorted(inventory(job, args, self_pids))
   281	    return sorted(killed), survivors
