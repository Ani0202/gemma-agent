   158	def job_name(root, procs, records):
   159	    """Use status metadata only; never inspect a process command line."""
   160	    pgid = procs.get(root, {}).get("pgid")
   161	    for record in records:
   162	        if (record["pid"] == root or record["pgid"] == root or
   163	                (pgid is not None and pgid in (record["pid"], record["pgid"]))):
   164	            return record["name"]
   165	    return None
   166	
