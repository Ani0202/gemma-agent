   168	def find_jobs(procs, args, self_pids, records=None):
   169	    """Classify every recipient independently; ancestry only associates eligible members."""
   170	    records = running_jobs() if records is None else records
   171	    marked = {p: marker_value(p, args.marker) for p in procs}
   172	    jobs = {}
   173	    for p, d in procs.items():
   174	        if d["uid"] != UID or d["state"] in {"Z", "X"} or is_session(p, procs):
   175	            continue
   176	        value = marked[p]
   177	        if value is None and not (d["rss"] > args.unmarked_rss and under(cwd_of(p), args.roots)):
   178	            continue
   179	        record = None
   180	        if value is not None:
   181	            lineage = [p] + ancestors(p, procs)
   182	            record = next((r for r in records if
   183	                           (r["pgid"] is not None and d["pgid"] == r["pgid"]) or
   184	                           (r["pgid"] is None and r["pid"] in lineage)), None)
   185	            key = (("job", value, record["pid"], record["pgid"]) if record else
   186	                   ("orphan", value))
   187	        else:
   188	            key = ("unmarked", p, d["starttime"])
   189	        root = record["pid"] if record else p
   190	        j = jobs.setdefault(key, {"key": key, "root": root, "name": job_name(root, procs, records),
   191	                                  "pids": [], "members": {}, "rss": 0, "records": records})
   192	        j["pids"].append(p)
   193	        j["members"][p] = d
   194	        j["rss"] += d["rss"]
   195	    # Exclude the watchdog's whole job, including siblings, rather than only its pid.
   196	    for key, j in list(jobs.items()):
   197	        if (set(j["pids"]) & self_pids or j["root"] in self_pids):
   198	            del jobs[key]
   199	    targets = {p: d for j in jobs.values() for p, d in j["members"].items()}
   200	    return targets, jobs
   201	
   202	
   203	def same_process(d):
   204	    current = proc_stat(d["pid"])
   205	    return bool(current and current["starttime"] == d["starttime"] and
   206	                current["state"] not in {"Z", "X"})
   207	
   208	
   209	def send_kill(d, log):
   210	    """Pin a pidfd before the final identity check; never signal a recycled pid."""
   211	    fd = None
   212	    try:
   213	        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
   214	            try:
   215	                fd = os.pidfd_open(d["pid"])
   216	            except OSError as exc:
   217	                if exc.errno not in (errno.ENOSYS, errno.EINVAL, errno.EPERM):
   218	                    raise
   219	        if not same_process(d):
   220	            return False
   221	        if fd is not None:
   222	            signal.pidfd_send_signal(fd, signal.SIGKILL)
   223	        else:
   224	            os.kill(d["pid"], signal.SIGKILL)
   225	        return True
   226	    except ProcessLookupError:
   227	        return False
   228	    except OSError as exc:
   229	        log(f"  cannot kill {d['pid']}: {exc}")
   230	        return False
   231	    finally:
   232	        if fd is not None:
   233	            os.close(fd)
   234	
   235	
   236	def raise_oom_adj(targets, dry):
   237	    n = 0
   238	    if dry:
   239	        return n
   240	    for p, d in targets.items():
   241	        # Opening first pins the proc file to this process, even if its numeric pid is reused.
   242	        try:
   243	            with open(f"/proc/{p}/oom_score_adj", "w") as f:
   244	                if same_process(d):
   245	                    f.write("1000")
   246	                    n += 1
   247	        except OSError:
   248	            pass
   249	    return n
   250	
   251	
   252	def inventory(job, args, self_pids):
   253	    # Keep the original wrapper/pgid association even after it records done or exits.
   254	    _, jobs = find_jobs(snapshot(), args, self_pids, job["records"])
   255	    return jobs.get(job["key"], {}).get("members", {})
