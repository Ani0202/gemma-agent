    94	def marker_value(pid, marker):
    95	    env = read(f"/proc/{pid}/environ", "rb") or b""
    96	    key = marker.encode() + b"="
    97	    for entry in env.split(b"\0"):
    98	        if entry.startswith(key):
    99	            return entry[len(key):]  # Empty marker values still count as marked.
