   141	def running_jobs():
   142	    """Legacy three-field, current four-field, and longer (extra trailing fields) status records."""
   143	    records = []
   144	    for path in sorted(Path(REPO, "ops/jobs").glob("*.status")):
   145	        fields = (read(path) or "").split()
   146	        # >=3: legacy 3-field, current 4-field, and the proposed owner patch's extra identity fields.
   147	        if len(fields) < 3 or fields[0] != "running":
   148	            continue
   149	        try:
   150	            pid = int(fields[1])
   151	            pgid = int(fields[3]) if len(fields) >= 4 else None
   152	        except ValueError:
   153	            continue
   154	        records.append({"name": path.stem, "pid": pid, "pgid": pgid})
   155	    return records
   156	
