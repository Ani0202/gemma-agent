   114	def ancestors(pid, procs):
   115	    out, seen = [], set()
   116	    p = procs.get(pid, {}).get("ppid", 0)
   117	    while p and p in procs and p not in seen:
   118	        seen.add(p); out.append(p); p = procs[p]["ppid"]
   119	    return out
   120	
   121	
   122	def descendants(root, procs):
   123	    kids = {}
   124	    for d in procs.values():
   125	        kids.setdefault(d["ppid"], []).append(d["pid"])
   126	    out, stack = [], [root]
   127	    while stack:
   128	        for c in kids.get(stack.pop(), []):
   129	            if c not in out:
   130	                out.append(c); stack.append(c)
   131	    return out
