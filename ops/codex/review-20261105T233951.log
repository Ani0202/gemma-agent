   233	    cs = modules['swegemma.harness.container_setup']
   234	    calls, timeouts = [], []
   235	    def slow():
   236	        time.sleep(2)
   237	    class Manager:
   238	        def __init__(self, **kw):
   239	            pass
   240	        def start(self):
   241	            calls.append('start')
   242	            if slow_step == 'start':
   243	                slow()
   244	            return 'sid'
   245	        def exec(self, *args, **kw):
   246	            timeouts.append(kw['timeout'])
   247	            slow()
   248	        def cleanup_all(self):
