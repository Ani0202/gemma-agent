   205	def setup_artifact(current, payload):
   206	    """Full diagnostics live outside the journal, with only a task ID in the filename."""
   207	    iid = current.get('instance_id')
   208	    if iid is None or not (payload.get('stdout') or payload.get('stderr')):
   209	        return
   210	    if not re.fullmatch(r'[A-Za-z0-9_.-]+', iid):
   211	        raise ValueError('Unsafe task ID')
   212	    path = WORK / 'setup_artifacts' / str(current.get('setup_fix', SETUP_FIX)) / (iid + '.jsonl')
   213	    path.parent.mkdir(parents=True, exist_ok=True)
   214	    if 'setup_output_artifact' not in current:
   215	        path.write_text('')
   216	    with path.open('a') as stream:
   217	        stream.write(json.dumps(payload) + '\n')
   218	    current['setup_output_artifact'] = str(path)
