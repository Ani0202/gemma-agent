  1224	                   started=time.perf_counter(), setup_calls=[], setup_failed=False,
  1225	                   editable_rc=None, retrying_lines=0, interpreter_version=None,
  1226	                   wheel_tags_chosen=[], setup_subprocesses=[])
  1227	    state.set(current)
