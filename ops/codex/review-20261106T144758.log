    55	               NCCL_DEBUG='WARN', LITELLM_LOCAL_MODEL_COST_MAP='True', LITELLM_TELEMETRY='False',
    56	               LITELLM_LOG='WARNING', PYTORCH_CUDA_ALLOC_CONF='expandable_segments:True',
    57	               OTEL_SDK_DISABLED='true', OTEL_PYTHON_DISABLED='true')
    58	    os.environ.update(env)
    59	    for key in ('OPENAI_API_KEY', 'LOCAL_API_KEY'):
    60	        os.environ.setdefault(key, 'EMPTY')
    61	    for pattern in ('/usr/local/lib/python*/dist-packages/*cutlass*.pth',
    62	                    '/usr/local/lib/python*/site-packages/*cutlass*.pth'):
    63	        for pth in glob.glob(pattern):
    64	            try:
