   226	def inject_base(cs, wheels, destination, current):
   227	    from importlib.metadata import version
   228	    harness_version = version('swegemma')
   229	    row = current['setup_calls'][-1]
   230	    row.update(selected_wheels=sorted(p.name for p in wheels), harness_version=harness_version,
