   737	class AsyncioTimingProxy:
   738	    """Observe only agent_runner's timeout context, without changing asyncio itself."""
   739	    def __init__(self, original, state):
   740	        self._original, self._state = original, state
   741	
   742	    def __getattr__(self, name):
   743	        return getattr(self._original, name)
   744	
   745	    def timeout(self, *args, **kwargs):
   746	        cm = self._original.timeout(*args, **kwargs)
   747	        state = self._state
   748	        delay = args[0] if args else kwargs.get('delay')
   749	
   750	        class ObservedTimeout:
   751	            async def __aenter__(self):
   752	                self.current = state.get(None)
   753	                if self.current is not None:
   754	                    self.current.update(agent_timeout_seconds=delay, timeout_enter=time.perf_counter())
   755	                return await cm.__aenter__()
   756	
   757	            async def __aexit__(self, *exc_info):
   758	                exit_exc = exc_info[1]
   759	                try:
   760	                    return await cm.__aexit__(*exc_info)
   761	                except BaseException as exc:
   762	                    exit_exc = exc
   763	                    raise
   764	                finally:
   765	                    if self.current is not None:
   766	                        self.current.update(timeout_exit=time.perf_counter(),
   767	                            agent_timeout_fired=bool(getattr(cm, 'expired', lambda: False)())
   768	                                or isinstance(exit_exc, TimeoutError))
   769	
   770	        return ObservedTimeout()
   771	
   772	
   773	def observe_sandbox(original, state, name):
   774	    """Forward identical arguments/results/exceptions and time sandbox boundaries."""
   775	    async def observed(*args, **kwargs):
   776	        current = state.get(None)
   777	        start = time.perf_counter()
   778	        row = None
   779	        if current is not None:
   780	            if name == 'sandbox_start':
   781	                current['sandbox_start_begin'] = start
   782	            elif name == 'sandbox_exec' and current.get('timeout_exit') is not None:
   783	                cmd = args[2] if len(args) > 2 else kwargs.get('command', kwargs.get('cmd', ''))
   784	                row = dict(cmd=str(cmd)[:40], duration_s=None, rc=None)
   785	                current.setdefault('finalization_exec', []).append(row)
   786	        try:
   787	            result = await original(*args, **kwargs)
   788	            if row is not None:
   789	                row['rc'] = getattr(result, 'exit_code', None)
   790	            return result
   791	        except BaseException as exc:
   792	            if row is not None:
   793	                row['exception'] = type(exc).__name__
   794	            raise
   795	        finally:
   796	            end = time.perf_counter()
   797	            if current is not None:
   798	                if name in ('sandbox_start', 'sandbox_stop'):
   799	                    current[name + '_end'] = end
   800	                    current[name + '_duration'] = end - start
   801	                if row is not None:
   802	                    row['duration_s'] = end - start
   803	    return observed
