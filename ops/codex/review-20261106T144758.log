   497	            # Only the scorer's image tools and public base wheels belong here.
   498	            def isolate_venv():
   499	                for pth in sp.glob('_host_env.pth'):
   500	                    pth.unlink()
   501	                cfg = venv / 'pyvenv.cfg'
   502	                if cfg.exists():
   503	                    cfg.write_text(cfg.read_text().replace(
   504	                        'include-system-site-packages = true', 'include-system-site-packages = false'))
   505	            setup_step(current, 'venv_fidelity', isolate_venv)
   506	            pip_wheel = fallback_wheel(wheels, 'pip')
   507	            def bootstrap_pip():
   508	                if pip_wheel:
   509	                    current['setup_calls'][-1]['source'] = str(pip_wheel)
   510	                    import zipfile
   511	                    with zipfile.ZipFile(pip_wheel) as zf:
   512	                        zf.extractall(sp)
   513	                else:
   514	                    current['setup_calls'][-1]['source'] = copy_runtime_package('pip', sp)
   515	                    if current['setup_calls'][-1]['source'] == 'missing':
   516	                        raise RuntimeError('No offline pip source available')
   517	                return docker.exec(container_id, 'python3 -m pip --version', timeout=30)
   518	            result = setup_step(current, 'pip_bootstrap', bootstrap_pip)
   519	            if result.exit_code != 0:
   520	                raise RuntimeError('Sandbox pip bootstrap failed')
   521	            probe = ("import sys,json;from pip._vendor.packaging.tags import sys_tags;"
   522	                     "from pip._vendor.packaging.markers import default_environment;"
   523	                     "print(json.dumps({'version':sys.version,'tags':[str(t) for t in sys_tags()],"
   524	                     "'environment':default_environment()}))")
   525	            result = setup_step(current, 'interpreter_probe', lambda: docker.exec(
   526	                container_id, 'python3 -c ' + shlex.quote(probe), timeout=30))
   527	            if result.exit_code != 0:
   528	                raise RuntimeError('Sandbox interpreter probe failed')
   529	            identity = json.loads(result.stdout)
   530	            current['interpreter_version'] = identity['version']
   531	            selected = compatible_wheels(wheels, identity['tags'])
