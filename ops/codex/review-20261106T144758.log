   480	            started=time.perf_counter(), setup_calls=[], setup_failed=False)
   481	        fixed = os.environ.get('SETUP_FIX', '1') == '1'
   482	        current['setup_fix'] = int(fixed)
   483	        venv = docker.sandboxes[container_id]['venv']
   484	        sp = next(iter(sorted(venv.glob('lib/python3*/site-packages'))))
   485	        if not fixed:
   486	            # Preserve the original injector's wheel selection and base tar exactly.
