  1217	def setup_task(data_dir, wheels_dir, iid, repo, state):
  1218	    """Real agent_runner setup path through dependency installation; no agent/verification."""
  1219	    from types import SimpleNamespace
  1220	    from swegemma.sandbox import SubprocessManager
  1221	    from swegemma.deduplication import resolve_task_snapshot_paths
  1222	    import swegemma.harness.container_setup as cs
