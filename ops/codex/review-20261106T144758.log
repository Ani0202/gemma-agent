   840	                  ('turns', re.compile(r'Agent exceeded (turns budget|maximum allowed LLM turns)\b')),
   841	                  ('tool_calls', re.compile(r'Agent exceeded tool call budget\b')),
   842	                  ('no_submit', re.compile(r'Agent completed execution without calling submit_patch\b')))
