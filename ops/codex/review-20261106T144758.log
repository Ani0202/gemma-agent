  1229	    try:
  1230	        install_deps = patch_subprocess_deps(data_dir, state)
  1231	        sid = setup_step(current, 'venv', manager.start)
  1232	        config = SimpleNamespace(wheels_dir=wheels_dir, tasks_path=data_dir / 'tasks.jsonl',
  1233	                                 snapshots_dir=data_dir / 'snapshots')
  1234	        setup_step(current, 'setup_container_wheels', lambda: cs.setup_container_wheels(manager, sid, config))
  1235	        snapshot, base, patch = resolve_task_snapshot_paths(data_dir / 'snapshots', iid, repo)
  1236	        setup_step(current, 'extract_snapshot', lambda: cs.extract_snapshot(
  1237	            manager, sid, snapshot, base_snapshot_path=base, patch_path=patch))
  1238	        setup_step(current, 'setup_git_exclude', lambda: cs.setup_git_exclude(manager, sid))
  1239	        if current['setup_fix'] == 0:
  1240	            setup_step(current, 'install_editable_package', lambda: cs.install_editable_package(manager, sid))
  1241	        install_deps(manager, sid, repo)
  1242	    except Exception as exc:
  1243	        current.update(setup_failed=True, status='failed', error=type(exc).__name__ + ': ' + str(exc)[:2048])
  1244	    finally:
  1245	        current['setup_s_total'] = round(time.perf_counter()-current['started'], 6)
  1246	        try:
  1247	            setup_step(current, 'teardown', manager.cleanup_all)
  1248	        except Exception as exc:
  1249	            current['teardown_error'] = type(exc).__name__
  1250	        current.pop('started')
  1251	    return current
