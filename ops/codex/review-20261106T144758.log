   488	                base, large, _modules, _requirements = cs._inspect_wheels_dir(wheels)
   489	                if large:
   490	                    raise RuntimeError('large wheels present; workspace-import scan not emulated')
   491	                current['wheel_tags_chosen'] = [p.name for p in base]
   492	                inject_base(cs, base, sp, current)
