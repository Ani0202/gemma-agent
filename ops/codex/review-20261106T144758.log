   115	def missing_tool_closure(wheels, tags=None, runtime=True):
   116	    """Mirror the sandbox tool_deps walk: compatible_wheels (wheelhouse, then embedded), then runtime copy.
   117	
   118	    tags default to the kernel interpreter's, which is the sandbox venv's interpreter on Kaggle.
   119	    """
   120	    from packaging.markers import default_environment
   121	    from packaging.requirements import Requirement
   122	    from packaging.tags import sys_tags
   123	    from packaging.utils import canonicalize_name, parse_wheel_filename
   124	    tags = [str(t) for t in sys_tags()] if tags is None else tags
   125	    extra = extra_wheels()
   126	    selected = compatible_wheels(wheels, tags)
   127	    roots = [wheel_metadata(selected[canonicalize_name(n)]) for n in SCORER_TOOLS
   128	             if n not in ('pip', 'pytest-timeout') and canonicalize_name(n) in selected]
   129	    timeout = [p for p in pytest_timeout_wheels(wheels)
   130	               if any(str(t) in tags for t in parse_wheel_filename(p.name)[3])]
   131	    roots.extend(wheel_metadata(p) for p in timeout[:1])
   132	    env, seen, missing, queue = dict(default_environment(), extra=''), set(), [], list(roots)
   133	    while queue:
   134	        metadata = queue.pop()
   135	        key = (canonicalize_name(metadata['Name']), metadata['Version'])
   136	        if key in seen:
   137	            continue
   138	        seen.add(key)
   139	        for raw in metadata.get_all('Requires-Dist', []):
   140	            req = Requirement(raw)
   141	            if req.marker and not req.marker.evaluate(env):
   142	                continue
   143	            name = canonicalize_name(req.name)
   144	            candidate = compatible_wheels(wheels, tags, req).get(name) or compatible_wheels(extra, tags, req).get(name)
   145	            if candidate:
   146	                queue.append(wheel_metadata(candidate))
   147	                continue
   148	            found = runtime_copyable(name) if runtime else None
   149	            if found is not None and found[0].version in req.specifier:
   150	                queue.append(found[0].metadata)
   151	            elif name not in missing:
   152	                missing.append(name)
   153	    return missing
