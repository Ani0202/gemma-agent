   464	def patch_subprocess_deps(data_dir, state=None):
   465	    """Install scorer tools in each venv, using that interpreter's ABI, entirely offline."""
   466	    import swegemma.harness.container_setup as cs
   467	    from packaging.utils import parse_wheel_filename
   468	    orig = getattr(cs.install_test_dependencies, '_timing_original', cs.install_test_dependencies)
   469	    wheels = data_dir / 'wheels'
   470	    if not wheels.is_dir():
   471	        wheels = WHEELHOUSE
   472	    setup = data_dir / 'sandbox' / 'setup.py'
   473	    if not setup.exists():
   474	        setup = next(iter(data_dir.rglob('setup.py')), setup)
