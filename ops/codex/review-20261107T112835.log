   197	def submit_evidence(row, entries, gate_mode=None, trace_loaded=True):
   198	    observed = successful_submit_index(entries, gate_mode) is not None
   199	    flag, source = _terminal_flag(row, entries)
   200	    known = type(flag) is bool
   201	    return dict(submit_unverifiable=not trace_loaded or not known or flag != observed,
   202	                patch_submitted=flag if known else observed,
   203	                patch_submitted_source=source,
   204	                successful_submit=observed)
