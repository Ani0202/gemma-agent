   293	
   294	def gate_descriptives(entries, row=None):
   295	    roots = root_tool_calls(entries)
   296	    gates = gate_invocations(entries)
   297	    cmds = [c for g in gates for c in g['children'] if c.get('tool') == 'run_command']
   298	    limit = any('LlmCallsLimitExceeded' in _response_text(e) for e in entries
   299	                if e.get('author') == 'submit_patch')
   300	    if row and gates and gates[-1]['canonical_index'] is None and gates[-1]['root_index'] == len(roots) - 1:
   301	        limit |= row.get('agent_outcome') == 'turns'
   302	        limit |= any(re.search(r'LlmCallsLimitExceeded|exceeded turns budget|maximum allowed LLM turns', str(row.get(k, ''))) is not None
   303	                     for k in ('agent_error', 'agent_error_text', 'result_error', 'error'))
   304	    return dict(gate_calls=len(gates),
   305	                bounces=sum(g['canonical_reply'].startswith('NOT SUBMITTED') for g in gates),
   306	                forced=sum('reason=forced' in _response_text(c['response']) for c in cmds),
   307	                check_error=sum('reason=check_error' in _response_text(c['response']) for c in cmds),
   308	                submit_failed=sum(g['canonical_reply'].startswith('SUBMIT FAILED') for g in gates),
   309	                bounce_no_followup=sum(g['root_index'] == len(roots) - 1 and
   310	                                       g['canonical_reply'].startswith('NOT SUBMITTED') for g in gates),
   311	                gate_llm_limit=int(limit),
   312	                unacknowledged_inner_submits=sum(len(g['inner_successes']) for g in gates
   313	                                                if g['canonical_reply'] != 'SUBMITTED'),
   314	                gate_run_cmds=[_command(c) for c in cmds],
   315	                gate_internal_visible=any(g['children'] for g in gates))
   316	
