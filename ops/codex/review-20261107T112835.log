   318	def untracked_only(patch_text):
   319	    sections = re.split(r'^diff --git ', patch_text, flags=re.M)[1:]
   320	    return bool(patch_text.strip() and sections) and all(
   321	        re.search(r'^new file mode [0-7]+\s*$', s, re.M) is not None for s in sections)
   322	
