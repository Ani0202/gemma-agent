  1190	    differences = [k for k in envs['arm3'] if envs['arm3'][k] != envs['base'][k]]
  1191	    envs.update(differences=differences, pairing_void_candidate='kernel_code' in differences)
  1192	    inputs = dict(arm3_timeouts=a['timeouts']['count'], base_timeouts=b['timeouts']['count'],
  1193	                  on_only=len(on), off_only=len(off), p=p, arm3_h=a['h_rows']['count'],
  1194	                  smoke_invalid=smoke_invalid, smoke_bound=smoke_bound, smoke_thinking=ci,
