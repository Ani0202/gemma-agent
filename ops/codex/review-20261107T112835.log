   708	def _classifier(timing, path, sha, rows):
   709	    c = json.loads(Path(path).read_text())
   710	    assert c['classifier_sha256'] == sha
   711	    assert c['input_sha256'] == base.sha(timing)
   712	    by_id = base.unique_map(c['rows'], path)
   713	    assert set(by_id) == {r['instance_id'] for r in rows}
   714	    for r in rows:
   715	        base.assert_paired(by_id[r['instance_id']], r)
   716	    return by_id
