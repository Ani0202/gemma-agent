   276	def selected_bundle(headers):
   277	    """(name, source). Only the kernel header agent_yaml_sha256 is authoritative."""
   278	    shas = {h['agent_yaml_sha256'] for h in headers if isinstance(h.get('agent_yaml_sha256'), str)}
   279	    known = {hashlib.sha256(p.read_bytes()).hexdigest(): n for n, p in BUNDLE_YAMLS.items() if p.is_file()}
   280	    if len(shas) == 1 and next(iter(shas)) in known:
   281	        return known[next(iter(shas))], 'header.agent_yaml_sha256'
   282	    return None, 'unidentified (%s)' % ('no agent_yaml_sha256' if not shas else 'unrecognized or conflicting agent_yaml_sha256')
