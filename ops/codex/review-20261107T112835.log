  1105	def arm3_decision(on, off, p, h_count, smoke_invalid, vetoes, *, pairing_void_reason=None,
  1106	                  base_valid=True, identity_valid=True, smoke_bound=True, thinking_pass=True):
  1107	    if pairing_void_reason:
  1108	        return 'INVALID (pairing voided: ' + pairing_void_reason + ')'
  1109	    if not base_valid:
  1110	        return 'INVALID (base invalid/unruled)'
  1111	    if not identity_valid:
  1112	        return 'INVALID (identity mismatch)'
  1113	    if not thinking_pass:
  1114	        return 'INVALID (smoke i)'
  1115	    if not smoke_bound:
  1116	        return 'INVALID (smoke evidence not bound)'
  1117	    if smoke_invalid or h_count >= 5:
  1118	        return 'INVALID'
  1119	    if off >= on:
  1120	        return 'KEEP-OFF'
  1121	    if p >= .2:
  1122	        return 'NO-DIFFERENCE'
