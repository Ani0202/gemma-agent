   105	def identical_runs_root(entries):
   106	    lens, cur, prev = [], 0, object()
   107	    for c in root_tool_calls(entries):
   108	        key = (c.get('tool'), json.dumps(c.get('args', c.get('arguments')), sort_keys=True))
   109	        if key == prev:
   110	            cur += 1
   111	        else:
   112	            if cur:
   113	                lens.append(cur)
   114	            cur = 1
   115	        prev = key
   116	    if cur:
   117	        lens.append(cur)
   118	    return dict(max_run=max(lens, default=0), runs_ge3=sum(n >= 3 for n in lens),
   119	                runs_ge5=sum(n >= 5 for n in lens), repeated_calls=sum(n - 1 for n in lens))
