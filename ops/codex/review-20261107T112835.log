   549	class GateResponseInBuiltinRun(ValueError):
   550	    """Dec 077 item 2: B3 (unpaired gate-authored inner responses) is unfixed, so the
   551	    builtin (v011) arm-2 path refuses any non-root submit_patch response. STOP, report."""
