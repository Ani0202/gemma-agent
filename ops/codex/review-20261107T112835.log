   554	def nonroot_submit_responses(entries):
   555	    """Raw scan, independent of call pairing: indices of submit_patch responses whose
   556	    author is not the root agent (missing author counts as non-root)."""
   557	    return [i for i, e in enumerate(entries)
   558	            if e.get('type') in ('tool_response', 'tool_result')
   559	            and e.get('tool') == 'submit_patch' and e.get('author') != ROOT]
