   654	# Separate definitions keep the legacy modes' schema bytes stable.
   655	ARM3_DEFINITIONS = {
   656	    'primary': 'resolved is True, including H rows; paired by exact registered instance_id set',
   657	    'sign_test': 'exact two-sided Binomial(n discordants, p=0.5), doubled smaller tail capped at 1; no discordants -> 1',
   658	    'resolved': 'k/n and Wilson 95% CI; plan007_arm1_summary.rate/wilson',
   659	    'h_rows': 'governing d4cdf0f0 h is not None; H>=5 invalid without exemptions; a208a023 alongside',
   660	    'sensitivity': 'resolved over each arm non-H rows; denominator stated separately',
   661	    'known_diag': 'count of truthy governing classifier known_diag; null if unavailable',
   662	    'timing': 'each arm3 row: finite nonnegative agent_clock_seconds <=220 and finalization_seconds <=30; absent evidence fails',
   663	    'timeouts': 'bool(timed_out) or bool(agent_timeout_fired), plan007 definition',
   664	    'safety': 'arm3 test_files_edited and stray_files zero rows; total wall p90 <=1.10*base; empty and submitted_without_test <=base+3; missing evidence fails',
   665	    'thinking': 'thinking_bound.task: root author swe_baseline_agent, type thinking, nonempty content; blocks/chars per task and tasks>0',
   666	    'arm3smoke': 'first two registered ids exactly; i each >=1 thinking block and sum>=5; ii timing; iii vLLM startup, verification verdict, zero H, ZIP/CONTENT event proof and per-push TRANSPORT/header identity',
   667	    'aggregation': 'exact registered 33-id union; earliest supplied dir wins; duplicate attempts listed; within-dir duplicates fail inventory; identity-rejected runs only in uncounted_sensitivity',
   668	    'calls': 'timing llm_turns/tool_calls.total if present; otherwise trace root usage-bearing turns/root tool calls; linear percentiles from plan007.pct',
   669	    'descriptive': 'per repo uses timing repo, fallback id prefix before __; unscreened excludes 004-gpu-retime ids; context overflow unavailable in plan007',
   670	    'env_drift': 'header environment values, null if absent; setup/verification wall p50/p90 from timing; differences reported only',
   671	    'kernel_code': 'header kernel_code and agent/verification path hashes when present; differing values void pairing',
   672	    'decision': 'INVALID for voided pairing, identity mismatch, invalid/unruled base (arm2 base needs ruled SHIP-ELIGIBLE), unbound/failed smoke or H>=5; on ahead p<0.2 adopts only with timeout/timing/all safety; otherwise veto; off>=on KEEP-OFF; else NO-DIFFERENCE',
   673	}
