   334	
   335	def smoke_check(row, entries, gate_yaml_path, scored_patch=None, test_files_loaded=False):
   336	    """D73.2 i..v. scored_patch must already be stripped with task.test_files.
   337	
   338	    Missing evidence is UNVERIFIABLE, which is FAIL for the overall smoke.
   339	    Reasons are fixed descriptions; commands, patches and task text are never emitted.
   340	    """
   341	    out = {}
   342	    gates = gate_invocations(entries)
   343	    desc = gate_descriptives(entries, row)
   344	    expected = _gate_command(gate_yaml_path)
   345	    failures, missing = [], []
   346	    captures = []
   347	    if not gates:
   348	        failures.append('no gate invocation in task')
   349	    for gate in gates:
   350	        children = gate['children']
   351	        if not children:
   352	            missing.append('gate internals absent')
   353	            continue
   354	        if gate['canonical_index'] is None:
   355	            missing.append('canonical gate response absent')
   356	        cmds = [c for c in children if c.get('tool') == 'run_command']
   357	        subs = [c for c in children if c.get('tool') == 'submit_patch']
   358	        captures.extend(gate['inner_successes'])
   359	        if len(cmds) != 1 or _command(cmds[0]) != expected:
   360	            failures.append('gate check command differs or count differs')
   361	        elif cmds[0]['response_index'] is None:
   362	            missing.append('gate check response absent')
   363	        else:
   364	            text = _response_text(cmds[0]['response'])
   365	            need_submit = 'VERDICT=SUBMIT' in text or 'VERDICT=EDIT_FIRST' not in text
   366	            if need_submit and (len(subs) != 1 or subs[0]['entry_index'] <= cmds[0]['response_index']
   367	                                or not gate['inner_successes']):
   368	                failures.append('successful inner submit absent or out of order')
   369	            if not need_submit and subs:
   370	                failures.append('inner submit after EDIT_FIRST')
   371	        if gate['canonical_reply'] == 'SUBMITTED':
   372	            for e in entries[gate['canonical_index'] + 1:]:
   373	                if e.get('author') != ROOT or e.get('type') in ('tool_response', 'tool_result'):
   374	                    continue
   375	                if e.get('type') == 'final' and e.get('content') == gate['canonical_reply']:
   376	                    continue  # legacy recorder's mirrored function-response display
   377	                failures.append('root model event after successful gate response')
   378	                break
   379	    if gates and not captures:
   380	        missing.append('no successful inner submit evidence')
   381	    flag, _ = _terminal_flag(row, entries)
   382	    if flag is False:
   383	        failures.append('run did not end with patch_submitted true')
   384	    elif flag is not True:
   385	        missing.append('terminal patch_submitted flag absent')
   386	    out['i'] = _criterion('FAIL' if failures else 'UNVERIFIABLE' if missing else 'PASS',
   387	                          '; '.join(failures or missing) or 'gate sequence and termination observed')
   388	
   389	    actual = row.get('verified_patch_bytes')
   390	    if not test_files_loaded or scored_patch is None or not captures or type(actual) is not int:
   391	        out['ii'] = _criterion('UNVERIFIABLE', 'task test_files, saved patch or capture evidence missing')
   392	    else:
   393	        size = _patch_size(captures[-1]['response'])
   394	        agrees = len(scored_patch) == size and len(scored_patch.encode('utf-8')) == actual
   395	        out['ii'] = _criterion('PASS' if agrees else 'FAIL',
   396	                               'stripped patch characters and UTF-8 bytes agree' if agrees else 'stripped patch sizes differ')
   397	
   398	    errors = bool(desc['check_error'] or desc['submit_failed'])
   399	    for key in ('agent_error', 'agent_error_text', 'result_error', 'error'):
   400	        err = row.get(key)
   401	        if err and (re.search(r'unknown[ _-]tool|ToolErrorPlugin|compile|validator', str(err), re.I)
   402	                    or not re.search(r'budget|timeout|timed out', str(err), re.I)):
   403	            errors = True
   404	    for e in entries:
   405	        if e.get('author') not in (ROOT, 'submit_patch'):
   406	            continue
   407	        if e.get('type') in ('tool_response', 'tool_result'):
   408	            text = _response_text(e.get('result', ''))
   409	            errors |= _has_error(text) or bool(re.search(r'unknown[ _-]tool|ToolErrorPlugin|compile error|validator error', text, re.I))
   410	    malformed = False
   411	    for gate in gates:
   412	        args = gate.get('args', gate.get('arguments'))
   413	        malformed |= not (isinstance(args, dict) and set(args) == {'request'}
   414	                          and isinstance(args['request'], str) and bool(args['request']))
   415	        malformed |= gate['canonical_reply'] not in ('SUBMITTED', BOUNCE)
   416	        for c in gate['children']:
   417	            args = c.get('args', c.get('arguments'))
   418	            if c.get('tool') == 'run_command':
   419	                malformed |= args != {'command': expected}
   420	            elif c.get('tool') == 'submit_patch':
   421	                malformed |= args != {}
   422	            else:
   423	                malformed = True
   424	    out['iii'] = _criterion('FAIL' if errors or malformed else 'PASS',
   425	                            'error or malformed gate call/reply observed' if errors or malformed else 'no errors or malformed gate calls/replies observed')
   426	    clock = row.get('agent_clock_seconds')
   427	    valid = type(clock) in (int, float) and math.isfinite(clock) and clock >= 0
   428	    out['iv'] = _criterion('UNVERIFIABLE' if not valid else 'PASS' if clock <= 210 else 'FAIL',
   429	                           'agent clock missing or invalid' if not valid else 'agent clock within 210 seconds' if clock <= 210 else 'agent clock exceeds 210 seconds')
   430	    out['v'] = _criterion('PASS' if desc['bounces'] <= 2 else 'FAIL',
   431	                          'at most two EDIT_FIRST replies' if desc['bounces'] <= 2 else 'more than two EDIT_FIRST replies')
   432	    return out
   433	
