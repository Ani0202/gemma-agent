   941	def gold_created_dirs(iid, tasks_path=None):
   942	    """Parent dirs of gold-created files for one task; None if the gold patch cannot be loaded (S81.1: fails, never passes)."""
   943	    path = Path(tasks_path) if tasks_path else _tasks_path()
   944	    key = str(path)
   945	    if key not in _GOLD_DIRS:
   946	        table = {}
   947	        try:
   948	            with open(path) as fh:
   949	                for line in fh:
   950	                    if line.strip():
   951	                        task = json.loads(line)
   952	                        table[task['instance_id']] = task.get('patch')
   953	        except (OSError, ValueError, KeyError):
   954	            table = None
   955	        _GOLD_DIRS[key] = table
   956	    table = _GOLD_DIRS[key]
   957	    if table is None or not isinstance(table.get(iid), str):
   958	        return None
   959	    return {os.path.dirname(f) for f in gold_created_files(table[iid])}
