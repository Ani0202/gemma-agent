   324	def _gate_command(path):
   325	    # Read the literal YAML instruction block without a YAML dependency.
   326	    lines = Path(path).read_text().splitlines()
   327	    i = next(i for i, line in enumerate(lines) if '1. Call `run_command` ONCE' in line)
   328	    return next(line[2:] for line in lines[i + 1:] if line.strip())
