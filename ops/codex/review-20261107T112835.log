   443	
   444	def base_metrics():
   445	    rows, paths = [], [base.ARM_IDS, base.__file__, 'eval/plan007_report.py']
   446	    for part, timing, d4path, a2path in base.PARTS:
   447	        d4, a2 = [json.loads(Path(p).read_text()) for p in (d4path, a2path)]
   448	        assert d4['classifier_sha256'] == base.D4_SHA and a2['classifier_sha256'] == base.A2_SHA
   449	        assert d4['input_sha256'] == base.sha(timing) == a2['input_sha256']
   450	        ts = base.load_rows(timing)
   451	        cs, als = base.unique_map(d4['rows'], d4path), base.unique_map(a2['rows'], a2path)
   452	        assert set(cs) == set(als) == {r['instance_id'] for r in ts}
   453	        paths.extend((timing, d4path, a2path))
   454	        for t in ts:
   455	            iid = t['instance_id']
   456	            base.assert_paired(cs[iid], t)
   457	            base.assert_paired(als[iid], t)
   458	            trace = Path(timing).parent / 'runs' / iid / 'trace.json'
   459	            entries = json.loads(trace.read_text())['entries']
   460	            paths.append(trace)
   461	            rep = identical_runs_root(entries)
   462	            rows.append(dict(instance_id=iid, part=part, **rep, mechanism2=rep['max_run'] >= 5,
   463	                             mechanism1_empty=t.get('verified_patch_bytes') == 0,
   464	                             submitted_without_test=submitted_without_test(entries, gate_mode=False)))
   465	    assert [r['instance_id'] for r in rows] == base.ids_file(base.ARM_IDS)
   466	    totals = dict(mechanism2=sum(r['mechanism2'] for r in rows),
   467	                  mechanism1_empty=sum(r['mechanism1_empty'] for r in rows),
   468	                  submitted_without_test=sum(r['submitted_without_test'] is True for r in rows),
   469	                  count_no_successful_submit=sum(r['submitted_without_test'] is None for r in rows),
   470	                  max_run=max((r['max_run'] for r in rows), default=0),
   471	                  runs_ge3=sum(r['runs_ge3'] for r in rows), runs_ge5=sum(r['runs_ge5'] for r in rows),
   472	                  repeated_calls=sum(r['repeated_calls'] for r in rows))
   473	    assert totals['mechanism2'] == 17, 'arm-1 mechanism2 baseline changed'
   474	    assert totals['mechanism1_empty'] == 12, 'arm-1 empty baseline changed'
   475	    assert totals['submitted_without_test'] == 23, 'arm-1 safety baseline changed'
   476	    assert totals['count_no_successful_submit'] == 7, 'arm-1 no-submit baseline changed'
   477	    return dict(_schema=_schema('base', paths), n_rows=len(rows), totals=totals, rows=rows)
