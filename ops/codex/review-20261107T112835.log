   480	def load_task_test_files(tasks_path):
   481	    # Match agent_timing.evaluate / run_agent_eval.run: the Task property derives
   482	    # these paths from test_patch. Never use gold patch or test text as agent input.
   483	    from swegemma.models import load_tasks
   484	    tasks = load_tasks(Path(tasks_path))
   485	    inventory = {t.instance_id: list(t.test_files) for t in tasks}
   486	    if len(inventory) != len(tasks):
   487	        raise ValueError('duplicate task IDs')
   488	    return inventory
