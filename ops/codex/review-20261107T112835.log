  1224	def arm3_cli(argv):
  1225	    import argparse
  1226	    parser = argparse.ArgumentParser(description='Plan 009 CPU/offline metrics')
  1227	    parser.add_argument('mode', choices=['arm3', 'arm3smoke'])
  1228	    parser.add_argument('--identity-json', required=True)
  1229	    parser.add_argument('--bundle', required=True)
  1230	    parser.add_argument('--transport', action='append', required=True)
  1231	    parser.add_argument('--push-event', action='append', required=True)
  1232	    def transports_for(args, dirs):
  1233	        transports = {}
  1234	        for value in args.transport:
  1235	            if '=' not in value:
  1236	                parser.error('--transport requires DIR=SHA256')
  1237	            directory, sha = value.rsplit('=', 1)
  1238	            if not re.fullmatch('[0-9a-f]{64}', sha):
  1239	                parser.error('--transport requires a SHA256')
  1240	            if str(Path(directory)) in transports:
  1241	                parser.error('duplicate --transport dir')
  1242	            transports[str(Path(directory))] = sha
  1243	        if set(transports) != {str(Path(d)) for d in dirs}:
  1244	            parser.error('--transport required for every arm3 dir')
  1245	        if not re.fullmatch(r'v01[0-9]+', args.bundle):
  1246	            parser.error('--bundle requires v01N')
  1247	        return transports
  1248	    def events_for(args, dirs):
  1249	        events = {}
  1250	        for value in args.push_event:
  1251	            if '=' not in value:
  1252	                parser.error('--push-event requires DIR=EVENT')
  1253	            directory, event = value.rsplit('=', 1)
  1254	            directory = str(Path(directory))
  1255	            if directory in events:
  1256	                parser.error('duplicate --push-event dir')
  1257	            events[directory] = event
  1258	        errors = _push_errors(dirs, events, {d for d, e in events.items() if e == 'smoke'}, args.mode == 'arm3smoke')
  1259	        if errors:
  1260	            parser.error('; '.join(errors))
  1261	        return events
  1262	    if argv[1] == 'arm3smoke':
