   122	def _has_error(value):
   123	    value = _parsed(value)
   124	    if isinstance(value, dict):
   125	        if value.get('error') or str(value.get('status', '')).lower() in ('error', 'failed', 'failure'):
   126	            return True
   127	        return any(_has_error(v) for v in value.values())
   128	    if isinstance(value, list):
   129	        return any(_has_error(v) for v in value)
   130	    return False
   131	
   132	
   133	def _patch_size(value):
   134	    value = _parsed(value)
   135	    if isinstance(value, dict) and not _has_error(value):
   136	        n = value.get('patch_size')
   137	        if type(n) is int and n >= 0:
   138	            return n
   139	    return None
