   207	def submitted_without_test(entries, gate_mode=None):
   208	    index = successful_submit_index(entries, gate_mode)
   209	    if index is None:
   210	        return None
   211	    return not any(c.get('tool') == 'run_command' and TEST.search(_command(c))
   212	                   for c in root_tool_calls(entries)[:index])
