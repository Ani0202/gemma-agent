   190	def _terminal_flag(row, entries):
   191	    if type(row.get('patch_submitted')) is bool:
   192	        return row['patch_submitted'], 'row'
   193	    flags = [e['patch_submitted'] for e in entries if type(e.get('patch_submitted')) is bool]
   194	    return (flags[-1], 'trace') if flags else (None, 'derived_from_harness_response')
