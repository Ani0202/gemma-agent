  1170	    smoke_bound = all(evidence.get(str(p)) == base.sha(p) for p in required_evidence)
  1171	    # A smoke report must name exactly the timing files that supplied the counted rows.
  1172	    smoke_bound = smoke_bound and {str(Path(p)) for p in evidence if Path(p).name == 'timing.jsonl'} == {
  1173	        str(Path(d) / 'timing.jsonl') for d in smoke_dirs}
