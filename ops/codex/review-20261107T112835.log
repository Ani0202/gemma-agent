   735	def _manifest_path(bundle):
   736	    return BUNDLES_ROOT / bundle / 'MANIFEST.md' if isinstance(bundle, str) and re.fullmatch(r'v01[0-9]+', bundle) else None
   737	
   738	
   739	def _push_errors(dirs, push_events, smoke_dirs, smoke_only=False):
   740	    dirs = [str(Path(d)) for d in dirs]
   741	    errors = []
   742	    if len(set(dirs)) != len(dirs) or set(push_events) != set(dirs):
   743	        errors.append('push-event dirs must match run dirs exactly')
   744	    events = list(push_events.values())
   745	    if any(not isinstance(e, str) or not PUSH_EVENT.fullmatch(e) for e in events):
   746	        errors.append('invalid push event')
   747	    if len(set(events)) != len(events):
   748	        errors.append('duplicate push event')
   749	    if smoke_only:
   750	        if len(dirs) != 1 or events != ['smoke']:
   751	            errors.append('arm3smoke requires one smoke push')
   752	    elif events.count('smoke') != 1 or events.count('main') != 1:
   753	        errors.append('arm3 requires exactly one smoke and one main push')
   754	    if {d for d, e in push_events.items() if e == 'smoke'} != smoke_dirs:
   755	        errors.append('smoke push must supply both counted smoke rows')
   756	    return errors
