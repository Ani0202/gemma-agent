   872	def aggregate_arm(dirs, classifiers):
   873	    """Inventory first, before loading classifier/trace evidence. Never drop a row."""
   874	    selected, occurrences, paths, headers = {}, defaultdict(list), [], []
   875	    for directory in dirs:
   876	        timing = Path(directory) / 'timing.jsonl'
   877	        if not timing.is_file():
   878	            raise IncompleteRun(dict(dir=str(directory), missing_timing=True))
   879	        try:
   880	            rows = base.load_rows(timing)
   881	        except AssertionError:
   882	            raw = [json.loads(l) for l in timing.read_text().splitlines() if l.strip()]
   883	            inv = inventory([r['instance_id'] for r in raw if 'instance_id' in r], base.ids_file(base.ARM_IDS))
   884	            raise IncompleteRun(dict(dir=str(directory), inventory=inv))
   885	        paths.append(timing)
   886	        headers.extend(_headers(timing))
   887	        for row in rows:
   888	            iid = row['instance_id']
   889	            occurrences[iid].append(dict(dir=str(directory), resolved=row.get('resolved'),
   890	                                         timeout=bool(row.get('timed_out') or row.get('agent_timeout_fired')),
   891	                                         empty_patch=row.get('verified_patch_bytes') == 0))
   892	            selected.setdefault(iid, (row, str(directory)))
   893	    inv = inventory(list(selected), base.ids_file(base.ARM_IDS))
   894	    inv['duplicates'] = [dict(instance_id=i, dirs=[a['dir'] for a in ds], attempts=ds) for i, ds in occurrences.items() if len(ds) > 1]
   895	    if not inv['complete']:
   896	        raise IncompleteRun(inv)
   897	    classified = {}
   898	    for directory in dirs:
   899	        timing = Path(directory) / 'timing.jsonl'
   900	        d4, a2 = classifiers[str(Path(directory))]
