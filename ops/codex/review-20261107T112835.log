   141	
   142	def gate_invocations(entries):
   143	    """Legacy traces lack event IDs: enclose children by root call/reply interval.
   144	
   145	    A missing acknowledgement ends at the next root call or trace end. This retains
   146	    inner captures interrupted by a deadline, without assigning them to a later call.
   147	    Only the root tool_response is a canonical gate reply.
   148	    """
   149	    pairs = _pairs(entries)
   150	    roots = [c for c in pairs if c.get('author') == ROOT]
   151	    gates = []
   152	    for i, c in enumerate(roots):
   153	        if c.get('tool') != 'submit_patch':
   154	            continue
   155	        end = roots[i + 1]['entry_index'] if i + 1 < len(roots) else len(entries)
   156	        reply_index = c['response_index']
   157	        canonical = (reply_index is not None and reply_index < end
   158	                     and entries[reply_index].get('type') == 'tool_response')
   159	        if canonical:
   160	            end = reply_index
   161	        children = [dict(p, response=None, response_index=None)
   162	                    if p['response_index'] is not None and p['response_index'] >= end else p
   163	                    for p in pairs if p.get('author') == 'submit_patch'
   164	                    and c['entry_index'] < p['entry_index'] < end]
   165	        inner = [p for p in children if p.get('tool') == 'submit_patch'
   166	                 and p['response_index'] is not None and p['response_index'] < end
   167	                 and _patch_size(p['response']) is not None]
   168	        gates.append(dict(c, root_index=i, children=children, inner_successes=inner,
   169	                          canonical_reply=_reply(c['response']) if canonical else '',
   170	                          canonical_index=reply_index if canonical else None))
   171	    return gates
   172	
   173	
   174	def successful_submit_index(entries, gate_mode=None):
   175	    gates = {g['entry_index']: g for g in gate_invocations(entries)}
   176	    for i, c in enumerate(root_tool_calls(entries)):
   177	        if c.get('tool') != 'submit_patch':
   178	            continue
   179	        gate = gates[c['entry_index']]
   180	        args = c.get('args', c.get('arguments'))
   181	        is_gate = gate_mode if gate_mode is not None else bool(
   182	            gate['children'] or isinstance(args, dict) and 'request' in args
   183	            or gate['canonical_reply'] in ('SUBMITTED', BOUNCE)
   184	            or gate['canonical_reply'].startswith('SUBMIT FAILED'))
   185	        if (gate['inner_successes'] if is_gate else _patch_size(c['response']) is not None):
   186	            return i
   187	    return None
