  1061	def environment_metrics(headers, records):
  1062	    aliases = dict(docker_image_digest=('docker_image_digest', 'docker_image'),
  1063	                   vllm_version=('vllm_version',), google_adk_version=('google_adk_version', 'google-adk'),
  1064	                   swegemma_version=('swegemma_version',), model_id=('model_id', 'model'),
  1065	                   gpu_names=('gpu_names',), gpu_count=('gpu_count',))
  1066	    def values(keys):
  1067	        vals = []
  1068	        for h in headers:
  1069	            val = next((h[k] for k in keys if k in h), None)
  1070	            if val not in vals:
  1071	                vals.append(val)
  1072	        return vals[0] if len(vals) == 1 else vals or None
  1073	    out = {key: values(keys) for key, keys in aliases.items()}
  1074	    for package in ('vllm', 'google-adk', 'swegemma'):
  1075	        key = package.replace('-', '_') + '_version'
  1076	        if out[key] is None:
  1077	            values_from_versions = []
  1078	            for h in headers:
  1079	                val = (h.get('versions') or {}).get(package)
  1080	                if val not in values_from_versions:
  1081	                    values_from_versions.append(val)
  1082	            out[key] = values_from_versions[0] if len(values_from_versions) == 1 else values_from_versions or None
  1083	    for field, wall in (('setup_wall_p50_p90', None), ('verification_wall_p50_p90', 'verification')):
  1084	        out[field] = _quantiles([r.get('sandbox_setup_seconds') if wall is None else
  1085	                                 (r.get('wall_seconds') or {}).get(wall) for r, _, _, _ in records])
  1086	    kernel_keys = sorted({k for h in headers for k in h if k.startswith('kernel_code') or
  1087	                          (('agent' in k or 'verification' in k) and ('sha' in k) and k != 'agent_yaml_sha256')})
  1088	    out['kernel_code'] = {k: values((k,)) for k in kernel_keys} or None
  1089	    return out
