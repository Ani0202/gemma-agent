   265	def inventory(ids, expected):
   266	    seen = set(ids)
   267	    out = dict(expected=len(expected), observed=len(ids),
   268	               missing=[i for i in expected if i not in seen],
   269	               extra=sorted(seen - set(expected)),
   270	               duplicates=sorted({i for i in ids if ids.count(i) > 1}),
   271	               order_matches=list(ids) == list(expected))
   272	    out['complete'] = not (out['missing'] or out['extra'] or out['duplicates'])
   273	    return out
