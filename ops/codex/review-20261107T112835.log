   504	def smoke_metrics(run_dir, tasks_path=None):
   505	    timing = Path(run_dir) / 'timing.jsonl'
   506	    paths, rows = [timing, GATE_YAML], []
   507	    tasks_path = Path(tasks_path) if tasks_path is not None else _tasks_path()
   508	    if tasks_path.is_file():
   509	        paths.append(tasks_path)
   510	    try:
   511	        test_files = load_task_test_files(tasks_path)
   512	    except Exception:
   513	        test_files = {}  # criterion ii is UNVERIFIABLE for every missing task
   514	    for row in base.load_rows(timing):
   515	        artifacts = _artifacts(run_dir, row['instance_id'])
   516	        trace, patch = artifacts / 'trace.json', artifacts / 'agent.patch'
   517	        if trace.is_file():
   518	            paths.append(trace)
   519	        entries = json.loads(trace.read_text()).get('entries', []) if trace.is_file() else []
   520	        scored = None
   521	        loaded = row['instance_id'] in test_files
   522	        if patch.is_file():
   523	            paths.append(patch)
   524	            if loaded:
   525	                from swegemma.harness.verification import strip_protected_files_from_patch
   526	                try:
   527	                    scored = strip_protected_files_from_patch(patch.read_bytes().decode('utf-8'),
   528	                                extra_protected_paths=test_files[row['instance_id']])
   529	                except (OSError, UnicodeError, ValueError):
   530	                    scored = None
   531	        desc = gate_descriptives(entries, row)
   532	        desc.pop('gate_run_cmds')
   533	        rows.append(dict(instance_id=row['instance_id'],
   534	                         criteria=smoke_check(row, entries, GATE_YAML, scored, loaded), **desc))
   535	    inv = inventory([r['instance_id'] for r in rows], expected_ids('smoke'))
   536	    passed = inv['complete'] and bool(rows) and all(c['status'] == 'PASS' for r in rows for c in r['criteria'].values())
   537	    return dict(_schema=_schema('smoke', paths), n_rows=len(rows), inventory=inv,
   538	                overall='PASS' if passed else 'FAIL', rows=rows)
