   215	def earliest_candidate_index(entries):
   216	    """D73.5 boundary, independent of successful-root attribution: the earliest of
   217	    (a) any gate-authored inner submit_patch harness response carrying patch_size,
   218	    (b) the root submit call enclosing such a response (gate_invocations interval),
   219	    (c) any root submit_patch call whose own response carries patch_size (builtin).
   220	    Extra candidates only move the boundary earlier (stricter). None = no candidate."""
   221	    cands = [i for i in nonroot_submit_responses(entries)
   222	             if _patch_size(entries[i].get('result', '')) is not None]
   223	    cands += [p['response_index'] for p in _pairs(entries)
   224	             if p.get('author') == 'submit_patch' and p.get('tool') == 'submit_patch'
   225	             and p['response_index'] is not None and _patch_size(p['response']) is not None]
   226	    cands += [g['entry_index'] for g in gate_invocations(entries) if g['inner_successes']]
   227	    cands += [c['entry_index'] for c in root_tool_calls(entries)
   228	              if c.get('tool') == 'submit_patch' and _patch_size(c['response']) is not None]
   229	    return min(cands, default=None)
   230	
   231	
   232	def tested_before(entries, index):
   233	    return index is not None and any(
   234	        c.get('tool') == 'run_command' and TEST.search(_command(c)) and c['entry_index'] < index
   235	        for c in root_tool_calls(entries))
