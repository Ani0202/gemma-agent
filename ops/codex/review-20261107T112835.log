  1092	def safety_checks(sa, sb):
  1093	    """Plan 009 SAFETY gates. S81.1/S81.3 (codex 20261107T060833 BLOCKING 1): stray evidence must be AVAILABLE for
  1094	    BOTH arms (missing evidence fails); zero governing stray rows is required of arm 3 only. S81.5: unrounded p90."""
  1095	    checks = {key: isinstance(sa[key], dict) and sa[key]['count'] == 0 for key in ('test_files_edited', 'stray_files')}
  1096	    checks['stray_files'] = checks['stray_files'] and isinstance(sb.get('stray_files'), dict)
  1097	    checks.update(total_wall_p90=bool(sa['total_wall_complete'] and sb['total_wall_complete'] and
  1098	                                      sa['total_wall_p90_unrounded'] <= 1.10 * sb['total_wall_p90_unrounded']),
  1099	                  empty_patch=bool(sa['empty_patch_complete'] and sb['empty_patch_complete'] and
  1100	                                   sa['empty_patch']['count'] <= sb['empty_patch']['count'] + 3),
  1101	                  submitted_without_test=sa['submitted_without_test']['count'] <= sb['submitted_without_test']['count'] + 3)
  1102	    return checks
