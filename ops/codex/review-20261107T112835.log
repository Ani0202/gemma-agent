   758	
   759	def identity_check(dirs, identity_json, bundle, transports, smoke_dirs, push_events=None, *, smoke_only=False):
   760	    """Only the latest exact-event proof can authorize a push; hash types stay separate."""
   761	    push_events = push_events or {}
   762	    mapping_errors = _push_errors(dirs, push_events, smoke_dirs, smoke_only)
   763	    if set(transports) != {str(Path(d)) for d in dirs}:
   764	        mapping_errors.append('transport dirs must match run dirs exactly')
   765	    records = _read_json(identity_json).get('records', [])
   766	    records = records if isinstance(records, list) else []
   767	    manifest = _manifest_path(bundle)
   768	    try:
   769	        matches = re.findall(r'^zip sha256:\s*([0-9a-fA-F]{64})[ \t]*$', manifest.read_text(), re.MULTILINE)
   770	        registered_zip = matches[0].lower() if len(matches) == 1 else None
   771	    except (OSError, AttributeError, UnicodeError):
   772	        registered_zip = None
   773	    results = []
   774	    for directory in dirs:
   775	        directory = str(Path(directory))
   776	        event = push_events.get(directory)
   777	        matching = [r for r in records if isinstance(r, dict) and event is not None and r.get('event') == event]
   778	        latest = matching[-1] if matching else {}
   779	        bundles = latest.get('bundles', {})
   780	        proof = bundles.get(bundle, {}) if isinstance(bundles, dict) else {}
   781	        proof = proof if isinstance(proof, dict) else {}
   782	        reasons = list(mapping_errors)
   783	        if not matching:
   784	            reasons.append('missing event record')
   785	        for key in ('pass', 'zip_ok', 'content_ok'):
   786	            if proof.get(key) is not True:
   787	                reasons.append(key + ' must be true')
   788	        hashes = {}
   789	        for key in ('zip_sha256', 'manifest_zip_sha256', 'agent_yaml_sha256'):
   790	            value = proof.get(key)
   791	            hashes[key] = value.lower() if isinstance(value, str) and re.fullmatch('[0-9a-fA-F]{64}', value) else None
   792	            if hashes[key] is None:
   793	                reasons.append(key + ' missing/invalid')
   794	        if hashes['zip_sha256'] != hashes['manifest_zip_sha256']:
   795	            reasons.append('ZIP differs from proof manifest')
   796	        if registered_zip is None or hashes['zip_sha256'] != registered_zip:
   797	            reasons.append('registered MANIFEST ZIP missing/mismatched')
   798	        for key in ('only_in_zip', 'only_in_dir', 'byte_mismatch', 'duplicate_members'):
   799	            if not isinstance(proof.get(key), list) or proof[key]:
   800	                reasons.append(key + ' must be an empty list')
   801	        if not isinstance(proof.get('zip_path'), str) or not proof['zip_path'].endswith(f'31b-{bundle}.zip'):
   802	            reasons.append('zip_path missing/invalid')
   803	        timing = Path(directory) / 'timing.jsonl'
   804	        headers = _headers(timing) if timing.is_file() else []
   805	        transport = transports.get(directory)
   806	        if not headers:
   807	            reasons.append('missing headers')
   808	        if not isinstance(transport, str) or not re.fullmatch('[0-9a-f]{64}', transport) or any(h.get('bundle_sha256') != transport for h in headers):
   809	            reasons.append('transport header mismatch')
   810	        if any(h.get('agent_yaml_sha256') != hashes['agent_yaml_sha256'] for h in headers):
   811	            reasons.append('agent header mismatch')
   812	        results.append(dict(dir=directory, event=event, record_count=len(matching),
   813	                            zip_sha256=hashes['zip_sha256'], agent_yaml_sha256=hashes['agent_yaml_sha256'],
   814	                            transport_sha256=transport, failure_reasons=reasons))
   815	    for key in ('zip_sha256', 'agent_yaml_sha256'):
   816	        if len({r[key] for r in results if r[key] is not None}) > 1:
   817	            for r in results:
   818	                r['failure_reasons'].append(key + ' differs across pushes')
   819	    for r in results:
   820	        r['checked'] = not r['failure_reasons']
   821	    return dict(checked=bool(results) and all(r['checked'] for r in results), runs=results,
   822	                mismatching_dirs=[r['dir'] for r in results if not r['checked']])
   823	
   824	
   825	def arm3smoke_metrics(run_dir, classifier, identity_json=None, bundle=None, transports=None, push_events=None):
   826	    timing = Path(run_dir) / 'timing.jsonl'
   827	    paths = [base.ARM_IDS, base.__file__, 'eval/plan007_report.py', 'eval/thinking_bound.py']
   828	    expected = base.ids_file(base.ARM_IDS)[:2]
   829	    rows = base.load_rows(timing) if timing.is_file() else []
   830	    if timing.is_file():
   831	        paths.append(timing)
   832	    inv = inventory([r['instance_id'] for r in rows], expected)
   833	    traces = [Path(run_dir) / 'runs' / iid / 'trace.json' for iid in expected]
   834	    paths.extend(p for p in traces if p.is_file())
   835	    ci = thinking_criterion(traces)
   836	    ti = arm3_timing(rows)
   837	    missing_time = not rows or any(not _finite_number(r.get(k)) for r in rows
   838	                                 for k in ('agent_clock_seconds', 'finalization_seconds'))
   839	    cii = dict(status='UNVERIFIABLE' if missing_time else 'PASS' if ti['timing_pass'] else 'FAIL', **ti)
   840	    headers = _headers(timing) if timing.is_file() else []
   841	    identity = {k: [h.get(k) for h in headers] for k in ('agent_yaml_sha256', 'bundle_sha256')}
   842	    checked_identity = identity_check([run_dir], identity_json, bundle, transports or {}, {str(Path(run_dir))}, push_events, smoke_only=True)
   843	    if identity_json and _readable_file(identity_json):
   844	        paths.append(identity_json)
   845	    manifest = _manifest_path(bundle)
   846	    if manifest and _readable_file(manifest):
   847	        paths.append(manifest)
   848	    startup = [r.get('_vllm') for r in map(json.loads, filter(str.strip, timing.read_text().splitlines())) if '_vllm' in r] if timing.is_file() else []
   849	    vllm_up = any(isinstance(v, dict) and _finite_number(v.get('startup_seconds'))
   850	                  and v['startup_seconds'] > 0 for v in startup)
   851	    identity_missing = not headers or any(not v for vals in identity.values() for v in vals)
   852	    identity_conflict = any(len(set(vals)) > 1 for vals in identity.values())
   853	    hs = None
   854	    if timing.is_file() and Path(classifier).is_file():
   855	        paths.append(classifier)
   856	        cs = _classifier(timing, classifier, base.D4_SHA, rows)
   857	        hs = ([r['instance_id'] for r in rows if cs[r['instance_id']]['h'] is not None]
   858	              if all('h' in cs[r['instance_id']] for r in rows) else None)
   859	    verdict_missing = any(type(r.get('resolved')) is not bool or r.get('verification_skipped') is True for r in rows)
   860	    missing = bool(inv['missing']) or not rows or hs is None or identity_missing or verdict_missing or not vllm_up
   861	    ciii = dict(status='FAIL' if inv['extra'] or inv['duplicates'] or identity_conflict or not checked_identity['checked'] or hs else
   862	                'UNVERIFIABLE' if missing else 'PASS', h_rows=hs, identity_headers=identity,
   863	                identity=checked_identity, vllm_up=vllm_up)
   864	    criteria = dict(i=ci, ii=cii, iii=ciii)
   865	    overall = 'PASS' if all(c['status'] == 'PASS' for c in criteria.values()) else 'FAIL'
   866	    return dict(_schema=_schema('arm3smoke', paths), n_rows=len(rows), inventory=inv,
   867	                criteria=criteria, overall=overall,
   868	                verdict='INVALID (smoke i)' if ci['status'] != 'PASS' else overall,
   869	                label='thinking ACTIVE != budget enforced')
