  1018	            len(e.get('content') or '') for e in entries if e.get('author') == ROOT and e.get('type') == 'thinking')))
  1019	        repeats.append(dict(instance_id=iid, **identical_runs_root(entries)))
  1020	        llm.append(row.get('llm_turns') if row.get('llm_turns') is not None else th['root_usage_turns'])
  1021	        tc = row.get('tool_calls')
  1022	        tools.append(tc['total'] if isinstance(tc, dict) and tc.get('total') is not None else len(root_tool_calls(entries)))
  1023	        observed = submitted_without_test(entries, gate_mode=False)
  1024	        count = observed is True
  1025	        if not arm1:
  1026	            evidence = dict(submitted_without_test=observed, **submit_evidence(row, entries, False))
  1027	            count = d735_counts(evidence, entries)['swt_d735']
