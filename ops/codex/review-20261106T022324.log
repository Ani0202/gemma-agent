    45	class SubAgentRef(BaseModel):
    46	    """Reference to a sub-agent's YAML configuration file.
    47	
    48	    This model is used within multi-agent workflows (Sequential, Parallel, Loop, and LLM sub-agents)
    49	    to reference child agents. Only ``config_path`` is supported; the standard ADK ``code`` field
    50	    (which resolves arbitrary Python imports) is intentionally excluded to prevent unsandboxed code execution.
    51	    The ``config_path`` field is strictly validated to prevent path traversal attacks.
    52	    """
    53	
    54	    model_config = ConfigDict(extra="forbid", frozen=True)
    55	
    56	    config_path: str = Field(
    57	        description="Relative path to the sub-agent's YAML config within "
    58	        "the submission directory."
    59	    )
    60	
    61	    @field_validator("config_path")
    62	    @classmethod
    63	    def validate_no_path_traversal(cls, v: str) -> str:
    64	        """Validate that the configuration path does not attempt directory traversal.
    65	
    66	        Args:
    67	            v (str): The relative file path to validate.
    68	
    69	        Returns:
    70	            str: The unmodified file path if validation succeeds.
    71	
    72	        Raises:
    73	            PathTraversalError: If the path contains traversal components.
    74	        """
    75	        ensure_no_traversal_components(v)
    76	        return v
