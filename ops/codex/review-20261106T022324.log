     1	#!/usr/bin/env python3
     2	"""Count tool-call errors per task in a timing run's traces (plan 005 mechanism metrics).
     3	
     4	Usage: trace_tool_errors.py <run_dir> <bundle_label> <out.json> [<ids_file>]
     5	With <ids_file> (one instance id per line), the run must contain EXACTLY those ids, each with trace.json and
     6	agent.patch, else exit 2 (no output written). Responses are classified by their own tool name (fallback: the
     7	earliest unanswered call), and paired to calls FIFO per tool for call indices.
     8	Reads <run_dir>/runs/<task>/{trace.json,agent.patch}. Writes counts only (no task text).
     9	Error classes (matched on the tool response, never on task content):
    10	  write_outside_ws   write_file rejected: "escapes workspace root"
    11	  edit_missing_param edit_file rejected: mandatory input parameters not present (mangled tool-call args)
    12	  edit_other_error   any other edit_file error
    13	  cmd_error_empty    unsuccessful run_command response with empty message (e.g. grep no-match exit 1)
    14	  cmd_error_shell    unsuccessful run_command response containing "syntax error" (shell quoting)
    15	  cmd_error_other    any other unsuccessful run_command response (any error_type except BudgetExceeded,
    16	                     e.g. CommandError, TimeoutExceeded)
    17	  budget_exceeded    BudgetExceeded responses
    18	  sitecustomize_warn responses whose text mentions "Error in sitecustomize" (stderr noise, may be non-fatal)
    19	"""
    20	import ast, json, os, sys
    21	
    22	
    23	def _load(v):
    24	    if isinstance(v, dict):
    25	        return v
    26	    s = str(v)
    27	    try:
    28	        return json.loads(s)
    29	    except Exception:
    30	        try:
    31	            return ast.literal_eval(s)
    32	        except Exception:
    33	            return {"raw": s}
    34	
    35	
    36	def classify(tool, r):
    37	    raw = json.dumps(r)
    38	    cls = []
    39	    if "Error in sitecustomize" in raw:
    40	        cls.append("sitecustomize_warn")
    41	    if r.get("status") == "ok":
    42	        return cls, True
    43	    et = r.get("error_type") or ""
    44	    msg = str(r.get("error_message") or r.get("error") or "")
    45	    if et == "BudgetExceeded":
    46	        cls.append("budget_exceeded")
    47	    elif tool == "write_file" and "escapes workspace root" in msg:
    48	        cls.append("write_outside_ws")
    49	    elif tool == "edit_file" and "mandatory input parameters are not present" in msg:
    50	        cls.append("edit_missing_param")
    51	    elif tool == "edit_file":
    52	        cls.append("edit_other_error")
    53	    elif tool == "run_command" and not msg.strip():
    54	        cls.append("cmd_error_empty")
    55	    elif tool == "run_command" and "syntax error" in msg:
    56	        cls.append("cmd_error_shell")
    57	    elif tool == "run_command":
    58	        cls.append("cmd_error_other")
    59	    else:
    60	        cls.append(f"{tool}_error")
    61	    return cls, False
    62	
    63	
    64	def main(run_dir, label, out, ids_file=None):
    65	    base = os.path.join(run_dir, "runs")
    66	    tasks = sorted(t for t in os.listdir(base)
    67	                   if os.path.isfile(os.path.join(base, t, "trace.json")))
    68	    if ids_file:
    69	        want = sorted(l.strip() for l in open(ids_file) if l.strip() and not l.startswith("#"))
    70	        bad = [t for t in want if not (os.path.isfile(os.path.join(base, t, "trace.json"))
    71	                                       and os.path.isfile(os.path.join(base, t, "agent.patch")))]
    72	        extra = sorted(set(tasks) - set(want))
    73	        if bad or extra:
    74	            print(json.dumps({"error": "incomplete or unexpected artifacts", "missing": bad, "extra": extra}))
    75	            sys.exit(2)
    76	        tasks = want
    77	    rows, tot = [], {}
    78	    for t in tasks:
    79	        d = json.load(open(os.path.join(base, t, "trace.json")))
    80	        pp = os.path.join(base, t, "agent.patch")
    81	        row = {"instance_id": t, "patch_bytes": os.path.getsize(pp) if os.path.exists(pp) else None,
    82	               "tool_calls": 0, "tool_errors": 0, "calls_by_tool": {}, "errors": {},
    83	               "first_ok_edit_elapsed_s": None, "first_ok_edit_call_index": None}
    84	        pending = []  # [(call_index, tool)] unanswered calls, in order
    85	        for e in d["entries"]:
    86	            if e["type"] == "tool_call":
    87	                tool = e.get("tool")
    88	                row["tool_calls"] += 1
    89	                row["calls_by_tool"][tool] = row["calls_by_tool"].get(tool, 0) + 1
    90	                pending.append((row["tool_calls"], tool))
    91	            elif e["type"] == "tool_response":
    92	                tool = e.get("tool")
    93	                j = next((i for i, (_, t) in enumerate(pending) if t == tool), 0 if pending else None)
    94	                idx, ctool = pending.pop(j) if j is not None else (None, None)
    95	                tool = tool or ctool
    96	                cls, ok = classify(tool, _load(e.get("result", "")))
    97	                for c in cls:
    98	                    row["errors"][c] = row["errors"].get(c, 0) + 1
    99	                    tot[c] = tot.get(c, 0) + 1
   100	                if not ok:
   101	                    row["tool_errors"] += 1
   102	                if ok and tool == "edit_file" and row["first_ok_edit_elapsed_s"] is None:
   103	                    row["first_ok_edit_elapsed_s"] = float(e["elapsed_s"])
   104	                    row["first_ok_edit_call_index"] = idx
   105	        rows.append(row)
   106	    res = {
   107	        "_schema": "trace_tool_errors_v1",
   108	        "run": run_dir, "bundle": label, "n": len(rows),
   109	        "generator": "eval/trace_tool_errors.py",
   110	        "fields": {"patch_bytes": "size of agent.patch (0 = empty diff)",
   111	                   "errors": "per-class counts, see generator docstring",
   112	                   "first_ok_edit_*": "first edit_file with status ok (null = none; sed/shell edits not counted)"},
   113	        "empty_patch_count": sum(1 for r in rows if r["patch_bytes"] == 0),
   114	        "tasks_with_class": {c: sum(1 for r in rows if r["errors"].get(c)) for c in sorted(tot)},
   115	        "totals": dict(sorted(tot.items())),
   116	        "tasks": rows,
   117	    }
   118	    with open(out, "w") as f:
   119	        json.dump(res, f, indent=1)
   120	    print(json.dumps({k: res[k] for k in ("n", "empty_patch_count", "tasks_with_class", "totals")}))
   121	
   122	
   123	if __name__ == "__main__":
   124	    main(*sys.argv[1:5])

