   119	def _strip_thought_parts_from_response(llm_response: Any) -> tuple[Any, bool]:
   120	    """Remove Part(thought=True) from an LlmResponse while preserving visible text, tool calls, and metadata.
   121	
   122	    Returns:
   123	        A tuple of (updated_llm_response, should_skip_partial).
   124	    """
   125	    content = getattr(llm_response, "content", None)
   126	    parts = getattr(content, "parts", None) if content is not None else None
   127	    if not isinstance(parts, list) or not any(
   128	        getattr(p, "thought", False) is True for p in parts
   129	    ):
   130	        return llm_response, False
   131	
   132	    filtered_parts = [p for p in parts if not getattr(p, "thought", False)]
   133	    is_partial = bool(getattr(llm_response, "partial", False))
   134	    if (
   135	        is_partial
   136	        and not filtered_parts
   137	        and getattr(llm_response, "usage_metadata", None) is None
   138	        and getattr(llm_response, "error_code", None) is None
   139	    ):
   140	        return llm_response, True
   141	
   142	    content.parts = filtered_parts
   143	    return llm_response, False
