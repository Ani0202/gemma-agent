    35	    types_mod = _get_genai_types(ctx)
    36	    if config.generate_content_config is not None:
    37	        config_dict = config.generate_content_config.model_dump(exclude_none=True)
    38	
    39	        if ctx.generation_constraints is not None:
    40	            config_dict = ctx.generation_constraints.validate_config(
    41	                config_dict, config.name
    42	            )
    43	
    44	        if config_dict:
    45	            return types_mod.GenerateContentConfig(**config_dict)
    46	        return None
    47	
    48	    # No user config — apply organizer defaults if any
    49	    if (
    50	        ctx.generation_constraints is not None
    51	        and ctx.generation_constraints.defaults
    52	    ):
    53	        validated = ctx.generation_constraints.validate_config({}, config.name)
    54	        return types_mod.GenerateContentConfig(
    55	            **validated
    56	        )
