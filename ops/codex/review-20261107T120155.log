  1349	        document = _read_json(trace)
  1350	        summary = document.get('summary')
  1351	        sources = [document, summary] + [e for e in entries if e.get('type') in ('error', 'exception', 'agent_end')]
  1352	        explicit, errors = [], []
  1353	        for source in sources + entries:
  1354	            if not isinstance(source, dict):
  1355	                continue
  1356	            if type(source.get('context_overflow')) is bool:
  1357	                explicit.append(source['context_overflow'])
  1358	            errors.extend(source[k] for k in ('error', 'error_message', 'exception', 'agent_error') if source.get(k))
  1359	        for event in sources[2:]:
  1360	            errors.extend(event.get(k) for k in ('content', 'message') if event.get(k))
  1361	        if any(explicit) or any(pattern.search(_response_text(error)) for error in errors):
  1362	            found.append(row['instance_id'])
  1363	        elif not explicit and not any(e.get('type') == 'agent_end' or
  1364	                                      e.get('type') == 'final' and e.get('author') == ROOT for e in entries):
