   770	    records = records if isinstance(records, list) else []
   771	    manifest = _manifest_path(bundle)
   772	    try:
   773	        matches = re.findall(r'^zip sha256:\s*([0-9a-fA-F]{64})[ \t]*$', manifest.read_text(), re.MULTILINE)
   774	        registered_zip = matches[0].lower() if len(matches) == 1 else None
   775	    except (OSError, AttributeError, UnicodeError):
   776	        registered_zip = None
   777	    results = []
   778	    for directory in dirs:
   779	        directory = str(Path(directory))
   780	        event = push_events.get(directory)
   781	        matching = [r for r in records if isinstance(r, dict) and event is not None and r.get('event') == event]
   782	        latest = matching[-1] if matching else {}
   783	        bundles = latest.get('bundles', {})
   784	        proof = bundles.get(bundle, {}) if isinstance(bundles, dict) else {}
   785	        proof = proof if isinstance(proof, dict) else {}
   786	        reasons = list(mapping_errors)
   787	        if not matching:
   788	            reasons.append('missing event record')
   789	        for key in ('pass', 'zip_ok', 'content_ok'):
   790	            if proof.get(key) is not True:
