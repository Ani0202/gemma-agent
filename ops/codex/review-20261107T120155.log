   876	def aggregate_arm(dirs, classifiers):
   877	    """Inventory first, before loading classifier/trace evidence. Never drop a row."""
   878	    selected, occurrences, paths, headers = {}, defaultdict(list), [], []
   879	    for directory in dirs:
   880	        timing = Path(directory) / 'timing.jsonl'
   881	        if not timing.is_file():
   882	            raise IncompleteRun(dict(dir=str(directory), missing_timing=True))
   883	        try:
   884	            rows = base.load_rows(timing)
   885	        except AssertionError:
   886	            raw = [json.loads(l) for l in timing.read_text().splitlines() if l.strip()]
   887	            inv = inventory([r['instance_id'] for r in raw if 'instance_id' in r], base.ids_file(base.ARM_IDS))
   888	            raise IncompleteRun(dict(dir=str(directory), inventory=inv))
   889	        paths.append(timing)
   890	        headers.extend(_headers(timing))
   891	        for row in rows:
   892	            iid = row['instance_id']
   893	            occurrences[iid].append(dict(dir=str(directory), resolved=row.get('resolved'),
   894	                                         timeout=bool(row.get('timed_out') or row.get('agent_timeout_fired')),
   895	                                         empty_patch=row.get('verified_patch_bytes') == 0))
   896	            selected.setdefault(iid, (row, str(directory)))
   897	    inv = inventory(list(selected), base.ids_file(base.ARM_IDS))
   898	    inv['duplicates'] = [dict(instance_id=i, dirs=[a['dir'] for a in ds], attempts=ds) for i, ds in occurrences.items() if len(ds) > 1]
   899	    if not inv['complete']:
   900	        raise IncompleteRun(inv)
   901	    classified = {}
   902	    for directory in dirs:
   903	        timing = Path(directory) / 'timing.jsonl'
   904	        d4, a2 = classifiers[str(Path(directory))]
   905	        rows = base.load_rows(timing)
   906	        classified[str(directory)] = _classifier(timing, d4, base.D4_SHA, rows)
   907	        _classifier(timing, a2, base.A2_SHA, rows)
   908	        paths.extend((d4, a2))
   909	    records = []
   910	    for iid in base.ids_file(base.ARM_IDS):
   911	        row, directory = selected[iid]
   912	        trace = Path(directory) / 'runs' / iid / 'trace.json'
   913	        entries = json.loads(trace.read_text()).get('entries') or []
   914	        paths.append(trace)
   915	        records.append((row, classified[directory][iid], trace, entries))
   916	    return records, inv, paths, headers
