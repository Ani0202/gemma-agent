   680	def trace_counts(trace):
   681	    entries = trace.entries if trace else []
   682	    counts = Counter(e.tool_name for e in entries if e.event_type == 'tool_call')
   683	    tokens = {}
   684	    for key in ('prompt_tokens', 'completion_tokens'):
   685	        values = [e.usage[key] for e in entries if e.usage and isinstance(e.usage.get(key), (int, float))]
   686	        tokens[key] = sum(values) if values else None
   687	    return dict(counts), tokens, tool_seconds(entries)
   688	
   689	def tool_seconds(entries):
   690	    """Per tool name: wall seconds from each tool_call to its tool_response (FIFO per name)."""
   691	    pending, out = {}, {}
   692	    for e in entries:
   693	        if e.event_type == 'tool_call':
   694	            pending.setdefault(e.tool_name, []).append(e.timestamp)
   695	        elif e.event_type == 'tool_response' and pending.get(e.tool_name):
   696	            stat = out.setdefault(e.tool_name, dict(n=0, total=0.0, max=0.0))
   697	            dt = max(0.0, e.timestamp - pending[e.tool_name].pop(0))
   698	            stat['n'] += 1
   699	            stat['total'] = round(stat['total'] + dt, 3)
   700	            stat['max'] = round(max(stat['max'], dt), 3)
   701	    return out
