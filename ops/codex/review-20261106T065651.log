    36	def classify(row: dict) -> dict:
    37	    """Classify one task row, preserving the stock verdict even for H rows."""
    38	    if 'instance_id' not in row:
    39	        raise ValueError('Meta row has no instance_id')
    40	    row_reasons = []
    41	    error = row.get('error')
    42	    if any(key not in row for key in REQUIRED):
    43	        row_reasons.append('r1:missing_schema')
    44	    if isinstance(error, str) and any(marker in error for marker in WRAPPER_H):
    45	        row_reasons.append('r2:wrapper_exception')
    46	    elif error is not None and error != 'Harness task failure':
    47	        row_reasons.append('r3:unexpected_error')
    48	    elif error is None or error == 'Harness task failure':
    49	        for message in (row.get('result_error'), row.get('agent_error_text')):
    50	            if message and agent_end(message) is None and not message.startswith(VERIFY_AGENT_PREFIXES):
    51	                row_reasons.append('r4:unrecognized_message' if error else 'r5:unrecognized_message')
    52	                break
    53	
    54	    setup_reasons = []
    55	    diagnostic = False
    56	    if row.get('missing_tool_deps'):
    57	        setup_reasons.append('s1:missing_tool_deps')
    58	    for entry in row.get('setup_calls', []):
    59	        step, rc = entry.get('step'), entry.get('rc')
    60	        if step not in ('pip_check', 'workspace_editable', 'setup.py'):
    61	            if rc != 0 and (rc is not None or (entry.get('duration_s') or 0) > 0 or entry.get('stderr')):
    62	                setup_reasons.append('s2:setup_step_failed')
    63	        elif step == 'workspace_editable' and rc != 0:
    64	            if RECORD in output_text(entry):
    65	                diagnostic = True
    66	            else:
    67	                setup_reasons.append('s4:workspace_editable_failed')
    68	        elif step == 'setup.py':
    69	            if rc != 0:
    70	                setup_reasons.append('s3:setup_py_failed')
    71	            earlier_offline_record = False
    72	            for sub in entry.get('subprocesses', []):
    73	                argv = sub.get('argv')
    74	                if not isinstance(argv, list) or '-e' not in argv or sub.get('rc') == 0:
    75	                    continue
    76	                if '--no-index' in argv and RECORD in output_text(sub):
