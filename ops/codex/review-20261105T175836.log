+def execute_limited(command, cwd, env, timeout=300, *, shell=None,
+                    max_output_chars=10 * 1024 * 1024):
+    """Installed executor contract, with host process-tree limits and cleanup."""
+    from adk_eval_core.errors import EvalCoreError
+    from adk_eval_core.sandbox.base import ExecutionResult
+
+    start = time.perf_counter()
+    metrics = command_metrics.get()
+    tracked = {}
+    peak = 0
+    marker = ('GEMMA_SANDBOX_TREE=' + uuid.uuid4().hex).encode()
+    child_env = dict(env)
+    child_env['GEMMA_SANDBOX_TREE'] = marker.decode().split('=', 1)[1]
+    if shell is None:
+        shell = isinstance(command, str)
+    try:
+        limit = int(os.environ.get('GEMMA_SANDBOX_MEM_BYTES', 4 * 1024**3))
+        as_limit = int(os.environ.get('GEMMA_SANDBOX_AS_BYTES', 8 * 1024**3))
+        # A bin/job fallback may already impose a lower hard AS cap. Raising
+        # that cap requires privileges; preserve the tighter inherited limit.
+        hard_as = resource.getrlimit(resource.RLIMIT_AS)[1]
+        if hard_as != resource.RLIM_INFINITY:
+            as_limit = min(as_limit, hard_as)
+        prlimit = shutil.which('prlimit')
+        if prlimit:
+            # Preserve Popen's string/list shell semantics inside the backstop.
+            if shell:
+                command = ['/bin/sh', '-c', command] if isinstance(command, str) else ['/bin/sh', '-c', *command]
+            elif isinstance(command, str):
+                command = [command]
+            command = [prlimit, f'--as={as_limit}', '--', *command]
+            shell = False
+        proc = subprocess.Popen(command, shell=shell, cwd=str(cwd), env=child_env,
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                text=True, encoding='utf-8', errors='replace',
+                                start_new_session=True)
+    except (RuntimeError, OSError, ValueError, EvalCoreError) as exc:
+        return ExecutionResult(status='error', stdout='', stderr=str(exc), exit_code=-1,
+                               duration_seconds=round(time.perf_counter() - start, 3))
+
+    def scan():
+        nonlocal peak
+        processes = proctree.snapshot()
+        roots = set(proctree.survivors(tracked, processes)) | {proc.pid}
+        selected = proctree.descendants(roots, processes)
+        for p in processes.values():
+            if p.pgid == proc.pid or p.sid == proc.pid:
