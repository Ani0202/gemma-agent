    29	def finished_results(text):
    30	    """Parse a journal, ignoring only a torn final JSON line; last full row wins.
    31	
    32	    Both successful verifications and errors are finished attempts. Malformed
    33	    complete records fail loudly rather than silently removing tasks.
    34	    """
    35	    results = {}
    36	    lines = text.splitlines(keepends=True)
    37	    for index, line in enumerate(lines):
    38	        try:
    39	            row = json.loads(line)
    40	        except json.JSONDecodeError:
    41	            if index == len(lines) - 1 and not line.endswith('\n'):
    42	                break
    43	            raise ValueError(f'Invalid results JSON at line {index + 1}') from None
    44	        if (not isinstance(row, dict) or not isinstance(row.get('instance_id'), str)
    45	                or not row['instance_id'] or not isinstance(row.get('repo'), str)
    46	                or type(row.get('resolved')) is not bool
    47	                or 'exit_code' not in row or 'error' not in row
    48	                or (row['exit_code'] is not None and type(row['exit_code']) is not int)
    49	                or (row['error'] is not None and not isinstance(row['error'], str))
    50	                or type(row.get('duration_seconds')) not in (float, int)
    51	                or not math.isfinite(row['duration_seconds']) or row['duration_seconds'] < 0):
    52	            raise ValueError(f'Invalid result schema at line {index + 1}')
    53	        results[row['instance_id']] = row
    54	    return results
