    81	        # new read-only exposure. Only wheel files or trusted wheelhouse subdirs
    82	        # can be reached through symlinks; a file mount cannot expose siblings.
    83	        if not (target.is_file() and target.suffix == '.whl') and not any(
    84	                target.is_relative_to(Path(p).resolve()) for p in ro_paths):
