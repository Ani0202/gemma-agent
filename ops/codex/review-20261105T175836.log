    46	                "os._exit(0) if p else None; os.setsid(); "
    47	                "open('child.pid','w').write(str(os.getpid())); time.sleep(600)")
    48	        cmd = ['/bin/bash', '-c', shlex.join(python(code)) + '; sleep 600']
