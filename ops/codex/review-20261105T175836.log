   232	def apply_isolation(hidden_paths, ro_paths):
   233	    """Wrap the module executor, retaining the installed manager's translation/env.
   234	
   235	    Empty hidden_paths disables bwrap (explicit opt-out), but retains timeout
   236	    accounting. Repeated setup replaces this hook rather than stacking it.
   237	    """
   238	    import swegemma.sandbox.subprocess as sb
   239	    hidden_paths, ro_paths = tuple(hidden_paths), tuple(ro_paths)
   240	    original = getattr(sb.execute_subprocess_command, '_unwrapped', sb.execute_subprocess_command)
   241	
   242	    def execute(command, cwd, env, **kwargs):
   243	        if ro_paths:
   244	            command = [*command[:2], re.sub(r'(?<![\w.-])/wheels(?![\w.-])',
   245	                                           str(Path(ro_paths[0]).resolve()), command[2])]
   246	        if hidden_paths:
   247	            if not isinstance(command, list) or command[:2] != ['/bin/bash', '-c']:
   248	                raise RuntimeError('Unsupported harness subprocess command')
   249	            # The harness's fallback wheel search doesn't include custom data dirs.
   250	            command = bwrap_argv(command, cwd, hidden_paths, runtime_ro_paths(cwd, ro_paths))
   251	        result = execute_limited(command=command, cwd=cwd, env=env, **kwargs)
   252	        metrics = command_metrics.get()
   253	        if metrics is not None and (result.status == 'timeout' or result.exit_code == 124):
