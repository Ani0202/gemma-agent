   190	async def verify_gold(task, patch, data_dir, sandbox, out_dir=None):
   191	    """The only swegemma API adapter; see docs/GOLD_CALIBRATION.md assumptions.
   192	
   193	    verify_task owns fresh sandbox staging, baseline setup, and test_patch.
   194	    Bind explicit parameters from Evaluator resources, failing closed on an
   195	    unknown required argument rather than guessing positional argument order.
   196	    """
   197	    from swegemma.config import EvalConfig
   198	    from swegemma.evaluate import Evaluator
   199	    from swegemma.harness.verification import verify_task
   200	
   201	    out_dir = Path(out_dir or WORKING_DIR).resolve()
   202	    out_dir.mkdir(parents=True, exist_ok=True)
   203	    with tempfile.TemporaryDirectory(prefix='gold-verify-', dir=out_dir) as scratch:
   204	        config = EvalConfig(tasks_path=data_dir / 'tasks.jsonl',
   205	                            snapshots_dir=data_dir / 'snapshots', wheels_dir=data_dir / 'wheels',
   206	                            results_dir=Path(scratch), submission_dir=data_dir / 'sample_submission',
   207	                            models={}, sandbox=sandbox, verification_timeout_seconds=300, verbose=False)
   208	        evaluator = Evaluator(config)
   209	        context = {name.lstrip('_'): value for name, value in vars(evaluator).items()}
   210	        context.update(task=task, agent_patch=patch, config=config,
   211	                       snapshots_dir=config.snapshots_dir, wheels_dir=config.wheels_dir,
   212	                       timeout_seconds=300, verification_timeout_seconds=300)
   213	        from swegemma.deduplication import resolve_task_snapshot_paths
   214	        _paths = resolve_task_snapshot_paths(config.snapshots_dir, task.instance_id, task.repo)
   215	        context.update(snapshot_path=_paths[0], base_snapshot_path=_paths[1], patch_path=_paths[2])
   216	        parameters = inspect.signature(verify_task).parameters
   217	        if not {'task', 'agent_patch'} <= parameters.keys():
   218	            raise RuntimeError('Unsupported verify_task signature')
   219	        kwargs = {name: context[name] for name, p in parameters.items()
   220	                  if name in context and p.kind in (p.KEYWORD_ONLY, p.POSITIONAL_OR_KEYWORD)}
   221	        try:
   222	            inspect.signature(verify_task).bind(**kwargs)
   223	        except TypeError as exc:
   224	            sig = inspect.signature(verify_task)
   225	            req = [n for n, p in sig.parameters.items() if p.default is p.empty and p.kind in (p.POSITIONAL_ONLY, p.POSITIONAL_OR_KEYWORD, p.KEYWORD_ONLY)]
   226	            import swegemma.evaluate as _ev, swegemma.harness.verification as _vf, re as _re
   227	            _src = (inspect.getsource(_ev) + '\n' + inspect.getsource(_vf)).splitlines()
   228	            _hits = [l.strip() for l in _src if _re.search(r'snapshot', l)]
   229	            _d1 = ' || '.join(_hits)[:3000]
   230	            import swegemma.sandbox as _sb
   231	            _d2 = ','.join(n for n in dir(_sb) if 'Manager' in n or 'Sandbox' in n)
   232	            raise RuntimeError('bind failed; SRC=' + _d1 + '; SB=' + _d2 + '; sig=' + str(sig)[:300] + '; required=' + ','.join(req) + '; ctx=' + ','.join(sorted(context))[:300]) from None
   233	        token = gold_artifact_dir.set(Path(scratch))
   234	        try:
   235	            result = verify_task(**kwargs)
   236	            return await result if inspect.isawaitable(result) else result
   237	        finally:
   238	            gold_artifact_dir.reset(token)
