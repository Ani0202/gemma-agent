    36	def bwrap_argv(command, workspace, hidden_paths, ro_paths):
    37	    workspace = Path(workspace).resolve()
    38	    root = workspace.parent
    39	    argv = BWRAP_TEMPLATE[:11]
    40	    # Mask parents first so nested masks don't get covered by their parents.
    41	    for path in sorted({str(Path(p).absolute()) for p in hidden_paths},
    42	                       key=lambda p: (len(Path(p).parts), p)):
    43	        argv += ['--tmpfs', path]
    44	    argv += ['--tmpfs', '/tmp']
    45	    # A final /tmp mask removes nested hidden mountpoints. Recreate their empty
    46	    # directories so temporary inventories can be probed with ls as well.
    47	    for path in sorted({str(Path(p).absolute()) for p in hidden_paths}):
    48	        if path != '/tmp' and Path(path).is_relative_to('/tmp'):
    49	            argv += ['--dir', path]
    50	    argv += ['--bind', str(root), str(root)]
    51	    # Bind each asset at its resolved path and, when reached through a symlink
    52	    # (uv's cpython-3.13 -> cpython-3.13.18 alias under a masked $HOME), at the
    53	    # unresolved path too, so venv interpreter symlinks don't dangle in the sandbox.
    54	    binds = set()
    55	    for p in ro_paths:
    56	        src = str(Path(p).resolve())
    57	        binds |= {(src, src), (src, str(Path(p).absolute()))}
    58	    for path, dest in sorted(binds, key=lambda b: (len(Path(b[1]).parts), b)):
    59	        # Only explicit runtime assets may be re-exposed, never inventory/artifacts.
    60	        if ({'tasks.jsonl', 'splits', 'runs', 'results'} & (set(Path(path).parts) | set(Path(dest).parts))
    61	                or (Path(path).is_dir() and (Path(path) / 'tasks.jsonl').exists())):
    62	            raise ValueError('Forbidden read-only exposure')
    63	        argv += ['--ro-bind', path, dest]
    64	    argv += ['--chdir', str(workspace), *command]
    65	    return argv
