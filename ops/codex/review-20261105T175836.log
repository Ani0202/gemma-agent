    74	    if prefix != Path(sys.base_prefix).resolve():
    75	        raise ValueError('Sandbox python prefix differs from the scorer interpreter')
    76	    # Keep the unresolved alias too; bwrap_argv binds the resolved target there.
    77	    paths = {prefix, Path(home).absolute().parent, *(Path(p).resolve() for p in ro_paths)}
    78	    def wheel_target(path):
    79	        target = path.resolve()
