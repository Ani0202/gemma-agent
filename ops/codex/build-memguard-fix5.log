        return False
    procs = snapshot()
    # Preserve session ancestry checks when a shell's parent was missed by the scan.
    parent = initial["ppid"]
    while initial["comm"] in SHELL_COMMS and parent and parent not in procs:
        info = proc_info(parent)
        if not info:
            break
        procs[parent] = info
        parent = info["ppid"]
    records = running_jobs()
    verified = verified_records(procs, records)
    protected = protected_watchdogs(procs, records)
    # Read the command and environment after the protection scan, then bind them
    # to the recipient identity again. Missing proc metadata refuses both actions.
    cmdline = read(f"/proc/{d['pid']}/cmdline", "rb")
    environ = read(f"/proc/{d['pid']}/environ", "rb")
    current = proc_info(d["pid"])
    if (not current or current["starttime"] != d["starttime"] or
            cmdline is None or environ is None):
        return False
    job_id = next((entry[len(b"GEMMA_JOB_ID="):] for entry in environ.split(b"\0")
                   if entry.startswith(b"GEMMA_JOB_ID=")), None)
    if watchdog_record(d["pid"], cmdline, job_id, records):
        return False
    # Re-parented wrappers whose parent cannot be inspected fail closed.
    if current["comm"] in SHELL_COMMS and current["ppid"] and current["ppid"] not in procs:
        return False
    procs[d["pid"]] = {**current, "job_id": job_id}
    # Re-evaluate fresh recipient metadata against the scanned protections/ancestry.
    return eligible(d["pid"], procs, args, protected, verified, known_jobs)


def send_kill(d, log, args, known_jobs=None):
    """Pin a pidfd before the final identity check; never signal a recycled pid."""
    fd = None
    try:
        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
            try:
                fd = os.pidfd_open(d["pid"])
            except OSError as exc:
                if exc.errno not in (errno.ENOSYS, errno.EINVAL, errno.EPERM):
                    raise
        if not action_eligible(d, args, known_jobs):
            return False
        if fd is not None:
            signal.pidfd_send_signal(fd, signal.SIGKILL)
        else:
            os.kill(d["pid"], signal.SIGKILL)
        return True
    except ProcessLookupError:
        return False
    except OSError as exc:
        log(f"  cannot kill {d['pid']}: {exc}")
        return False
    finally:
        if fd is not None:
            os.close(fd)


