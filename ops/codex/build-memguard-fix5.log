def watchdog_record(pid, cmdline, job_id, records):
    """Use this recipient's fresh command and marker, including wrapper metadata."""
    if watchdog_id(job_id) or watchdog_argv(cmdline):
        return True
    for record in records:
        if record["pid"] != pid:
            continue
        command = read(os.path.join(REPO, "ops/jobs", record["name"] + ".cmd")) or ""
        if "bin/memguard" in command and is_job_wrapper(cmdline, record["name"], wrapper_script()):
            return True
    return False


def protected_watchdogs(procs, records):
    # Deployment stops the old guard before starting the new one, with no heavy
    # jobs running. We do not rely on the old implementation excluding this guard.
    guards = {p for p in procs if runs_memguard(p) or watchdog_record(
        p, read(f"/proc/{p}/cmdline", "rb") or b"",
        marker_value(p, "GEMMA_JOB_ID"), records)}
    for p in procs:
        job_id = marker_value(p, "GEMMA_JOB_ID")
