   342	def action_eligible(d, args, known_jobs=None):
   343	    """Refresh the recipient AFTER discovery/protection scans (exec keeps starttime)."""
   344	    initial = proc_info(d["pid"])
   345	    if not initial or initial["starttime"] != d["starttime"]:
   346	        return False
   347	    procs = snapshot()
   348	    # Preserve session ancestry checks when a shell's parent was missed by the scan.
   349	    parent = initial["ppid"]
   350	    while initial["comm"] in SHELL_COMMS and parent and parent not in procs:
   351	        info = proc_info(parent)
   352	        if not info:
   353	            break
   354	        procs[parent] = info
   355	        parent = info["ppid"]
   356	    records = running_jobs()
   357	    verified = verified_records(procs, records)
   358	    protected = protected_watchdogs(procs, records)
   359	    # Read the command and environment after the protection scan, then bind them
   360	    # to the recipient identity again. Missing proc metadata refuses both actions.
   361	    cmdline = read(f"/proc/{d['pid']}/cmdline", "rb")
   362	    environ = read(f"/proc/{d['pid']}/environ", "rb")
   363	    current = proc_info(d["pid"])
   364	    if (not current or current["starttime"] != d["starttime"] or
   365	            cmdline is None or environ is None):
   366	        return False
   367	    job_id = next((entry[len(b"GEMMA_JOB_ID="):] for entry in environ.split(b"\0")
   368	                   if entry.startswith(b"GEMMA_JOB_ID=")), None)
   369	    if watchdog_record(d["pid"], cmdline, job_id, records):
   370	        return False
   371	    # Re-parented wrappers whose parent cannot be inspected fail closed.
   372	    if current["comm"] in SHELL_COMMS and current["ppid"] and current["ppid"] not in procs:
   373	        return False
   374	    procs[d["pid"]] = {**current, "job_id": job_id}
   375	    # Re-evaluate fresh recipient metadata against the scanned protections/ancestry.
   376	    return eligible(d["pid"], procs, args, protected, verified, known_jobs)
