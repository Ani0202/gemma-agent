def is_job_wrapper(cmdline, name, script):
    argv = cmdline.split(b"\0")
    return (script is not None and len(argv) >= 6 and
            os.path.basename(argv[0]) == b"bash" and argv[1] == b"-c" and
            argv[2] == ("\n" + script).encode() and argv[3] == b"_" and
