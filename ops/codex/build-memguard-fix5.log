    if watchdog_id(job_id):
        return False
    if job_id is not None:
        return True
    boot_id = current_boot_id()
    records = [r for r in records if same_boot(r, boot_id)]
    known_jobs = {k: j for k, j in (known_jobs or {}).items() if same_boot(j, boot_id)}
    identity = procs[pid]["starttime"]
    if any(j["known_members"].get(pid) == identity for j in (known_jobs or {}).values()):
