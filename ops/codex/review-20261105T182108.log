    75	@pytest.mark.parametrize("pidfd", [False, True])
    76	def test_pid_reuse_is_not_signalled(monkeypatch, mg, args, pidfd):
    77	    calls = []
    78	    monkeypatch.setattr(mg, "proc_info", lambda p: proc(p, starttime=999))
    79	    monkeypatch.setattr(mg.os, "kill", lambda *a: calls.append(a))
    80	    if pidfd:
    81	        monkeypatch.setattr(mg.os, "pidfd_open", lambda p: 42)
