    38	      pgid=$(ps -o pgid= -p $$ | tr -d " ")
    39	      echo "running $$ $(date -u +%FT%TZ) $pgid" > "ops/jobs/$name.status"
    40	      { echo "[bin/job] $GEMMA_JOB_CAP; pgid $pgid"; nice -n 15 "$@"; } > "ops/jobs/$name.log" 2>&1; rc=$?
    41	      [ $rc -eq 137 ] && echo "[bin/job] exit 137: killed, most likely at the memory cap" >> "ops/jobs/$name.log"
    42	      if [ $rc -eq 0 ]; then st=done; else st=failed; fi
