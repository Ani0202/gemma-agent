   334	def main():
   335	    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   336	    ap.add_argument("--interval", type=float, default=2.0)
   337	    ap.add_argument("--min-available", type=float, default=2.5, help="GiB")
   338	    ap.add_argument("--max-total", type=float, default=6.0, help="GiB of summed targeted RSS")
   339	    ap.add_argument("--unmarked-rss", type=float, default=3.0, help="GiB, for unmarked targets (ii)")
   340	    ap.add_argument("--min-kill-rss", type=float, default=0.25,
   341	                    help="GiB; on low MemAvailable alone, skip jobs smaller than this (killing a waiter frees nothing)")
   342	    ap.add_argument("--marker", default="GEMMA_JOB_CAP")
   343	    ap.add_argument("--roots", default="/home/ubuntu/work/gemma,/tmp")
   344	    ap.add_argument("--log", default=os.path.join(REPO, "ops/logs/memguard.log"))
   345	    ap.add_argument("--once", action="store_true")
   346	    ap.add_argument("--dry-run", action="store_true")
   347	    ap.add_argument("--no-mail", action="store_true")
   348	    args = ap.parse_args()
   349	    args.roots = [r for r in args.roots.split(",") if r]
   350	    for k in ("min_available", "max_total", "unmarked_rss", "min_kill_rss"):
   351	        setattr(args, k, int(getattr(args, k) * GIB))
   352	    os.makedirs(os.path.dirname(args.log), exist_ok=True)
   353	
   354	    def log(msg):
   355	        line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}"
   356	        with open(args.log, "a") as f:
   357	            f.write(line + "\n")
   358	        print(line, flush=True)
   359	
   360	    log(f"start pid={os.getpid()} min_available={args.min_available/GIB:.2f}G max_total={args.max_total/GIB:.2f}G "
   361	        f"marker={args.marker} roots={args.roots} dry_run={args.dry_run}")
   362	    last_beat = 0
   363	    jobs = {}
   364	    while True:
   365	        procs = snapshot()
   366	        self_pids = {os.getpid()} | set(ancestors(os.getpid(), procs))
   367	        # Our ancestors include the bin/job wrapper and maybe a Claude shell; they're never targets.
   368	        targets, jobs = find_jobs(procs, args, self_pids, known_jobs=jobs)
   369	        if args.dry_run:
   370	            log(f"targets={sorted(targets)} jobs=" + repr([
   371	                {"name": j["name"], "root": j["root"], "pids": sorted(j["pids"])}
   372	                for j in jobs.values()]))
   373	        raise_oom_adj(targets, args.dry_run, args)
   374	        avail = mem_available() or 0
   375	        total = sum(j["rss"] for j in jobs.values())
   376	        if time.time() - last_beat > 600:
   377	            log(f"beat avail={avail/GIB:.2f}G targeted_rss={total/GIB:.2f}G jobs={len(jobs)} targets={len(targets)}")
   378	            last_beat = time.time()
   379	        reason = None
   380	        if total > args.max_total:
   381	            reason = f"targeted RSS {total/GIB:.2f}G > {args.max_total/GIB:.2f}G"
   382	        elif avail < args.min_available:
   383	            reason = f"MemAvailable {avail/GIB:.2f}G < {args.min_available/GIB:.2f}G"
   384	        if reason and jobs:
   385	            _, j = max(jobs.items(), key=lambda kv: kv[1]["rss"])
   386	            root = j["root"]
   387	            if total <= args.max_total and j["rss"] < args.min_kill_rss:
   388	                reason = None  # pressure is not ours to fix by killing a tiny job
   389	        if reason and jobs:
   390	            name = j["name"]
   391	            comm = procs.get(root, {}).get("comm", "?")
   392	            log(f"KILL job={name or '-'} root={root} comm={comm} rss={j['rss']/GIB:.2f}G reason: {reason}"
   393	                + (" [dry-run]" if args.dry_run else ""))
   394	            if not args.dry_run:
   395	                killed, surv = kill_tree(j, args, self_pids, log)
   396	                log(f"  killed {len(killed)} pids; survivors={surv}")
   397	                msg = (f"memguard killed job {name or '(unmarked pid %d %s)' % (root, comm)}: "
   398	                       f"{j['rss']/GIB:.2f}G, {reason}. Survivors: {surv or 'none'}. See ops/logs/memguard.log.")
   399	                if name:
   400	                    time.sleep(0.5)
   401	                    try:
   402	                        with open(os.path.join(REPO, "ops/jobs", f"{name}.log"), "a") as f:
   403	                            f.write(f"[memguard] {msg}\n")
   404	                    except OSError:
   405	                        pass
   406	                if not args.no_mail:
   407	                    # Mail may take up to ten seconds; keep polling while it completes.
   408	                    threading.Thread(target=send_mail, args=(msg, log)).start()
   409	        if args.once:
   410	            return 0
   411	        time.sleep(args.interval)
   412	
   413	
   414	if __name__ == "__main__":
   415	    sys.exit(main())
