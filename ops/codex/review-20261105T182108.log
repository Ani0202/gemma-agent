     1	#!/usr/bin/env bash
     2	# Detached long-running jobs that survive the end of a Claude cycle.
     3	#   bin/job start <name> -- <command...>   bin/job status [name]   bin/job tail <name> [lines]   bin/job kill <name>
     4	# Writes ops/jobs/<name>.status: "running <pid> <start> <pgid>" -> "done 0 <end>" / "failed <rc> <end>"
     5	set -uo pipefail
     6	cd "$(dirname "$0")/.." || exit 1
     7	mkdir -p ops/jobs
     8	cmd=${1:-}; shift || true
     9	case "$cmd" in
    10	  start)
    11	    name=$1; shift; [ "${1:-}" = "--" ] && shift
    12	    [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "bad name"; exit 2; }
    13	    if grep -q '^running' "ops/jobs/$name.status" 2>/dev/null; then echo "job $name already running"; exit 1; fi
    14	    # Admission control (dec 021): refuse heavy jobs when the VM is already short of memory.
    15	    avail_kb=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
    16	    if [[ "$name" != *-light ]] && [ "${avail_kb:-0}" -lt $((5 * 1024 * 1024)) ]; then
    17	      echo "refusing $name: MemAvailable $((avail_kb / 1024)) MiB < 5 GiB (name it *-light if it is small)"; exit 3
    18	    fi
    19	    printf '%q ' "$@" > "ops/jobs/$name.cmd"
    20	    # Memory cap per job: a runaway job must not stall the VM (Etho shares it; 2026-11-05 incident).
    21	    # Prefer a systemd user scope (caps the whole process tree); after a cron-started boot with no
    22	    # login there is no user manager, so fall back to a per-process ulimit -v.
    23	    rt=/run/user/$(id -u)
    24	    rm -f "ops/jobs/$name.unit"
    25	    if [ -S "$rt/bus" ] && XDG_RUNTIME_DIR=$rt systemd-run --user --scope --quiet -p MemoryMax=64M true 2>/dev/null; then
    26	      unit="gemma-job-$name-$(date +%s)"
    27	      echo "$unit" > "ops/jobs/$name.unit"
    28	      pre=(env XDG_RUNTIME_DIR="$rt" systemd-run --user --scope --quiet --collect --unit="$unit" -p MemoryMax=5G)
    29	      cap="memory cap: systemd scope MemoryMax=5G (whole job)"
    30	    else
