   209	        root = record["pid"] if record else p
   210	        if previous:
   211	            root = previous["root"]
   212	        j = jobs.setdefault(key, {"key": key, "root": root, "name": record["name"] if record else job_name(root, procs, records),
   213	                                  "pids": [], "members": {}, "rss": 0, "records": records,
   214	                                  "known_members": dict(previous["known_members"]) if previous else {}})
   215	        if previous:
   216	            j["name"] = previous["name"]
   217	        if job_id is None:
   218	            j["known_members"][p] = d["starttime"]
   219	        j["pids"].append(p)
   220	        j["members"][p] = d
   221	        j["rss"] += d["rss"]
   222	    # Exclude the watchdog's whole job, including siblings, rather than only its pid.
   223	    for key, j in list(jobs.items()):
   224	        if (set(j["pids"]) & self_pids or j["root"] in self_pids):
   225	            del jobs[key]
   226	    targets = {p: d for j in jobs.values() for p, d in j["members"].items()}
   227	    return targets, jobs
   228	
   229	
   230	def action_eligible(d, args):
   231	    """Refresh identity AND allowlist after opening the process handle (exec keeps starttime)."""
   232	    current = proc_info(d["pid"])
   233	    if not current or current["starttime"] != d["starttime"]:
   234	        return False
   235	    procs = {d["pid"]: current}
   236	    parent = current["ppid"]
   237	    while current["comm"] in SHELL_COMMS and parent and parent not in procs:
   238	        info = proc_info(parent)
   239	        if not info:
   240	            break
   241	        procs[parent] = info
   242	        parent = info["ppid"]
   243	    return eligible(d["pid"], procs, args)
   244	
   245	
   246	def send_kill(d, log, args):
   247	    """Pin a pidfd before the final identity check; never signal a recycled pid."""
   248	    fd = None
   249	    try:
   250	        if hasattr(os, "pidfd_open") and hasattr(signal, "pidfd_send_signal"):
   251	            try:
   252	                fd = os.pidfd_open(d["pid"])
   253	            except OSError as exc:
   254	                if exc.errno not in (errno.ENOSYS, errno.EINVAL, errno.EPERM):
   255	                    raise
   256	        if not action_eligible(d, args):
   257	            return False
   258	        if fd is not None:
   259	            signal.pidfd_send_signal(fd, signal.SIGKILL)
   260	        else:
   261	            os.kill(d["pid"], signal.SIGKILL)
   262	        return True
   263	    except ProcessLookupError:
   264	        return False
   265	    except OSError as exc:
   266	        log(f"  cannot kill {d['pid']}: {exc}")
   267	        return False
   268	    finally:
   269	        if fd is not None:
   270	            os.close(fd)
   271	
   272	
   273	def raise_oom_adj(targets, dry, args):
   274	    n = 0
   275	    if dry:
   276	        return n
   277	    for p, d in targets.items():
   278	        # Opening first pins the proc file to this process, even if its numeric pid is reused.
   279	        try:
   280	            with open(f"/proc/{p}/oom_score_adj", "w") as f:
   281	                if action_eligible(d, args):
   282	                    f.write("1000")
   283	                    n += 1
   284	        except OSError:
   285	            pass
   286	    return n
   287	
   288	
   289	def inventory(job, args, self_pids):
   290	    # Use the same job ID / known legacy identities for every scan, including survivors.
   291	    _, jobs = find_jobs(snapshot(), args, self_pids, job["records"], {job["key"]: job})
   292	    current = jobs.get(job["key"], {})
   293	    job["known_members"].update(current.get("known_members", {}))
   294	    return current.get("members", {})
   295	
   296	
   297	def kill_tree(job, args, self_pids, log):
   298	    """Two empty scans, bounded by five seconds, then an independent survivor inventory."""
   299	    killed = set()
   300	    started = time.monotonic()
   301	    deadline = started + 5
   302	    root_identity = job["members"].get(job["root"])
   303	    empty_scans = 0
   304	    while time.monotonic() < deadline:
   305	        members = inventory(job, args, self_pids)
   306	        # The wrapper gets a grace period to record the child's failure. A new process
   307	        # with the same numeric pid does not inherit this special treatment.
   308	        grace = (root_identity and time.monotonic() < started + 3 and
   309	                 any(p != job["root"] for p in job["members"]))
   310	        for p, d in members.items():
   311	            if grace and p == job["root"] and d["starttime"] == root_identity["starttime"]:
   312	                continue
   313	            if send_kill(d, log, args):
   314	                killed.add(p)
   315	        empty_scans = empty_scans + 1 if not members else 0
   316	        if empty_scans >= 2 and not grace:
   317	            break
   318	        time.sleep(0.2)
   319	    survivors = sorted(inventory(job, args, self_pids))
   320	    return sorted(killed), survivors
   321	
   322	
   323	def send_mail(msg, log):
   324	    try:
   325	        result = subprocess.run([os.path.join(REPO, "bin/send"), "builder", msg],
   326	                                env={**os.environ, "SEND_FROM": "memguard", "GEMMA_ROLE": "memguard"},
   327	                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
   328	        if result.returncode:
   329	            log(f"  mail failed: exit {result.returncode}")
   330	    except (OSError, subprocess.TimeoutExpired) as exc:
   331	        log(f"  mail failed: {exc}")
   332	
