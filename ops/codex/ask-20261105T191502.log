   192	def _extract_declared_tools(agent: Any) -> set[str] | None:
   193	    """Extract the set of declared tool names across the compiled agent hierarchy.
   194	
   195	    Returns None if the agent does not expose concrete tool lists (e.g., a mock object).
   196	    """
   197	    if agent is None:
   198	        return None
   199	
   200	    declared: set[str] = set()
   201	    found_concrete_list = False
   202	    visited: set[int] = set()
   203	
   204	    def _walk(curr: Any) -> None:
   205	        nonlocal found_concrete_list
   206	        if curr is None:
   207	            return
   208	        curr_id = id(curr)
   209	        if curr_id in visited:
   210	            return
   211	        visited.add(curr_id)
   212	
   213	        raw_tools = getattr(curr, 'tools', None)
   214	        if isinstance(raw_tools, (list, tuple)):
   215	            found_concrete_list = True
   216	            for t in raw_tools:
   217	                if isinstance(t, str):
   218	                    declared.add(t)
   219	                    continue
   220	                t_name = getattr(t, 'name', None) or getattr(t, '__name__', None)
   221	                if isinstance(t_name, str) and t_name:
   222	                    declared.add(t_name)
   223	                inner_agent = getattr(t, 'agent', None)
   224	                if inner_agent is not None:
   225	                    _walk(inner_agent)
   226	                inner_tools = getattr(t, '_tools', None)
   227	                if isinstance(inner_tools, (list, tuple)):
   228	                    for st in inner_tools:
   229	                        st_name = getattr(st, 'name', None) or getattr(
   230	                            st, '__name__', None
   231	                        )
   232	                        if isinstance(st_name, str) and st_name:
   233	                            declared.add(st_name)
   234	
   235	        sub_agents = getattr(curr, 'sub_agents', None)
   236	        if isinstance(sub_agents, (list, tuple)):
   237	            for sub in sub_agents:
   238	                _walk(sub)
   239	
   240	    _walk(agent)
   241	    return declared if found_concrete_list else None
