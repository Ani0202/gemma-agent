    64	def resolve_swegemma_adapter(
    65	    base_model: Any,
    66	    adapter_info: Any,
    67	    model_registry: Any | None = None,
    68	) -> Any:
    69	    """Resolve an adapter declaration to a configured LiteLlm model instance."""
    70	    import copy
    71	
    72	    adapter_name = getattr(adapter_info, 'name', str(adapter_info))
    73	    if model_registry is not None and adapter_name in model_registry:
    74	        return model_registry.get(adapter_name)
    75	
    76	    if hasattr(base_model, 'model') and isinstance(base_model.model, str):
    77	        target_model = f'openai/{adapter_name}'
    78	        for prefix in ('openai/', 'hosted_vllm/', 'custom/'):
    79	            if base_model.model.startswith(prefix):
    80	                target_model = f'{prefix}{adapter_name}'
    81	                break
    82	        if hasattr(base_model, 'model_copy'):
    83	            return base_model.model_copy(update={'model': target_model})
    84	        cloned = copy.copy(base_model)
    85	        cloned.model = target_model
    86	        return cloned
    87	
    88	    if isinstance(base_model, str):
    89	        for prefix in ('openai/', 'hosted_vllm/', 'custom/'):
    90	            if base_model.startswith(prefix):
    91	                return f'{prefix}{adapter_name}'
    92	        return f'openai/{adapter_name}'
    93	
    94	    return base_model
