   132	def _wrap_skill_toolset_tools(agent: Any, _visited: set[int] | None = None) -> None:
   133	    """Wrap SkillToolset tools on compiled agents so direct run_async calls coerce list args."""
   134	    if agent is None:
   135	        return
   136	    if _visited is None:
   137	        _visited = set()
   138	    obj_id = id(agent)
   139	    if obj_id in _visited:
   140	        return
   141	    _visited.add(obj_id)
   142	
   143	    raw_tools = getattr(agent, 'tools', None)
   144	    if isinstance(raw_tools, (list, tuple)):
   145	        for item in raw_tools:
   146	            inner_agent = getattr(item, 'agent', None)
   147	            if inner_agent is not None:
   148	                _wrap_skill_toolset_tools(inner_agent, _visited)
   149	            inner_tools = getattr(item, '_tools', None)
   150	            if isinstance(inner_tools, (list, tuple)):
   151	                for st in inner_tools:
   152	                    st_name = getattr(st, 'name', '') or ''
   153	                    if st_name in _SKILL_TOOL_NAMES and not getattr(
   154	                        st, '_swegemma_wrapped', False
   155	                    ):
   156	                        orig_run_async = st.run_async
   157	
   158	                        async def _wrapped_run_async(
   159	                            *,
   160	                            args: dict[str, Any],
   161	                            tool_context: Any,
   162	                            _orig: Any = orig_run_async,
   163	                            _name: str = st_name,
   164	                        ) -> Any:
   165	                            err = _sanitize_skill_tool_args(_name, args)
   166	                            if err is not None:
   167	                                return err
   168	                            try:
   169	                                return await _orig(args=args, tool_context=tool_context)
   170	                            except Exception as exc:
   171	                                logger.warning(
   172	                                    "Skill tool '%s' raised %s: %s",
   173	                                    _name,
   174	                                    type(exc).__name__,
   175	                                    exc,
   176	                                )
   177	                                return {
   178	                                    'status': 'error',
   179	                                    'error_type': type(exc).__name__,
   180	                                    'error': str(exc),
   181	                                }
   182	
   183	                        object.__setattr__(st, 'run_async', _wrapped_run_async)
   184	                        object.__setattr__(st, '_swegemma_wrapped', True)
   185	
   186	    sub_agents = getattr(agent, 'sub_agents', None)
   187	    if isinstance(sub_agents, (list, tuple)):
   188	        for sub in sub_agents:
   189	            _wrap_skill_toolset_tools(sub, _visited)
