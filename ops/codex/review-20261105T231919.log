#!/usr/bin/env bash
# Guarded Kaggle submission. Usage: bin/kaggle-submit <submission.zip> <31b|e4b> "<message>"
# Refuses unless: a Director decision contains "SUBMIT: AUTHORIZE sha256=<this zip's sha256> track=<track>",
# that authorization is unused, and no submission was made yet today (UTC).
set -euo pipefail
cd "$(dirname "$0")/.."
source ./config.env
zip=$1; track=$2; msg=${3:-"$track $(basename "$zip")"}
[ -f "$zip" ] || { echo "no such zip: $zip"; exit 1; }
[[ "$track" =~ ^(31b|e4b)$ ]] || { echo "track must be 31b or e4b"; exit 1; }
sha=$(sha256sum "$zip" | cut -d' ' -f1)
auth=$(grep -l "^SUBMIT: AUTHORIZE sha256=$sha track=$track" ops/decisions/*.md 2>/dev/null | tail -1 || true)
[ -n "$auth" ] || { echo "REFUSED: no Director authorization for sha256=$sha track=$track"; exit 3; }
touch ops/submissions.jsonl
grep -q "\"sha256\": \"$sha\"" ops/submissions.jsonl && { echo "REFUSED: this zip was already submitted"; exit 3; }
today=$(date -u +%F)
grep -q "\"day\": \"$today\"" ops/submissions.jsonl && { echo "REFUSED: already submitted today (UTC $today)"; exit 3; }
unzip -l "$zip" | awk '{print $4}' | grep -qx 'agent.yaml' || { echo "REFUSED: agent.yaml not at zip root"; exit 3; }
size=$(stat -c %s "$zip"); [ "$size" -lt 3221225472 ] || { echo "REFUSED: zip >= 3 GiB"; exit 3; }
echo "Submitting $zip ($track, sha256=$sha) authorized by $auth"
if [ "$SUBMIT_MODE" = "kernel" ]; then
  [ -n "$SUBMIT_KERNEL" ] || { echo "SUBMIT_KERNEL not set"; exit 1; }
  # Builder: verify exact flags with `kaggle competitions submit -h` in Phase 0 before first use.
  kaggle competitions submit "$COMP" -k "$SUBMIT_KERNEL" -f submission.zip -m "$msg"
else
  kaggle competitions submit "$COMP" -f "$zip" -m "$msg"
fi
printf '{"day": "%s", "t": "%s", "track": "%s", "sha256": "%s", "zip": "%s", "auth": "%s", "msg": "%s"}\n' \
  "$today" "$(date -u +%FT%TZ)" "$track" "$sha" "$zip" "$auth" "$msg" >> ops/submissions.jsonl
bin/notify default "Gemma: submitted $track" "$(basename "$zip") queued on Kaggle. Score in ~12-15h."
echo "logged to ops/submissions.jsonl"
# Settings (safe to commit; no secrets)
COMP=gemma-4-developer-agent
BUILDER_MODEL=opus            # long working turns (alias resolves to Opus 5.5)
BUILDER_EFFORT=high           # claude --effort: low|medium|high|xhigh|max
DIRECTOR_MODEL=opus           # short decisions; switch to sonnet if usage limits bite
DIRECTOR_EFFORT=high
PAPER_MODEL=opus              # paper writer (bin/session paper)
PAPER_EFFORT=high
TMUX_SESSION=gemma            # windows: builder, director, router (Etho's tmux session is never touched)
RL_SLEEP_MIN=30               # back off a role this long after it reports a usage limit
MIN_GAP_MIN=5                 # nudge an idle Builder whose status is CONTINUE after this long
WAKE_MAX_MIN=180              # nudge an idle Builder at least this often while waiting on jobs
HUMAN_QUIET_MIN=30            # don't /clear a session within this many minutes of Aniket typing in it
HUMAN_HOLD_SEC=120            # don't inject mail within this many seconds of Aniket typing
GPU_HARD_CAP_USD=150
DIGEST_HOUR_UTC=14            # 8am Chicago (CST)
SUBMIT_MODE=file              # file | kernel  (Builder verifies in Phase 0)
