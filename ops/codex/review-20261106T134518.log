   895	def stock_setup_probe(config, iid, repo):
   896	    """P1 (plan 006 addendum): time swegemma's STOCK subprocess setup sequence on this task's snapshot.
   897	    Mirrors eval/tools/stock_subprocess_setup_timing.py (agent_runner.py ~l.553-584); the stock
   898	    install_test_dependencies is used even though patch_subprocess_deps rebinds it. Never raises."""
   899	    steps, error, mgr, sid = {}, None, None, None
   900	    t0 = time.perf_counter()
   901	    deadline = t0 + P1_DEADLINE_SECONDS
   902	    # BaseException prevents stock helpers' broad Exception handlers from swallowing the deadline.
   903	    class Deadline(BaseException):
   904	        pass
   905	    def expired(*args):
   906	        raise Deadline()
   907	    def remaining():
   908	        left = deadline - time.perf_counter()
   909	        if left <= 0:
   910	            raise Deadline()
   911	        return left
   912	    old_handler, old_timer = None, None
   913	    try:
   914	        old_handler = signal.signal(signal.SIGALRM, expired)
   915	        old_timer = signal.setitimer(signal.ITIMER_REAL, remaining())
   916	        import swegemma.harness.container_setup as cs
   917	        from swegemma.sandbox.subprocess import SubprocessManager
   918	        install_deps = getattr(cs.install_test_dependencies, '_timing_original', cs.install_test_dependencies)
   919	        mgr = SubprocessManager(timeout_seconds=120)
   920	        original_exec = mgr.exec
   921	        def bounded_exec(*args, **kwargs):
   922	            kwargs['timeout'] = min(120, remaining())
   923	            return original_exec(*args, **kwargs)
   924	        mgr.exec = bounded_exec
   925	        remaining()
   926	        s = time.perf_counter(); sid = mgr.start(); steps['start_venv'] = round(time.perf_counter() - s, 3)
   927	        for name, fn, args, kwargs in (
   928	                ('setup_container_wheels', cs.setup_container_wheels, (mgr, sid, config), {}),
   929	                ('extract_snapshot', cs.extract_snapshot, (mgr, sid, Path(config.snapshots_dir) / f'{iid}.tgz'), {}),
   930	                ('setup_git_exclude', cs.setup_git_exclude, (mgr, sid), {}),
   931	                ('install_editable_package', cs.install_editable_package, (mgr, sid), {}),
   932	                ('install_test_dependencies', install_deps, (mgr, sid, repo), dict(config=config)),
   933	                ('setup_workspace_test_config', cs.setup_workspace_test_config, (mgr, sid), dict(repo=repo)),
   934	                ('setup_baseline_commit', cs.setup_baseline_commit, (mgr, sid, 'baseline'), {})):
   935	            remaining()
   936	            s = time.perf_counter()
   937	            try:
   938	                fn(*args, **kwargs)
   939	                remaining()
   940	            finally:
   941	                steps[name] = round(time.perf_counter() - s, 3)
   942	    except Deadline:
   943	        error = 'deadline'
   944	    except Exception as exc:
   945	        error = type(exc).__name__
   946	    finally:
   947	        try:
   948	            if old_timer is not None:
   949	                # Cleanup always gets a bounded chance, even after the overall deadline.
   950	                signal.setitimer(signal.ITIMER_REAL, max(.001, min(30, deadline - time.perf_counter()))
   951	                                 if time.perf_counter() < deadline else 30)
   952	            if mgr is not None:
   953	                mgr.cleanup_all()
   954	        except Deadline:
   955	            error = 'deadline'
   956	        except Exception as exc:
   957	            error = error or 'cleanup ' + type(exc).__name__
   958	        finally:
   959	            if time.perf_counter() >= deadline:
   960	                error = 'deadline'
   961	            if old_timer is not None:
   962	                signal.setitimer(signal.ITIMER_REAL, 0)
   963	            if old_handler is not None:
   964	                signal.signal(signal.SIGALRM, old_handler)
   965	            if old_timer is not None:
   966	                if old_timer[0]:
   967	                    signal.setitimer(signal.ITIMER_REAL,
   968	                                     max(.001, old_timer[0] - (time.perf_counter() - t0)), old_timer[1])
   969	    return dict(total_s=round(time.perf_counter() - t0, 3), steps_s=steps, error=error)
