   737	class AsyncioTimingProxy:
   738	    """Observe only agent_runner's timeout context, without changing asyncio itself."""
   739	    def __init__(self, original, state):
   740	        self._original, self._state = original, state
   741	
   742	    def __getattr__(self, name):
   743	        return getattr(self._original, name)
   744	
   745	    def timeout(self, *args, **kwargs):
   746	        cm = self._original.timeout(*args, **kwargs)
   747	        state = self._state
   748	        delay = args[0] if args else kwargs.get('delay')
   749	
   750	        class ObservedTimeout:
   751	            async def __aenter__(self):
   752	                self.current = state.get(None)
   753	                if self.current is not None:
   754	                    self.current.update(agent_timeout_seconds=delay, timeout_enter=time.perf_counter())
   755	                return await cm.__aenter__()
   756	
   757	            async def __aexit__(self, *exc_info):
   758	                exit_exc = exc_info[1]
   759	                try:
   760	                    return await cm.__aexit__(*exc_info)
   761	                except BaseException as exc:
   762	                    exit_exc = exc
   763	                    raise
   764	                finally:
   765	                    if self.current is not None:
