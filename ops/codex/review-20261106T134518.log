    55	               NCCL_DEBUG='WARN', LITELLM_LOCAL_MODEL_COST_MAP='True', LITELLM_TELEMETRY='False',
    56	               LITELLM_LOG='WARNING', PYTORCH_CUDA_ALLOC_CONF='expandable_segments:True',
    57	               OTEL_SDK_DISABLED='true', OTEL_PYTHON_DISABLED='true')
    58	    os.environ.update(env)
    59	    for key in ('OPENAI_API_KEY', 'LOCAL_API_KEY'):
    60	        os.environ.setdefault(key, 'EMPTY')
    61	    for pattern in ('/usr/local/lib/python*/dist-packages/*cutlass*.pth',
    62	                    '/usr/local/lib/python*/site-packages/*cutlass*.pth'):
    63	        for pth in glob.glob(pattern):
    64	            try:
    65	                os.unlink(pth)
    66	            except OSError:
    67	                pass
    68	    staged = Path('/tmp/wheelhouse')
    69	    staged.mkdir(exist_ok=True)
    70	    for w in WHEELHOUSE.glob('*.whl'):
    71	        gpu_wheel = w.name.lower().startswith(('vllm-', 'torch-', 'triton-', 'nvidia_'))
    72	        if 'cutlass' in w.name.lower() or (os.environ.get('SETUP_ONLY') == '1' and gpu_wheel):
    73	            continue
    74	        name = w.name.replace('cu128', '+cu128') if 'cu128' in w.name and '+' not in w.name else w.name
    75	        target = staged / name
    76	        if not target.exists():
    77	            try:
    78	                target.symlink_to(w)
    79	            except OSError:
    80	                shutil.copyfile(w, target)
    81	    wheels = sorted(map(str, staged.glob('*.whl')))
    82	    if not wheels:
    83	        raise RuntimeError('No wheelhouse wheels')
    84	    subprocess.run([sys.executable, '-m', 'pip', 'install', '-q', '--no-deps',
    85	                    '--no-index', '--force-reinstall', *wheels], check=True)
    86	    importlib.invalidate_caches()
    87	    os.environ['PYTEST_ADDOPTS'] = (os.environ.get('PYTEST_ADDOPTS', '') + ' -p no:langsmith_plugin').strip()
    88	    result = subprocess.run([sys.executable, '-m', 'pip', 'uninstall', '-y', 'langsmith'], capture_output=True)
    89	    print('langsmith uninstall rc=', result.returncode, flush=True)
    90	    for name in ('LiteLLM', 'LiteLLM Router', 'LiteLLM Proxy', 'litellm', 'httpx', 'httpcore',
    91	                 'openai', 'urllib3', 'opentelemetry', 'opentelemetry.context'):
    92	        lg = logging.getLogger(name); lg.setLevel(logging.WARNING)
    93	        if 'litellm' in name.lower():
    94	            lg.propagate = False
    95	            lg.handlers.clear()
