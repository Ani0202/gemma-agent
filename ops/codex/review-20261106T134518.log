   353	def close_tool_dependencies(roots, wheels, tags, environment, destination, install_wheel):
   354	    """Walk runtime requirements only, using sandbox markers and no pip resolver.
   355	
   356	    Existing sandbox metadata describes base wheels and copied tools. Each requirement
   357	    edge is checked, while each installed distribution/version is expanded only once.
   358	    Missing edges are returned to the caller, which must fail setup.
   359	    """
   360	    from importlib.metadata import distributions, distribution, PackageNotFoundError
   361	    from packaging.requirements import Requirement
   362	    from packaging.utils import canonicalize_name, parse_wheel_filename
   363	    installed = {canonicalize_name(d.metadata['Name']): d.metadata
   364	                 for d in distributions(path=[str(destination)])}
   365	    queue = list(roots)
   366	    installed.update({canonicalize_name(m['Name']): m for m in queue})
   367	    sources = {name: 'runtime-site-packages:' + str(destination) for name in installed}
   368	    for path in compatible_wheels(wheels, tags).values():
   369	        name, version, _, _ = parse_wheel_filename(path.name)
   370	        if name in installed and installed[name]['Version'] == str(version):
   371	            sources[name] = str(path)
   372	    visited, entries, missing = set(), [], []
   373	    while queue:
   374	        metadata = queue.pop(0)
   375	        key = (canonicalize_name(metadata['Name']), metadata['Version'])
   376	        if key in visited:
   377	            continue
   378	        visited.add(key)
   379	        for raw in metadata.get_all('Requires-Dist', []):
   380	            req = Requirement(raw)
   381	            if req.marker and not req.marker.evaluate(dict(environment, extra='')):
   382	                continue
   383	            name = canonicalize_name(req.name)
   384	            current = installed.get(name)
   385	            row = dict(name=name, required_spec=str(req.specifier), requirement=raw,
   386	                       source='missing', version_installed=None)
   387	            if current is not None and current['Version'] in req.specifier:
   388	                row.update(source=sources.get(name, 'sandbox metadata'),
   389	                           version_installed=current['Version'])
   390	            else:
   391	                # Wheelhouse first, then the embedded official PyPI wheels (pip-installed like the image), then runtime copy.
   392	                candidate = compatible_wheels(wheels, tags, req).get(name) or compatible_wheels(extra_wheels(), tags, req).get(name)
   393	                current = None
   394	                if candidate:
   395	                    result = install_wheel(candidate)
   396	                    row['rc'] = result.exit_code
   397	                    for field in ('stdout', 'stderr'):
   398	                        row[field] = (getattr(result, field, '') or '').encode()[-2048:].decode(errors='ignore')
   399	                    if result.exit_code == 0:
   400	                        current = wheel_metadata(candidate)
   401	                        row['source'] = str(candidate)
   402	                else:
   403	                    try:
   404	                        runtime = distribution(name)
   405	                    except PackageNotFoundError:
   406	                        runtime = None
   407	                    if runtime is not None and runtime.version in req.specifier:
   408	                        source = copy_runtime_package(name, destination)
   409	                        if source != 'missing':
   410	                            current = runtime.metadata
   411	                            row['source'] = source
   412	                if current is not None:
   413	                    installed[name] = current
   414	                    sources[name] = row['source']
   415	                    row['version_installed'] = current['Version']
   416	            entries.append(row)
   417	            if current is not None:
   418	                queue.append(current)
   419	            elif name not in missing:
   420	                missing.append(name)
   421	    return entries, missing
