    87	def keys_of_max(d):
    88	    """(tool, args) key of the first longest identical run (same key as identical_runs)."""
    89	    best, cur, prev = (0, None), 0, object()
    90	    for e in d.get('entries') or []:
    91	        if e.get('type') != 'tool_call':
    92	            continue
    93	        key = (e.get('tool'), json.dumps(e.get('args', e.get('arguments')), sort_keys=True))
    94	        cur = cur + 1 if key == prev else 1
    95	        prev = key
    96	        if cur > best[0]:
    97	            best = (cur, key)
    98	    return [best[1]] if best[1] else []
