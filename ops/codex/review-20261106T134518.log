@dataclass(frozen=True)
class DisplaySnapshot:
    """Immutable snapshot of context display state for thread-safe UI rendering."""

    task_id: str
    repo: str
    phase: str
    tools_used: int
    max_tools: int | None
    elapsed_seconds: float
    activity: str
    agent_started: bool = False


class SwegemmaContext:
    """Context managing the sandbox, tool state, budgets, and execution limits."""

    def __init__(
        self,
        *,
        docker_manager: BaseSandboxManager | Any = None,
        container_id: str = '',
        problem_statement: str = '',
        hints_text: str = '',
        task: Any | None = None,
        task_id: str | None = None,
        repo: str | None = None,
        graph_dir: str = 'data/graphs',
        embeddings_dir: str = 'data/embeddings',
        budget: EvaluationBudget | None = None,
        harness: HarnessLimits | None = None,
        # Direct convenience kwargs for backward compatibility
        max_tool_calls: int | None = None,
        max_time_minutes: int | float | None = None,
        max_exec_seconds: int | None = None,
        max_stdout_chars: int | None = None,
    ) -> None:
        self.docker = docker_manager
        self._lock = threading.RLock()
        self.tool_lock = threading.RLock()
        self._container_id = container_id
        self._sandbox: Any | None = None
        self._update_sandbox()

        self.problem_statement = problem_statement or (
            task.problem_statement
            if task and hasattr(task, 'problem_statement')
            else ''
        )
        self.hints_text = hints_text or (
            task.hints_text if task and hasattr(task, 'hints_text') else ''
        )
        self.task = task
        self._task_id = (
            task_id
            if task_id is not None
            else (task.instance_id if task and hasattr(task, 'instance_id') else None)
        )
        self.repo = repo or (task.repo if task and hasattr(task, 'repo') else None)
        self.graph_dir = graph_dir
        self.embeddings_dir = embeddings_dir

        # Construct budget (resolving direct kwargs if provided)
        base_budget = budget or EvaluationBudget()
        final_tool_calls = (
            max_tool_calls if max_tool_calls is not None else base_budget.tool_calls
        )
        final_time_minutes = (
            max_time_minutes
            if max_time_minutes is not None
            else base_budget.time_minutes
        )
        self.budget = EvaluationBudget(
            time_minutes=final_time_minutes,
            tool_calls=final_tool_calls,
            turns=base_budget.turns,
            cost_usd=base_budget.cost_usd,
            total_tokens=base_budget.total_tokens,
        )

        # Construct harness limits (resolving direct kwargs if provided)
        base_harness = harness or HarnessLimits()
        final_cmd_timeout = (
            max_exec_seconds
            if max_exec_seconds is not None
            else base_harness.command_timeout_seconds
        )
        final_stdout_chars = (
            max_stdout_chars
            if max_stdout_chars is not None
            else base_harness.max_stdout_chars
        )
"""Runs the exact gate command from bundles/31b/v010/sub_agents/submit_gate.yaml in temp git repos (CPU only)."""
import os, shutil, subprocess
from pathlib import Path
import pytest
import yaml

GATE = Path(__file__).resolve().parents[2] / 'bundles/31b/v010/sub_agents/submit_gate.yaml'


def gate_cmd(ws, counter):
    ins = yaml.safe_load(GATE.read_text())['instruction']
    lines = ins.splitlines()
    cmd = lines[lines.index(next(l for l in lines if 'exactly this command' in l)) + 1].strip()
    assert cmd.startswith('cd /workspace && ') and '/tmp/.submit_gate_n' in cmd
    return cmd.replace('/workspace', str(ws)).replace('/tmp/.submit_gate_n', str(counter))


def make_repo(tmp_path):
    ws = tmp_path / 'ws'
    for f in ['src/a.py', 'tests/test_a.py', 'pyproject.toml', 'src/latest_x.py']:
        (ws / f).parent.mkdir(parents=True, exist_ok=True)
        (ws / f).write_text('x\n')
    subprocess.run('git init -q && git add -A && git -c user.email=a@b -c user.name=a commit -qm i',
                   shell=True, check=True, cwd=ws)
    return ws


def run(cmd):
    return subprocess.run(['bash', '-c', cmd], capture_output=True, text=True).stdout.strip()


CASES = [([], ['EDIT_FIRST', 'EDIT_FIRST', 'SUBMIT', 'SUBMIT']), (['src/a.py'], ['SUBMIT']),
         (['tests/test_a.py'], ['EDIT_FIRST']), (['pyproject.toml'], ['EDIT_FIRST']),
         (['src/latest_x.py'], ['SUBMIT']), (['src/new.py'], ['SUBMIT']), (['tests/test_new.py'], ['EDIT_FIRST']),
         (['test_repro.py'], ['EDIT_FIRST']), (['DEL src/a.py'], ['SUBMIT']), (['conftest.py'], ['EDIT_FIRST']),
         (['src/tests/x.py'], ['EDIT_FIRST']), (['test/x.py'], ['EDIT_FIRST']), (['src/my file.py'], ['SUBMIT']),
         (['docs/x.md'], ['SUBMIT']), (['tests/test_a.py', 'src/a.py'], ['SUBMIT'])]


@pytest.mark.parametrize('edits,expected', CASES)
def test_gate(tmp_path, edits, expected):
    ws = make_repo(tmp_path)
    for e in edits:
        if e.startswith('DEL '):
            (ws / e[4:]).unlink()
        else:
            (ws / e).parent.mkdir(parents=True, exist_ok=True)
            with open(ws / e, 'a') as fh:
                fh.write('y\n')
    cmd = gate_cmd(ws, tmp_path / 'n')
    assert [run(cmd).replace('VERDICT=', '') for _ in expected] == expected


