   822	    source = 'sandbox_wrappers' if phase1 is not None else 'run_agent_sandbox'
   823	    phase1 = run_seconds if phase1 is None else phase1
   824	    submitted = bool(context.patch_submitted) if context is not None else None
   825	    return dict(agent_timeout_seconds=current.get('agent_timeout_seconds'),
   826	        agent_clock_seconds=difference('timeout_exit', 'timeout_enter'),
   827	        agent_timeout_fired=current.get('agent_timeout_fired'),
   828	        finalization_seconds=difference('sandbox_stop_end', 'timeout_exit'),
   829	        finalization_exec=current.get('finalization_exec', []),
   830	        teardown_seconds=current.get('sandbox_stop_duration'),
   831	        phase1_wall_seconds=phase1, phase1_source=source,
   832	        pre_agent_seconds=difference('timeout_enter', 'sandbox_start_begin'),
   833	        post_phase1_seconds=total - phase1, patch_submitted=submitted,
   834	        fallback_patch_used=(not submitted and bool(patch.strip())) if submitted is not None else None,
