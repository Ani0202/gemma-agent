        child_script=[call('run_command',{'command':'check'}),{'text':'NOT SUBMITTED'}]*2+[call('run_command',{'command':'check'}),call('submit_patch'),{'text':'SUBMITTED'}]
        child=LlmAgent(name='submit_patch',model=Scripted(model='offline',script=child_script),tools=[tools['run_command'],tools['submit_patch']])
        root_tool=AgentTool(agent=child,skip_summarization=True); script=[call('submit_patch',{'request':'submit'})]*3
    else: root_tool=tools['submit_patch']; script=[call('submit_patch'),{'text':'done'}]
    root=LlmAgent(name='swe_baseline_agent',model=Scripted(model='offline',script=script),tools=[root_tool])
    ss=InMemorySessionService(); runner=Runner(app_name='offline',agent=root,session_service=ss,plugins=[EventDisplayPlugin(trace_callback=on_event),ToolErrorPlugin()])
    session=await ss.create_session(app_name='offline',user_id='u')
    while not ctx.patch_submitted and ctx.llm_calls_used<50:
        async for e in runner.run_async(user_id='u',session_id=session.id,new_message=types.Content(role='user',parts=[types.Part(text='continue')]),run_config=RunConfig(max_llm_calls=50-ctx.llm_calls_used)):
            ctx.handle_adk_event(e)
        if mode=='builtin': break
    entries=tr.to_dict(format='legacy')['entries']
    print(json.dumps(dict(mode=mode,initial=initial,turns=ctx.llm_calls_used-initial,budgeted_tool_calls=ctx.tool_calls_used,submitted=ctx.patch_submitted,events=[{k:e[k] for k in ('type','author','tool','content','result') if k in e} for e in entries]),ensure_ascii=False))
    await runner.close()
async def main():
    await trial('builtin'); await trial('gate'); await trial('gate',49)
asyncio.run(main())
