   332	def copy_runtime_package(name, destination):
   333	    """Copy only the pure Python image package and metadata; no host path injection."""
   334	    found = runtime_copyable(name)
   335	    if found is None:
   336	        return 'missing'
   337	    dist, files = found
   338	    for entry in files:
   339	        target = destination / entry
   340	        target.parent.mkdir(parents=True, exist_ok=True)
   341	        shutil.copyfile(dist.locate_file(entry), target)
   342	    return 'runtime-site-packages:' + str(dist.locate_file(''))
