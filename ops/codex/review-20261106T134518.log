   129	def resolve_skills(
   130	    config: SandboxedLlmAgentConfig,
   131	    ctx: CompilationContext,
   132	    tools: Sequence[Any] | None = None,
   133	) -> Any | None:
   134	    """Resolve skills declared by an LLM agent into a SkillToolset.
   135	
   136	    Args:
   137	        config: The sandboxed LLM agent configuration object.
   138	        ctx: The compilation context tracking cumulative skill counts and registries.
   139	        tools: Optional sequence of tools resolved specifically for this agent.
   140	
   141	    Returns:
   142	        A SkillToolset instance if skills were declared, or None.
   143	
   144	    Raises:
   145	        LimitExceededError: If the cumulative skill count, skill byte size, or instruction length exceeds configured limits.
   146	        PathTraversalError: If a skill reference escapes the sandbox boundary.
   147	        SkillNotFoundError: If a skill reference is missing from a provided SkillRegistry.
   148	        SubmissionValidationError: If loading a skill directory fails.
   149	    """
   150	    if not config.skills:
   151	        return None
   152	
   153	    ctx.total_skills_count += len(config.skills)
   154	    if ctx.total_skills_count > ctx.limits.max_skills:
   155	        raise LimitExceededError(
   156	            f"Agent '{config.name}': cumulative skills count ({ctx.total_skills_count}) "
   157	            f"exceeds submission limit of {ctx.limits.max_skills}"
   158	        )
   159	
   160	    loaded_skills = []
   161	    for skill_ref in config.skills:
   162	        skill_path: Path | None = None
   163	        if ctx.skill_registry is not None:
   164	            cand_keys = [
   165	                skill_ref,
   166	                Path(skill_ref).name,
   167	                Path(skill_ref).name.replace("_", "-"),
   168	                skill_ref.strip("/").replace("/", "-").replace("_", "-"),
   169	            ]
   170	            matched_key = next(
   171	                (k for k in cand_keys if k in ctx.skill_registry),
   172	                None,
   173	            )
   174	            if matched_key is not None:
   175	                skill = ctx.skill_registry.get(matched_key)
   176	            else:
   177	                avail = (
   178	                    ctx.skill_registry.list_skills()
   179	                    if hasattr(ctx.skill_registry, "list_skills")
   180	                    else ctx.skill_registry.list_available()
   181	                )
