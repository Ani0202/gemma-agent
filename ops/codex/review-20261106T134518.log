   226	def inject_base(cs, wheels, destination, current):
   227	    from importlib.metadata import version
   228	    harness_version = version('swegemma')
   229	    row = current['setup_calls'][-1]
   230	    row.update(selected_wheels=sorted(p.name for p in wheels), harness_version=harness_version,
   231	               cache_key=base_cache_key(wheels, harness_version))
   232	    archive = cs._build_unpacked_wheels_tar(wheels, row['cache_key'], '.swegemma_base_injected')
   233	    with tarfile.open(archive) as tf:
   234	        members = tf.getmembers()
   235	        row['tar_member_count'] = len(members)
   236	        payload = [m for m in members if m.isfile() and
   237	                   Path(m.name).name not in ('', '.swegemma_base_injected')]
   238	        if wheels and not payload:
   239	            raise RuntimeError('Selected wheels but base tar contains only marker/empty entries')
   240	        tf.extractall(destination, filter='data')
