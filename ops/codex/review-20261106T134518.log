   971	def llm_calls(trace, limit=200):
   972	    """P3 (plan 006 addendum): one row per trace entry carrying usage (ADK attaches usage once per
   973	    model event), with the gap since the previous entry of any type (approx. model latency)."""
   974	    rows, prev = [], None
   975	    entries = trace.entries if trace else []
   976	    first = entries[0].timestamp if entries else None
   977	    for e in entries:
   978	        if e.usage:
   979	            rows.append(dict(t=round(e.timestamp - first, 3), gap_s=round(e.timestamp - prev, 3) if prev is not None else None,
   980	                             event_type=e.event_type,
   981	                             completion_tokens=e.usage.get('completion_tokens'), prompt_tokens=e.usage.get('prompt_tokens')))
   982	        prev = e.timestamp
   983	    return rows[:limit]
