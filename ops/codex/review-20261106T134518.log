   243	def record_distributions(docker, container_id, repo, row):
   244	    # Query the same interpreter and metadata selection pip uses, never host metadata.
   245	    package = repo.rsplit('/', 1)[-1].lower()
   246	    probe = """import json
   247	from importlib.metadata import distribution, PackageNotFoundError
   248	names = NAMES
   249	result = {}
   250	for name in names:
   251	    try:
   252	        d = distribution(name)
   253	        result[name] = dict(location=str(d.locate_file('')), version=d.version,
   254	                            metadata_location=str(d._path), record_exists=d.read_text('RECORD') is not None)
   255	    except PackageNotFoundError:
   256	        result[name] = dict(location=None, version=None, metadata_location=None, record_exists=False)
   257	print(json.dumps(result))
   258	""".replace('NAMES', repr([package]))
   259	    # Diagnostic only: a probe problem must never change the harness path.
   260	    try:
   261	        result = docker.exec(container_id, 'python3 -c ' + shlex.quote(probe), timeout=30)
   262	        row['dist_probe_rc'] = result.exit_code
   263	        if result.exit_code != 0:
   264	            row['dist_probe_error'] = 'rc'
   265	            return
   266	        row['distributions'] = json.loads(result.stdout)
   267	    except Exception as exc:
   268	        row['dist_probe_error'] = type(exc).__name__
   269	
   270	
   271	def setup_step(current, name, action, *, fatal=True):
   272	    """Time setup steps and retain bounded output plus retry counts."""
   273	    start = time.perf_counter()
   274	    row = dict(step=name, start_offset_s=round(start-current['started'], 6),
   275	               duration_s=0.0, rc=None, stdout='', stderr='', retrying_lines=0)
   276	    current['setup_calls'].append(row)
   277	    try:
   278	        result = action()
   279	        row['rc'] = getattr(result, 'exit_code', getattr(result, 'returncode', 0))
   280	        setup_artifact(current, dict(step=name, stdout=getattr(result, 'stdout', '') or '',
   281	                                     stderr=getattr(result, 'stderr', '') or ''))
   282	        for field in ('stdout', 'stderr'):
   283	            value = getattr(result, field, '') or ''
   284	            row['retrying_lines'] += sum('Retrying' in line for line in value.splitlines())
   285	            row[field] = value.encode('utf-8', errors='replace')[-2048:].decode('utf-8', errors='ignore')
   286	        return result
   287	    except Exception as exc:
   288	        row.update(rc=-1, stderr=type(exc).__name__)
   289	        if fatal:
   290	            current['setup_failed'] = True
   291	            raise
   292	    finally:
   293	        row['duration_s'] = round(time.perf_counter()-start, 6)
   294	        current['retrying_lines'] = sum(c['retrying_lines'] for c in current['setup_calls'])
   295	        if fatal and row['rc'] != 0:
   296	            current['setup_failed'] = True
