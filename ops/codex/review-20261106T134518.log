     1	"""ADK EventDisplayPlugin for real-time live terminal streaming."""
     2	
     3	from __future__ import annotations
     4	
     5	import logging
     6	from collections.abc import Callable
     7	from typing import TYPE_CHECKING, Any
     8	
     9	from google.adk.plugins.base_plugin import BasePlugin
    10	
    11	from adk_eval_core.ui.formatters import (
    12	    ToolFormatterRegistry,
    13	    get_default_formatter_registry,
    14	)
    15	
    16	if TYPE_CHECKING:
    17	    from google.adk.agents.invocation_context import InvocationContext
    18	    from google.adk.events.event import Event
    19	
    20	    from adk_eval_core.ui.event_display import EventDisplay
    21	
    22	logger = logging.getLogger(__name__)
    23	
    24	
    25	class EventDisplayPlugin(BasePlugin):
    26	    """ADK plugin intercepting agent events to render terminal UI updates."""
    27	
    28	    def __init__(
    29	        self,
    30	        display: EventDisplay | Callable[[Any], None] | None = None,
    31	        formatter_registry: ToolFormatterRegistry | None = None,
    32	        name: str | None = None,
    33	        on_event: Callable[[Any], None] | None = None,
    34	        *,
    35	        event_display: Any | None = None,
    36	        display_manager: Any | None = None,
    37	        trace_callback: Callable[[Any], None] | None = None,
    38	    ) -> None:
    39	        eff_name = (
    40	            name
    41	            if name is not None
    42	            else (
    43	                "swegemma_display"
    44	                if (
    45	                    trace_callback is not None
    46	                    or display_manager is not None
    47	                    or event_display is not None
    48	                )
    49	                else "event_display"
    50	            )
    51	        )
    52	        super().__init__(name=eff_name)
    53	        eff_display = display if display is not None else (event_display or display_manager)
    54	        eff_on_event = on_event if on_event is not None else trace_callback
    55	
    56	        if callable(eff_on_event):
    57	            self._on_event: Callable[..., Any] | None = eff_on_event
    58	            self.display: Any | None = (
    59	                eff_display
    60	                if (eff_display is not None and not callable(eff_display))
    61	                else None
    62	            )
    63	        elif (
    64	            callable(eff_display)
    65	            and not hasattr(eff_display, "on_event")
    66	            and not hasattr(eff_display, "log")
    67	        ):
    68	            self._on_event = eff_display
    69	            self.display = None
    70	        else:
    71	            self._on_event = None
    72	            self.display = eff_display
    73	
    74	        self.display_manager = self.display
    75	        self.trace_callback = self._on_event
    76	
    77	        if formatter_registry is not None:
    78	            self.formatter_registry = formatter_registry
    79	        elif self.display and hasattr(self.display, "formatter_registry"):
    80	            self.formatter_registry = self.display.formatter_registry
    81	        else:
    82	            self.formatter_registry = get_default_formatter_registry()
    83	
    84	    async def on_event_callback(
    85	        self,
    86	        *,
    87	        invocation_context: InvocationContext,
    88	        event: Event,
    89	    ) -> Event | None:
    90	        """Called when an ADK event occurs during agent execution."""
    91	        if self.display is not None and hasattr(self.display, "on_event"):
    92	            self.display.on_event(event)
    93	
    94	        if self._on_event is not None and self._on_event != getattr(self.display, "on_event", None):
    95	            self._on_event(event)
    96	
    97	        if self.display is not None and hasattr(self.display, "log") and not hasattr(self.display, "on_event"):
    98	            from rich.markup import escape
    99	
   100	            event_type = getattr(event, "type", "event")
   101	            content = getattr(event, "content", "")
   102	
   103	            if event_type == "call":
   104	                tool_name = getattr(event, "tool_name", "tool") or "tool"
   105	                args = getattr(event, "tool_args", {}) or {}
   106	                fmt = self.formatter_registry.get(tool_name)
   107	                call_disp = fmt.format_call(tool_name, args)
   108	                preview_str = f" [dim]{escape(str(call_disp.preview))}[/dim]" if call_disp.preview else ""
   109	                self.display.log(
   110	                    f"{call_disp.icon} [bold cyan]{escape(str(call_disp.title))}[/bold cyan]{preview_str}"
   111	                )
   112	            elif event_type == "response":
   113	                tool_name = getattr(event, "tool_name", "tool") or "tool"
   114	                raw_res = getattr(event, "tool_result", "")
   115	                fmt = self.formatter_registry.get(tool_name)
   116	                res_disp = fmt.format_response(tool_name, raw_res)
   117	                if res_disp.is_error:
   118	                    self.display.log(
   119	                        f"{res_disp.icon} [bold red]{escape(str(res_disp.title))}: {escape(str(res_disp.preview))}[/bold red]"
   120	                    )
   121	                else:
   122	                    self.display.log(
   123	                        f"{res_disp.icon} [bold yellow]{escape(str(res_disp.title))}: {escape(str(res_disp.preview))}[/bold yellow]"
   124	                    )
   125	            elif event_type == "thought" and content:
   126	                first_line = escape(str(content).split("\n")[0][:100])
   127	                self.display.log(f"💭 [dim white]{first_line}...[/dim white]")
   128	            elif event_type == "system_instruction" and content:
   129	                first_line = escape(str(content).split("\n")[0][:100])
   130	                self.display.log(f"📋 [bold magenta]System Prompt:[/bold magenta] {first_line}...")
   131	            elif event_type == "task_prompt" and content:
   132	                first_line = escape(str(content).split("\n")[0][:100])
   133	                self.display.log(f"🎯 [bold cyan]Task Prompt:[/bold cyan] {first_line}...")
   134	            elif event_type == "final":
   135	                self.display.log("✅ [bold green]Final response received[/bold green]")
   136	
   137	        return event
   138	
   139	
   140	__all__ = ["EventDisplayPlugin"]

