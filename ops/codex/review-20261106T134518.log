    97	def extra_wheels():
    98	    """Write the embedded wheels (sha256-checked) to a kernel-local dir and return it."""
    99	    target = WORK / 'extra_wheels'
   100	    target.mkdir(parents=True, exist_ok=True)
   101	    for name, (digest, payload) in EXTRA_WHEELS.items():
   102	        data = base64.b64decode(payload)
   103	        if hashlib.sha256(data).hexdigest() != digest or '/' in name or name.startswith('.'):
   104	            raise RuntimeError('Embedded wheel failed verification: ' + name)
   105	        (target / name).write_bytes(data)
   106	    return target
