    27	def _is_valid_non_negative(val: Any) -> bool:
    28	    """Return True if val is a finite non-negative int or float (excluding bool)."""
    29	    return (
    30	        isinstance(val, (int, float))
    31	        and not isinstance(val, bool)
    32	        and math.isfinite(val)
    33	        and val >= 0
    34	    )
