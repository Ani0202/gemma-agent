    37	@dataclass(frozen=True)
    38	class ModelPricing:
    39	    """Per-token pricing for a model (USD per 1M tokens)."""
    40	
    41	    model_id: str
    42	    path: str
    43	    display_name: str
    44	    input_price_per_million: float  # $/1M input tokens
    45	    cached_input_price_per_million: float  # $/1M cached input tokens
    46	    output_price_per_million: float  # $/1M output tokens
    47	
    48	    def __post_init__(self) -> None:
    49	        if not (
    50	            _is_valid_non_negative(self.input_price_per_million)
    51	            and _is_valid_non_negative(self.cached_input_price_per_million)
    52	            and _is_valid_non_negative(self.output_price_per_million)
    53	        ):
    54	            raise InvalidBudgetError(
    55	                "Model pricing rates must be finite non-negative numbers",
    56	                model_id=self.model_id,
    57	            )
    58	
    59	    def cost(self, input_tokens: int, output_tokens: int, cached_input_tokens: int = 0) -> float:
    60	        """Compute cost in USD for a given number of tokens."""
    61	        if not (
    62	            _is_valid_non_negative(input_tokens)
    63	            and _is_valid_non_negative(output_tokens)
    64	            and _is_valid_non_negative(cached_input_tokens)
    65	        ):
    66	            raise InvalidBudgetError(
    67	                "Token counts must be finite non-negative numbers",
    68	                model_id=self.model_id,
    69	            )
    70	        non_cached_input = max(0, input_tokens - cached_input_tokens)
    71	        input_cost = (non_cached_input / 1_000_000) * self.input_price_per_million
    72	        cached_cost = (cached_input_tokens / 1_000_000) * self.cached_input_price_per_million
    73	        output_cost = (output_tokens / 1_000_000) * self.output_price_per_million
    74	        return input_cost + cached_cost + output_cost
