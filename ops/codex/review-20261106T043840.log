   179	class GenerateContentConfig(BaseModel):
   180	    """Generation parameters — validated against organizer constraints at compile time.
   181	
   182	    This schema is intentionally permissive: it defines the *universe* of parameters a submission
   183	    could set. Actual restrictions and bounding checks are applied by
   184	    :class:`~adk_submission.limits.GenerationConstraints` during compilation.
   185	
   186	    Fields that are **never** settable by submissions (``safety_settings``, ``tools``,
   187	    ``system_instruction``, ``response_schema``) are hard-excluded from this schema.
   188	
   189	    Attributes:
   190	        temperature (Optional[float]): Sampling temperature. Must be >= 0.0. Defaults to None.
   191	        top_p (Optional[float]): Nucleus sampling threshold. Must be between 0.0 and 1.0 inclusive. Defaults to None.
   192	        top_k (Optional[int]): Top-k sampling cutoff. Must be >= 1. Defaults to None.
   193	        max_output_tokens (Optional[int]): Maximum number of tokens to generate. Must be >= 1. Defaults to None.
   194	        stop_sequences (Optional[list[str]]): List of strings that stop generation when encountered. Defaults to None.
   195	        presence_penalty (Optional[float]): Penalty for repeated tokens based on presence. Defaults to None.
   196	        frequency_penalty (Optional[float]): Penalty for repeated tokens based on frequency. Defaults to None.
   197	        response_mime_type (Optional[str]): Expected MIME type for the model response (e.g., 'application/json'). Defaults to None.
   198	        seed (Optional[int]): Random seed for deterministic generation. Defaults to None.
   199	        thinking_config (Optional[ThinkingConfig]): Configuration for model reasoning/thinking. Defaults to None.
   200	    """
   201	
   202	    model_config = ConfigDict(extra="forbid", frozen=True)
   203	
   204	    temperature: float | None = Field(default=None, ge=0.0)
   205	    top_p: float | None = Field(default=None, ge=0.0, le=1.0)
   206	    top_k: int | None = Field(default=None, ge=1)
   207	    max_output_tokens: int | None = Field(default=None, ge=1)
   208	    stop_sequences: list[str] | None = None
   209	    presence_penalty: float | None = None
   210	    frequency_penalty: float | None = None
   211	    response_mime_type: str | None = None
   212	    seed: int | None = None
   213	    thinking_config: ThinkingConfig | None = None
   214	
   215	    @field_validator(
   216	        "temperature",
   217	        "top_p",
   218	        "top_k",
   219	        "max_output_tokens",
   220	        "presence_penalty",
   221	        "frequency_penalty",
   222	        "seed",
   223	        mode="before",
   224	    )
   225	    @classmethod
   226	    def _validate_numeric_fields(cls, v: Any, info: ValidationInfo) -> Any:
   227	        return _reject_bool_nan_inf(v, info.field_name or "numeric_field")
