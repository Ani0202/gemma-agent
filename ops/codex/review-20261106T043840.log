    27	def resolve_model(
    28	    config: SandboxedLlmAgentConfig,
    29	    ctx: CompilationContext,
    30	) -> Any:
    31	    """Resolve the model for an LLM agent, attaching an adapter if specified.
    32	
    33	    Args:
    34	        config: The sandboxed LLM agent configuration object.
    35	        ctx: The compilation context tracking mutable state and registries.
    36	
    37	    Returns:
    38	        The resolved model object or string identifier, or None if neither
    39	        model nor adapter is specified.
    40	
    41	    Raises:
    42	        AdapterNotFoundError: If the specified adapter is not found in discovered adapters.
    43	        SubmissionValidationError: If an adapter is specified without a base model.
    44	        ModelNotFoundError: If the specified base model alias is not in the model registry.
    45	    """
    46	    if config.adapter:
    47	        if not ctx.adapter_manifest or config.adapter not in ctx.adapter_manifest.adapters:
    48	            available = (
    49	                sorted(ctx.adapter_manifest.adapters.keys())
    50	                if ctx.adapter_manifest
    51	                else []
    52	            )
    53	            raise AdapterNotFoundError(config.adapter, available=available)
    54	        if not config.model:
    55	            raise SubmissionValidationError(
    56	                f"Agent '{config.name}' specifies adapter '{config.adapter}' "
    57	                f"without a base model alias."
    58	            )
    59	        base_model = ctx.model_registry.get(config.model)
    60	        adapter_info = ctx.adapter_manifest.adapters[config.adapter]
    61	        if ctx.adapter_resolver_fn is not None:
    62	            return ctx.adapter_resolver_fn(base_model, adapter_info)
    63	        prefixed_key = f"adapter:{adapter_info.name}"
    64	        if prefixed_key in ctx.model_registry:
    65	            registered = ctx.model_registry.get(prefixed_key)
    66	            return _clone_model(registered)
    67	        if adapter_info.name in ctx.model_registry:
    68	            registered = ctx.model_registry.get(adapter_info.name)
    69	            return _clone_model(registered)
    70	        if isinstance(base_model, str):
    71	            return f"{base_model}:{adapter_info.name}"
    72	        if hasattr(base_model, "model") and isinstance(base_model.model, str):
    73	            cloned = _clone_model(base_model)
    74	            cloned.model = f"{base_model.model}:{adapter_info.name}"
    75	            return cloned
    76	        return f"{base_model}:{adapter_info.name}"
    77	    elif config.model:
    78	        base_model = ctx.model_registry.get(config.model)
    79	        return _clone_model(base_model)
    80	    return None
