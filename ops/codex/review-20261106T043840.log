def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('bundle_dir')
    parser.add_argument('--zip', action='store_true')
    args = parser.parse_args()
    try:
        bundle = Bundle(args.bundle_dir)
        total = bundle.validate()
        if args.zip:
            write_zip(bundle, Path(__file__).resolve().parent.parent / 'dist')
        print(f'PASS: {args.bundle_dir} ({total} unpacked bytes)')
        return 0
    except (Invalid, OSError, UnicodeError, RecursionError) as exc:
        print(f'FAIL: {exc}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())

