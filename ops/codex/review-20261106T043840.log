     1	#!/usr/bin/env python3
     2	"""Plan 005 dec 059 item 4 CPU checks (counts and hashes only, no task text written).
     3	
     4	Usage: shell_error_causes.py <out.json> <runA_dir> <labelA> <runB_dir> <labelB> <id> [<id> ...]
     5	(a) sha256 of <run>/runs/<id>/agent.patch for each listed id in both runs, and whether A == B byte-identical.
     6	(b) for run B: every run_command response classified cmd_error_shell by eval/trace_tool_errors.py, broken down by cause:
     7	    quoting_heredoc  bash "unexpected EOF while looking for matching", "here-document", "unexpected token", "unexpected end of file"
     8	    missing_binary   "command not found" / "No such file or directory" on the command itself
     9	    syntax_other     any other message containing "syntax error"
    10	    other            anything else
    11	    plus per-task counts, distinct command strings (by sha256), and the max identical-command repeat count.
    12	"""
    13	import hashlib, json, os, sys
    14	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    15	from trace_tool_errors import _load, classify
    16	
    17	
    18	def sha(p):
    19	    return hashlib.sha256(open(p, "rb").read()).hexdigest() if os.path.exists(p) else None
    20	
    21	
    22	def cause(msg):
    23	    if "command not found" in msg:
    24	        return "missing_binary"
    25	    if any(s in msg for s in ("looking for matching", "here-document", "unexpected token", "unexpected end of file")):
    26	        return "quoting_heredoc"
    27	    if "syntax error" in msg:
    28	        return "syntax_other"
    29	    return "other"
    30	
    31	
    32	def shell_errors(run_dir):
    33	    base = os.path.join(run_dir, "runs")
    34	    causes, per_task, cmds = {}, {}, {}
    35	    for t in sorted(os.listdir(base)):
    36	        p = os.path.join(base, t, "trace.json")
    37	        if not os.path.isfile(p):
    38	            continue
    39	        pend = []
    40	        for e in json.load(open(p))["entries"]:
    41	            if e["type"] == "tool_call" and e.get("tool") == "run_command":
    42	                pend.append(e)
    43	            elif e["type"] == "tool_response" and e.get("tool") == "run_command":
    44	                c = pend.pop(0) if pend else {}
    45	                r = _load(e.get("result", ""))
    46	                cls, _ = classify("run_command", r)
    47	                if "cmd_error_shell" not in cls:
    48	                    continue
    49	                k = cause(str(r.get("error_message") or r.get("error") or ""))
    50	                causes[k] = causes.get(k, 0) + 1
    51	                per_task[t] = per_task.get(t, 0) + 1
    52	                h = hashlib.sha256(json.dumps(c.get("args", c), sort_keys=True).encode()).hexdigest()[:12]
    53	                cmds[h] = cmds.get(h, 0) + 1
    54	    return {"total": sum(causes.values()), "by_cause": causes, "tasks_with_errors": len(per_task),
    55	            "per_task": per_task, "distinct_commands": len(cmds), "max_identical_repeats": max(cmds.values(), default=0)}
    56	
    57	
    58	def main(out, ra, la, rb, lb, *ids):
    59	    a = {}
    60	    for i in ids:
    61	        ha, hb = sha(os.path.join(ra, "runs", i, "agent.patch")), sha(os.path.join(rb, "runs", i, "agent.patch"))
    62	        a[i] = {la: ha, lb: hb, "identical": ha is not None and ha == hb}
    63	    res = {"_schema": "shell_error_causes_v1", "generator": "eval/shell_error_causes.py", "decision": "059 item 4",
    64	           "runs": {la: ra, lb: rb},
    65	           "a_patch_sha256": a, "a_identical_count": sum(v["identical"] for v in a.values()), "a_n": len(ids),
    66	           "b_shell_errors": {la: shell_errors(ra), lb: shell_errors(rb)}}
    67	    json.dump(res, open(out, "w"), indent=1)
    68	    print(json.dumps({"a_identical": res["a_identical_count"], "n": len(ids),
    69	                      "b": {k: {x: v[x] for x in ("total", "by_cause", "tasks_with_errors", "distinct_commands", "max_identical_repeats")}
    70	                            for k, v in res["b_shell_errors"].items()}}))
    71	
    72	
    73	if __name__ == "__main__":
    74	    main(*sys.argv[1:])

