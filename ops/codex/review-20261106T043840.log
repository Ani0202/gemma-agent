   227	
   228	        callbacks = CallbackRegistry()
   229	        callbacks.register(
   230	            "rate_limit",
   231	            rate_limit_fn,
   232	            types={CallbackType.BEFORE_MODEL},
   233	        )
   234	        callbacks.register("log_to_state", log_fn)  # usable anywhere
