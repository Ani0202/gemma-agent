    38	def resolve_tool_item(
    39	    item: str | AgentToolEntry,
    40	    ctx: CompilationContext,
    41	    compile_agent_fn: Callable[[Any, CompilationContext], BaseAgent] | None = None,
    42	) -> Any:
    43	    """Resolve a single entry in the agent's tools list.
    44	
    45	    - Plain ``str`` → look up in the tool registry.
    46	    - :class:`AgentToolEntry` → compile the referenced agent and wrap it in an ADK ``AgentTool``.
    47	
    48	    Args:
    49	        item: Either a plain string representing a tool name in the registry, or an AgentToolEntry object referencing a sub-agent.
    50	        ctx: The compilation context tracking mutable state and limits.
    51	        compile_agent_fn: Optional callable for recursive agent compilation.
    52	
    53	    Returns:
    54	        The resolved tool callable or an ADK AgentTool instance wrapping a compiled sub-agent.
    55	
    56	    Raises:
    57	        ToolNotFoundError: If a plain string tool name is not found in the tool registry.
    58	        PathTraversalError: If an AgentTool config_path escapes the submission root directory.
    59	        SubmissionValidationError: If an AgentTool configuration file is not found.
    60	        LimitExceededError: If sub-agent nesting depth via AgentTool exceeds ``ctx.limits.max_sub_agent_depth``.
    61	        SubmissionSchemaError: If an AgentTool configuration fails schema validation.
    62	        yaml.YAMLError: If an AgentTool YAML configuration file is malformed.
    63	    """
    64	    if isinstance(item, str):
    65	        tool = ctx.tool_registry.get(item)
    66	        if callable(tool):
    67	            cur_name = getattr(tool, "__name__", "")
    68	            if cur_name == "<lambda>":
    69	                try:
    70	                    tool.__name__ = item
    71	                    tool._is_named_lambda = True  # type: ignore[attr-defined]
    72	                except (AttributeError, TypeError):
    73	                    @functools.wraps(tool)
    74	                    def _wrapped_ro(*args: Any, **kwargs: Any) -> Any:
    75	                        return tool(*args, **kwargs)
    76	
    77	                    _wrapped_ro.__name__ = item
    78	                    return _wrapped_ro
    79	            elif getattr(tool, "_is_named_lambda", False) and cur_name != item:
    80	                @functools.wraps(tool)
    81	                def _wrapped_alias(*args: Any, **kwargs: Any) -> Any:
    82	                    return tool(*args, **kwargs)
    83	
    84	                _wrapped_alias.__name__ = item
    85	                return _wrapped_alias
    86	        return tool
    87	
    88	    # --- AgentToolEntry -------------------------------------------------
    89	    ref = item.agent_tool
    90	    current_dir = ctx.current_dir or ctx.root_dir
    91	    sub_path = ctx.resolve_sub_config_path(ref.config_path, error_prefix="AgentTool")
    92	
    93	    ctx.depth += 1
    94	    prev_dir = current_dir
    95	    ctx.current_dir = sub_path.parent
    96	    try:
    97	        if ctx.depth > ctx.limits.max_sub_agent_depth:
    98	            raise LimitExceededError(
    99	                f"Sub-agent nesting too deep (via agent_tool): {ctx.depth} "
   100	                f"(max {ctx.limits.max_sub_agent_depth})"

