    13	def _clone_model(model: Any) -> Any:
    14	    if isinstance(model, str):
    15	        return model
    16	    if hasattr(model, "model_copy") and callable(model.model_copy):
    17	        try:
    18	            return model.model_copy(deep=True)
    19	        except Exception:  # noqa: BLE001
    20	            pass
    21	    cloned = copy.copy(model)
