import subprocess
from pathlib import Path
original=subprocess.check_output(['git','show','HEAD:bin/kaggle-submit'],text=True).splitlines(True)
p=Path('ops/patches/kaggle-submit-kernel.diff').read_text().splitlines(True)
import re
out=[]; pos=0; active=False
for line in p:
    if line.startswith('+++ b/bin/kaggle-submit'): active=True; continue
    if active and line.startswith('--- a/'): break
    if not active: continue
    if line.startswith('@@'):
        n=int(re.match(r'@@ -(\\d+)',line)[1])-1
        out.extend(original[pos:n]); pos=n
    elif line.startswith(' '): out.append(original[pos]); pos+=1
    elif line.startswith('-'): assert original[pos]==line[1:]; pos+=1
    elif line.startswith('+'): out.append(line[1:])
out.extend(original[pos:]); script=''.join(out)
r=subprocess.run(['bash','-n'],input=script,text=True,capture_output=True)
print('Patched bash syntax:',r.returncode,r.stderr)
for i,l in enumerate(script.splitlines(),1): print(f'{i:3} {l}')
