--- a/bin/job
+++ b/bin/job
@@ -1,7 +1,9 @@
 #!/usr/bin/env bash
 # Detached long-running jobs that survive the end of a Claude cycle.
 #   bin/job start <name> -- <command...>   bin/job status [name]   bin/job tail <name> [lines]   bin/job kill <name>
-# Writes ops/jobs/<name>.status: "running <pid> <start> <pgid>" -> "done 0 <end>" / "failed <rc> <end>"
+# Writes ops/jobs/<name>.status: "running <pid> <start> <pgid> <boot_id> <starttime>" -> "done 0 <end>" / "failed <rc> <end>"
+# Every job process inherits GEMMA_JOB_ID=<name>/<boot_id>/<starttime> (unique per run), so `kill` can find
+# descendants that left the process group (setsid) and never trusts a pgid recorded before a reboot.
 set -uo pipefail
 cd "$(dirname "$0")/.." || exit 1
 mkdir -p ops/jobs
@@ -18,25 +20,34 @@
     fi
     printf '%q ' "$@" > "ops/jobs/$name.cmd"
     # Memory cap per job: a runaway job must not stall the VM (Etho shares it; 2026-11-05 incident).
-    # Prefer a systemd user scope (caps the whole process tree); after a cron-started boot with no
-    # login there is no user manager, so fall back to a per-process ulimit -v.
+    # Prefer a systemd user scope (caps the whole process tree), but ONLY with linger on: without
+    # linger the user manager exists just while someone is logged in, and logout stops user@UID
+    # and every scope in it (the job dies, its status file still says running; dec 023).
+    # Otherwise fall back to a per-process RLIMIT_DATA cap. Not ulimit -v: Codex's tool host
+    # reserves a large virtual address space and crashes (SIGTRAP) under RLIMIT_AS. RLIMIT_DATA caps
+    # private memory (brk + private writable mmap) per process only, not shared mappings or a job's
+    # total; bin/memguard covers those.
     rt=/run/user/$(id -u)
     rm -f "ops/jobs/$name.unit"
-    if [ -S "$rt/bus" ] && XDG_RUNTIME_DIR=$rt systemd-run --user --scope --quiet -p MemoryMax=64M true 2>/dev/null; then
+    linger=$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)
+    if [ "$linger" = yes ] && [ -S "$rt/bus" ] && XDG_RUNTIME_DIR=$rt systemd-run --user --scope --quiet -p MemoryMax=64M true 2>/dev/null; then
       unit="gemma-job-$name-$(date +%s)"
       echo "$unit" > "ops/jobs/$name.unit"
       pre=(env XDG_RUNTIME_DIR="$rt" systemd-run --user --scope --quiet --collect --unit="$unit" -p MemoryMax=5G)
       cap="memory cap: systemd scope MemoryMax=5G (whole job)"
     else
-      pre=(bash -c 'ulimit -v 5242880 && exec "$@"' _)
-      cap="memory cap: ulimit -v 5G per process (no systemd user manager)"
+      pre=(bash -c 'ulimit -d 5242880 && exec "$@"' _)
+      cap="memory cap: ulimit -d 5G per process (no lingering systemd user manager)"
     fi
     # setsid: the wrapper leads its own process group, so `kill` can signal the whole tree.
     GEMMA_JOB_CAP=$cap setsid nohup bash -c '
       name=$1; shift
       echo 1000 > /proc/self/oom_score_adj 2>/dev/null || true   # kernel OOM killer picks our jobs before Etho
       pgid=$(ps -o pgid= -p $$ | tr -d " ")
-      echo "running $$ $(date -u +%FT%TZ) $pgid" > "ops/jobs/$name.status"
+      boot=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
+      stime=$(sed "s/.*) //" /proc/$$/stat | awk "{print \$20}")
+      export GEMMA_JOB_ID="$name/$boot/$stime"
+      echo "running $$ $(date -u +%FT%TZ) $pgid $boot $stime" > "ops/jobs/$name.status"
       { echo "[bin/job] $GEMMA_JOB_CAP; pgid $pgid"; nice -n 15 "$@"; } > "ops/jobs/$name.log" 2>&1; rc=$?
       [ $rc -eq 137 ] && echo "[bin/job] exit 137: killed, most likely at the memory cap" >> "ops/jobs/$name.log"
