@@ -47,20 +58,47 @@
     if [ -n "${1:-}" ]; then cat "ops/jobs/$1.status"; else for f in ops/jobs/*.status; do [ -e "$f" ] && echo "$(basename "$f" .status): $(cat "$f")"; done; fi;;
   tail) tail -n "${2:-40}" "ops/jobs/$1.log";;
   kill)
-    read -r st pid _ pgid < "ops/jobs/$1.status"
+    read -r st pid _ pgid boot stime < "ops/jobs/$1.status"
